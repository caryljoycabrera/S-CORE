function toggleUserTypeFields() {
  const userType = document.getElementById('userType').value;
  const studentFields = document.getElementById('studentFields');
  const nonStudentFields = document.getElementById('nonStudentFields');
  const commonFields = document.getElementById('commonFields');

  // Helper to clear all inputs/selects in a section
  function clearFields(section) {
    section.querySelectorAll('input').forEach(input => {
      input.value = '';
      input.style.borderColor = '';
      input.removeAttribute('required');
    });
    section.querySelectorAll('select').forEach(select => {
      if (select.multiple) {
        $(select).val([]).trigger('change');
      } else {
        select.value = '';
      }
      select.removeAttribute('required');
    });
  }

  // Clear common fields (phone, email, username, passwords)
  function clearCommonFields() {
    const commonInputs = commonFields.querySelectorAll('input');
    commonInputs.forEach(input => {
      if (input.name !== 'terms') { // Don't clear terms checkbox
        input.value = '';
        input.style.borderColor = '';
      }
    });
    // Uncheck terms
    const termsCheckbox = document.querySelector('input[name="terms"]');
    if (termsCheckbox) termsCheckbox.checked = false;
    // Clear password strength indicator
    const strengthIndicator = document.getElementById('passwordStrength');
    if (strengthIndicator) strengthIndicator.style.display = 'none';
    // Clear any messages
    const messageContainer = document.getElementById('messageContainer');
    if (messageContainer) messageContainer.innerHTML = '';
  }

  if (userType === 'student') {
    clearFields(nonStudentFields);
    clearFields(studentFields);
    clearCommonFields();
    // Update counters
    if (typeof updateOrganizationCounter === 'function') updateOrganizationCounter();
    if (typeof updateOfficeCounter === 'function') updateOfficeCounter();

    studentFields.style.display = 'block';
    nonStudentFields.style.display = 'none';
    commonFields.style.display = 'block';

    // Enable student fields and set required attributes
    studentFields.querySelectorAll('input, select').forEach(input => {
      input.disabled = false;
      if (input.dataset.name) input.name = input.dataset.name;
      // Set required for student-specific fields
      if (input.id === 'studentId' || input.id === 'studentYear' || input.id === 'studentProgram' || input.id === 'studentOrganization') {
        input.setAttribute('required', 'required');
      }
    });

    // Disable non-student fields
    nonStudentFields.querySelectorAll('input, select').forEach(input => {
      input.disabled = true;
      if (input.name) {
        input.dataset.name = input.name;
        input.removeAttribute('name');
      }
    });

  } else if (userType === 'nonstudent') {
    clearFields(studentFields);
    clearFields(nonStudentFields);
    clearCommonFields();
    // Update counters
    if (typeof updateOrganizationCounter === 'function') updateOrganizationCounter();
    if (typeof updateOfficeCounter === 'function') updateOfficeCounter();

    studentFields.style.display = 'none';
    nonStudentFields.style.display = 'block';
    commonFields.style.display = 'block';

    // Enable non-student fields and set required attributes
    nonStudentFields.querySelectorAll('input, select').forEach(input => {
      input.disabled = false;
      if (input.dataset.name) input.name = input.dataset.name;
      // Set required for non-student-specific fields
      if (input.id === 'nonStudentOffice') {
        input.setAttribute('required', 'required');
      }
    });

    // Disable student fields
    studentFields.querySelectorAll('input, select').forEach(input => {
      input.disabled = true;
      if (input.name) {
        input.dataset.name = input.name;
        input.removeAttribute('name');
      }
    });
  } else {
    // No user type selected
    clearFields(studentFields);
    clearFields(nonStudentFields);
    clearCommonFields();
    studentFields.style.display = 'none';
    nonStudentFields.style.display = 'none';
    commonFields.style.display = 'none';
  }
}

