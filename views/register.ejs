$(document).ready(function () {
  // Initialize Student Organization Select2
  const studentOrgSelect = $('#studentOrganization');
  organizationOptions.forEach(org => {
    const option = new Option(org, org, false, false);
    studentOrgSelect.append(option);
  });

  studentOrgSelect.select2({
    placeholder: "Search or select organizations",
    allowClear: true,
    width: '100%',
    closeOnSelect: false,
    templateResult: function(data) {
      if (!data.id) return data.text;
      return $(`<div style="padding: 4px 0;">${data.text}</div>`);
    }
  });

  // Set up organization counter and click handlers
  studentOrgSelect.on('change', function() {
    updateOrganizationCounter();
    setTimeout(setupOrganizationClickHandlers, 100);
  });

  // Initial counter update
  updateOrganizationCounter();
  
  // Setup click handlers
  setTimeout(setupOrganizationClickHandlers, 200);

  // Initialize Office/Department Select2
  const nonStudentOfficeSelect = $("#nonStudentOffice");
  
  // Add options to office select
  officeOptions.forEach(office => {
    const option = new Option(office, office, false, false);
    nonStudentOfficeSelect.append(option);
  });

  nonStudentOfficeSelect.select2({
    placeholder: "Select office(s)/department(s)",
    allowClear: true,
    width: "100%",
    closeOnSelect: false
  });
});

// Enhanced add organization functionality
document.getElementById('addOrganizationButton').addEventListener('click', addCustomOrganization);

// Allow Enter key to add organization
document.getElementById('otherOrganization').addEventListener('keypress', function(e) {
  if (e.key === 'Enter') {
    e.preventDefault();
    addCustomOrganization();
  }
});

// Run on page load
window.addEventListener('DOMContentLoaded', () => {
  toggleUserTypeFields();
});
</script>
