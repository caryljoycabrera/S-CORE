// Organization counter
function updateOrganizationCounter() {
  const select = $('#studentOrganization');
  const counter = document.getElementById('orgCounter');
  if (!counter) return;
  
  const selectedCount = select.val()?.length || 0;
  
  if (selectedCount === 0) {
    counter.textContent = 'No organizations selected';
    counter.classList.remove('has-selections');
  } else if (selectedCount === 1) {
    counter.textContent = '1 organization selected';
    counter.classList.add('has-selections');
  } else {
    counter.textContent = `${selectedCount} organizations selected`;
    counter.classList.add('has-selections');
  }
}

// Custom organization removal handler
function setupOrganizationClickHandlers() {
  // Remove existing handlers to prevent duplicates
  $(document).off('click', '.select2-selection__choice');
  
  // Add click handler for organization removal
  $(document).on('click', '.select2-selection__choice', function(e) {
    e.preventDefault();
    e.stopPropagation();
    
    const $choice = $(this);
    const value = $choice.attr('title');
    const select = $('#studentOrganization');
    
    if (value) {
      // Get current selections
      let currentValues = select.val() || [];
      
      // Remove the clicked value
      currentValues = currentValues.filter(v => v !== value);
      
      // Update the select
      select.val(currentValues).trigger('change');
      
      // Update counter
      updateOrganizationCounter();
      
      // Show feedback
      showFeedback(`"${value}" has been removed.`, 'warning');
      setTimeout(hideFeedback, 2000);
    }
  });
}

// Enhanced add organization functionality
function addCustomOrganization() {
  const input = document.getElementById('otherOrganization');
  const orgName = input.value.trim();
  const select = $('#studentOrganization');

  if (!orgName) {
    showFeedback('Please enter an organization name.', 'error');
    input.focus();
    return;
  }
  if (orgName.length < 3) {
    showFeedback('Organization name must be at least 3 characters long.', 'error');
    input.focus();
    return;
  }

  // Check if organization already exists
  const existingOptions = Array.from(select[0].options).map(option => option.value.toLowerCase());
  if (existingOptions.includes(orgName.toLowerCase())) {
    showFeedback('This organization is already in your list.', 'warning');
    input.focus();
    return;
  }

  // Add to database via API
  $.ajax({
    url: '/api/add-organization',
    method: 'POST',
    contentType: 'application/json',
    data: JSON.stringify({ name: orgName }),
    success: function(response) {
      // Add new option to select2
      if (select.find(`option[value="${orgName}"]`).length === 0) {
        const newOption = new Option(orgName, orgName, true, true);
        select.append(newOption);
      }
      const current = select.val() || [];
      if (!current.includes(orgName)) {
        current.push(orgName);
        select.val(current).trigger('change');
      }
      input.value = '';
      showFeedback(`"${orgName}" has been added successfully!`, 'success');
      updateOrganizationCounter();
      setTimeout(hideFeedback, 3000);
    },
    error: function(xhr) {
      if (xhr.responseJSON && xhr.responseJSON.message) {
        showFeedback(xhr.responseJSON.message, 'error');
      } else {
        showFeedback('Failed to add organization. Please try again.', 'error');
      }
    }
  });
}

// Toggle custom organization input
function toggleCustomOrg() {
  const customOrgContainer = document.getElementById('customOrgContainer');
  const isVisible = customOrgContainer.style.display !== 'none';
  customOrgContainer.style.display = isVisible ? 'none' : 'block';
  
  if (!isVisible) {
    document.getElementById('otherOrganization').focus();
  } else {
    document.getElementById('otherOrganization').value = '';
    hideFeedback();
  }
}

// ========================================
// CLIENT-SIDE VALIDATION
// ========================================

// Email validation function
function isValidEmail(email) {
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  return emailRegex.test(email);
}

// Password strength validation
function checkPasswordRequirements(password) {
  return {
    length: password.length >= 8,
    hasNumber: /\d/.test(password),
    hasLetter: /[a-zA-Z]/.test(password),
    isValid: password.length >= 8 && /\d/.test(password) && /[a-zA-Z]/.test(password)
  };
}

// Name validation: only letters, spaces, hyphens, apostrophes allowed
function isValidName(name) {
  return /^[a-zA-Z\s\-']+$/.test(name);
}

// Validation function for firstName with priority
function validateFirstName(input, showError = true) {
  const value = input.value.trim();
  
  if (!value) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('First name is required.', 'error');
    return false;
  } else if (!isValidName(value)) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('First name must only contain letters, spaces, hyphens, or apostrophes.', 'error');
    return false;
  } else {
    input.style.borderColor = '#10b981';
    if (showError) clearInstantMessage();
    return true;
  }
}

// Validation function for lastName with priority
function validateLastName(input, showError = true) {
  const value = input.value.trim();
  
  if (!value) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Last name is required.', 'error');
    return false;
  } else if (!isValidName(value)) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Last name must only contain letters, spaces, hyphens, or apostrophes.', 'error');
    return false;
  } else {
    input.style.borderColor = '#10b981';
    if (showError) clearInstantMessage();
    return true;
  }
}

// Validation function for middleName
function validateMiddleName(input, showError = true) {
  const value = input.value.trim();
  
  if (value && !isValidName(value)) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Middle name must only contain letters, spaces, hyphens, or apostrophes.', 'error');
    return false;
  } else {
    input.style.borderColor = value ? '#10b981' : '';
    if (showError && value) clearInstantMessage();
    return true;
  }
}

// Validation function for email
function validateEmail(input, showError = true) {
  const value = input.value.trim();
  
  if (!value) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Email address is required.', 'error');
    return false;
  } else if (!isValidEmail(value)) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Please enter a valid email address.', 'error');
    return false;
  } else {
    input.style.borderColor = '#10b981';
    if (showError) clearInstantMessage();
    return true;
  }
}

// Validation function for username
function validateUsername(input, showError = true) {
  const value = input.value.trim();
  
  if (!value) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Username is required.', 'error');
    return false;
  } else if (value.length < 4) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Username must be at least 4 characters long.', 'error');
    return false;
  } else {
    input.style.borderColor = '#10b981';
    if (showError) clearInstantMessage();
    return true;
  }
}

// Validation function for password
function validatePassword(input, showError = true) {
  const value = input.value;
  const passwordCheck = checkPasswordRequirements(value);
  
  if (!value) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Password is required.', 'error');
    return false;
  } else if (!passwordCheck.isValid) {
    input.style.borderColor = '#ef4444';
    if (showError) {
      // Show the first failing requirement
      if (!passwordCheck.length) {
        showInstantMessage('Password must be at least 8 characters long.', 'error');
      } else if (!passwordCheck.hasLetter) {
        showInstantMessage('Password must contain at least one letter.', 'error');
      } else if (!passwordCheck.hasNumber) {
        showInstantMessage('Password must contain at least one number.', 'error');
      }
    }
    return false;
  } else {
    input.style.borderColor = '#10b981';
    if (showError) clearInstantMessage();
    return true;
  }
}

// Validation function for confirmPassword
function validateConfirmPassword(confirmInput, passwordInput, showError = true) {
  const confirmValue = confirmInput.value;
  const passwordValue = passwordInput.value;
  
  if (!confirmValue) {
    confirmInput.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Please confirm your password.', 'error');
    return false;
  } else if (confirmValue !== passwordValue) {
    confirmInput.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Passwords do not match.', 'error');
    return false;
  } else {
    confirmInput.style.borderColor = '#10b981';
    if (showError) clearInstantMessage();
    return true;
  }
}

// Validation function for phoneNumber
function validatePhoneNumber(input, showError = true) {
  const value = input.value.replace(/\D/g, ''); // Remove non-digits for validation
  
  if (!value) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Phone number is required.', 'error');
    return false;
  } else if (value.length !== 4 && value.length !== 11) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Phone number must be either 4 digits (telephone) or 11 digits (cellphone).', 'error');
    return false;
  } else {
    input.style.borderColor = '#10b981';
    if (showError) clearInstantMessage();
    return true;
  }
}

// Validation function for studentId
function validateStudentId(input, showError = true) {
  const value = input.value.replace(/\D/g, '');
  input.value = value.slice(0, 9); // Format to max 9 digits
  
  if (!input.value) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Student ID is required for student registration.', 'error');
    return false;
  } else if (input.value.length !== 9) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Student ID must be exactly 9 digits.', 'error');
    return false;
  } else {
    input.style.borderColor = '#10b981';
    if (showError) clearInstantMessage();
    return true;
  }
}

// Validation function for CYS
function validateCYS(input, showError = true) {
  const value = input.value.trim();
  
  if (!value) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Course/Year/Section is required for student registration.', 'error');
    return false;
  } else if (!/^[A-Z]{3}[0-9]{2}$/.test(value)) {
    input.style.borderColor = '#ef4444';
    if (showError) showInstantMessage('Course/Year/Section must be 3 letters followed by 2 numbers (e.g., BSN21, ICT31).', 'error');
    return false;
  } else {
    input.style.borderColor = '#10b981';
    if (showError) clearInstantMessage();
    return true;
  }
}

// Real-time CYS formatting
document.getElementById('cys')?.addEventListener('input', function(e) {
  let value = e.target.value.toUpperCase();
  let formatted = '';
  
  for (let i = 0; i < value.length && i < 5; i++) {
    const char = value[i];
    if (i < 3) {
      if (/[A-Z]/.test(char)) formatted += char;
    } else {
      if (/[0-9]/.test(char)) formatted += char;
    }
  }
  
  e.target.value = formatted;
  validateCYS(e.target, true);
});

// Real-time phone number formatting (allow only digits)
document.querySelector('input[name="phoneNumber"]')?.addEventListener('input', function(e) {
  const value = e.target.value.replace(/\D/g, '');
  e.target.value = value;
  validatePhoneNumber(e.target, true);
});

// Real-time Student ID formatting (allow only digits, max 9)
document.getElementById('studentId')?.addEventListener('input', function(e) {
  validateStudentId(e.target, true);
});

