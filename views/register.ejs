document.querySelector('form').addEventListener('submit', function(e) {
  e.preventDefault(); // Prevent default submission first
  
  const userType = document.getElementById('userType').value;
  const firstNameInput = document.querySelector('input[name="firstName"]');
  const lastNameInput = document.querySelector('input[name="lastName"]');
  const middleNameInput = document.querySelector('input[name="middleName"]');
  const emailInput = document.querySelector('input[name="email"]');
  const usernameInput = document.querySelector('input[name="username"]');
  const passwordInput = document.querySelector('input[name="password"]');
  const confirmPasswordInput = document.querySelector('input[name="confirmPassword"]');
  const phoneNumberInput = document.querySelector('input[name="phoneNumber"]');
  const terms = document.querySelector('input[name="terms"]').checked;

  // Validate in order - stop at first error
  
  // 1. Check user type selection
  if (!userType) {
    showInstantMessage('Please select a user type (Student or Staff/Faculty).', 'error');
    document.getElementById('userTypeSelection')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return false;
  }

  // 2. Validate first name
  if (!validateFirstName(firstNameInput, true)) {
    firstNameInput.focus();
    firstNameInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return false;
  }

  // 3. Validate last name
  if (!validateLastName(lastNameInput, true)) {
    lastNameInput.focus();
    lastNameInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return false;
  }

  // 4. Validate middle name (if provided)
  if (!validateMiddleName(middleNameInput, true)) {
    middleNameInput.focus();
    middleNameInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return false;
  }

  // 5. Student-specific validation
  if (userType === 'student') {
    const studentIdInput = document.getElementById('studentId');
    const cysInput = document.getElementById('cys');
    const studentOrg = $('#studentOrganization').val();

    if (!validateStudentId(studentIdInput, true)) {
      studentIdInput.focus();
      studentIdInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return false;
    }

    if (!validateCYS(cysInput, true)) {
      cysInput.focus();
      cysInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return false;
    }

    if (!studentOrg || studentOrg.length === 0) {
      showInstantMessage('Please select at least one student organization.', 'error');
      $('#studentOrganization').select2('open');
      return false;
    }
  }

  // 6. Non-student validation
  if (userType === 'nonstudent') {
    const affiliation = $('#nonStudentOffice').val();
    
    if (!affiliation || affiliation.length === 0) {
      showInstantMessage('Please select at least one office/department.', 'error');
      $('#nonStudentOffice').select2('open');
      return false;
    }
  }

  // 7. Validate phone number
  if (!validatePhoneNumber(phoneNumberInput, true)) {
    phoneNumberInput.focus();
    phoneNumberInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return false;
  }

  // 8. Validate email
  if (!validateEmail(emailInput, true)) {
    emailInput.focus();
    emailInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return false;
  }

  // 9. Validate username
  if (!validateUsername(usernameInput, true)) {
    usernameInput.focus();
    usernameInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return false;
  }

  // 10. Validate password
  if (!validatePassword(passwordInput, true)) {
    passwordInput.focus();
    passwordInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return false;
  }

  // 11. Validate confirm password
  if (!validateConfirmPassword(confirmPasswordInput, passwordInput, true)) {
    confirmPasswordInput.focus();
    confirmPasswordInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return false;
  }

  // 12. Terms validation
  if (!terms) {
    showInstantMessage('You must agree to the Terms and Conditions to register.', 'error');
    document.querySelector('input[name="terms"]').focus();
    document.querySelector('.terms-section').scrollIntoView({ behavior: 'smooth', block: 'center' });
    return false;
  }

  // If all client-side validations pass, submit via AJAX to catch server errors
  
  const submitBtn = this.querySelector('button[type="submit"]');
  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating Account...';
  }

  // Collect form data as URLSearchParams for proper encoding
  const formData = new FormData(this);
  const urlEncodedData = new URLSearchParams();
  
  for (const [key, value] of formData.entries()) {
    urlEncodedData.append(key, value);
  }

  // Get the form action (respects invitation vs regular registration)
  const formAction = this.getAttribute('action') || '/register';

  // Submit via fetch to handle server-side errors
  fetch(formAction, {
    method: 'POST',
    body: urlEncodedData,
    headers: {
      'Content-Type': 'application/x-www-form-urlencoded',
      'Accept': 'application/json'
    }
  })
  .then(async response => {
    // Check content type to determine how to parse response
    const contentType = response.headers.get('content-type');
    
    if (contentType && contentType.includes('application/json')) {
      const data = await response.json();
      if (data.error) {
        throw new Error(data.error);
      }
      // Success - redirect to login
      if (data.success || data.redirect) {
        window.location.href = data.redirect || '/login';
        return;
      }
    } else {
      // Server returned HTML - check for error
      const html = await response.text();
      
      // Try to extract error message from the HTML using multiple patterns
      let errorMessage = null;
      
      // Pattern 1: error-message class
      const errorMatch1 = html.match(/class="error-message"[^>]*>([^<]+)</);
      if (errorMatch1 && errorMatch1[1]) {
        errorMessage = errorMatch1[1].trim();
      }
      
      // Pattern 2: Look for error in EJS rendered content
      const errorMatch2 = html.match(/<div[^>]*class="[^"]*error[^"]*"[^>]*>([\s\S]*?)<\/div>/i);
      if (!errorMessage && errorMatch2 && errorMatch2[1]) {
        errorMessage = errorMatch2[1].replace(/<[^>]+>/g, '').trim();
      }
      
      // Pattern 3: Check for common error keywords in content
      if (!errorMessage) {
        if (html.includes('already registered') || html.includes('already taken')) {
          const emailMatch = html.match(/email[^.]*already[^.]*\./i);
          const usernameMatch = html.match(/username[^.]*already[^.]*\./i);
          if (emailMatch) errorMessage = 'This email is already registered. Please use a different email.';
          else if (usernameMatch) errorMessage = 'This username is already taken. Please choose a different username.';
        }
      }
      
      // If we found an error, throw it
      if (errorMessage) {
        throw new Error(errorMessage);
      }
      
      // Check response status - if not ok, it's an error
      if (!response.ok) {
        throw new Error('Registration failed. Please check your information and try again.');
      }
      
      // If response is OK and no error found, assume success
      window.location.href = '/login';
    }
  })
  .catch(error => {
    // Show the server error message
    showInstantMessage(error.message || 'Registration failed. Please try again.', 'error');
    
    // Re-enable the submit button
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Create Account';
    }
  });

  return false;
});

// Phone number validation: only 4 digits (telephone) or 11 digits (cellphone)
document.querySelector('input[name="phoneNumber"]').addEventListener('blur', function(e) {
  const value = e.target.value.trim();
  if (value && !(value.length === 4 || value.length === 11)) {
    e.target.style.borderColor = '#ef4444';
    showMessage('Phone number must be either 4 digits (telephone) or 11 digits (cellphone).', 'error');
  } else if (value.length === 4 || value.length === 11) {
    e.target.style.borderColor = '#10b981';
  } else {
    e.target.style.borderColor = '';
  }
});

