$(document).ready(function () {
  // Initialize Student Organization Select2
  const studentOrgSelect = $('#studentOrganization');
  organizationOptions.forEach(org => {
    const option = new Option(org, org, false, false);
    studentOrgSelect.append(option);
  });

  studentOrgSelect.select2({
    placeholder: "Search or select organizations",
    allowClear: true,
    width: '100%'
  });

  // Initialize Office/Department Select2
  const nonStudentOfficeSelect = $("#nonStudentOffice");
  officeOptions.forEach(function(office) {
    nonStudentOfficeSelect.append(new Option(office, office));
  });

  nonStudentOfficeSelect.select2({
    placeholder: "Select office(s)/department(s)",
    allowClear: true,
    width: "100%"
  });
});

// Add organization functionality
document.getElementById('addOrganizationButton').addEventListener('click', function () {
  const input = document.getElementById('otherOrganization');
  const orgName = input.value.trim();

  if (orgName) {
    const select = $('#studentOrganization');

    if (select.find(`option[value="${orgName}"]`).length === 0) {
      const newOption = new Option(orgName, orgName, true, true);
      select.append(newOption);
    }

    const current = select.val() || [];
    if (!current.includes(orgName)) {
      current.push(orgName);
      select.val(current).trigger('change');
    }

    input.value = '';
  } else {
    alert('Please enter an organization name.');
  }
});

// Add office functionality
document.getElementById('addOfficeButton').addEventListener('click', function () {
  const input = document.getElementById('otherOffice');
  const officeName = input.value.trim();

  if (officeName) {
    const select = $('#nonStudentOffice');

    if (select.find(`option[value="${officeName}"]`).length === 0) {
      const newOption = new Option(officeName, officeName, true, true);
      select.append(newOption);
    }

    const current = select.val() || [];
    if (!current.includes(officeName)) {
      current.push(officeName);
      select.val(current).trigger('change');
    }

    input.value = '';
  } else {
    alert('Please enter an office/department name.');
  }
});

