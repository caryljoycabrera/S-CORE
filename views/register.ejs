$(document).ready(function () {
  const select = $('#studentOrganization');

  // Populate the dropdown from the array
  organizationOptions.forEach(org => {
    const option = new Option(org, org, false, false);
    select.append(option);
  });

  // Initialize Select2
  select.select2({
    placeholder: "Search or select organizations",
    allowClear: true
  });
});
  // Function to filter organizations based on search input
  function filterOrganizations() {
    const searchInput = document.getElementById('orgSearch').value.toLowerCase();
    const organizationList = document.getElementById('organizationList');
    const items = organizationList.getElementsByClassName('organization-item');

    for (let i = 0; i < items.length; i++) {
      const itemText = items[i].textContent.toLowerCase();
      if (itemText.includes(searchInput)) {
        items[i].style.display = '';
      } else {
        items[i].style.display = 'none';
      }
    }
  }
    // Event listener for organization selection
    document.querySelectorAll('.organization-item').forEach(item => {
      item.addEventListener('click', function() {
        const selectedOrg = this.getAttribute('data-value');
        const orgInput = document.getElementById('studentOrganization');
        if (!Array.from(orgInput.options).some(option => option.value === selectedOrg)) {
          const newOption = new Option(this.textContent, selectedOrg, true, true);
          orgInput.add(newOption);
        }
      });
    });
  document.getElementById('addOrganizationButton').addEventListener('click', function () {
  const input = document.getElementById('otherOrganization');
  const orgName = input.value.trim();

  if (orgName) {
    const select = $('#studentOrganization');

    // Check if it already exists
    if (select.find(`option[value="${orgName}"]`).length === 0) {
      const newOption = new Option(orgName, orgName, true, true);
      select.append(newOption);
    }

    // Always select the value (even if it already exists)
    const current = select.val() || [];
    if (!current.includes(orgName)) {
      current.push(orgName);
      select.val(current).trigger('change');
    }

    input.value = '';
  } else {
    alert('Please enter an organization name.');
  }
});


