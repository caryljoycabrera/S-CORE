  // Add helper function to update table row data
  function updateTableRowData(requestId, updatedData) {
    const row = document.querySelector(`[data-id="${requestId}"]`);
    if (!row) return;
    
    // Update data attributes
    if (updatedData.status) {
      row.dataset.status = updatedData.status;
      
      // Update the status badge in the table
      const statusBadge = row.querySelector('.status-badge');
      if (statusBadge) {
        statusBadge.className = `status-badge ${updatedData.status.toLowerCase().replace(' ', '-')}`;
        statusBadge.textContent = updatedData.status;
      }
    }
    
    if (updatedData.units !== undefined) {
      row.dataset.units = updatedData.units;
      
      // Update the units cell in the table
      const cells = row.querySelectorAll('td');
      if (cells[6]) { // Assigned Units column is index 6
        cells[6].textContent = updatedData.units;
      }
    }
    
    if (updatedData.formattedDeadline) {
      row.dataset.formattedDeadline = updatedData.formattedDeadline;
    }

    // Update the allRequestsData array for filtering
    const requestIndex = allRequestsData.findIndex(req => req.element === row);
    if (requestIndex !== -1) {
      if (updatedData.status) {
        allRequestsData[requestIndex].status = updatedData.status.toLowerCase();
      }
      if (updatedData.units !== undefined) {
        allRequestsData[requestIndex].units = updatedData.units.toLowerCase();
      }
    }
  }
  
  // Initialize everything
  try {
    initializeModalHandlers();
    initializeRowClickHandlers();
    initializeConversationModal();
    initializeFilters();
    console.log('🎉 All initialization complete!');
  } catch (error) {
    console.error('❌ Error during initialization:', error);
  }
});


// Enhanced Single-Select Class (for Type filter)
class EnhancedSingleSelect {
  constructor(containerId, options, placeholder = 'Select option') {
    this.container = document.getElementById(containerId);
    this.options = options;
    this.placeholder = placeholder;
    this.selectedValue = 'all'; // Default to 'all'
    this.isOpen = false;
    
    this.init();
  }
  
  init() {
    this.setupElements();
    this.attachEventListeners();
    this.updateDisplay();
  }
  
  setupElements() {
    this.display = this.container.querySelector('.single-select-display');
    this.dropdown = this.container.querySelector('.single-select-dropdown');
    this.optionsContainer = this.container.querySelector('.single-options-container');
    this.selectedText = this.display.querySelector('.single-selected-text');
  }
  
  attachEventListeners() {
    // Toggle dropdown
    this.display.addEventListener('click', (e) => {
      e.stopPropagation();
      this.toggle();
    });
    
    // Option selection
    this.optionsContainer.addEventListener('click', (e) => {
      const option = e.target.closest('.single-dropdown-option');
      if (option) {
        this.selectOption(option.dataset.value, option.textContent.trim());
      }
    });
    
    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (!this.container.contains(e.target)) {
        this.close();
      }
    });
    
    // Prevent dropdown close when clicking inside
    this.dropdown.addEventListener('click', (e) => {
      e.stopPropagation();
    });
  }
  
  selectOption(value, text) {
    this.selectedValue = value;
    this.updateDisplay();
    this.updateOptionStates();
    this.close();
    this.triggerChange();
  }
  
  updateOptionStates() {
    const options = this.optionsContainer.querySelectorAll('.single-dropdown-option');
    options.forEach(option => {
      if (option.dataset.value === this.selectedValue) {
        option.classList.add('selected');
      } else {
        option.classList.remove('selected');
      }
    });
  }
  
  updateDisplay() {
    const selectedOption = this.optionsContainer.querySelector(`[data-value="${this.selectedValue}"]`);
    this.selectedText.textContent = selectedOption ? selectedOption.textContent.trim() : this.placeholder;
  }
  
  getSelectedValue() {
    return this.selectedValue;
  }
  
  setValue(value) {
    this.selectedValue = value;
    this.updateDisplay();
    this.updateOptionStates();
    this.triggerChange();
  }
  
  reset() {
    this.selectedValue = 'all';
    this.updateDisplay();
    this.updateOptionStates();
    this.triggerChange();
  }
  
  toggle() {
    if (this.isOpen) {
      this.close();
    } else {
      this.open();
    }
  }
  
  open() {
    this.isOpen = true;
    this.display.classList.add('active');
    this.dropdown.classList.add('show');
  }
  
  close() {
    this.isOpen = false;
    this.display.classList.remove('active');
    this.dropdown.classList.remove('show');
  }
  
  triggerChange() {
    // Trigger custom event for filter updates
    const event = new CustomEvent('selectionChange', {
      detail: { value: this.selectedValue }
    });
    this.container.dispatchEvent(event);
  }
}
