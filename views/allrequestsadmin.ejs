<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>All Requests</title>
  <link rel="stylesheet" href="/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
  <style>
  .status-badge.for-revision {
  background-color: #fed7d7;
  color: #e53e3e;
}

.status-badge.archived {
  background-color: #f3f4f6;
  color: #6b7280;
}
  .deadline-badge {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 500;
    background-color: #f3f4f6;
    color: #374151;
  }
  
  .deadline-badge.near-deadline {
    background-color: #fef3c7;
    color: #d97706;
  }
  
  .deadline-badge.overdue {
    background-color: #fecaca;
    color: #dc2626;
  }

  .deadline-badge.editable-deadline:hover {
    background-color: #e5e7eb;
    cursor: pointer;
  }

  .message {
    margin-bottom: 1rem;
    max-width: 80%;
  }

  .admin-message {
    margin-left: auto;
  }

  .user-message {
    margin-right: auto;
  }

  .message-content {
    padding: 0.75rem;
    border-radius: 0.5rem;
    background: white;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .admin-message .message-content {
    background: var(--primary-green);
    color: white;
  }

  .message-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }

  .message-time {
    opacity: 0.7;
    font-size: 0.75rem;
  }

  .message-text {
    word-wrap: break-word;
  }

  .status-badge.pending {
    background-color: #fef3c7;
    color: #d97706;
  }

  .status-badge.approved {
    background-color: #dcfce7;
    color: #16a34a;
  }

  .status-badge.for-revision {
    background-color: #fed7d7;
    color: #e53e3e;
  }

  .status-badge.completed {
    background-color: #dbeafe;
    color: #3b82f6;
  }

  .status-badge.rejected {
    background-color: #fee2e2;
    color: #dc2626;
  }

  .status-badge.archived {
    background-color: #f3f4f6;
    color: #6b7280;
  }

  /* Notification Modal Styles */
  #notificationModal {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0; top: 0; width: 100vw; height: 100vh;
    background: rgba(0,0,0,0.15);
  }
  #notificationModal.flex {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #notificationModal .modal-content {
    border-radius: 10px;
    box-shadow: 0 6px 32px rgba(0,0,0,0.18);
    padding: 2em 1.5em 1.5em 1.5em;
    background: #fff;
    min-width: 260px;
    max-width: 350px;
    text-align: center;
    position: relative;
    border-left: 6px solid #f3f4f6;
  }
  #notificationModal.success .modal-content {
    border-left: 6px solid #16a34a;
  }
  #notificationModal.warning .modal-content {
    border-left: 6px solid #eab308;
  }
  #notificationModal .close {
    color: #6b7280;
    position: absolute;
    right: 10px; top: 8px;
    font-size: 1.5em;
    cursor: pointer;
    font-weight: bold;
    line-height: 1;
  }
  #notificationModal.success #notificationIcon {
    color: #16a34a;
  }
  #notificationModal.warning #notificationIcon {
    color: #eab308;
  }
  /* Confirmation Modal Styles */
  #confirmationModal {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0; top: 0; width: 100vw; height: 100vh;
    background: rgba(0,0,0,0.15);
  }
  #confirmationModal.flex {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #confirmationModal .modal-content {
    border-radius: 10px;
    box-shadow: 0 6px 32px rgba(0,0,0,0.18);
    padding: 2em 1.5em 1.5em 1.5em;
    background: #fff;
    min-width: 320px;
    max-width: 450px;
    text-align: center;
    position: relative;
    border-left: 6px solid #eab308;
  }
  #confirmationModal .close {
    color: #6b7280;
    position: absolute;
    right: 10px; top: 8px;
    font-size: 1.5em;
    cursor: pointer;
    font-weight: bold;
    line-height: 1;
  }
  #confirmationModal #confirmIcon {
    color: #eab308;
  }
  #confirmationModal .modal-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 1.5rem;
  }
  #confirmationModal .confirm-btn {
    background-color: #3b82f6;
    color: white;
    border: none;
    padding: 0.5rem 1.5rem;
    border-radius: 0.375rem;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
  }
  #confirmationModal .cancel-btn {
    background-color: #e5e7eb;
    color: #374151;
    border: none;
    padding: 0.5rem 1.5rem;
    border-radius: 0.375rem;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
  }
  #confirmationModal .confirm-btn:hover {
    background-color: #2563eb;
  }
  #confirmationModal .cancel-btn:hover {
    background-color: #d1d5db;
  }
</style>
</head>
<body>
  <div class="student-side">
    <div class="div">

      <!-- Header -->
      <div class="overlap">
        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/admin" class="text-wrapper">S-CORE ADMIN</a>
        <span class="text-wrapper-2">All Requests</span>

        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="/Picture/user.png" alt="Admin Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/admin/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>

      <!-- Section -->
      <section class="activity-section">
        <div class="section-header">
          <div class="profile-info" style="display: flex; align-items: center; gap: 1rem;">
            <div>
              <h2 style="margin-bottom: 0.25rem;">All Requests Overview</h2>
              <p style="color: #6b7280;">View and manage all user requests in one place</p>
            </div>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="tabs" style="display:flex; gap: 1rem; margin-bottom: 1rem;">
          <a href="/admin/all-requests" class="view-all-btn" style="background: var(--primary-green); color: white;">All Requests</a>
          <a href="/admin/approvals" class="view-all-btn">Approvals</a>
          <a href="/admin/services" class="view-all-btn">Services</a>
          <a href="/admin/users" class="view-all-btn">Users</a>
        </nav>

        <!-- Filter Options -->
        <div class="filter-section">
          <div class="filter-container">
            <div class="filter-group">
              <label class="filter-label">Filter by:</label>
              <div class="filter-controls">
                <div class="filter-item">
                  <label for="requestIdFilter" class="filter-sublabel">Request ID</label>
                  <input type="text" id="requestIdFilter" class="filter-input" placeholder="Search request ID...">
                </div>
                <div class="filter-item">
                  <label for="typeFilter" class="filter-sublabel">Type</label>
                  <select id="typeFilter" class="filter-select">
                    <option value="all">All Types</option>
                    <option value="Request Approval">Request Approval</option>
                    <option value="Service Request">Service Request</option>
                  </select>
                </div>
               <div class="filter-item">
                <label class="filter-sublabel">Status</label>
                <div class="custom-select-wrapper">
                  <div class="custom-select" id="statusFilter">
                    <div class="select-display">All Status</div>
                    <div class="select-dropdown" id="statusDropdown">
                      <label class="dropdown-option">
                        <input type="checkbox" value="all" checked> All Status
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="pending"> Pending
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="approved"> Approved
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="for revision"> For Revision
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="completed"> Completed
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="rejected"> Rejected
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="archived"> Archived
                      </label>
                    </div>
                  </div>
                </div>
              </div>
                <div class="filter-item">
                  <label for="studentFilter" class="filter-sublabel">User</label>
                  <input type="text" id="studentFilter" class="filter-input" placeholder="Search user name...">
                </div>
                <div class="filter-item">
                  <label for="organizationFilter" class="filter-sublabel">Office/Department/Organization</label>
                  <input type="text" id="organizationFilter" class="filter-input" placeholder="Search office/department/organization...">
                </div>
              </div>
              <br>
              <div class="filter-controls">
                <div class="filter-item">
                  <label for="dateFromFilter" class="filter-sublabel">Date From</label>
                  <input type="date" id="dateFromFilter" class="filter-input">
                </div>
                <div class="filter-item">
                  <label for="dateToFilter" class="filter-sublabel">Date To</label>
                  <input type="date" id="dateToFilter" class="filter-input">
                </div>
              </div>
            </div>
            <div class="filter-actions">
              <button id="clearFilters" class="clear-filters-btn">
                <span>🗑️</span> Clear All
              </button>
              <div class="results-count">
                <span id="resultsCount">Showing all requests</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Table -->
        <section class="table-section" style="overflow-x: auto;">
          <table class="requests-table" style="width: 100%; border-collapse: collapse; background: white;">
            <thead style="background: var(--light-green); color: var(--primary-green);">
              <tr>
                <th>Request ID</th>
                <th>Type</th>
                <th>User</th>
                <th>Project Title</th>
                <th>Office/Department/Organization</th>
                <th>Status</th>
                <th>Assigned Units</th>
                <th>Date Submitted</th>
              </tr>
            </thead>
            <tbody id="requestsTableBody">
          <% allRequests.forEach(request => { 
            // Calculate local deadline and formatted deadline string
            let localDeadline = '';
            let formattedDeadline = 'N/A';
            if (request.deadline) {
              const d = new Date(request.deadline);
              localDeadline = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
              formattedDeadline = (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
            }
          %>
          <tr class="request-row"
              data-id="<%= request._id %>"
              data-request-id="<%= request._id.toString().slice(-6) %>"
              data-type="<%= request.type %>"
              data-title="<%= request.title %>"
              data-status="<%= request.status %>"
              data-organization="<%= request.displayOrganization || request.organization %>"
              data-units="<%= request.assignedUnits || 'Not yet assigned' %>"
              data-datetime="<%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %>"
              data-date="<%= request.datetime ? request.datetime.toISOString().split('T')[0] : new Date(request.createdAt).toISOString().split('T')[0] %>"
              data-created="<%= new Date(request.createdAt).toISOString().split('T')[0] %>"
              data-description="<%= request.description %>" 
              data-file="<%= request.file || '' %>"
              data-deadline="<%= localDeadline %>"
              data-formatted-deadline="<%= formattedDeadline %>"
              data-student="<%= request.userId ? request.userId.fName + ' ' + request.userId.lName : 'Unknown' %>">
            <!-- existing table cells remain the same -->
            <td><%= request._id.toString().slice(-6) %></td>
            <td>
              <% if (request.type === 'Request Approval') { %>
                <span class="type-badge" style="padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 500; background: #dbeafe; color: #1e40af;">
                  Approval
                </span>
              <% } else { %>
                <span class="type-badge" style="padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 500; background: #fef3c7; color: #92400e;">
                  Service
                </span>
              <% } %>
            </td>
            <td><%= request.userId ? request.userId.fName + ' ' + request.userId.lName : 'Unknown' %></td>
            <td><%= request.title %></td>
            <td><%= request.displayOrganization || request.organization %></td>
            <td>
              <span class="status-badge <%= request.status.toLowerCase().replace(' ', '-') %>">
                <%= request.status %>
              </span>
            </td>
            <td><%= request.assignedUnits || 'Not yet assigned' %></td>
            <td><%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %></td>
          </tr>
          <% }); %>
        </tbody>
                  </table>

                  <% if (allRequests.length === 0) { %>
                  <div style="text-align: center; padding: 2rem; color: #6b7280;">
                    <p>No requests found.</p>
                  </div>
                  <% } %>
                </section>

                <!-- Back to Dashboard -->
                <a href="/admin" class="view-all-btn" style="margin-top: 1rem; display: inline-block;">← Back to Dashboard</a>
              </section>
            </div>
          </div>

  <!-- Request Details Modal -->
<!-- Request Details Modal -->
<div id="detailsModal" class="modal" style="display:none;">
  <div class="modal-content">
    <header class="modal-header">
      <span class="modal-title">Request Details</span>
      <span class="close" id="closeDetailsModal">&times;</span>
    </header>
    <div class="modal-body">
      <p><strong>Type:</strong> <span id="detailType"></span></p>
      <p><strong>User:</strong> <span id="detailStudent"></span></p>
      <p><strong>Title:</strong> <span id="detailTitle"></span></p>
      <p><strong>Office/Department/Organization:</strong> <span id="detailOrganization"></span></p>
      <p><strong>Description:</strong> <span id="detailDescription"></span></p>
      <p><strong>Status:</strong> <span id="detailStatus"></span></p>
      <p><strong>Assigned Units:</strong> <span id="detailUnits"></span></p>
      <p><strong>Date Submitted:</strong> <span id="detailDatetime"></span></p>
      <p id="deadlineSection" style="display: none;">
        <strong>Deadline:</strong> 
        <span id="detailDeadline" class="deadline-badge editable-deadline" style="cursor:pointer;"></span>
        <span style="font-size:0.9em;color:#6b7280;">(Click to edit)</span>
      </p>
      <div id="file-preview" style="margin-top:1rem;"></div>
      <form class="modal-form" id="updateForm" method="POST" style="margin-top: 1rem;">
        <input type="hidden" id="updateRequestId" name="requestId" />
        <div class="form-group">
          <label for="status">Status:</label>
          <select id="status" name="status">
            <!-- Options will be populated by JavaScript based on request type -->
          </select>
        </div>
        <div class="form-group" id="assignedUnitsGroup">
          <label for="assignedUnits">Assigned Units:</label>
          <select id="assignedUnits" name="assignedUnits">
            <option value="">Not yet assigned</option>
            <option value="Social Media Unit">Social Media Unit</option>
            <option value="Graphics Unit">Graphics Unit</option>
            <option value="Multimedia Unit">Multimedia Unit</option>
            <option value="Public Relations Unit">Public Relations Unit</option>
          </select>
        </div>
        <div class="form-actions">
          <button type="submit" class="view-all-btn" style="background: var(--success); color: white;">Update</button>
          <button type="button" class="view-all-btn" id="openChatFromModal" style="background: var(--primary-green); color: white;">💬 Chat</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Deadline Edit Modal -->
<div id="deadlineModal" class="modal" style="display:none;">
  <div class="modal-content">
    <header class="modal-header">
      <span class="modal-title">Edit Deadline</span>
      <span class="close" id="closeDeadlineModal">&times;</span>
    </header>
    <div class="modal-body">
      <div class="form-group">
        <label for="deadlineInput">Deadline:</label>
        <input type="datetime-local" id="deadlineInput" class="filter-input" required>
      </div>
      <div class="form-actions" style="margin-top: 1rem;">
        <button id="saveDeadlineBtn" class="view-all-btn" style="background: var(--success); color: white;">Save</button>
        <button id="cancelDeadlineBtn" class="view-all-btn" style="background: #e5e7eb; color: #374151;">Cancel</button>
      </div>
    </div>
  </div>
</div>

<!-- Conversation Modal -->
<div id="conversationModal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width: 800px; width: 90%; height: 80vh; overflow: hidden;">
    <header class="modal-header">
      <span class="modal-title">Conversation</span>
      <span class="close" id="closeConversationModal">&times;</span>
    </header>
    <div class="modal-body" style="display: flex; flex-direction: column; height: calc(100% - 60px); padding: 0; overflow: hidden;">
      <div id="messagesContainer" style="flex: 1; overflow-y: auto; padding: 1rem; background: #f9f9f9; min-height: 400px;">
      </div>
      <div style="padding: 1rem; border-top: 1px solid #e5e7eb; background: white; flex-shrink: 0;">
        <div style="display: flex; gap: 0.5rem;">
          <input type="text" id="messageInput" placeholder="Type your message..." 
                 style="flex: 1; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.375rem;">
          <button id="sendMessageBtn" class="view-all-btn" style="background: var(--primary-green); color: white;">
            Send
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Notification Modal -->
<div id="notificationModal" class="modal">
  <div class="modal-content">
    <span class="close" id="closeNotificationModal">&times;</span>
    <div id="notificationIcon" style="font-size: 2.5rem; margin-top: 10px;"></div>
    <div id="notificationMessage" style="margin: 1.2em 0 1em 0; font-size:1.1em;"></div>
  </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmationModal" class="modal">
  <div class="modal-content">
    <span class="close" id="closeConfirmationModal">&times;</span>
    <div id="confirmIcon" style="font-size: 2.5rem; margin-top: 10px;">&#9888;</div>
    <div id="confirmationMessage" style="margin: 1.2em 0 1em 0; font-size:1.1em;"></div>
    <div class="modal-actions">
      <button id="confirmYesBtn" class="confirm-btn">OK</button>
      <button id="confirmNoBtn" class="cancel-btn">Cancel</button>
    </div>
  </div>
</div>
<script>
// Global variables
const detailModal = document.getElementById("detailsModal");
const closeDetailsModal = document.getElementById("closeDetailsModal");
const typeFilter = document.getElementById("typeFilter");
const clearFiltersBtn = document.getElementById("clearFilters");
const tableBody = document.getElementById("requestsTableBody");
const allRows = Array.from(document.querySelectorAll('.request-row'));

const deadlineModal = document.getElementById("deadlineModal");
const closeDeadlineModal = document.getElementById("closeDeadlineModal");
const deadlineInput = document.getElementById("deadlineInput");
const saveDeadlineBtn = document.getElementById("saveDeadlineBtn");
const cancelDeadlineBtn = document.getElementById("cancelDeadlineBtn");
let currentRequestId = null;
let currentRequestCreatedDate = null;
let currentOriginalDeadline = null;

const conversationModal = document.getElementById("conversationModal");
const closeConversationModal = document.getElementById("closeConversationModal");
const messagesContainer = document.getElementById("messagesContainer");
const messageInput = document.getElementById("messageInput");
const sendMessageBtn = document.getElementById("sendMessageBtn");
const openChatFromModal = document.getElementById("openChatFromModal");
let currentConversationId = null;

// Modal close handlers
closeDetailsModal.onclick = () => detailModal.style.display = 'none';
closeDeadlineModal.onclick = () => deadlineModal.style.display = 'none';
closeConversationModal.onclick = () => conversationModal.style.display = 'none';
cancelDeadlineBtn.onclick = () => deadlineModal.style.display = 'none';

// Close modals when clicking outside
window.onclick = function(event) {
  if (event.target === detailModal) detailModal.style.display = 'none';
  if (event.target === deadlineModal) deadlineModal.style.display = 'none';
  if (event.target === conversationModal) conversationModal.style.display = 'none';
  if (event.target === document.getElementById('notificationModal')) {
    document.getElementById('notificationModal').style.display = 'none';
  }
  if (event.target === document.getElementById('confirmationModal')) {
    document.getElementById('confirmationModal').style.display = 'none';
  }
}

// Notification modal functions
function showNotificationModal(type, message) {
  const modal = document.getElementById('notificationModal');
  const icon = document.getElementById('notificationIcon');
  const msg = document.getElementById('notificationMessage');
  
  modal.className = 'modal ' + type + ' flex';
  if (type === "success") {
    icon.innerHTML = "&#10003;"; // checkmark
  } else if (type === "warning") {
    icon.innerHTML = "&#9888;"; // warning sign
  } else {
    icon.innerHTML = "";
  }
  msg.innerText = message;
  modal.style.display = 'flex';

  // Success: auto-close after 1s
  if (type === "success") {
    setTimeout(() => {
      modal.style.display = 'none';
    }, 1000);
  }
}

// Close notification modal by X
document.getElementById("closeNotificationModal").onclick = function() {
  document.getElementById("notificationModal").style.display = 'none';
}

// Confirmation modal functions
function showConfirmationModal(message) {
  return new Promise((resolve) => {
    const modal = document.getElementById('confirmationModal');
    const msg = document.getElementById('confirmationMessage');
    const yesBtn = document.getElementById('confirmYesBtn');
    const noBtn = document.getElementById('confirmNoBtn');
    const closeBtn = document.getElementById('closeConfirmationModal');
    
    msg.innerText = message;
    modal.className = 'modal flex';
    modal.style.display = 'flex';
    
    // Handle responses
    const handleYes = () => {
      modal.style.display = 'none';
      resolve(true);
    };
    
    const handleNo = () => {
      modal.style.display = 'none';
      resolve(false);
    };
    
    // Add event listeners (remove any existing ones first)
    yesBtn.onclick = handleYes;
    noBtn.onclick = handleNo;
    closeBtn.onclick = handleNo;
  });
}

// Deadline save handler with validation
saveDeadlineBtn.onclick = async function() {
  if (!currentRequestId || !deadlineInput.value) {
    showNotificationModal("warning", "Please select a deadline.");
    return;
  }

  const selectedDate = new Date(deadlineInput.value);
  const createdDate = new Date(currentRequestCreatedDate);
  const originalDeadline = currentOriginalDeadline ? new Date(currentOriginalDeadline) : null;
  
  // Check if selected date is before request creation date
  if (selectedDate < createdDate) {
    showNotificationModal("warning", "Deadline cannot be set before the request submission date.");
    return;
  }
  
  // Check if new deadline is earlier than original deadline
  if (originalDeadline && selectedDate < originalDeadline) {
    const userConfirmed = await showConfirmationModal("Warning: The new deadline is earlier than the original deadline. Are you sure you want to proceed?");
    if (!userConfirmed) {
      return;
    }
  }

  try {
    const response = await fetch('/admin/service/update-deadline', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        requestId: currentRequestId,
        deadline: deadlineInput.value
      })
    });

    const result = await response.json();

    if (result.success) {
      // Close only the deadline modal
      deadlineModal.style.display = 'none';
      
      // Update the deadline display in the detail modal without closing it
      const deadlineElement = document.getElementById("detailDeadline");
      const newDate = new Date(deadlineInput.value);
      const formattedDate = `${newDate.getMonth() + 1}/${newDate.getDate()}/${newDate.getFullYear()}`;
      deadlineElement.innerText = formattedDate;
      
      // Update the deadline classes based on the new date
      const today = new Date();
      today.setHours(0,0,0,0);
      newDate.setHours(0,0,0,0);
      const timeDiff = newDate - today;
      const daysDiff = Math.ceil(timeDiff / (1000 * 60 * 60 * 24));
      
      // Get current status from the modal
      const currentStatus = document.getElementById("status").value.toLowerCase();
      
      const isPastDue = daysDiff < 0;
      const isNearDeadline = daysDiff === 1 && currentStatus === 'pending';
      const isToday = daysDiff === 0;
      const isApprovedOrRevision = ['approved', 'for revision'].includes(currentStatus);
      
      // Reset classes
      deadlineElement.className = 'deadline-badge editable-deadline';
      if (isPastDue) {
        deadlineElement.classList.add('overdue');
      } else if (isNearDeadline) {
        deadlineElement.classList.add('near-deadline');
      } else if (isToday && isApprovedOrRevision) {
        deadlineElement.classList.add('overdue');
      }
      
      // Update the table row data as well
      const currentRow = document.querySelector(`[data-id="${currentRequestId}"]`);
      if (currentRow) {
        const localDeadline = newDate.getFullYear() + '-' + String(newDate.getMonth() + 1).padStart(2, '0') + '-' + String(newDate.getDate()).padStart(2, '0');
        currentRow.dataset.deadline = localDeadline;
        currentRow.dataset.formattedDeadline = formattedDate;
      }
      
      showNotificationModal("success", "Deadline updated successfully!");
      
    } else {
      showNotificationModal("warning", result.message || "Failed to update deadline. Please choose a valid future date.");
    }
  } catch (error) {
    showNotificationModal("warning", "Failed to update deadline. Please try again.");
  }
};

// Chat functions
openChatFromModal.onclick = function() {
  const requestId = document.getElementById("updateRequestId").value;
  detailModal.style.display = 'none';
  openChat(requestId);
};

function openChat(requestId) {  // Generic function name for both types
  currentConversationId = requestId;
  loadConversation(requestId);
  conversationModal.style.display = 'flex';
}

async function loadConversation(requestId) {
  try {
    const response = await fetch(`/api/conversation/${requestId}`);
    const conversation = await response.json();
    
    messagesContainer.innerHTML = '';
    
    if (conversation.messages && conversation.messages.length > 0) {
      conversation.messages.forEach(message => {
        addMessageToUI(message);
      });
      
      await fetch(`/api/conversation/${requestId}/mark-read`, {
        method: 'POST'
      });
    } else {
      messagesContainer.innerHTML = '<p style="text-align: center; color: #6b7280;">No messages yet. Start the conversation!</p>';
    }
    
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  } catch (error) {
    console.error('Error loading conversation:', error);
    messagesContainer.innerHTML = '<p style="color: red;">Error loading conversation</p>';
  }
}


function addMessageToUI(message) {
  const messageDiv = document.createElement('div');
  const isAdmin = message.senderRole === 'admin';
  const senderName = message.senderId ? `${message.senderId.fName} ${message.senderId.lName}` : 'Unknown';
  
  messageDiv.className = `message ${isAdmin ? 'admin-message' : 'user-message'}`;
  messageDiv.innerHTML = `
    <div class="message-content">
      <div class="message-header">
        <strong>${senderName}</strong>
        <span class="message-time">${new Date(message.timestamp).toLocaleString()}</span>
      </div>
      <div class="message-text">${message.content}</div>
    </div>
  `;
  
  messagesContainer.appendChild(messageDiv);
}

sendMessageBtn.onclick = async function() {
  const content = messageInput.value.trim();
  if (!content || !currentConversationId) return;

  try {
    const response = await fetch(`/api/conversation/${currentConversationId}/message`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ content })
    });

    const result = await response.json();
    
    if (result.success) {
      addMessageToUI(result.message);
      messageInput.value = '';
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    } else {
      showNotificationModal("warning", "Failed to send message");
    }
  } catch (error) {
    console.error('Error sending message:', error);
    showNotificationModal("warning", "Failed to send message");
  }
};


messageInput.addEventListener('keypress', function(e) {
  if (e.key === 'Enter') {
    sendMessageBtn.click();
  }
});

function filterRequests() {
  const requestIdValue = document.getElementById('requestIdFilter').value.trim().toLowerCase();
  const typeValue = typeFilter.value.toLowerCase();
  const selectedStatuses = getSelectedStatuses();
  const studentValue = document.getElementById('studentFilter').value.trim().toLowerCase();
  const organizationValue = document.getElementById('organizationFilter').value.trim().toLowerCase();
  const dateFromValue = document.getElementById('dateFromFilter').value;
  const dateToValue = document.getElementById('dateToFilter').value;

  let visibleCount = 0;

  allRows.forEach(row => {
    const rowRequestId = row.dataset.requestId.toLowerCase();
    const rowType = row.dataset.type.toLowerCase();
    const rowStatus = row.dataset.status.toLowerCase();
    const rowStudent = row.dataset.student.toLowerCase();
    const rowOrganization = row.dataset.organization.toLowerCase();
    const rowDate = row.dataset.date;

    // Convert dates to comparable format
    const rowDateObj = new Date(rowDate);
    const fromDateObj = dateFromValue ? new Date(dateFromValue) : null;
    const toDateObj = dateToValue ? new Date(dateToValue) : null;

    const requestIdMatch = !requestIdValue || rowRequestId.includes(requestIdValue);
    const typeMatch = typeValue === 'all' || rowType === typeValue;
    const statusMatch = selectedStatuses.length === 0 || selectedStatuses.includes('all') || selectedStatuses.includes(rowStatus);
    const studentMatch = !studentValue || rowStudent.includes(studentValue);
    const organizationMatch = !organizationValue || rowOrganization.includes(organizationValue);

    let dateMatch = true;
    if (fromDateObj && rowDateObj < fromDateObj) dateMatch = false;
    if (toDateObj && rowDateObj > toDateObj) dateMatch = false;

    // Combine all filters
    const isVisible = requestIdMatch && typeMatch && statusMatch && studentMatch && organizationMatch && dateMatch;

    row.style.display = isVisible ? '' : 'none';
    if (isVisible) visibleCount++;
  });

  const totalCount = allRows.length;
  const resultsCount = document.getElementById('resultsCount');
  resultsCount.textContent = visibleCount === totalCount
    ? `Showing all ${totalCount} requests`
    : `Showing ${visibleCount} of ${totalCount} requests`;

  toggleNoResultsMessage(visibleCount === 0);
}

function toggleNoResultsMessage(show) {
  let noResultsRow = document.getElementById('noResultsRow');
  
  if (show && !noResultsRow) {
    const tbody = document.getElementById('requestsTableBody');
    noResultsRow = document.createElement('tr');
    noResultsRow.id = 'noResultsRow';
    noResultsRow.innerHTML = `
      <td colspan="8" style="text-align: center; padding: 3rem; color: #6b7280;">
        <div style="font-size: 3rem; margin-bottom: 1rem;">🔍</div>
        <h3 style="margin-bottom: 0.5rem; color: var(--primary-green);">No requests found</h3>
        <p>Try adjusting your filters to see more results.</p>
      </td>
    `;
    tbody.appendChild(noResultsRow);
  } else if (!show && noResultsRow) {
    noResultsRow.remove();
  }
}

document.getElementById('requestIdFilter').addEventListener('input', filterRequests);
typeFilter.addEventListener('change', filterRequests);
document.getElementById('studentFilter').addEventListener('input', filterRequests);
document.getElementById('organizationFilter').addEventListener('input', filterRequests);
document.getElementById('dateFromFilter').addEventListener('change', filterRequests);
document.getElementById('dateToFilter').addEventListener('change', filterRequests);

clearFiltersBtn.addEventListener('click', () => {
  document.getElementById('requestIdFilter').value = '';
  typeFilter.value = 'all';
  document.getElementById('studentFilter').value = '';
  document.getElementById('organizationFilter').value = '';
  document.getElementById('dateFromFilter').value = '';
  document.getElementById('dateToFilter').value = '';
   // Clear status filter
  statusCheckboxes.forEach(cb => cb.checked = false);
  allStatusCheckbox.checked = true;
  updateStatusDisplay()

  filterRequests();
});

document.querySelectorAll('.request-row').forEach(row => {
  row.addEventListener('click', (e) => {
    // Prevent modal opening when clicking on deadline badge
    if (e.target.classList.contains('deadline-badge')) {
      return;
    }
    
    const requestType = row.dataset.type;
    
    document.getElementById("detailType").innerText = requestType;
    document.getElementById("detailStudent").innerText = row.dataset.student;
    document.getElementById("detailTitle").innerText = row.dataset.title;
    document.getElementById("detailOrganization").innerText = row.dataset.organization;
    document.getElementById("detailDescription").innerText = row.dataset.description || 'N/A';
    document.getElementById("detailStatus").innerText = row.dataset.status;
    document.getElementById("detailUnits").innerText = row.dataset.units;
    document.getElementById("detailDatetime").innerText = row.dataset.datetime;

    const deadlineSection = document.getElementById("deadlineSection");
    const deadlineElement = document.getElementById("detailDeadline");
    
    if (requestType === 'Service Request') {
      deadlineSection.style.display = 'block';
      const formattedDeadline = row.dataset.formattedDeadline || 'N/A';
      deadlineElement.innerText = formattedDeadline;
      
      if (formattedDeadline !== 'N/A') {
        const deadline = row.dataset.deadline;
        const status = row.dataset.status.toLowerCase();
        
        if (deadline) {
          const [year, month, day] = deadline.split('-');
          const deadlineDate = new Date(Number(year), Number(month) - 1, Number(day));
          const today = new Date();
          today.setHours(0,0,0,0);
          deadlineDate.setHours(0,0,0,0);
          const timeDiff = deadlineDate - today;
          const daysDiff = Math.ceil(timeDiff / (1000 * 60 * 60 * 24));

          const isPastDue = daysDiff < 0;
          const isNearDeadline = daysDiff === 1 && status === 'pending';
          const isToday = daysDiff === 0;
          const isApprovedOrRevision = ['approved', 'for revision'].includes(status);

          deadlineElement.className = 'deadline-badge editable-deadline';
          if (isPastDue) {
            deadlineElement.classList.add('overdue');
          } else if (isNearDeadline) {
            deadlineElement.classList.add('near-deadline');
          } else if (isToday && isApprovedOrRevision) {
            deadlineElement.classList.add('overdue');
          }
        } else {
          deadlineElement.className = 'deadline-badge editable-deadline';
        }
      } else {
        deadlineElement.className = 'deadline-badge editable-deadline';
      }
    } else {
      deadlineSection.style.display = 'none';
    }

    const updateForm = document.getElementById("updateForm");
    const assignedUnitsGroup = document.getElementById("assignedUnitsGroup");
    const statusSelect = document.getElementById("status");
    
    // Clear previous options
    statusSelect.innerHTML = '';
    
    if (requestType === 'Request Approval') {
      updateForm.action = '/admin/approval/update-status';
      assignedUnitsGroup.style.display = 'block';
      
      // Add approval status options
      const approvalStatuses = [
        { value: 'Pending', text: 'Pending' },
        { value: 'For Revision', text: 'For Revision' },
        { value: 'Approved', text: 'Approved' },
        { value: 'Rejected', text: 'Rejected' },
        { value: 'Archived', text: 'Archived' }
      ];
      
      approvalStatuses.forEach(status => {
        const option = document.createElement('option');
        option.value = status.value;
        option.textContent = status.text;
        statusSelect.appendChild(option);
      });
    } else {
      updateForm.action = '/admin/service/update-status';
      assignedUnitsGroup.style.display = 'none';
      
      // Add service status options
      const serviceStatuses = [
        { value: 'Pending', text: 'Pending' },
        { value: 'Approved', text: 'Approved' },
        { value: 'For Revision', text: 'For Revision' },
        { value: 'Completed', text: 'Completed' },
        { value: 'Rejected', text: 'Rejected' },
        { value: 'Archived', text: 'Archived' }
      ];
      
      serviceStatuses.forEach(status => {
        const option = document.createElement('option');
        option.value = status.value;
        option.textContent = status.text;
        statusSelect.appendChild(option);
      });
    }

    document.getElementById("updateRequestId").value = row.dataset.id;
    document.getElementById("status").value = row.dataset.status;
    document.getElementById("assignedUnits").value = row.dataset.units === 'Not yet assigned' ? '' : row.dataset.units;

    const file = row.dataset.file;
    const previewContainer = document.getElementById('file-preview');
    previewContainer.innerHTML = '';
    if (file) {
      const fileUrl = `/uploads/${file}`;
      const ext = file.split('.').pop().toLowerCase();
      if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext)) {
        previewContainer.innerHTML = `<img src="${fileUrl}" style="max-width:100%; border-radius:8px;" /><br><a href="${fileUrl}" target="_blank">Open Image</a>`;
      } else if (ext === 'pdf') {
        previewContainer.innerHTML = `<embed src="${fileUrl}" width="100%" height="400px" /><br><a href="${fileUrl}" target="_blank">Open PDF</a>`;
      } else {
        previewContainer.innerHTML = `<p>Click to download:</p><a href="${fileUrl}" target="_blank">Download File (${file})</a>`;
      }
    } else {
      previewContainer.innerHTML = `<p>No file uploaded.</p>`;
    }

    detailModal.style.display = 'flex';
  });
});

// Deadline badge click handler in modal
document.getElementById("detailDeadline").onclick = function() {
  const requestType = document.getElementById("detailType").innerText;
  
  // Only allow deadline editing for Service Requests
  if (requestType !== 'Service Request') {
    return;
  }
  
  const deadlineText = document.getElementById("detailDeadline").innerText;
  const requestId = document.getElementById("updateRequestId").value;
  
  // Find the current row to get creation date
  const currentRow = document.querySelector(`[data-id="${requestId}"]`);
  if (currentRow) {
    currentRequestCreatedDate = currentRow.dataset.created;
    currentOriginalDeadline = currentRow.dataset.deadline;
  }

  let currentDateISO = "";
  if (deadlineText && deadlineText !== "N/A") {
    let dt = new Date(deadlineText);
    if (isNaN(dt.getTime())) {
      const parts = deadlineText.split("/");
      if (parts.length === 3) {
        dt = new Date(`${parts[2]}-${parts[0].padStart(2, "0")}-${parts[1].padStart(2, "0")}T00:00`);
      }
    }
    if (!isNaN(dt.getTime())) {
      const tzOffset = dt.getTimezoneOffset() * 60000;
      const localISO = new Date(dt.getTime() - tzOffset).toISOString().slice(0,16);
      currentDateISO = localISO;
    }
  }
  
  currentRequestId = requestId;
  deadlineInput.value = currentDateISO;
  
  // Set minimum date to creation date
  if (currentRequestCreatedDate) {
    deadlineInput.min = currentRequestCreatedDate + 'T00:00';
  }
  
  deadlineModal.style.display = 'flex';
};

