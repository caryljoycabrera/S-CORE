      studentFilter.addEventListener('input', debounce(applyFilters, 300));
    }

    if (organizationFilter) {
      organizationFilter.addEventListener('input', debounce(applyFilters, 300));
    }

    if (dateFromFilter) {
      dateFromFilter.addEventListener('change', applyFilters);
    }

    if (dateToFilter) {
      dateToFilter.addEventListener('change', applyFilters);
    }

    if (clearFiltersBtn) {
      clearFiltersBtn.addEventListener('click', clearAllFilters);
    }

    // Apply filters function
    function applyFilters() {
      console.log('🔍 Applying filters...');
      
      const filters = {
        requestId: requestIdFilter ? requestIdFilter.value.toLowerCase().trim() : '',
        type: typeFilter ? typeFilter.value : 'all',
        status: getSelectedStatuses(),
        student: studentFilter ? studentFilter.value.toLowerCase().trim() : '',
        organization: organizationFilter ? organizationFilter.value.toLowerCase().trim() : '',
        dateFrom: dateFromFilter ? dateFromFilter.value : '',
        dateTo: dateToFilter ? dateToFilter.value : ''
      };

      console.log('Applied filters:', filters);

      let visibleCount = 0;

      allRequestsData.forEach(request => {
        let shouldShow = true;

        // Request ID filter
        if (filters.requestId && !request.requestId.toLowerCase().includes(filters.requestId)) {
          shouldShow = false;
        }

        // Type filter
        if (filters.type !== 'all' && request.type !== filters.type) {
          shouldShow = false;
        }

        // Status filter (multi-select)
        if (filters.status.length > 0 && !filters.status.includes('all')) {
          if (!filters.status.includes(request.status)) {
            shouldShow = false;
          }
        }

        // Student filter
        if (filters.student && !request.student.includes(filters.student)) {
          shouldShow = false;
        }

        // Organization filter
        if (filters.organization && !request.organization.includes(filters.organization)) {
          shouldShow = false;
        }

        // Date range filter
        if (filters.dateFrom || filters.dateTo) {
          const requestDate = request.date;
          
          if (filters.dateFrom && requestDate < filters.dateFrom) {
            shouldShow = false;
          }
          
          if (filters.dateTo && requestDate > filters.dateTo) {
            shouldShow = false;
          }
        }

        // Show/hide row
        if (shouldShow) {
          request.element.style.display = '';
          visibleCount++;
        } else {
          request.element.style.display = 'none';
        }
      });

      // Update results count
      updateResultsCount(visibleCount);
    }

    // Initialize status filter dropdown
    function initializeStatusFilter() {
      const statusFilter = document.getElementById('statusFilter');
      const statusDropdown = document.getElementById('statusDropdown');
      
      if (!statusFilter || !statusDropdown) return;

      // Toggle dropdown
      statusFilter.addEventListener('click', function(e) {
        e.stopPropagation();
        statusDropdown.style.display = statusDropdown.style.display === 'block' ? 'none' : 'block';
      });

      // Handle checkbox changes
      const checkboxes = statusDropdown.querySelectorAll('input[type="checkbox"]');
      checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
          if (this.value === 'all') {
            // If "All Status" is checked, uncheck others
            if (this.checked) {
              checkboxes.forEach(cb => {
                if (cb.value !== 'all') cb.checked = false;
              });
            }
          } else {
            // If any specific status is checked, uncheck "All Status"
            if (this.checked) {
              const allCheckbox = statusDropdown.querySelector('input[value="all"]');
              if (allCheckbox) allCheckbox.checked = false;
            }
          }

          updateStatusDisplay();
          applyFilters();
        });
      });

      // Update display text
      function updateStatusDisplay() {
        const selectDisplay = statusFilter.querySelector('.select-display');
        const checkedBoxes = Array.from(checkboxes).filter(cb => cb.checked && cb.value !== 'all');
        
        if (checkedBoxes.length === 0) {
          // If nothing is selected, check "All Status"
          const allCheckbox = statusDropdown.querySelector('input[value="all"]');
          if (allCheckbox) allCheckbox.checked = true;
          selectDisplay.textContent = 'All Status';
        } else if (checkedBoxes.length === 1) {
          selectDisplay.textContent = checkedBoxes[0].value.charAt(0).toUpperCase() + checkedBoxes[0].value.slice(1);
        } else {
          selectDisplay.textContent = `${checkedBoxes.length} selected`;
        }
      }

      // Close dropdown when clicking outside
      document.addEventListener('click', function(e) {
        if (!statusFilter.contains(e.target)) {
          statusDropdown.style.display = 'none';
        }
      });
    }

    // Get selected statuses
    function getSelectedStatuses() {
      const statusDropdown = document.getElementById('statusDropdown');
      if (!statusDropdown) return ['all'];

      const checkedBoxes = statusDropdown.querySelectorAll('input[type="checkbox"]:checked');
      return Array.from(checkedBoxes).map(cb => cb.value);
    }

    // Clear all filters
    function clearAllFilters() {
      console.log('🧹 Clearing all filters...');
      
      // Clear text inputs
      if (requestIdFilter) requestIdFilter.value = '';
      if (studentFilter) studentFilter.value = '';
      if (organizationFilter) organizationFilter.value = '';
      if (dateFromFilter) dateFromFilter.value = '';
      if (dateToFilter) dateToFilter.value = '';
      
      // Reset type filter
      if (typeFilter) typeFilter.value = 'all';
      
      // Reset status filter
      const statusDropdown = document.getElementById('statusDropdown');
      if (statusDropdown) {
        const checkboxes = statusDropdown.querySelectorAll('input[type="checkbox"]');
        checkboxes.forEach(checkbox => {
          checkbox.checked = checkbox.value === 'all';
        });
        
        const selectDisplay = statusFilter.querySelector('.select-display');
        if (selectDisplay) selectDisplay.textContent = 'All Status';
      }

      // Show all rows
      allRequestsData.forEach(request => {
        request.element.style.display = '';
      });

      // Update results count
      updateResultsCount(allRequestsData.length);
      
      showNotification('All filters cleared', 'info');
    }

    // Update results count
    function updateResultsCount(count) {
      if (resultsCount) {
        const total = allRequestsData.length;
        if (count === total) {
          resultsCount.textContent = `Showing all ${total} requests`;
        } else {
          resultsCount.textContent = `Showing ${count} of ${total} requests`;
        }
      }
    }

    // Debounce function to limit API calls
    function debounce(func, wait) {
      let timeout;
      return function executedFunction(...args) {
        const later = () => {
          clearTimeout(timeout);
          func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
      };
    }

    // Initial results count
    updateResultsCount(allRequestsData.length);
    
    console.log('✅ Filters initialized successfully');
  }
  
