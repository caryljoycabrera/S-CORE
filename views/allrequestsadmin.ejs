                  <div class="custom-select" id="statusFilter">
                    <div class="select-display">All Status</div>
                    <div class="select-dropdown" id="statusDropdown">
                      <label class="dropdown-option">
                        <input type="checkbox" value="all" checked> All Status
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="pending"> Pending
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="approved"> Approved
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="for revision"> For Revision
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="completed"> Completed
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="rejected"> Rejected
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="archived"> Archived
                      </label>
                    </div>
                  </div>
                </div>
              </div>
