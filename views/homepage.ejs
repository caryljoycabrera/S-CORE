<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>DLSU-D Strategic Communications Office | Home</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary-green: #1a5d1a;
      --secondary-green: #2d7a2d;
      --accent-green: #4caf50;
      --light-green: #e8f5e8;
      --dark-green: #0d2818;
      --gold: #ffd700;
      --text-dark: #1a2e1a;
      --text-light: #4a5d4a;
      --background: #fafcfa;
      --white: #ffffff;
      --shadow: rgba(26, 93, 26, 0.1);
      --gradient: linear-gradient(135deg, var(--primary-green) 0%, var(--secondary-green) 100%);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--background);
      color: var(--text-dark);
      line-height: 1.6;
      overflow-x: hidden;
    }

    .bg-animation {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      background: linear-gradient(45deg, #f0f8f0, #e8f5e8, #f5faf5);
      background-size: 400% 400%;
      animation: gradientShift 15s ease infinite;
    }

    .bg-animation::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: 
        radial-gradient(circle at 20% 80%, rgba(26, 93, 26, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(45, 122, 45, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 40% 40%, rgba(76, 175, 80, 0.02) 0%, transparent 50%);
    }

    @keyframes gradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .navbar {
      position: fixed;
      top: 0;
      width: 100%;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(26, 93, 26, 0.1);
      padding: 15px 0;
      z-index: 1000;
      transition: all 0.3s ease;
    }

    .navbar.scrolled {
      padding: 10px 0;
      box-shadow: 0 4px 20px rgba(26, 93, 26, 0.1);
    }

    .nav-container {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 20px;
    }

    .logo-area {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .logo-area img {
      height: 40px;
      border-radius: 12px;
      transition: transform 0.3s ease;
    }

    .logo-area img:hover {
      transform: scale(1.05);
    }

    .logo-text {
      font-family: 'Playfair Display', serif;
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--primary-green);
      user-select: none;
    }

    .nav-links {
      display: flex;
      gap: 30px;
      align-items: center;
    }

    .nav-link {
      color: var(--text-dark);
      text-decoration: none;
      font-weight: 500;
      padding: 8px 16px;
      border-radius: 8px;
      transition: all 0.3s ease;
      position: relative;
    }

    .nav-link:hover {
      color: var(--primary-green);
      background: var(--light-green);
      transform: translateY(-2px);
    }

    .nav-link.active {
      color: var(--primary-green);
      background: var(--light-green);
    }

    .cta-nav {
      background: var(--gradient) !important;
      color: var(--white) !important;
      padding: 12px 24px !important;
      border-radius: 25px !important;
      font-weight: 600 !important;
      box-shadow: 0 4px 15px rgba(26, 93, 26, 0.3);
    }

    .cta-nav:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(26, 93, 26, 0.4);
    }

    .mobile-menu-toggle {
      display: none;
      flex-direction: column;
      cursor: pointer;
      padding: 5px;
    }

    .mobile-menu-toggle span {
      width: 25px;
      height: 3px;
      background: var(--primary-green);
      margin: 3px 0;
      transition: 0.3s;
      border-radius: 2px;
    }

    .mobile-menu-toggle.active span:nth-child(1) {
      transform: rotate(-45deg) translate(-5px, 6px);
    }

    .mobile-menu-toggle.active span:nth-child(2) {
      opacity: 0;
    }

    .mobile-menu-toggle.active span:nth-child(3) {
      transform: rotate(45deg) translate(-5px, -6px);
    }

    .mobile-nav {
      display: none;
      position: fixed;
      top: 80px;
      left: 0;
      width: 100%;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(26, 93, 26, 0.1);
      box-shadow: 0 4px 20px rgba(26, 93, 26, 0.1);
      z-index: 999;
    }

    .mobile-nav.active {
      display: block;
    }

    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      padding: 20px;
      gap: 15px;
    }

    .mobile-nav .nav-link {
      padding: 15px 20px;
      font-size: 1.1rem;
      border-radius: 12px;
      text-align: center;
    }

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 120px 0 50px;
      position: relative;
      overflow: hidden;
    }

    .hero-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 20px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .hero-content h1 {
      font-family: 'Playfair Display', serif;
      font-size: 3.5rem;
      font-weight: 700;
      color: var(--text-dark);
      margin-bottom: 25px;
      line-height: 1.2;
    }

    .hero-highlight {
      background: linear-gradient(120deg, var(--accent-green) 0%, var(--gold) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-content p {
      font-size: 1.3rem;
      color: var(--text-light);
      margin-bottom: 35px;
      line-height: 1.8;
    }

    .hero-buttons {
      display: flex;
      gap: 20px;
      align-items: center;
    }

    .btn-primary {
      background: var(--gradient);
      color: var(--white);
      padding: 18px 35px;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      font-size: 1.1rem;
      transition: all 0.3s ease;
      box-shadow: 0 8px 25px rgba(26, 93, 26, 0.3);
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 35px rgba(26, 93, 26, 0.4);
    }

    .btn-secondary {
      color: var(--primary-green);
      text-decoration: none;
      font-weight: 600;
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.3s ease;
    }

    .btn-secondary:hover {
      color: var(--secondary-green);
      transform: translateX(5px);
    }

    .hero-visual {
      position: relative;
    }

    .hero-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(20px);
      border-radius: 24px;
      padding: 40px;
      box-shadow: 0 20px 60px rgba(26, 93, 26, 0.1);
      border: 1px solid rgba(26, 93, 26, 0.1);
      animation: moveUp 2s ease-out forwards;
    }

    @keyframes moveUp {
      0% { transform: translateY(0px); }
      100% { transform: translateY(-20px); }
    }

    .pledge-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.8rem;
      color: var(--primary-green);
      margin-bottom: 25px;
      text-align: center;
    }

    .pledge-item {
      margin-bottom: 20px;
    }

    .pledge-item h4 {
      color: var(--secondary-green);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
      font-size: 0.9rem;
    }

    .pledge-item p {
      color: var(--text-light);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .about-section {
      padding: 100px 0;
      background: var(--white);
    }

    .section-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .section-header {
      text-align: center;
      margin-bottom: 80px;
    }

    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: 3rem;
      color: var(--text-dark);
      margin-bottom: 20px;
    }

    .section-subtitle {
      font-size: 1.2rem;
      color: var(--text-light);
      max-width: 600px;
      margin: 0 auto;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
      margin-bottom: 80px;
    }

    .about-content h3 {
      font-size: 2rem;
      color: var(--text-dark);
      margin-bottom: 25px;
    }

    .about-content p {
      font-size: 1.1rem;
      color: var(--text-light);
      line-height: 1.8;
      margin-bottom: 20px;
    }

    .about-visual {
      position: relative;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
    }

    .feature-card {
      background: var(--light-green);
      padding: 40px 30px;
      border-radius: 20px;
      text-align: center;
      transition: all 0.3s ease;
      border: 2px solid transparent;
    }

    .feature-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 20px 40px rgba(26, 93, 26, 0.15);
      border-color: var(--accent-green);
    }

    .feature-icon {
      width: 60px;
      height: 60px;
      background: var(--gradient);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      font-size: 1.5rem;
      color: var(--white);
    }

    .feature-card h4 {
      font-size: 1.3rem;
      color: var(--text-dark);
      margin-bottom: 15px;
    }

    .feature-card p {
      color: var(--text-light);
      line-height: 1.6;
    }

    .services-section {
      padding: 100px 0;
      background: var(--light-green);
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 40px;
    }

    .service-card {
      background: var(--white);
      padding: 50px 40px;
      border-radius: 24px;
      box-shadow: 0 10px 40px rgba(26, 93, 26, 0.1);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .service-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: var(--gradient);
    }

    .service-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 60px rgba(26, 93, 26, 0.15);
    }

    .service-number {
      display: inline-block;
      background: var(--gradient);
      color: var(--white);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      text-align: center;
      line-height: 40px;
      font-weight: 700;
      margin-bottom: 20px;
    }

    .service-card h3 {
      font-size: 1.5rem;
      color: var(--text-dark);
      margin-bottom: 15px;
    }

    .service-card p {
      color: var(--text-light);
      line-height: 1.7;
    }

    .team-section {
      padding: 100px 0;
      background: var(--white);
    }

    .team-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 40px;
    }

    .team-card {
      background: var(--white);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 15px 50px rgba(26, 93, 26, 0.1);
      transition: all 0.3s ease;
      border: 2px solid var(--light-green);
    }

    .team-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 25px 70px rgba(26, 93, 26, 0.2);
      border-color: var(--accent-green);
    }

    .team-info {
      padding: 40px 30px;
    }

    .team-info h4 {
      font-size: 1.3rem;
      color: var(--text-dark);
      margin-bottom: 8px;
    }

    .team-role {
      color: var(--accent-green);
      font-weight: 600;
      margin-bottom: 15px;
      text-transform: uppercase;
      font-size: 0.9rem;
      letter-spacing: 1px;
    }

    .team-contact {
      font-size: 0.95rem;
      color: var(--text-light);
      line-height: 1.6;
    }

    .team-contact a {
      color: var(--primary-green);
      text-decoration: none;
    }

    .team-contact a:hover {
      text-decoration: underline;
    }

    .contact-section {
      padding: 100px 0;
      background: var(--dark-green);
      color: var(--white);
    }

    .contact-content {
      text-align: center;
      max-width: 1000px;
      margin: 0 auto;
    }

    .contact-content h2 {
      font-family: 'Playfair Display', serif;
      font-size: 3.5rem;
      margin-bottom: 20px;
      color: var(--white);
    }

    .contact-content .intro-text {
      font-size: 1.3rem;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 60px;
      line-height: 1.6;
    }

    .contact-cards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(2, auto);
      gap: 30px;
      margin-bottom: 60px;
    }

    .contact-card {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(20px);
      border-radius: 20px;
      padding: 40px 30px;
      text-align: center;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .contact-card:hover {
      transform: translateY(-10px);
      background: rgba(255, 255, 255, 0.15);
      border-color: var(--gold);
    }

    .contact-card-icon {
      width: 80px;
      height: 80px;
      background: var(--gold);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 25px;
      font-size: 2rem;
      color: var(--dark-green);
      font-weight: 700;
    }

    .contact-card h3 {
      font-size: 1.5rem;
      margin-bottom: 15px;
      color: var(--white);
    }

    .contact-card p {
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.6;
      margin-bottom: 15px;
    }

    .contact-card a {
      color: var(--gold);
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
    }

    .contact-card a:hover {
      color: #ffed4e;
      text-decoration: underline;
    }

    .btn-cta {
      background: var(--gold);
      color: var(--dark-green);
      padding: 20px 50px;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 700;
      font-size: 1.2rem;
      transition: all 0.3s ease;
      box-shadow: 0 10px 30px rgba(255, 215, 0, 0.3);
      display: inline-flex;
      align-items: center;
      gap: 15px;
      min-width: 280px;
      justify-content: center;
    }

    .btn-cta:hover {
      background: #ffed4e;
      transform: translateY(-3px);
      box-shadow: 0 15px 40px rgba(255, 215, 0, 0.4);
    }

    .btn-outline {
      background: transparent;
      color: var(--white);
      border: 2px solid rgba(255, 255, 255, 0.3);
    }

    .btn-outline:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: var(--gold);
      color: var(--gold);
      box-shadow: 0 10px 30px rgba(255, 215, 0, 0.2);
    }

    .social-section {
      text-align: center;
      padding-top: 30px;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
    }

    .social-section h3 {
      font-size: 1.3rem;
      margin-bottom: 25px;
      color: rgba(255, 255, 255, 0.9);
    }

    .social-links {
      display: flex;
      justify-content: center;
      gap: 20px;
    }

    .social-link {
      width: 60px;
      height: 60px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--white);
      text-decoration: none;
      font-size: 1.5rem;
      font-weight: 600;
      transition: all 0.3s ease;
      backdrop-filter: blur(10px);
      border: 2px solid transparent;
    }

    .social-link:hover {
      background: var(--gold);
      color: var(--dark-green);
      transform: translateY(-5px);
      border-color: var(--gold);
      box-shadow: 0 10px 25px rgba(255, 215, 0, 0.3);
    }

    .footer {
      background: var(--text-dark);
      color: rgba(255, 255, 255, 0.8);
      padding: 50px 0 30px;
      text-align: center;
    }

    .footer-content {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .footer p {
      margin-bottom: 10px;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: 30px;
      margin: 20px 0;
    }

    .footer-links a {
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .footer-links a:hover {
      color: var(--gold);
    }

    @media (max-width: 1024px) {
      .logo-text {
        font-size: 1.2rem;
      }

      .hero-content h1 {
        font-size: 3rem;
      }

      .section-title {
        font-size: 2.5rem;
      }

      .contact-content h2 {
        font-size: 3rem;
      }
    }

    @media (max-width: 768px) {
      .nav-links {
        display: none;
      }

      .mobile-menu-toggle {
        display: flex;
      }

      .logo-area {
        gap: 10px;
      }

      .logo-area img {
        height: 35px;
      }

      .logo-text {
        font-size: 1rem;
      }

      .hero {
        padding: 100px 0 50px;
        min-height: auto;
      }

      .hero-container,
      .about-grid {
        grid-template-columns: 1fr;
        gap: 40px;
      }

      .hero-content h1 {
        font-size: 2.2rem;
        text-align: center;
      }

      .hero-content p {
        font-size: 1.1rem;
        text-align: center;
      }

      .hero-card {
        padding: 30px 25px;
      }

      .pledge-title {
        font-size: 1.5rem;
      }

      .contact-cards {
        grid-template-columns: 1fr;
      }

      .contact-content h2 {
        font-size: 2.2rem;
      }

      .contact-content .intro-text {
        font-size: 1.1rem;
      }

      .section-title {
        font-size: 2rem;
      }

      .section-subtitle {
        font-size: 1.1rem;
      }

      .hero-buttons {
        flex-direction: column;
        align-items: stretch;
        gap: 15px;
      }

      .btn-primary,
      .btn-secondary,
      .btn-cta {
        text-align: center;
        justify-content: center;
        padding: 16px 30px;
        font-size: 1rem;
      }

      .feature-grid {
        grid-template-columns: 1fr;
        gap: 25px;
      }

      .feature-card {
        padding: 30px 25px;
      }

      .services-grid {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .service-card {
        padding: 40px 30px;
      }

      .team-grid {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .social-links {
        flex-wrap: wrap;
        gap: 15px;
      }

      .social-link {
        width: 50px;
        height: 50px;
        font-size: 1.3rem;
      }

      .contact-card {
        padding: 30px 25px;
      }

      .contact-card-icon {
        width: 60px;
        height: 60px;
        font-size: 1.5rem;
      }

      .footer-links {
        flex-direction: column;
        gap: 15px;
      }

      .about-content h3 {
        font-size: 1.6rem;
        text-align: center;
      }

      .about-content p {
        font-size: 1rem;
        text-align: center;
      }

      .btn-cta {
        min-width: auto;
        width: 100%;
        max-width: 300px;
        margin: 0 auto;
      }
    }

    @media (max-width: 480px) {
      .nav-container {
        padding: 0 15px;
      }

      .section-container {
        padding: 0 15px;
      }

      .hero-container {
        padding: 0 15px;
      }

      .logo-text {
        display: block;
        font-size: 0.9rem;
      }

      .hero-content h1 {
        font-size: 1.8rem;
        line-height: 1.3;
      }

      .hero-content p {
        font-size: 1rem;
      }

      .hero-card {
        padding: 25px 20px;
      }

      .pledge-title {
        font-size: 1.3rem;
      }

      .section-title {
        font-size: 1.8rem;
      }

      .contact-content h2 {
        font-size: 2rem;
      }

      .feature-card,
      .service-card,
      .team-card .team-info,
      .contact-card {
        padding: 25px 20px;
      }

      .btn-primary,
      .btn-secondary {
        padding: 14px 25px;
        font-size: 0.95rem;
      }

      .social-link {
        width: 45px;
        height: 45px;
        font-size: 1.2rem;
      }
    }

    .fade-in {
      opacity: 0;
      transform: translateY(30px);
      animation: fadeInUp 0.6s ease forwards;
    }

    @keyframes fadeInUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .loading {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
