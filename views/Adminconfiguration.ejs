    <div class="preview-content">
      <div class="preview-header">
        <h2>Preview Changes</h2>
        <button type="button" class="btn-close-icon" onclick="closePreview()">×</button>
      </div>
      <div class="preview-body" id="modalContent">
        <!-- Preview content will be injected here -->
      </div>
    </div>
  </div>

  <!-- Save Confirmation Modal -->
  <div id="saveConfirmModal" class="preview-modal">
    <div class="preview-content">
      <div class="preview-header">
        <h2>Confirm Save</h2>
        <button type="button" class="btn-close-icon" onclick="closeSaveConfirm()">×</button>
      </div>
      <div class="preview-body">
        <p>Are you sure you want to save these changes to the homepage? This will update the live website content.</p>
        <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem;">
          <button type="button" class="btn-close-preview" onclick="closeSaveConfirm()">Cancel</button>
          <button type="button" class="btn-save" onclick="confirmSave()" style="background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.5rem; cursor: pointer; font-weight: 600;">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Reset Confirmation Modal -->
  <div id="resetConfirmModal" class="preview-modal">
    <div class="preview-content">
      <div class="preview-header">
        <h2>Confirm Reset</h2>
        <button type="button" class="btn-close-icon" onclick="closeResetConfirm()">×</button>
      </div>
      <div class="preview-body">
        <p>Are you sure you want to reset the form? All unsaved changes will be lost.</p>
        <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem;">
          <button type="button" class="btn-close-preview" onclick="closeResetConfirm()">Cancel</button>
          <button type="button" class="btn-danger" onclick="confirmReset()" style="background: linear-gradient(135deg, #ef4444, #dc2626); color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.5rem; cursor: pointer; font-weight: 600;">Reset Form</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Restoration Confirmation Modal -->
  <div id="amRestoreModal" class="preview-modal">
    <div class="preview-content" style="max-width: 480px;">
      <div class="preview-header">
        <div style="display:flex;align-items:center;gap:12px;">
          <span style="font-size:1.5rem;">📦</span>
          <div style="display:flex;flex-direction:column;">
            <h2 style="margin:0;font-size:1.15rem;">Restore Request</h2>
            <div id="restoreTypeBadgeContainer" style="margin-top:2px;">
              <span id="restoreTypeBadge" class="am-badge"></span>
            </div>
          </div>
        </div>
        <button type="button" class="btn-close-icon" onclick="closeRestoreModal()">×</button>
      </div>
      <div class="preview-body" style="padding: 1.5rem 2rem;">
        <div style="margin-bottom: 1.5rem; padding: 1rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.75rem;">
          <p style="margin: 0 0 0.4rem 0; color: #64748b; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.025em;">Request Title</p>
          <strong id="restoreTargetName" style="display: block; color: #1e293b; font-size: 1.15rem; margin-bottom: 0.75rem; font-weight: 700;"></strong>
          
          <div style="display:flex; align-items:center; gap:8px; padding-top:0.75rem; border-top:1px dashed #cbd5e1;">
            <span style="color: #64748b; font-size: 0.85rem;">Previous Status:</span>
            <span id="restoreOriginalStatus" style="font-weight: 700; font-size:0.85rem; padding: 2px 8px; border-radius:4px; background:#f1f5f9;"></span>
          </div>
        </div>

        <div style="margin-bottom: 1.5rem;">
          <label style="display: block; font-weight: 600; color: #334155; margin-bottom: 0.75rem; font-size: 0.9rem;">Select Restoration Status:</label>
          <select id="restoreStatusSelect" 
            style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 0.6rem; font-size: 0.95rem; cursor: pointer; border-left: 4px solid #10b981; background: white;">
            <!-- Options populated by JS -->
          </select>
          <p style="margin-top: 0.75rem; font-size: 0.8rem; color: #64748b; line-height: 1.4;">
            Choose the specific status this request should return to in the active tracking system.
          </p>
        </div>

        <div style="display: flex; gap: 0.75rem; justify-content: flex-end; border-top: 1px solid #f1f5f9; padding-top: 1.25rem;">
          <button type="button" class="btn-close-preview" onclick="closeRestoreModal()" 
            style="width: auto; height: auto; padding: 0.65rem 1.25rem; border-radius: 0.5rem; background: #f1f5f9; color: #475569; font-weight: 600; font-size: 0.9rem;">
            Cancel
          </button>
          <button type="button" class="btn-save" onclick="confirmRestoreWithStatus()" 
            style="padding: 0.65rem 1.75rem; border-radius: 0.5rem; font-size: 0.9rem; font-weight: 700;">
            Confirm Restoration
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Permanent Deletion Modal -->
  <div id="amDeleteModal" class="preview-modal">
    <div class="preview-content" style="max-width: 480px;">
      <div class="preview-header" style="background: #fff1f2; border-bottom: 1px solid #ffe4e6;">
        <h2 style="color: #be123c; display:flex;align-items:center;gap:10px;">⚠️ Permanent Deletion</h2>
        <button type="button" class="btn-close-icon" onclick="closeDeleteModal()">×</button>
      </div>
      <div class="preview-body" style="padding: 1.5rem 2rem;">
        <div style="text-align: center; margin-bottom: 1.5rem;">
          <div style="font-size: 3.5rem; margin-bottom: 12px; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));">🗑️</div>
          <h3 style="color: #1e293b; margin: 0 0 0.5rem 0; font-size: 1.25rem; font-weight: 700;">Are you absolutely sure?</h3>
          <p style="color: #64748b; font-size: 0.95rem; line-height: 1.5; margin: 0;">
            You are about to permanently delete:<br>
            <strong id="deleteTargetName" style="color: #0f172a; display: block; margin-top: 6px; font-size: 1.1rem; font-weight: 700;"></strong>
          </p>
        </div>

        <div style="background: #fff7ed; border: 1px solid #ffedd5; border-left: 4px solid #f97316; padding: 1rem; border-radius: 0.75rem; margin-bottom: 1.5rem;">
          <p style="color: #9a3412; font-size: 0.85rem; font-weight: 600; margin: 0; line-height: 1.4;">
            This action CANNOT be undone. All data related to this request will be removed from the system forever.
          </p>
        </div>

        <div style="display: flex; gap: 0.75rem; justify-content: flex-end; border-top: 1px solid #f1f5f9; padding-top: 1.25rem;">
          <button type="button" class="btn-close-preview" onclick="closeDeleteModal()" 
            style="width: auto; height: auto; padding: 0.6rem 1.25rem; border-radius: 0.5rem; background: #f1f5f9; color: #475569; font-weight: 600; font-size: 0.9rem;">
            Cancel
          </button>
          <button type="button" class="btn-reset" onclick="confirmPermanentDelete()" 
            style="padding: 0.6rem 1.75rem; border-radius: 0.5rem; font-size: 0.9rem; background: linear-gradient(135deg, #ef4444, #b91c1c);">
            Delete Forever
          </button>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
