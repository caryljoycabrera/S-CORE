  <!-- MAIN CONTENT WITH HEADER -->
  <div class="admin-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="admin-menu-toggle" id="adminMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/admin" class="text-wrapper">S-CORE ADMIN</a>
      </div>
      
      <span class="text-wrapper-2">Configuration</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/admin/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

    <!-- CONFIGURATION CONTENT -->
    <div class="config-container">
      <!-- Toast Notification Area -->
      <div id="configToast" style="position:fixed;top:2rem;right:2rem;z-index:99999;min-width:200px;background:#10b981;color:white;padding:1rem 2rem;border-radius:0.5rem;box-shadow:0 2px 8px rgba(16,185,129,0.2);font-weight:600;display:none;"></div>

      <!-- Tab Navigation -->
      <div class="config-tabs">
        <button type="button" class="config-tab active" onclick="switchTab('system')">
          ⚙️ System Configuration
        </button>
        <button type="button" class="config-tab" onclick="switchTab('homepage')">
          🏠 Homepage Configuration
        </button>
        <button type="button" class="config-tab" onclick="switchTab('aboutscore')">
          📝 About S-CORE Page Configuration
        </button>
        <button type="button" class="config-tab" onclick="switchTab('archivemanager')" id="archiveManagerTabBtn">
          📦 Archive Manager
        </button>
      </div>

      <!-- Homepage Configuration Tab -->
      <div id="homepage-tab" class="tab-content">
        <!-- Header -->
        <div class="config-header">
          <h1>Homepage Configuration</h1>
          <div class="config-header-actions">
            <button type="button" id="previewBtn" class="btn-preview">
              👁️ Preview Changes
            </button>
            <button type="button" id="saveBtn" class="btn-save">
              💾 Save Changes
            </button>
            <button type="button" id="cancelBtn" class="btn-reset">
              🔄 Reset Form
            </button>
          </div>
        </div>

        <!-- Info Banner -->
        <div style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-left: 4px solid #f59e0b; padding: 1rem 1.5rem; border-radius: 0.5rem; margin-bottom: 2rem;">
          <p style="margin: 0; color: #92400e; font-weight: 500;">
            <strong>🏠 Homepage Configuration:</strong> Customize the public-facing homepage content including hero section, about information, services, team members, and contact details. Changes will be visible to all visitors.
          </p>
        </div>

        <!-- Configuration Form -->
        <form id="configurationForm" action="/admin/configuration" method="POST">
          <div class="config-sections" id="configForm">
                  <!-- Modal for Preview -->
                  <div id="configModal" class="preview-modal">
                    <div class="preview-content">
                      <div class="preview-header">
                        <h2>Preview Changes</h2>
                        <button type="button" class="btn-close-preview" onclick="closePreview()">Close</button>
                      </div>
                      <div class="preview-body" id="modalContent">
                        <!-- Preview content will be injected here -->
                      </div>
                    </div>
                  </div>
            <!-- Homepage Preview Area -->
            <div id="homepagePreview" style="display:none;padding:1rem;background:#f9fafb;border-radius:0.5rem;margin-bottom:1rem;"></div>

          <!-- Hero Section -->
          <div class="config-section">
            <h2 class="section-title">
              <span class="section-icon">🎯</span>
              Hero Section
            </h2>
            <p class="section-description">
              The main hero section that visitors see first when they land on the homepage.
            </p>

            <div class="form-group">
              <label for="heroTitle">Hero Title</label>
              <input
                type="text"
                id="heroTitle"
                name="heroTitle"
                value="<%= pageContent.heroTitle %>"
                maxlength="150"
                oninput="updateCharCount(this, 'heroTitleCount', 150)"
              >
              <div class="char-count" id="heroTitleCount"></div>
              <p class="form-hint">Main heading that appears in the hero section (before the highlighted part)</p>
            </div>

            <div class="form-group">
              <label for="heroTitleHighlight">Hero Title Highlight</label>
              <input
                type="text"
                id="heroTitleHighlight"
                name="heroTitleHighlight"
                value="<%= pageContent.heroTitleHighlight %>"
                maxlength="50"
                oninput="updateCharCount(this, 'heroTitleHighlightCount', 50)"
              >
              <div class="char-count" id="heroTitleHighlightCount"></div>
              <p class="form-hint">Highlighted part of the hero title (appears with gradient styling)</p>
            </div>

            <div class="form-group">
              <label for="heroSubtitle">Hero Subtitle</label>
              <textarea
                id="heroSubtitle"
                name="heroSubtitle"
                class="tall"
                maxlength="500"
                oninput="updateCharCount(this, 'heroSubtitleCount', 500)"
              ><%= pageContent.heroSubtitle %></textarea>
              <div class="char-count" id="heroSubtitleCount"></div>
              <p class="form-hint">Descriptive text that appears below the hero title</p>
            </div>

            <div class="form-group">
              <label for="heroPrimaryButtonText">Primary Button Text</label>
              <input
                type="text"
                id="heroPrimaryButtonText"
                name="heroPrimaryButtonText"
                value="<%= pageContent.heroPrimaryButtonText %>"
                maxlength="50"
                oninput="updateCharCount(this, 'heroPrimaryButtonTextCount', 50)"
              >
              <div class="char-count" id="heroPrimaryButtonTextCount"></div>
              <p class="form-hint">Text for the main call-to-action button</p>
            </div>

            <div class="form-group">
              <label for="heroPrimaryButtonLink">Primary Button Link</label>
              <input
                type="text"
                id="heroPrimaryButtonLink"
                name="heroPrimaryButtonLink"
                value="<%= pageContent.heroPrimaryButtonLink %>"
                maxlength="200"
              >
              <p class="form-hint">URL or anchor link (e.g., #contact, /page, https://example.com)</p>
            </div>

            <div class="form-group">
              <label for="heroSecondaryButtonText">Secondary Button Text</label>
              <input
                type="text"
                id="heroSecondaryButtonText"
                name="heroSecondaryButtonText"
                value="<%= pageContent.heroSecondaryButtonText %>"
                maxlength="50"
                oninput="updateCharCount(this, 'heroSecondaryButtonTextCount', 50)"
              >
              <div class="char-count" id="heroSecondaryButtonTextCount"></div>
              <p class="form-hint">Text for the secondary button</p>
            </div>

            <div class="form-group">
              <label for="heroSecondaryButtonLink">Secondary Button Link</label>
              <input
                type="text"
                id="heroSecondaryButtonLink"
                name="heroSecondaryButtonLink"
                value="<%= pageContent.heroSecondaryButtonLink %>"
                maxlength="200"
              >
              <p class="form-hint">URL or anchor link for secondary button</p>
            </div>
          </div>

          <!-- SCO Pledge Section -->
          <div class="config-section">
            <h2 class="section-title">
              <span class="section-icon">🤝</span>
              SCO Pledge Section
            </h2>
            <p class="section-description">
              The section title and core values that define the Strategic Communications Office's commitment. You can add, remove, or edit pledge items dynamically.
            </p>

            <div class="form-group">
              <label for="pledgeSectionTitle">Section Title</label>
              <input
                type="text"
                id="pledgeSectionTitle"
                name="pledgeSectionTitle"
                value="<%= pageContent.pledgeSectionTitle %>"
                maxlength="50"
                oninput="updateCharCount(this, 'pledgeSectionTitleCount', 50)"
              >
              <div class="char-count" id="pledgeSectionTitleCount"></div>
              <p class="form-hint">Title that appears above the pledge items</p>
            </div>

            <div class="dynamic-items-section">
              <div class="dynamic-items-header">
                <h3>Pledge Items</h3>
                <button type="button" class="btn-add-item" onclick="addPledgeItem()">
                  <span>+</span> Add Pledge Item
                </button>
              </div>
              <div id="pledgeItemsContainer" class="dynamic-items-container">
                <% 
                const pledgeItems = pageContent.pledgeItems || [];
                pledgeItems.forEach((item, index) => { %>
                <div class="dynamic-item" data-index="<%= index %>">
                  <div class="item-header">
                    <span class="item-number">Pledge <%= index + 1 %></span>
                    <button type="button" class="btn-remove-item" onclick="removePledgeItem(this)">
                      <span>×</span>
                    </button>
                  </div>
                  <div class="item-content">
                    <div class="form-group">
                      <label>Name</label>
                      <input
                        type="text"
                        name="pledgeName[]"
                        value="<%= item.name %>"
                        maxlength="50"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>Description</label>
                      <textarea
                        name="pledgeDescription[]"
                        maxlength="250"
                        required
                      ><%= item.description %></textarea>
                    </div>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- About Section -->
          <div class="config-section">
            <h2 class="section-title">
              <span class="section-icon">ℹ️</span>
              About Section
            </h2>
            <p class="section-description">
              Section title, subtitle, and information about the Strategic Communications Office's mission and vision.
            </p>

            <div class="form-group">
              <label for="aboutSectionTitle">Section Title</label>
              <input
                type="text"
                id="aboutSectionTitle"
                name="aboutSectionTitle"
                value="<%= pageContent.aboutSectionTitle %>"
                maxlength="50"
                oninput="updateCharCount(this, 'aboutSectionTitleCount', 50)"
              >
              <div class="char-count" id="aboutSectionTitleCount"></div>
              <p class="form-hint">Title that appears above the about section</p>
            </div>

            <div class="form-group">
              <label for="aboutSectionSubtitle">Section Subtitle</label>
              <input
                type="text"
                id="aboutSectionSubtitle"
                name="aboutSectionSubtitle"
                value="<%= pageContent.aboutSectionSubtitle %>"
                maxlength="100"
                oninput="updateCharCount(this, 'aboutSectionSubtitleCount', 100)"
              >
              <div class="char-count" id="aboutSectionSubtitleCount"></div>
              <p class="form-hint">Subtitle that appears below the section title</p>
            </div>

            <div class="form-group">
              <label for="aboutMissionTitle">Mission Title</label>
              <input
                type="text"
                id="aboutMissionTitle"
                name="aboutMissionTitle"
                value="<%= pageContent.aboutMissionTitle %>"
                maxlength="50"
                oninput="updateCharCount(this, 'aboutMissionTitleCount', 50)"
              >
              <div class="char-count" id="aboutMissionTitleCount"></div>
              <p class="form-hint">Title for the mission section (e.g., "Our Mission")</p>
            </div>

            <div class="form-group">
              <label for="aboutMission">Mission Statement</label>
              <textarea
                id="aboutMission"
                name="aboutMission"
                class="tall"
                maxlength="600"
                oninput="updateCharCount(this, 'aboutMissionCount', 600)"
              ><%= pageContent.aboutMission %></textarea>
              <div class="char-count" id="aboutMissionCount"></div>
            </div>

            <div class="form-group">
              <label for="aboutVisionTitle">Vision Title</label>
              <input
                type="text"
                id="aboutVisionTitle"
                name="aboutVisionTitle"
                value="<%= pageContent.aboutVisionTitle %>"
                maxlength="50"
                oninput="updateCharCount(this, 'aboutVisionTitleCount', 50)"
              >
              <div class="char-count" id="aboutVisionTitleCount"></div>
              <p class="form-hint">Title for the vision section (e.g., "Our Vision")</p>
            </div>

            <div class="form-group">
              <label for="aboutVision">Vision Statement</label>
              <textarea
                id="aboutVision"
                name="aboutVision"
                class="tall"
                maxlength="600"
                oninput="updateCharCount(this, 'aboutVisionCount', 600)"
              ><%= pageContent.aboutVision %></textarea>
              <div class="char-count" id="aboutVisionCount"></div>
            </div>

            <div class="dynamic-items-section">
              <div class="dynamic-items-header">
                <h3>About Features</h3>
                <button type="button" class="btn-add-item" onclick="addAboutFeature()">
                  <span>+</span> Add Feature
                </button>
              </div>
              <div id="aboutFeaturesContainer" class="dynamic-items-container">
                <% 
                const aboutFeatures = pageContent.aboutFeatures || [];
                aboutFeatures.forEach((feature, index) => { %>
                <div class="dynamic-item" data-index="<%= index %>">
                  <div class="item-header">
                    <span class="item-number">Feature <%= index + 1 %></span>
                    <button type="button" class="btn-remove-item" onclick="removeAboutFeature(this)">
                      <span>×</span>
                    </button>
                  </div>
                  <div class="item-content">
                    <div class="form-group">
                      <label>Icon</label>
                      <input
                        type="text"
                        name="featureIcon[]"
                        value="<%= feature.icon %>"
                        maxlength="10"
                        placeholder="📱"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>Title</label>
                      <input
                        type="text"
                        name="featureTitle[]"
                        value="<%= feature.title %>"
                        maxlength="50"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>Description</label>
                      <textarea
                        name="featureDescription[]"
                        maxlength="200"
                        required
                      ><%= feature.description %></textarea>
                    </div>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- Services Section -->
          <div class="config-section">
            <h2 class="section-title">
              <span class="section-icon">💼</span>
              Services Section
            </h2>
            <p class="section-description">
              Section title, subtitle, and the services offered by the Strategic Communications Office. You can add, remove, or edit services dynamically.
            </p>

            <div class="form-group">
              <label for="servicesSectionTitle">Section Title</label>
              <input
                type="text"
                id="servicesSectionTitle"
                name="servicesSectionTitle"
                value="<%= pageContent.servicesSectionTitle %>"
                maxlength="50"
                oninput="updateCharCount(this, 'servicesSectionTitleCount', 50)"
              >
              <div class="char-count" id="servicesSectionTitleCount"></div>
              <p class="form-hint">Title that appears above the services section</p>
            </div>

            <div class="form-group">
              <label for="servicesSectionSubtitle">Section Subtitle</label>
              <input
                type="text"
                id="servicesSectionSubtitle"
                name="servicesSectionSubtitle"
                value="<%= pageContent.servicesSectionSubtitle %>"
                maxlength="100"
                oninput="updateCharCount(this, 'servicesSectionSubtitleCount', 100)"
              >
              <div class="char-count" id="servicesSectionSubtitleCount"></div>
              <p class="form-hint">Subtitle that appears below the section title</p>
            </div>

            <div class="dynamic-items-section">
              <div class="dynamic-items-header">
                <h3>Services</h3>
                <button type="button" class="btn-add-item" onclick="addServiceItem()">
                  <span>+</span> Add Service
                </button>
              </div>
              <div id="servicesContainer" class="dynamic-items-container">
                <% 
                const services = pageContent.services || [];
                services.forEach((service, index) => { %>
