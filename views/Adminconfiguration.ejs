                    </button>
                    <button type="button" id="systemResetBtn" class="btn-reset">
                      🔄 Reset Form
                    </button>
                  </div>
                </div>

                <!-- Info Banner -->
                <div style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); border-left: 4px solid #3b82f6; padding: 1rem 1.5rem; border-radius: 0.5rem; margin-bottom: 2rem;">
                  <p style="margin: 0; color: #1e40af; font-weight: 500;">
                    <strong>ℹ️ System Configuration:</strong> All settings configured here are stored in the database and dynamically control the system behavior. Changes take effect immediately after saving.
                  </p>
                </div>

                <!-- System Configuration Form -->
                <form id="systemConfigForm" method="POST" action="/admin/system-configuration">
                  <div class="config-sections">

                    <!-- Organizations Section -->
                    <div class="config-section">
                      <h2 class="section-title">
                        <span class="section-icon">🏢</span>
                        Organizations
                      </h2>
                      <p class="section-description">
                        Manage the list of student organizations that users can select from.
                      </p>
                      <div class="form-group">
                        <label for="organizationsList">Student Organizations (one per line)</label>
                        <textarea
                          id="organizationsList"
                          name="organizationsList"
                          class="tall"
                          placeholder="University Student Government (USG)&#10;College of Business Administration and Accountancy Student Government (CBAASG)&#10;etc."
                          rows="10"
                        ><%= (settings && settings.organizations && settings.organizations.length > 0) ? (Array.isArray(settings.organizations) ? settings.organizations.map(org => typeof org === 'string' ? org : org.name).join('\n') : '') : '' %></textarea>
                        <p class="form-hint">Enter each organization on a new line</p>
                      </div>
                    </div>

                    <!-- Offices/Departments Section -->
                    <div class="config-section">
                      <h2 class="section-title">
                        <span class="section-icon">🏛️</span>
                        Offices/Departments
                      </h2>
                      <p class="section-description">
                        Manage the list of offices and departments for non-student users.
                      </p>
                      <div class="form-group">
                        <label for="officesList">Offices/Departments (one per line)</label>
                        <textarea
                          id="officesList"
                          name="officesList"
                          class="tall"
                          placeholder="Academic Affairs&#10;Student Services&#10;Administration&#10;etc."
                          rows="10"
                        ><%= (settings && settings.offices && settings.offices.length > 0) ? settings.offices.join('\n') : '' %></textarea>
                        <p class="form-hint">Enter each office/department on a new line</p>
                      </div>
                    </div>

                    <!-- Units and Request Types Management Section -->
                    <div class="config-section">
                      <h2 class="section-title">
                        <span class="section-icon">🔗</span>
                        Units & Request Types Management
                      </h2>
                      <p class="section-description">
                        Manage units and their associated request types. Each unit can handle multiple types of requests.
                      </p>
                      <div class="dynamic-items-section">
                        <div class="dynamic-items-header">
                          <h3>Units</h3>
                          <button type="button" class="btn-add-item" onclick="addUnitWithRequestTypes()">
                            <span>+</span> Add Unit
                          </button>
                        </div>
                        <div id="unitsWithRequestTypesContainer" class="dynamic-items-container">
                          <% 
                          // Get existing units and mappings from database
                          const existingUnits = (settings && settings.units) || [];
                          const mappings = (settings && settings.requestTypeMappings) || [];
                          
                          // Group request types by unit
                          const unitRequestTypes = {};
                          existingUnits.forEach(unit => {
                            const unitName = typeof unit === 'string' ? unit : unit.name || unit;
                            unitRequestTypes[unitName] = [];
                          });
                          
                          mappings.forEach(mapping => {
                            const unit = mapping.recommendedUnit;
                            if (!unitRequestTypes[unit]) {
                              unitRequestTypes[unit] = [];
                            }
                            unitRequestTypes[unit].push(mapping.requestType);
                          });
                          
                          Object.keys(unitRequestTypes).forEach((unitName, index) => { %>
                          <div class="dynamic-item unit-request-item" data-index="<%= index %>">
                            <div class="item-header">
                              <span class="item-number">Unit <%= index + 1 %>: <strong><%= unitName %></strong></span>
                              <button type="button" class="btn-remove-item" onclick="removeUnitWithRequestTypes(this)">
                                <span>×</span>
                              </button>
                            </div>
                            <div class="item-content">
                              <div class="form-group">
                                <label>Unit Name</label>
                                <input
                                  type="text"
                                  name="unitName[]"
                                  value="<%= unitName %>"
                                  maxlength="100"
                                  required
                                  onchange="updateUnitLabel(this)"
                                >
                              </div>
                              <div class="form-group">
                                <label>Request Types for this Unit (one per line)</label>
                                <textarea
                                  name="unitRequestTypes[]"
                                  class="tall"
                                  placeholder="Enter request types that this unit handles (one per line)"
                                  rows="8"
                                ><%= unitRequestTypes[unitName].join('\n') %></textarea>
                                <p class="form-hint">Enter each request type on a new line</p>
                              </div>
                            </div>
                          </div>
                          <% }); %>
                        </div>
                      </div>
                    </div>

                    <!-- Request Statuses Section -->
                    <div class="config-section">
                      <h2 class="section-title">
                        <span class="section-icon">📊</span>
                        Request Statuses
                      </h2>
                      <p class="section-description">
                        Manage the possible statuses for service requests.
                      </p>
                      <div class="form-group">
                        <label for="requestStatuses">Request Statuses (one per line)</label>
                        <textarea
                          id="requestStatuses"
                          name="requestStatuses"
                          class="tall"
                          placeholder="Pending&#10;Queued&#10;In Progress&#10;etc."
                          rows="8"
                        ><%= (settings && settings.requestStatuses && settings.requestStatuses.length > 0) ? settings.requestStatuses.join('\n') : '' %></textarea>
                        <p class="form-hint">Enter each status on a new line</p>
                      </div>
                    </div>

                    <!-- User Roles Section -->
                    <div class="config-section">
                      <h2 class="section-title">
                        <span class="section-icon">👤</span>
                        User Roles & Permissions
                      </h2>
                      <p class="section-description">
                        Manage user roles and configure their access permissions.
                      </p>
                      <div class="dynamic-items-section">
                        <div class="dynamic-items-header">
                          <h3>User Roles</h3>
                          <button type="button" class="btn-add-item" onclick="addUserRole()">
                            <span>+</span> Add Role
                          </button>
                        </div>
                        <div id="userRolesContainer" class="dynamic-items-container">
                          <% 
                          // Get user roles from database only
                          const userRoles = (settings && settings.userRoles) || [];
                          
                          userRoles.forEach((role, index) => { 
                            const roleName = typeof role === 'string' ? role : role.name;
                            const rolePerms = typeof role === 'string' ? [] : (role.permissions || []);
                          %>
                          <div class="dynamic-item" data-index="<%= index %>">
                            <div class="item-header">
                              <span class="item-number">Role <%= index + 1 %>: <strong><%= roleName %></strong></span>
                              <button type="button" class="btn-remove-item" onclick="removeUserRole(this)">
                                <span>×</span>
                              </button>
                            </div>
                            <div class="item-content">
                              <div class="form-group">
                                <label>Role Name</label>
                                <input
                                  type="text"
                                  name="roleName[]"
                                  value="<%= roleName %>"
                                  maxlength="50"
                                  required
                                  onchange="updateRoleLabel(this)"
                                >
                              </div>
                              <div class="form-group">
                                <label>Access Level</label>
                                <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 0.5rem;">
                                  <label style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 0.5rem; cursor: pointer; transition: all 0.2s;" class="role-option">
                                    <input type="radio" name="roleAccessLevel_<%= index %>" value="user" <%= rolePerms.includes('user') || (!rolePerms.includes('unit') && !rolePerms.includes('admin')) ? 'checked' : '' %> style="margin-top: 0.25rem; cursor: pointer;">
                                    <div style="flex: 1;">
                                      <div style="font-weight: 600; color: #1f2937; margin-bottom: 0.25rem;">
                                        <svg width="14" height="14" fill="none" stroke="#3b82f6" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; margin-right: 0.25rem; vertical-align: text-bottom;">
                                          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                          <circle cx="12" cy="7" r="4"/>
                                        </svg>
                                        Requestor (User) - Submits Requests
                                      </div>
                                      <div style="font-size: 0.875rem; color: #6b7280;">Can create and view their own requests</div>
                                    </div>
                                  </label>
                                  
                                  <label style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 0.5rem; cursor: pointer; transition: all 0.2s;" class="role-option">
                                    <input type="radio" name="roleAccessLevel_<%= index %>" value="unit" <%= rolePerms.includes('unit') ? 'checked' : '' %> style="margin-top: 0.25rem; cursor: pointer;">
                                    <div style="flex: 1;">
                                      <div style="font-weight: 600; color: #1f2937; margin-bottom: 0.25rem;">
                                        <svg width="14" height="14" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; margin-right: 0.25rem; vertical-align: text-bottom;">
                                          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                          <circle cx="9" cy="7" r="4"></circle>
                                          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                        </svg>
                                        Unit Member - Works on Tasks
                                      </div>
                                      <div style="font-size: 0.875rem; color: #6b7280;">Can view all requests, work on assigned tasks, and upload deliverables</div>
                                    </div>
                                  </label>
                                  
                                  <label style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 0.5rem; cursor: pointer; transition: all 0.2s;" class="role-option">
                                    <input type="radio" name="roleAccessLevel_<%= index %>" value="admin" <%= rolePerms.includes('admin') ? 'checked' : '' %> style="margin-top: 0.25rem; cursor: pointer;">
                                    <div style="flex: 1;">
                                      <div style="font-weight: 600; color: #1f2937; margin-bottom: 0.25rem;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b" style="display: inline-block; margin-right: 0.25rem; vertical-align: text-bottom;">
                                          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                                        </svg>
                                        Administrator - Full Access
                                      </div>
                                      <div style="font-size: 0.875rem; color: #6b7280;">Complete administrative access to all system features</div>
                                    </div>
                                  </label>
                                </div>
                              </div>
                            </div>
                          </div>
                          <% }); %>
                        </div>
                      </div>
                    </div>

                    <!-- Announcement Priority Levels Section -->
                    <div class="config-section">
                      <h2 class="section-title">
                        <span class="section-icon">🎯</span>
                        Announcement Priority Levels
                      </h2>
                      <p class="section-description">
                        Manage the priority levels for announcements (e.g., low, medium, high, urgent).
                      </p>
                      <div class="form-group">
                        <label for="announcementPriorities">Priority Levels (one per line)</label>
                        <textarea
                          id="announcementPriorities"
                          name="announcementPriorities"
                          class="tall"
                          placeholder="low&#10;medium&#10;high&#10;urgent"
                          rows="5"
                        ><%= (settings && settings.announcementPriorities && settings.announcementPriorities.length > 0) ? settings.announcementPriorities.join('\n') : '' %></textarea>
                        <p class="form-hint">Enter each priority level on a new line</p>
                      </div>
                    </div>

                    <!-- Announcement Types Section -->
                    <div class="config-section">
                      <h2 class="section-title">
                        <span class="section-icon">📢</span>
                        Announcement Types
                      </h2>
                      <p class="section-description">
                        Manage the types/categories of announcements (e.g., Event, News, Reminder, Update).
                      </p>
                      <div class="form-group">
                        <label for="announcementTypes">Announcement Types (one per line)</label>
                        <textarea
                          id="announcementTypes"
                          name="announcementTypes"
                          class="tall"
                          placeholder="Event&#10;News&#10;Reminder&#10;Update&#10;Maintenance"
                          rows="6"
                        ><%= (settings && settings.announcementTypes && settings.announcementTypes.length > 0) ? settings.announcementTypes.join('\n') : '' %></textarea>
                        <p class="form-hint">Enter each announcement type on a new line</p>
                      </div>
                    </div>

                    <!-- Automated Workflow & Archiving Section -->
                    <div class="config-section">
                      <h2 class="section-title">
                        <span class="section-icon">🗃️</span>
                        Automated Workflow &amp; Archiving
                      </h2>
                      <p class="section-description">
                        Configure how long requests stay active before being automatically archived. The system runs a nightly job at midnight to apply these rules.
                      </p>

                      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                        <div class="form-group">
                          <label for="archiveCompletedAfterDays">Archive Completed/Approved After (days)</label>
                          <input
                            type="number"
                            id="archiveCompletedAfterDays"
                            name="archiveCompletedAfterDays"
                            min="1"
                            max="365"
                            value="<%= (settings && settings.archiveCompletedAfterDays != null) ? settings.archiveCompletedAfterDays : 30 %>"
                          >
                          <p class="form-hint">Requests with status 'Completed' or 'Approved' will be archived after this many days of inactivity. Default: 30 days.</p>
                        </div>

                        <div class="form-group">
                          <label for="archiveRevisionAfterDays">Archive 'For Revision' After (days of inactivity)</label>
                          <input
                            type="number"
                            id="archiveRevisionAfterDays"
                            name="archiveRevisionAfterDays"
                            min="1"
                            max="365"
                            value="<%= (settings && settings.archiveRevisionAfterDays != null) ? settings.archiveRevisionAfterDays : 14 %>"
                          >
                          <p class="form-hint">Requests stuck in 'For Revision' with no updates will be archived after this many days. Default: 14 days.</p>
                        </div>
                      </div>

                      <div class="form-group" style="margin-top: 1rem;">
                        <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer;">
                          <input
                            type="checkbox"
                            id="allowUserReactivation"
                            name="allowUserReactivation"
                            <%= (settings && settings.allowUserReactivation) ? 'checked' : '' %>
                            style="width: 18px; height: 18px; cursor: pointer;"
                          >
                          <span style="font-weight: 600; color: #374151;">Allow Users to Restore Their Own Archived Requests</span>
                        </label>
                        <p class="form-hint" style="margin-top: 0.5rem; margin-left: 2rem;">If enabled, regular users can see a "Restore" button on their own archived requests. If disabled, only Admins can restore archived items.</p>
                      </div>

                      <!-- Link to Archive Manager tab -->
                      <div style="margin-top: 1.25rem; padding: 1rem 1.25rem; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 0.5rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
                        <div style="flex: 1;">
                          <p style="margin: 0; font-weight: 600; color: #0c4a6e; font-size: 0.9rem;">📦 View & manage archived requests in the Archive Manager tab.</p>
                          <p style="margin: 0.25rem 0 0 0; font-size: 0.82rem; color: #075985;">Run the archiving job or browse and restore archived records.</p>
                        </div>
                        <button type="button"
                          onclick="switchTab('archivemanager')"
                          style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #0891b2; color: white; border: none; border-radius: 6px; font-size: 0.875rem; font-weight: 600; cursor: pointer; white-space: nowrap;">
                          Go to Archive Manager →
                        </button>
                      </div>
                    </div>

                  </div>

                  <!-- Footer Actions -->
                  <div class="config-footer-actions" style="display: flex; justify-content: flex-end; gap: 1rem; padding: 2rem 0; margin-top: 2rem; border-top: 1px solid #e5e7eb;">
                    <button type="button" id="systemSaveBtnFooter" class="btn-save" onclick="document.getElementById('systemSaveBtn').click()">
                      💾 Save Changes
                    </button>
                    <button type="button" id="systemResetBtnFooter" class="btn-reset" onclick="document.getElementById('systemResetBtn').click()">
                      🔄 Reset Form
                    </button>
                  </div>
                </form>
              </div> <!-- End system-tab -->

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- ARCHIVE MANAGER TAB                                   -->
            <!-- ══════════════════════════════════════════════════════ -->
            <div id="archivemanager-tab" class="tab-content">

              <!-- ── Section 1: Archiving Settings ────────────────────── -->
              <div style="background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 24px 28px; margin-bottom: 24px;">
                <div style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 6px;">
                  <span style="font-size: 1.5rem;">💾</span>
                  <div>
                    <h2 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #1f2937;">Automated Workflow & Archiving</h2>
                    <p style="margin: 4px 0 0 0; font-size: 0.875rem; color: #6b7280;">Configure how long requests stay active before being automatically archived. The system runs a <strong style="color:#3b82f6;">nightly job at midnight</strong> to apply these rules.</p>
                  </div>
                </div>

                <hr style="border: none; border-top: 1px solid #f3f4f6; margin: 16px 0;">

                <!-- Day-limit inputs -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                  <div class="form-group">
                    <label for="archiveCompletedAfterDays2" style="font-weight:600;color:#374151;font-size:0.9rem;">Archive Completed After (days)</label>
                    <input type="number" id="archiveCompletedAfterDays2" name="archiveCompletedAfterDays"
                      value="<%= (settings && settings.archiveCompletedAfterDays != null) ? settings.archiveCompletedAfterDays : 30 %>"
                      min="0" style="margin-top:6px;width:100%;">
                    <p class="form-hint" style="color:#6b7280;font-size:0.8rem;margin-top:4px;">Finished tasks will be archived after this many days. Default: 30 days.</p>
                  </div>
                  <div class="form-group">
                    <label for="archiveApprovedAfterDays2" style="font-weight:600;color:#374151;font-size:0.9rem;">Archive Approved After (days)</label>
                    <input type="number" id="archiveApprovedAfterDays2" name="archiveApprovedAfterDays"
                      value="<%= (settings && settings.archiveApprovedAfterDays != null) ? settings.archiveApprovedAfterDays : 30 %>"
                      min="0" style="margin-top:6px;width:100%;">
                    <p class="form-hint" style="color:#6b7280;font-size:0.8rem;margin-top:4px;">Tasks approved but not started will be archived after this many days. Default: 30 days.</p>
                  </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr; gap: 20px; margin-bottom: 20px;">
                  <div class="form-group">
                    <label for="archiveRevisionAfterDays2" style="font-weight:600;color:#374151;font-size:0.9rem;">Archive 'For Revision' After (days of inactivity)</label>
                    <input type="number" id="archiveRevisionAfterDays2" name="archiveRevisionAfterDays"
                      value="<%= (settings && settings.archiveRevisionAfterDays != null) ? settings.archiveRevisionAfterDays : 14 %>"
                      min="0" style="margin-top:6px;width:100%;">
                    <p class="form-hint" style="color:#6b7280;font-size:0.8rem;margin-top:4px;">Requests stuck in 'For Revision' with no updates will be archived after this many days. Default: 14 days.</p>
                  </div>
                </div>

                <!-- Checkbox -->
                <div class="form-group" style="margin-bottom:20px;">
                  <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                    <input type="checkbox" id="allowUserReactivation2" name="allowUserReactivation"
                      <%= (settings && settings.allowUserReactivation) ? 'checked' : '' %>
                      style="width:18px;height:18px;cursor:pointer;">
                    <span style="font-weight:600;color:#374151;">Allow Users to Restore Their Own Archived Requests</span>
                  </label>
                  <p class="form-hint" style="margin-top:6px;margin-left:28px;color:#6b7280;font-size:0.82rem;">If enabled, regular users can see a "Restore" button on their own archived requests. If disabled, only Admins can restore archived items.</p>
                </div>

                <!-- Save + Run Archiving -->
                <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;padding-top:16px;border-top:1px solid #f3f4f6;">
                  <button type="button" id="archiveSettingsSaveBtn" onclick="saveArchiveSettings()"
                    style="display:inline-flex;align-items:center;gap:6px;padding:10px 20px;background:linear-gradient(135deg,#10b981,#059669);color:white;border:none;border-radius:8px;font-size:0.9rem;font-weight:600;cursor:pointer;">
                    💾 Save Settings
                  </button>
                  <button type="button" id="configRunArchivingBtn" onclick="configTriggerArchiving()"
                    style="display:inline-flex;align-items:center;gap:6px;padding:10px 18px;background:#0891b2;color:white;border:none;border-radius:8px;font-size:0.875rem;font-weight:600;cursor:pointer;">
                    <svg viewBox="0 0 24 24" fill="none" style="width:16px;height:16px;"><path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" fill="currentColor"/></svg>
                    Run Archiving Now
                  </button>
                  <div id="archivingResultMsg" style="display:none;padding:6px 14px;border-radius:6px;font-size:0.85rem;font-weight:600;"></div>
                </div>
              </div>

              <!-- ── Section 2: Archive Table Header ───────────────────── -->
              <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:12px;margin-bottom:16px;">
                <div>
                  <h2 style="margin:0;font-size:1.15rem;font-weight:700;color:#1f2937;">📦 Archived Records</h2>
                  <p style="margin:4px 0 0 0;font-size:0.85rem;color:#6b7280;">Auto-archived and manually deleted requests.
                    <span id="archiveTotalCount" style="font-weight:600;color:#374151;"></span>
                  </p>
                </div>
                <!-- Search & Filter -->
                <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;">
                  <input type="text" id="archiveSearch" placeholder="🔍 Search title, requester, org..."
                    style="padding:8px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;font-family:inherit;min-width:220px;" oninput="applyArchiveFilters()">
                  <select id="archiveTypeFilter" onchange="applyArchiveFilters()"
                    style="padding:8px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;font-family:inherit;cursor:pointer;">
                    <option value="all">All Types</option>
                    <option value="Request Approval">Approval</option>
                    <option value="Service Request">Service</option>
                  </select>
                  <select id="archiveSourceFilter" onchange="applyArchiveFilters()"
                    style="padding:8px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;font-family:inherit;cursor:pointer;">
                    <option value="all">All Sources</option>
                    <option value="auto">🤖 Auto-Archived</option>
                    <option value="deleted">🗑️ Manually Deleted</option>
                  </select>
                  <select id="archiveStatusFilter" onchange="applyArchiveFilters()"
                    style="padding:8px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;font-family:inherit;cursor:pointer;">
                    <option value="all">All Statuses</option>
                    <option value="Approved">Approved</option>
                    <option value="Completed">Completed</option>
                    <option value="For Revision">For Revision</option>
                    <option value="Deleted">Manually Deleted</option>
                  </select>
                  <button type="button" onclick="resetArchiveFilters()"
                    style="padding:8px 14px;background:#6b7280;color:white;border:none;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;">Reset</button>
                </div>
              </div>

              <!-- ── Archive Table ─────────────────────────────────────── -->
              <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;border:1px solid #e5e7eb;border-radius:10px;">
                <table id="archiveManagerTable" style="width:100%;border-collapse:collapse;table-layout:fixed;min-width:1000px;">
                  <colgroup>
                      <col style="width:7%;">
                      <col style="width:12%;">
                      <col style="width:12%;">
                      <col style="width:9%;">
                      <col style="width:8%;">
                      <col style="width:9%;">
                      <col style="width:10%;">
                      <col style="width:10%;">
                      <col style="width:9%;">
                      <col style="width:5%;">
                      <col style="width:9%;">
                    </colgroup>
                  <thead style="background:#f9fafb;border-bottom:2px solid #e5e7eb;">
                    <tr>
                      <th style="padding:12px 10px;text-align:left;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;">Type</th>
                      <th style="padding:12px 10px;text-align:left;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;">Title</th>
                      <th style="padding:12px 10px;text-align:left;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;">Organization</th>
                      <th style="padding:12px 10px;text-align:left;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;">Requester</th>
                      <th style="padding:12px 10px;text-align:left;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;">Orig. Status</th>
                        <th style="padding:12px 10px;text-align:left;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;">Archived By</th>
                        <th style="padding:12px 10px;text-align:left;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;">Archive Reason</th>
                        <th style="padding:12px 10px;text-align:left;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;">Restore Reason</th>
                      <th style="padding:12px 10px;text-align:left;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;">Date</th>
                      <th style="padding:12px 10px;text-align:left;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;">Source</th>
                      <th style="padding:12px 10px;text-align:left;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.05em;">Actions</th>
                    </tr>
                  </thead>
                  <tbody id="archiveManagerBody">
                    <% if (archivedRequests && archivedRequests.length > 0) { %>
                      <% archivedRequests.forEach(request => { %>
                        <tr class="archive-row"
                            data-request-id="<%= request._id %>"
                            data-request-type="<%= request.type %>"
                            data-title="<%= (request.title || '').toLowerCase() %>"
                            data-org="<%= (request.displayOrganization || '').toLowerCase() %>"
                            data-requester="<%= (request.userName || '').toLowerCase() %>"
                            data-archive-source="<%= request.archiveSource %>"
                            data-previous-status="<%= request.previousStatus || 'Pending' %>"
                            style="border-bottom:1px solid #f3f4f6;">
                          <td style="padding:10px 10px;overflow:hidden;">
                            <span class="<%= request.type === 'Request Approval' ? 'am-badge-approval' : 'am-badge-service' %>"
                              style="display:inline-block;padding:3px 7px;border-radius:10px;font-size:11px;font-weight:700;white-space:nowrap;">
                              <%= request.type === 'Request Approval' ? 'Approval' : 'Service' %>
                            </span>
                          </td>
                          <td style="padding:10px 10px;overflow:hidden;max-width:0;" title="<%= request.title %>">
                            <div style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:13px;font-weight:500;color:#1f2937;"><%= request.title %></div>
                          </td>
                          <td style="padding:10px 10px;overflow:hidden;max-width:0;" title="<%= request.displayOrganization %>">
                            <div style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:13px;color:#4b5563;"><%= request.displayOrganization %></div>
                          </td>
                          <td style="padding:10px 10px;overflow:hidden;max-width:0;" title="<%= request.userName %>">
                            <div style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:13px;color:#4b5563;"><%= request.userName %></div>
                          </td>
                          <td style="padding:10px 10px;overflow:hidden;">
                            <% 
                               let statusLabel = request.previousStatus || 'Draft';
                               let statusClass = 'am-status-default';
                               if (request.previousStatus === 'Approved') statusClass = 'am-status-approved';
                               else if (request.previousStatus === 'Completed') statusClass = 'am-status-completed';
                               else if (request.previousStatus === 'For Revision') statusClass = 'am-status-revision';
                               else if (request.archiveSource === 'deleted') { statusLabel = 'Deleted'; statusClass = 'am-status-deleted'; }
                            %>
                            <span class="am-status-badge <%= statusClass %>" style="font-size:10px; font-weight:700; padding:2px 6px; border-radius:6px; text-transform:uppercase;">
                              <%= statusLabel %>
                            </span>
                          </td>
                          <td style="padding:10px 10px;overflow:hidden;max-width:0;" title="<%= request.deletedByName %>">
                            <div style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:12px;color:#6b7280;"><%= request.deletedByName %></div>
                          </td>
                          <td style="padding:10px 10px;overflow:hidden;max-width:0;" title="<%= request.archiveReason || 'N/A' %>">
                            <div style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:12px;color:#6b7280;"><%= request.archiveReason || 'N/A' %></div>
                          </td>
                          <td style="padding:10px 10px;overflow:hidden;max-width:0;" title="<% let pendingReq; if(request.restorationRequests && request.restorationRequests.length){ pendingReq = request.restorationRequests.find(rr => rr.status==='pending'); } %><%= pendingReq ? pendingReq.reason : 'N/A' %>">
                            <div style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:12px;color:#6b7280;"><%= pendingReq ? pendingReq.reason : 'N/A' %></div>
                          </td>
                          <td style="padding:10px 10px;overflow:hidden;">
                            <div style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:12px;color:#6b7280;"><%= request.deletedAt ? new Date(request.deletedAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : 'N/A' %></div>
                          </td>
                          <td style="padding:10px 10px;overflow:hidden;">
                            <% if (request.archiveSource === 'auto') { %>
                              <span style="display:inline-flex;align-items:center;padding:2px 7px;border-radius:20px;font-size:10px;font-weight:700;background:#fef3c7;color:#92400e;white-space:nowrap;">Auto</span>
                            <% } else { %>
                              <span style="display:inline-flex;align-items:center;padding:2px 7px;border-radius:20px;font-size:10px;font-weight:700;background:#f3f4f6;color:#374151;white-space:nowrap;">Deleted</span>
                            <% } %>
                          </td>
                          <td style="padding:8px 10px;overflow:hidden;">
                            <div style="display:flex;gap:4px;">
                              <button onclick="amRestoreRequest('<%= request._id %>','<%= request.type %>')" 
                                title="Original Status: <%= request.previousStatus || 'Pending' %>"
                                style="display:inline-flex;align-items:center;gap:3px;padding:5px 9px;background:#10b981;color:white;border:none;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap;">
                                ↩ Restore
                              </button>
                              <button onclick="amDeleteRequest('<%= request._id %>','<%= request.type %>')" title="Delete Forever"
                                style="display:inline-flex;align-items:center;gap:3px;padding:5px 9px;background:#ef4444;color:white;border:none;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap;">
                                🗑️ Delete
                              </button>
                            </div>
                          </td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr>
                        <td colspan="8" style="padding:60px 20px;text-align:center;">
                          <div style="font-size:2.5rem;margin-bottom:12px;">📭</div>
                          <p style="font-size:16px;font-weight:600;color:#374151;margin:0 0 6px;">No archived requests</p>
                          <p style="font-size:13px;color:#9ca3af;margin:0;">Automatically archived or manually deleted requests will appear here.</p>
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>

              <!-- ── Pagination ─────────────────────────────────────────── -->
              <div style="display:flex;justify-content:center;align-items:center;gap:8px;margin-top:20px;flex-wrap:wrap;" id="archivePaginationControls">
                <button id="archivePrevBtn" onclick="archiveChangePage(archiveCurrentPage - 1)"
                  style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid #d1d5db;border-radius:8px;background:white;cursor:pointer;font-size:14px;color:#374151;" disabled>
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"/></svg>
                </button>
                <div id="archivePageNumbers" style="display:flex;gap:4px;"></div>
                <button id="archiveNextBtn" onclick="archiveChangePage(archiveCurrentPage + 1)"
                  style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid #d1d5db;border-radius:8px;background:white;cursor:pointer;font-size:14px;color:#374151;" disabled>
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
                </button>
              </div>


            </div>
          </div>
        </div> <!-- End admin-main-content -->
        <!-- Add global tab switching function at end of body -->
          <script>
            // ── Archiving trigger from Configuration page ─────────────────────
            async function configTriggerArchiving() {
              const btn = document.getElementById('configRunArchivingBtn');
              const msgDiv = document.getElementById('archivingResultMsg');

              if (btn) { btn.disabled = true; btn.textContent = '⏳ Running...'; }
              if (msgDiv) { msgDiv.style.display = 'none'; }

              try {
                const response = await fetch('/admin/run-archiving-now', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
                });
                const data = await response.json();

                if (msgDiv) {
                  msgDiv.style.display = 'block';
                  if (data.success) {
                    msgDiv.style.background = '#dcfce7';
                    msgDiv.style.color = '#166534';
                    msgDiv.style.border = '1px solid #86efac';
                    msgDiv.textContent = '✅ ' + data.message + ' Refreshing list...';
                    
                    setTimeout(() => {
                      window.location.reload();
                    }, 1000);
                  } else {
                    msgDiv.style.background = '#fee2e2';
                    msgDiv.style.color = '#991b1b';
                    msgDiv.style.border = '1px solid #fca5a5';
                    msgDiv.textContent = '❌ ' + (data.message || 'Archiving failed.');
                  }
                }
              } catch (err) {
                if (msgDiv) {
                  msgDiv.style.display = 'block';
                  msgDiv.style.background = '#fee2e2';
                  msgDiv.style.color = '#991b1b';
                  msgDiv.style.border = '1px solid #fca5a5';
                  msgDiv.textContent = '❌ Could not reach server. Is it running?';
                }
              } finally {
                if (btn) {
                  btn.disabled = false;
                  btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" style="width:18px;height:18px;"><path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" fill="currentColor"/></svg> Run Archiving Now`;
                }
              }
            }
            window.configTriggerArchiving = configTriggerArchiving;

            // Tab switching function
            function switchTab(tabName) {
                    // Hide all tabs
                    const tabs = document.querySelectorAll('.tab-content');
                    tabs.forEach(tab => tab.classList.remove('active'));

                    // Remove active class from all tab buttons
                    const tabButtons = document.querySelectorAll('.config-tab');
                    tabButtons.forEach(button => button.classList.remove('active'));

                    // Show selected tab
                    const selectedTab = document.getElementById(tabName + '-tab');
                    if (selectedTab) {
                      selectedTab.classList.add('active');
                    }

                    // Add active class to clicked button
                    const activeButton = document.querySelector(`[onclick="switchTab('${tabName}')"]`);
                    if (activeButton) {
                      activeButton.classList.add('active');
                    }
                    // Store active tab in localStorage
                    localStorage.setItem('activeConfigTab', tabName);
                  }
                  // Expose to global scope
                  window.switchTab = switchTab;

                  // On page load, restore active tab — URL param takes priority over localStorage
                  document.addEventListener('DOMContentLoaded', function () {
                    const urlParams = new URLSearchParams(window.location.search);
                    const urlTab = urlParams.get('tab');
                    const savedTab = urlTab || localStorage.getItem('activeConfigTab') || 'system';
                    switchTab(savedTab);
                  });

                  // ── Archive Manager: Pagination + Filter (unified) ──────────
                  const ARCHIVE_PAGE_SIZE = 10;
                  let archiveCurrentPage = 1;
                  let archiveAllRows = [];      // ALL rows, never changes
                  let archiveFilteredRows = []; // rows matching current filter

                  function archiveInit() {
                    archiveAllRows = Array.from(document.querySelectorAll('#archiveManagerBody .archive-row'));
                    archiveApplyFilter(); // sets filteredRows and renders page 1
                  }

                  function archiveApplyFilter() {
                    const search = (document.getElementById('archiveSearch')?.value || '').toLowerCase();
                    const typeFilter = document.getElementById('archiveTypeFilter')?.value || 'all';
                    const sourceFilter = document.getElementById('archiveSourceFilter')?.value || 'all';
                    const statusFilter = document.getElementById('archiveStatusFilter')?.value || 'all';

                    archiveFilteredRows = archiveAllRows.filter(row => {        
                      const title     = row.dataset.title || '';
                      const org       = row.dataset.org || '';
                      const requester = row.dataset.requester || '';
                      const type      = row.dataset.requestType || '';
                      const source    = row.dataset.archiveSource || '';        
                      const prevStatus = (row.dataset.previousStatus || 'Pending').toLowerCase();

                      const okSearch  = !search || title.includes(search) || org.includes(search) || requester.includes(search);
                      const okType    = typeFilter === 'all' || type === typeFilter;
                      const okSource  = sourceFilter === 'all' || source === sourceFilter;
                      const okStatus  = statusFilter === 'all' || prevStatus === statusFilter.toLowerCase();

                      return okSearch && okType && okSource && okStatus;
                    archiveRenderPage(1);
                  }

                  function archiveRenderPage(page) {
                    const total = archiveFilteredRows.length;
                    const totalPages = Math.max(1, Math.ceil(total / ARCHIVE_PAGE_SIZE));
                    if (page < 1) page = 1;
                    if (page > totalPages) page = totalPages;
                    archiveCurrentPage = page;

                    const start = (page - 1) * ARCHIVE_PAGE_SIZE;
                    const end   = Math.min(start + ARCHIVE_PAGE_SIZE, total);

                    // Show only current-page rows; all others stay hidden
                    archiveFilteredRows.forEach((r, i) => {
                      r.style.display = (i >= start && i < end) ? '' : 'none';
                    });

                    // Count label — shows range + total
                    const countEl = document.getElementById('archiveTotalCount');
                    if (countEl) {
                      if (total === 0) {
                        countEl.textContent = '(0 records)';
                      } else {
                        countEl.textContent = `(${start + 1}–${end} of ${total} record${total !== 1 ? 's' : ''})`;
                      }
                    }

                    // Prev / Next buttons
                    const prevBtn = document.getElementById('archivePrevBtn');
                    const nextBtn = document.getElementById('archiveNextBtn');
                    if (prevBtn) prevBtn.disabled = page <= 1;
                    if (nextBtn) nextBtn.disabled = page >= totalPages;

                    // Numbered page buttons
                    const numbersEl = document.getElementById('archivePageNumbers');
                    if (!numbersEl) return;
                    numbersEl.innerHTML = '';
                    if (totalPages <= 1) return;

                    const pgStyle = (active) =>
                      `display:inline-flex;align-items:center;justify-content:center;min-width:34px;height:34px;`+
                      `padding:0 6px;border:1px solid ${active?'#10b981':'#d1d5db'};border-radius:7px;`+
                      `background:${active?'#10b981':'white'};color:${active?'white':'#374151'};`+
                      `font-size:13px;font-weight:${active?700:400};cursor:pointer;transition:all .15s;`;

                    const mkPageBtn = (p) => {
                      const b = document.createElement('button');
                      b.textContent = p;
                      b.setAttribute('style', pgStyle(p === page));
                      b.onclick = () => archiveGoToPage(p);
                      numbersEl.appendChild(b);
                    };
                    const mkEllipsis = () => {
                      const s = document.createElement('span');
                      s.textContent = '…';
                      s.style.cssText = 'padding:0 4px;color:#9ca3af;line-height:34px;font-size:14px;';
                      numbersEl.appendChild(s);
                    };

                    if (totalPages <= 7) {
                      for (let p = 1; p <= totalPages; p++) mkPageBtn(p);
                    } else {
                      mkPageBtn(1);
                      if (page > 3) mkEllipsis();
                      const lo = Math.max(2, page - 1);
                      const hi = Math.min(totalPages - 1, page + 1);
                      for (let p = lo; p <= hi; p++) mkPageBtn(p);
                      if (page < totalPages - 2) mkEllipsis();
                      mkPageBtn(totalPages);
                    }
                  }

                  window.archiveChangePage = function(page) { archiveGoToPage(page); };
                  function archiveGoToPage(page) { archiveRenderPage(page); }

                  // Public filter hooks (called from HTML oninput/onchange)
                  window.applyArchiveFilters = function() { archiveApplyFilter(); };
                  window.resetArchiveFilters = function() {
                    const s   = document.getElementById('archiveSearch');
                    const t   = document.getElementById('archiveTypeFilter');
                    const src = document.getElementById('archiveSourceFilter');
                    const stat = document.getElementById('archiveStatusFilter');
                    if (s)   s.value   = '';
                    if (t)   t.value   = 'all';
                    if (src) src.value = 'all';
                    if (stat) stat.value = 'all';
                  let currentRestoreId = null;
                  let currentRestoreType = null;

                  window.amRestoreRequest = function(id, type) {
                    currentRestoreId = id;
                    currentRestoreType = type;
                    
                    const row = document.querySelector(`tr[data-request-id="${id}"]`);
                    // Ensure we get the title and previous status from the row data
                    const title = row ? row.dataset.title.toUpperCase() : 'REQUEST';
                    const prevStatus = row ? row.dataset.previousStatus : 'Pending';
                    const requestType = row ? (row.dataset.type || type) : type;
                    
                    document.getElementById('restoreTargetName').textContent = title;
                    document.getElementById('restoreOriginalStatus').textContent = prevStatus;
                    
                    // Update Badge and Status Dropdown
                    const badge = document.getElementById('restoreTypeBadge');
                    const select = document.getElementById('restoreStatusSelect');
                    if (badge && select) {
                      select.innerHTML = ''; // Clear existing options
                      
                      const isService = (requestType.toLowerCase().includes('service'));
                      
                      if (isService) {
                        badge.textContent = 'Service';
                        badge.className = 'am-badge am-badge-service';
                        const statuses = ['Pending', 'Queued', 'In Progress', 'For Checking', 'Approved', 'For Revision', 'Completed', 'Rejected'];
                        statuses.forEach(s => {
                          const opt = document.createElement('option');
                          opt.value = opt.textContent = s;
                          select.appendChild(opt);
                        });
                        select.style.borderLeftColor = '#10b981';
                      } else {
                        badge.textContent = 'Approval';
                        badge.className = 'am-badge am-badge-approval';
                        const statuses = ['Pending', 'Queued', 'In Progress', 'For Revision', 'Approved', 'Rejected', 'Completed'];
                        statuses.forEach(s => {
                          const opt = document.createElement('option');
                          opt.value = opt.textContent = s;
                          select.appendChild(opt);
                        });
                        select.style.borderLeftColor = '#3b82f6';
                      }
                      
                      // Pre-select the original status if it exists in the new list, otherwise default to Pending
                      // Handle 'Archived' specifically by defaulting to Pending if it was the previous state
                      const normalizedPrev = (prevStatus === 'Archived' || prevStatus === 'ARCHIVED') ? 'Pending' : prevStatus;
                      
                      let matchFound = false;
                      for (let i = 0; i < select.options.length; i++) {
                        if (select.options[i].value.toLowerCase() === normalizedPrev.toLowerCase()) {
                          select.selectedIndex = i;
                          matchFound = true;
                          break;
                        }
                      }
                      if (!matchFound) select.value = 'Pending';
                    }
                    
                    document.getElementById('amRestoreModal').classList.add('active');
                  };

                  window.closeRestoreModal = function() {
                    document.getElementById('amRestoreModal').classList.remove('active');
                    currentRestoreId = null;
                    currentRestoreType = null;
                  };

                  window.confirmRestoreWithStatus = async function() {
                    if (!currentRestoreId) return;
                    
                    const newStatus = document.getElementById('restoreStatusSelect').value;
                    const btn = document.querySelector('#amRestoreModal .btn-save');
                    const originalText = btn.textContent;
                    
                    btn.disabled = true;
                    btn.textContent = '⏳ Restoring...';
                    
                    try {
                      const res = await fetch('/admin/request/restore', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({ 
                          requestId: currentRestoreId, 
                          requestType: currentRestoreType,
                          newStatus: newStatus
                        })
                      });
                      const data = await res.json();
                      if (data.success) {
                        const row = document.querySelector(`tr[data-request-id="${currentRestoreId}"]`);
                        if (row) row.remove();
                        window.showToast && window.showToast(`✅ Request restored to ${newStatus}.`);
                        closeRestoreModal();
                        
                        // Highlight the Run Archiving button as a hint
                        const runBtn = document.getElementById('configRunArchivingBtn');
                        if (runBtn) runBtn.style.outline = '2px solid #10b981';
                      } else {
                        alert('Restore failed: ' + (data.message || 'Unknown error'));
                      }
                    } catch (e) {
                      alert('Network error. Try again.');
                    } finally {
                      btn.disabled = false;
                      btn.textContent = originalText;
                    }
                  };

                  // ── Permanent Deletion Modal Logic ────────────────────────────────────
                  let currentDeleteId = null;
                  let currentDeleteType = null;

                  window.amDeleteRequest = function(id, type) {
                    currentDeleteId = id;
                    currentDeleteType = type;
                    
                    const row = document.querySelector(`tr[data-request-id="${id}"]`);
                    const title = row ? row.dataset.title.toUpperCase() : 'REQUEST';
                    
                    document.getElementById('deleteTargetName').textContent = title;
                    document.getElementById('amDeleteModal').classList.add('active');
                  };

                  window.closeDeleteModal = function() {
                    document.getElementById('amDeleteModal').classList.remove('active');
                    currentDeleteId = null;
                    currentDeleteType = null;
                  };

                  window.confirmPermanentDelete = async function() {
                    if (!currentDeleteId) return;
                    
                    const btn = document.querySelector('#amDeleteModal .btn-danger');
                    const originalText = btn.textContent;
                    
                    btn.disabled = true;
                    btn.textContent = '🗑️ Deleting...';
                    
                    try {
                      const res = await fetch('/admin/request/permanent-delete', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({ 
                          requestId: currentDeleteId, 
                          requestType: currentDeleteType 
                        })
                      });
                      const data = await res.json();
                      if (data.success || res.ok) {
                        const row = document.querySelector(`tr[data-request-id="${currentDeleteId}"]`);
                        if (row) row.remove();
                        window.showToast && window.showToast('🗑️ Request permanently deleted.');
                        closeDeleteModal();
                      } else {
                        alert('Delete failed: ' + (data.message || 'Check server logs'));
                      }
                    } catch (e) {
                      alert('Network error. Try again.');
                    } finally {
                      btn.disabled = false;
                      btn.textContent = originalText;
                    }
                  };

                  // \u2500\u2500 Save Archive Settings (inline) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
                  window.saveArchiveSettings = async function() {
                    const btn = document.getElementById('archiveSettingsSaveBtn');
                    const completedDays = parseInt(document.getElementById('archiveCompletedAfterDays2')?.value, 10);
                    const approvedDays  = parseInt(document.getElementById('archiveApprovedAfterDays2')?.value,  10);
                    const revisionDays  = parseInt(document.getElementById('archiveRevisionAfterDays2')?.value,  10);
                    const allowReactivation = document.getElementById('allowUserReactivation2')?.checked;

                    if (isNaN(completedDays) || isNaN(approvedDays) || isNaN(revisionDays)) {
                      alert('Please enter valid numbers for all day fields.');
                      return;
                    }

                    if (btn) { btn.disabled = true; btn.textContent = '⏳ Saving...'; }
                    try {
                      const res = await fetch('/admin/archive-settings', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({
                          archiveCompletedAfterDays: completedDays,
                          archiveApprovedAfterDays:  approvedDays,
                          archiveRevisionAfterDays:  revisionDays,
                          allowUserReactivation:     allowReactivation
                        })
                      });
                      const data = await res.json();
                      if (data.success) {
                        if (btn) { btn.textContent = '✅ Saved!'; btn.style.background = 'linear-gradient(135deg,#059669,#047857)'; }
                        setTimeout(() => {
                          if (btn) { btn.textContent = '💾 Save Settings'; btn.style.background = ''; btn.disabled = false; }
                        }, 2500);
                      } else {
                        throw new Error(data.message || 'Save failed');
                      }
                    } catch(e) {
                      if (btn) { btn.textContent = '❌ Error \u2014 try again'; btn.disabled = false; }
                      console.error('Archive settings save error:', e);
                      setTimeout(() => { if (btn) btn.textContent = '💾 Save Settings'; }, 3000);
                    }
                  };

                  // Initialize archive on DOMContentLoaded
                  document.addEventListener('DOMContentLoaded', function() {
                    archiveInit();
                  });


                  function updateCharCount(element, counterId, maxLength) {
                    const counter = document.getElementById(counterId);
                    if (counter) {
                      const currentLength = element.value.length;
                      counter.textContent = `${currentLength}/${maxLength}`;
                      counter.style.color = currentLength > maxLength ? '#ef4444' : '#6b7280';
                    }
                  }

                  // Preview function
                  function showPreview() {
                    // Open homepage in new tab for preview
                    window.open('/', '_blank');
                  }

                  // Dropdown toggle function
                  function toggleDropdown() {
                    const dropdown = document.querySelector('.dropdown-menu');
                    if (dropdown) {
                      dropdown.classList.toggle('show');
                    }
                  }

                  // Reset form functions
                  function resetForm() {
                    if (confirm('Are you sure you want to reset the homepage configuration form? All unsaved changes will be lost.')) {
                      document.getElementById('configForm').reset();
                      // Reset character counters
                      const counters = document.querySelectorAll('.char-count');
                      counters.forEach(counter => {
                        const maxLength = counter.textContent.split('/')[1];
                        if (maxLength) {
                          counter.textContent = `0/${maxLength}`;
                          counter.style.color = '#6b7280';
                        }
                      });
                    }
                  }

                  function resetSystemForm() {
                    if (confirm('Are you sure you want to reset the system configuration form? All unsaved changes will be lost.')) {
