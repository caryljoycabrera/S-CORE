// ===== REQUEST TYPE SELECTION LOGIC =====
document.addEventListener('DOMContentLoaded', function() {
  const specificRequestTypeSelect = document.getElementById('specificRequestType');

  // Fetch and populate approved request types
  async function loadApprovedRequestTypes() {
    try {
      const response = await fetch('/api/request-types/approved');
      const data = await response.json();

      if (data.success && data.requestTypes && data.requestTypes.length > 0) {
        // Clear existing options except the first one
        while (specificRequestTypeSelect.options.length > 1) {
          specificRequestTypeSelect.remove(1);
        }

        // Group request types by category
        const groupedTypes = {};
        data.requestTypes.forEach(type => {
          const category = type.category || 'Other Services';
          if (!groupedTypes[category]) {
            groupedTypes[category] = [];
          }
          groupedTypes[category].push(type);
        });

        // Add optgroups and options
        Object.keys(groupedTypes).sort().forEach(category => {
          const optgroup = document.createElement('optgroup');
          optgroup.label = category;

          groupedTypes[category].forEach(type => {
            const option = document.createElement('option');
            option.value = type.name;
            option.textContent = type.name;
            optgroup.appendChild(option);
          });

          specificRequestTypeSelect.appendChild(optgroup);
        });

        console.log('Loaded', data.requestTypes.length, 'approved request types');
      } else {
        console.warn('No approved request types found, using fallback options');
        // Fallback to hardcoded options if API fails
        addFallbackOptions();
      }
    } catch (error) {
      console.error('Error loading request types:', error);
      // Fallback to hardcoded options
      addFallbackOptions();
    }
  }

  // Fallback options if API fails
  function addFallbackOptions() {
    const fallbackOptions = [
      { category: 'Content & Communications', types: ['Content Posting', 'Social Media Monitoring', 'Caption Approval', 'Publication Design', 'Proofreading', 'Graphics Design', 'Media Coverage'] }
    ];

    fallbackOptions.forEach(group => {
      const optgroup = document.createElement('optgroup');
      optgroup.label = group.category;

      group.types.forEach(type => {
        const option = document.createElement('option');
        option.value = type;
        option.textContent = type;
        optgroup.appendChild(option);
      });

      specificRequestTypeSelect.appendChild(optgroup);
    });
  }

  // Load request types on page load
  loadApprovedRequestTypes();

  // ===== LINKS MANAGEMENT =====
  const linksContainer = document.getElementById('linksContainer');
  const addLinkBtn = document.getElementById('addLinkBtn');

  // Function to create a new link input field
  function createLinkInput(value = '') {
    const linkItem = document.createElement('div');
    linkItem.className = 'link-item';
    
    linkItem.innerHTML = `
      <input type="url" placeholder="https://example.com" value="${value}" />
      <button type="button" class="remove-link-btn" title="Remove link">&times;</button>
    `;
    
    // Add event listener to remove button
    const removeBtn = linkItem.querySelector('.remove-link-btn');
    removeBtn.addEventListener('click', function() {
      linkItem.remove();
    });
    
    return linkItem;
  }

  // Add link button event listener
