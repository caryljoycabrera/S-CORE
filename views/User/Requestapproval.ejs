/* Enhanced File Upload */
.file-upload-group {
  position: relative;
  border: 2px dashed #cbd5e1;
  border-radius: 12px;
  padding: 2rem;
  text-align: center;
  background: linear-gradient(135deg, #fefefe, #f8fafc);
  transition: all 0.3s ease;
  cursor: pointer;
  min-height: 120px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.file-upload-group:hover {
  border-color: var(--primary-green);
  background: linear-gradient(135deg, #f0fdf4, #f7fee7);
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(64, 139, 78, 0.1);
}

.file-upload-group.has-file {
  border-color: var(--primary-green);
  background: linear-gradient(135deg, #f0fdf4, #f7fee7);
  border-style: solid;
}

.file-upload-group.dragover {
  border-color: var(--primary-green);
  background: linear-gradient(135deg, #f0fdf4, #f7fee7);
  box-shadow: 0 0 0 4px rgba(64, 139, 78, 0.1);
  transform: scale(1.02);
}

.upload-icon {
  width: 48px;
  height: 48px;
  margin-bottom: 1rem;
  color: #64748b;
  transition: color 0.3s ease;
}

.file-upload-group:hover .upload-icon,
.file-upload-group.dragover .upload-icon {
  color: var(--primary-green);
}

.upload-text {
  font-size: 1.1rem;
  font-weight: 600;
  color: #334155;
  margin-bottom: 0.5rem;
}

.upload-subtext {
  font-size: 0.9rem;
  color: #64748b;
  margin-bottom: 1rem;
}

.file-input-hidden {
  position: absolute;
  opacity: 0;
  width: 100%;
  height: 100%;
  cursor: pointer;
  z-index: 1;
}

.browse-file-btn {
  background: linear-gradient(135deg, var(--primary-green), #20c997);
  color: white;
  border: none;
  padding: 0.75rem 1.5rem;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 0.9rem;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  position: relative;
  z-index: 2;
}

.browse-file-btn:hover {
  background: linear-gradient(135deg, #157347, var(--primary-green));
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(64, 139, 78, 0.3);
}

