<style>
/* ========================================
   USER PAGE LAYOUT - STANDARDIZED
   Matches admin page spacing and structure
   ======================================== */

/* Main container - proper padding from header and edges */
.student-side {
  padding: 0 !important;
  background: #f8f9fa !important;
  box-sizing: border-box;
}

/* Activity section - consistent with admin */
.activity-section {
  padding: 0 !important;
  margin: 0 !important;
  background: #f8f9fa !important;
  overflow: visible !important;
  position: relative;
  z-index: 1;
}

/* Page Header Layout - with proper top spacing */
.page-header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  gap: 1rem;
  flex-wrap: wrap;
  padding: 2rem 3rem 0 3rem; /* Match admin padding */
}

.user-info-section {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex: 1;
}

.action-button-container {
  margin-left: auto;
}

/* Navigation tabs - proper padding */
.nav-tabs {
  padding: 0 3rem; /* Match admin padding */
  margin-bottom: 1.5rem;
}

/* Filter section - proper spacing from edges */
.filter-section {
  background: white;
  border: none;
  border-radius: 0;
  padding: 1.25rem;
  margin: 0 3rem 1.5rem 3rem; /* Match admin margins */
  box-shadow: none;
  overflow: visible !important;
  position: relative;
  z-index: 1;
}

/* Table section - proper padding */
.table-section {
  background: white;
  padding: 1.5rem;
  margin: 0 3rem 2rem 3rem; /* Match admin margins */
  border-radius: 0;
}

/* Content wrapper */
.student-side > .div {
  max-width: 100%;
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  background: transparent;
}

/* Responsive breathing room */
@media (max-width: 1200px) {
  .page-header-container,
  .nav-tabs,
  .filter-section,
  .table-section {
    padding-left: 2rem;
    padding-right: 2rem;
    margin-left: 2rem;
    margin-right: 2rem;
  }
}

@media (max-width: 768px) {
  .page-header-container {
    flex-direction: column;
    align-items: flex-start;
    padding: 1.5rem;
    margin-left: 1.5rem;
    margin-right: 1.5rem;
  }
  
  .nav-tabs,
  .filter-section,
  .table-section {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    margin-left: 1.5rem;
    margin-right: 1.5rem;
  }
  
  .action-button-container {
    width: 100%;
    margin-left: 0;
  }
  
  .action-button-container .view-all-btn {
    width: 100%;
  }
}

/* Modal Styles (allrequests) */
.modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0,0,0,0.5);
  display: none;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.modal.show,
.modal[style*="flex"],
.modal[style*="display: block"],
.modal[style*="display:block"] {
  display: flex !important;
}

.modal .modal-content,
.confirmation-modal .confirmation-modal-content,
.edit-modal .edit-modal-content,
.calendar-modal .calendar-modal-content,
.deadline-details-modal .deadline-details-modal-content,
.notification-modal .notification-modal-content {
  position: relative !important;
  top: auto !important;
  left: auto !important;
  right: auto !important;
  bottom: auto !important;
  transform: none !important;
}

.unit-modal-wide {
  max-width: 1600px !important;
  width: 95% !important;
  max-height: 95vh !important;
  overflow: hidden;
}

.modal-content,
.confirmation-modal-content,
.edit-modal-content,
.calendar-modal-content,
.deadline-details-modal-content,
.notification-modal-content {
  z-index: 100001 !important;
  position: relative !important;
  margin: auto !important;
  background: white !important;
  border-radius: 16px !important;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3) !important;
  max-height: 90vh !important;
  overflow-y: auto !important;
  overflow-x: visible !important;
  transform: translateY(0) !important;
  display: flex;
  flex-direction: column;
}

.modal-content {
  background: white;
  border-radius: 8px;
  max-width: min(800px, calc(100vw - 120px)) !important;
  width: 90% !important;
  max-height: 95vh;
  overflow: hidden;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

.modal-content {
  background: white;
  border-radius: var(--border-radius);
  padding: 2rem;
  width: 100%;
  max-width: 600px;
  box-shadow: var(--card-shadow-hover);
  animation: fadeIn 0.3s ease-in-out;
  max-height: 90vh;
  overflow-y: auto;
}

/* Ensure wide modal wins over tighter modal-content sizing */
.unit-modal-wide {
  max-width: 1600px !important;
  width: 95% !important;
  max-height: 95vh !important;
}

.modal[style*="display: flex"],
.modal[style*="display:flex"],
.modal[style*="display: block"],
.modal[style*="display:block"],
#teamConversationModal[style*="display: flex"],
#teamConversationModal[style*="display:flex"] {
  pointer-events: auto !important;
}

.modal-form {
  padding: 1rem 1.5rem;
  display: grid;
  grid-template-columns: 1fr 1fr; 
  gap: 1.5rem;
}

.form-group.full-width {
  grid-column: 1 / -1;
}

.form-group {
  display: flex;
  flex-direction: column;
}

.form-group label {
  font-weight: 600;
  font-size: 0.875rem;
  color: #374151;
  margin-bottom: 0.5rem;
  display: block;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 0.75rem;
  border: 2px solid #e5e7eb;
  border-radius: 0.5rem;
  font-size: 1rem;
  background-color: white;
  color: #1f2937;
  transition: all 0.3s ease;
  font-family: inherit;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--primary-green);
  box-shadow: 0 0 0 3px rgba(64, 139, 78, 0.1);
}

.form-group input[readonly] {
  background-color: #f9fafb;
  color: #6b7280;
  cursor: not-allowed;
}

.form-group textarea {
  resize: vertical;
  min-height: 120px;
}

/* Links Section Styles */
#linksContainer {
  margin-bottom: 1rem;
}

.link-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.75rem;
  padding: 0.75rem;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  transition: all 0.3s ease;
}

.link-item:hover {
  border-color: var(--primary-green);
  background: #f0fdf4;
}

.link-item input[type="url"] {
  flex: 1;
  padding: 0.5rem;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  font-size: 0.875rem;
  background: white;
  transition: border-color 0.3s ease;
}

.link-item input[type="url"]:focus {
  outline: none;
  border-color: var(--primary-green);
  box-shadow: 0 0 0 3px rgba(64, 139, 78, 0.1);
}

.remove-link-btn {
  background: transparent;
  color: #6b7280;
  border: none;
  font-size: 2rem;
  line-height: 1;
  cursor: pointer;
  transition: all 0.3s ease;
  padding: 0;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-link-btn:hover {
  color: #dc2626;
  transform: scale(1.1);
}

.add-link-btn {
  background: linear-gradient(135deg, var(--primary-green), #20c997);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 0.75rem 1.5rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  box-shadow: 0 2px 8px rgba(64, 139, 78, 0.2);
}

.add-link-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(64, 139, 78, 0.3);
  background: linear-gradient(135deg, #157347, var(--primary-green));
}

.form-actions {
  grid-column: 1 / -1;
  display: flex;
  gap: 1rem;
  justify-content: flex-end;
  padding-top: 2rem;
  margin-top: 2rem;
  border-top: 2px solid #f1f5f9;
}

.form-actions button {
  padding: 0.875rem 2rem;
  border-radius: 12px;
  font-weight: 600;
  font-size: 1rem;
  transition: all 0.3s ease;
  cursor: pointer;
  border: none;
  min-width: 120px;
}

.form-actions button[type="submit"] {
  background: linear-gradient(135deg, var(--primary-green), #20c997);
  color: white;
  box-shadow: 0 4px 12px rgba(64, 139, 78, 0.3);
}

.form-actions button[type="submit"]:hover {
  background: linear-gradient(135deg, #157347, var(--primary-green));
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(64, 139, 78, 0.4);
}

.form-actions button[type="button"] {
  background: #f1f5f9;
  color: #64748b;
  border: 2px solid #e2e8f0;
}

.form-actions button[type="button"]:hover {
  background: #e2e8f0;
  color: #475569;
  transform: translateY(-1px);
}

/* Confirmation Modal Actions */
.modal-actions {
  display: flex;
  gap: 1rem;
  justify-content: flex-end;
  padding: 1.5rem;
  border-top: 2px solid #f1f5f9;
  background: #f9fafb;
}

.modal-actions button {
  padding: 0.875rem 2rem;
  border-radius: 12px;
  font-weight: 600;
  font-size: 1rem;
  transition: all 0.3s ease;
  cursor: pointer;
  border: none;
  min-width: 120px;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.modal-actions button:first-child {
  background: #f1f5f9;
  color: #64748b;
  border: 2px solid #e2e8f0;
}

.modal-actions button:first-child:hover {
  background: #e2e8f0;
  color: #475569;
  transform: translateY(-1px);
}

.modal-actions button:last-child {
  background: linear-gradient(135deg, var(--primary-green), #20c997);
  color: white;
  box-shadow: 0 4px 12px rgba(64, 139, 78, 0.3);
}

.modal-actions button:last-child:hover {
  background: linear-gradient(135deg, #157347, var(--primary-green));
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(64, 139, 78, 0.4);
}

/* Enhanced Filter Styles */
.enhanced-multi-select-wrapper {
  position: relative;
  width: 100%;
}

.enhanced-multi-select {
  position: relative;
  width: 100%;
}

.select-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.5rem 0.75rem;
  border: 1px solid #d1d5db;
  border-radius: 0.375rem;
  font-size: 0.875rem;
  color: #374151;
  background: white;
  cursor: pointer;
  transition: all 0.2s ease;
  min-height: 2.5rem;
  box-sizing: border-box;
}

.select-display:hover {
  border-color: #9ca3af;
}

.select-display.active {
  border-color: var(--primary-green);
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
}

.selected-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dropdown-arrow {
  margin-left: 0.5rem;
  font-size: 0.75rem;
  color: #6b7280;
  transition: transform 0.2s ease;
  flex-shrink: 0;
}

.select-display.active .dropdown-arrow {
  transform: rotate(180deg);
}

.select-dropdown {
  display: none;
  position: absolute;
  top: calc(100% + 2px);
  left: 0;
  right: 0;
  background: white;
  border: 1px solid #d1d5db;
  border-radius: 0.375rem;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  z-index: 1000;
  max-height: 300px;
  overflow: hidden;
  animation: dropdownSlideIn 0.2s ease-out;
}

@keyframes dropdownSlideIn {
  from {
    opacity: 0;
    transform: translateY(-10px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.select-dropdown.show {
  display: block;
}

.search-container {
  padding: 0.75rem;
  border-bottom: 1px solid #e5e7eb;
  background: #f9fafb;
}

.search-input {
  width: 100%;
  padding: 0.5rem;
  border: 1px solid #d1d5db;
  border-radius: 0.25rem;
  font-size: 0.875rem;
  background: white;
  transition: border-color 0.2s ease;
}

.search-input:focus {
  outline: none;
  border-color: var(--primary-green);
  box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.1);
}

.options-container {
  max-height: 200px;
  overflow-y: auto;
  padding: 0.25rem 0;
}

.dropdown-option {
  display: flex;
  align-items: center;
  padding: 0.5rem 0.75rem;
  cursor: pointer;
  font-size: 0.875rem;
  color: #374151;
  transition: background-color 0.15s ease;
  margin: 0;
  position: relative;
}

.dropdown-option:hover {
  background: #f3f4f6;
}

.dropdown-option.selected {
  background: #f0fdf4;
  color: var(--primary-green);
}

.dropdown-option input[type="checkbox"] {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.checkbox-custom {
  width: 16px;
  height: 16px;
  border: 2px solid #d1d5db;
  border-radius: 3px;
  margin-right: 0.75rem;
  position: relative;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.dropdown-option:hover .checkbox-custom {
  border-color: var(--primary-green);
}

.dropdown-option input[type="checkbox"]:checked + .checkbox-custom {
  background: var(--primary-green);
  border-color: var(--primary-green);
}

.dropdown-option input[type="checkbox"]:checked + .checkbox-custom::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: white;
  font-size: 11px;
  font-weight: bold;
}

.options-container::-webkit-scrollbar {
  width: 6px;
}

.options-container::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 3px;
}

.options-container::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 3px;
}

.options-container::-webkit-scrollbar-thumb:hover {
  background: #a8a8a8;
}

.no-results {
  padding: 1rem;
  text-align: center;
  color: #6b7280;
  font-size: 0.875rem;
  font-style: italic;
}

