    </div>

    <!-- DASHBOARD CONTENT -->
    <div class="student-side">
      <div class="div">

      <section class="activity-section">
        <!-- Page Header with User Info and Action Button -->
        <div class="page-header-container">
          <div class="user-info-section">
            <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" 
                 alt="Profile Picture" class="profile-pic-large" style="width:64px;height:64px;border-radius:50%;" />
            <div>
              <h2 style="margin-bottom: 0.25rem;"><%= user.fName %> <%= user.lName %></h2>
              <p style="color: #6b7280;"><%= user.userType === 'student' ? 'Student' : 'Non-Student' %></p>
            </div>
          </div>
          <div class="action-button-container">
            <button class="view-all-btn" id="openModalBtn">+ Request Approval</button>
          </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="nav-tabs">
          <a href="/all-requests" class="tab-btn">All Requests</a>
          <a href="/request-approvals" class="tab-btn active">Request Approvals</a>
          <a href="/service-requests" class="tab-btn">Service Requests</a>
        </nav>

        <div class="filter-section">
          <div class="filter-container">
            <div class="filter-group">
              <label class="filter-label">Filter by:</label>
              
              <!-- First Row -->
              <div class="filter-controls">
                <div class="filter-item">
                  <label class="filter-sublabel">Status</label>
                  <div class="custom-select-wrapper">
                    <div class="custom-select" id="statusFilter">
                      <div class="select-display">All Status</div>
                      <div class="select-dropdown" id="statusDropdown">
                        <label class="dropdown-option">
                          <input type="checkbox" value="all" checked>
                          <span class="checkbox-custom"></span>
                          All Status
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="pending">
                          <span class="checkbox-custom"></span>
                          Pending
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="queued">
                          <span class="checkbox-custom"></span>
                          Queued
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="in-progress">
                          <span class="checkbox-custom"></span>
                          In Progress
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="for-checking">
                          <span class="checkbox-custom"></span>
                          For Checking
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="approved">
                          <span class="checkbox-custom"></span>
                          Approved
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="completed">
                          <span class="checkbox-custom"></span>
                          Completed
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="for-revision">
                          <span class="checkbox-custom"></span>
                          For Revision
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="rejected">
                          <span class="checkbox-custom"></span>
                          Rejected
                        </label>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="filter-item">
                  <label for="titleFilter" class="filter-sublabel">Title</label>
                  <input type="text" id="titleFilter" class="filter-input" placeholder="Search title...">
                </div>
                <div class="filter-item">
                  <% if (user.userType === 'student') { %>
                  <label for="organizationFilter" class="filter-sublabel">My Student Organizations</label>
                  <div class="enhanced-multi-select-wrapper">
                    <div class="enhanced-multi-select" id="organizationFilter">
                      <div class="select-display" data-placeholder="Select My Organizations">
                        <span class="selected-text">All My Organizations</span>
                        <span class="dropdown-arrow">▼</span>
                      </div>
                      <div class="select-dropdown" id="organizationDropdown">
                        <div class="search-container">
                          <input type="text" class="search-input" placeholder="Search my organizations...">
                        </div>
                        <div class="options-container">
                          <!-- Options populated by JavaScript -->
                        </div>
                      </div>
                    </div>
                  </div>
                  <% } else { %>
                  <label for="organizationFilter" class="filter-sublabel">My Office/Department</label>
                  <div class="enhanced-multi-select-wrapper">
                    <div class="enhanced-multi-select" id="organizationFilter">
                      <div class="select-display" data-placeholder="Select My Departments">
                        <span class="selected-text">All My Departments</span>
                        <span class="dropdown-arrow">▼</span>
                      </div>
                      <div class="select-dropdown" id="organizationDropdown">
                        <div class="search-container">
                          <input type="text" class="search-input" placeholder="Search my departments...">
                        </div>
                        <div class="options-container">
                          <!-- Options populated by JavaScript -->
                        </div>
                      </div>
                    </div>
                  </div>
                  <% } %>
                </div>
              </div>
              
              <!-- Second Row -->
              <div class="filter-controls">
                <div class="filter-item">
                  <label for="dateFromFilter" class="filter-sublabel">Date From</label>
                  <input type="date" id="dateFromFilter" class="filter-input">
                </div>
                <div class="filter-item">
                  <label for="dateToFilter" class="filter-sublabel">Date To</label>
                  <input type="date" id="dateToFilter" class="filter-input">
                </div>
              </div>
            </div>
            
            <div class="filter-actions">
              <button id="clearFilters" class="clear-filters-btn">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <rect x="3" y="6" width="18" height="14" rx="2"/>
                  <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                  <line x1="1" y1="6" x2="23" y2="6"/>
                  <line x1="10" y1="11" x2="10" y2="17"/>
                  <line x1="14" y1="11" x2="14" y2="17"/>
                </svg>
                Clear All
              </button>
              <div class="results-count">
                <span id="resultsCount">Showing all requests</span>
              </div>
            </div>
          </div>
        </div>

        <section class="table-section" style="overflow-x: auto;">
          <table class="requests-table" style="width: 100%; border-collapse: collapse; border-radius: var(--border-radius); box-shadow: var(--card-shadow); overflow: hidden; background: white;">
            <thead style="background: var(--light-green); color: var(--primary-green);">
              <tr>
                <th>Request ID</th>
                <th>Project Title</th>
                <th>Office/Department/Organization</th>
                <th>Status</th>
                <th>Assigned Units</th>
                <th>Date Submitted</th>
              </tr>
            </thead>
            <tbody id="requestsTableBody">
              <% allRequests.forEach(request => { %>
             <tr class="request-row"
    data-id="<%= request._id %>"
    data-type="Request Approval"
    data-specifictype="<%= request.specificRequestType || 'Not specified' %>"
    data-title="<%= request.title %>"
    data-status="<%= request.status %>"
    data-organization="<%= request.organization %>"
    data-units="<%= request.assignedUnits || 'Not yet assigned' %>"
    data-datetime="<%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %>"
    data-date="<%= request.datetime ? request.datetime.toISOString().split('T')[0] : new Date(request.createdAt).toISOString().split('T')[0] %>"
    data-description="<%= request.description %>"
    data-file="<%= request.file ? request.file : '' %>"
    data-files="<%= request.files ? request.files.join(',') : '' %>"
    data-allowadditionalfileupload="<%= request.allowAdditionalFileUpload ? 'true' : 'false' %>">
                  <td><%= request._id.toString().slice(-6) %></td>
                  <td><%= request.title %></td>
                  <td><%= request.organization %></td>
                  <td>
                    <span class="status-badge <%= request.status.toLowerCase().replace(/\s+/g, '-') %>">
                      <%= request.status %>
                    </span>
                  </td>
                  <td><%= request.assignedUnits || 'Not yet assigned' %></td>
                  <td><%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>

          <!-- Pagination Controls -->
          <div id="paginationControls" style="display: flex; justify-content: center; align-items: center; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
            <button id="prevPageBtn" onclick="previousPage()" style="padding: 0.5rem 1rem; border: 1px solid #cbd5e1; border-radius: 4px; cursor: pointer; background: white; transition: all 0.2s;" title="Previous page">← Previous</button>
            <div id="pageInfo" style="font-weight: 500; color: #64748b;">Page 1</div>
            <button id="nextPageBtn" onclick="nextPage()" style="padding: 0.5rem 1rem; border: 1px solid #cbd5e1; border-radius: 4px; cursor: pointer; background: white; transition: all 0.2s;" title="Next page">Next →</button>
          </div>

          <% if (!allRequests || allRequests.length === 0) { %>
          <div class="no-requests-message">
            <p>No requests found.</p>
          </div>
          <% } %>
        </section>

        <!-- Back to Dashboard Button -->
        <div class="back-to-dashboard-container">
          <a href="/dashboard" class="back-to-dashboard-btn">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Back to Dashboard
          </a>
        </div>
      </section>
    </div>
  </div>

  <!-- Create Request Modal -->
  <div id="requestModal" class="modal" style="display:none;">
    <div class="modal-content unit-modal-wide">
      <div class="modal-header unit-modal-header approval-header-color">
        <div class="modal-title-section">
          <svg class="modal-title-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          <h2 class="modal-title">Create a Request for Approval</h2>
          <span class="type-badge">APPROVAL</span>
        </div>
        <button class="close-modal-btn" onclick="document.getElementById('requestModal').style.display='none'" aria-label="Close">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="modal-body">
        <form class="modal-form" action="/submit-request-approval" method="POST" enctype="multipart/form-data" id="requestForm" onsubmit="return handleFormSubmit(event)">
          <!-- Row 1: Title and Organization -->
          <div class="form-group">
            <label for="projectTitle">Project/Event Title:</label>
            <input type="text" id="projectTitle" name="projectTitle" required placeholder="Enter project or event title..." />
          </div>
          
          <div class="form-group">
            <label for="organization">Organization:</label>
            <%
              let userOrgs = [];
              if (user.userType === 'student') {
                if (Array.isArray(user.studentOrganization)) {
                  if (user.studentOrganization.length === 1 && user.studentOrganization[0].includes(',')) {
                    userOrgs = user.studentOrganization[0].split(',').map(o => o.trim()).filter(Boolean);
                  } else {
                    userOrgs = user.studentOrganization;
                  }
                } else if (typeof user.studentOrganization === 'string') {
                  userOrgs = user.studentOrganization.split(',').map(o => o.trim()).filter(Boolean);
                }
              } else {
                if (Array.isArray(user.affiliation)) {
                  if (user.affiliation.length === 1 && user.affiliation[0].includes(',')) {
                    userOrgs = user.affiliation[0].split(',').map(o => o.trim()).filter(Boolean);
                  } else {
                    userOrgs = user.affiliation;
                  }
                } else if (typeof user.affiliation === 'string') {
                  userOrgs = user.affiliation.split(',').map(o => o.trim()).filter(Boolean);
                }
              }
            %>
            <% if (userOrgs.length === 1) { %>
              <input type="text" id="organization" name="organization" value="<%= userOrgs[0] %>" readonly />
            <% } else if (userOrgs.length > 1) { %>
              <select id="organization" name="organization" required>
                <option value="" disabled selected>Select organization/department</option>
                <% userOrgs.forEach(function(org) { %>
                  <option value="<%= org %>"><%= org %></option>
                <% }); %>
              </select>
            <% } else { %>
              <input type="text" id="organization" name="organization" placeholder="Enter organization/department" required />
            <% } %>
          </div>

          <!-- Row 2: File Upload (Required for approval requests) -->
          <div class="form-group full-width">
            <label for="upload">Upload Files:</label>
            <div class="file-upload-group" id="approvalFileUploadGroup">
              <svg class="upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7,10 12,15 17,10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <p class="upload-text">Drop your files here</p>
              <p class="upload-subtext">or click to browse from your device</p>
              <input type="file" id="upload" name="upload" class="file-input-hidden" multiple required accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.webp,.xls,.xlsx,.txt" />
              <button type="button" class="browse-file-btn" onclick="event.stopPropagation(); document.getElementById('upload').click()">
                <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14,2 14,8 20,8"/>
                </svg>
                Choose Files
              </button>
              
              <!-- Upload Progress -->
              <div class="upload-progress" id="approvalUploadProgress">
                <div class="progress-bar">
                  <div class="progress-fill" id="approvalProgressFill"></div>
                </div>
              </div>
            </div>
            
            <!-- File Management Section -->
            <div class="file-management" id="approvalFileManagement" style="display: none;">
              <div class="file-actions">
                <span id="approvalFilesCount">0 files selected</span>
                <button type="button" class="clear-all-btn" id="approvalClearAllBtn" onclick="clearAllApprovalFiles()">
                  <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="6" width="18" height="14" rx="2"/>
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    <line x1="1" y1="6" x2="23" y2="6"/>
                    <line x1="10" y1="11" x2="10" y2="17"/>
                    <line x1="14" y1="11" x2="14" y2="17"/>
                  </svg>
                  Clear All Files
                </button>
              </div>
              
              <!-- Selected Files Container -->
              <div class="selected-files-container" id="approvalSelectedFiles">
                <!-- Files will be added here dynamically -->
              </div>
              
              <div class="files-summary" id="approvalFilesSummary">
                Total size: 0 MB
              </div>
            </div>
            
            <small style="color: #dc2626; margin-top: 0.5rem;">* Required: Please attach relevant documents (Max 10MB per file)</small>
          </div>

          <!-- Row 3: Relevant Links -->
          <div class="form-group full-width">
            <label>Relevant Links (Optional):</label>
            <small style="color: #6b7280; display: block; margin-bottom: 0.5rem;">💡 Reminder: Please ensure links have public access or proper sharing permissions</small>
            <div id="linksContainer">
              <!-- Links will be added here dynamically -->
            </div>
            <button type="button" id="addLinkBtn" class="add-link-btn">
              <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 5v14M5 12h14"/>
              </svg>
              Add Link
            </button>
          </div>

          <!-- Row 4: Description (Full Width) -->
          <div class="form-group full-width">
            <label for="description">Description:</label>
            <div id="descriptionEditor" style="background: white; min-height: 150px; border: 1px solid #e2e8f0; border-radius: 8px;"></div>
            <input type="hidden" id="description" name="description" required>
          </div>

          <!-- Row 5: Request Type -->
          <div class="form-group full-width">
  <label for="specificRequestType">Select Request Type:</label>
  <select id="specificRequestType" name="specificRequestType" class="form-control" required>
    <option value="" disabled selected>Select request type...</option>
    <!-- Predefined types will be populated by JavaScript -->
  </select>
</div>

          <!-- Form Actions -->
          <div class="form-actions">
            <button type="button" id="cancelModalBtn">Cancel</button>
            <button type="submit">Submit Request</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Enhanced Submission Confirmation Modal -->
  <div id="submissionConfirmationModal" class="modal" style="display:none;">
    <div class="modal-content" style="max-width: 600px;">
      <header class="modal-header">
        <span class="modal-title confirmation">Confirm Your Submission</span>
        <span class="close" id="closeSubmissionConfirmation">&times;</span>
      </header>
      <div class="modal-body" style="padding: 0;">
        <div style="padding: 2rem; text-align: center; background: linear-gradient(135deg, #f0f9ff, #e0f2fe);">
          <div style="font-size: 4rem; margin-bottom: 1.5rem; color: #3b82f6;">
            <svg width="64" height="64" fill="none" stroke="#3b82f6" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h2 style="margin: 0 0 1rem 0; font-size: 1.5rem; font-weight: 700; color: #3b82f6;">
            Ready to Submit Your Request?
          </h2>
          <p style="margin: 0 0 1.5rem 0; font-size: 1.1rem; color: #374151; font-weight: 500;">
            Please review your information before final submission to the S-CORE team.
          </p>
        </div>
        
        <div style="padding: 1.5rem 2rem; background: white;">
          <div style="background: #fef3c7; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #f59e0b; margin-bottom: 1.5rem;">
            <h3 style="margin: 0 0 0.75rem 0; font-size: 1rem; font-weight: 600; color: #92400e; display: flex; align-items: center; gap: 0.5rem;">
              <svg width="20" height="20" fill="none" stroke="#f59e0b" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              Important Notice
            </h3>
            <p style="margin: 0; color: #92400e; font-size: 0.95rem; line-height: 1.5;">
              Once submitted, your request cannot be edited. Please ensure all information and files are correct.
            </p>
          </div>
          
          <div style="background: #f0f9ff; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #3b82f6; margin-bottom: 1.5rem;">
            <h3 style="margin: 0 0 0.75rem 0; font-size: 1rem; font-weight: 600; color: #1e40af; display: flex; align-items: center; gap: 0.5rem;">
              <svg width="20" height="20" fill="none" stroke="#3b82f6" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12,6 12,12 16,14"/>
              </svg>
              Processing Timeline
            </h3>
            <p style="margin: 0; color: #1e40af; font-size: 0.95rem; line-height: 1.5;">
              The S-CORE team strives to provide feedback within <strong>three (3) working days</strong>.
            </p>
          </div>
          
          <div style="background: #f8fafc; padding: 1.5rem; border-radius: 12px; border: 1px solid #e2e8f0;">
            <p style="margin: 0; color: #64748b; font-size: 0.9rem; text-align: center; font-style: italic;">
              You can track your request status and communicate with our team through the conversation feature after submission.
            </p>
          </div>
        </div>
      </div>
      <div class="modal-actions">
        <button id="cancelSubmissionBtn">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8z"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Review & Edit
        </button>
        <button id="proceedSubmissionBtn">
          <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Confirm & Submit
        </button>
      </div>
    </div>
  </div>

  <!-- Request Details Modal -->
  <div id="detailsModal" class="modal" style="display:none;">
    <div class="modal-content unit-modal-wide">
      <div class="modal-header unit-modal-header" style="background: #0891b2 !important; padding: 20px">
        <div class="modal-title-section">
          <svg class="modal-title-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" id="detailsModalIcon">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          <h2 class="modal-title" id="detailsModalTitle" style="color: white !important;">Request Details</h2>
          <span class="type-badge" id="modalTypeBadge">APPROVAL</span>
        </div>
        <button class="close-modal-btn" onclick="document.getElementById('detailsModal').style.display='none'" aria-label="Close">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="modal-body unit-modal-body">
        <!-- LEFT COLUMN: Request Details -->
        <div class="unit-left-column">
        <div class="details-content">
          <!-- General Information Section -->
         <div class="details-section">
  <h3>General Information</h3>
  <div class="details-grid">
    <div class="details-field">
      <div class="details-label">Request Type</div>
      <div class="details-value" id="detailType"></div>
    </div>
    
    <!-- ADD THIS NEW FIELD -->
    <div class="details-field">
      <div class="details-label">Specific Request Type</div>
      <div class="details-value" id="detailSpecificType" style="color: var(--primary-green); font-weight: 600;">Not specified</div>
    </div>
    
    <div class="details-field">
      <div class="details-label">Project Title</div>
      <div class="details-value" id="detailTitle"></div>
    </div>
              
              <div class="details-field">
                <div class="details-label">Organization</div>
                <div class="details-value" id="detailOrganization"></div>
              </div>
              
              <div class="details-field">
                <div class="details-label">Date Submitted</div>
                <div class="details-value" id="detailDatetime"></div>
              </div>
            </div>
          </div>

          <!-- Status & Assignment Section -->
          <div class="details-section">
            <h3>Status & Assignment</h3>
            <div class="details-grid">
              <div class="details-field">
                <div class="details-label">Current Status</div>
                <div class="details-value">
                  <span class="status-badge-large" id="detailStatusBadge">
                    <span id="detailStatus"></span>
                  </span>
                </div>
              </div>
              
              <div class="details-field">
                <div class="details-label">Assigned Units</div>
                <div class="details-value" id="detailUnits"></div>
              </div>
              
              <div class="details-field" id="deadlineSection" style="display: none;">
                <div class="details-label">Requested Deadline</div>
                <div class="details-value">
                  <span class="deadline-badge-large" id="detailDeadlineBadge">
                    <span id="detailDeadline"></span>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Description Section -->
          <div class="description-section">
            <h3>Description</h3>
            <div class="description-content" id="detailDescription"></div>
          </div>

          <!-- Files Section -->
          <div id="file-preview"></div>

          <!-- Chat Section -->
          <div class="chat-section" id="chatButtonSectionLeft" style="display: none;">
            <button id="openChatFromDetailsModal" class="chat-card-btn" style="width: 100%; padding: 0; background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%); border: 2px solid #6ee7b7; border-radius: 12px; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.15);" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(16, 185, 129, 0.25)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 8px rgba(16, 185, 129, 0.15);">
              <div style="display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                  <div style="width: 40px; height: 40px; background: #10b981; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <svg width="20" height="20" fill="none" stroke="white" stroke-width="2.5" viewBox="0 0 24 24">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                  </div>
                  <div style="text-align: left;">
                    <div style="font-weight: 600; font-size: 1rem; color: #065f46; margin-bottom: 0.25rem;">Open Team Discussion</div>
                    <div style="font-size: 0.875rem; color: #047857;">Communicate with SCO support</div>
                  </div>
                </div>
                <svg width="20" height="20" fill="none" stroke="#059669" stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink: 0;">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </div>
            </button>
          </div>
        </div>
        </div>
        
        <!-- RIGHT COLUMN: Revision History & Resubmission Form -->
        <div class="unit-right-column" id="requestorRightColumn">
