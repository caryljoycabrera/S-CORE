    if (teamInput) {
        teamInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendTeamMessage();
            }
            
            // Keyboard shortcuts for formatting
            // Ctrl+B or Cmd+B for bold
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
                e.preventDefault();
                console.log('[Keyboard] Bold shortcut triggered (Ctrl+B)');
                applyFormatting('bold');
                return false;
            }
            // Ctrl+I or Cmd+I for italic
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'i') {
                e.preventDefault();
                console.log('[Keyboard] Italic shortcut triggered (Ctrl+I)');
                applyFormatting('italic');
                return false;
            }
            // Ctrl+U or Cmd+U for underline
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'u') {
                e.preventDefault();
                console.log('[Keyboard] Underline shortcut triggered (Ctrl+U)');
                applyFormatting('underline');
                return false;
            }
        });
    }
});

function displayChatFiles(files, container) {
    container.innerHTML = '';
    const filesCount = document.querySelector('.files-count');
    if (filesCount) filesCount.textContent = `${files.length} file(s) attached`;
    
    Array.from(files).forEach((file, index) => {
        const fileItem = document.createElement('div');
        fileItem.className = 'file-item';
        fileItem.innerHTML = `
            <div class="file-icon">📎</div>
            <div class="file-name">${escapeHtml(file.name)}</div>
            <div class="file-size">${(file.size / 1024).toFixed(1)} KB</div>
        `;
        container.appendChild(fileItem);
    });
}

// ========== REVISION HISTORY FUNCTIONS ==========
let resubmissionQuill = null;

async function loadRevisionHistory(requestId) {
    console.log('[allRequestsUser] loadRevisionHistory called for:', requestId);
    const historySection = document.getElementById('revisionHistorySection');
    const historyContainer = document.getElementById('revisionHistoryContainer');
    const rightColumn = document.getElementById('requestorRightColumn');
    const modalBody = document.querySelector('.requestor-modal-body');
    const modalContent = document.querySelector('.requestor-modal-content');
    const resubmissionSection = document.getElementById('resubmissionFormSection');
    
    console.log('[allRequestsUser] Elements found:', {
      historySection: !!historySection,
      historyContainer: !!historyContainer,
      rightColumn: !!rightColumn,
      modalBody: !!modalBody,
      modalContent: !!modalContent
    });
    
    if (!historyContainer) {
      console.log('[allRequestsUser] History container not found!');
      return;
    }
    
    try {
        const response = await fetch(`/api/revision-history/${requestId}`);
        
        const contentType = response.headers.get('content-type');
        if (!contentType || !contentType.includes('application/json')) {
            if (historySection) historySection.style.display = 'none';
            if (rightColumn) rightColumn.style.display = 'none';
            if (modalBody) modalBody.classList.remove('two-column');
            return;
        }
        
        const result = await response.json();
        
        console.log('🔥 [AllRequests] RAW API RESPONSE:', result);
        
        // Filter out initial submission, but show unit feedback AND user resubmissions
        console.log('📋 [AllRequests] All revisions before filter:', result.revisions);
        console.log('📊 [AllRequests] REVISION TYPES:', result.revisions?.map((r, i) => ({ 
            index: i,
            type: r.type, 
            createdBy: r.createdBy, 
            hasFiles: !!r.files,
            filesCount: r.files?.length || 0,
            fileNames: r.files || []
        })));
        const revisionsToShow = result.revisions ? result.revisions.filter(rev => rev.type !== 'initial') : [];
        console.log('✅ [AllRequests] Revisions after filter (showing):', revisionsToShow);
        console.log('📊 [AllRequests] FILTERED TYPES:', revisionsToShow.map(r => ({ type: r.type, createdBy: r.createdBy, files: r.files?.length || 0 })));
        
        if (result.success && revisionsToShow.length > 0) {
            console.log('[allRequestsUser] Revisions to show:', revisionsToShow.length);
            console.log('[allRequestsUser] BEFORE layout change - modalContent classes:', modalContent ? modalContent.className : 'N/A');
            console.log('[allRequestsUser] BEFORE layout change - modalContent width:', modalContent ? modalContent.offsetWidth : 'N/A');
            
            // Show two-column layout
            if (rightColumn) rightColumn.style.display = 'flex';
            if (modalBody) modalBody.classList.add('two-column');
            if (modalContent) modalContent.classList.add('has-revisions');
            if (historySection) historySection.style.display = 'block';
            
            // Force reflow
            if (modalContent) {
              void modalContent.offsetHeight;
              console.log('[allRequestsUser] AFTER layout change - modalContent classes:', modalContent.className);
              console.log('[allRequestsUser] AFTER layout change - modalContent width:', modalContent.offsetWidth);
              console.log('[allRequestsUser] AFTER layout change - computed width:', window.getComputedStyle(modalContent).width);
              console.log('[allRequestsUser] AFTER layout change - computed max-width:', window.getComputedStyle(modalContent).maxWidth);
            }
            
            historyContainer.innerHTML = '';
            
            revisionsToShow.forEach((revision, index) => {
                const entry = createRevisionEntry(revision, index, revisionsToShow.length);
                historyContainer.appendChild(entry);
            });
            
            // Check if request is "For Revision" - show resubmission form
            const row = document.querySelector(`tr[data-id="${requestId}"]`);
            const status = row ? row.dataset.status : '';
            console.log('🔍 [AllRequests] Checking resubmission form visibility:', { requestId, status, hasSection: !!resubmissionSection });
            
            if ((status.toLowerCase() === 'for revision' || status.toLowerCase() === 'revision requested') && resubmissionSection) {
                console.log('✅ [AllRequests] Showing resubmission form');
                resubmissionSection.style.display = 'block';
                
                // Initialize Quill editor if not already initialized
                if (!resubmissionQuill) {
                    resubmissionQuill = new Quill('#resubmissionEditor', {
                        theme: 'snow',
                        placeholder: 'Enter your response to the revision request...',
                        modules: {
                            toolbar: [
                                ['bold', 'italic', 'underline'],
                                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                                ['link'],
                                ['clean']
                            ]
                        }
                    });
                }
            } else if (resubmissionSection) {
                resubmissionSection.style.display = 'none';
            }
        } else {
            if (historySection) historySection.style.display = 'none';
            if (rightColumn) rightColumn.style.display = 'none';
            if (modalBody) modalBody.classList.remove('two-column');
            
            // Keep modal at original size
            const modalContent = document.querySelector('.requestor-modal-content');
            if (modalContent) modalContent.classList.remove('has-revisions');
        }
    } catch (error) {
        console.error('Error loading revision history:', error);
        if (historySection) historySection.style.display = 'none';
        if (rightColumn) rightColumn.style.display = 'none';
        if (modalBody) modalBody.classList.remove('two-column');
        
        const modalContent = document.querySelector('.requestor-modal-content');
        if (modalContent) modalContent.classList.remove('has-revisions');
    }
}

function createRevisionEntry(revision, index, total) {
    console.log('🔍 [AllRequests] Creating revision entry:', {
        index,
        total,
        hasRequestedBy: !!revision.requestedBy,
        hasRespondedBy: !!revision.respondedBy,
        status: revision.status,
        revisionNotes: revision.revisionNotes,
        responseNotes: revision.responseNotes,
        hasFiles: revision.responseFiles?.length > 0 || revision.revisionFiles?.length > 0,
        revision: revision
    });
    
    const entry = document.createElement('div');
    
    // Determine if this is a unit action or requestor action
    // Unit action: has requestedBy (unit requests revision)
    // Requestor action: has respondedBy but no requestedBy (user resubmits)
    const isUnitAction = revision.requestedBy && !revision.respondedBy;
    const isRequestorAction = revision.respondedBy && !revision.requestedBy;
    
    console.log('✅ [AllRequests] Action type:', {
        isUnitAction,
        isRequestorAction
    });
    
    entry.className = `revision-conversation-item ${isUnitAction ? 'unit-action' : 'requestor-action'}`;
    
    const revisionNumber = index + 1;
    // Use requestedAt for unit actions, respondedAt for requestor actions
    const timestamp = new Date(revision.requestedAt || revision.respondedAt);
    const fullDate = timestamp.toLocaleString('en-US', {
        weekday: 'long',
        month: 'long',
        day: 'numeric',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true
    });
    
    // Determine type label based on action type
    let typeLabel = '';
    let badgeClass = '';
    if (isUnitAction) {
        typeLabel = 'Revision Requested';
        badgeClass = 'badge-revision';
    } else if (isRequestorAction) {
        typeLabel = 'Resubmitted for Review';
        badgeClass = 'badge-resubmitted';
    } else {
        typeLabel = 'Update';
        badgeClass = 'badge-revision';
    }
    
    // Calculate relative time
    const now = new Date();
    const diffMs = now - timestamp;
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);
    
    let relativeTime = '';
    if (diffMins < 1) relativeTime = 'Just now';
    else if (diffMins < 60) relativeTime = `${diffMins} minute${diffMins > 1 ? 's' : ''} ago`;
    else if (diffHours < 24) relativeTime = `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;
    else relativeTime = `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;
    
    // Show status indicator on last message
    let statusIndicator = '';
    if (index === total - 1) {
        if (revision.type === 'approved') {
            statusIndicator = `
                <div class="status-indicator approved">
                    <svg width="16" height="16" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="8 12 11 15 16 9"/>
                    </svg>
                    <span style="color: #10b981; font-weight: 600;">Your Request Has Been Approved!</span>
                </div>
            `;
        } else if (isUnitAction) {
            statusIndicator = `
                <div class="status-indicator waiting">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    Waiting for Your Response
                </div>
            `;
        } else {
            statusIndicator = `
                <div class="status-indicator under-review">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                    Under Unit Review
                </div>
            `;
        }
    }
    
    entry.innerHTML = `
        <div class="revision-number-badge">#${revisionNumber}</div>
        <div class="revision-message-bubble">
            <div class="revision-bubble-header">
                <div>
                    <span class="revision-author">${escapeHtml(revision.by || 'System')}</span>
                    <span class="revision-badge ${badgeClass}" style="margin-left: 0.5rem;">${typeLabel}</span>
                </div>
                <div class="revision-timestamp">
                    <span style="font-weight: 600; color: #1e293b;">${fullDate}</span>
                    <span style="font-size: 0.75rem; color: #94a3b8;">${relativeTime}</span>
                </div>
            </div>
            
            <div class="message-content-section">
                <div class="content-label">${isUnitAction ? 'UNIT FEEDBACK:' : 'YOUR RESPONSE:'}</div>
                <div class="content-text">${(() => {
                    const content = isUnitAction ? revision.revisionNotes : revision.responseNotes;
                    console.log('🎯 Rendering content:', { isUnitAction, content, type: typeof content });
                    return displayFormattedText(content || 'No feedback provided');
                })()}</div>
            </div>
            
            ${((revision.revisionFiles && revision.revisionFiles.length > 0) || (revision.responseFiles && revision.responseFiles.length > 0)) ? `
                <div class="message-attachments-section">
                    <div class="attachments-header">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                        </svg>
                        <span class="attachments-count">${(revision.revisionFiles || revision.responseFiles).length} file${(revision.revisionFiles || revision.responseFiles).length > 1 ? 's' : ''} attached</span>
                    </div>
                    <div class="attachments-grid">
                        ${(revision.revisionFiles || revision.responseFiles).map(file => createRevisionFileCard(file)).join('')}
                    </div>
                </div>
            ` : ''}
            
            ${statusIndicator}
        </div>
    `;
    
    return entry;
}

function createRevisionFileCard(file) {
    console.log('📁 [AllRequests] Creating file card for:', file);
    const filename = typeof file === 'string' ? file : (file.filename || file.name || file);
    const displayName = typeof file === 'object' ? (file.originalname || file.filename || file.name) : file;
    const ext = filename.split('.').pop().toLowerCase();
    const isImage = ['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext);
    const isPDF = ext === 'pdf';
    console.log('📁 [AllRequests] File details:', { filename, displayName, ext, isImage, isPDF });
    
    // Extract timestamp from filename if present (format: upload-timestamp-randomnumber.ext)
    let uploadDate = '';
    const timestampMatch = filename.match(/upload-?(\d{13})/);
    console.log('📅 [AllRequests] Timestamp extraction:', {
        filename,
        timestampMatch,
        hasMatch: !!timestampMatch,
        extractedTimestamp: timestampMatch ? timestampMatch[1] : null
    });
    if (timestampMatch) {
        const timestamp = parseInt(timestampMatch[1]);
        const date = new Date(timestamp);
        uploadDate = date.toLocaleString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
        console.log('✅ [AllRequests] Extracted date:', uploadDate);
    } else {
        console.log('⚠️ [AllRequests] No timestamp match found in filename');
    }
    
    let iconColor = '#64748b';
    if (isImage) iconColor = '#059669';
    else if (isPDF) iconColor = '#dc2626';
    else if (['doc', 'docx'].includes(ext)) iconColor = '#2563eb';
    else if (['xls', 'xlsx'].includes(ext)) iconColor = '#16a34a';
    
    return `
        <div class="revision-file-card">
            <div class="revision-file-icon" style="background: ${iconColor}20; color: ${iconColor};">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="4" y="4" width="16" height="16" rx="2"/>
                    <line x1="8" y1="8" x2="16" y2="8"/>
                    <line x1="8" y1="12" x2="16" y2="12"/>
                </svg>
            </div>
            <div class="revision-file-info">
                <div class="revision-file-name" title="${escapeHtml(displayName)}">${escapeHtml(displayName)}</div>
                <div class="revision-file-size">${ext.toUpperCase()}${uploadDate ? ` • ${uploadDate}` : ''}</div>
            </div>
            <div class="revision-file-actions">
                <a href="/uploads/${filename}" download="${escapeHtml(displayName)}" class="revision-file-btn" title="Download">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                </a>
            </div>
        </div>
    `;
}

// Handle resubmission (Submit for Approval Again)
async function handleResubmission() {
    if (!resubmissionQuill || !currentConversationId) return;
    
    const responseText = resubmissionQuill.root.innerHTML;
    const filesInput = document.getElementById('resubmissionFiles');
    
    // Validate response text
    if (!responseText || responseText.trim() === '<p><br></p>' || responseText.trim() === '') {
        if (typeof window.showAlert === 'function') {
            window.showAlert('error', 'Please enter your response before submitting.');
        } else {
            alert('Please enter your response before submitting.');
        }
        return;
    }
    
    const formData = new FormData();
    formData.append('resubmissionNotes', responseText);
    
    // Add files if any
    if (filesInput && filesInput.files.length > 0) {
        for (let i = 0; i < filesInput.files.length; i++) {
            formData.append('additionalFiles', filesInput.files[i]);
        }
    }
    
    try {
        const response = await fetch(`/resubmit-approval-request/${currentConversationId}`, {
            method: 'POST',
            body: formData
        });
        
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const result = await response.json();
        
        if (result.success) {
            if (typeof window.showAlert === 'function') {
                window.showAlert('success', 'Your response has been submitted successfully!');
            } else {
                alert('Your response has been submitted successfully!');
            }
            
            // Clear form
            resubmissionQuill.setContents([]);
            if (filesInput) filesInput.value = '';
            
            // Reload revision history
            await loadRevisionHistory(currentConversationId);
            
            // Close modal and refresh page
            setTimeout(() => {
                document.getElementById('detailsModal').style.display = 'none';
                location.reload();
            }, 1500);
        } else {
            if (typeof window.showAlert === 'function') {
                window.showAlert('error', result.message || 'Failed to submit response. Please try again.');
            } else {
                alert(result.message || 'Failed to submit response. Please try again.');
            }
        }
    } catch (error) {
        console.error('Error submitting resubmission:', error);
        if (typeof window.showAlert === 'function') {
            window.showAlert('error', 'An error occurred while submitting your response.');
        } else {
            alert('An error occurred while submitting your response.');
        }
    }
}

// Handle clarification request
async function handleClarificationRequest() {
    if (!resubmissionQuill || !currentConversationId) return;
    
    const responseText = resubmissionQuill.root.innerHTML;
    
    // Validate response text
    if (!responseText || responseText.trim() === '<p><br></p>' || responseText.trim() === '') {
        showAlert('error', 'Please enter your clarification question before submitting.');
        return;
    }
    
    const formData = new FormData();
    formData.append('requestId', currentConversationId);
    formData.append('message', responseText);
    formData.append('actionType', 'clarification');
    
    try {
        // Open team conversation modal for clarification
        document.getElementById('detailsModal').style.display = 'none';
        window.openTeamConversationModal(currentConversationId);
        
        // Clear form
        resubmissionQuill.setContents([]);
        
        showAlert('info', 'Opening team discussion for clarification...');
    } catch (error) {
        console.error('Error opening clarification:', error);
        showAlert('error', 'An error occurred. Please try again.');
    }
}

