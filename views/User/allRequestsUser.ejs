<style>
  /* ========================================
     USER PAGE LAYOUT - STANDARDIZED
     Matches admin page spacing and structure
     ======================================== */
  
  /* Main container - proper padding from header and edges */
  .student-side {
    padding: 0 !important;
    background: #f8f9fa !important;
    box-sizing: border-box;
  }

  /* Activity section - consistent with admin */
  .activity-section {
    padding: 0 !important;
    margin: 0 !important;
    background: #f8f9fa !important;
    overflow: visible !important;
    position: relative;
    z-index: 1;
  }

  /* Page Header Layout - with proper top spacing */
  .page-header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 2rem 3rem 0 3rem; /* Match admin padding */
  }

  .user-info-section {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
  }

  .action-button-container {
    margin-left: auto;
    display: flex;
    gap: 0.75rem;
  }

  /* Navigation tabs - proper padding */
  .nav-tabs {
    padding: 0 3rem; /* Match admin padding */
    margin-bottom: 1.5rem;
  }

  /* Filter section - proper spacing from edges */
  .filter-section {
    background: white;
    border: none;
    border-radius: 0;
    padding: 1.25rem;
    margin: 0 3rem 1.5rem 3rem; /* Match admin margins */
    box-shadow: none;
    overflow: visible !important;
    position: relative;
    z-index: 1;
  }

  /* Table section - proper padding */
  .table-section {
    background: white;
    padding: 1.5rem;
    margin: 0 3rem 2rem 3rem; /* Match admin margins */
    border-radius: 0;
  }

  /* Content wrapper */
  .student-side > .div {
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
    background: transparent;
  }

  /* Responsive breathing room */
  @media (max-width: 1200px) {
    .page-header-container,
    .nav-tabs,
    .filter-section,
    .table-section {
      padding-left: 2rem;
      padding-right: 2rem;
      margin-left: 2rem;
      margin-right: 2rem;
    }
  }

  @media (max-width: 768px) {
    .page-header-container {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
      margin-left: 1.5rem;
      margin-right: 1.5rem;
    }
    
    .nav-tabs,
    .filter-section,
    .table-section {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
      margin-left: 1.5rem;
      margin-right: 1.5rem;
    }
    
    .action-button-container {
      width: 100%;
      margin-left: 0;
      flex-direction: column;
    }
    
    .action-button-container .view-all-btn {
      width: 100%;
    }
  }

  .modal-title.warning {
  font-size: 1.25rem;
  font-weight: 600;
  color: rgb(194, 122, 40);
}

  .requestor-modal-header {
    background: linear-gradient(135deg, #2d7a4a 0%, #256d3f 100%) !important;
    box-shadow: 0 4px 12px rgba(45, 122, 74, 0.25) !important;
    padding: 1.5rem 2rem !important;
    border-radius: 16px 16px 0 0 !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
  }

.message {
  margin-bottom: 1.5rem;
  max-width: 80%;
}

.admin-message {
  margin-left: auto;
}

.user-message {
  margin-right: auto;
}

.message-content {
  padding: 0.75rem;
  border-radius: 0.5rem;
  background: white;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
}

.user-message .message-content {
  background: var(--primary-green);
  color: white;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
  font-size: 0.875rem;
}

.message-time {
  opacity: 0.7;
  font-size: 0.75rem;
}

.message-text {
  word-wrap: break-word;
}
/* Enhanced Request Details Modal Styles */
.details-modal-body {
  padding: 0;
  max-height: 80vh;
  overflow-y: auto;
}

.details-content {
  padding: 2rem;
}

.details-section {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 2rem;
  margin-bottom: 1.5rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.details-section:hover {
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  transform: translateY(-1px);
}

.details-section h3 {
  margin: 0 0 1.5rem 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary-green);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
  position: relative;
}

.details-section h3::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 60px;
  height: 2px;
  background: var(--primary-green);
  border-radius: 1px;
}

.details-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

.details-field {
  background: white;
  border-radius: 12px;
  padding: 1.25rem;
  border: 1px solid #f1f5f9;
  transition: all 0.3s ease;
}

.details-field:hover {
  border-color: #e2e8f0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.details-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 0.5rem;
  display: block;
}

.details-value {
  font-size: 1rem;
  color: #1e293b;
  line-height: 1.6;
  font-weight: 500;
}

.status-badge-large {
  display: inline-flex;
  align-items: center;
  padding: 0.625rem 1.25rem;
  border-radius: 25px;
  font-size: 0.875rem;
  font-weight: 600;
  text-transform: capitalize;
  border: 2px solid transparent;
  transition: all 0.3s ease;
}

.status-badge-large.pending {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #92400e;
  border-color: #f59e0b;
}

.status-badge-large.queued {
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
  color: #0c4a6e;
  border-color: #0ea5e9;
}

.status-badge-large.in-progress,
.status-badge-large.inprogress {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #1e40af;
  border-color: #3b82f6;
}

.status-badge-large.approved {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  color: #065f46;
  border-color: #10b981;
}

.status-badge-large.rejected {
  background: linear-gradient(135deg, #fecaca, #fca5a5);
  color: #991b1b;
  border-color: #ef4444;
}

.status-badge-large.completed {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #1e40af;
  border-color: #3b82f6;
}

.deadline-badge-large {
  display: inline-flex;
  align-items: center;
  padding: 0.625rem 1.25rem;
  border-radius: 25px;
  font-size: 0.875rem;
  font-weight: 600;
  background: linear-gradient(135deg, #f8fafc, #f1f5f9);
  color: #475569;
  border: 2px solid #e2e8f0;
  transition: all 0.3s ease;
}

.deadline-badge-large.overdue {
  background: linear-gradient(135deg, #fecaca, #fca5a5);
  color: #dc2626;
  border-color: #ef4444;
}

.deadline-badge-large.near-deadline {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #d97706;
  border-color: #f59e0b;
}

.description-section {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 2rem;
  margin-bottom: 1.5rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.description-section h3 {
  margin: 0 0 1.5rem 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary-green);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
  position: relative;
}

.description-section h3::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 60px;
  height: 2px;
  background: var(--primary-green);
  border-radius: 1px;
}

.description-content {
  background: white;
  border-radius: 12px;
  padding: 1.5rem;
  border: 1px solid #f1f5f9;
  line-height: 1.7;
  color: #374151;
  font-size: 1rem;
}

.chat-section {
  text-align: center;
  margin-top: 1.5rem;
  padding: 2rem;
  background: linear-gradient(135deg, #f0fdf4, #f7fee7);
  border-radius: 16px;
  border: 1px solid #bbf7d0;
}

/* ========================================
   DEPRECATED CLASSES - USE unit-modal-* INSTEAD
   ======================================== */
/* The following classes have been replaced by standardized unit-modal-* classes.
   They are kept for reference only and should not be used in new code.
   - .requestor-modal-body → .unit-modal-body
   - .requestor-left-column → .unit-left-column
   - .requestor-right-column → .unit-right-column
*/

/* Revision Section Styles */
.requestor-revision-section {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 1.5rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.requestor-section-header h3 {
  margin: 0 0 1.25rem 0;
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--primary-green);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
}

/* Revision History Timeline (matching unit side) */
.revision-history-timeline {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-top: 1rem;
}

.revision-conversation-item {
  display: flex;
  flex-direction: column;
  position: relative;
}

.revision-conversation-item.unit-action {
  padding-left: 4rem;
}

.revision-conversation-item.requestor-action {
  padding-right: 4rem;
  align-items: flex-end;
}

.revision-number-badge {
  position: absolute;
  left: 0;
  top: 0;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.875rem;
  color: white;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.revision-conversation-item.unit-action .revision-number-badge {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  left: 0;
}

.revision-conversation-item.requestor-action .revision-number-badge {
  background: linear-gradient(135deg, var(--primary-green), #059669);
  right: 0;
  left: auto;
}

.revision-message-bubble {
  background: white;
  border-radius: 12px;
  padding: 1.25rem;
  border: 1px solid #e5e7eb;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  max-width: 100%;
}

.revision-conversation-item.unit-action .revision-message-bubble {
  border-left: 3px solid #3b82f6;
}

.revision-conversation-item.requestor-action .revision-message-bubble {
  border-left: 3px solid var(--primary-green);
}

.revision-bubble-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.75rem;
  gap: 1rem;
}

.revision-author {
  font-weight: 600;
  color: #1e293b;
  font-size: 0.9375rem;
}

.revision-timestamp {
  font-size: 0.8125rem;
  color: #64748b;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.25rem;
}

.message-content-section {
  margin-top: 0.75rem;
}

.content-label {
  font-size: 0.75rem;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 0.5rem;
}

.content-text {
  color: #374151;
  line-height: 1.6;
  font-size: 0.9375rem;
}

.message-attachments-section {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid #f1f5f9;
}

.attachments-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  color: #64748b;
  margin-bottom: 0.75rem;
}

.attachments-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 0.75rem;
}

/* Resubmission Form Styles */
.requestor-resubmission-section {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 1.5rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.form-group {
  margin-bottom: 1.5rem;
}

.form-group label {
  display: block;
  font-weight: 600;
  color: #374151;
  margin-bottom: 0.5rem;
  font-size: 0.9375rem;
}

#resubmissionEditor {
  border: 1px solid #d1d5db;
  border-radius: 8px;
  min-height: 150px;
}

.form-group input[type="file"] {
  display: block;
  width: 100%;
  padding: 20px;
  border: 2px dashed #cbd5e1;
  border-radius: 12px;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 14px;
  color: #475569;
  font-weight: 500;
  text-align: center;
}

.form-group input[type="file"]:hover {
  border-color: #3b82f6;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  border-style: solid;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
}

.form-group input[type="file"]:focus {
  outline: none;
  border-color: #3b82f6;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1), 0 4px 12px rgba(59, 130, 246, 0.2);
}

.form-group input[type="file"]::file-selector-button {
  padding: 10px 20px;
  margin-right: 12px;
  border: none;
  border-radius: 8px;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: white;
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.form-group input[type="file"]::file-selector-button:hover {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  transform: translateY(-1px);
  box-shadow: 0 4px 8px rgba(37, 99, 235, 0.3);
}

.file-list {
  margin-top: 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.resubmission-actions {
  display: flex;
  gap: 1rem;
  margin-top: 1.5rem;
}

.btn-resubmit,
.btn-clarification {
  flex: 1;
  padding: 0.875rem 1.5rem;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.9375rem;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.btn-resubmit {
  background: linear-gradient(135deg, var(--primary-green), #059669);
  color: white;
  box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3);
}

.btn-resubmit:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
}

.btn-clarification {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: white;
  box-shadow: 0 2px 8px rgba(245, 158, 11, 0.3);
}

.btn-clarification:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
}

.add-link-btn {
  background: linear-gradient(135deg, var(--primary-green), #20c997);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 0.75rem 1.5rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  box-shadow: 0 2px 8px rgba(64, 139, 78, 0.2);
}

.add-link-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(64, 139, 78, 0.3);
  background: linear-gradient(135deg, #157347, var(--primary-green));
}

.status-indicator {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: #fef3c7;
  color: #92400e;
  border-radius: 6px;
  font-size: 0.8125rem;
  font-weight: 600;
  margin-top: 0.75rem;
}

.status-indicator.waiting {
  background: #fef3c7;
  color: #92400e;
}

.status-indicator.under-review {
  background: #dbeafe;
  color: #1e40af;
}

/* Revision File Cards */
.revision-file-card {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 0.75rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  transition: all 0.2s ease;
}

.revision-file-card:hover {
  border-color: #3b82f6;
  box-shadow: 0 2px 8px rgba(59, 130, 246, 0.1);
}

.revision-file-icon {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.revision-file-info {
  flex: 1;
  min-width: 0;
}

.revision-file-name {
  font-size: 0.8125rem;
  font-weight: 600;
  color: #1e293b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.revision-file-size {
  font-size: 0.75rem;
  color: #64748b;
}

.revision-file-actions {
  display: flex;
  gap: 0.25rem;
}

.revision-file-btn {
  width: 1.75rem;
  height: 1.75rem;
  border: none;
  background: #f1f5f9;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  color: #64748b;
  text-decoration: none;
  flex-shrink: 0;
}

.revision-file-btn:hover {
  background: var(--primary-green);
  color: white;
  transform: scale(1.1);
}

.revision-file-btn:active {
  transform: scale(0.95);
}

.chat-btn-enhanced {
  background: linear-gradient(135deg, var(--primary-green), #20c997);
  color: white;
  border: none;
  padding: 1rem 2.5rem;
  border-radius: 30px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 1rem;
  box-shadow: 0 4px 20px rgba(64, 139, 78, 0.2);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.chat-btn-enhanced:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 30px rgba(64, 139, 78, 0.3);
  background: linear-gradient(135deg, #157347, var(--primary-green));
}

/* Enhanced file preview styles */
.enhanced-file-preview {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 2rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  margin-bottom: 1.5rem;
}

.enhanced-file-preview h3 {
  margin: 0 0 1.5rem 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary-green);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
  position: relative;
