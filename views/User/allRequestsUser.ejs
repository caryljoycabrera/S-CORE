    document.body.removeChild(overlay);
    document.body.style.overflow = '';
  });
  
  // Prevent body scroll
  document.body.style.overflow = 'hidden';
};

// Simple global formatting function - works immediately
window.applyFormatting = function(format) {
  console.log('[Formatting] ✅ applyFormatting called with format:', format);
  
  const input = document.getElementById('teamMessageInput');
  if (!input) {
    console.error('[Formatting] ❌ teamMessageInput not found!');
    console.log('[Formatting] Available inputs:', {
      byId: document.getElementById('teamMessageInput'),
      byQuery: document.querySelector('#teamMessageInput'),
      allTextareas: document.querySelectorAll('textarea').length
    });
    return;
  }
  
  console.log('[Formatting] ✅ Input found, applying format');
  const start = input.selectionStart;
  const end = input.selectionEnd;
  const selectedText = input.value.substring(start, end);
  console.log('[Formatting] Selection:', { start, end, selectedText });
  
  // Prevent default if this was triggered by a keyboard shortcut
  if (window.event) {
    window.event.preventDefault();
  }
  
  let startTag = '';
  let endTag = '';
  
  switch(format) {
    case 'bold':
      startTag = '**';
      endTag = '**';
      break;
    case 'italic':
      startTag = '*';
      endTag = '*';
      break;
    case 'underline':
      startTag = '<u>';
      endTag = '</u>';
      break;
  }
  
  if (selectedText) {
    const formattedText = `${startTag}${selectedText}${endTag}`;
    const beforeText = input.value.substring(0, start);
    const afterText = input.value.substring(end);
    
    input.value = beforeText + formattedText + afterText;
    
    // Set cursor position after formatted text
    const newPosition = start + formattedText.length;
    input.setSelectionRange(newPosition, newPosition);
  } else {
    // If no text selected, insert tags where cursor is
    const cursorPos = input.selectionStart;
    const beforeText = input.value.substring(0, cursorPos);
    const afterText = input.value.substring(cursorPos);
    
    input.value = beforeText + startTag + endTag + afterText;
    
    // Position cursor between tags
    const newPosition = cursorPos + startTag.length;
    input.setSelectionRange(newPosition, newPosition);
  }
  
  input.focus();
  console.log('[Formatting] ✓ Applied:', format);
};

// Add keyboard shortcut support
document.addEventListener('DOMContentLoaded', function() {
  document.addEventListener('keydown', function(e) {
    // Check if user is typing in the message input
    const input = document.getElementById('teamMessageInput');
    if (!input || document.activeElement !== input) return;
    
    // Ctrl+B for bold
    if (e.ctrlKey && e.key === 'b') {
      e.preventDefault();
      console.log('[Keyboard] Ctrl+B pressed');
      applyFormatting('bold');
    }
    // Ctrl+I for italic
    else if (e.ctrlKey && e.key === 'i') {
      e.preventDefault();
      console.log('[Keyboard] Ctrl+I pressed');
      applyFormatting('italic');
    }
    // Ctrl+U for underline
    else if (e.ctrlKey && e.key === 'u') {
      e.preventDefault();
      console.log('[Keyboard] Ctrl+U pressed');
      applyFormatting('underline');
    }
  });
  console.log('[Keyboard] Shortcuts registered: Ctrl+B, Ctrl+I, Ctrl+U');
});

