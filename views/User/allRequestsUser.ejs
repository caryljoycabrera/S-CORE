// Simple global formatting function - works immediately (WYSIWYG via execCommand)
window.applyChatFormat = function(formatType) {
  console.log('[Formatting] ✅ applyChatFormat called with format:', formatType);

  const input = document.getElementById('teamMessageInput');
  if (!input) {
    console.error('[Formatting] ❌ teamMessageInput not found!');
    return;
  }

  // Check if contenteditable (DIV) or textarea (fallback)
  if (input.tagName === 'DIV' || input.getAttribute('contenteditable') !== null) {
    // WYSIWYG: use execCommand for immediate visual formatting
    const cmdMap = { bold: 'bold', italic: 'italic', underline: 'underline' };
    const cmd = cmdMap[formatType];
    if (cmd && document.queryCommandSupported(cmd)) {
      document.execCommand(cmd, false, null);
    }
    input.focus();
  } else {
    // Textarea fallback: markdown markers
    const start = input.selectionStart;
    const end = input.selectionEnd;
    const selectedText = input.value.substring(start, end);

    let startTag = '';
    let endTag = '';
    switch(formatType) {
      case 'bold': startTag = '**'; endTag = '**'; break;
      case 'italic': startTag = '*'; endTag = '*'; break;
      case 'underline': startTag = '__'; endTag = '__'; break;
    }

    if (selectedText) {
      const formattedText = `${startTag}${selectedText}${endTag}`;
      input.value = input.value.substring(0, start) + formattedText + input.value.substring(end);
      input.setSelectionRange(start + formattedText.length, start + formattedText.length);
    } else {
      const cursorPos = input.selectionStart;
      input.value = input.value.substring(0, cursorPos) + startTag + endTag + input.value.substring(cursorPos);
      input.setSelectionRange(cursorPos + startTag.length, cursorPos + startTag.length);
    }
    input.focus();
  }
  console.log('[Formatting] ✓ Applied:', formatType);
};

