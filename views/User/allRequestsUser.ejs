<style>
  /* ========================================
     USER PAGE LAYOUT - STANDARDIZED
     Matches admin page spacing and structure
     ======================================== */
  
  /* Main container - proper padding from header and edges */
  .student-side {
    padding: 0 !important;
    background: #f8f9fa !important;
    box-sizing: border-box;
  }

  /* Activity section - consistent with admin */
  .activity-section {
    padding: 0 !important;
    margin: 0 !important;
    background: #f8f9fa !important;
    overflow: visible !important;
    position: relative;
    z-index: 1;
  }

  /* Page Header Layout - with proper top spacing */
  .page-header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 2rem 3rem 0 3rem; /* Match admin padding */
  }

  .user-info-section {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
  }

  .action-button-container {
    margin-left: auto;
    display: flex;
    gap: 0.75rem;
  }

  /* Navigation tabs - proper padding */
  .nav-tabs {
    padding: 0 3rem; /* Match admin padding */
    margin-bottom: 1.5rem;
  }

  /* Filter section - proper spacing from edges */
  .filter-section {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid var(--primary-green);
    border-radius: 12px;
    padding: 1.25rem;
    margin: 0 3rem 1.5rem 3rem; /* Match admin margins */
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    overflow: visible !important;
    position: relative;
    z-index: 1;
  }

  /* Table section - proper padding */
  .table-section {
    background: white;
    padding: 1.5rem;
    margin: 0 3rem 2rem 3rem; /* Match admin margins */
    border-radius: 0;
  }

  /* Content wrapper */
  .student-side > .div {
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
    background: transparent;
  }

  /* Responsive breathing room */
  @media (max-width: 1200px) {
    .page-header-container,
    .nav-tabs,
    .filter-section,
    .table-section {
      padding-left: 2rem;
      padding-right: 2rem;
      margin-left: 2rem;
      margin-right: 2rem;
    }
  }

  @media (max-width: 768px) {
    .page-header-container {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
      margin-left: 1.5rem;
      margin-right: 1.5rem;
    }
    
    .nav-tabs,
    .filter-section,
    .table-section {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
      margin-left: 1.5rem;
      margin-right: 1.5rem;
    }
    
    .action-button-container {
      width: 100%;
      margin-left: 0;
      flex-direction: column;
    }
    
    .action-button-container .view-all-btn {
      width: 100%;
    }
  }

  .modal-title.warning {
  font-size: 1.25rem;
  font-weight: 600;
  color: rgb(194, 122, 40);
}

  .requestor-modal-header {
    background: linear-gradient(135deg, #2d7a4a 0%, #256d3f 100%) !important;
    box-shadow: 0 4px 12px rgba(45, 122, 74, 0.25) !important;
    padding: 1.5rem 2rem !important;
    border-radius: 16px 16px 0 0 !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
  }

.message {
  margin-bottom: 1.5rem;
  max-width: 80%;
}

.admin-message {
  margin-left: auto;
}

.user-message {
  margin-right: auto;
}

.message-content {
  padding: 0.75rem;
  border-radius: 0.5rem;
  background: white;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
}

.user-message .message-content {
  background: var(--primary-green);
  color: white;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
