// ========== REVISION HISTORY FUNCTIONS ==========

async function loadRevisionHistory(requestId, page = Number.MAX_SAFE_INTEGER) {
    console.log('[allRequestsUser] loadRevisionHistory called for:', requestId);
    const historySection = document.getElementById('revisionHistorySection');
    const historyContainer = document.getElementById('revisionHistoryContainer');
    const pagerContainer = document.getElementById('revisionHistoryPager');
    const rightColumn = document.getElementById('requestorRightColumn');
    const modalBody = document.querySelector('.unit-modal-body');
    const modalContent = document.querySelector('.unit-modal-wide');
    const resubmissionSection = document.getElementById('resubmissionFormSection');

    console.log('[allRequestsUser] Elements found:', {
      historySection: !!historySection,
      historyContainer: !!historyContainer,
      rightColumn: !!rightColumn,
      modalBody: !!modalBody,
      modalContent: !!modalContent
    });

    if (!historyContainer) {
      console.log('[allRequestsUser] History container not found!');
      return;
    }

    try {
        // page defaults to a huge number so the API clamps it to the true last page,
        // surfacing the most recent/actionable entry without an extra click.
        const response = await fetch(`/api/revision-history/${requestId}?page=${page}&limit=5`);

        const contentType = response.headers.get('content-type');
        if (!contentType || !contentType.includes('application/json')) {
            if (historySection) historySection.style.display = 'none';
            // Keep right column visible for chat button
            if (rightColumn) rightColumn.style.display = 'flex';
            if (modalBody) modalBody.classList.add('two-column');
            if (modalContent) modalContent.classList.add('has-revisions');
            return;
        }
        
        const result = await response.json();
        
        console.log('🔥 [AllRequests] RAW API RESPONSE:', result);
        
        // Show all revisions including initial submission
        console.log('📋 [AllRequests] All revisions:', result.revisions);
        console.log('📊 [AllRequests] REVISION TYPES:', result.revisions?.map((r, i) => ({ 
            index: i,
            type: r.type, 
            createdBy: r.createdBy, 
            hasFiles: !!r.files,
            filesCount: r.files?.length || 0,
            fileNames: r.files || []
        })));
        const revisionsToShow = result.revisions ? result.revisions : [];
        console.log('✅ [AllRequests] All revisions to show:', revisionsToShow);
        console.log('📊 [AllRequests] ALL TYPES:', revisionsToShow.map(r => ({ type: r.type, createdBy: r.createdBy, files: r.files?.length || 0 })));
        
        if (result.success && revisionsToShow.length > 0) {
            console.log('[allRequestsUser] Revisions to show:', revisionsToShow.length);
            console.log('[allRequestsUser] BEFORE layout change - modalContent classes:', modalContent ? modalContent.className : 'N/A');
            console.log('[allRequestsUser] BEFORE layout change - modalContent width:', modalContent ? modalContent.offsetWidth : 'N/A');
            
            // Show two-column layout
            if (rightColumn) rightColumn.style.display = 'flex';
            if (modalBody) modalBody.classList.add('two-column');
            if (modalContent) modalContent.classList.add('has-revisions');
            if (historySection) historySection.style.display = 'block';
            
            // Force reflow
            if (modalContent) {
              void modalContent.offsetHeight;
              console.log('[allRequestsUser] AFTER layout change - modalContent classes:', modalContent.className);
              console.log('[allRequestsUser] AFTER layout change - modalContent width:', modalContent.offsetWidth);
              console.log('[allRequestsUser] AFTER layout change - computed width:', window.getComputedStyle(modalContent).width);
              console.log('[allRequestsUser] AFTER layout change - computed max-width:', window.getComputedStyle(modalContent).maxWidth);
            }
            
            historyContainer.innerHTML = '';

            const pagination = result.pagination || { page: 1, totalPages: 1 };
            const isLastPage = pagination.page >= pagination.totalPages;

            // Render this page's revisions (duplicates are now filtered on the API side)
            revisionsToShow.forEach((revision, index) => {
              const entry = createRevisionEntry(revision, index, revisionsToShow.length, isLastPage);
              historyContainer.appendChild(entry);
            });

            renderRevisionPager(pagerContainer, requestId, pagination);
            
            // Check if request is "For Revision" - show resubmission form
            const row = document.querySelector(`tr[data-id="${requestId}"]`);
            const status = row ? row.dataset.status : '';
            console.log('🔍 [AllRequests] Checking resubmission form visibility:', { requestId, status, hasSection: !!resubmissionSection });
            
            // Show approval action buttons if status is "For Revision"
            const approvalActionButtons = document.getElementById('approvalActionButtons');
            if ((status.toLowerCase() === 'for revision' || status.toLowerCase() === 'revision requested')) {
                if (approvalActionButtons) {
                    approvalActionButtons.style.display = 'flex';
                    console.log('✅ [AllRequests] Showing approval action button');
                }
                
                if (resubmissionSection) {
                    console.log('✅ [AllRequests] Showing resubmission form for "For Revision" status');
                    resubmissionSection.style.display = 'block';
                    
                    // Update button text to show it's visible
                    const toggleBtn = document.getElementById('showResubmissionFormBtn');
                    const toggleText = document.getElementById('resubmissionFormToggleText');
                    if (toggleBtn && toggleText) {
                        toggleText.textContent = 'Hide Response Form';
                        toggleBtn.style.background = 'linear-gradient(135deg, #ef4444 0%, #dc2626 100%)';
                    }
                
                    // Initialize Quill editor if not already initialized
                    if (!resubmissionQuill) {
                        resubmissionQuill = new Quill('#resubmissionEditor', {
                            theme: 'snow',
                            placeholder: 'Enter your response to the revision request...',
                            modules: {
                                toolbar: [
                                    ['bold', 'italic', 'underline'],
                                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                                    ['link'],
                                    ['clean']
                                ]
                            }
                        });

                        // Add keyboard shortcuts for text formatting
                        const resubmissionEditor = document.querySelector('#resubmissionEditor');
                        if (resubmissionEditor) {
                            resubmissionEditor.addEventListener('keydown', function(e) {
                                // Ctrl+B for Bold
                                if (e.ctrlKey && e.key === 'b') {
                                    e.preventDefault();
                                    const format = resubmissionQuill.getFormat();
                                    resubmissionQuill.format('bold', !format.bold);
                                }
                                // Ctrl+I for Italic
                                else if (e.ctrlKey && e.key === 'i') {
                                    e.preventDefault();
                                    const format = resubmissionQuill.getFormat();
                                    resubmissionQuill.format('italic', !format.italic);
                                }
                                // Ctrl+U for Underline
                                else if (e.ctrlKey && e.key === 'u') {
                                    e.preventDefault();
                                    const format = resubmissionQuill.getFormat();
                                    resubmissionQuill.format('underline', !format.underline);
                                }
                            });
                        }
                    }
                }
            } else {
                // Hide approval action buttons if status is not "For Revision"
                if (approvalActionButtons) {
                    approvalActionButtons.style.display = 'none';
                }
                
                if (resubmissionSection) {
                    // Hide the form if status is not "For Revision"
                    console.log('❌ [AllRequests] Hiding resubmission form - status is not "For Revision"');
                    resubmissionSection.style.display = 'none';
                }
            }
        } else {
            if (historySection) historySection.style.display = 'block';
            // Keep right column visible for chat button, even with no revisions
            if (rightColumn) rightColumn.style.display = 'flex';
            if (modalBody) modalBody.classList.add('two-column');

            // Keep modal at wider size
            const modalContent = document.querySelector('.unit-modal-wide');
            if (modalContent) modalContent.classList.add('has-revisions');

            if (pagerContainer) pagerContainer.innerHTML = '';

            // Show empty revision history message
            historyContainer.innerHTML = `
                <div style="text-align: center; padding: 2rem; color: #64748b;">
                    <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin: 0 auto 1rem; opacity: 0.5;">
                        <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    <p>No revision history available yet.</p>
                    <small>Revision history will appear here when updates are made to your request.</small>
                </div>
            `;
            
            // Show service action buttons only if this is a service request
            const actionButtons = document.getElementById('serviceActionButtons');
            const isServiceRequest = currentRequestType === 'Service Request';
            if (actionButtons && isServiceRequest) {
                actionButtons.style.display = 'flex';
            }
        }
    } catch (error) {
        console.error('Error loading revision history:', error);
        if (historySection) historySection.style.display = 'block';
        // Keep right column visible for chat button, even on error
        if (rightColumn) rightColumn.style.display = 'flex';
        if (modalBody) modalBody.classList.add('two-column');
        
        const modalContent = document.querySelector('.unit-modal-wide');
        if (modalContent) modalContent.classList.add('has-revisions');

        if (pagerContainer) pagerContainer.innerHTML = '';

        // Show error message in revision history
        historyContainer.innerHTML = `
            <div style="text-align: center; padding: 2rem; color: #dc2626;">
                <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin: 0 auto 1rem; opacity: 0.5;">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="15" y1="9" x2="9" y2="15"/>
                    <line x1="9" y1="9" x2="15" y2="15"/>
                </svg>
                <p>Unable to load revision history.</p>
                <small>Please try refreshing the page.</small>
            </div>
        `;
    }
}

// Renders Prev/Page X of Y/Next controls for the revision history timeline
// loaderFnName lets this single helper serve both loadRevisionHistory
// (approval requests) and loadServiceRevisionHistory (service requests).
function renderRevisionPager(pagerContainer, requestId, pagination, loaderFnName = 'loadRevisionHistory') {
    if (!pagerContainer) return;
    const { page, totalPages } = pagination;
    if (!totalPages || totalPages <= 1) {
        pagerContainer.innerHTML = '';
        return;
    }
    pagerContainer.innerHTML = `
        <button type="button" class="pager-btn" ${page <= 1 ? 'disabled' : ''} onclick="${loaderFnName}('${requestId}', ${page - 1})">‹ Prev</button>
        <span class="pager-status">Page ${page} of ${totalPages}</span>
        <button type="button" class="pager-btn" ${page >= totalPages ? 'disabled' : ''} onclick="${loaderFnName}('${requestId}', ${page + 1})">Next ›</button>
    `;
}

function createRevisionEntry(revision, index, total, isLastPage = true) {
    console.log('🔍 [AllRequests] Creating revision entry:', {
        index,
        total,
        hasRequestedBy: !!revision.requestedBy,
        hasRespondedBy: !!revision.respondedBy,
        status: revision.status,
        revisionNotes: revision.revisionNotes,
        responseNotes: revision.responseNotes,
        hasFiles: revision.responseFiles?.length > 0 || revision.revisionFiles?.length > 0,
        revision: revision
    });
    
    const entry = document.createElement('div');
    
    // Determine if this is a unit action or requestor action
    // Unit action: has requestedBy (unit requests revision)
    // Requestor action: has respondedBy but no requestedBy (user resubmits)
    const isUnitAction = revision.requestedBy && !revision.respondedBy;
    const isRequestorAction = revision.respondedBy && !revision.requestedBy;
    
    console.log('✅ [AllRequests] Action type:', {
        isUnitAction,
        isRequestorAction
    });
    
    entry.className = `revision-conversation-item ${isUnitAction ? 'unit-action' : 'requestor-action'}`;
    
    const revisionNumber = index + 1;
    // Use requestedAt for unit actions, respondedAt for requestor actions, or fallback to timestamp
    const timestampValue = revision.requestedAt || revision.respondedAt || revision.timestamp || revision.createdAt;
    const timestamp = timestampValue ? new Date(timestampValue) : new Date();
    
    // Check if date is valid
    const isValidDate = !isNaN(timestamp.getTime());
    const fullDate = isValidDate ? timestamp.toLocaleString('en-US', {
        weekday: 'long',
        month: 'long',
        day: 'numeric',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true
    }) : 'Unknown Date';
    
    // Determine type label based on action type
    let typeLabel = '';
    let badgeClass = '';
    if (isUnitAction) {
        typeLabel = 'Revision Requested';
        badgeClass = 'badge-revision';
    } else if (isRequestorAction) {
        typeLabel = 'Resubmitted for Review';
        badgeClass = 'badge-resubmitted';
    } else {
        typeLabel = 'Update';
        badgeClass = 'badge-revision';
    }
    
    // Calculate relative time
    const now = new Date();
    const diffMs = now - timestamp;
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);
    
    let relativeTime = '';
    if (diffMins < 1) relativeTime = 'Just now';
    else if (diffMins < 60) relativeTime = `${diffMins} minute${diffMins > 1 ? 's' : ''} ago`;
    else if (diffHours < 24) relativeTime = `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;
    else relativeTime = `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;
    
    // Show status indicator on last message
    let statusIndicator = '';
    if (isLastPage && index === total - 1) {
        if (revision.type === 'approved') {
            statusIndicator = `
                <div class="status-indicator approved">
                    <svg width="16" height="16" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="8 12 11 15 16 9"/>
                    </svg>
                    <span style="color: #10b981; font-weight: 600;">Your Request Has Been Approved!</span>
                </div>
            `;
        } else if (isUnitAction) {
            statusIndicator = `
                <div class="status-indicator waiting">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    Waiting for Your Response
                </div>
            `;
        } else {
            statusIndicator = `
                <div class="status-indicator under-review">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                    Under Unit Review
                </div>
            `;
        }
    }
    
    // Determine author name properly.
    // Requestor's own view: show the unit's TYPE only (never the individual member's
    // name - there can be multiple members per unit team), and "You" for the
    // requestor's own resubmission entries (this page is always the requestor's own view).
    let authorName = 'Unknown';
    let authorUnit = '';

    if (isUnitAction && revision.requestedBy) {
        if (typeof revision.requestedBy === 'object' && revision.requestedBy.unitTeam && revision.requestedBy.unitTeam !== 'N/A') {
            authorName = `${revision.requestedBy.unitTeam} Unit`;
        } else {
            authorName = 'Unit Team';
        }
    } else if (isRequestorAction) {
        authorName = 'You';
    } else {
        // Fallback to revision.by or other fields
        authorName = revision.by || revision.createdBy || revision.author || 'System';
    }
    
    entry.innerHTML = `
        <div class="revision-number-badge">#${revisionNumber}</div>
        <div class="revision-message-bubble">
            <div class="revision-bubble-header">
                <div>
                    <span class="revision-author">${escapeHtml(authorName)}${escapeHtml(authorUnit)}</span>
                    <span class="revision-badge ${badgeClass}" style="margin-left: 0.5rem;">${typeLabel}</span>
                </div>
                <div class="revision-timestamp">
                    <span style="font-weight: 600; color: #1e293b;">${fullDate}</span>
                    <span style="font-size: 0.75rem; color: #94a3b8;">${relativeTime}</span>
                </div>
            </div>
            
            <div class="message-content-section">
                <div class="content-text">${(() => {
                    let content = '';
                    if (isUnitAction) {
                        content = revision.revisionNotes;
                    } else {
                        content = revision.revisionNotes || revision.responseNotes;
                    }
                    console.log('🎯 Rendering content:', { isUnitAction, content, type: typeof content });
                    // Requestor's own resubmission content is already-sanitized real HTML
                    // from Quill - skip the markdown pass so literal */_ aren't mangled.
                    return displayFormattedText(content || 'No content provided', { skipMarkdown: isRequestorAction });
                })()}</div>
            </div>
            
            ${((revision.revisionLinks && revision.revisionLinks.length > 0) || (revision.responseLinks && revision.responseLinks.length > 0)) ? `
                <div class="message-attachments-section" style="margin-top: 1rem;">
                    <div class="attachments-header">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                        </svg>
                        <span class="attachments-count">${(revision.revisionLinks || revision.responseLinks).length} link${(revision.revisionLinks || revision.responseLinks).length > 1 ? 's' : ''} attached</span>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.75rem;">
                        ${(revision.revisionLinks || revision.responseLinks).map(link => `
                            <a href="${escapeHtml(link)}" target="_blank" rel="noopener noreferrer" 
                               style="display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; color: #0ea5e9; text-decoration: none; transition: all 0.2s;"
                               onmouseover="this.style.background='#e0f2fe'; this.style.borderColor='#0ea5e9';"
                               onmouseout="this.style.background='#f8fafc'; this.style.borderColor='#e2e8f0';">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                                    <polyline points="15 3 21 3 21 9"/>
                                    <line x1="10" y1="14" x2="21" y2="3"/>
                                </svg>
                                <span style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${escapeHtml(link)}</span>
                            </a>
                        `).join('')}
                    </div>
                </div>
            ` : ''}
            
            ${statusIndicator}
        </div>
    `;
    
    return entry;
}

// Handle resubmission (Submit for Approval Again)
async function handleResubmission() {
    if (!resubmissionQuill || !currentConversationId) return;
    
    const responseText = resubmissionQuill.root.innerHTML;
    
    // Validate response text
    if (!responseText || responseText.trim() === '<p><br></p>' || responseText.trim() === '') {
        if (typeof window.showAlert === 'function') {
            window.showAlert('error', 'Please enter your response before submitting.');
        } else {
            alert('Please enter your response before submitting.');
        }
        return;
    }
    
    // Collect links from link inputs
    const linkInputs = document.querySelectorAll('#resubmissionLinksContainer input[type="url"]');
    const links = [];
    let hasInvalidLink = false;
    
    linkInputs.forEach(input => {
        const value = input.value.trim();
        if (value !== '') {
            if (!validateLinkInput(input)) {
                hasInvalidLink = true;
            } else {
                links.push(value);
            }
        }
    });
    
    if (hasInvalidLink) {
        if (typeof window.showAlert === 'function') {
            window.showAlert('error', 'Please fix invalid links before submitting.');
        } else {
            alert('Please fix invalid links before submitting.');
        }
        return;
    }
    
    const bodyData = {
        resubmissionNotes: responseText,
        links: links
    };

    try {
        const response = await fetch(`/resubmit-approval-request/${currentConversationId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(bodyData)
        });
        
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const result = await response.json();
        
        if (result.success) {
            if (typeof window.showAlert === 'function') {
                window.showAlert('success', 'Your response has been submitted successfully! Awaiting unit review.');
            } else {
                alert('Your response has been submitted successfully!');
            }
            
            // Clear form
            resubmissionQuill.setContents([]);
            const linksContainer = document.getElementById('resubmissionLinksContainer');
            if (linksContainer) linksContainer.innerHTML = '';
            
            // Hide the resubmission form immediately
            const resubmissionSection = document.getElementById('resubmissionFormSection');
            if (resubmissionSection) {
                resubmissionSection.style.display = 'none';
            }
            
            // Hide the action button
            const approvalActionButtons = document.getElementById('approvalActionButtons');
            if (approvalActionButtons) {
                approvalActionButtons.style.display = 'none';
            }
            
            // Reload revision history immediately
            await loadRevisionHistory(currentConversationId);
            
            // Update the status badge in the modal
            const statusBadge = document.getElementById('modalStatusBadge');
            if (statusBadge) {
                statusBadge.textContent = 'For Checking';
                statusBadge.className = 'status-badge-large for-checking';
            }

            // Update the table row status without reloading
            const row = document.querySelector(`tr[data-id="${currentConversationId}"]`);
            if (row) {
                const statusCell = row.querySelector('.status-badge');
                if (statusCell) {
                    statusCell.textContent = 'For Checking';
                    statusCell.className = 'status-badge for-checking';
                }
                row.dataset.status = 'For Checking';
            }
        } else {
            if (typeof window.showAlert === 'function') {
                window.showAlert('error', result.message || 'Failed to submit response. Please try again.');
            } else {
                alert(result.message || 'Failed to submit response. Please try again.');
            }
        }
    } catch (error) {
        console.error('Error submitting resubmission:', error);
        if (typeof window.showAlert === 'function') {
            window.showAlert('error', 'An error occurred while submitting your response.');
        } else {
            alert('An error occurred while submitting your response.');
        }
    }
}

// Handle clarification request
async function handleClarificationRequest() {
    if (!resubmissionQuill || !currentConversationId) return;
    
    const responseText = resubmissionQuill.root.innerHTML;
    
    // Validate response text
    if (!responseText || responseText.trim() === '<p><br></p>' || responseText.trim() === '') {
        showAlert('error', 'Please enter your clarification question before submitting.');
        return;
    }
    
    const formData = new FormData();
    formData.append('requestId', currentConversationId);
    formData.append('message', responseText);
    formData.append('actionType', 'clarification');
    
    try {
        // Open team conversation modal for clarification
        document.getElementById('detailsModal').style.display = 'none';
        window.openTeamConversationModal(currentConversationId);
        
        // Clear form
        resubmissionQuill.setContents([]);
        
        showAlert('info', 'Opening team discussion for clarification...');
    } catch (error) {
        console.error('Error opening clarification:', error);
        showAlert('error', 'An error occurred. Please try again.');
    }
}

// ===== LINK MANAGEMENT FUNCTIONS =====
let resubmissionLinkCounter = 0;

function addResubmissionLink() {
    const container = document.getElementById('resubmissionLinksContainer');
    if (!container) return;

    const linkId = `resubmissionLink_${resubmissionLinkCounter++}`;
    const linkItem = document.createElement('div');
    linkItem.className = 'link-entry-row';
    linkItem.innerHTML = `
        <input type="url"
               id="${linkId}"
               placeholder="https://example.com"
               class="resubmission-link-input link-entry-input"
               pattern="https?://.*"
               title="Please enter a valid URL starting with http:// or https://">
        <button type="button"
                class="link-entry-remove-btn"
                onclick="removeResubmissionLink(this)">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
    `;
    container.appendChild(linkItem);

    // Add validation listener to the newly added input
    const input = linkItem.querySelector('input');
    if (input) {
        input.addEventListener('blur', function() {
            validateLinkInput(this);
        });
    }
}

function validateLinkInput(input) {
    const row = input.closest('.link-entry-row');
    const value = input.value.trim();
    if (value === '') {
        // Empty is allowed (optional field)
        if (row) row.classList.remove('invalid', 'valid');
        return true;
    }

    // Check if URL starts with http:// or https://
    const urlPattern = /^https?:\/\/.+/i;
    if (!urlPattern.test(value)) {
        if (row) { row.classList.add('invalid'); row.classList.remove('valid'); }
        if (typeof window.showAlert === 'function') {
            window.showAlert('error', 'Please enter a valid URL starting with http:// or https://');
        } else {
            alert('Please enter a valid URL starting with http:// or https://');
        }
        return false;
    }

    // Valid URL
    if (row) { row.classList.add('valid'); row.classList.remove('invalid'); }
    return true;
}

function removeResubmissionLink(button) {
    const linkItem = button.closest('.link-entry-row');
    if (linkItem) linkItem.remove();
}

