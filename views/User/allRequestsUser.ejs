// Add MutationObserver to monitor for unwanted style changes
function setupMessageAlignmentProtection() {
    const container = document.getElementById('teamMessagesContainer');
    if (!container) return;
    
    const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
            if (mutation.type === 'childList') {
                mutation.addedNodes.forEach((node) => {
                    if (node.classList && node.classList.contains('unit-message-item')) {
                        // Remove any inline styles that might override CSS
                        if (node.getAttribute('style')) {
                            console.warn('⚠️ [Protection] Removing inline style from message:', node.className);
                            node.removeAttribute('style');
                        }
                    }
                });
            }
        });
    });
    
    observer.observe(container, {
        childList: true,
        subtree: false,
        attributes: false
    });
    
    console.log('✅ [Protection] Message alignment observer active');
}

// Load conversation messages
function loadTeamConversation(requestId) {
    setupMessageAlignmentProtection();
    const container = document.getElementById('teamMessagesContainer');
    if (!container) return;

    console.log('[LoadConversation] 🚀 Starting to load conversation for request:', requestId);
    console.log('[LoadConversation] 📋 Current user role from window:', window.currentUserRole);

    fetch(`/api/conversation/${requestId}`)
        .then(response => response.json())
        .then(data => {
            console.log('[LoadConversation] 📦 RAW API RESPONSE:', data);
            console.log('[LoadConversation] 📨 Message count:', data.conversation?.length || 0);
            
            if (data.conversation && data.conversation.length > 0) {
                console.log('[LoadConversation] 🔍 First message sample:', JSON.stringify(data.conversation[0], null, 2));
                container.innerHTML = '';
                data.conversation.forEach((msg, index) => {
                    console.log(`[LoadConversation] ✉️ Message ${index + 1}:`);
                    console.log(`   Name: "${msg.senderName}"`);
                    console.log(`   Role: "${msg.senderRole}"`);
                    console.log(`   Content: ${msg.content?.substring(0, 30)}`);
                    const messageDiv = createMessageElement(msg);
                    container.appendChild(messageDiv);
                });
                container.scrollTop = container.scrollHeight;
            } else {
                container.innerHTML = `
                    <div class="unit-messages-empty">
                        <div class="empty-icon">
                            <svg width="48" height="48" fill="none" stroke="#94a3b8" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                            </svg>
                        </div>
                        <p>No discussion yet</p>
                        <small>Start the conversation below</small>
                    </div>
                `;
            }
        })
        .catch(error => {
            console.error('Error loading conversation:', error);
            alert('Failed to load conversation');
        });
}

// Create message element
function createMessageElement(msg) {
    const div = document.createElement('div');
    
    // Get message sender info
    const messageSenderName = msg.senderName ? String(msg.senderName).trim() : '';
    const messageSenderRole = msg.senderRole ? String(msg.senderRole).toLowerCase().trim() : '';
    
    // Compare sender name with logged-in user's name
    // Use the globally set currentUserFullName
    const loggedInUserName = window.currentUserFullName || '';
    const isOwnMessage = messageSenderName === loggedInUserName;
    
    console.log('[CreateMessage] 🔍 ALIGNMENT DECISION:');
    console.log('  ✅ Logged-in user:', loggedInUserName);
    console.log('  📨 Message sender:', messageSenderName);
    console.log('  🎭 Sender role:', messageSenderRole);
    console.log('  ❓ Exact match?:', messageSenderName === loggedInUserName);
    console.log('  ✅ Is own message?:', isOwnMessage);
    console.log('  ➡️ WILL ALIGN:', isOwnMessage ? '→→→ RIGHT' : '←←← LEFT');
    console.log('  📦 Full message:', JSON.stringify(msg, null, 2));
    
    // Role-based styling - NO inline styles, CSS classes only
    let roleClass = 'user-message';
    
    if (isOwnMessage) {
        // This is the logged-in user's OWN message - RIGHT side
        roleClass = 'own-message';
    } else if (messageSenderRole === 'admin') {
        // Admin messages - LEFT side
        roleClass = 'admin-message';
    } else if (messageSenderRole === 'unit') {
        // Unit messages - LEFT side
        roleClass = 'unit-message';
    } else {
        // Other users - LEFT side
        roleClass = 'user-message';
    }
    
    // Apply alignment class - OWN messages go RIGHT, ALL others go LEFT
    const alignmentClass = isOwnMessage ? 'message-right' : 'message-left';
    div.className = `unit-message-item ${alignmentClass}`;
    
    // FORCE remove any inline styles that might override CSS
    div.removeAttribute('style');
    
    // Log final class for debugging
    console.log('  🎨 CSS Classes:', div.className);
    console.log('  🎨 Role Class:', roleClass);
    console.log('  🎨 Inline Style:', div.getAttribute('style') || 'NONE (correct!)');
    
    const time = new Date(msg.timestamp).toLocaleString('en-US', {
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
    });
    
    let attachmentsHTML = '';
    if (msg.attachments && msg.attachments.length > 0) {
        attachmentsHTML = msg.attachments.map(file => {
            const ext = file.filename.split('.').pop().toLowerCase();
            const isPdf = ext === 'pdf';
            const isImage = ['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext);
            
            let iconColor = '#64748b';
            if (isImage) iconColor = '#059669';
            else if (isPdf) iconColor = '#dc2626';
            else if (['doc', 'docx'].includes(ext)) iconColor = '#2563eb';
            
            return `
                <div class="message-attachment">
                    <div class="message-attachment-icon" style="color: ${iconColor};">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="4" y="4" width="16" height="16" rx="2"/>
                            <line x1="8" y1="8" x2="16" y2="8"/>
                            <line x1="8" y1="12" x2="16" y2="12"/>
                            <line x1="8" y1="16" x2="12" y2="16"/>
                        </svg>
                    </div>
                    <div class="message-attachment-info">
                        <div class="message-attachment-name">${escapeHtml(file.originalname || file.filename)}</div>
                        <div class="message-attachment-size">${ext.toUpperCase()}</div>
                    </div>
                    <div class="message-attachment-actions">
                        ${isImage ? `
                            <button class="attachment-action-btn" onclick="viewImage('/uploads/${file.filename}', '${escapeHtml(file.originalname || file.filename)}')" title="View Image">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        ` : ''}
                        ${isPdf ? `
                            <button class="attachment-action-btn pdf-view" onclick="viewPdf('/uploads/${file.filename}', '${escapeHtml(file.originalname || file.filename)}')" title="View PDF">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        ` : ''}
                        <a href="/uploads/${file.filename}" download="${escapeHtml(file.originalname || file.filename)}" class="attachment-action-btn" title="Download">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="7 10 12 15 17 10"/>
                                <line x1="12" y1="15" x2="12" y2="3"/>
                            </svg>
                        </a>
                    </div>
                </div>
            `;
        }).join('');
    }
    
    // Format message content (convert markdown-style formatting to HTML)
    let formattedContent = escapeHtml(msg.content || '');
    formattedContent = formattedContent
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')  // **bold** -> <strong>bold</strong>
        .replace(/\*(.*?)\*/g, '<em>$1</em>')              // *italic* -> <em>italic</em>
        .replace(/&lt;u&gt;(.*?)&lt;\/u&gt;/g, '<u>$1</u>'); // escaped <u>underline</u> -> <u>underline</u>
    
    // Build read receipts display
    let readReceiptsHTML = '';
    if (msg.readBy && msg.readBy.length > 0 && isOwnMessage) {
        const readers = msg.readBy
            .filter(r => r.userId && r.userId.fName) // Only valid readers with names
            .map(r => `${r.userId.fName} ${r.userId.lName}`)
            .join(', ');
        if (readers) {
            readReceiptsHTML = `
                <div class="message-read-receipt">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Seen by ${readers}</span>
                </div>
            `;
        }
    }
    
    div.innerHTML = `
        <div class="unit-message-bubble ${roleClass}">
            <div class="message-header">
                <strong>${escapeHtml(msg.senderName || 'Unknown')} <span style="font-size: 0.75rem; opacity: 0.7;">(${msg.senderRole})</span></strong>
                <span class="message-time">${time}</span>
            </div>
            <div class="message-content">${formattedContent}</div>
            ${attachmentsHTML}
            ${readReceiptsHTML}
        </div>
    `;
    
    return div;
}

// Send message
window.sendTeamMessage = function() {
    console.log('[AllRequestsUser] Send team message triggered');
    const input = document.getElementById('teamMessageInput');
    const fileInput = document.getElementById('chatFileInput');
    if (!input || !currentConversationRequestId) {
        console.error('[AllRequestsUser] Missing input or request ID:', {
            input: !!input,
            currentConversationRequestId
        });
        return;
    }

    const content = input.value.trim();
    console.log('[AllRequestsUser] Message content:', content || '(empty)');
    console.log('[AllRequestsUser] Files selected:', fileInput ? fileInput.files.length : 0);
    
    if (!content && (!fileInput || fileInput.files.length === 0)) {
        console.warn('[AllRequestsUser] No content or files');
        alert('Please enter a message or attach files');
        return;
    }

    const formData = new FormData();
    if (content) {
        formData.append('content', content);
    }

    if (fileInput && fileInput.files.length > 0) {
        console.log('[AllRequestsUser] Appending files...');
        for (let i = 0; i < fileInput.files.length; i++) {
            console.log(`[AllRequestsUser] File ${i + 1}:`, fileInput.files[i].name);
            formData.append('chatFiles', fileInput.files[i]);
        }
    }

    console.log('[AllRequestsUser] Sending to:', `/api/conversation/${currentConversationRequestId}/message`);
    fetch(`/api/conversation/${currentConversationRequestId}/message`, {
        method: 'POST',
        body: formData
    })
    .then(response => {
        console.log('[AllRequestsUser] Response status:', response.status);
        return response.json();
    })
    .then(data => {
        console.log('[AllRequestsUser] Response data:', data);
        if (data.success) {
            console.log('[AllRequestsUser] Message sent successfully');
            input.value = '';
            if (fileInput) {
                fileInput.value = '';
                const preview = document.getElementById('chatFilesPreview');
                if (preview) preview.style.display = 'none';
            }
            loadTeamConversation(currentConversationRequestId);
        } else {
            console.error('[AllRequestsUser] Server error:', data);
            alert('Failed to send message');
        }
    })
    .catch(error => {
        console.error('[AllRequestsUser] Error sending message:', error);
        console.error('[AllRequestsUser] Error stack:', error.stack);
        alert('Error sending message');
    });
};

// Helper function to escape HTML
function escapeHtml(unsafe) {
    if (!unsafe) return '';
    return unsafe
        .toString()
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}

// Helper function to format text with markdown-like syntax
function displayFormattedText(text) {
    if (!text) return '';
    
    // Check if the text is already HTML (from Quill editor)
    // Quill outputs HTML like <p>text</p>, <strong>bold</strong>, etc.
    if (text.includes('<p>') || text.includes('<strong>') || text.includes('<em>') || text.includes('<u>')) {
        // It's HTML content from Quill, return as-is
        return text;
    }
    
    // It's plain text, escape HTML first
    let formatted = escapeHtml(text);
    
    // Bold: **text** -> <strong>text</strong>
    formatted = formatted.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    
    // Italic: *text* -> <em>text</em> (but not ** which is bold)
    formatted = formatted.replace(/(?<!\*)\*([^*]+)\*(?!\*)/g, '<em>$1</em>');
    
    // Underline: __text__ -> <u>text</u>
    formatted = formatted.replace(/__([^_]+)__/g, '<u>$1</u>');
    
    // Preserve line breaks
    formatted = formatted.replace(/\n/g, '<br>');
    
    return formatted;
}

