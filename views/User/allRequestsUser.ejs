// ========== SERVICE REQUEST REVISION HISTORY FUNCTIONS ==========

async function loadServiceRevisionHistory(requestId, page = Number.MAX_SAFE_INTEGER) {
    console.log('[Service] ===== STARTING LOAD =====');
    console.log('[Service] Request ID:', requestId);
    const historySection = document.getElementById('revisionHistorySection');
    const historyContainer = document.getElementById('revisionHistoryContainer');
    const pagerContainer = document.getElementById('revisionHistoryPager');
    const rightColumn = document.getElementById('requestorRightColumn');
    const modalBody = document.querySelector('.unit-modal-body');
    const modalContent = document.querySelector('.unit-modal-wide');
    const serviceRevisionSection = document.getElementById('serviceRevisionFormSection');
    
    console.log('[Service] Elements check:');
    console.log('  ✓ historyContainer:', !!historyContainer);
    console.log('  ✓ rightColumn:', !!rightColumn);
    console.log('  ✓ modalBody:', !!modalBody);
    
    if (!historyContainer) {
        console.log('[Service] ❌ History container not found!');
        return;
    }
    
    try {
        console.log('[Service] Fetching API...');
        const response = await fetch(`/api/service-revision-history/${requestId}?page=${page}&limit=5`);
        console.log('[Service] API status:', response.status);

        const contentType = response.headers.get('content-type');
        if (!contentType || !contentType.includes('application/json')) {
            console.log('[Service] ❌ Non-JSON response');
            // Hide revision section but keep two-column layout with chat button
            if (historySection) historySection.style.display = 'none';
            if (rightColumn) rightColumn.style.display = 'flex'; // Keep right column visible for chat button
            if (modalBody) modalBody.classList.add('two-column'); // Keep two-column layout
            if (modalContent) modalContent.classList.add('has-revisions'); // Keep wider modal
            if (pagerContainer) pagerContainer.innerHTML = '';
            return;
        }
        
        const result = await response.json();
        console.log('[Service] ===== API RESPONSE =====');
        console.log('[Service] Success:', result.success);
        console.log('[Service] Revisions:', result.revisions ? result.revisions.length : 0);
        console.log('[Service] Data:', result);

        if (result.success) {
            // Action-button / warning / rejected-banner visibility - driven purely by
            // status and the real revision limit, independent of whether there are
            // any revision entries yet to render.
            const row = document.querySelector(`tr[data-id="${requestId}"]`);
            // Prefer the status this same response just fetched from the server -
            // the row's data-status can go stale (e.g. after a revision request or
            // deliverable resubmission that never updated the DOM), which previously
            // made the "limit reached" banner disappear even though the server-side
            // status/limit truly called for showing it.
            const normalizedStatus = (result.status || (row ? row.dataset.status : '') || '').toLowerCase().replace(/\s+/g, '-');
            if (row) {
                row.dataset.status = result.status || row.dataset.status;
                const statusCell = row.querySelector('.status-badge');
                if (statusCell && result.status) {
                    statusCell.textContent = result.status;
                    statusCell.className = `status-badge ${normalizedStatus}`;
                }
            }
            const actionButtons = document.getElementById('serviceActionButtons');
            const revisionLimitWarning = document.getElementById('serviceRevisionLimitWarning');
            const revisionLimitWarningText = document.getElementById('serviceRevisionLimitWarningText');
            const rejectedBanner = document.getElementById('serviceRejectedBanner');
            const rejectedReasonText = document.getElementById('serviceRejectedReasonText');

            if (normalizedStatus === 'rejected') {
                if (actionButtons) actionButtons.style.display = 'none';
                if (revisionLimitWarning) revisionLimitWarning.style.display = 'none';
                if (rejectedBanner) {
                    rejectedBanner.style.display = 'flex';
                    if (rejectedReasonText) {
                        rejectedReasonText.textContent = (row && row.dataset.rejectionReason) ? row.dataset.rejectionReason : '';
                    }
                }
            } else {
                if (rejectedBanner) rejectedBanner.style.display = 'none';

                // Approve/Request-Revision only appear once the unit has actually sent deliverables
                if (actionButtons) {
                    actionButtons.style.display = (normalizedStatus === 'for-checking') ? 'flex' : 'none';
                }

                const revisionCount = result.revisionCount || 0;
                const revisionLimit = result.revisionLimit || 2;
                const limitReached = revisionCount >= revisionLimit;
                const showRevisionBtn = document.getElementById('showServiceRevisionFormBtn');
                if (showRevisionBtn) {
                    showRevisionBtn.style.display = (normalizedStatus === 'for-checking' && limitReached) ? 'none' : 'inline-flex';
                }
                // The "last revision used" note must persist once the limit is hit -
                // not just while status is "for-checking". It should stay visible
                // while the unit is still reviewing the final revision ("for-revision")
                // too, and survive reloads (both statuses reach here via result.status).
                const revisionLimitIrrelevant = normalizedStatus === 'approved' || normalizedStatus === 'completed';
                if (revisionLimitWarning) {
                    revisionLimitWarning.style.display = (limitReached && !revisionLimitIrrelevant) ? 'flex' : 'none';
                    if (revisionLimitWarningText && limitReached) {
                        revisionLimitWarningText.textContent = `You have used all ${revisionLimit} revision requests for this service request. If you need further changes, please submit a new service request and reference this one, or ask the assigned unit to allow one more revision.`;
                    }
                }
            }
        }

        if (result.success && result.revisions && result.revisions.length > 0) {
            // Log each revision before filtering
            result.revisions.forEach((rev, idx) => {
                console.log(`[Service] ===== REVISION ${idx} DETAILS =====`);
                console.log('[Service] Type:', rev.type);
                console.log('[Service] Has requestedBy:', !!rev.requestedBy);
                console.log('[Service] Has respondedBy:', !!rev.respondedBy);
                console.log('[Service] Deliverable files:', rev.deliverableFiles ? rev.deliverableFiles.length : 0);
                console.log('[Service] Response files:', rev.responseFiles ? rev.responseFiles.length : 0);
                console.log('[Service] Timestamp:', rev.timestamp || rev.requestedAt || rev.respondedAt);
                console.log('[Service] Full object:', rev);
                console.log('[Service] =====================================');
            });
            
            // Show all revisions including initial submission
            const revisionsToShow = result.revisions;
            
            console.log('[Service] All revisions to show:', revisionsToShow.length);
            
            if (revisionsToShow.length > 0) {
                console.log('[Service] ✅ Displaying revision history');
                
                // Show two-column layout
                if (rightColumn) {
                    rightColumn.style.display = 'flex';
                    console.log('[Service] ✅ Right column visible');
                }
                if (modalBody) {
                    modalBody.classList.add('two-column');
                    console.log('[Service] ✅ Two-column layout activated');
                }
                if (modalContent) modalContent.classList.add('has-revisions');
                if (historySection) historySection.style.display = 'block';
                
                historyContainer.innerHTML = '';

                const pagination = result.pagination || { page: 1, totalPages: 1 };
                const isLastPage = pagination.page >= pagination.totalPages;

                revisionsToShow.forEach((revision, index) => {
                    console.log(`[Service] Creating entry ${index + 1}: ${revision.type}`);
                    const entry = createServiceRevisionEntry(revision, index, revisionsToShow.length, isLastPage);
                    historyContainer.appendChild(entry);
                });

                renderRevisionPager(pagerContainer, requestId, pagination, 'loadServiceRevisionHistory');

                // Keep the revision-request composer hidden by default - it's revealed
                // when the user clicks "Request Revision" (button visibility itself is
                // already handled above, driven by status + the real revision limit).
                if (serviceRevisionSection) serviceRevisionSection.style.display = 'none';
            } else {
                // No revisions to show, but still show the section with empty message
                if (modalContent) modalContent.classList.remove('has-revisions');
                if (pagerContainer) pagerContainer.innerHTML = '';
                historyContainer.innerHTML = `
                    <div style="text-align: center; padding: 2rem; color: #64748b;">
                        <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin: 0 auto 1rem; opacity: 0.5;">
                            <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        <p>No revision history available yet.</p>
                        <small>Revision history will appear here when updates are made to your request.</small>
                    </div>
                `;
            }
        } else {
            // No revisions data - show empty message
            if (modalContent) modalContent.classList.remove('has-revisions');
            if (pagerContainer) pagerContainer.innerHTML = '';
            historyContainer.innerHTML = `
                <div style="text-align: center; padding: 2rem; color: #64748b;">
                    <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin: 0 auto 1rem; opacity: 0.5;">
                        <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    <p>No revision history available yet.</p>
                    <small>Revision history will appear here when updates are made to your request.</small>
                </div>
            `;
        }
    } catch (error) {
        console.error('[Service] Error loading revision history:', error);
        // Error case - show error message in revision history section
        if (modalContent) modalContent.classList.remove('has-revisions');
        if (pagerContainer) pagerContainer.innerHTML = '';
        historyContainer.innerHTML = `
            <div style="text-align: center; padding: 2rem; color: #dc2626;">
                <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin: 0 auto 1rem; opacity: 0.5;">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="15" y1="9" x2="9" y2="15"/>
                    <line x1="9" y1="9" x2="15" y2="15"/>
                </svg>
                <p>Unable to load revision history.</p>
                <small>Please try refreshing the page.</small>
            </div>
        `;
    }
}

function createServiceRevisionEntry(revision, index, total, isLastPage = true) {
    console.log('[Service] Creating revision entry:', revision);
    
    const entry = document.createElement('div');
    
    const isUnitAction = revision.requestedBy || 
                         (revision.type === 'deliverable_submitted' || 
                          revision.type === 'completed' ||
                          revision.type === 'message');
    const isRequestorAction = revision.respondedBy || 
                              (revision.type === 'revision_requested' && !revision.requestedBy) ||
                              (revision.type === 'message' && !revision.requestedBy) ||
                              revision.type === 'initial';
    
    entry.className = `revision-conversation-item ${isUnitAction ? 'unit-action' : 'requestor-action'}`;
    
    const timestamp = new Date(revision.requestedAt || revision.respondedAt || revision.timestamp || revision.createdAt);
    const isValidDate = !isNaN(timestamp.getTime());
    const fullDate = isValidDate ? timestamp.toLocaleString('en-US', {
        weekday: 'long',
        month: 'long',
        day: 'numeric',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true
    }) : 'Unknown Date';
    
    const now = new Date();
    const diffMs = isValidDate ? now - timestamp : 0;
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);
    
    let relativeTime = '';
    if (!isValidDate) {
        relativeTime = '';
    } else if (diffMins < 1) relativeTime = 'Just now';
    else if (diffMins < 60) relativeTime = `${diffMins} minute${diffMins > 1 ? 's' : ''} ago`;
    else if (diffHours < 24) relativeTime = `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;
    else relativeTime = `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;
    
    let typeLabel = '';
    let badgeClass = '';
    
    if (revision.type === 'deliverable_submitted') {
        typeLabel = 'Deliverables Uploaded';
        badgeClass = 'badge-resubmitted';
    } else if (revision.type === 'completed') {
        typeLabel = '✓ Completed';
        badgeClass = 'badge-approved';
    } else if (revision.type === 'revision_requested') {
        typeLabel = 'Revision Requested';
        badgeClass = 'badge-revision';
    } else if (revision.type === 'message') {
        typeLabel = 'Message';
        badgeClass = 'badge-revision';
    } else if (revision.type === 'initial') {
        typeLabel = 'Initial Request';
        badgeClass = 'badge-revision';
    } else if (revision.type === 'rejected') {
        typeLabel = '✕ Rejected';
        badgeClass = 'badge-revoked';
    } else if (revision.type === 'limit_override') {
        typeLabel = 'Revision Limit Extended';
        badgeClass = 'badge-approved';
    } else {
        typeLabel = 'Update';
        badgeClass = 'badge-revision';
    }

    // Author label: on the requestor's own view, show the unit's TYPE only
    // (never the individual member's name), and "You" for the requestor's own
    // entries (this page is always the requestor's own view).
    let authorName;
    if (isUnitAction) {
        authorName = (revision.requestedBy && typeof revision.requestedBy === 'object' && revision.requestedBy.unitTeam && revision.requestedBy.unitTeam !== 'N/A')
            ? `${revision.requestedBy.unitTeam} Unit`
            : 'Unit Team';
    } else {
        authorName = 'You';
    }
    
    const isLast = isLastPage && index === total - 1;
    let statusIndicator = '';

    if (revision.type === 'completed') {
        statusIndicator = `
            <div class="status-indicator approved">
                <svg width="16" height="16" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="8 12 11 15 16 9"/>
                </svg>
                <span style="color: #10b981; font-weight: 600;">Service Request Completed!</span>
            </div>
        `;
    } else if (isLast) {
        if (isUnitAction) {
            statusIndicator = `
                <div class="status-indicator waiting">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    Review the deliverables below
                </div>
            `;
        } else {
            statusIndicator = `
                <div class="status-indicator under-review">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                    Unit is reviewing your feedback
                </div>
            `;
        }
    }
    
    const content = revision.type === 'message' ? 
        (revision.revisionNotes || revision.responseNotes || 'Message') :
        revision.type === 'initial' ?
        (revision.description || 'Initial request submitted') :
        (isUnitAction ? 
            (revision.revisionNotes || 'Deliverables submitted') : 
            (revision.responseNotes || 'Revision requested'));
    
    const files = revision.deliverableFiles || revision.responseFiles || [];
    const links = revision.revisionLinks || revision.responseLinks || [];

    entry.innerHTML = `
        <div class="revision-number-badge">#${index + 1}</div>
        <div class="revision-message-bubble">
            <div class="revision-bubble-header">
                <div>
                    <span class="revision-author">${escapeHtml(authorName)}</span>
                    <span class="revision-badge ${badgeClass}" style="margin-left: 0.5rem;">${typeLabel}</span>
                </div>
                <div class="revision-timestamp">
                    <span style="font-weight: 600; color: #1e293b;">${fullDate}</span>
                    <span style="font-size: 0.75rem; color: #94a3b8;">${relativeTime}</span>
                </div>
            </div>

            <div class="message-content-section">
                <div class="content-label">${revision.type === 'message' ? 'MESSAGE:' : revision.type === 'initial' ? 'REQUEST:' : (isUnitAction ? 'UNIT UPDATE:' : 'YOUR FEEDBACK:')}</div>
                <div class="content-text">${displayFormattedText(content, { skipMarkdown: !isUnitAction })}</div>
            </div>

            ${links && links.length > 0 ? `
                <div class="message-attachments-section" style="margin-top: 1rem;">
                    <div class="attachments-header">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                        </svg>
                        <span class="attachments-count">${links.length} link${links.length > 1 ? 's' : ''} attached</span>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.75rem;">
                        ${links.map(link => `
                            <a href="${escapeHtml(link)}" target="_blank" rel="noopener noreferrer"
                               style="display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; color: #0891b2; text-decoration: none; transition: all 0.2s;"
                               onmouseover="this.style.background='#e0f2fe'; this.style.borderColor='#0ea5e9';"
                               onmouseout="this.style.background='#f8fafc'; this.style.borderColor='#e2e8f0';">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                                    <polyline points="15 3 21 3 21 9"/>
                                    <line x1="10" y1="14" x2="21" y2="3"/>
                                </svg>
                                <span style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${escapeHtml(link)}</span>
                            </a>
                        `).join('')}
                    </div>
                </div>
            ` : ''}

            ${statusIndicator}
        </div>
    `;

    return entry;
}

// Handle service revision request
async function handleServiceRevision() {
    if (!serviceRevisionQuill || !currentConversationId) {
        console.error('[Service] Quill or request ID not found');
        return;
    }
    
    const revisionText = serviceRevisionQuill.root.innerHTML;
    
    // Validate revision text
    if (!revisionText || revisionText.trim() === '<p><br></p>' || revisionText.trim() === '') {
        if (typeof window.showAlert === 'function') {
            window.showAlert('error', 'Please describe what needs to be revised before submitting.');
        } else {
            alert('Please describe what needs to be revised before submitting.');
        }
        return;
    }
    
    // Collect links from link inputs
    const linkInputs = document.querySelectorAll('#revisionLinksContainer input[type="url"]');
    const links = [];
    let hasInvalidLink = false;
    
    linkInputs.forEach(input => {
        const value = input.value.trim();
        if (value !== '') {
            if (!validateRevisionLink(input)) {
                hasInvalidLink = true;
            } else {
                links.push(value);
            }
        }
    });
    
    if (hasInvalidLink) {
        if (typeof window.showAlert === 'function') {
            window.showAlert('error', 'Please fix invalid links before submitting.');
        } else {
            alert('Please fix invalid links before submitting.');
        }
        return;
    }
    
    const bodyData = {
        revisionNotes: revisionText,
        links: links
    };

    try {
        const response = await fetch(`/user/service/request-revision/${currentConversationId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(bodyData)
        });
        
        const result = await response.json();
        
        if (result.success) {
            if (typeof window.showAlert === 'function') {
                window.showAlert('success', result.message || 'Revision request submitted successfully!');
            } else {
                alert(result.message || 'Revision request submitted successfully!');
            }
            
            // Clear form
            serviceRevisionQuill.setContents([]);
            const linksContainer = document.getElementById('revisionLinksContainer');
            if (linksContainer) linksContainer.innerHTML = '';
            
            // Reload revision history immediately
            await loadServiceRevisionHistory(currentConversationId);
            
            // Hide the revision form
            const serviceRevisionSection = document.getElementById('serviceRevisionFormSection');
            if (serviceRevisionSection) {
                serviceRevisionSection.style.display = 'none';
            }
            
            // Reset button text
            const toggleBtn = document.getElementById('showServiceRevisionFormBtn');
            const toggleText = document.getElementById('revisionFormToggleText');
            if (toggleBtn) {
                toggleBtn.textContent = 'Request Revision';
                toggleBtn.style.background = 'linear-gradient(135deg, #f59e0b 0%, #d97706 100%)';
            }
            if (toggleText) toggleText.textContent = 'Request Revision';
        } else {
            let errorMessage = result.message || 'Failed to submit revision request. Please try again.';
            
            // Enhance specific status error message
            if (result.message && result.message.includes('Only completed or for-checking requests')) {
                errorMessage = `<strong>Revision request unavailable:</strong> Revisions can only be requested once the service is 'Completed' or 'For Checking'. Since your request is currently <strong>"${result.message.split('"')[1] || 'Queued'}"</strong>, please wait for the unit to process it first.`;
            }

            // Show in-modal alert if container exists
            const alertContainer = document.getElementById('serviceRevisionAlert');
            const alertMessage = document.getElementById('serviceRevisionAlertMessage');
            
            if (alertContainer && alertMessage) {
                alertMessage.innerHTML = errorMessage;
                alertContainer.style.display = 'block';
                alertContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else if (typeof window.showAlert === 'function') {
                window.showAlert('error', errorMessage);
            } else {
                alert(errorMessage.replace(/<\/?[^>]+(>|$)/g, "")); // Strip HTML for standard alert
            }
        }
    } catch (error) {
        console.error('[Service] Error submitting revision:', error);
        if (typeof window.showAlert === 'function') {
            window.showAlert('error', 'An error occurred while submitting your revision request.');
        } else {
            alert('An error occurred while submitting your revision request.');
        }
    }
}

// Wrapper function to determine which toggle function to call
function toggleRevisionForm() {
    // Check if this is a service request or approval request
    const serviceRevisionSection = document.getElementById('serviceRevisionFormSection');
    const resubmissionSection = document.getElementById('resubmissionFormSection');
    
    if (serviceRevisionSection && resubmissionSection) {
        // Determine which form exists and is relevant
        const isServiceRequest = !!serviceRevisionSection;
        const isApprovalRequest = !!resubmissionSection;
        
        if (isServiceRequest && serviceRevisionSection.parentElement) {
            // Service request - use service toggle
            toggleServiceRevisionForm();
        } else if (isApprovalRequest) {
            // Approval request - use resubmission toggle
            toggleResubmissionForm();
        }
    } else if (serviceRevisionSection && serviceRevisionSection.parentElement) {
        toggleServiceRevisionForm();
    } else if (resubmissionSection) {
        toggleResubmissionForm();
    }
}

// Toggle service revision form visibility
function toggleServiceRevisionForm() {
    const serviceRevisionSection = document.getElementById('serviceRevisionFormSection');
    const toggleBtn = document.getElementById('showServiceRevisionFormBtn');
    const toggleText = document.getElementById('revisionFormToggleText');
    
    console.log('[Service] Toggling revision form visibility');
    
    if (serviceRevisionSection) {
        const isVisible = serviceRevisionSection.style.display === 'block';
        
        if (isVisible) {
            // Hide the form
            serviceRevisionSection.style.display = 'none';
            if (toggleText) toggleText.textContent = 'Request Revision';
            if (toggleBtn) {
                toggleBtn.style.background = 'linear-gradient(135deg, #f59e0b 0%, #d97706 100%)';
            }
            console.log('[Service] Revision form hidden');
        } else {
            // Show the form
            serviceRevisionSection.style.display = 'block';
            if (toggleText) toggleText.textContent = 'Hide Revision Form';
            if (toggleBtn) {
                toggleBtn.style.background = 'linear-gradient(135deg, #ef4444 0%, #dc2626 100%)';
            }
            console.log('[Service] Revision form shown');
            
            // Initialize Quill editor if not already initialized
            if (!serviceRevisionQuill) {
                serviceRevisionQuill = new Quill('#serviceRevisionEditor', {
                    theme: 'snow',
                    placeholder: 'Describe what needs to be revised or improved...',
                    modules: {
                        toolbar: [
                            ['bold', 'italic', 'underline'],
                            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                            ['link'],
                            ['clean']
                        ]
                    }
                });

                // Add keyboard shortcuts for text formatting
                const serviceEditor = document.querySelector('#serviceRevisionEditor');
                if (serviceEditor) {
                    serviceEditor.addEventListener('keydown', function(e) {
                        // Ctrl+B for Bold
                        if (e.ctrlKey && e.key === 'b') {
                            e.preventDefault();
                            const format = serviceRevisionQuill.getFormat();
                            serviceRevisionQuill.format('bold', !format.bold);
                        }
                        // Ctrl+I for Italic
                        else if (e.ctrlKey && e.key === 'i') {
                            e.preventDefault();
                            const format = serviceRevisionQuill.getFormat();
                            serviceRevisionQuill.format('italic', !format.italic);
                        }
                        // Ctrl+U for Underline
                        else if (e.ctrlKey && e.key === 'u') {
                            e.preventDefault();
                            const format = serviceRevisionQuill.getFormat();
                            serviceRevisionQuill.format('underline', !format.underline);
                        }
                    });
                }
            }
            
            // Scroll to the form
            setTimeout(() => {
                serviceRevisionSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }, 100);
        }
    } else {
        console.error('[Service] Revision form section not found');
    }
}

function toggleResubmissionForm() {
    const resubmissionSection = document.getElementById('resubmissionFormSection');
    const toggleBtn = document.getElementById('showResubmissionFormBtn');
    const toggleText = document.getElementById('resubmissionFormToggleText');
    
    console.log('[Approval] Toggling resubmission form visibility');
    
    if (resubmissionSection) {
        const isVisible = resubmissionSection.style.display === 'block';
        
        if (isVisible) {
            // Hide the form
            resubmissionSection.style.display = 'none';
            if (toggleText) {
                toggleText.textContent = 'Respond to Revision';
            }
            if (toggleBtn) {
                toggleBtn.style.background = 'linear-gradient(135deg, #10b981 0%, #059669 100%)';
            }
            console.log('[Approval] Resubmission form hidden');
        } else {
            // Show the form
            resubmissionSection.style.display = 'block';
            if (toggleText) {
                toggleText.textContent = 'Hide Response Form';
            }
            if (toggleBtn) {
                toggleBtn.style.background = 'linear-gradient(135deg, #ef4444 0%, #dc2626 100%)';
            }
            console.log('[Approval] Resubmission form shown');
            
            // Scroll to the form
            setTimeout(() => {
                resubmissionSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }, 100);
        }
    } else {
        console.error('[Approval] Resubmission form section not found');
    }
}

// Handle marking service as complete (accept deliverables)
async function handleMarkServiceComplete() {
    if (!currentConversationId) {
        console.error('[Service] Request ID not found');
        return;
    }
    
    // Confirm action
    if (!confirm('Are you sure you want to approve these deliverables? The unit will then finalize the task.')) {
        return;
    }

    try {
        const response = await fetch(`/user/service/mark-complete/${currentConversationId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        const result = await response.json();

        if (result.success) {
            showAlert('success', result.message || 'Deliverables approved successfully!');

            // Reload revision history immediately
            await loadServiceRevisionHistory(currentConversationId);

            // Update the status in the modal - the real status here is "Approved"
            // (not "Completed" - that only happens later when the unit finalizes it)
            const statusBadge = document.getElementById('detailStatusBadge');
            const statusText = document.getElementById('detailStatus');
            if (statusBadge && statusText) {
                statusText.textContent = 'Approved';
                statusBadge.className = 'status-badge-large approved';
            }

            // Update the table row so the list reflects the new status without a reload
            const row = document.querySelector(`tr[data-id="${currentConversationId}"]`);
            if (row) {
                row.setAttribute('data-status', 'Approved');
                const statusCell = row.querySelector('.status-badge');
                if (statusCell) {
                    statusCell.textContent = 'Approved';
                    statusCell.className = 'status-badge approved';
                }
            }

            // Hide action buttons since the requestor has nothing left to do at this stage
            const actionButtons = document.getElementById('serviceActionButtons');
            if (actionButtons) {
                actionButtons.style.display = 'none';
            }
        } else {
            showAlert('error', result.message || 'Failed to approve deliverables. Please try again.');
        }
    } catch (error) {
        console.error('[Service] Error approving deliverables:', error);
        showAlert('error', 'An error occurred while approving the deliverables.');
    }
}

