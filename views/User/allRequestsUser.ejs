                <th>Assigned Unit</th>
                <th>Date Submitted</th>
              </tr>
            </thead>
<!-- Replace the existing tbody section with this corrected version -->
<tbody id="requestsTableBody">
  <% allRequests.forEach(request => { %>
  <% if (request.status !== 'Archived') { %>
  <%
    const isServiceType = request.type !== 'Request Approval';
    // Presentational-only: the requestor sees "Approved" instead of "Completed" for
    // a finished Service Request; the unit side still shows the real "Completed" status.
    const displayStatus = (isServiceType && request.status === 'Completed') ? 'Approved' : request.status;
  %>
<tr class="request-row"
    data-id="<%= request._id %>"
    data-type="<%= request.type %>"
    data-specifictype="<%= request.type === 'Request Approval' ? (request.requestType || 'Not specified') : (request.serviceType || 'Not specified') %>"
    data-title="<%= request.title %>"
    data-status="<%= request.status %>"
    data-rejection-reason="<%= (request.rejectionReason || '').replace(/"/g, '&quot;') %>"
    data-organization="<%= request.organization %>"
    data-units="<%= request.assignedUnits || 'Not yet assigned' %>"
    data-datetime="<%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %>"
    data-date="<%= request.datetime ? request.datetime.toISOString().split('T')[0] : new Date(request.createdAt).toISOString().split('T')[0] %>"
    data-deadline="<%= request.deadline ? request.deadline.toLocaleString() : 'N/A' %>"
    data-description="<%= request.description %>"
    data-links='<%= JSON.stringify(request.links || []) %>'
    data-file="<%= request.file ? request.file : '' %>"
    data-files="<%= request.files ? request.files.join(',') : '' %>"
    data-createdbyadmin="<%= request.createdByAdmin ? 'true' : 'false' %>"
    title="<%= request.createdByAdmin ? 'Created for you by admin' : '' %>">
    <td><%= request._id.toString().slice(-6) %></td>
    <td>
      <% if (request.type === 'Request Approval') { %>
        <span class="type-badge" style="padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 500; background: #dbeafe; color: #1e40af;">
          Approval
        </span>
      <% } else { %>
        <span class="type-badge" style="padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 500; background: #fef3c7; color: #92400e;">
          Service
        </span>
      <% } %>
    </td>
    <td><%= request.title %></td>
    <td><%= request.organization %></td>
    <td>
      <span class="status-badge <%= displayStatus.toLowerCase().replace(/\s+/g, '-') %>">
        <%= displayStatus %>
      </span>
    </td>
    <td><%= request.assignedUnits || 'Not yet assigned' %></td>
    <td><%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %></td>
  </tr>
  <% } %>
  <% }); %>
</tbody>
          </table>
          <% if (allRequests && allRequests.some(r => r.createdByAdmin && r.status !== 'Archived')) { %>
            <div class="admin-created-note">
              <span class="admin-created-swatch"></span>
              <span>Rows highlighted in green are requests created for you by an admin.</span>
            </div>
          <% } %>

          <!-- Pagination Controls -->
          <div id="paginationControls" style="display: flex; justify-content: center; align-items: center; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
            <button id="prevPageBtn" onclick="previousPage()" style="padding: 0.5rem 1rem; border: 1px solid #cbd5e1; border-radius: 4px; cursor: pointer; background: white; transition: all 0.2s;" title="Previous page">← Previous</button>
            <div id="pageInfo" style="font-weight: 500; color: #64748b;">Page 1</div>
            <button id="nextPageBtn" onclick="nextPage()" style="padding: 0.5rem 1rem; border: 1px solid #cbd5e1; border-radius: 4px; cursor: pointer; background: white; transition: all 0.2s;" title="Next page">Next →</button>
          </div>
        </section>

