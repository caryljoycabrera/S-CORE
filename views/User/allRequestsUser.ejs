}

.description-section {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 2rem;
  margin-bottom: 1.5rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.description-section h3 {
  margin: 0 0 1.5rem 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary-green);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
  position: relative;
}

.description-section h3::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 60px;
  height: 2px;
  background: var(--primary-green);
  border-radius: 1px;
}

.description-content {
  background: white;
  border-radius: 12px;
  padding: 1.5rem;
  border: 1px solid #f1f5f9;
  line-height: 1.7;
  color: #374151;
  font-size: 1rem;
}

.chat-section {
  text-align: center;
  margin-top: 1.5rem;
  padding: 2rem;
  background: linear-gradient(135deg, #f0fdf4, #f7fee7);
  border-radius: 16px;
  border: 1px solid #bbf7d0;
}

/* ========================================
   DEPRECATED CLASSES - USE unit-modal-* INSTEAD
   ======================================== */
/* The following classes have been replaced by standardized unit-modal-* classes.
