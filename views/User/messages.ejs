<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/user-navbar.css">
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/messaging-socket.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
        }

        .container {
            display: flex;
            height: calc(100vh - 60px);
            background: white;
        }

        .sidebar {
            width: 350px;
            border-right: 1px solid #e0e0e0;
            display: flex;
            flex-direction: column;
            background: #fafafa;
        }

        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid #e0e0e0;
        }

        .sidebar-header h2 {
            font-size: 20px;
            margin-bottom: 10px;
            color: #333;
        }

        .search-box {
            display: flex;
            gap: 8px;
            margin-top: 10px;
        }

        .search-box input {
            flex: 1;
            padding: 10px 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
        }

        .search-box button {
            padding: 10px 15px;
            background: #007bff;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .search-box button:hover {
            background: #0056b3;
        }

        .conversations-list {
            flex: 1;
            overflow-y: auto;
            padding: 10px 0;
        }

        .conversation-item {
            padding: 15px 20px;
            border-bottom: 1px solid #e0e0e0;
            cursor: pointer;
            transition: background 0.2s;
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .conversation-item:hover {
            background: #f0f0f0;
        }

        .conversation-item.active {
            background: #e3f2fd;
            border-left: 4px solid #007bff;
        }

        .conversation-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #ddd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: #666;
            flex-shrink: 0;
            overflow: hidden;
            position: relative;
        }

        .conversation-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Presence indicator dot */
        .status-indicator {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: 3px solid white;
            background: #ccc;
            transition: background 0.3s ease;
        }

        .status-indicator.online {
            background: #28a745;
            box-shadow: 0 0 0 2px #fff, 0 0 4px 0 rgba(40, 167, 69, 0.5);
        }

        .status-indicator.offline {
            background: #999;
        }

        .conversation-info {
            flex: 1;
            min-width: 0;
        }

        .conversation-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 4px;
        }

        .conversation-name {
            font-weight: 600;
            color: #333;
            font-size: 14px;
        }

        .conversation-time {
            font-size: 12px;
            color: #999;
        }

        .conversation-preview {
            font-size: 13px;
            color: #666;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .last-seen {
            font-size: 11px;
            color: #999;
            margin-top: 2px;
            display: block;
        }

        .last-seen.online {
            color: #28a745;
            font-weight: 500;
        }

        .unread-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #dc3545;
            color: white;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            font-size: 12px;
            font-weight: bold;
            flex-shrink: 0;
        }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: white;
        }

        .empty-state {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #999;
        }

        .empty-state-icon {
            font-size: 64px;
            margin-bottom: 20px;
        }

        .empty-state h3 {
            font-size: 18px;
            margin-bottom: 10px;
            color: #666;
        }

        .new-conversation-btn {
            padding: 10px 20px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            margin-top: 20px;
        }

        .new-conversation-btn:hover {
            background: #218838;
        }

        .search-results {
            position: absolute;
            top: 60px;
            left: 0;
            right: 0;
            background: white;
            border: 1px solid #ddd;
            border-radius: 6px;
            max-height: 300px;
            overflow-y: auto;
            z-index: 1000;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .search-result-item {
            padding: 12px 20px;
            border-bottom: 1px solid #f0f0f0;
            cursor: pointer;
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .search-result-item:hover {
            background: #f9f9f9;
        }

        .no-conversations {
            text-align: center;
            padding: 40px 20px;
            color: #999;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .container {
                height: calc(100vh - 56px);
            }

            .sidebar {
                width: 100%;
                max-height: 300px;
            }

            .main-content {
                display: none;
            }

            .sidebar.collapsed {
                max-height: 60px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/unit-navbar.ejs') %>

    <div class="container">
        <!-- Sidebar with conversation list -->
        <div class="sidebar">
            <div class="sidebar-header">
                <h2>💬 Messages</h2>
                <div class="search-box">
                    <input 
                        type="text" 
                        id="searchInput" 
                        placeholder="Search users..."
                        autocomplete="off"
                    >
                    <button onclick="startNewConversation()">+</button>
                </div>
                <div id="searchResults" class="search-results" style="display: none;"></div>
            </div>

            <div class="conversations-list" id="conversationsList">
                <% if (conversations && conversations.length > 0) { %>
                    <% conversations.forEach((conv, index) => { %>
                        <% 
                            const otherParticipant = conv.participants.find(p => !p.userId._id.equals(user._id));
                            const otherUserId = otherParticipant ? otherParticipant.userId._id : null;
                        %>
                        <div class="conversation-item" onclick="openConversation('<%= conv._id %>', this)" data-conv-id="<%= conv._id %>" data-user-id="<%= otherUserId %>">
                            <div class="conversation-avatar">
                                <% 
                                    const otherParticipant = conv.participants.find(p => !p.userId._id.equals(user._id));
                                    const initials = otherParticipant ? 
                                        (otherParticipant.userId.fName.charAt(0) + otherParticipant.userId.lName.charAt(0)).toUpperCase() : 
                                        'U';
                                %>
                                <% if (otherParticipant && otherParticipant.userId.profilePicture) { %>
                                    <img src="/uploads/<%= otherParticipant.userId.profilePicture %>" alt="Avatar">
                                <% } else { %>
                                    <%= initials %>
                                <% } %>
                            </div>
                            <div class="conversation-info">
                                <div class="conversation-header">
                                    <div class="conversation-name">
                                        <% 
                                            const other = conv.participants.find(p => !p.userId._id.equals(user._id));
                                            if (other) {
                                                %><%- other.userId.fName + ' ' + other.userId.lName %><%
                                            }
                                        %>
                                    </div>
                                    <div class="conversation-time">
                                        <% const lastMsg = conv.messages && conv.messages.length > 0 ? 
                                            new Date(conv.messages[conv.messages.length - 1].timestamp).toLocaleDateString() : 'N/A' %>
                                        <%= lastMsg %>
                                    </div>
                                </div>
                                <div class="conversation-preview">
                                    <% const lastMsg = conv.messages && conv.messages.length > 0 ? 
                                        conv.messages[conv.messages.length - 1].content : 'No messages yet' %>
                                    <%= lastMsg %>
                                </div>
                                <span class="last-seen">Last seen online</span>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="no-conversations">
                        <p>No conversations yet</p>
                        <button class="new-conversation-btn" onclick="showNewConversationModal()">Start New Conversation</button>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Main content area -->
        <div class="main-content" id="mainContent">
            <div class="empty-state">
                <div class="empty-state-icon">💬</div>
                <h3>Select a conversation to start</h3>
                <p>Choose a conversation from the list or start a new one</p>
            </div>
        </div>
    </div>

    <script>
        // Search for users
        document.getElementById('searchInput').addEventListener('input', async (e) => {
            const query = e.target.value.trim();
            const resultsContainer = document.getElementById('searchResults');

            if (query.length < 2) {
                resultsContainer.style.display = 'none';
                return;
            }

            try {
                const response = await fetch(`/messages/search?query=${encodeURIComponent(query)}`);
                const data = await response.json();

                if (data.success && data.results.length > 0) {
                    resultsContainer.innerHTML = data.results.map(user => `
                        <div class="search-result-item" onclick="startConversationWith('${user._id}', '${user.fName} ${user.lName}')">
                            <div class="conversation-avatar">${user.fName.charAt(0)}${user.lName.charAt(0)}</div>
                            <div>
                                <strong>${user.fName} ${user.lName}</strong>
                                <br>
                                <small>${user.email}</small>
                            </div>
                        </div>
                    `).join('');
                    resultsContainer.style.display = 'block';
                } else {
                    resultsContainer.style.display = 'none';
                }
            } catch (error) {
                console.error('Search error:', error);
            }
        });

        async function startConversationWith(userId, userName) {
            try {
                const response = await fetch('/messages', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ recipientId: userId })
                });

                const data = await response.json();
                if (data.success) {
                    openConversation(data.conversation._id);
                    document.getElementById('searchInput').value = '';
                    document.getElementById('searchResults').style.display = 'none';
                }
            } catch (error) {
                console.error('Error starting conversation:', error);
            }
        }

        function openConversation(conversationId, element) {
            // Update active state
            document.querySelectorAll('.conversation-item').forEach(item => {
                item.classList.remove('active');
            });
            if (element) element.classList.add('active');

            // Load conversation details
            fetch(`/messages/${conversationId}`)
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        loadConversationView(data.conversation);
                    }
                })
                .catch(err => console.error('Error loading conversation:', err));
        }

        function loadConversationView(conversation) {
            const mainContent = document.getElementById('mainContent');
            const otherUser = conversation.participants.find(p => p.userId._id !== '<%- user._id %>');
            
            mainContent.innerHTML = `
                <div style="display: flex; flex-direction: column; height: 100%; background: white;" data-conversation-id="${conversation._id}" data-user-id="<%- user._id %>" data-user-name="<%- user.fName %>">
                    <!-- Header -->
                    <div style="padding: 20px; border-bottom: 1px solid #e0e0e0; display: flex; justify-content: space-between; align-items: center;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="position: relative;">
                                <div style="width: 40px; height: 40px; border-radius: 50%; background: #ddd; display: flex; align-items: center; justify-content: center; font-weight: bold; color: #666;">
                                    ${otherUser ? (otherUser.userId.fName.charAt(0) + otherUser.userId.lName.charAt(0)).toUpperCase() : 'U'}
                                </div>
                                <div class="status-indicator" style="position: absolute; bottom: 0; right: 0; width: 12px; height: 12px; border-radius: 50%; background: #28a745; border: 2px solid white;"></div>
                            </div>
                            <div>
                                <h3 style="margin: 0; font-size: 16px;">${otherUser ? otherUser.userId.fName + ' ' + otherUser.userId.lName : 'Conversation'}</h3>
                                <small style="color: #999;" id="userStatusText">${otherUser ? otherUser.userId.email : ''}</small>
                            </div>
                        </div>
                        <div>
                            <button onclick="archiveConversation('${conversation._id}')" style="padding: 8px 16px; background: #f0f0f0; border: none; border-radius: 4px; cursor: pointer; margin-left: 10px;">Archive</button>
                        </div>
                    </div>

                    <!-- Messages -->
                    <div id="messagesContainer" style="flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 12px;">
                        ${conversation.messages.map(msg => `
                            <div class="message-item" data-message-id="${msg._id}" style="display: flex; ${msg.senderId._id === '<%- user._id %>' ? 'justify-content: flex-end' : 'justify-content: flex-start'}; margin-bottom: 8px;">
                                <div style="max-width: 60%; padding: 10px 14px; border-radius: 8px; ${msg.senderId._id === '<%- user._id %>' ? 'background: #007bff; color: white;' : 'background: #e0e0e0; color: #333;'}">
                                    <div class="message-content">${msg.content === '[Message deleted]' ? '<em style="opacity: 0.6;">' + msg.content + '</em>' : msg.content}</div>
                                    <div style="display: flex; gap: 8px; align-items: center; margin-top: 4px;">
                                        <small style="opacity: 0.7; font-size: 11px;">${new Date(msg.timestamp).toLocaleTimeString()}</small>
                                        ${msg.editedAt ? '<small class="edited-label" style="opacity: 0.7; font-size: 10px;">(edited)</small>' : ''}
                                        ${msg.senderId._id === '<%- user._id %>' ? '<span class="read-receipt" style="display: none; font-size: 10px;">✓</span>' : ''}
                                    </div>
                                </div>
                            </div>
                        `).join('')}
                    </div>

                    <!-- Typing Indicator -->
                    <div id="typingIndicator" style="padding: 0 20px 10px 20px; display: none; color: #999; font-size: 12px; font-style: italic;">
                        Someone is typing...
                    </div>

                    <!-- Input -->
                    <div style="padding: 20px; border-top: 1px solid #e0e0e0; display: flex; gap: 10px;">
                        <input type="text" id="messageInput" placeholder="Type a message..." style="flex: 1; padding: 10px 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px;">
                        <button onclick="sendMessage('${conversation._id}')" style="padding: 10px 20px; background: #007bff; color: white; border: none; border-radius: 6px; cursor: pointer;">Send</button>
                    </div>
                </div>
            `;

            // Join socket room for this conversation
            if (messagingSocket) {
                messagingSocket.joinConversation(conversation._id);
            }

            // Auto-scroll to bottom
            setTimeout(() => {
                const container = document.getElementById('messagesContainer');
                container.scrollTop = container.scrollHeight;
            }, 100);
        }

        async function sendMessage(conversationId) {
            const input = document.getElementById('messageInput');
            const content = input.value.trim();

            if (!content) return;

            try {
                const response = await fetch(`/messages/${conversationId}/send`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content })
                });

                const data = await response.json();
                if (data.success) {
                    input.value = '';
                    // Reload conversation to show new message
                    const convElement = document.querySelector(`[data-conv-id="${conversationId}"]`);
                    if (convElement) {
                        openConversation(conversationId, convElement);
                    }
                }
            } catch (error) {
                console.error('Error sending message:', error);
            }
        }

        async function archiveConversation(conversationId) {
            if (!confirm('Archive this conversation?')) return;

            try {
                const response = await fetch(`/messages/${conversationId}/archive`, {
                    method: 'POST'
                });

                const data = await response.json();
                if (data.success) {
                    location.reload();
                }
            } catch (error) {
                console.error('Error archiving conversation:', error);
            }
        }

        function showNewConversationModal() {
            alert('Use the search box to find a user and start a conversation!');
        }
    </script>
</body>
</html>
