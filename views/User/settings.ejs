<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/x-icon" href="/Picture/favicon.ico?v=2">
    <link rel="shortcut icon" href="/Picture/favicon.ico?v=2">
    <meta name="theme-color" content="#1a5d1a">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings - S-CORE</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/stylesheets/user-navbar.css">
  <link rel="stylesheet" href="/stylesheets/notifications.css">
  <link rel="stylesheet" href="/stylesheets/modal-centered.css">
  <link rel="stylesheet" href="/stylesheets/no-animations.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
  <script src="/javascripts/alert-handler.js"></script>

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #f8f9fa; min-height: 100vh; }
    .main-wrapper { display: flex; gap: 2rem; padding: 2rem; max-width: 1200px; margin: 0 auto; }
    
    /* Sidebar Navigation */
    .settings-sidebar { width: 250px; background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); height: fit-content; position: sticky; top: 80px; }
    .settings-sidebar h3 { font-size: 0.875rem; text-transform: uppercase; color: #6b7280; letter-spacing: 0.5px; margin-bottom: 1rem; }
    .settings-nav-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem; margin-bottom: 0.5rem; border-radius: 8px; cursor: pointer; transition: all 0.2s ease; color: #374151; text-decoration: none; border: 2px solid transparent; }
    .settings-nav-item:hover { background: #f9fafb; color: #10b981; }
    .settings-nav-item.active { background: #f0fdf4; color: #10b981; border-color: #10b981; font-weight: 600; }
    .settings-nav-icon { width: 20px; height: 20px; }

    /* Main Content */
    .settings-content { flex: 1; }
    .settings-section { background: white; border-radius: 12px; padding: 2rem; margin-bottom: 2rem; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); }
    .settings-section h2 { font-size: 1.5rem; margin-bottom: 0.5rem; color: #1f2937; }
    .settings-section-subtitle { font-size: 0.9rem; color: #6b7280; margin-bottom: 1.5rem; }

    /* Form Styles */
    .form-group { margin-bottom: 1.5rem; }
    .form-group label { display: block; font-weight: 600; color: #374151; margin-bottom: 0.5rem; font-size: 0.9rem; }
    .form-group input[type="text"],
    .form-group input[type="email"],
    .form-group input[type="password"],
    .form-group input[type="number"],
    .form-group select,
    .form-group textarea { width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem; font-family: inherit; transition: all 0.2s ease; }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus { outline: none; border-color: #10b981; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1); }
    .form-group input:disabled { background: #f3f4f6; color: #9ca3af; cursor: not-allowed; }
    .form-group small { display: block; margin-top: 0.5rem; color: #6b7280; font-size: 0.875rem; }

    /* Toggle Switch */
    .toggle-group { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
    .toggle-label { font-weight: 600; color: #374151; margin: 0; }
    .toggle-switch { position: relative; width: 56px; height: 32px; background: #e5e7eb; border-radius: 16px; cursor: pointer; transition: all 0.3s ease; }
    .toggle-switch.active { background: #10b981; }
    .toggle-switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 28px; height: 28px; background: white; border-radius: 50%; transition: all 0.3s ease; }
    .toggle-switch.active::after { left: 26px; }

    /* Checkbox Group */
    .checkbox-group { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .checkbox-item { display: flex; align-items: center; gap: 0.75rem; }
    .checkbox-item input[type="checkbox"] { width: 20px; height: 20px; cursor: pointer; accent-color: #10b981; }
    .checkbox-item label { margin: 0; cursor: pointer; }

    /* Form Grid */
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media (max-width: 768px) { .form-grid { grid-template-columns: 1fr; } }

    /* Buttons */
    .btn-group { display: flex; gap: 0.75rem; margin-top: 2rem; }
    .btn { padding: 0.75rem 1.5rem; border-radius: 8px; font-size: 0.9rem; font-weight: 600; cursor: pointer; border: none; transition: all 0.2s ease; text-transform: uppercase; letter-spacing: 0.5px; }
    .btn-primary { background: #10b981; color: white; }
    .btn-primary:hover { background: #059669; transform: translateY(-1px); }
    .btn-secondary { background: #f3f4f6; color: #374151; border: 2px solid #e5e7eb; }
    .btn-secondary:hover { background: #e5e7eb; }
    .btn-danger { background: #ef4444; color: white; }
    .btn-danger:hover { background: #dc2626; }

    /* Profile Picture */
    .profile-pic-container { display: flex; align-items: flex-end; gap: 1.5rem; margin-bottom: 2rem; }
    .profile-pic-display { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid #10b981; }
    .profile-pic-actions { display: flex; flex-direction: column; gap: 0.75rem; }
    .profile-pic-actions .btn { width: 150px; }

    /* Divider */
    .divider { height: 1px; background: #e5e7eb; margin: 2rem 0; }

    /* Loading State */
    .loading { display: inline-block; width: 16px; height: 16px; border: 2px solid #e5e7eb; border-top: 2px solid #10b981; border-radius: 50%; animation: spin 1s linear infinite; }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

    /* Modal */
    .modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); display: none; justify-content: center; align-items: center; z-index: 1000; }
    .modal.active { display: flex; }
    .modal-content { background: white; border-radius: 12px; max-width: 400px; width: 90%; padding: 2rem; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2); }
    .modal-header { font-size: 1.25rem; font-weight: 600; color: #1f2937; margin-bottom: 1rem; }
    .modal-body { margin-bottom: 1.5rem; color: #6b7280; }
    .modal-actions { display: flex; gap: 0.75rem; justify-content: flex-end; }
    .modal-btn { padding: 0.75rem 1.5rem; border-radius: 8px; font-size: 0.875rem; font-weight: 600; cursor: pointer; border: none; transition: all 0.2s ease; }
    .modal-btn-primary { background: #10b981; color: white; }
    .modal-btn-primary:hover { background: #059669; }
    .modal-btn-secondary { background: #f3f4f6; color: #374151; }
    .modal-btn-secondary:hover { background: #e5e7eb; }
    .modal-btn-danger { background: #ef4444; color: white; }
    .modal-btn-danger:hover { background: #dc2626; }

    /* Responsive */
    @media (max-width: 768px) {
      .main-wrapper { flex-direction: column; }
      .settings-sidebar { width: 100%; position: static; }
      .checkbox-group { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body>
  <!-- Include Navbar (assuming it exists) -->
  <%- include('../partials/unit-navbar') %>

  <div class="main-wrapper">
    <!-- Sidebar Navigation -->
    <aside class="settings-sidebar">
      <h3>Settings</h3>
      <a href="#profile" class="settings-nav-item active" onclick="switchTab(event, 'profile')">
        <svg class="settings-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span>Profile</span>
      </a>
      <a href="#notifications" class="settings-nav-item" onclick="switchTab(event, 'notifications')">
        <svg class="settings-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span>Notifications</span>
      </a>
      <a href="#security" class="settings-nav-item" onclick="switchTab(event, 'security')">
        <svg class="settings-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>Security</span>
      </a>
      <a href="#preferences" class="settings-nav-item" onclick="switchTab(event, 'preferences')">
        <svg class="settings-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="1"></circle>
          <path d="M12 1v6m0 6v6"></path>
          <path d="M4.22 4.22l4.24 4.24m5.08 5.08l4.24 4.24"></path>
          <path d="M1 12h6m6 0h6"></path>
          <path d="M4.22 19.78l4.24-4.24m5.08-5.08l4.24-4.24"></path>
        </svg>
        <span>Preferences</span>
      </a>
      <a href="#privacy" class="settings-nav-item" onclick="switchTab(event, 'privacy')">
        <svg class="settings-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7v5c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"></path>
        </svg>
        <span>Privacy</span>
      </a>
    </aside>

    <!-- Main Content -->
    <main class="settings-content">
      <!-- Profile Section -->
      <section class="settings-section" id="profile-tab">
        <h2>Profile Information</h2>
        <p class="settings-section-subtitle">Manage your account information</p>

        <!-- Profile Picture -->
        <div class="profile-pic-container">
          <img id="profilePic" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user-placeholder.svg' %>" alt="Profile" class="profile-pic-display">
          <div class="profile-pic-actions">
            <input type="file" id="profilePicInput" accept="image/*" style="display: none;" onchange="uploadProfilePic(event)">
            <button class="btn btn-primary" onclick="document.getElementById('profilePicInput').click()">Change Photo</button>
            <button class="btn btn-secondary" onclick="removeProfilePic()">Remove</button>
          </div>
        </div>

        <div class="divider"></div>

        <form id="profileForm" onsubmit="saveProfile(event)">
          <div class="form-grid">
            <div class="form-group">
              <label for="firstName">First Name</label>
              <input type="text" id="firstName" name="firstName" value="<%= user.fName %>" required>
            </div>
            <div class="form-group">
              <label for="lastName">Last Name</label>
              <input type="text" id="lastName" name="lastName" value="<%= user.lName %>" required>
            </div>
          </div>

          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" value="<%= user.email %>" required>
            <small>We'll never share your email</small>
          </div>

          <div class="form-group">
            <label for="contact">Contact Number</label>
            <input type="text" id="contact" name="contact" value="<%= user.contactNo || '' %>">
          </div>

          <div class="form-group">
            <label for="organization">Organization</label>
            <input type="text" id="organization" name="organization" value="<%= user.organization || user.affiliation?.[0] || '' %>" disabled>
            <small>Contact administrator to change organization</small>
          </div>

          <div class="btn-group">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <button type="reset" class="btn btn-secondary">Cancel</button>
          </div>
        </form>
      </section>

      <!-- Notifications Section -->
      <section class="settings-section" id="notifications-tab" style="display: none;">
        <h2>Notification Preferences</h2>
        <p class="settings-section-subtitle">Control how you receive notifications</p>

        <form id="notificationsForm" onsubmit="saveNotifications(event)">
          <div class="toggle-group">
            <label class="toggle-label">Email Notifications</label>
            <div class="toggle-switch active" id="emailToggle" onclick="toggleNotification(event)"></div>
          </div>

          <div class="form-group">
            <label>Email Frequency</label>
            <select id="emailFrequency" name="emailFrequency">
              <option value="immediate">Immediately</option>
              <option value="daily" selected>Daily Digest</option>
              <option value="weekly">Weekly Digest</option>
              <option value="never">Never</option>
            </select>
          </div>

          <div class="divider"></div>

          <h3 style="margin: 1.5rem 0 1rem 0; font-size: 1rem; color: #374151;">Notify me about:</h3>

          <div class="checkbox-group">
            <div class="checkbox-item">
              <input type="checkbox" id="notifNewRequest" checked>
              <label for="notifNewRequest">New requests assigned</label>
            </div>
            <div class="checkbox-item">
              <input type="checkbox" id="notifRequestUpdate" checked>
              <label for="notifRequestUpdate">Request updates</label>
            </div>
            <div class="checkbox-item">
              <input type="checkbox" id="notifRequestComplete" checked>
              <label for="notifRequestComplete">Request completed</label>
            </div>
            <div class="checkbox-item">
              <input type="checkbox" id="notifRevision" checked>
              <label for="notifRevision">Revisions required</label>
            </div>
            <div class="checkbox-item">
              <input type="checkbox" id="notifAnnouncements" checked>
              <label for="notifAnnouncements">System announcements</label>
            </div>
            <div class="checkbox-item">
              <input type="checkbox" id="notifMessages" checked>
              <label for="notifMessages">Direct messages</label>
            </div>
          </div>

          <div class="btn-group">
            <button type="submit" class="btn btn-primary">Save Preferences</button>
            <button type="reset" class="btn btn-secondary">Cancel</button>
          </div>
        </form>
      </section>

      <!-- Security Section -->
      <section class="settings-section" id="security-tab" style="display: none;">
        <h2>Security Settings</h2>
        <p class="settings-section-subtitle">Keep your account safe and secure</p>

        <h3 style="margin: 1.5rem 0 1rem 0; font-size: 1rem; color: #374151;">Change Password</h3>

        <form id="passwordForm" onsubmit="changePassword(event)">
          <div class="form-group">
            <label for="currentPassword">Current Password</label>
            <input type="password" id="currentPassword" name="currentPassword" required>
          </div>

          <div class="form-group">
            <label for="newPassword">New Password</label>
            <input type="password" id="newPassword" name="newPassword" required>
            <small>At least 8 characters with numbers and special characters</small>
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" required>
          </div>

          <div class="btn-group">
            <button type="submit" class="btn btn-primary">Update Password</button>
            <button type="reset" class="btn btn-secondary">Cancel</button>
          </div>
        </form>

        <div class="divider"></div>

        <h3 style="margin: 1.5rem 0 1rem 0; font-size: 1rem; color: #374151;">Active Sessions</h3>
        <p style="color: #6b7280; margin-bottom: 1rem;">You have 1 active session on this browser</p>
        <button class="btn btn-secondary" onclick="logoutOtherSessions()">Logout Other Sessions</button>
      </section>

      <!-- Preferences Section -->
      <section class="settings-section" id="preferences-tab" style="display: none;">
        <h2>Display Preferences</h2>
        <p class="settings-section-subtitle">Customize your experience</p>

        <form id="preferencesForm" onsubmit="savePreferences(event)">
          <div class="toggle-group">
            <label class="toggle-label">Dark Mode</label>
            <div class="toggle-switch" id="darkModeToggle" onclick="toggleDarkMode(event)"></div>
          </div>

          <div class="form-group">
            <label for="language">Language</label>
            <select id="language" name="language">
              <option value="en" selected>English</option>
              <option value="es">Spanish</option>
              <option value="fr">French</option>
            </select>
          </div>

          <div class="form-group">
            <label for="timezone">Timezone</label>
            <select id="timezone" name="timezone">
              <option value="UTC">UTC</option>
              <option value="America/New_York">Eastern Time</option>
              <option value="America/Los_Angeles">Pacific Time</option>
              <option value="Asia/Manila" selected>Manila Time</option>
            </select>
          </div>

          <div class="form-group">
            <label for="itemsPerPage">Items Per Page</label>
            <select id="itemsPerPage" name="itemsPerPage">
              <option value="10">10</option>
              <option value="20" selected>20</option>
              <option value="50">50</option>
            </select>
          </div>

          <div class="btn-group">
            <button type="submit" class="btn btn-primary">Save Preferences</button>
            <button type="reset" class="btn btn-secondary">Cancel</button>
          </div>
        </form>
      </section>

      <!-- Privacy Section -->
      <section class="settings-section" id="privacy-tab" style="display: none;">
        <h2>Privacy & Data</h2>
        <p class="settings-section-subtitle">Manage your privacy settings and data</p>

        <h3 style="margin: 1.5rem 0 1rem 0; font-size: 1rem; color: #374151;">Profile Visibility</h3>

        <div class="form-group">
          <label for="profileVisibility">Who can see your profile?</label>
          <select id="profileVisibility" name="profileVisibility">
            <option value="everyone" selected>Everyone in S-CORE</option>
            <option value="organization">Organization members only</option>
            <option value="admins">Administrators only</option>
            <option value="private">Only me</option>
          </select>
        </div>

        <div class="divider"></div>

        <h3 style="margin: 1.5rem 0 1rem 0; font-size: 1rem; color: #374151;">Data Management</h3>

        <p style="color: #6b7280; margin-bottom: 1rem;">Download or delete your personal data</p>

        <div class="btn-group">
          <button class="btn btn-secondary" onclick="downloadData()">
            <svg style="width: 16px; height: 16px; display: inline; margin-right: 0.5rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download My Data
          </button>
          <button class="btn btn-danger" onclick="openDeleteModal()">
            <svg style="width: 16px; height: 16px; display: inline; margin-right: 0.5rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 4 21 4 23 6 23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6"></polyline>
              <line x1="10" y1="11" x2="10" y2="17"></line>
              <line x1="14" y1="11" x2="14" y2="17"></line>
            </svg>
            Delete My Account
          </button>
        </div>
      </section>
    </main>
  </div>

  <!-- Delete Account Modal -->
  <div class="modal" id="deleteModal">
    <div class="modal-content">
      <div class="modal-header">Delete Account</div>
      <div class="modal-body">
        <p style="margin-bottom: 1rem;"><strong>⚠️ Warning:</strong> This action is permanent and cannot be undone.</p>
        <p>All your data, requests, and messages will be permanently deleted from S-CORE.</p>
      </div>
      <div class="modal-actions">
        <button class="modal-btn modal-btn-secondary" onclick="closeDeleteModal()">Cancel</button>
        <button class="modal-btn modal-btn-danger" onclick="deleteAccount()">Delete Account</button>
      </div>
    </div>
  </div>

  <script src="/javascripts/notifications.js"></script>

  <script>
    // Tab Switching
    function switchTab(event, tabName) {
      event.preventDefault();
      
      // Hide all tabs
      document.querySelectorAll('.settings-section').forEach(el => el.style.display = 'none');
      
      // Show selected tab
      document.getElementById(tabName + '-tab').style.display = 'block';
      
      // Update active nav item
      document.querySelectorAll('.settings-nav-item').forEach(el => el.classList.remove('active'));
      event.currentTarget.classList.add('active');
    }

    // Save Profile
    function saveProfile(event) {
      event.preventDefault();
      const formData = new FormData(document.getElementById('profileForm'));
      
      fetch('/user/settings/profile', {
        method: 'POST',
        body: JSON.stringify({
          fName: document.getElementById('firstName').value,
          lName: document.getElementById('lastName').value,
          email: document.getElementById('email').value,
          contactNo: document.getElementById('contact').value
        }),
        headers: { 'Content-Type': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          showAlert('Profile updated successfully', 'success');
        } else {
          showAlert(data.message || 'Failed to update profile', 'error');
        }
      })
      .catch(err => {
        console.error('Error:', err);
        showAlert('An error occurred', 'error');
      });
    }

    // Save Notifications
    function saveNotifications(event) {
      event.preventDefault();
      const data = {
        emailNotifications: document.getElementById('emailToggle').classList.contains('active'),
        emailFrequency: document.getElementById('emailFrequency').value,
        notificationPreferences: {
          newRequest: document.getElementById('notifNewRequest').checked,
          requestUpdate: document.getElementById('notifRequestUpdate').checked,
          requestComplete: document.getElementById('notifRequestComplete').checked,
          revision: document.getElementById('notifRevision').checked,
          announcements: document.getElementById('notifAnnouncements').checked,
          messages: document.getElementById('notifMessages').checked
        }
      };

      fetch('/user/settings/notifications', {
        method: 'POST',
        body: JSON.stringify(data),
        headers: { 'Content-Type': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          showAlert('Notification preferences saved', 'success');
        } else {
          showAlert(data.message || 'Failed to save preferences', 'error');
        }
      })
      .catch(err => showAlert('An error occurred', 'error'));
    }

    // Change Password
    function changePassword(event) {
      event.preventDefault();
      const newPass = document.getElementById('newPassword').value;
      const confirmPass = document.getElementById('confirmPassword').value;

      if (newPass !== confirmPass) {
        showAlert('Passwords do not match', 'error');
        return;
      }

      if (newPass.length < 8) {
        showAlert('Password must be at least 8 characters', 'error');
        return;
      }

      fetch('/user/settings/password', {
        method: 'POST',
        body: JSON.stringify({
          currentPassword: document.getElementById('currentPassword').value,
          newPassword: newPass
        }),
        headers: { 'Content-Type': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          showAlert('Password changed successfully', 'success');
          document.getElementById('passwordForm').reset();
        } else {
          showAlert(data.message || 'Failed to change password', 'error');
        }
      })
      .catch(err => showAlert('An error occurred', 'error'));
    }

    // Toggle Notifications
    function toggleNotification(event) {
      event.currentTarget.classList.toggle('active');
    }

    // Toggle Dark Mode
    function toggleDarkMode(event) {
      event.currentTarget.classList.toggle('active');
      // Implement dark mode logic
    }

    // Save Preferences
    function savePreferences(event) {
      event.preventDefault();
      const data = {
        language: document.getElementById('language').value,
        timezone: document.getElementById('timezone').value,
        itemsPerPage: document.getElementById('itemsPerPage').value,
        darkMode: document.getElementById('darkModeToggle').classList.contains('active')
      };

      fetch('/user/settings/preferences', {
        method: 'POST',
        body: JSON.stringify(data),
        headers: { 'Content-Type': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          showAlert('Preferences saved successfully', 'success');
        } else {
          showAlert(data.message || 'Failed to save preferences', 'error');
        }
      })
      .catch(err => showAlert('An error occurred', 'error'));
    }

    // Profile Picture Upload
    function uploadProfilePic(event) {
      const file = event.target.files[0];
      if (!file) return;

      const formData = new FormData();
      formData.append('file', file);

      fetch('/user/settings/profile-pic', {
        method: 'POST',
        body: formData
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          document.getElementById('profilePic').src = '/uploads/' + data.filename;
          showAlert('Profile picture updated', 'success');
        } else {
          showAlert(data.message || 'Failed to upload picture', 'error');
        }
      })
      .catch(err => showAlert('An error occurred', 'error'));
    }

    // Remove Profile Picture
    function removeProfilePic() {
      if (confirm('Remove your profile picture?')) {
        fetch('/user/settings/profile-pic', { method: 'DELETE' })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              document.getElementById('profilePic').src = '/Picture/user.png';
              showAlert('Profile picture removed', 'success');
            }
          })
          .catch(err => showAlert('An error occurred', 'error'));
      }
    }

    // Download Data
    function downloadData() {
      window.location.href = '/user/settings/download-data';
    }

    // Delete Account Modals
    function openDeleteModal() {
      document.getElementById('deleteModal').classList.add('active');
    }

    function closeDeleteModal() {
      document.getElementById('deleteModal').classList.remove('active');
    }

    function deleteAccount() {
      if (confirm('Are you absolutely sure? This cannot be undone.')) {
        fetch('/user/settings/account', { method: 'DELETE' })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              showAlert('Account deleted. Redirecting...', 'success');
              setTimeout(() => window.location.href = '/login', 2000);
            }
          })
          .catch(err => showAlert('An error occurred', 'error'));
      }
    }

    function logoutOtherSessions() {
      fetch('/user/settings/logout-other-sessions', { method: 'POST' })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            showAlert('Other sessions logged out', 'success');
          }
        })
        .catch(err => showAlert('An error occurred', 'error'));
    }

    // Close modal on outside click
    document.getElementById('deleteModal').addEventListener('click', (e) => {
      if (e.target.id === 'deleteModal') closeDeleteModal();
    });
  </script>
</body>
</html>
