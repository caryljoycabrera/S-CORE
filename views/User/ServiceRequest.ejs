  bottom: -2px;
  left: 0;
  width: 60px;
  height: 2px;
  background: var(--primary-green);
  border-radius: 1px;
}

.details-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

.details-field {
  background: white;
  border-radius: 12px;
  padding: 1.25rem;
  border: 1px solid #f1f5f9;
  transition: all 0.3s ease;
}

