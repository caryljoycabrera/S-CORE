}

.file-header-enhanced {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid #f1f5f9;
}

.file-icon-enhanced {
  width: 28px;
  height: 28px;
  color: var(--primary-green);
  flex-shrink: 0;
}

.file-info-enhanced {
  flex: 1;
}

.file-name-enhanced {
  font-weight: 600;
  color: #1e293b;
  font-size: 1rem;
