                } else {
                    // No revisions to show, but still show the section with empty message
                    if (modalContent) modalContent.classList.remove('has-revisions');
                    historyContainer.innerHTML = `
                        <div style="text-align: center; padding: 2rem; color: #64748b;">
                            <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin: 0 auto 1rem; opacity: 0.5;">
                                <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            <p>No revision history available yet.</p>
                            <small>Revision history will appear here when updates are made to your request.</small>
                        </div>
                    `;
                }
            } else {
                // API call successful but no revisions
                if (modalContent) modalContent.classList.remove('has-revisions');
                historyContainer.innerHTML = `
                    <div style="text-align: center; padding: 2rem; color: #64748b;">
                        <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin: 0 auto 1rem; opacity: 0.5;">
                            <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        <p>No revision history available yet.</p>
                        <small>Revision history will appear here when updates are made to your request.</small>
                    </div>
                `;
            }
        } catch (error) {
            console.error('[Service] Error loading revision history:', error);
            // Show error message in revision history section
            if (modalContent) modalContent.classList.remove('has-revisions');
            historyContainer.innerHTML = `
                <div style="text-align: center; padding: 2rem; color: #dc2626;">
                    <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin: 0 auto 1rem; opacity: 0.5;">
