  border-color: #e2e8f0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.details-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 0.5rem;
  display: block;
}

.details-value {
  font-size: 1rem;
  color: #1e293b;
  line-height: 1.6;
  font-weight: 500;
}

.status-badge-large {
  display: inline-flex;
  align-items: center;
  padding: 0.625rem 1.25rem;
  border-radius: 25px;
  font-size: 0.875rem;
  font-weight: 600;
  text-transform: capitalize;
  border: 2px solid transparent;
  transition: all 0.3s ease;
}

.status-badge-large.pending {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #92400e;
  border-color: #f59e0b;
}

.status-badge-large.queued {
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
  color: #0c4a6e;
  border-color: #0ea5e9;
}

.status-badge-large.in-progress,
.status-badge-large.inprogress {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #1e40af;
  border-color: #3b82f6;
}

.status-badge-large.approved {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  color: #065f46;
  border-color: #10b981;
}

.status-badge-large.rejected {
  background: linear-gradient(135deg, #fecaca, #fca5a5);
  color: #991b1b;
  border-color: #ef4444;
}

.status-badge-large.completed {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  color: #065f46;
  border-color: #10b981;
}

.status-badge-large.for-revision {
  background: linear-gradient(135deg, #fed7aa, #fdba74);
  color: #78350f;
  border-color: #f97316;
}

.deadline-badge-large {
  display: inline-flex;
  align-items: center;
  padding: 0.625rem 1.25rem;
  border-radius: 25px;
  font-size: 0.875rem;
  font-weight: 600;
  background: linear-gradient(135deg, #f8fafc, #f1f5f9);
  color: #475569;
  border: 2px solid #e2e8f0;
  transition: all 0.3s ease;
}

.deadline-badge-large.overdue {
  background: linear-gradient(135deg, #fecaca, #fca5a5);
  color: #dc2626;
  border-color: #ef4444;
}

.deadline-badge-large.near-deadline {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #d97706;
  border-color: #f59e0b;
}

.description-section {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 2rem;
  margin-bottom: 1.5rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.description-section h3 {
  margin: 0 0 1.5rem 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary-green);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
  position: relative;
}

.description-section h3::after {
  content: '';
