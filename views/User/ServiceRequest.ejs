  <script>
// ===== QUILL RICH TEXT EDITORS =====
let descriptionQuill;

document.addEventListener('DOMContentLoaded', function() {
  // Initialize Description Editor
  if (document.getElementById('descriptionEditor')) {
    descriptionQuill = new Quill('#descriptionEditor', {
      theme: 'snow',
      placeholder: 'Provide detailed information about your request...',
      modules: {
        toolbar: [
          ['bold', 'italic', 'underline'],
          [{ 'list': 'ordered'}, { 'list': 'bullet' }],
          ['link'],
          ['clean']
        ],
        keyboard: {
          bindings: {
            bold: { key: 'B', ctrlKey: true, handler: function() { this.quill.format('bold', !this.quill.getFormat().bold); }},
            italic: { key: 'I', ctrlKey: true, handler: function() { this.quill.format('italic', !this.quill.getFormat().italic); }},
            underline: { key: 'U', ctrlKey: true, handler: function() { this.quill.format('underline', !this.quill.getFormat().underline); }}
          }
        }
      }
    });
  }

  // Handle form submission to extract Quill content
  const serviceForm = document.querySelector('#requestModal form');
  if (serviceForm) {
    serviceForm.addEventListener('submit', function(e) {
      // Extract HTML content from Quill editor before submission
      if (descriptionQuill) {
        const descriptionHTML = descriptionQuill.root.innerHTML;
        const descriptionText = descriptionQuill.getText().trim();
        const descriptionInput = document.getElementById('description');
        
        if (descriptionInput) {
          descriptionInput.value = descriptionHTML;
        }
        
        // Validate description has content
        if (!descriptionText) {
          e.preventDefault();
          alert('Please enter a description.');
          descriptionQuill.focus();
          return false;
        }
      }

      // Add links to form data
      const links = getLinkValues();
      // Clear any existing link inputs from previous submissions
      const existingLinkInputs = serviceForm.querySelectorAll('input[name="links"]');
      existingLinkInputs.forEach(input => input.remove());
      
      // Add link inputs
      links.forEach(link => {
        const linkInput = document.createElement('input');
        linkInput.type = 'hidden';
        linkInput.name = 'links';
        linkInput.value = link;
        serviceForm.appendChild(linkInput);
      });
    });
  }
});

// ===== REQUEST TYPE SELECTION LOGIC =====
document.addEventListener('DOMContentLoaded', function() {
  const specificRequestTypeSelect = document.getElementById('specificRequestType');
  const customRequestTypeInput = document.getElementById('customRequestType');
  const finalRequestTypeInput = document.getElementById('finalRequestType');
  const requestTypeError = document.getElementById('requestTypeError');
  const serviceRequestForm = document.querySelector('#requestModal form');

  // Custom type modal elements
  const customTypeModal = document.getElementById('customTypeModal');
  const closeCustomTypeModal = document.getElementById('closeCustomTypeModal');
  const customTypeCancelBtn = document.getElementById('customTypeCancelBtn');
  const customTypeProceedBtn = document.getElementById('customTypeProceedBtn');
  const customTypeText = document.getElementById('customTypeText');

  let pendingCustomType = '';

  // Fetch and populate approved request types
  async function loadApprovedRequestTypes() {
    try {
      const response = await fetch('/api/request-types/approved');
      const data = await response.json();

      if (data.success && data.requestTypes && data.requestTypes.length > 0) {
        // Clear existing options except the first one
        while (specificRequestTypeSelect.options.length > 1) {
          specificRequestTypeSelect.remove(1);
        }

        // Group request types by category
        const groupedTypes = {};
        data.requestTypes.forEach(type => {
          const category = type.category || 'Other Services';
          if (!groupedTypes[category]) {
            groupedTypes[category] = [];
          }
          groupedTypes[category].push(type);
        });

        // Add optgroups and options
        Object.keys(groupedTypes).sort().forEach(category => {
          const optgroup = document.createElement('optgroup');
          optgroup.label = category;

          groupedTypes[category].forEach(type => {
            const option = document.createElement('option');
            option.value = type.name;
            option.textContent = type.name;
            optgroup.appendChild(option);
          });

          specificRequestTypeSelect.appendChild(optgroup);
        });

        console.log('Loaded', data.requestTypes.length, 'approved request types');
      } else {
        console.warn('No approved request types found, using fallback options');
        // Fallback to hardcoded options if API fails
        addFallbackOptions();
      }
    } catch (error) {
      console.error('Error loading request types:', error);
      // Fallback to hardcoded options
      addFallbackOptions();
    }
  }

  // Fallback options if API fails
  function addFallbackOptions() {
    const fallbackOptions = [
      { category: 'Graphics & Design Services', types: ['Creation of New Graphics/Pubmat', 'Creation of New Logo/Branding Element'] },
      { category: 'Multimedia Services', types: ['Event Photo & Video Coverage', 'Photo/Video Editing Service'] },
      { category: 'Content & Communications', types: ['Magazine Content Creation', 'Social Media Content Sharing/Posting'] }
    ];

    fallbackOptions.forEach(group => {
      const optgroup = document.createElement('optgroup');
      optgroup.label = group.category;

      group.types.forEach(type => {
        const option = document.createElement('option');
        option.value = type;
        option.textContent = type;
        optgroup.appendChild(option);
      });

      specificRequestTypeSelect.appendChild(optgroup);
    });
  }

  // Load request types on page load
  loadApprovedRequestTypes();

  // ===== LINKS MANAGEMENT =====
  const linksContainer = document.getElementById('linksContainer');
  const addLinkBtn = document.getElementById('addLinkBtn');

  // Function to create a new link input field
  function createLinkInput(value = '') {
    const linkItem = document.createElement('div');
    linkItem.className = 'link-item';
    
    linkItem.innerHTML = `
      <input type="url" placeholder="https://example.com" value="${value}" />
      <button type="button" class="remove-link-btn" title="Remove link">&times;</button>
    `;
    
    // Add event listener to remove button
    const removeBtn = linkItem.querySelector('.remove-link-btn');
    removeBtn.addEventListener('click', function() {
      linkItem.remove();
    });
    
    return linkItem;
  }

  // Add link button event listener
  addLinkBtn.addEventListener('click', function() {
    const linkInput = createLinkInput();
    linksContainer.appendChild(linkInput);
    // Focus on the new input
    linkInput.querySelector('input[type="url"]').focus();
  });

  // Function to get all link values
  // NOTE: This is now defined globally below DOMContentLoaded

  // Handle dropdown selection
  if (specificRequestTypeSelect) {
    specificRequestTypeSelect.addEventListener('change', function() {
      if (this.value) {
        // Clear custom input when dropdown is selected
        if (customRequestTypeInput) {
          customRequestTypeInput.value = '';
        }
        updateFinalRequestType(this.value);
        hideRequestTypeError();
      }
    });
  }

  // Handle custom input
  if (customRequestTypeInput) {
    customRequestTypeInput.addEventListener('input', function() {
      const customValue = this.value.trim();

      if (customValue) {
        // Clear dropdown when custom input has value
        if (specificRequestTypeSelect) {
          specificRequestTypeSelect.value = '';
        }
        updateFinalRequestType(customValue);
        hideRequestTypeError();
      } else {
        updateFinalRequestType('');
      }
    });
  }

  // Update hidden final request type field
  function updateFinalRequestType(value) {
    if (finalRequestTypeInput) {
      finalRequestTypeInput.value = value;
    }
  }

  // Show/hide error message
  function showRequestTypeError() {
    if (requestTypeError) {
      requestTypeError.style.display = 'block';
    }
  }

  function hideRequestTypeError() {
    if (requestTypeError) {
      requestTypeError.style.display = 'none';
    }
  }

  // Form validation before submission
  if (serviceRequestForm) {
    serviceRequestForm.addEventListener('submit', function(e) {
      const finalType = finalRequestTypeInput ? finalRequestTypeInput.value.trim() : '';

      if (!finalType) {
        e.preventDefault();
        showRequestTypeError();
        // Focus on dropdown first
        if (specificRequestTypeSelect) {
          specificRequestTypeSelect.focus();
        }
        return;
      }

      // Check if it's a custom type (not in dropdown options)
      const dropdownOptions = specificRequestTypeSelect ? Array.from(specificRequestTypeSelect.options).map(opt => opt.value) : [];
      const isCustomType = finalType && !dropdownOptions.includes(finalType);

      if (isCustomType) {
        e.preventDefault();
        pendingCustomType = finalType;

        // Show custom type confirmation modal
        if (customTypeModal && customTypeText) {
          customTypeText.textContent = finalType;
          customTypeModal.style.display = 'flex';
        }
        return;
      }

      // Allow normal submission for predefined types
    });
  }

  // Custom type modal handlers
  if (closeCustomTypeModal) {
    closeCustomTypeModal.onclick = function() {
      if (customTypeModal) customTypeModal.style.display = 'none';
    };
  }

  if (customTypeCancelBtn) {
    customTypeCancelBtn.onclick = function() {
      if (customTypeModal) customTypeModal.style.display = 'none';
      // Focus back on custom input
      if (customRequestTypeInput) {
        customRequestTypeInput.focus();
      }
    };
  }

  if (customTypeProceedBtn) {
    customTypeProceedBtn.onclick = function() {
      if (customTypeModal) customTypeModal.style.display = 'none';

      // Submit the form with custom type
      if (serviceRequestForm) {
        // Create hidden input for custom type flag
        const customTypeFlag = document.createElement('input');
        customTypeFlag.type = 'hidden';
        customTypeFlag.name = 'isCustomType';
        customTypeFlag.value = 'true';
        serviceRequestForm.appendChild(customTypeFlag);

        // Submit the form
        serviceRequestForm.submit();
      }
    };
  }

  // Close modal when clicking outside
  window.onclick = function(event) {
    if (event.target === customTypeModal) {
      customTypeModal.style.display = 'none';
    }
  };
});

// Function to get all link values (moved outside DOMContentLoaded for global access)
function getLinkValues() {
  const linksContainer = document.getElementById('linksContainer');
  const linkInputs = linksContainer.querySelectorAll('input[type="url"]');
  const links = [];
  linkInputs.forEach(input => {
    const value = input.value.trim();
    if (value) {
      links.push(value);
    }
  });
  return links;
}

