    function createServiceRevisionEntry(revision, index, total) {
        console.log('[Service] Creating revision entry:', revision);
        
        const entry = document.createElement('div');
        
        const isUnitAction = revision.requestedBy || 
                             (revision.type === 'deliverable_submitted' || 
                              revision.type === 'completed' ||
                              revision.type === 'message');
        const isRequestorAction = revision.respondedBy || 
                                  (revision.type === 'revision_requested' && !revision.requestedBy) ||
                                  (revision.type === 'message' && !revision.requestedBy) ||
                                  revision.type === 'initial';
        
        entry.className = `revision-conversation-item ${isUnitAction ? 'unit-action' : 'requestor-action'}`;
        
        const timestamp = new Date(revision.requestedAt || revision.respondedAt);
        const fullDate = timestamp.toLocaleString('en-US', {
            weekday: 'long',
            month: 'long',
            day: 'numeric',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: true
        });
        
        const now = new Date();
        const diffMs = now - timestamp;
        const diffMins = Math.floor(diffMs / 60000);
        const diffHours = Math.floor(diffMs / 3600000);
        const diffDays = Math.floor(diffMs / 86400000);
        
        let relativeTime = '';
        if (diffMins < 1) relativeTime = 'Just now';
        else if (diffMins < 60) relativeTime = `${diffMins} minute${diffMins > 1 ? 's' : ''} ago`;
        else if (diffHours < 24) relativeTime = `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;
        else relativeTime = `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;
        
        let typeLabel = '';
        let badgeClass = '';
        
        if (revision.type === 'deliverable_submitted') {
            typeLabel = 'Deliverables Uploaded';
            badgeClass = 'badge-resubmitted';
        } else if (revision.type === 'approved_by_requestor') {
            typeLabel = '✓ Approved';
            badgeClass = 'badge-approved';
        } else if (revision.type === 'completed') {
            typeLabel = '✓ Completed';
            badgeClass = 'badge-approved';
        } else if (revision.type === 'revision_requested') {
            typeLabel = 'Revision Requested';
            badgeClass = 'badge-revision';
        } else if (revision.type === 'message') {
            typeLabel = 'Message';
            badgeClass = 'badge-revision';
        } else if (revision.type === 'initial') {
            typeLabel = 'Initial Request';
            badgeClass = 'badge-revision';
        } else {
            typeLabel = 'Update';
            badgeClass = 'badge-revision';
        }
        
        let authorName = 'Unknown';
        let authorUnit = '';
        
        if (revision.requestedBy) {
            if (typeof revision.requestedBy === 'object' && revision.requestedBy.fName) {
                authorName = `${revision.requestedBy.fName} ${revision.requestedBy.lName}`;
                if (revision.requestedBy.unitTeam && revision.requestedBy.unitTeam !== 'N/A') {
                    authorUnit = ` (${revision.requestedBy.unitTeam} Unit)`;
                } else {
                    authorUnit = ' (User)';
                }
            }
        } else if (revision.respondedBy) {
            if (typeof revision.respondedBy === 'object' && revision.respondedBy.fName) {
                authorName = `${revision.respondedBy.fName} ${revision.respondedBy.lName}`;
                authorUnit = ' (User)';
            }
        } else if (revision.type === 'initial' && revision.by) {
            authorName = revision.by;
            authorUnit = ' (User)';
        }
        
        const isLast = index === total - 1;
        let statusIndicator = '';
        
        if (revision.type === 'completed') {
            statusIndicator = `
                <div class="status-indicator approved">
                    <svg width="16" height="16" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="8 12 11 15 16 9"/>
                    </svg>
                    <span style="color: #10b981; font-weight: 600;">Service Request Completed!</span>
                </div>
            `;
        } else if (revision.type === 'approved_by_requestor') {
            statusIndicator = `
                <div class="status-indicator approved">
                    <svg width="16" height="16" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="8 12 11 15 16 9"/>
                    </svg>
                    <span style="color: #10b981; font-weight: 600;">Approved - Awaiting Unit Completion</span>
                </div>
            `;
        } else if (isLast) {
            if (isUnitAction) {
                statusIndicator = `
                    <div class="status-indicator waiting">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                        Review the deliverables below
                    </div>
                `;
            } else {
                statusIndicator = `
                    <div class="status-indicator under-review">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                        Unit is reviewing your feedback
                    </div>
                `;
            }
        }
        
        const content = revision.type === 'message' ? 
            (revision.revisionNotes || revision.responseNotes || 'Message') :
            revision.type === 'initial' ?
            (revision.description || 'Initial request submitted') :
            (isUnitAction ? 
                (revision.revisionNotes || 'Deliverables submitted') : 
                (revision.responseNotes || 'Revision requested'));
        
        const files = revision.deliverableFiles || revision.responseFiles || [];
        
        // Show revision number for completed entries, otherwise just sequential number
        const badgeNumber = (revision.type === 'completed' && revision.revisionNumber > 0) 
            ? `REV #${revision.revisionNumber}` 
            : `#${index + 1}`;
        
        entry.innerHTML = `
            <div class="revision-number-badge">${badgeNumber}</div>
            <div class="revision-message-bubble">
                <div class="revision-bubble-header">
                    <div>
                        <span class="revision-author">${escapeHtml(authorName)}${escapeHtml(authorUnit)}</span>
                        <span class="revision-badge ${badgeClass}" style="margin-left: 0.5rem;">${typeLabel}</span>
                    </div>
                    <div class="revision-timestamp">
                        <span style="font-weight: 600; color: #1e293b;">${fullDate}</span>
                        <span style="font-size: 0.75rem; color: #94a3b8;">${relativeTime}</span>
                    </div>
                </div>
                
                <div class="message-content-section">
                    <div class="content-label">${revision.type === 'message' ? 'MESSAGE:' : revision.type === 'initial' ? 'REQUEST:' : (isUnitAction ? 'UNIT UPDATE:' : 'YOUR FEEDBACK:')}</div>
                    <div class="content-text">${displayFormattedText(content)}</div>
                </div>
                
                ${files && files.length > 0 ? `
                    <div class="message-attachments-section">
                        <div class="attachments-header">
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                            </svg>
                            <span class="attachments-count">${files.length} file${files.length > 1 ? 's' : ''} attached</span>
                        </div>
                        <div class="attachments-grid">
                            ${files.map(file => createRevisionFileCard(file)).join('')}
                        </div>
                    </div>
                ` : ''}
                
                ${statusIndicator}
            </div>
        `;
        
        return entry;
    }

    function displayFormattedText(text) {
        if (!text) return '';
        
        // Check if the text is already HTML (from Quill editor)
        // Quill outputs HTML like <p>text</p>, <strong>bold</strong>, etc.
        if (text.includes('<p>') || text.includes('<strong>') || text.includes('<em>') || text.includes('<u>')) {
            // It's HTML content from Quill, return as-is
            return text;
        }
        
        // It's plain text, escape HTML first
        let formatted = escapeHtml(text);
        
        // Bold: **text** -> <strong>text</strong>
        formatted = formatted.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        
        // Italic: *text* -> <em>text</em> (but not ** which is bold)
        formatted = formatted.replace(/(?<!\*)\*([^*]+)\*(?!\*)/g, '<em>$1</em>');
        
        // Underline: __text__ -> <u>text</u>
        formatted = formatted.replace(/__([^_]+)__/g, '<u>$1</u>');
        
        // Preserve line breaks
        formatted = formatted.replace(/\n/g, '<br>');
        
        return formatted;
    }

    // Helper function to truncate long filenames intelligently
    function truncateFilename(filename, maxLength = 50) {
        if (!filename || filename.length <= maxLength) return filename;
        
        const ext = filename.split('.').pop();
        const nameWithoutExt = filename.substring(0, filename.lastIndexOf('.'));
        const availableLength = maxLength - ext.length - 4; // 4 for "...."
        
        if (availableLength < 10) {
            // Very short limit, just show start and extension
            return nameWithoutExt.substring(0, 10) + '...' + ext;
        }
        
        // Show start and end of filename with ellipsis in middle
        const startLength = Math.ceil(availableLength * 0.6);
        const endLength = Math.floor(availableLength * 0.4);
        
        return nameWithoutExt.substring(0, startLength) + '...' + nameWithoutExt.substring(nameWithoutExt.length - endLength) + '.' + ext;
    }

    function createRevisionFileCard(file) {
        console.log('📁 [ServiceRequest] Creating file card for:', file);
        const filename = typeof file === 'string' ? file : (file.filename || file.name || file);
        const displayName = typeof file === 'object' ? (file.originalname || file.filename || file.name) : file;
        const truncatedName = truncateFilename(displayName, 45);
        const ext = filename.split('.').pop().toLowerCase();
        const isImage = ['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext);
        const isPDF = ext === 'pdf';
        console.log('📁 [ServiceRequest] File details:', { filename, displayName, ext, isImage, isPDF });
        
        // Extract timestamp from filename if present (format: upload-timestamp-randomnumber.ext)
        let uploadDate = '';
        const timestampMatch = filename.match(/upload-?(\d{13})/);
        console.log('📅 [ServiceRequest] Timestamp extraction:', {
            filename,
            timestampMatch,
            hasMatch: !!timestampMatch,
            extractedTimestamp: timestampMatch ? timestampMatch[1] : null
        });
        if (timestampMatch) {
            const timestamp = parseInt(timestampMatch[1]);
            const date = new Date(timestamp);
            uploadDate = date.toLocaleString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
            console.log('✅ [ServiceRequest] Extracted date:', uploadDate);
        } else {
            console.log('⚠️ [ServiceRequest] No timestamp match found in filename');
        }
        
        let iconColor = '#64748b';
        if (isImage) iconColor = '#059669';
        else if (isPDF) iconColor = '#dc2626';
        else if (['doc', 'docx'].includes(ext)) iconColor = '#2563eb';
        else if (['xls', 'xlsx'].includes(ext)) iconColor = '#16a34a';
        
        return `
            <div class="revision-file-card">
                <div class="revision-file-icon" style="background: ${iconColor}20; color: ${iconColor};">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="4" y="4" width="16" height="16" rx="2"/>
                        <line x1="8" y1="8" x2="16" y2="8"/>
                        <line x1="8" y1="12" x2="16" y2="12"/>
                    </svg>
                </div>
                <div class="revision-file-info">
                    <div class="revision-file-name" title="${escapeHtml(displayName)}">${escapeHtml(truncatedName)}</div>
                    <div class="revision-file-size">${ext.toUpperCase()}${uploadDate ? ` • ${uploadDate}` : ''}</div>
                </div>
                <div class="revision-file-actions">
                    ${isImage ? `
                    <button onclick="viewImage('/uploads/${filename}', '${escapeHtml(displayName)}')" class="revision-file-btn" title="View Image" style="border: none; background: none; cursor: pointer; padding: 0; margin-right: 8px;">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                    ` : isPDF ? `
                    <button onclick="viewPdf('/uploads/${filename}', '${escapeHtml(displayName)}')" class="revision-file-btn" title="View PDF" style="border: none; background: none; cursor: pointer; padding: 0; margin-right: 8px;">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                    ` : `
                    <button onclick="viewFile('/uploads/${filename}', '${escapeHtml(displayName)}')" class="revision-file-btn" title="View File" style="border: none; background: none; cursor: pointer; padding: 0; margin-right: 8px;">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                    `}
                    <a href="/uploads/${filename}" download="${escapeHtml(displayName)}" class="revision-file-btn" title="Download">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                    </a>
                </div>
            </div>
        `;
    }

    async function handleServiceRevision() {
        if (!serviceRevisionQuill || !currentConversationId) {
            console.error('[Service] Quill or request ID not found');
            return;
        }
        
        const revisionText = serviceRevisionQuill.root.innerHTML;
        const revisionTextPlain = serviceRevisionQuill.getText().trim();
        
        // Validate revision text
        if (!revisionText || revisionText.trim() === '<p><br></p>' || revisionTextPlain === '') {
            if (typeof window.showAlert === 'function') {
                window.showAlert('error', 'Please describe what needs to be revised before submitting.');
            } else {
                alert('Please describe what needs to be revised before submitting.');
            }
            return;
        }
        
        // Get file input
        const filesInput = document.getElementById('serviceRevisionFiles');
        const formData = new FormData();
        formData.append('revisionNotes', revisionText);
        
        // Add files if any
        if (filesInput && filesInput.files.length > 0) {
            for (let i = 0; i < filesInput.files.length; i++) {
                formData.append('revisionFiles', filesInput.files[i]);
            }
        }
        
        console.log('[Service] Submitting revision for request:', currentConversationId);
        console.log('[Service] Revision text (HTML):', revisionText);
        console.log('[Service] Revision text (plain):', revisionTextPlain);
        console.log('[Service] Files count:', filesInput && filesInput.files.length || 0);
        
        try {
            const response = await fetch(`/user/service/request-revision/${currentConversationId}`, {
                method: 'POST',
                body: formData
            });
            
            console.log('[Service] Response status:', response.status);
            const result = await response.json();
            console.log('[Service] Response:', result);
            
            if (response.ok && result.success) {
                if (typeof window.showAlert === 'function') {
                    window.showAlert('success', result.message || 'Revision request submitted successfully!');
                } else {
                    alert(result.message || 'Revision request submitted successfully!');
                }
                
                // Clear form
                serviceRevisionQuill.setContents([]);
                if (filesInput) filesInput.value = '';
                
                // Reload revision history
                await loadServiceRevisionHistory(currentConversationId);
                
                // Close modal and refresh page
                setTimeout(() => {
                    document.getElementById('detailsModal').style.display = 'none';
                    location.reload();
                }, 1500);
            } else {
                if (typeof window.showAlert === 'function') {
                    window.showAlert('error', result.message || 'Failed to submit revision request. Please try again.');
                } else {
                    alert(result.message || 'Failed to submit revision request. Please try again.');
                }
            }
        } catch (error) {
            console.error('[Service] Error submitting revision:', error);
            if (typeof window.showAlert === 'function') {
                window.showAlert('error', 'An error occurred while submitting your revision request.');
            } else {
                alert('An error occurred while submitting your revision request.');
            }
        }
    }

    // Toggle service revision form visibility
    function toggleServiceRevisionForm() {
      const serviceRevisionSection = document.getElementById('serviceRevisionFormSection');
      const toggleBtn = document.getElementById('showServiceRevisionFormBtn');
      const toggleText = document.getElementById('revisionFormToggleText');

      if (!serviceRevisionSection) {
        console.error('[Service] Service revision section not found');
        return;
      }

      const isVisible = serviceRevisionSection.style.display === 'block';

      if (isVisible) {
        serviceRevisionSection.style.display = 'none';
        if (toggleText) toggleText.textContent = 'Request Revision';
        if (toggleBtn) toggleBtn.style.background = 'linear-gradient(135deg, #f59e0b 0%, #d97706 100%)';
      } else {
        serviceRevisionSection.style.display = 'block';
        if (toggleText) toggleText.textContent = 'Hide Revision Form';
        if (toggleBtn) toggleBtn.style.background = 'linear-gradient(135deg, #ef4444 0%, #dc2626 100%)';

        if (!serviceRevisionQuill) {
          serviceRevisionQuill = new Quill('#serviceRevisionEditor', {
            theme: 'snow',
            placeholder: 'Describe what needs to be revised or improved... ',
            modules: {
              toolbar: [
                ['bold', 'italic', 'underline'],
                [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                ['link'],
                ['clean']
              ]
            }
          });
        }

        setTimeout(() => {
          serviceRevisionSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 100);
      }
    }

    // Expose service revision functions to global scope
    window.handleServiceRevision = handleServiceRevision;
    window.toggleServiceRevisionForm = toggleServiceRevisionForm;

    // Handle marking service as complete (accept deliverables)
    async function handleMarkServiceComplete() {
        if (!currentConversationId) {
            console.error('[Service] Request ID not found');
            return;
        }
        
        // Confirm action
        if (!confirm('Are you sure you want to approve these deliverables? The unit will then finalize the task.')) {
            return;
        }
        
        try {
            const response = await fetch(`/user/service/mark-complete/${currentConversationId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });
            
            const result = await response.json();
            
            if (result.success) {
                showAlert('success', result.message || 'Deliverables approved successfully!');
                
                // Hide action buttons after approval
                const actionButtons = document.getElementById('serviceActionButtons');
                if (actionButtons) actionButtons.style.display = 'none';
                
                // Close modal and refresh page
                setTimeout(() => {
                    document.getElementById('detailsModal').style.display = 'none';
                    location.reload();
                }, 1500);
            } else {
                showAlert('error', result.message || 'Failed to approve deliverables. Please try again.');
            }
        } catch (error) {
            console.error('[Service] Error marking as complete:', error);
            showAlert('error', 'An error occurred while marking the service as complete.');
        }
    }
  </script>
</body>
</html>
