    async function loadConversation(serviceRequestId) {
      try {
        const response = await fetch(`/api/conversation/${serviceRequestId}`);
        const conversation = await response.json();
        
        // Handle archived/deleted requests (410 Gone status)
        if (response.status === 410 || conversation.archived) {
          if (messagesContainer) {
            messagesContainer.innerHTML = `
              <div style="display: flex; align-items: center; justify-content: center; height: 200px; color: #64748b;">
                <div style="text-align: center;">
                  <div style="font-size: 2rem; margin-bottom: 1rem;">🗂️</div>
                  <p><strong>This request has been archived</strong></p>
                  <small style="display: block; margin-top: 0.5rem;">An administrator has archived this request. You can request restoration by providing a reason below.</small>
                </div>
              </div>
            `;
          }
          // Disable message form and show restoration option
          const messageForm = document.getElementById('conversationForm');
          if (messageForm) messageForm.style.display = 'none';
          const restorationSection = document.getElementById('requestRestorationForm') || document.getElementById('resubmissionFormSection');
          if (restorationSection && restorationSection.style) {
            restorationSection.style.display = 'block';
          }
          return;
        }
        
        if (messagesContainer) messagesContainer.innerHTML = '';
        
        if (conversation.conversation && conversation.conversation.length > 0) {
          conversation.conversation.forEach(message => {
            addMessageToUI(message);
          });
          
          await fetch(`/api/conversation/${serviceRequestId}/mark-read`, {
            method: 'POST'
          });
        } else {
          if (messagesContainer) messagesContainer.innerHTML = `
            <div style="display: flex; align-items: center; justify-content: center; height: 200px; color: #64748b;">
              <div style="text-align: center;">
                <div style="font-size: 2rem; margin-bottom: 1rem;">💭</div>
                <p>No messages yet</p>
                <small>Start the conversation by sending a message below</small>
              </div>
            </div>
          `;
        }
        
        if (messagesContainer) messagesContainer.scrollTop = messagesContainer.scrollHeight;
      } catch (error) {
        console.error('Error loading conversation:', error);
        if (messagesContainer) messagesContainer.innerHTML = '<p style="color: red;">Error loading conversation</p>';
      }
    }

    function addMessageToUI(message) {
      if (!messagesContainer) return;
      
      // Clear empty state container if it exists
      const emptyStateDiv = messagesContainer.querySelector('.unit-messages-empty');
      if (emptyStateDiv) {
        emptyStateDiv.remove();
      }
      
      const messageDiv = document.createElement('div');
      const senderName = message.senderName || 'Unknown';
      
      // Determine if this is the current user's message (name-based comparison)
      const isOwnMessage = window.currentUserFullName && senderName === window.currentUserFullName;
      
      // Role-based styling
      let roleClass = 'user-message';
      let roleColor = '#e0f2fe'; // Light blue for users
      
      if (isOwnMessage) {
        roleClass = 'own-message';
        roleColor = '#ffffff'; // White for own messages
      } else if (message.senderRole === 'admin') {
        roleClass = 'admin-message';
        roleColor = '#fecaca'; // Light red for admin
      } else if (message.senderRole === 'unit') {
        roleClass = 'unit-message';
        roleColor = '#bbf7d0'; // Light green for unit
      } else if (message.senderRole === 'user') {
        roleClass = 'user-message';
        roleColor = '#e0f2fe'; // Light blue for users
      }
      
      // Add alignment class
      messageDiv.className = `unit-message-item ${isOwnMessage ? 'message-right' : 'message-left'}`;
      
      const time = new Date(message.timestamp).toLocaleString('en-US', {
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
      
      // Handle attachments
      let attachmentsHTML = '';
      if (message.file_path) {
        const isImage = message.file_type && message.file_type.startsWith('image/');
        const fileName = message.original_filename || 'File';
        
        if (isImage) {
          attachmentsHTML = `
            <div class="message-attachment">
              <img src="${message.file_path}" 
                   style="max-width: 200px; max-height: 150px; border-radius: 0.375rem; cursor: pointer; border: 1px solid #e5e7eb;" 
                   onclick="openImageModal('${message.file_path}')"
                   alt="${fileName}">
            </div>
          `;
        } else {
          attachmentsHTML = `
            <div class="message-attachment">
              <div class="message-attachment-icon" style="color: #64748b;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="4" y="4" width="16" height="16" rx="2"/>
                  <line x1="8" y1="8" x2="16" y2="8"/>
                  <line x1="8" y1="12" x2="16" y2="12"/>
                  <line x1="8" y1="16" x2="12" y2="16"/>
                </svg>
              </div>
              <div class="message-attachment-info">
                <div class="message-attachment-name">${escapeHtml(fileName)}</div>
              </div>
              <div class="message-attachment-actions">
                <a href="${message.file_path}" download="${fileName}" class="attachment-action-btn" title="Download">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                  </svg>
                </a>
              </div>
            </div>
          `;
        }
      }
      
      // Build read receipts display
      let readReceiptsHTML = '';
      if (message.readBy && message.readBy.length > 0 && isOwnMessage) {
        const readers = message.readBy
          .filter(r => r.userId && r.userId.fName)
          .map(r => `${r.userId.fName} ${r.userId.lName}`)
          .join(', ');
        if (readers) {
          readReceiptsHTML = `
            <div class="message-read-receipt">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Seen by ${readers}</span>
            </div>
          `;
        }
      }
      
      messageDiv.innerHTML = `
        <div class="unit-message-bubble ${roleClass}" style="background: ${roleColor};">
          <div class="message-header">
            <strong>${escapeHtml(senderName)} <span style="font-size: 0.75rem; opacity: 0.7;">(${message.senderRole})</span></strong>
            <span class="message-time">${time}</span>
          </div>
          <div class="message-content">${formatText(message.content || '')}</div>
          ${attachmentsHTML}
          ${readReceiptsHTML}
        </div>
      `;
      
      messagesContainer.appendChild(messageDiv);
    }

    if (sendMessageBtn) {
      sendMessageBtn.onclick = async function() {
        const content = messageInput ? messageInput.value.trim() : '';
        if (!content && !currentAttachment) return;
        if (!currentConversationId) return;

        try {
          let response;
          
          if (currentAttachment) {
            // Send with file attachment using FormData
            const formData = new FormData();
            formData.append('content', content || ''); // Always include content field
            formData.append('file', currentAttachment.file);
            
            response = await fetch(`/api/conversation/${currentConversationId}/message`, {
              method: 'POST',
              body: formData
            });
          } else {
            // Send text only using JSON
            response = await fetch(`/api/conversation/${currentConversationId}/message`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({ content })
            });
          }

          const result = await response.json();
          
          if (result.success) {
            addMessageToUI(result.message);
            if (messageInput) messageInput.value = '';
            
            // Clear attachment
            if (currentAttachment) {
              currentAttachment = null;
              if (attachmentPreview) attachmentPreview.style.display = 'none';
              if (imageUpload) imageUpload.value = '';
              if (fileUpload) fileUpload.value = '';
              if (imagePreviewContainer) imagePreviewContainer.style.display = 'none';
            }
            
            if (messagesContainer) messagesContainer.scrollTop = messagesContainer.scrollHeight;
          } else {
            throw new Error(result.error || 'Failed to send message');
          }
        } catch (error) {
          console.error('Error sending message:', error);
          alert('Failed to send message: ' + error.message);
        }
      };
    }

    if (messageInput) {
      messageInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
