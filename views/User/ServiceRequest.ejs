/* Message Styles */
.message {
  margin-bottom: 1rem;
  max-width: 80%;
}

.admin-message {
  margin-right: auto;
}

.user-message {
  margin-left: auto;
}

.message-content {
  padding: 0.75rem;
  border-radius: 0.5rem;
  background: white;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
}

.user-message .message-content {
  background: var(--primary-green);
  color: white;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
  font-size: 0.875rem;
}

.message-time {
  opacity: 0.7;
  font-size: 0.75rem;
}

.message-text {
  word-wrap: break-word;
}

/* Checkbox Container */
.checkbox-container {
  padding: 1rem;
  border-radius: 0.75rem;
  background: linear-gradient(145deg, #f8fdf9, #f0f9f1);
  border: 2px solid #d1fae5;
  transition: all 0.3s ease;
  cursor: pointer;
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

.checkbox-container:hover {
  background: linear-gradient(145deg, #f0f9f1, #e8f5e9);
  border-color: #a7f3d0;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.15);
}

.checkbox-container input[type="checkbox"] {
  accent-color: var(--primary-green);
  width: 1.25rem;
  height: 1.25rem;
  margin: 0;
  flex-shrink: 0;
}

.checkbox-text {
  flex: 1;
  font-weight: 500;
  color: #065f46;
}

.checkbox-description {
  margin-top: 0.5rem;
  color: #6b7280;
  font-size: 0.875rem;
  font-style: italic;
}

/* Enhanced File Upload */
.file-upload-group {
  position: relative;
  border: 2px dashed #cbd5e1;
  border-radius: 12px;
  padding: 2rem;
  text-align: center;
  background: linear-gradient(135deg, #fefefe, #f8fafc);
  transition: all 0.3s ease;
  cursor: pointer;
  min-height: 120px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.file-upload-group:hover {
  border-color: var(--primary-green);
  background: linear-gradient(135deg, #f0fdf4, #f7fee7);
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(64, 139, 78, 0.1);
}

.file-upload-group.has-file {
  border-color: var(--primary-green);
  background: linear-gradient(135deg, #f0fdf4, #f7fee7);
  border-style: solid;
}

.file-upload-group.dragover {
