  <!-- Main JavaScript -->
  <script>
    // ==================================
    // HELPER FUNCTIONS FOR CONVERSATION
    // ==================================
    
    // Helper function to escape HTML
    window.escapeHtml = function(text) {
      if (!text) return '';
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // Helper function to format text with markdown-style syntax
    window.formatText = function(text) {
      if (!text) return '';
      
      // Escape HTML first
      let formatted = window.escapeHtml(text);
      
      // Bold: **text** -> <strong>text</strong>
      formatted = formatted.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      
      // Italic: *text* -> <em>text</em> (but not ** which is bold)
      formatted = formatted.replace(/(?<!\*)\*([^*]+)\*(?!\*)/g, '<em>$1</em>');
      
      // Underline: __text__ -> <u>text</u>
      formatted = formatted.replace(/__([^_]+)__/g, '<u>$1</u>');
      
      // Preserve line breaks
      formatted = formatted.replace(/\n/g, '<br>');
      
      return formatted;
    }

    // PDF viewer modal functions
    window.viewPdf = function(pdfUrl, fileName) {
      const modal = document.getElementById('pdfViewerModal');
      const title = document.getElementById('pdfViewerTitle');
      const iframe = document.getElementById('pdfViewerFrame');
      
      if (modal && iframe) {
        // Check if PDF exists first
        fetch(pdfUrl, { method: 'HEAD' })
          .then(response => {
            if (response.ok) {
              title.textContent = fileName;
              iframe.src = pdfUrl;
              modal.style.display = 'flex';
              modal.style.zIndex = '999999'; // Ensure on top
            } else {
              if (typeof window.showAlert === 'function') {
                window.showAlert('error', 'PDF file not found. It may have been moved or deleted.');
              } else {
                alert('PDF file not found. It may have been moved or deleted.');
              }
            }
          })
          .catch(error => {
            if (typeof window.showAlert === 'function') {
              window.showAlert('error', 'Error accessing PDF: ' + error.message);
            } else {
              alert('Error accessing PDF: ' + error.message);
            }
          });
      }
    };

    window.closePdfViewer = function() {
      const modal = document.getElementById('pdfViewerModal');
      const iframe = document.getElementById('pdfViewerFrame');
      
      if (modal) {
        modal.style.display = 'none';
        if (iframe) {
          iframe.src = '';
        }
      }
    };

    // Image viewer modal functions
    window.viewImage = function(imageUrl, fileName) {
      const modal = document.getElementById('imageViewerModal');
