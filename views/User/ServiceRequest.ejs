  .filter-input {
    font-size: 0.875rem;
    padding: 0.5rem 0.75rem;
  }

  .select-dropdown {
    font-size: 0.875rem;
  }

  /* Table section */
  .table-section {
    padding: 0.5rem;
    overflow-x: auto;
  }

  table {
    font-size: 0.813rem;
  }

  th, td {
    padding: 0.5rem 0.25rem;
  }

  /* Buttons */
  .chat-btn-enhanced,
  .download-btn-enhanced {
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
  }

  .browse-file-btn {
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
  }

  /* Modal actions */
  .modal-actions {
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem 0;
  }

  .modal-actions button {
    width: 100%;
  }

  /* Status badges */
  .status-badge-large {
    font-size: 0.75rem;
    padding: 0.375rem 0.75rem;
  }

  .deadline-badge-large {
    font-size: 0.75rem;
    padding: 0.375rem 0.75rem;
  }

  .revision-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
  }

  /* Checkbox container */
  .checkbox-container {
    padding: 0.75rem;
  }

  .checkbox-text {
    font-size: 0.875rem;
  }

  .checkbox-description {
    font-size: 0.75rem;
  }

  /* Message styles */
  .message-content {
    padding: 0.75rem;
  }

  .message-text {
    font-size: 0.875rem;
  }

  .message-time {
    font-size: 0.75rem;
  }
}

/* Small mobile devices */
@media (max-width: 480px) {
  .modal-content {
    max-width: 100%;
    margin: 0;
    border-radius: 0;
    min-height: 100vh;
  }

  .unit-modal-wide {
    max-width: 100%;
    margin: 0;
    border-radius: 0;
  }

  .modal-header {
    padding: 0.75rem;
  }

  .modal-title {
    font-size: 1.1rem;
  }

  .unit-modal-body {
    padding: 0.75rem;
  }

  .modal-form {
    padding: 0.5rem;
    gap: 0.5rem;
  }

  .details-section,
  .description-section,
  .enhanced-file-preview,
  .requestor-revision-section,
  .requestor-resubmission-section {
    padding: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .details-section h3,
  .description-section h3 {
    font-size: 0.938rem;
  }

  .filter-section {
    padding: 0.5rem;
  }

  .select-dropdown {
    max-height: 200px;
  }

  .options-container {
    max-height: 150px;
  }

  table {
    font-size: 0.75rem;
  }

  th, td {
    padding: 0.375rem 0.25rem;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    font-size: 0.813rem;
  }

  .file-upload-group {
    padding: 1rem 0.75rem;
  }

  .upload-icon {
    font-size: 1.75rem;
  }
}

/* Filter styles */
.filter-input {
  min-height: 2.5rem;
  box-sizing: border-box;
}

.enhanced-multi-select-wrapper {
  width: 100%;
  min-width: 200px;
}

/* Scrollbar styling */
.modal-body::-webkit-scrollbar {
  width: 8px;
}

.modal-body::-webkit-scrollbar-track {
  background: #f1f5f9;
  border-radius: 4px;
}

.modal-body::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 4px;
}

.modal-body::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

.selected-files-container::-webkit-scrollbar {
  width: 6px;
}

.selected-files-container::-webkit-scrollbar-track {
  background: #f1f5f9;
  border-radius: 3px;
}

.selected-files-container::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 3px;
}

.selected-files-container::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* ========================================
   UNIT TWO-COLUMN MODAL LAYOUT (shared)
   Matches allRequestsUser/admin modal layout
   ======================================== */

.unit-modal-body {
  display: grid !important;
  grid-template-columns: 1fr 700px !important;
  gap: 2rem !important;
  padding: 2rem !important;
  max-height: calc(95vh - 120px) !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
  scroll-behavior: smooth !important;
}

.unit-left-column,
.unit-right-column {
  overflow: visible !important;
  min-height: 0 !important;
}

.unit-left-column {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  min-height: fit-content;
}

.unit-right-column {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  min-height: fit-content;
}

@media (max-width: 1400px) {
  .unit-modal-body {
    grid-template-columns: 1fr !important;
    gap: 1.5rem !important;
  }
}

/* Revision Section Styles */
.requestor-revision-section {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 1.5rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  width: 45rem;
}

.requestor-section-header h3 {
  margin: 0 0 1.25rem 0;
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--primary-green);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
}

/* Revision History Timeline (matching unit side) */
.revision-history-timeline {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-top: 1rem;
}

.revision-conversation-item {
  display: flex;
  flex-direction: column;
  position: relative;
}

.revision-conversation-item.unit-action {
  padding-left: 4rem;
}

.revision-conversation-item.requestor-action {
  padding-right: 4rem;
  align-items: flex-end;
}

.revision-number-badge {
  position: absolute;
  left: 0;
  top: 0;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.875rem;
  color: white;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.revision-conversation-item.unit-action .revision-number-badge {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  left: 0;
}

.revision-conversation-item.requestor-action .revision-number-badge {
  background: linear-gradient(135deg, var(--primary-green), #059669);
  right: 0;
  left: auto;
}

.revision-message-bubble {
  background: white;
  border-radius: 12px;
  padding: 1.25rem;
  border: 1px solid #e5e7eb;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  max-width: 100%;
}

.revision-conversation-item.unit-action .revision-message-bubble {
  border-left: 3px solid #3b82f6;
}

.revision-conversation-item.requestor-action .revision-message-bubble {
  border-left: 3px solid var(--primary-green);
}

.revision-bubble-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.75rem;
  gap: 1rem;
}

.revision-author {
  font-weight: 600;
  color: #1f2937;
  font-size: 0.95rem;
}

.revision-timestamp {
  font-size: 0.8rem;
  color: #6b7280;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.message-content-section {
  margin-top: 0.75rem;
}

.content-label {
  font-size: 0.75rem;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 0.5rem;
}

.content-text {
  color: #374151;
  line-height: 1.6;
  font-size: 0.925rem;
}

.message-attachments-section {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid #e5e7eb;
}

.attachments-header {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #6b7280;
  margin-bottom: 0.75rem;
}

.attachments-grid {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: 1fr;
}

/* Resubmission Form Styles */
.requestor-resubmission-section {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 1.5rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.form-group {
  margin-bottom: 1.5rem;
}

.form-group label {
  font-weight: 600;
  font-size: 0.875rem;
  color: #374151;
  margin-bottom: 0.5rem;
  display: block;
}

#resubmissionEditor,
#serviceRevisionEditor {
  border: 1px solid #e5e7eb;
  border-radius: 8px;
}

.form-group input[type="file"] {
  display: block;
  width: 100%;
  padding: 20px;
  border: 2px dashed #cbd5e1;
  border-radius: 12px;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 14px;
  color: #475569;
  font-weight: 500;
  text-align: center;
}

.form-group input[type="file"]:hover {
  border-color: #3b82f6;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  border-style: solid;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
}

.form-group input[type="file"]:focus {
  outline: none;
  border-color: #3b82f6;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1), 0 4px 12px rgba(59, 130, 246, 0.2);
}

.form-group input[type="file"]::file-selector-button {
  padding: 10px 20px;
  margin-right: 12px;
  border: none;
  border-radius: 8px;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: white;
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.form-group input[type="file"]::file-selector-button:hover {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  transform: translateY(-1px);
  box-shadow: 0 4px 8px rgba(37, 99, 235, 0.3);
}

.file-list {
  margin-top: 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.resubmission-actions {
  display: flex;
  gap: 1rem;
  margin-top: 1.5rem;
}

.btn-resubmit,
.btn-clarification {
  flex: 1;
  padding: 0.875rem 1.5rem;
  border-radius: 10px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.btn-resubmit {
  background: linear-gradient(135deg, var(--primary-green), #059669);
  color: white;
  box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3);
}

.btn-resubmit:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
}

.btn-clarification {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: white;
  box-shadow: 0 2px 8px rgba(245, 158, 11, 0.3);
}

.btn-clarification:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
}

.status-indicator {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: #fef3c7;
  color: #92400e;
  border-radius: 6px;
  font-size: 0.8125rem;
  font-weight: 600;
  margin-top: 0.75rem;
}

.status-indicator.waiting {
  background: #fef3c7;
  color: #92400e;
}

.status-indicator.under-review {
  background: #dbeafe;
  color: #1e40af;
}

.status-indicator.approved {
  background: #d1fae5;
  color: #065f46;
}

/* Revision File Cards */
.revision-file-card {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  padding: 0.75rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  transition: all 0.2s ease;
}

.revision-file-card:hover {
  background: white;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.revision-file-icon {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 6px;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.revision-file-info {
  flex: 1;
  min-width: 0;
}

.revision-file-name {
  font-weight: 500;
  font-size: 0.875rem;
  color: #1f2937;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.revision-file-size {
  font-size: 0.75rem;
  color: #64748b;
}

.revision-file-actions {
  display: flex;
  gap: 0.25rem;
}

.revision-file-btn {
  padding: 0.5rem 0.75rem;
  border-radius: 6px;
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  border: none;
  display: flex;
  align-items: center;
  gap: 0.25rem;
  background: linear-gradient(135deg, var(--primary-green), #059669);
  color: white;
}

.revision-file-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3);
}

/* Revision History Badge Styles */
.revision-badge {
  display: inline-flex;
  align-items: center;
  padding: 0.25rem 0.75rem;
  border-radius: 12px;
  font-size: 0.75rem;
  font-weight: 600;
  margin-left: 0.5rem;
  text-transform: capitalize;
}

.badge-initial {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #1e40af;
  border: 1px solid #3b82f6;
}

.badge-revision {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #92400e;
  border: 1px solid #f59e0b;
}

.badge-revoked {
  background: linear-gradient(135deg, #fecaca, #fca5a5);
  color: #991b1b;
  border: 1px solid #ef4444;
}

.badge-resubmitted {
  background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
  color: #3730a3;
  border: 1px solid #6366f1;
}

.badge-approved {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  color: #065f46;
  border: 1px solid #10b981;
}

.status-indicator.approved {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  color: #065f46;
  border: 2px solid #10b981;
}

.content-text strong {
  font-weight: 700;
  color: #1f2937;
}

.content-text em {
  font-style: italic;
  color: #4b5563;
}

.content-text u {
  text-decoration: underline;
  text-decoration-color: #6b7280;
  text-underline-offset: 2px;
}

/* Mobile Responsiveness for Requestor Modal */
@media (max-width: 1400px) {
  .requestor-modal-body.two-column {
    grid-template-columns: 1fr 650px !important;
  }
}

@media (max-width: 1024px) {
  .requestor-modal-body.two-column {
    grid-template-columns: 1fr !important;
    gap: 1.5rem !important;
  }
  
  .requestor-right-column {
    display: block !important;
  }
}

.type-badge {
  padding: 0.375rem 0.875rem;
  border-radius: 6px;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
  border: 1.5px solid rgba(255, 255, 255, 0.4);
  white-space: nowrap;
  flex-shrink: 0;
  right: 30rem;
}
</style>
</head>

