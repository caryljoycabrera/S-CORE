        <span class="close" id="closeOnboardingModal">&times;</span>
      </header>
      <div class="modal-body" style="padding: 0;">
        <div id="onboardingContent">
          <!-- Introduction Slide -->
          <div class="onboarding-slide active" data-slide="1">
            <div style="text-align: center; padding: 3rem 2rem;">
              <div style="font-size: 4rem; margin-bottom: 1.5rem; color: var(--primary-green);">
                🎯
              </div>
