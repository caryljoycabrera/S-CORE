  <!-- User Data for JavaScript -->
  <script id="user-data" type="application/json"><%- JSON.stringify({ id: user._id, role: user.role, name: user.fName + ' ' + user.lName, showOnboarding: showOnboarding }) %></script>

  <!-- Unified Notifications Page Script -->
  <script src="/javascripts/notifications-page.js"></script>
  <script>
    // Initialize notifications page with Unit-specific icon configuration
    const notificationsPage = new NotificationsPage({
      containerId: 'notifications-container',
      paginationId: 'pagination',
      pageInfoId: 'page-info',
      prevBtnId: 'prev-btn',
      nextBtnId: 'next-btn',
      markAllReadBtnId: 'mark-all-btn',
      refreshBtnId: 'refresh-btn',
      // Unit-specific: add unit_approved icon
      additionalIcons: {
        'unit_approved': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17,11 19,13 23,9"></polyline></svg>'
      },
      // Unit-specific: hide sender for unit_approved notifications
      hideSenderForTypes: ['user_approved', 'unit_approved'],
      selectionEnabled: true
    });

    // Global functions for inline event handlers
    function previousPage() { notificationsPage.previousPage(); }
    function nextPage() { notificationsPage.nextPage(); }
    function markAsRead(id) { notificationsPage.markAsRead(id); }
    function deleteNotification(id) { notificationsPage.deleteNotification(id); }

    // Direct event handlers for buttons
    document.addEventListener('DOMContentLoaded', () => {
      const markAllBtn = document.getElementById('mark-all-btn');
      const refreshBtn = document.getElementById('refresh-btn');
      
      if (markAllBtn) {
        markAllBtn.onclick = async () => {
          console.log('🔘 Mark All Read clicked');
          try {
            const response = await fetch('/api/notifications/read-all', {
              method: 'PATCH',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' }
            });
            
            if (response.ok) {
              console.log('✅ All notifications marked as read');
              document.querySelectorAll('.notification-page-item.unread').forEach(item => {
                item.classList.remove('unread');
                const markReadBtn = item.querySelector('.notification-page-action-btn.mark-read');
                if (markReadBtn) markReadBtn.remove();
              });
              if (notificationsPage) notificationsPage.loadNotifications();
              if (window.notificationSystem) window.notificationSystem.refreshNotifications();
            } else {
              console.error('❌ Failed:', response.status);
            }
          } catch (error) {
            console.error('❌ Error:', error);
          }
        };
      }
      
      if (refreshBtn) {
        refreshBtn.onclick = () => {
          if (notificationsPage) notificationsPage.loadNotifications();
        };
      }
    });

    // Unit-specific notification click handler with onboarding support
    function handleNotificationClick(notificationId, actionUrl, notificationType) {
      if (notificationType === 'unit_onboarding') {
        const modal = document.getElementById('onboardingModal');
        if (modal) {
          modal.style.display = 'flex';
          currentSlide = 1;
          showSlide(1);
        }
        markAsRead(notificationId);
        return;
      }
      notificationsPage.handleNotificationClick(notificationId, actionUrl, notificationType);
    }

    // Dropdown toggle
    function toggleDropdown() {
      const dropdown = document.getElementById('dropdownMenu');
      dropdown.classList.toggle('show');
    }

    // Close dropdown when clicking outside
    window.addEventListener('click', (e) => {
      if (!e.target.closest('.dropdown-wrapper')) {
        const dropdown = document.getElementById('dropdownMenu');
        if (dropdown) dropdown.classList.remove('show');
      }
    });

    // Sidebar hover effect for desktop
    const sidebar = document.getElementById('unitSidebar');
    if (sidebar) {
      sidebar.addEventListener('mouseenter', function() { this.classList.add('expanded'); });
      sidebar.addEventListener('mouseleave', function() { this.classList.remove('expanded'); });
    }

    // ==========================================
    // UNIT-SPECIFIC: Onboarding Modal Functionality
    // ==========================================
    let currentSlide = 1;
    const totalSlides = 5;

    function initOnboardingModal() {
      const modal = document.getElementById('onboardingModal');
      const closeBtn = document.getElementById('closeOnboardingModal');
      const prevBtn = document.getElementById('prevSlide');
      const nextBtn = document.getElementById('nextSlide');
      const slideIndicators = document.getElementById('slideIndicators');

      if (closeBtn) closeBtn.onclick = () => modal.style.display = 'none';
      if (prevBtn) prevBtn.onclick = () => { if (currentSlide > 1) { currentSlide--; showSlide(currentSlide); } };
      if (nextBtn) nextBtn.onclick = () => {
        if (currentSlide < totalSlides) { currentSlide++; showSlide(currentSlide); }
        else { modal.style.display = 'none'; markOnboardingComplete(); }
      };

      if (slideIndicators) {
        let indicatorsHTML = '';
        for (let i = 1; i <= totalSlides; i++) {
          indicatorsHTML += `<span class="slide-indicator ${i === 1 ? 'active' : ''}" data-slide="${i}"></span>`;
        }
        slideIndicators.innerHTML = indicatorsHTML;
      }

      window.onclick = function(event) { if (event.target === modal) modal.style.display = 'none'; };
    }

    function showSlide(slideNumber) {
      document.querySelectorAll('.onboarding-slide').forEach(slide => slide.classList.remove('active'));
      document.querySelectorAll('.slide-indicator').forEach(indicator => indicator.classList.remove('active'));
      const currentSlideEl = document.querySelector(`[data-slide="${slideNumber}"]`);
      if (currentSlideEl) currentSlideEl.classList.add('active');
      const currentIndicator = document.querySelector(`.slide-indicator[data-slide="${slideNumber}"]`);
      if (currentIndicator) currentIndicator.classList.add('active');
      const prevBtn = document.getElementById('prevSlide');
      const nextBtn = document.getElementById('nextSlide');
      if (prevBtn) prevBtn.style.display = slideNumber === 1 ? 'none' : 'inline-flex';
      if (nextBtn) nextBtn.textContent = slideNumber === totalSlides ? 'Get Started! 🚀' : 'Next →';
      currentSlide = slideNumber;
    }

    async function markOnboardingComplete() {
      try {
        await fetch('/api/user/onboarding-complete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include' });
        console.log('Onboarding marked as complete');
      } catch (error) { console.error('Error marking onboarding complete:', error); }
    }

    // Open announcement detail modal
    async function openAnnouncementDetail(announcementId) {
      try {
        // Fetch announcement details from API
        const response = await fetch(`/api/announcements/${announcementId}`);
        const result = await response.json();
        
        if (!response.ok || !result.success) {
          console.error('Failed to fetch announcement:', result.message);
          return;
        }

        const announcement = result.announcement;

        // Update modal content
        document.getElementById('announcementModalTitle').textContent = announcement.title;
        document.getElementById('announcementModalDate').textContent = new Date(announcement.createdAt).toLocaleDateString('en-US', { 
          month: 'long', 
          day: 'numeric', 
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
        
        // Render HTML content (from Quill editor)
        document.getElementById('announcementModalContent').innerHTML = announcement.content;
        
        document.getElementById('announcementModalFrom').textContent = announcement.sentBy 
          ? `${announcement.sentBy.fName} ${announcement.sentBy.lName}` 
          : 'Admin';
        
        const priorityText = announcement.priority === 'high' ? 'Urgent' : 
                             announcement.priority === 'medium' ? 'Important' : 'Low';
        document.getElementById('announcementModalPriority').textContent = priorityText;
        
        // Show modal
        document.getElementById('announcementDetailModal').style.display = 'flex';
        
        // Mark as read if not already
        if (!announcement.isRead) {
          await fetch(`/api/announcements/${announcementId}/read`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
        }
      } catch (error) {
        console.error('Error opening announcement:', error);
      }
    }

    // Close announcement detail modal
    function closeAnnouncementModal() {
      document.getElementById('announcementDetailModal').style.display = 'none';
    }

    // Close modal when clicking outside
    document.getElementById('announcementDetailModal')?.addEventListener('click', function(e) {
      if (e.target === this) {
        closeAnnouncementModal();
      }
    });

    // Make openAnnouncementDetail available globally
    window.openAnnouncementDetail = openAnnouncementDetail;

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', () => {
      initOnboardingModal();
      const userData = JSON.parse(document.getElementById('user-data').textContent || '{}');
      if (userData.showOnboarding) {
        setTimeout(() => {
          const modal = document.getElementById('onboardingModal');
          if (modal) { modal.style.display = 'flex'; currentSlide = 1; showSlide(1); }
        }, 1000);
      }
    });

    // ═══════════════════════════════════════════════
    // Bulk Delete — Selection Management
    // ═══════════════════════════════════════════════

    let ntDeleteMode = false;

    function ntToggleDeleteMode() {
      ntDeleteMode = !ntDeleteMode;
      const container = document.querySelector('.notifications-page');
      const btn = document.getElementById('ntDeleteToggleBtn');
      if (ntDeleteMode) {
        container.classList.add('nt-delete-mode');
        btn.classList.add('active');
        btn.textContent = 'Cancel';
      } else {
        container.classList.remove('nt-delete-mode');
        btn.classList.remove('active');
        btn.textContent = 'Delete';
        ntClearSelections();
      }
    }

    function ntClearSelections() {
      document.querySelectorAll('.nt-checkbox').forEach(cb => cb.checked = false);
      document.querySelectorAll('.notification-page-item.nt-selected').forEach(el => el.classList.remove('nt-selected'));
      ntUpdateUI();
    }

    function ntUpdateUI() {
      const checkboxes = document.querySelectorAll('.nt-checkbox');
      const checked = document.querySelectorAll('.nt-checkbox:checked');
      const count = checked.length;
      const total = checkboxes.length;
      const countEl = document.getElementById('ntSelectedCount');
      const delBtn = document.getElementById('ntDeleteSelectedBtn');
      const selectAllBtn = document.getElementById('ntSelectAllBtn');
      countEl.textContent = count > 0 ? `${count} selected` : '';
      delBtn.disabled = count === 0;
      if (selectAllBtn) {
        selectAllBtn.style.display = total > 0 && ntDeleteMode ? 'inline-flex' : 'none';
        selectAllBtn.textContent = count === total ? 'Deselect All' : 'Select All';
      }
    }

    // Delegate checkbox change + click-to-select item
    document.addEventListener('change', (e) => {
      if (e.target.classList.contains('nt-checkbox')) {
        const item = e.target.closest('.notification-page-item');
        if (item) item.classList.toggle('nt-selected', e.target.checked);
        ntUpdateUI();
      }
    });

    // Click on notification body toggles checkbox
    document.addEventListener('click', (e) => {
      const item = e.target.closest('.notification-page-item');
      if (item && ntDeleteMode) {
        if (e.target.closest('.nt-action-checkbox') || e.target.closest('.notification-page-item-actions')) return;
        const cb = item.querySelector('.nt-checkbox');
        if (cb) { cb.checked = !cb.checked; cb.dispatchEvent(new Event('change')); }
      }
    });

    function ntToggleSelectAll() {
      const allChecked = document.querySelectorAll('.nt-checkbox:checked').length === document.querySelectorAll('.nt-checkbox').length;
      document.querySelectorAll('.nt-checkbox').forEach(cb => {
        cb.checked = !allChecked;
        const item = cb.closest('.notification-page-item');
        if (item) item.classList.toggle('nt-selected', cb.checked);
      });
      ntUpdateUI();
    }

    function ntShowModal(id) {
      document.getElementById(id).classList.add('show');
      document.body.classList.add('nt-modal-active');
    }

    function ntCloseModal(id) {
      document.getElementById(id).classList.remove('show');
      document.body.classList.remove('nt-modal-active');
    }

    // Close modals on backdrop click
    document.querySelectorAll('.nt-modal-backdrop').forEach(bd => {
      bd.addEventListener('click', (e) => {
        if (e.target === bd) ntCloseModal(bd.id);
      });
    });

    function ntDeleteSelected() {
      const checked = document.querySelectorAll('.nt-checkbox:checked');
      if (checked.length === 0) return;
      document.getElementById('ntDeleteCount').textContent = checked.length;
      ntShowModal('ntDeleteModal');
    }

    async function ntConfirmDeleteSelected() {
      const btn = document.getElementById('ntConfirmDeleteBtn');
      btn.disabled = true; btn.textContent = 'Deleting...';
      const ids = [...document.querySelectorAll('.nt-checkbox:checked')].map(cb => cb.dataset.id);
      try {
        const res = await fetch('/api/notifications/bulk-delete', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids })
        });
        const data = await res.json();
        if (data.success) {
          ntCloseModal('ntDeleteModal');
          ntToggleDeleteMode();
          if (notificationsPage) notificationsPage.loadNotifications();
          if (window.notificationSystem) window.notificationSystem.refreshNotifications();
        } else {
          alert(data.message || 'Failed to delete');
        }
      } catch (err) {
        alert('Error: ' + err.message);
      } finally {
        btn.disabled = false; btn.textContent = 'Delete';
      }
    }

    function ntDeleteAll() {
      const allIds = [...document.querySelectorAll('.nt-checkbox')].map(cb => cb.dataset.id).filter(Boolean);
      if (allIds.length === 0) { alert('No notifications on this page to delete.'); return; }
      document.getElementById('ntDeleteCountAll').textContent = allIds.length;
      ntShowModal('ntDeleteAllModal');
    }

    async function ntConfirmDeleteAll() {
      const btn = document.getElementById('ntConfirmDeleteAllBtn');
      btn.disabled = true; btn.textContent = 'Deleting...';
      const ids = [...document.querySelectorAll('.nt-checkbox')].map(cb => cb.dataset.id).filter(Boolean);
      if (ids.length === 0) { ntCloseModal('ntDeleteAllModal'); btn.disabled = false; btn.textContent = 'Delete All'; return; }
      try {
        const res = await fetch('/api/notifications/bulk-delete', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids })
        });
        const data = await res.json();
        if (data.success) {
          ntCloseModal('ntDeleteAllModal');
          if (ntDeleteMode) ntToggleDeleteMode();
          if (notificationsPage) notificationsPage.loadNotifications();
          if (window.notificationSystem) window.notificationSystem.refreshNotifications();
        } else {
          alert(data.message || 'Failed to delete');
        }
      } catch (err) {
        alert('Error: ' + err.message);
      } finally {
        btn.disabled = false; btn.textContent = 'Delete All';
      }
    }
  </script>
</body>
</html>