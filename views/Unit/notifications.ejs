          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/unit/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

      <div class="notifications-page">
    <a href="/unit/dashboard" class="back-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15,18 9,12 15,6"></polyline>
      </svg>
      Back to Dashboard
    </a>

    <div class="notifications-header">
      <h1 class="notifications-title">Notifications</h1>
      <div class="notifications-actions">
        <button class="btn" id="mark-all-btn">
          Mark All as Read
        </button>
        <button class="btn" id="refresh-btn">
          Refresh
        </button>
        <button class="btn danger" id="ntDeleteToggleBtn" onclick="ntToggleDeleteMode()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="3,6 5,6 21,6"></polyline>
            <path d="M19,6v14a2,2,0,0,1-2,2H7a2,2,0,0,1-2-2V6m3,0V4a2,2,0,0,1,2-2h4a2,2,0,0,1,2,2V6"></path>
          </svg>
          Delete
        </button>
      </div>
    </div>

    <div class="notifications-filters">
      <button class="filter-btn active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="unread">Unread</button>
      <button class="filter-btn" data-filter="service">Services</button>
      <button class="filter-btn" data-filter="approval">Approvals</button>
      <button class="filter-btn" data-filter="message">Messages</button>
      <button class="filter-btn" data-filter="system">System</button>
    </div>

    <div class="notifications-list-page" id="notifications-container">
      <div class="loading">Loading notifications...</div>
    </div>

    <div class="nt-action-bar">
      <span class="nt-count" id="ntSelectedCount"></span>
      <button class="nt-btn nt-btn-outline" id="ntSelectAllBtn" onclick="ntToggleSelectAll()" style="display:none;">Select All</button>
      <button class="nt-btn nt-btn-danger" id="ntDeleteSelectedBtn" onclick="ntDeleteSelected()" disabled>Delete Selected</button>
      <button class="nt-btn nt-btn-danger" id="ntDeleteAllBtn" onclick="ntDeleteAll()">Delete All</button>
    </div>

    <div class="pagination" id="pagination" style="display: none;">
      <button id="prev-btn" onclick="previousPage()">Previous</button>
      <span id="page-info">Page 1 of 1</span>
      <button id="next-btn" onclick="nextPage()">Next</button>
    </div>
    </div>
  </div>
  </div>
  </div>

  <!-- ── Bulk Delete Confirmation Modal ─────────────────────────── -->
  <div class="nt-modal-backdrop" id="ntDeleteModal">
    <div class="nt-modal">
      <div class="nt-modal-header">
        <h3 class="nt-modal-title">Delete Notifications</h3>
        <button class="nt-modal-close" onclick="ntCloseModal('ntDeleteModal')">&times;</button>
      </div>
      <div class="nt-modal-body">
        <p style="color:#4b5563;margin:0;line-height:1.6;">
          Are you sure you want to delete the <strong id="ntDeleteCount">0</strong> selected notification(s)? This action cannot be undone.
        </p>
      </div>
      <div class="nt-modal-footer">
        <button class="nt-btn-secondary" onclick="ntCloseModal('ntDeleteModal')">Cancel</button>
        <button class="nt-btn-primary-danger" id="ntConfirmDeleteBtn" onclick="ntConfirmDeleteSelected()">Delete</button>
      </div>
    </div>
  </div>

  <!-- ── Delete All Confirmation Modal ───────────────────────────── -->
  <div class="nt-modal-backdrop" id="ntDeleteAllModal">
    <div class="nt-modal">
      <div class="nt-modal-header">
        <h3 class="nt-modal-title">Delete All Notifications</h3>
        <button class="nt-modal-close" onclick="ntCloseModal('ntDeleteAllModal')">&times;</button>
      </div>
      <div class="nt-modal-body">
        <p style="color:#4b5563;margin:0;line-height:1.6;">
          Are you sure you want to delete all <strong id="ntDeleteCountAll">0</strong> notification(s) on this page? This action cannot be undone.
        </p>
      </div>
      <div class="nt-modal-footer">
        <button class="nt-btn-secondary" onclick="ntCloseModal('ntDeleteAllModal')">Cancel</button>
        <button class="nt-btn-primary-danger" id="ntConfirmDeleteAllBtn" onclick="ntConfirmDeleteAll()">Delete All</button>
      </div>
    </div>
  </div>

