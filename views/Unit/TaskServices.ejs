<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/x-icon" href="/Picture/favicon.ico?v=2">
    <link rel="shortcut icon" href="/Picture/favicon.ico?v=2">
    <meta name="theme-color" content="#1a5d1a">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Service Tasks - S-CORE</title>

  <link rel="stylesheet" href="/stylesheets/ejs/table-fixes.css" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/stylesheets/status-badges-new.css" />
  <link rel="stylesheet" href="/stylesheets/notifications.css" />
  <link rel="stylesheet" href="/stylesheets/unit-navbar.css" />
  <link rel="stylesheet" href="/stylesheets/modal-centered.css" />
  <link rel="stylesheet" href="/stylesheets/no-animations.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/alltasks.css?v=3" />
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/alltasks-modal.css?v=10" />
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/alltasks-conversation-modal.css?v=3" />
  <link rel="stylesheet" href="/stylesheets/ejs/allrequestsadmin.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="/javascripts/alert-handler.js"></script>
  <script src="/javascripts/unit-navbar.js"></script>
</head>
<body>
  <%- include('../partials/unit-navbar', { user: user, activePage: 'task-services' }) %>

  <!-- MAIN CONTENT WITH HEADER -->
  <div class="unit-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="unit-menu-toggle" id="unitMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/unit/dashboard" class="text-wrapper">S-CORE UNIT</a>
      </div>
      
      <span class="text-wrapper-2">Service Tasks</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user-placeholder.svg' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/unit/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="student-side">
      <div class="div">
        <section class="activity-section">
          <div class="section-header" style="padding: 2rem 3rem 0 3rem;">
            <h1><%= unitTeam %> Team - Service Requests</h1>
            <p>Process and collaborate on service requests assigned to your unit</p>
          </div>

          <nav class="nav-tabs tabs" style="padding: 0 3rem; margin-bottom: 1.5rem;">
            <a href="/unit/all-tasks" class="tab-btn">All Tasks</a>
            <a href="/unit/task-approvals" class="tab-btn">Approvals</a>
            <a href="/unit/task-services" class="tab-btn active">Services</a>
          </nav>

          <hr style="margin: 0 3rem 2rem 3rem; border: none; border-top: 2px solid #e5e7eb;">

          <!-- Filters (same layout as others) -->
          <div class="filter-section">
            <div class="filter-container">
              <div class="filter-group">
                <label class="filter-label">Filter by:</label>
                <div class="filter-controls">
                  <div class="filter-item">
                    <label for="titleFilter" class="filter-sublabel">Title</label>
                    <input type="text" id="titleFilter" class="filter-input" placeholder="Search title...">
                  </div>
                  <div class="filter-item">
                    <label class="filter-sublabel">Status</label>
                    <div class="enhanced-multi-select-wrapper">
                      <div class="enhanced-multi-select" id="statusFilter">
                        <div class="select-display" data-placeholder="Select Status">
                          <span class="selected-text">All Status</span>
                          <span class="dropdown-arrow">▼</span>
                        </div>
                        <div class="select-dropdown" id="statusDropdown">
                          <div class="options-container">
                            <!-- JavaScript will populate this -->
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="filter-item">
                    <label for="requestorFilter" class="filter-sublabel">Requestor</label>
                    <input type="text" id="requestorFilter" class="filter-input" placeholder="Search requestor...">
                  </div>

                  <div class="filter-item">
                    <label for="sortSelect" class="filter-sublabel">Sort By</label>
                    <select id="sortSelect" class="filter-select">
                      <option value="priority">Priority (Urgent First)</option>
                      <option value="deadline-asc">Deadline (Nearest First)</option>
                      <option value="deadline-desc">Deadline (Farthest First)</option>
                      <option value="status-priority">Status (Active First)</option>
                      <option value="date-desc">Date Submitted (Newest)</option>
                      <option value="date-asc">Date Submitted (Oldest)</option>
                      <option value="title-asc">Title (A-Z)</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="filter-actions">
                <button id="clearFilters" class="clear-filters-btn">
                  <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="6" width="18" height="14" rx="2"/>
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    <line x1="1" y1="6" x2="23" y2="6"/>
                    <line x1="10" y1="11" x2="10" y2="17"/>
                    <line x1="14" y1="11" x2="14" y2="17"/>
                  </svg>
                  Clear All
                </button>
                <div class="results-count">
                  <span id="resultsCount">Showing all requests</span>
                </div>
              </div>
            </div>
          </div>

          <div class="table-section" style="background: white; padding: 1.5rem; margin: 0 3rem 2rem 3rem;">
            <table class="requests-table" style="width: 100%;">
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Title</th>
                  <th>Requestor</th>
                  <th>Organization/Office/Dept</th>
                  <th>Date Submitted</th>
                  <th>Status</th>
                  <th style="text-align: center;">Deadline</th>
                </tr>
              </thead>
              <tbody id="requestsTableBody">
                <% 
                // Smart sorting for service requests
                const allRequests = (serviceRequests || []).map(r => ({...r, requestType: 'service'}))
                  .sort((a, b) => {
                    const statusPriority = {
                      'Queued': 1,
                      'In Progress': 2,
                      'Pending': 3,
                      'For Revision': 4,
                      // Finalized statuses should always appear last in this specific order
                      // Completed (most recent first), then Approved, Rejected, then Cancelled/Archived
                      'Completed': 5,
                      'Approved': 6,
                      'Rejected': 7,
                      'Cancelled': 8
                    };
                    
                    const aPriority = statusPriority[a.status] || 999;
                    const bPriority = statusPriority[b.status] || 999;
                    
                    if (aPriority === bPriority) {
                      if (aPriority <= 4) {
                        if (!a.deadline && !b.deadline) return new Date(b.createdAt) - new Date(a.createdAt);
                        if (!a.deadline) return 1;
                        if (!b.deadline) return -1;
                        return new Date(a.deadline) - new Date(b.deadline);
                      }
                      return new Date(b.createdAt) - new Date(a.createdAt);
                    }
                    
                    return aPriority - bPriority;
                  });
                %>

                <% if (allRequests && allRequests.length > 0) { %>
                  <% allRequests.forEach(request => { %>
                    <% 
                      const type = 'service';
                      const title = request.title || request.serviceType || request.specificRequestType || 'Untitled';
                      const requestor = request.userId ? `${request.userId.fName} ${request.userId.lName}` : 'Unknown';
                      let organization = 'N/A';
                      if (request.userId) {
                        if (request.userId.studentOrganization && Array.isArray(request.userId.studentOrganization) && request.userId.studentOrganization.length > 0) {
                          organization = request.userId.studentOrganization[0];
                        } else if (request.userId.office && request.userId.office.trim()) {
                          organization = request.userId.office;
                        } else if (request.userId.department && request.userId.department.trim()) {
                          organization = request.userId.department;
                        } else if (request.userId.affiliation && Array.isArray(request.userId.affiliation) && request.userId.affiliation.length > 0) {
                          organization = request.userId.affiliation[0];
                        }
                      }
                      const dateSubmitted = new Date(request.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                      const status = request.status || 'Pending';
                      const files = request.files || [];
                      const deliverables = request.deliverables || [];
                      const deadline = request.deadline || '';
                      const serviceType = request.serviceType || request.specificRequestType || '';
                      const description = request.description || '';
                      const requestorEmail = request.userId ? request.userId.email : '';
                    %>
                    <tr class="request-row clickable" 
                        data-request-id="<%= request._id %>"
                        data-request-type="<%= type %>"
                        data-title="<%= title.replace(/"/g, '&quot;') %>"
                        data-requestor="<%= requestor.replace(/"/g, '&quot;') %>"
                        data-requestor-email="<%= requestorEmail.replace(/"/g, '&quot;') %>"
                        data-organization="<%= organization.replace(/"/g, '&quot;') %>"
                        data-description="<%= description.replace(/"/g, '&quot;') %>"
                        data-date-submitted="<%= dateSubmitted %>"
                        data-status="<%= status %>"
                        data-awaiting-resubmission="false"
                        data-files='<%= JSON.stringify(files) %>'
                        data-deliverables='<%= JSON.stringify(deliverables) %>'
                        data-deadline="<%= deadline %>"
                        data-service-type="<%= serviceType.replace(/"/g, '&quot;') %>">
                      <td>
                        <span class="type-badge service">Service</span>
                      </td>
                      <td class="title-cell"><%= title %></td>
                      <td><%= requestor %></td>
                      <td><%= organization %></td>
                      <td><%= dateSubmitted %></td>
                      <td>
                        <span class="status-badge <%= status.toLowerCase().replace(/\s+/g, '-') %>"><%= status %></span>
                      </td>
                      <td style="text-align: center;">
                        <% if (deadline) { %>
                          <% 
                            const today = new Date();
                            today.setHours(0,0,0,0);
                            const deadlineDate = new Date(deadline);
                            deadlineDate.setHours(0,0,0,0);
                            const timeDiff = deadlineDate - today;
                            const daysDiff = Math.ceil(timeDiff / (1000 * 60 * 60 * 24));
                            const isOverdue = daysDiff < 0 && (status.toLowerCase() === 'pending' || status.toLowerCase() === 'queued' || status.toLowerCase() === 'in-progress' || status.toLowerCase() === 'for-revision');
                            const isNearDeadline = daysDiff >= 0 && daysDiff <= 1 && (status.toLowerCase() === 'pending' || status.toLowerCase() === 'queued' || status.toLowerCase() === 'in-progress' || status.toLowerCase() === 'for-revision');
                          %>
                          <span class="deadline-badge <%= isOverdue ? 'overdue' : isNearDeadline ? 'near-deadline' : '' %>">
                            <%= new Date(deadline).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                          </span>
                        <% } else { %>
                          <span class="deadline-badge">N/A</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" style="text-align: center; padding: 3rem; color: #64748b;">
                      <div style="font-size: 3rem; margin-bottom: 1rem;">
                        <svg width="64" height="64" fill="none" stroke="#94a3b8" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block;">
                          <rect x="4" y="4" width="16" height="16" rx="2"/>
                          <line x1="8" y1="8" x2="16" y2="8"/>
                          <line x1="8" y1="12" x2="16" y2="12"/>
                          <line x1="8" y1="16" x2="12" y2="16"/>
                        </svg>
                      </div>
                      <p>No service requests assigned to your unit yet</p>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </div>

  <!-- Request Details Modal (reuse same modal as AllTasks) -->
  <div id="requestDetailsModal" class="modal" style="display: none;">
    <div class="modal-content unit-modal-wide">
      <div class="modal-header unit-modal-header">
        <div class="modal-title-section">
          <svg class="modal-title-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="4" y="4" width="16" height="16" rx="2"/>
            <line x1="8" y1="8" x2="16" y2="8"/>
            <line x1="8" y1="12" x2="16" y2="12"/>
            <line x1="8" y1="16" x2="12" y2="16"/>
          </svg>
          <h2 id="modalTitle">Request Details</h2>
          <span class="type-badge" id="modalTypeBadge">SERVICE</span>
        </div>
        <div class="modal-action-buttons">
          <button class="modal-action-btn edit-btn" id="editRequestBtn" title="Edit Request">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            <span>Edit</span>
          </button>
          <button class="modal-action-btn delete-btn" id="deleteRequestBtn" title="Archive Request">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M21 8v13H3V8M1 3h22v5H1zM10 12h4"></path>
            </svg>
            <span>Archive</span>
          </button>
        </div>
        <button class="close-modal-btn" onclick="closeRequestModal()" aria-label="Close">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <div class="modal-body unit-modal-body">
        <div class="unit-left-column">
          <div class="unit-info-card">
            <div class="unit-card-header">
              <h3>Request Information</h3>
              <p class="unit-card-subtitle">Complete details about this request</p>
            </div>
            <div class="unit-info-grid">
              <div class="unit-info-item"><span class="unit-info-label">Requestor</span><span class="unit-info-value" id="modalRequestor">Loading...</span></div>
              <div class="unit-info-item"><span class="unit-info-label">Email</span><span class="unit-info-value" id="modalRequestorEmail">Loading...</span></div>
              <div class="unit-info-item"><span class="unit-info-label">Organization/Office/Dept</span><span class="unit-info-value" id="modalOrganization">Loading...</span></div>
              <div class="unit-info-item"><span class="unit-info-label">Date Submitted</span><span class="unit-info-value" id="modalDate">Loading...</span></div>
              <div class="unit-info-item"><span class="unit-info-label">Current Status</span><span class="status-badge" id="modalStatus">Pending</span></div>
              <div class="unit-info-item" id="approvedOnField" style="display: none;"><span class="unit-info-label">Approved On</span><span class="unit-info-value" id="modalApprovedOn" style="color: #16a34a; font-weight: 600;">N/A</span></div>
              <div class="unit-info-item" id="deadlineField" style="display: none;"><span class="unit-info-label">Deadline</span><span class="unit-info-value" id="modalDeadline">N/A</span></div>
              <div class="unit-info-item" id="serviceTypeField" style="display: none;"><span class="unit-info-label">Service Type</span><span class="unit-info-value" id="modalServiceType">N/A</span></div>
            </div>
          </div>

          <div class="unit-info-card">
            <div class="unit-card-header">
              <h3>Description</h3>
              <p class="unit-card-subtitle">Request details and requirements</p>
            </div>
            <div class="unit-description-content" id="modalDescription">Loading description...</div>
          </div>

          <div id="filesSection" class="unit-info-card" style="display: none;">
            <div class="unit-card-header">
              <h3>Attached Files</h3>
              <p class="unit-card-subtitle">Files submitted with this request</p>
            </div>
            <div id="modalFiles"></div>
          </div>

          <div id="deliverablesSection" class="unit-info-card" style="display: none;">
            <div class="unit-card-header">
              <h3>Deliverables</h3>
              <p class="unit-card-subtitle">Files uploaded by unit team</p>
            </div>
            <div id="modalDeliverables"></div>
          </div>
        </div>

        <div class="unit-right-column">
          <div class="unit-info-card unit-conversation-trigger">
            <button id="openTeamChatBtn" class="unit-chat-button">
              <span class="unit-chat-icon">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
              </span>
              <div class="unit-chat-text">
                <strong>Open Request Discussion</strong>
                <small>Communicate with users and admins</small>
              </div>
              <span class="unit-chat-arrow">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
            </button>
          </div>

          <div id="revisionHistorySection" class="unit-action-panel revision-history-panel">
            <div class="unit-panel-header revision-header">
              <h3>
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; vertical-align: -2px; margin-right: 8px;">
                  <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                  <path d="M21 3v5h-5"/>
                  <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                  <path d="M3 21v-5h5"/>
                </svg>
                Revision History
              </h3>
              <p>Complete timeline of all revisions and resubmissions</p>
            </div>
            <div id="revisionHistoryContainer" class="revision-history-timeline"></div>
          </div>

          <div id="serviceActionsPanel" class="unit-action-panel service-panel" style="display: none;">
            <div class="unit-panel-header service-header">
              <h3>Process Service Request</h3>
              <p>Upload deliverables and complete the service</p>
            </div>
            <div class="unit-action-guide">
              <div class="guide-item">
                <span class="guide-icon">⇪</span>
                <span>Upload all required deliverables</span>
              </div>
              <div class="guide-item">
                <span class="guide-icon">📁</span>
                <span>Verify files before uploading</span>
              </div>
              <div class="guide-item">
                <span class="guide-icon">✔</span>
                <span>Mark as complete when work is done</span>
              </div>
            </div>

            <div class="unit-upload-section">
              <label class="unit-form-label"><strong>Upload Deliverables</strong><small>Select one or more files to upload</small></label>
              <div class="unit-file-upload-group" id="unitFileUploadGroup">
                <input type="file" id="deliverablesFileInput" multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.webp,.xls,.xlsx,.txt" class="unit-file-input-hidden">
                <button type="button" class="unit-browse-file-btn" onclick="event.stopPropagation(); document.getElementById('deliverablesFileInput').click()">Choose Files</button>
                <div class="unit-upload-progress" id="unitUploadProgress"><div class="unit-progress-bar"><div class="unit-progress-fill" id="unitProgressFill"></div></div></div>
              </div>
              <div class="unit-file-management" id="unitFileManagement" style="display: none;">
                <div class="unit-file-actions">
                  <span id="unitFilesCount">0 files selected</span>
                  <button type="button" class="unit-clear-all-btn" id="unitClearAllBtn">Clear All Files</button>
                </div>
                <div class="unit-selected-files-container" id="unitSelectedFiles"></div>
                <div class="unit-files-summary" id="unitFilesSummary">Total size: 0 MB</div>
              </div>
              <button id="uploadDeliverablesBtn" disabled class="unit-btn unit-btn-upload" style="margin-top: 1rem;">Submit Deliverables for Review</button>
            </div>

            <div class="unit-info-notice">
              <div>
                <p style="margin:0; font-weight:600; color:#1e293b;">Service Request Workflow</p>
                <p style="margin:0; font-size:0.875rem; color:#64748b;">Upload files and submit for requestor review. Only requestor can mark complete.</p>
              </div>
            </div>
          </div>

          <!-- Complete Task Panel (shown when status is Approved) -->
          <div id="completeTaskPanel" class="unit-action-panel" style="display: none; background: white; border: 2px solid #2563eb; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
            <div class="unit-panel-header" style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; padding: 1.5rem;">
              <h3 style="color: #1e293b; font-size: 1.125rem; display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.5rem 0;">
                <svg width="20" height="20" fill="none" stroke="#2563eb" stroke-width="2" viewBox="0 0 24 24">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                Complete Task
              </h3>
              <p style="color: #64748b; font-size: 0.875rem; margin: 0;">Requestor has approved your deliverables. Provide final remarks to complete.</p>
            </div>
            <div style="padding: 1.5rem;">
              <div style="background: #eff6ff; border-left: 4px solid #2563eb; border-radius: 4px; padding: 1rem; margin-bottom: 1.5rem;">
                <p style="color: #1e40af; font-weight: 600; margin: 0 0 0.5rem 0; font-size: 0.9rem;">
                  <svg width="16" height="16" fill="none" stroke="#2563eb" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; margin-right: 0.5rem;">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="16" x2="12" y2="12"/>
                    <line x1="12" y1="8" x2="12.01" y2="8"/>
                  </svg>
                  Deliverables Approved
                </p>
                <p style="color: #475569; font-size: 0.875rem; margin: 0; line-height: 1.6;">
                  Similar to request approvals, you must provide <strong>final remarks</strong> to officially complete this service request and change the status to "Completed".
                </p>
              </div>
              <button id="openCompleteTaskModalBtn" class="unit-btn" style="width: 100%; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; font-weight: 600; border: none; padding: 0.875rem 1.5rem; font-size: 0.95rem; box-shadow: 0 2px 4px rgba(37, 99, 235, 0.2);">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; margin-right: 0.5rem;">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                Complete Task with Final Remarks
              </button>
            </div>
          </div>

          <div id="additionalFileToggleSection" class="unit-action-panel">
            <style>
              .toggle-switch {
                position: relative;
                display: inline-block;
                width: 50px;
                height: 24px;
                margin: 0;
              }

              .toggle-slider {
                position: absolute;
                cursor: pointer;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background-color: #cbd5e1;
                transition: 0.4s;
                border-radius: 24px;
              }

              .toggle-slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background-color: white;
                transition: 0.4s;
                border-radius: 50%;
              }

              input:checked + .toggle-slider {
                background-color: #10b981;
              }

              input:checked + .toggle-slider:before {
                transform: translateX(26px);
              }

              .toggle-switch input[type="checkbox"] {
                opacity: 0;
                width: 0;
                height: 0;
              }
            </style>
            <div style="background: #f0fdf4; border-radius: 8px; padding: 1rem; margin: 1rem 0; border: 1px solid #bbf7d0;">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <label class="toggle-switch" style="margin: 0;">
                  <input type="checkbox" id="toggleAdditionalFileUploadBtn" checked>
                  <span class="toggle-slider"></span>
                </label>
                <span style="font-size: 0.9rem; color: #166534; font-weight: 500;">Allow users to upload additional files</span>
              </div>
              <div style="font-size: 0.8rem; color: #6b7280; margin-top: 0.25rem;">
                This will permit users to add more files when revising their requests
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Complete Task Modal -->
