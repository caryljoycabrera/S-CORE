  <!-- Chart.js Data -->
  <script>
    // Open announcement detail modal — fetch fresh so newly-created/live-refreshed
    // announcements (not present in the page's initial render) still open correctly
    async function openAnnouncementDetail(announcementId) {
      try {
        const response = await fetch(`/api/announcements/${announcementId}`);
        const data = await response.json();
        if (!data.success || !data.announcement) {
          console.error('Announcement not found:', announcementId);
          return;
        }
        const announcement = data.announcement;

        // Update modal content
        document.getElementById('announcementModalTitle').textContent = announcement.title;
        document.getElementById('announcementModalDate').textContent = new Date(announcement.createdAt).toLocaleDateString('en-US', {
          month: 'long',
          day: 'numeric',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });

        // Render HTML content (from Quill editor)
        document.getElementById('announcementModalContent').innerHTML = announcement.content;

        document.getElementById('announcementModalFrom').textContent = announcement.sentBy
          ? `${announcement.sentBy.fName} ${announcement.sentBy.lName}`
          : 'Admin';

        const priorityText = announcement.priority === 'high' ? 'Urgent' :
                             announcement.priority === 'medium' ? 'Important' : 'Low';
        document.getElementById('announcementModalPriority').textContent = priorityText;

        // Show modal
        document.getElementById('announcementDetailModal').style.display = 'flex';

        // Mark as read if not already
        if (!announcement.isRead) {
          markAnnouncementAsRead(announcementId);
        }
      } catch (error) {
        console.error('Error loading announcement:', error);
      }
    }

    // Ensure global reference points to this version (not the partial's)
    window.openAnnouncementDetail = openAnnouncementDetail;

    // Close announcement detail modal
    function closeAnnouncementModal() {
      document.getElementById('announcementDetailModal').style.display = 'none';
    }

    // Close modal when clicking outside
    document.getElementById('announcementDetailModal')?.addEventListener('click', function(e) {
      if (e.target === this) {
        closeAnnouncementModal();
      }
    });

    const taskBreakdownData = {
      labels: <%- JSON.stringify((taskBreakdown && taskBreakdown.labels) || ['No Tasks']) %>,
      data: <%- JSON.stringify((taskBreakdown && taskBreakdown.data) || [1]) %>,
      totalActive: <%= (taskBreakdown && taskBreakdown.totalActive) || 0 %>,
      totalCompleted: <%= (taskBreakdown && taskBreakdown.totalCompleted) || 0 %>,
      completionRate: <%= (taskBreakdown && taskBreakdown.completionRate) || 0 %>
    };

    const requesterComplianceData = <%- JSON.stringify(requesterCompliance || []) %>;
    
    const taskTimeline = <%- JSON.stringify(taskTimeline || []) %>;

    // Mark announcement as read
    async function markAnnouncementAsRead(announcementId) {
      try {
        const response = await fetch(`/api/announcements/${announcementId}/read`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        });
        
        if (response.ok) {
          // Update UI - mark as read
          const item = document.querySelector(`.announcement-item[data-id="${announcementId}"]`);
          if (item) {
            item.classList.remove('unread');
            item.classList.add('read');
            // Remove "New" badge
            const newBadge = item.querySelector('.announcement-badge.success');
            if (newBadge) newBadge.remove();
          }
          
          // Update badge count in header
          const badge = document.querySelector('.announcements-badge');
          if (badge) {
            const currentCount = parseInt(badge.textContent) || 0;
            if (currentCount > 1) {
              badge.textContent = `${currentCount - 1} new`;
            } else {
              badge.style.display = 'none';
            }
          }
        }
      } catch (error) {
        console.log('Error marking announcement as read:', error);
      }
    }

    // Urgent Tasks Tab Switching
    function switchUrgentTab(tabName) {
      // Remove active class from all tab buttons and panes
      document.querySelectorAll('.urgent-tab-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      document.querySelectorAll('.urgent-tab-pane').forEach(pane => {
        pane.classList.remove('active');
      });
      
      // Add active class to selected tab button and pane
      const tabBtn = document.querySelector(`.urgent-tab-btn[data-tab="${tabName}"]`);
      const tabPane = document.getElementById(`${tabName}-pane`);
      
      if (tabBtn) tabBtn.classList.add('active');
      if (tabPane) tabPane.classList.add('active');
    }

    function toggleGuidelines() {
      const content = document.getElementById('guidelinesContent');
      const toggle = document.getElementById('guidelinesToggle');
      
      if (content.style.display === 'none') {
        content.style.display = 'block';
        toggle.style.transform = 'rotate(180deg)';
        setTimeout(() => {
          content.classList.add('active');
        }, 10);
      } else {
        content.classList.remove('active');
        toggle.style.transform = 'rotate(0deg)';
        setTimeout(() => {
          content.style.display = 'none';
        }, 300);
      }
    }
  </script>
  
