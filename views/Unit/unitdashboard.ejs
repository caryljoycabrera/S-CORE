      .workload-snapshot-table,
      .activity-table {
        min-width: 600px; /* Prevents squishing */
        font-size: 0.85rem;
      }

      .workload-table-wrapper table {
        margin: 0 auto;
      }

      /* Chart containers - responsive sizing */
      .chart-content canvas,
      .chart-wrapper canvas {
        max-width: 100%;
        max-height: 250px;
      }

      /* Metrics cards - responsive grid */
      .performance-metrics-section {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      /* Timeline chart - responsive */
      .timeline-chart-card .chart-content canvas {
        max-height: 200px;
      }

      /* Cards and charts - mobile-friendly sizing */
      .panel-content,
      .calendar-content,
      .chart-content,
      .timeline-chart-card,
      .recent-activity-table-card {
        padding: 1rem;
      }

      /* Guidelines container - mobile adjustments */
      .guidelines-container {
        margin: 1.5rem 0;
        padding: 1rem;
      }

      .guidelines-title {
        font-size: 1rem;
      }

      /* Urgent tasks - mobile stacking */
      .urgent-tasks-list {
        gap: 0.75rem;
      }

      .task-item-compact {
        padding: 0.75rem;
      }

      /* Tab navigation - mobile friendly */
      .urgent-tasks-tabs {
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .urgent-tab-btn {
        flex: 1;
        min-width: 120px;
        font-size: 0.85rem;
      }

      /* Help & Guide Card */
      .guide-card-container {
        margin-top: 1.5rem;
      }

      .dashboard-guide-card {
        padding: 1rem;
        gap: 1rem;
      }

      .guide-card-content h3 {
        font-size: 1.1rem;
      }
    }

    /* Extra small screens */
    @media (max-width: 480px) {
      /* Even smaller spacing and fonts */
      .student-side {
        padding-left: 0.75rem;
        padding-right: 0.75rem;
