<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/x-icon" href="/Picture/favicon.ico?v=2">
    <link rel="shortcut icon" href="/Picture/favicon.ico?v=2">
    <meta name="theme-color" content="#1a5d1a">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>S-CORE <%= unitTeam %> Unit Dashboard</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/stylesheets/notifications.css" />
  <link rel="stylesheet" href="/stylesheets/unit-navbar.css" />
  <link rel="stylesheet" href="/stylesheets/modal-centered.css" />
  <link rel="stylesheet" href="/stylesheets/no-animations.css" />
  <link rel="stylesheet" href="/stylesheets/announcements-shared.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/unitdashboard-layout.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/unitdashboard-analytics.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="/javascripts/alert-handler.js"></script>
  <script src="/javascripts/unit-navbar.js"></script>
</head>
<body>
  <!-- Unit Sidebar Navigation -->
  <%- include('../partials/unit-navbar', { user: user, activePage: 'dashboard' }) %>

  <!-- MAIN CONTENT WITH HEADER -->
  <div class="unit-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="unit-menu-toggle" id="unitMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/unit/dashboard" class="text-wrapper">S-CORE UNIT</a>
      </div>
      
      <span class="text-wrapper-2">Welcome, <%= name %>!</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user-placeholder.svg' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/unit/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

    <!-- DASHBOARD CONTENT -->
    <div class="student-side">
      <div class="div">

      <!-- Action Cards - Horizontal Row -->
      <div class="action-cards-section">
        <div class="action-card" onclick="location.href='/unit/all-tasks'">
          <div class="card-icon-wrapper">
            <img src="/Picture/Stats.png" alt="All Tasks" class="card-icon" />
            <div class="icon-glow"></div>
          </div>
          <h3 class="card-title">All Tasks</h3>
          <p class="card-subtitle">View all assigned tasks</p>
          <div class="card-arrow">→</div>
        </div>
        <div class="action-card" onclick="location.href='/unit/task-approvals'">
          <div class="card-icon-wrapper">
            <img src="/Picture/File.png" alt="Approval Tasks" class="card-icon" />
            <div class="icon-glow"></div>
          </div>
          <h3 class="card-title">Approval Tasks</h3>
          <p class="card-subtitle">Manage approval requests</p>
          <div class="card-arrow">→</div>
        </div>
        <div class="action-card" onclick="location.href='/unit/task-services'">
          <div class="card-icon-wrapper">
            <img src="/Picture/Repair.png" alt="Service Tasks" class="card-icon" />
            <div class="icon-glow"></div>
          </div>
          <h3 class="card-title">Service Tasks</h3>
          <p class="card-subtitle">Manage service requests</p>
          <div class="card-arrow">→</div>
        </div>
      </div>

      <!-- Task Management Guidelines - Moved here after action cards -->
      <div class="guidelines-container">
        <div class="guidelines-header" onclick="toggleGuidelines()" style="cursor: pointer;">
          <div class="guidelines-header-content">
            <div class="guidelines-title-group">
              <div class="guidelines-icon-wrapper">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </div>
              <div>
                <h4 class="guidelines-title">Task Management Guidelines</h4>
                <p class="guidelines-subtitle">Quick reference for efficient task handling</p>
              </div>
            </div>
            <span class="guidelines-toggle" id="guidelinesToggle" style="transform: rotate(0deg);">▼</span>
          </div>
        </div>

        <div class="guidelines-content" id="guidelinesContent" style="display: none;">
          
          <!-- Approval Requests -->
          <div class="guidelines-section" style="border-left-color: #2c5d31;">
            <h5 class="section-title" style="color: #2c5d31;">
              <span class="section-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px;">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
              </span>
              Type 1: Approval Requests
            </h5>
            <p style="background: #f0fdf4; padding: 8px 12px; border-radius: 4px; font-size: 0.85rem; color: #2c5d31; margin: 0 0 12px; font-weight: 600;">You Review → They Already Created It</p>
            
            <div style="margin: 16px 0;">
              <p style="margin: 0 0 10px; font-size: 0.875rem;"><strong>Your Goal:</strong> Review and validate materials (like a pubmat, caption, or video) that a requestor already submitted.</p>
              <p style="margin: 0 0 10px; font-size: 0.875rem;"><strong>Your Actions:</strong></p>
              <ul style="margin: 0 0 10px; padding-left: 20px; font-size: 0.85rem;">
                <li><strong>"Approve":</strong> If submission is correct, provide final remarks → Sets status to "Approved" (final).</li>
                <li><strong>"For Revision":</strong> If errors exist → Explain what needs fixing in Conversation. Requestor resubmits → status becomes "For Checking" for re-review.</li>
                <li><strong>"Revoke Approval":</strong> If approved by mistake, revoke it → sends back to "For Revision".</li>
              </ul>
              <p style="margin: 0; padding: 12px; background: #fef3c7; border-left: 3px solid #d97706; border-radius: 4px; font-size: 0.85rem;">
                <strong>Tip:</strong> Always use the Conversation tab to explain what needs fixing when setting "For Revision." Be specific about changes required.
              </p>
            </div>
          </div>

          <!-- Service Requests -->
          <div class="guidelines-section" style="border-left-color: #1e40af;">
            <h5 class="section-title" style="color: #1e40af;">
              <span class="section-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px;">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                </svg>
              </span>
              Type 2: Service Requests
            </h5>
            <p style="background: #eff6ff; padding: 8px 12px; border-radius: 4px; font-size: 0.85rem; color: #1e40af; margin: 0 0 12px; font-weight: 600;">You Create → You Deliver the Final Product</p>
            
            <div style="margin: 16px 0;">
              <p style="margin: 0 0 10px; font-size: 0.875rem;"><strong>Your Goal:</strong> Create and deliver a new creative asset (like a graphic, video, or photo set) for a requestor.</p>
              <p style="margin: 0 0 10px; font-size: 0.875rem;"><strong>Your Actions:</strong></p>
              <ul style="margin: 0 0 10px; padding-left: 20px; font-size: 0.85rem;">
                <li><strong>"Reject":</strong> Available only before you start (status "Queued"). Requires a reason → Sets to "Rejected" (final).</li>
                <li><strong>"Start" / "Acknowledge":</strong> Begin working → Sets status to "In Progress".</li>
                <li><strong>"Submit Deliverable":</strong> Paste link(s) to finished work + notes → Sets to "For Checking" for requestor review.</li>
                <li><strong>"Mark Final Complete":</strong> After requestor approves deliverable, provide final remarks → Sets to "Completed" (true final).</li>
              </ul>
              <p style="margin: 0; padding: 12px; background: #fef3c7; border-left: 3px solid #d97706; border-radius: 4px; font-size: 0.85rem;">
                <strong>Tip:</strong> Use the Conversation tab to share watermarked drafts with the requestor before submitting the final deliverable link.
              </p>
            </div>
          </div>

          <!-- Need More Detail -->
          <div class="guidelines-section" style="background: #f3f4f6; border-left: 4px solid #6b7280; padding: 16px; margin-top: 24px;">
            <p style="margin: 0 0 12px; font-size: 0.9rem; color: #374151;">
              <strong>Need more detail?</strong> This is just a quick reference. For the full workflow, rules, and best practices, check the complete Unit Guide.
            </p>
            <a href="/unit/guide" style="display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #2d7a4a 0%, #1e3a5f 100%); color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 0.875rem;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
              View Full Guide
            </a>
          </div>

        </div>
      </div>

      <!-- UNIFIED DASHBOARD GRID -->
      <div class="dashboard-unified-grid">
        
        <!-- Row 1: Calendar (Left) -->
        <div class="calendar-standalone">
          <div class="calendar-header">
            <div style="display: flex; align-items: center;">
              <svg class="calendar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <h3 class="calendar-title">My Unit Calendar</h3>
            </div>
            <div class="calendar-controls">
              <button class="calendar-maximize-btn" id="calendar-maximize" aria-label="Maximize Calendar" title="Maximize Calendar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <polyline points="9 21 3 21 3 15"></polyline>
                  <line x1="21" y1="3" x2="14" y2="10"></line>
                  <line x1="3" y1="21" x2="10" y2="14"></line>
                </svg>
              </button>
              <div class="calendar-month-controls">
                <button class="calendar-nav-btn" id="calendar-prev-month" aria-label="Previous Month" title="Previous Month">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                </button>
                <span class="calendar-month-year" id="calendar-month-year"></span>
                <button class="calendar-nav-btn" id="calendar-next-month" aria-label="Next Month" title="Next Month">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </button>
              </div>
            </div>
          </div>
          <div class="calendar-legend">
            <div class="legend-item">
              <div class="legend-dot approval"></div>
              <span class="legend-text">Request Approvals</span>
            </div>
            <div class="legend-item">
              <div class="legend-dot service"></div>
              <span class="legend-text">Service Requests</span>
            </div>
          </div>
          <div class="calendar-content">
            <div id="calendar-standalone" class="calendar-grid"></div>
          </div>
        </div>

        <!-- Row 1: Urgent Tasks (Right) -->
        <div class="urgent-tasks-panel">
          <div class="panel-header urgent">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <h3>My Urgent Tasks</h3>
          </div>
          
            <% if (urgentTasks && urgentTasks.length > 0) { %>
              <%
                const excludedStatuses = ['completed', 'approved', 'rejected', 'archived', 'deleted'];
                const approvalTasks = urgentTasks.filter(t => !t.serviceType && !excludedStatuses.includes((t.status || '').toLowerCase()));
                const serviceTasks = urgentTasks.filter(t => t.serviceType && !excludedStatuses.includes((t.status || '').toLowerCase()));
                const hasApprovals = approvalTasks.length > 0;
                const hasServices = serviceTasks.length > 0;
              %>            <!-- Tab Navigation -->
            <div class="urgent-tasks-tabs">
              <button class="urgent-tab-btn active" data-tab="approvals" onclick="switchUrgentTab('approvals')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 11l3 3L22 4"></path>
                  <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
                </svg>
                Approvals
                <% if (hasApprovals) { %>
                  <span class="tab-count"><%= approvalTasks.length %></span>
                <% } %>
              </button>
              <button class="urgent-tab-btn" data-tab="services" onclick="switchUrgentTab('services')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"></path>
                </svg>
                Services
                <% if (hasServices) { %>
                  <span class="tab-count"><%= serviceTasks.length %></span>
                <% } %>
              </button>
            </div>
            
            <!-- Tab Content -->
            <div class="urgent-tasks-tab-content">
              <!-- Approvals Tab -->
              <div class="urgent-tab-pane active" id="approvals-pane">
                <% if (hasApprovals) { %>
                  <div class="urgent-tasks-list">
                    <% approvalTasks.forEach(function(task) { %>
                      <div class="task-item-compact approval-task" data-task-id="<%= task._id %>" data-task-type="approval" onclick="viewTaskDetails('<%= task._id %>', 'approval')" style="cursor: pointer;">
                        <div class="task-compact-header">
                          <h5 class="task-compact-title"><%= task.title || 'Untitled Task' %></h5>
                          <span class="task-badge approval">APPROVAL</span>
                        </div>
                        <div class="task-compact-info">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                          </svg>
                          <span><%= task.userId ? task.userId.fName + ' ' + task.userId.lName : 'Unknown' %></span>
                        </div>
                        <div class="task-compact-deadline">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                          </svg>
                          <span><%= new Date(task.deadline).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                <% } else { %>
                  <div class="no-tasks-column">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <p>No urgent approval requests</p>
                  </div>
                <% } %>
              </div>
              
              <!-- Services Tab -->
              <div class="urgent-tab-pane" id="services-pane">
                <% if (hasServices) { %>
                  <div class="urgent-tasks-list">
                    <% serviceTasks.forEach(function(task) { %>
                      <div class="task-item-compact service-task" data-task-id="<%= task._id %>" data-task-type="service" onclick="viewTaskDetails('<%= task._id %>', 'service')" style="cursor: pointer;">
                        <div class="task-compact-header">
                          <h5 class="task-compact-title"><%= task.title || task.serviceType || 'Untitled Task' %></h5>
                          <span class="task-badge service">SERVICE</span>
                        </div>
                        <div class="task-compact-info">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                          </svg>
                          <span><%= task.userId ? task.userId.fName + ' ' + task.userId.lName : 'Unknown' %></span>
                        </div>
                        <div class="task-compact-deadline">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                          </svg>
                          <span><%= new Date(task.deadline).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                <% } else { %>
                  <div class="no-tasks-column">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <p>No urgent service requests</p>
                  </div>
                <% } %>
              </div>
            </div>
          <% } else { %>
            <div class="panel-content">
              <div class="no-tasks">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
                <p>No urgent tasks!</p>
                <span>All caught up 🎉</span>
              </div>
            </div>
          <% } %>
          
          <p style="font-size: 0.75rem; color: #9ca3af; text-align: center; margin: 12px 0 0; padding: 12px;">
            Click on any task card to view details
          </p>
        </div>

        <!-- Row 2: Announcements (Left) -->
        <div class="announcements-panel">
          <div class="announcements-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M11 5L6 9H2v6h4l5 4V5zM15.54 8.46a5 5 0 010 7.07M19.07 4.93a10 10 0 010 14.14"/>
            </svg>
            <h3>Announcements</h3>
            <% if (typeof announcements !== 'undefined' && announcements.length > 0) { %>
              <span class="announcements-badge"><%= announcements.filter(a => !a.isRead).length %> new</span>
            <% } %>
          </div>
          <div class="announcements-content" id="announcements-content">
            <% if (typeof announcements !== 'undefined' && announcements.length > 0) { %>
              <% announcements.forEach(function(announcement) { %>
                <div class="announcement-item <%= announcement.priority === 'high' ? 'urgent' : '' %> <%= announcement.isRead ? 'read' : 'unread' %>" 
                     data-id="<%= announcement._id %>"
                     onclick="openAnnouncementDetail('<%= announcement._id %>'); event.stopPropagation();"
                     style="cursor: pointer;">                  <div class="announcement-header-row">
                    <h4 class="announcement-title"><%= announcement.title %></h4>
                    <span class="announcement-date">
                      <%= new Date(announcement.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                    </span>
                  </div>
                  <% 
                    // Strip HTML tags for preview
                    const plainText = announcement.content.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').trim();
                    const previewText = plainText.length > 150 ? plainText.substring(0, 150) + '...' : plainText;
                  %>
                  <p class="announcement-message"><%= previewText %></p>
                  <div class="announcement-from">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                      <circle cx="12" cy="7" r="4"/>
                    </svg>
                    <span>From: <%= announcement.sentBy ? announcement.sentBy.fName + ' ' + announcement.sentBy.lName : 'Admin' %></span>
                  </div>
                  <% if (announcement.priority === 'high') { %>
                    <span class="announcement-badge urgent">Urgent</span>
                  <% } else if (announcement.priority === 'medium') { %>
                    <span class="announcement-badge info">Important</span>
                  <% } %>
                  <% if (!announcement.isRead) { %>
                    <span class="announcement-badge success" style="margin-left: 0.5rem;">New</span>
                  <% } %>
                </div>
              <% }); %>
            <% } else { %>
              <div class="no-announcements">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                  <path d="M13 11h.01M11 11h.01"/>
                </svg>
                <p>No announcements yet.</p>
                <span>Check back later for updates!</span>
                <div class="quick-tip">
                  <strong>Quick Tip:</strong> Remember to review and respond to assigned tasks promptly to meet deadlines!
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Row 2: Task Breakdown Pie Chart (Right) -->
        <div class="chart-card">
          <div class="chart-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.21 15.89A10 10 0 1 1 8.11 2.99"></path>
              <path d="M22 12A10 10 0 0 0 12 2v10z"></path>
            </svg>
            <h3>My Task Breakdown</h3>
          </div>
          <div class="chart-content">
