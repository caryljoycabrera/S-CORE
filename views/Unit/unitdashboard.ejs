        grid-column: 1;
        grid-row: 5;
      }

      /* Workload snapshot - spans full width */
      .workload-snapshot-card {
        grid-column: 1;
        grid-row: 6;
      }

      /* Table responsiveness - horizontal scrolling */
      .table-wrapper,
      .workload-table-wrapper {
        overflow-x: auto;
