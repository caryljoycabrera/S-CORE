<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= unitTeam %> Unit Dashboard - S-CORE</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/stylesheets/notifications.css" />
  <link rel="stylesheet" href="/stylesheets/unit-navbar.css" />
  <link rel="stylesheet" href="/stylesheets/modal-centered.css" />
  <link rel="stylesheet" href="/stylesheets/no-animations.css" />
  <link rel="stylesheet" href="/stylesheets/announcements-shared.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/unitdashboard-layout.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/unitdashboard-analytics.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="/javascripts/alert-handler.js"></script>
  <script src="/javascripts/unit-navbar.js"></script>
</head>
<body>
  <!-- Unit Sidebar Navigation -->
  <%- include('../partials/unit-navbar', { user: user, activePage: 'dashboard' }) %>

  <!-- MAIN CONTENT WITH HEADER -->
  <div class="unit-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="unit-menu-toggle" id="unitMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/unit/dashboard" class="text-wrapper">S-CORE UNIT</a>
      </div>
      
      <span class="text-wrapper-2">Welcome, <%= name %>!</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/unit/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

    <!-- DASHBOARD CONTENT -->
    <div class="student-side">
      <div class="div">

      <!-- Action Cards - Horizontal Row -->
      <div class="action-cards-section">
        <div class="action-card" onclick="location.href='/unit/all-tasks'">
          <div class="card-icon-wrapper">
            <img src="/Picture/Stats.png" alt="All Tasks" class="card-icon" />
            <div class="icon-glow"></div>
          </div>
          <h3 class="card-title">All Tasks</h3>
          <p class="card-subtitle">View all assigned tasks</p>
          <div class="card-arrow">→</div>
        </div>
        <div class="action-card" onclick="location.href='/unit/task-approvals'">
          <div class="card-icon-wrapper">
            <img src="/Picture/File.png" alt="Approval Tasks" class="card-icon" />
            <div class="icon-glow"></div>
          </div>
          <h3 class="card-title">Approval Tasks</h3>
          <p class="card-subtitle">Manage approval requests</p>
          <div class="card-arrow">→</div>
        </div>
        <div class="action-card" onclick="location.href='/unit/task-services'">
          <div class="card-icon-wrapper">
            <img src="/Picture/Repair.png" alt="Service Tasks" class="card-icon" />
            <div class="icon-glow"></div>
          </div>
          <h3 class="card-title">Service Tasks</h3>
          <p class="card-subtitle">Manage service requests</p>
          <div class="card-arrow">→</div>
        </div>
      </div>

      <!-- Task Management Guidelines - Moved here after action cards -->
      <div class="guidelines-container">
        <div class="guidelines-header" onclick="toggleGuidelines()" style="cursor: pointer;">
          <div class="guidelines-header-content">
            <div class="guidelines-title-group">
              <div class="guidelines-icon-wrapper">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </div>
              <div>
                <h4 class="guidelines-title">Task Management Guidelines</h4>
                <p class="guidelines-subtitle">Quick reference for efficient task handling</p>
              </div>
            </div>
            <span class="guidelines-toggle" id="guidelinesToggle">▼</span>
          </div>
        </div>

        <div class="guidelines-content" id="guidelinesContent" style="display: none;">
          <div class="guidelines-section">
            <h5 class="section-title">
              <span class="section-icon">⚡</span>
              Priority Management
            </h5>
            <ul class="guidelines-list">
              <li><strong>Urgent:</strong> Tasks with deadlines within 3 days</li>
              <li><strong>High Priority:</strong> Tasks requiring immediate attention</li>
              <li><strong>Regular:</strong> Tasks with standard processing time</li>
            </ul>
          </div>

          <div class="guidelines-section">
            <h5 class="section-title">
              <span class="section-icon">✓</span>
              Best Practices
            </h5>
            <ul class="guidelines-list">
              <li>Review task details thoroughly before approval</li>
              <li>Communicate clearly with requesters when revisions are needed</li>
              <li>Update task status promptly to maintain transparency</li>
              <li>Monitor deadlines regularly and plan work accordingly</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- UNIFIED DASHBOARD GRID -->
      <div class="dashboard-unified-grid">
        
        <!-- Row 1: Calendar (Left) -->
        <div class="calendar-standalone">
          <div class="calendar-header">
            <div style="display: flex; align-items: center;">
              <svg class="calendar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <h3 class="calendar-title">My Unit Calendar</h3>
            </div>
            <div class="calendar-controls">
              <button class="calendar-maximize-btn" id="calendar-maximize" aria-label="Maximize Calendar" title="Maximize Calendar">⛶</button>
              <div class="calendar-month-controls">
                <button class="calendar-nav-btn" id="calendar-prev-month" aria-label="Previous Month" title="Previous Month">❮</button>
                <span class="calendar-month-year" id="calendar-month-year"></span>
                <button class="calendar-nav-btn" id="calendar-next-month" aria-label="Next Month" title="Next Month">❯</button>
              </div>
            </div>
          </div>
          <div class="calendar-legend">
            <div class="legend-item">
              <div class="legend-dot approval"></div>
              <span class="legend-text">Request Approvals</span>
            </div>
            <div class="legend-item">
              <div class="legend-dot service"></div>
              <span class="legend-text">Service Requests</span>
            </div>
          </div>
          <div class="calendar-content">
            <div id="calendar-standalone" class="calendar-grid"></div>
          </div>
        </div>

        <!-- Row 1: Urgent Tasks (Right) -->
        <div class="urgent-tasks-panel">
          <div class="panel-header urgent">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <h3>My Urgent Tasks</h3>
          </div>
          
          <% if (urgentTasks && urgentTasks.length > 0) { %>
            <%
              const approvalTasks = urgentTasks.filter(t => !t.serviceType);
              const serviceTasks = urgentTasks.filter(t => t.serviceType);
              const hasApprovals = approvalTasks.length > 0;
              const hasServices = serviceTasks.length > 0;
            %>
            
            <!-- Tab Navigation -->
            <div class="urgent-tasks-tabs">
              <button class="urgent-tab-btn active" data-tab="approvals" onclick="switchUrgentTab('approvals')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 11l3 3L22 4"></path>
                  <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
                </svg>
                Approvals
                <% if (hasApprovals) { %>
                  <span class="tab-count"><%= approvalTasks.length %></span>
                <% } %>
              </button>
              <button class="urgent-tab-btn" data-tab="services" onclick="switchUrgentTab('services')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"></path>
                </svg>
                Services
                <% if (hasServices) { %>
                  <span class="tab-count"><%= serviceTasks.length %></span>
                <% } %>
              </button>
            </div>
            
            <!-- Tab Content -->
            <div class="urgent-tasks-tab-content">
              <!-- Approvals Tab -->
              <div class="urgent-tab-pane active" id="approvals-pane">
                <% if (hasApprovals) { %>
                  <div class="urgent-tasks-list">
                    <% approvalTasks.forEach(function(task) { %>
                      <div class="task-item-compact approval-task" data-task-id="<%= task._id %>" data-task-type="approval">
                        <div class="task-compact-header">
                          <h5 class="task-compact-title"><%= task.title || 'Untitled Task' %></h5>
                          <span class="task-badge approval">APPROVAL</span>
                        </div>
                        <div class="task-compact-info">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                          </svg>
                          <span><%= task.userId ? task.userId.fName + ' ' + task.userId.lName : 'Unknown' %></span>
                        </div>
                        <div class="task-compact-deadline">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                          </svg>
                          <span><%= new Date(task.deadline).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                        </div>
                        <button class="view-task-btn-compact approval" onclick="viewTaskDetails('<%= task._id %>', 'approval')">
                          View
                        </button>
                      </div>
                    <% }); %>
                  </div>
                <% } else { %>
                  <div class="no-tasks-column">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <p>No urgent approval requests</p>
                  </div>
                <% } %>
              </div>
              
              <!-- Services Tab -->
              <div class="urgent-tab-pane" id="services-pane">
                <% if (hasServices) { %>
                  <div class="urgent-tasks-list">
                    <% serviceTasks.forEach(function(task) { %>
                      <div class="task-item-compact service-task" data-task-id="<%= task._id %>" data-task-type="service">
                        <div class="task-compact-header">
                          <h5 class="task-compact-title"><%= task.title || task.serviceType || 'Untitled Task' %></h5>
                          <span class="task-badge service">SERVICE</span>
                        </div>
                        <div class="task-compact-info">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                          </svg>
                          <span><%= task.userId ? task.userId.fName + ' ' + task.userId.lName : 'Unknown' %></span>
                        </div>
                        <div class="task-compact-deadline">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                          </svg>
                          <span><%= new Date(task.deadline).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                        </div>
                        <button class="view-task-btn-compact service" onclick="viewTaskDetails('<%= task._id %>', 'service')">
                          View
                        </button>
                      </div>
                    <% }); %>
                  </div>
                <% } else { %>
                  <div class="no-tasks-column">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <p>No urgent service requests</p>
                  </div>
                <% } %>
              </div>
            </div>
          <% } else { %>
            <div class="panel-content">
              <div class="no-tasks">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
                <p>No urgent tasks!</p>
                <span>All caught up 🎉</span>
              </div>
            </div>
          <% } %>
        </div>

        <!-- Row 2: Announcements (Left) -->
        <div class="announcements-panel">
          <div class="announcements-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M11 5L6 9H2v6h4l5 4V5zM15.54 8.46a5 5 0 010 7.07M19.07 4.93a10 10 0 010 14.14"/>
            </svg>
            <h3>Announcements</h3>
          </div>
          <div class="announcements-content" id="announcements-content">
            <div class="no-announcements">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
                <path d="M13 11h.01M11 11h.01"/>
              </svg>
              <p>No announcements yet.</p>
              <span>Check back later for updates!</span>
              <div class="quick-tip">
                <strong>Quick Tip:</strong> Remember to review and respond to assigned tasks promptly to meet deadlines!
              </div>
            </div>
          </div>
        </div>

        <!-- Row 2: Task Breakdown Pie Chart (Right) -->
        <div class="chart-card">
          <div class="chart-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.21 15.89A10 10 0 1 1 8.11 2.99"></path>
              <path d="M22 12A10 10 0 0 0 12 2v10z"></path>
            </svg>
            <h3>My Task Breakdown</h3>
          </div>
          <div class="chart-content">
            <canvas id="taskBreakdownChart"></canvas>
          </div>
          <div class="chart-stats">
            <div class="stat-item">
              <div class="stat-label">Completion Rate:</div>
              <div class="stat-value"><%= (taskBreakdown && taskBreakdown.completionRate) || 0 %>%</div>
            </div>
            <div class="stat-item">
              <div class="stat-label">Active Tasks:</div>
              <div class="stat-value"><%= (taskBreakdown && taskBreakdown.totalActive) || 0 %></div>
            </div>
            <div class="stat-item">
              <div class="stat-label">Completed:</div>
              <div class="stat-value"><%= (taskBreakdown && taskBreakdown.totalCompleted) || 0 %></div>
            </div>
          </div>
        </div>

        <!-- Row 3: Organizations Requesting Services (Left) -->
        <div class="requester-chart-panel">
          <div class="panel-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 3v18h18"></path>
              <path d="M18 17V9"></path>
              <path d="M13 17V5"></path>
              <path d="M8 17v-3"></path>
            </svg>
            <h3>Organizations Requesting Services</h3>
          </div>
          <div class="panel-content">
            <% if (requesterCompliance && requesterCompliance.length > 0) { %>
              <div class="chart-wrapper">
                <canvas id="requesterChart"></canvas>
              </div>
              <div class="chart-legend-custom">
                <div class="legend-item-custom">
                  <div class="legend-color" style="background: #3b82f6;"></div>
                  <span>On-Time</span>
                </div>
                <div class="legend-item-custom">
                  <div class="legend-color" style="background: #eab308;"></div>
                  <span>Pending</span>
                </div>
                <div class="legend-item-custom">
                  <div class="legend-color" style="background: #ef4444;"></div>
                  <span>Overdue</span>
                </div>
              </div>
            <% } else { %>
              <div class="no-data">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 3v18h18"></path>
                  <path d="M18 17V9"></path>
                  <path d="M13 17V5"></path>
                  <path d="M8 17v-3"></path>
                </svg>
                <p>No requester data yet</p>
                <span>Request analytics will appear as requests are submitted</span>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Row 3: Workload Snapshot (Right) -->
        <div class="workload-snapshot-card">
          <div class="workload-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
              <polyline points="13 2 13 9 20 9"></polyline>
            </svg>
            <h3>My Unit's Workload Snapshot</h3>
          </div>
          <div class="workload-table-wrapper">
            <table class="workload-snapshot-table">
              <thead>
                <tr>
                  <th>Status Category</th>
                  <th style="text-align: center;">Total</th>
                  <th>Next Task Up (Most Urgent)</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    <strong>New Tasks (Pending)</strong>
                    <small>Tasks in your inbox, awaiting review.</small>
                  </td>
                  <td class="count-cell"><%= pendingRequests %></td>
                  <td class="task-cell">
                    <% if (urgentTasks && urgentTasks.length > 0) { %>
                      <strong><%= urgentTasks[0].title || urgentTasks[0].serviceType || 'Untitled Task' %></strong>
                      <small>from <%= urgentTasks[0].userId ? urgentTasks[0].userId.fName : 'Unknown' %> - Due <%= new Date(urgentTasks[0].deadline).toLocaleDateString() %></small>
                    <% } else { %>
                      <small>No pending tasks.</small>
                    <% } %>
                  </td>
                </tr>
                <tr>
                  <td>
                    <strong>Active Revisions</strong>
                    <small>Tasks waiting on feedback from requestor.</small>
                  </td>
                  <td class="count-cell"><%= inReviewRequests %></td>
                  <td class="task-cell">
                    <small>No tasks in revision.</small>
                  </td>
                </tr>
                <tr>
                  <td>
                    <strong>Completed (This Week)</strong>
                    <small>Tasks your unit has finished in the last 7 days.</small>
                  </td>
                  <td class="count-cell"><%= approvedRequests %></td>
                  <td class="task-cell">
                    <small>Great job!</small>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>
      <!-- End of Unified Dashboard Grid -->

      <%
      function timeAgo(date) {
        const now = new Date();
        const diff = now - new Date(date);
        const minutes = Math.floor(diff / 60000);
        const hours = Math.floor(minutes / 60);
        const days = Math.floor(hours / 24);
        
        if (minutes < 1) return 'Just now';
        if (minutes < 60) return `${minutes} min${minutes === 1 ? '' : 's'} ago`;
        if (hours < 24) return `${hours} hour${hours === 1 ? '' : 's'} ago`;
        return `${days} day${days === 1 ? '' : 's'} ago`;
      }
      %>
      
      <!-- NEW ANALYTICS SECTIONS -->
      
      <!-- Performance Metrics Cards -->
      <div class="metrics-cards-grid" style="margin-top: 2rem;">
        <div class="metric-card">
          <div class="metric-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
            <h4>Response Time</h4>
          </div>
          <div class="metric-value">24hrs</div>
          <div class="metric-label">Avg. First Response</div>
          <div class="metric-trend positive">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
            </svg>
            <span>12% faster this week</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <h4>Completion Rate</h4>
          </div>
          <div class="metric-value"><%= taskBreakdown.completionRate || 0 %>%</div>
          <div class="metric-label">Tasks Completed On Time</div>
          <div class="metric-trend positive">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
            </svg>
            <span>Excellent performance</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 00-3-3.87"></path>
              <path d="M16 3.13a4 4 0 010 7.75"></path>
            </svg>
            <h4>Team Workload</h4>
          </div>
          <div class="metric-value"><%= totalRequests || 0 %></div>
          <div class="metric-label">Active Tasks</div>
          <div class="metric-trend <%= (totalRequests || 0) > 20 ? 'warning' : 'neutral' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span><%= (totalRequests || 0) > 20 ? 'High workload' : 'Manageable load' %></span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path>
            </svg>
            <h4>Revision Rate</h4>
          </div>
          <div class="metric-value"><%= Math.round(((inReviewRequests || 0) / Math.max(totalRequests || 1, 1)) * 100) %>%</div>
          <div class="metric-label">Tasks Needing Revision</div>
          <div class="metric-trend <%= ((inReviewRequests || 0) / Math.max(totalRequests || 1, 1)) > 0.2 ? 'warning' : 'positive' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span><%= ((inReviewRequests || 0) / Math.max(totalRequests || 1, 1)) > 0.2 ? 'Review needed' : 'Good quality' %></span>
          </div>
        </div>
      </div>

      <!-- Task Timeline - Line Chart -->
      <div class="timeline-chart-card" style="margin-top: 2rem;">
        <div class="chart-header">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
          <h3>Task Activity Timeline (Last 7 Days)</h3>
        </div>
        <div class="chart-content">
          <canvas id="taskTimelineChart"></canvas>
        </div>
      </div>

      <!-- Recent Activity Table -->
      <div class="recent-activity-table-card" style="margin-top: 2rem;">
        <div class="table-header">
          <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
            <h3>Recent Activity</h3>
          </div>
          <a href="/unit/all-tasks" class="view-all-link">View All →</a>
        </div>
        <div class="table-wrapper">
          <table class="activity-table">
            <thead>
              <tr>
                <th>Task</th>
                <th>Type</th>
                <th>Status</th>
                <th>Updated</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentActivity && recentActivity.length > 0) { %>
                <% recentActivity.slice(0, 5).forEach(activity => { %>
                  <tr>
                    <td>
                      <div class="task-title-cell"><%= activity.title %></div>
                      <div class="task-desc-cell"><%= activity.description.substring(0, 50) %>...</div>
                    </td>
                    <td><span class="type-badge <%= activity.type %>"><%= activity.type === 'approval' ? 'Approval' : 'Service' %></span></td>
                    <td><span class="status-badge <%= activity.status.toLowerCase().replace(' ', '-') %>"><%= activity.status %></span></td>
                    <td class="date-cell"><%= new Date(activity.updatedAt).toLocaleDateString() %></td>
                    <td><button class="action-btn-small" onclick="location.href='/unit/<%= activity.type === 'approval' ? 'task-approvals' : 'task-services' %>'">View</button></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="no-data-cell">No recent activity</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Help & Guide Card -->
      <div class="guide-card-container" style="margin-top: 24px;">
        <a href="/unit/guide" class="dashboard-guide-card">
          <div class="guide-card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <div class="guide-card-content">
            <h3>Need Help?</h3>
            <p>Check out the unit team guide to learn how to manage tasks effectively</p>
          </div>
          <div class="guide-card-arrow">→</div>
        </a>
      </div>

    </div>
  </div>
  </div>
  <!-- End of user-main-content -->

  <!-- Calendar Modal -->
  <div class="calendar-modal" id="calendar-modal">
    <div class="calendar-modal-content">
      <!-- Modal Calendar Header -->
      <div class="calendar-header">
        <div style="display: flex; align-items: center;">
          <svg class="calendar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <h3 class="calendar-title">Calendar</h3>
        </div>
        <div class="calendar-controls">
          <button class="calendar-maximize-btn" id="calendar-minimize" aria-label="Minimize Calendar" title="Minimize Calendar">
            ✕
          </button>
          <div class="calendar-month-controls">
            <button class="calendar-nav-btn" id="calendar-modal-prev-month" aria-label="Previous Month" title="Previous Month">
              ❮
            </button>
            <span class="calendar-month-year" id="calendar-modal-month-year"></span>
            <button class="calendar-nav-btn" id="calendar-modal-next-month" aria-label="Next Month" title="Next Month">
              ❯
            </button>
          </div>
        </div>
      </div>
      
      <!-- Modal Calendar Legend -->
      <div class="calendar-legend">
        <div class="legend-item">
          <div class="legend-dot approval"></div>
          <span class="legend-text">Request Approvals</span>
        </div>
        <div class="legend-item">
          <div class="legend-dot service"></div>
          <span class="legend-text">Service Requests</span>
        </div>
      </div>
      <!-- Modal Calendar Content -->
      <div class="calendar-content">
        <div id="calendar-modal-grid" class="calendar-grid"></div>
      </div>
    </div>
  </div>

  

  <!-- Deadline Details Modal -->
  <div class="deadline-details-modal" id="deadline-details-modal">
    <div class="deadline-details-content">
      <!-- Deadline Details Header -->
      <div class="deadline-details-header">
        <div>
          <h2 class="deadline-details-title">My Deadlines</h2>
          <p class="deadline-details-date" id="deadline-details-date"></p>
        </div>
      </div>
      
      <!-- Deadline Details Controls -->
      <div class="deadline-details-controls">
        <button class="deadline-control-btn" id="back-to-calendar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15,18 9,12 15,6"></polyline>
          </svg>
          Back to Calendar
        </button>
        <button class="deadline-control-btn close-btn" id="close-deadline-details">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          Close
        </button>
      </div>
      
      <!-- Deadline List -->
      <div class="deadline-list" id="deadline-list">
        <!-- Deadline items will be populated here -->
      </div>
    </div>
  </div>



  <!-- Include Scripts -->
  <script src="/javascripts/notifications.js"></script>
  
  <!-- Chart.js Data -->
  <script>
    const taskBreakdownData = {
      labels: <%- JSON.stringify((taskBreakdown && taskBreakdown.labels) || ['No Tasks']) %>,
      data: <%- JSON.stringify((taskBreakdown && taskBreakdown.data) || [1]) %>,
      totalActive: <%= (taskBreakdown && taskBreakdown.totalActive) || 0 %>,
      totalCompleted: <%= (taskBreakdown && taskBreakdown.totalCompleted) || 0 %>,
      completionRate: <%= (taskBreakdown && taskBreakdown.completionRate) || 0 %>
    };

    const requesterComplianceData = <%- JSON.stringify(requesterCompliance || []) %>;
    
    const taskTimeline = <%- JSON.stringify(taskTimeline || []) %>;

    // Urgent Tasks Tab Switching
    function switchUrgentTab(tabName) {
      // Remove active class from all tab buttons and panes
      document.querySelectorAll('.urgent-tab-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      document.querySelectorAll('.urgent-tab-pane').forEach(pane => {
        pane.classList.remove('active');
      });
      
      // Add active class to selected tab button and pane
      const tabBtn = document.querySelector(`.urgent-tab-btn[data-tab="${tabName}"]`);
      const tabPane = document.getElementById(`${tabName}-pane`);
      
      if (tabBtn) tabBtn.classList.add('active');
      if (tabPane) tabPane.classList.add('active');
    }
  </script>
  
  <script src="/javascripts/ejs/Unit/unitdashboard.js"></script>
</body>
</html>