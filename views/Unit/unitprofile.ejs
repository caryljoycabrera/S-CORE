<!-- ===========================================
     JAVASCRIPT CONNECTION
     ===========================================
     This page includes JavaScript functionality from:
     - public/javascripts/shared-data.js (centralized data arrays)
     - public/javascripts/ejs/Unit/unitprofile.js (main client-side logic)
     Note: Socket.IO is loaded via the notifications partial
     Note: notifications.js is already loaded in the notifications partial
     =========================================== -->
<script src="/javascripts/shared-data.js"></script>
<script src="/javascripts/ejs/Unit/unitprofile.js"></script>

<script>
// Sidebar hover effect - Unit sidebar uses different behavior (handled in unit-navbar.js)
// No need for manual hover effect here

// OVERRIDE openModal function with EJS template support
function openModal(id) {
  console.log('=== OPENING MODAL ===');
  console.log('Modal ID:', id);
  console.log('User Type:', '<%= user.userType %>');
  
  const modal = document.getElementById(id);
  if (!modal) {
    console.error('ERROR: Modal element not found:', id);
    return;
  }
  
  modal.style.display = 'flex';
  console.log('Modal display set to flex');

  // Student logic with enhanced functionality
  if (id === 'updateProfileModal' && '<%= user.userType %>' === 'student') {
    console.log('=== INITIALIZING STUDENT ORGANIZATION DROPDOWN ===');
    console.log('Initializing student organization select for student user');
    const select = $('#studentOrganization');
    
    if (!select.length) {
      console.error('ERROR: Student organization select element not found');
      return;
    }
    
    console.log('Select element found:', select.length, 'elements');
    
    if (!select.hasClass('select2-hidden-accessible')) {
      console.log('Select2 not yet initialized, initializing now...');
      
      // Check if shared-data.js is loaded
      console.log('🔍 Checking shared-data.js availability:');
      console.log('   - window.studentOrgsArray exists?', typeof window.studentOrgsArray !== 'undefined');
      console.log('   - window.affiliationsArray exists?', typeof window.affiliationsArray !== 'undefined');
      
      // Use the organization options from shared-data.js
      const organizationOptions = window.studentOrgsArray || [];
      console.log('Organization options loaded:', organizationOptions.length, 'items');
      
      if (organizationOptions.length === 0) {
        console.warn('WARNING: No organization options found in shared-data.js');
        console.warn('   - Checking if script is loaded...');
        console.warn('   - window object keys:', Object.keys(window).filter(k => k.includes('Org') || k.includes('affiliation')));
      }

      const currentOrgs = `<%= user.studentOrganization || '' %>`
        .split(',')
        .map(o => o.trim())
        .filter(Boolean);
      
      console.log('Current user organizations:', currentOrgs);

      // Clear existing options first
      select.empty();
      console.log('Select cleared');

      // Add predefined options
      let addedCount = 0;
      organizationOptions.forEach(org => {
        const exists = currentOrgs.includes(org);
        const option = new Option(org, org, exists, exists);
        select.append(option);
        if (exists) addedCount++;
      });
      console.log('Added', organizationOptions.length, 'organization options,', addedCount, 'pre-selected');

      // Add custom organizations
      let customCount = 0;
      currentOrgs.forEach(org => {
        if (!organizationOptions.includes(org)) {
          const option = new Option(org, org, true, true);
          select.append(option);
          customCount++;
        }
      });
      
      if (customCount > 0) {
        console.log('Added', customCount, 'custom organizations');
      }

      // NOW initialize Select2 AFTER adding all options
      console.log('Initializing Select2 with modal parent...');
      select.select2({
        placeholder: "Search and select organizations...",
        allowClear: true,
        width: '100%',
        dropdownParent: $('#updateProfileModal'),
        closeOnSelect: false,
        dropdownCssClass: 'select2-dropdown-above-modal',
        templateResult: function(data) {
          if (!data.id) return data.text;
          return $(`<div style="padding: 4px 0;">${data.text}</div>`);
        }
      });
      
      console.log('Select2 initialized successfully');

      select.trigger('change');
      console.log('Triggered change event');
      
      updateOrganizationCounter();
      console.log('Organization counter updated');

      // Listen for selection changes
      select.on('change', function() {
        const selectedCount = select.val()?.length || 0;
        console.log('Organization selection changed:', selectedCount, 'items selected');
        updateOrganizationCounter();
        // Re-setup click handlers after any change
        setTimeout(setupOrganizationClickHandlers, 100);
      });

      // Initial setup of click handlers
      setTimeout(setupOrganizationClickHandlers, 200);
      console.log('Click handlers setup scheduled');
    } else {
      console.log('Select2 already initialized, skipping');
    }

    // Set up toggle functionality
    const toggleBtn = document.getElementById('toggleCustomOrg');
    if (toggleBtn) {
      toggleBtn.onclick = toggleCustomOrg;
      console.log('Toggle custom org button handler set');
    } else {
      console.error('ERROR: Toggle custom org button not found');
    }

    // Set up add organization button
    const addBtn = document.getElementById('addOrganizationButton');
    if (addBtn) {
      addBtn.onclick = addCustomOrganization;
      console.log('Add organization button handler set');
    } else {
      console.error('ERROR: Add organization button not found');
    }

    // Set up Enter key functionality
    const orgInput = document.getElementById('otherOrganization');
    if (orgInput) {
      orgInput.onkeypress = function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          addCustomOrganization();
        }
      };
      console.log('Enter key handler set for organization input');
    } else {
      console.error('ERROR: Organization input field not found');
    }
    
    console.log('=== STUDENT DROPDOWN INITIALIZATION COMPLETE ===');
  }

  // NON-STUDENT LOGIC - Fixed version for multiple selection
  if (id === 'updateProfileModal' && '<%= user.userType %>' !== 'student') {
    console.log('=== ADMIN: INITIALIZING OFFICE/DEPT DROPDOWN (NON-STUDENT) ===');
    const select = $('#officeSelect');
    
    if (!select.length) {
      console.error('ERROR: Office select element not found');
      return;
    }
    
    console.log('Office select element found:', select.length, 'elements');
    
    // Only initialize if not already initialized
    if (!select.hasClass('select2-hidden-accessible')) {
      console.log('Initializing office select for non-student user');
      
      // Check if shared-data.js is loaded
      console.log('🔍 Checking shared-data.js availability for office:');
      console.log('   - window.affiliationsArray exists?', typeof window.affiliationsArray !== 'undefined');
      
      // Use the office options from shared-data.js
      const officeOptions = window.affiliationsArray || [];
      console.log('Office options loaded:', officeOptions.length, 'items');
      
      if (officeOptions.length === 0) {
        console.warn('WARNING: No office options found in shared-data.js');
        console.warn('   - window object keys:', Object.keys(window).filter(k => k.includes('Org') || k.includes('affiliation')));
      }

      // Get current affiliations from server
      const currentAffiliations = `<%= user.affiliation || '' %>`
        .split(',')
        .map(o => o.trim())
        .filter(Boolean);

      console.log('Current user affiliations:', currentAffiliations);

      // Clear any existing options first
      select.empty();
      console.log('Office select cleared');

      // Add predefined office options
      let preSelectedCount = 0;
      officeOptions.forEach(office => {
        const isSelected = currentAffiliations.includes(office);
        const option = new Option(office, office, isSelected, isSelected);
        select.append(option);
        if (isSelected) preSelectedCount++;
      });
      console.log('Added', officeOptions.length, 'office options,', preSelectedCount, 'pre-selected');

      // Add any custom affiliations not in the predefined list
      let customAffiliationCount = 0;
      currentAffiliations.forEach(affiliation => {
        if (!officeOptions.includes(affiliation)) {
          const option = new Option(affiliation, affiliation, true, true);
          select.append(option);
          customAffiliationCount++;
        }
      });
      
      if (customAffiliationCount > 0) {
        console.log('Added', customAffiliationCount, 'custom affiliations');
      }

      // Initialize Select2 AFTER adding all options
      console.log('Initializing Select2 for office dropdown...');
      select.select2({
        placeholder: "Search and select office/department...",
        allowClear: true,
        width: '100%',
        dropdownParent: $('#updateProfileModal'),
        closeOnSelect: false,
        dropdownCssClass: 'select2-dropdown-above-modal',
        templateResult: function(data) {
          if (!data.id) return data.text;
          return $(`<div style="padding: 4px 0;">${data.text}</div>`);
        }
      });
      
      console.log('Select2 initialized successfully for office dropdown');

      // Add Select2 event listeners for debugging and z-index fixing
      select.on('select2:opening', function(e) {
        console.log('🔓 ADMIN: Office Select2 OPENING');
      });
      
      select.on('select2:open', function(e) {
        console.log('✅ ADMIN: Office Select2 OPENED');
        
        // Debug and fix z-index
        setTimeout(function() {
          const dropdown = $('.select2-dropdown');
          console.log('🔍 ADMIN: Office Dropdown z-index:', dropdown.css('z-index'));
          
          const currentZIndex = parseInt(dropdown.css('z-index')) || 0;
          if (currentZIndex < 9999) {
            console.warn('⚠️  WARNING: Office dropdown z-index too low! Forcing to 9999');
            dropdown.css({'z-index': '9999', 'position': 'absolute'});
            console.log('   - ✅ New office dropdown z-index:', dropdown.css('z-index'));
          }
        }, 100);
      });
      
      select.on('select2:closing', function(e) {
        console.log('🔒 ADMIN: Office Select2 CLOSING');
      });
      
      select.on('select2:close', function(e) {
        console.log('❌ ADMIN: Office Select2 CLOSED');
      });

      // Trigger change to update display
      select.trigger('change');

      console.log('Office select initialized with', select.val()?.length || 0, 'selections');

      // Listen for selection changes
      select.on('change', function() {
        const selectedCount = select.val()?.length || 0;
        console.log('Office selection changed:', selectedCount, 'items selected');
        updateOfficeCounter();
        // Re-setup click handlers after any change
        setTimeout(setupOfficeClickHandlers, 100);
      });

      // Initial setup of click handlers and counter
      updateOfficeCounter();
      console.log('Office counter updated');
      setTimeout(setupOfficeClickHandlers, 200);
      console.log('Office click handlers setup scheduled');
    } else {
      console.log('Office Select2 already initialized, skipping');
    }
    
    // Set up toggle functionality for custom office
    const toggleOfficeBtn = document.getElementById('toggleCustomOfficeBtn');
    if (toggleOfficeBtn) {
      toggleOfficeBtn.onclick = toggleCustomOffice;
      console.log('Toggle custom office button handler set');
    } else {
      console.error('ERROR: Toggle custom office button not found');
    }
    
    // Set up add office button
    const addOfficeBtn = document.getElementById('addOfficeButton');
    if (addOfficeBtn) {
      addOfficeBtn.onclick = addCustomOffice;
      console.log('Add office button handler set');
    } else {
      console.error('ERROR: Add office button not found');
    }
    
    // Set up Enter key functionality
    const officeInput = document.getElementById('otherOffice');
    if (officeInput) {
      officeInput.onkeypress = function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          addCustomOffice();
        }
      };
      console.log('Enter key handler set for office input');
    } else {
      console.error('ERROR: Office input field not found');
    }
    
    console.log('=== OFFICE/DEPT DROPDOWN INITIALIZATION COMPLETE ===');
  }
  
  console.log('=== MODAL OPENED SUCCESSFULLY ===\n');
}

// Organization counter update
function updateOrganizationCounter() {
  const select = $('#studentOrganization');
  const counter = document.getElementById('orgCounter');
  if (!counter) return;
  
  const selectedCount = select.val()?.length || 0;
  
  if (selectedCount === 0) {
    counter.textContent = 'No organizations selected';
    counter.classList.remove('has-selections');
  } else if (selectedCount === 1) {
    counter.textContent = '1 organization selected';
    counter.classList.add('has-selections');
  } else {
    counter.textContent = `${selectedCount} organizations selected`;
    counter.classList.add('has-selections');
  }
}

// Organization click handlers
function setupOrganizationClickHandlers() {
  $(document).off('click', '#studentOrganization + .select2-container .select2-selection__choice');
  
  $(document).on('click', '#studentOrganization + .select2-container .select2-selection__choice', function(e) {
    e.preventDefault();
    e.stopPropagation();
    
    const $choice = $(this);
    const value = $choice.attr('title');
    const select = $('#studentOrganization');
    
    if (value) {
      let currentValues = select.val() || [];
      currentValues = currentValues.filter(v => v !== value);
      select.val(currentValues).trigger('change');
      updateOrganizationCounter();
    }
  });
}

// Toggle custom organization input
function toggleCustomOrg() {
  const customOrgContainer = document.getElementById('customOrgSection');
  const isVisible = customOrgContainer.style.display !== 'none';
  customOrgContainer.style.display = isVisible ? 'none' : 'block';
  
  if (!isVisible) {
    document.getElementById('otherOrganization').focus();
  } else {
    document.getElementById('otherOrganization').value = '';
    hideFeedback();
  }
}

// Add custom organization
function addCustomOrganization() {
  const input = document.getElementById('otherOrganization');
  const orgName = input.value.trim();
  const select = $('#studentOrganization');

  if (!orgName) {
    showFeedback('Please enter an organization name.', 'error');
    input.focus();
    return;
  }
  
  if (orgName.length < 3) {
    showFeedback('Organization name must be at least 3 characters long.', 'error');
    input.focus();
    return;
  }

  const existingOptions = Array.from(select[0].options).map(option => option.value.toLowerCase());
  if (existingOptions.includes(orgName.toLowerCase())) {
    showFeedback('This organization is already in your list.', 'warning');
    input.focus();
    return;
  }

  if (select.find(`option[value="${orgName}"]`).length === 0) {
    const newOption = new Option(orgName, orgName, true, true);
    select.append(newOption);
  }

  const current = select.val() || [];
  if (!current.includes(orgName)) {
    current.push(orgName);
    select.val(current).trigger('change');
  }

  input.value = '';
  showFeedback(`"${orgName}" has been added successfully!`, 'success');
  updateOrganizationCounter();
  
  setTimeout(hideFeedback, 3000);
}

// Organization feedback system
function showFeedback(message, type = 'success') {
  const feedback = document.getElementById('orgAddedFeedback');
  if (feedback) {
    feedback.textContent = message;
    feedback.className = 'org-added-feedback ' + type;
    feedback.style.display = 'block';
  }
}

function hideFeedback() {
  const feedback = document.getElementById('orgAddedFeedback');
  if (feedback) {
    feedback.style.display = 'none';
    feedback.textContent = '';
    feedback.className = 'org-added-feedback';
  }
}

// Office counter update
function updateOfficeCounter() {
  const select = $('#officeSelect');
  const counter = document.getElementById('officeCounter');
  if (!counter) return;
  
  const selectedCount = select.val()?.length || 0;
  
  if (selectedCount === 0) {
    counter.textContent = 'No offices selected';
    counter.classList.remove('has-selections');
  } else if (selectedCount === 1) {
    counter.textContent = '1 office selected';
    counter.classList.add('has-selections');
  } else {
    counter.textContent = `${selectedCount} offices selected`;
    counter.classList.add('has-selections');
  }
}

