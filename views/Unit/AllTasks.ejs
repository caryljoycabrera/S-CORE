  <script>
  // ==========================================
  // FORMATTING FUNCTIONS - Consistent across all modals
  // ==========================================
  window.applyUnitFormatting = function(format) {
    const input = document.getElementById('teamMessageInput');
    if (!input) return;
    
    const start = input.selectionStart;
    const end = input.selectionEnd;
    const selectedText = input.value.substring(start, end);
    
    if (!selectedText) {
      alert('Please select text to format');
      return;
    }
    
    let formattedText = '';
    if (format === 'bold') formattedText = `**${selectedText}**`;
    else if (format === 'italic') formattedText = `*${selectedText}*`;
    else if (format === 'underline') formattedText = `<u>${selectedText}*</u>`;
    
    const newValue = input.value.substring(0, start) + formattedText + input.value.substring(end);
    input.value = newValue;
    
    const newCursorPos = start + formattedText.length;
    input.setSelectionRange(newCursorPos, newCursorPos);
    input.focus();
  };
  
  // ===== QUILL RICH TEXT EDITORS =====
  // Text formatting functions for Unit side
  document.addEventListener('DOMContentLoaded', function() {
    // Format text helper function
    function insertFormattingTags(textarea, startTag, endTag) {
      if (!textarea) return;
      
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const selectedText = textarea.value.substring(start, end);
      const beforeText = textarea.value.substring(0, start);
      const afterText = textarea.value.substring(end);
      
      // Insert formatted text
      textarea.value = beforeText + startTag + selectedText + endTag + afterText;
      
      // Position cursor - if no text selected, place between tags; if text selected, place after
      let newPosition;
      if (selectedText.length === 0) {
        newPosition = start + startTag.length;
      } else {
        newPosition = start + startTag.length + selectedText.length + endTag.length;
      }
      textarea.setSelectionRange(newPosition, newPosition);
      textarea.focus();
    }
    
    // Team message formatting - use event delegation
    document.addEventListener('click', function(e) {
      const target = e.target.closest('[data-chat-format]');
      if (target) {
        e.preventDefault();
        e.stopPropagation();
        const teamMessageInput = document.getElementById('teamMessageInput');
        if (!teamMessageInput) return;
        
        const format = target.getAttribute('data-chat-format');
        if (format === 'bold') {
          insertFormattingTags(teamMessageInput, '**', '**');
        } else if (format === 'italic') {
          insertFormattingTags(teamMessageInput, '*', '*');
        } else if (format === 'underline') {
          insertFormattingTags(teamMessageInput, '<u>', '</u>');
        }
      }
    });
    
    // Revision comments formatting - use event delegation
    document.addEventListener('click', function(e) {
      const target = e.target.closest('[data-revision-format]');
      if (target) {
        e.preventDefault();
        e.stopPropagation();
        console.log('[AllTasks] Revision format button clicked:', target.getAttribute('data-revision-format'));
        
        const revisionCommentsInput = document.getElementById('revisionComments');
        if (!revisionCommentsInput) {
          console.error('[AllTasks] Revision comments textarea not found');
          return;
        }
        
        console.log('[AllTasks] Textarea found, applying format');
        const format = target.getAttribute('data-revision-format');
        if (format === 'bold') {
          insertFormattingTags(revisionCommentsInput, '**', '**');
        } else if (format === 'italic') {
          insertFormattingTags(revisionCommentsInput, '*', '*');
        } else if (format === 'underline') {
          insertFormattingTags(revisionCommentsInput, '<u>', '</u>');
        }
      }
    });
    
    // Attach button handlers
    const chatAttachBtn = document.getElementById('chatAttachBtn');
    const chatFileInput = document.getElementById('chatFileInput');
    if (chatAttachBtn && chatFileInput) {
      chatAttachBtn.addEventListener('click', function(e) {
        e.preventDefault();
        chatFileInput.click();
      });
    }
    
    const revisionAttachBtn = document.getElementById('revisionAttachBtn');
    const revisionFileInput = document.getElementById('revisionFileInput');
    if (revisionAttachBtn && revisionFileInput) {
      revisionAttachBtn.addEventListener('click', function(e) {
        e.preventDefault();
        revisionFileInput.click();
      });
    }
    
    // Keyboard shortcuts for team message - use event delegation
    document.addEventListener('keydown', function(e) {
      const teamMessageInput = document.getElementById('teamMessageInput');
      if (teamMessageInput && document.activeElement === teamMessageInput) {
        if (e.ctrlKey && !e.shiftKey && !e.altKey) {
          if (e.key === 'b' || e.key === 'B') {
            e.preventDefault();
            insertFormattingTags(teamMessageInput, '**', '**');
          } else if (e.key === 'i' || e.key === 'I') {
            e.preventDefault();
            insertFormattingTags(teamMessageInput, '*', '*');
          } else if (e.key === 'u' || e.key === 'U') {
            e.preventDefault();
            insertFormattingTags(teamMessageInput, '<u>', '</u>');
          }
        }
      }
    });
    
    // Keyboard shortcuts for revision comments - use event delegation
    document.addEventListener('keydown', function(e) {
      const revisionCommentsInput = document.getElementById('revisionComments');
      if (revisionCommentsInput && document.activeElement === revisionCommentsInput) {
        if (e.ctrlKey && !e.shiftKey && !e.altKey) {
          if (e.key === 'b' || e.key === 'B') {
            e.preventDefault();
            insertFormattingTags(revisionCommentsInput, '**', '**');
          } else if (e.key === 'i' || e.key === 'I') {
            e.preventDefault();
            insertFormattingTags(revisionCommentsInput, '*', '*');
          } else if (e.key === 'u' || e.key === 'U') {
            e.preventDefault();
            insertFormattingTags(revisionCommentsInput, '<u>', '</u>');
          }
        }
      }
    });
  });
  
  // ==========================================
  // DYNAMIC CALENDAR FUNCTIONALITY
  // ==========================================
  
  // Calendar implementation
  function createDynamicCalendar() {
    const calendarContainer = document.getElementById('taskCalendar');
    if (!calendarContainer) return;
    
    const now = new Date();
    const currentMonth = now.getMonth();
    const currentYear = now.getFullYear();
    
    // Create calendar grid
    const calendar = document.createElement('div');
    calendar.style.cssText = `
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 1px;
      background: #e5e7eb;
      border-radius: 6px;
      overflow: hidden;
      width: 100%;
      max-width: 500px;
      margin: 0 auto;
    `;
    
    // Add day headers
    const dayHeaders = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    dayHeaders.forEach(day => {
      const header = document.createElement('div');
      header.textContent = day;
      header.style.cssText = `
        background: #f3f4f6;
        padding: 0.5rem;
        text-align: center;
        font-weight: 600;
        font-size: 0.875rem;
        color: #374151;
      `;
      calendar.appendChild(header);
    });
    
    // Get first day of month and number of days
    const firstDay = new Date(currentYear, currentMonth, 1).getDay();
    const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
    
    // Add empty cells for days before month starts
    for (let i = 0; i < firstDay; i++) {
      const emptyCell = document.createElement('div');
      emptyCell.style.cssText = `
        background: white;
        padding: 0.5rem;
        min-height: 40px;
      `;
      calendar.appendChild(emptyCell);
    }
    
    // Add days of the month
    for (let day = 1; day <= daysInMonth; day++) {
      const dayCell = document.createElement('div');
      const isToday = day === now.getDate() && currentMonth === now.getMonth() && currentYear === now.getFullYear();
      
      dayCell.style.cssText = `
        background: white;
        padding: 0.5rem;
        min-height: 40px;
        position: relative;
        cursor: pointer;
        transition: background-color 0.2s;
        border: ${isToday ? '2px solid #10b981' : 'none'};
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
      `;
      
      // Add day number
      const dayNumber = document.createElement('span');
      dayNumber.textContent = day;
      dayNumber.style.cssText = `
        font-size: 0.875rem;
        font-weight: ${isToday ? '600' : '400'};
        color: ${isToday ? '#059669' : '#374151'};
        margin-bottom: 2px;
      `;
      dayCell.appendChild(dayNumber);
      
      // Add data attribute for date - format as YYYY-MM-DD in local timezone (Asia/Manila)
      const year = currentYear;
      const month = String(currentMonth + 1).padStart(2, '0');
      const dayStr = String(day).padStart(2, '0');
      const dateStr = `${year}-${month}-${dayStr}`;
      dayCell.setAttribute('data-date', dateStr);
      
      // Hover effect
      dayCell.addEventListener('mouseenter', () => {
        if (!isToday) dayCell.style.background = '#f9fafb';
      });
      dayCell.addEventListener('mouseleave', () => {
        if (!isToday) dayCell.style.background = 'white';
      });
      
      calendar.appendChild(dayCell);
    }
    
    calendarContainer.innerHTML = '';
    calendarContainer.appendChild(calendar);
    
    // Load deadline data
    loadCalendarDeadlines();
  }
  
  // Load deadline data from API
  async function loadCalendarDeadlines() {
    try {
      const response = await fetch('/api/unit-deadlines');
      const deadlines = await response.json();
      
      // Add badges to calendar days
      Object.entries(deadlines).forEach(([date, counts]) => {
        const dayCell = document.querySelector(`[data-date="${date}"]`);
        if (!dayCell) return;
        
        // Create badge container
        const badgeContainer = document.createElement('div');
        badgeContainer.style.cssText = `
          display: flex;
          gap: 2px;
          margin-top: 2px;
        `;
        
        // Add approval badge if any
        if (counts.approvals > 0) {
          const approvalBadge = document.createElement('span');
          approvalBadge.textContent = counts.approvals;
          approvalBadge.className = 'calendar-date-badge approval';
          approvalBadge.style.cssText = `
            background: #ef4444;
            color: white;
            font-size: 0.625rem;
            padding: 1px 4px;
            border-radius: 10px;
            min-width: 12px;
            text-align: center;
            line-height: 1.2;
          `;
          approvalBadge.title = `${counts.approvals} approval deadline${counts.approvals > 1 ? 's' : ''}`;
          badgeContainer.appendChild(approvalBadge);
        }
        
        // Add service badge if any
        if (counts.services > 0) {
          const serviceBadge = document.createElement('span');
          serviceBadge.textContent = counts.services;
          serviceBadge.className = 'calendar-date-badge service';
          serviceBadge.style.cssText = `
            background: #3b82f6;
            color: white;
            font-size: 0.625rem;
            padding: 1px 4px;
            border-radius: 10px;
            min-width: 12px;
            text-align: center;
            line-height: 1.2;
          `;
          serviceBadge.title = `${counts.services} service deadline${counts.services > 1 ? 's' : ''}`;
          badgeContainer.appendChild(serviceBadge);
        }
        
        if (badgeContainer.children.length > 0) {
          dayCell.appendChild(badgeContainer);
          dayCell.style.cursor = 'pointer';
          
          // Add click handler for day with deadlines
          dayCell.addEventListener('click', () => {
            showDateDeadlines(date, counts);
          });
        }
      });
    } catch (error) {
      console.error('Error loading calendar deadlines:', error);
      document.getElementById('taskCalendar').innerHTML = `
        <div style="text-align: center; color: #ef4444; padding: 2rem;">
          <p>Unable to load calendar data</p>
          <button onclick="createDynamicCalendar()" style="background: #3b82f6; color: white; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer;">
            Retry
          </button>
        </div>
      `;
    }
  }
  
  // Show deadline details for a specific date
  async function showDateDeadlines(date, counts) {
    try {
      const response = await fetch(`/api/unit-deadlines/${date}/details`);
      const details = await response.json();
      
      alert(`Tasks due on ${new Date(date).toLocaleDateString()}:\\n` +
            `• ${details.approvalRequests.length} approval request(s)\\n` +
            `• ${details.serviceRequests.length} service request(s)\\n\\n` +
            `Click on tasks in the table below to view details.`);
      
      // Optionally filter the table to show only tasks for this date
      // This would require integration with the existing filter functionality
      
    } catch (error) {
      console.error('Error fetching date details:', error);
      alert('Unable to load deadline details for this date.');
    }
  }
  
  // Initialize calendar when page loads
  document.addEventListener('DOMContentLoaded', function() {
    // Add a slight delay to ensure all other elements are loaded
    setTimeout(createDynamicCalendar, 100);
  });
  
  </script>
  <script>
    window.filterDataFromDatabase = {
      requestStatuses: <%- JSON.stringify(typeof requestStatuses !== 'undefined' ? requestStatuses : []) %>,
      organizations: <%- JSON.stringify(typeof organizations !== 'undefined' ? organizations : []) %>,
      offices: <%- JSON.stringify(typeof offices !== 'undefined' ? offices : []) %>,
      units: <%- JSON.stringify(typeof units !== 'undefined' ? units : []) %>
    };
  </script>
  <script src="/javascripts/status-handler.js"></script>
</body>
</html>
