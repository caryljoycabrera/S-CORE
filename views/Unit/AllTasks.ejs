<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>All Assigned Tasks - <%= unitTeam %> Unit</title>

  <!-- Base Stylesheet and Google Fonts -->
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/stylesheets/notifications.css" />
  <link rel="stylesheet" href="/stylesheets/unit-navbar.css" />
  <link rel="stylesheet" href="/stylesheets/modal-centered.css" />
  <link rel="stylesheet" href="/stylesheets/no-animations.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/alltasks.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/alltasks-modal.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/conversation-modal.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="/javascripts/alert-handler.js"></script>
  <script src="/javascripts/unit-navbar.js"></script>
</head>
<body>
  <!-- Unit Sidebar Navigation -->
  <%- include('../partials/unit-navbar', { user: user, activePage: 'all-tasks' }) %>

  <!-- MAIN CONTENT WITH SIDEBAR -->
  <div class="unit-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="unit-menu-toggle" id="unitMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/unit/dashboard" class="text-wrapper">S-CORE UNIT</a>
      </div>
      
      <span class="text-wrapper-2">All Assigned Tasks</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/unit/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="student-side">
      <div class="div">
        <!-- Section -->
        <section class="activity-section">
          <div class="section-header" style="padding: 2rem 3rem 0 3rem;">
            <h1><%= unitTeam %> Team - All Assigned Tasks</h1>
            <p>Process and collaborate on tasks assigned to your unit</p>
          </div>
          
          <nav class="nav-tabs tabs" style="padding: 0 3rem; margin-bottom: 1.5rem;">
            <a href="/unit/all-tasks" class="tab-btn active">All Tasks</a>
            <a href="/unit/task-approvals" class="tab-btn">Approvals</a>
            <a href="/unit/task-services" class="tab-btn">Services</a>
          </nav>
          
          <hr style="margin: 0 3rem 2rem 3rem; border: none; border-top: 2px solid #e5e7eb;">

          <!-- Filter Options -->
          <div class="filter-section">
            <div class="filter-container">
              <div class="filter-group">
                <label class="filter-label">Filter by:</label>

                <!-- Filter Controls -->
                <div class="filter-controls">
                  <div class="filter-item">
                    <label for="titleFilter" class="filter-sublabel">Title</label>
                    <input type="text" id="titleFilter" class="filter-input" placeholder="Search title...">
                  </div>
                  
                  <div class="filter-item">
                    <label for="typeFilter" class="filter-sublabel">Type</label>
                    <select id="typeFilter" class="filter-select">
                      <option value="all">All Types</option>
                      <option value="approval">Approval Requests</option>
                      <option value="service">Service Requests</option>
                    </select>
                  </div>

                  <div class="filter-item">
                    <label for="statusFilter" class="filter-sublabel">Status</label>
                    <select id="statusFilter" class="filter-select">
                      <option value="all">All Statuses</option>
                      <option value="Pending">Pending</option>
                      <option value="In Progress">In Progress</option>
                      <option value="For Revision">For Revision</option>
                      <option value="Approved">Approved</option>
                      <option value="Completed">Completed</option>
                      <option value="Cancelled">Cancelled</option>
                    </select>
                  </div>

                  <div class="filter-item">
                    <label for="requestorFilter" class="filter-sublabel">Requestor</label>
                    <input type="text" id="requestorFilter" class="filter-input" placeholder="Search requestor...">
                  </div>

                  <div class="filter-item">
                    <label for="dateFromFilter" class="filter-sublabel">Date From</label>
                    <input type="date" id="dateFromFilter" class="filter-input">
                  </div>

                  <div class="filter-item">
                    <label for="dateToFilter" class="filter-sublabel">Date To</label>
                    <input type="date" id="dateToFilter" class="filter-input">
                  </div>
                </div>

                <button id="clearFilters" class="clear-filters-btn">Clear All Filters</button>
              </div>
            </div>
          </div>

          <!-- Requests Table -->
          <div class="table-section" style="background: white; padding: 1.5rem; margin: 0 3rem 2rem 3rem;">
            <table class="requests-table" style="width: 100%;">
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Title</th>
                  <th>Requestor</th>
                  <th>Organization</th>
                  <th>Date Submitted</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="requestsTableBody">
                <% 
                // Combine approval and service requests
                const allRequests = [
                  ...(approvalRequests || []).map(r => ({...r, requestType: 'approval'})),
                  ...(serviceRequests || []).map(r => ({...r, requestType: 'service'}))
                ].sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
                %>
                
                <% if (allRequests && allRequests.length > 0) { %>
                  <% allRequests.forEach(request => { %>
                    <% 
                      const isApproval = request.requestType === 'approval';
                      const type = request.requestType;
                      const title = isApproval ? (request.title || request.projectTitle || 'Untitled') : (request.title || request.serviceType || 'Untitled');
                      const requestor = request.userId ? `${request.userId.fName} ${request.userId.lName}` : 'Unknown';
                      
                      // Get organization/office/department - prioritize in this order
                      let organization = 'N/A';
                      if (request.userId) {
                        if (request.userId.studentOrganization && Array.isArray(request.userId.studentOrganization) && request.userId.studentOrganization.length > 0) {
                          organization = request.userId.studentOrganization[0];
                        } else if (request.userId.office && request.userId.office.trim()) {
                          organization = request.userId.office;
                        } else if (request.userId.department && request.userId.department.trim()) {
                          organization = request.userId.department;
                        } else if (request.userId.affiliation && Array.isArray(request.userId.affiliation) && request.userId.affiliation.length > 0) {
                          organization = request.userId.affiliation[0];
                        }
                      }
                      
                      const dateSubmitted = new Date(request.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                      const status = request.status || 'Pending';
                      const files = request.files || [];
                      const deliverables = request.deliverables || [];
                      const deadline = request.deadline || '';
                      const serviceType = isApproval ? '' : (request.serviceType || request.specificRequestType || '');
                      const description = request.description || '';
                      const specificRequestType = request.specificRequestType || '';
                      const requestorEmail = request.userId ? request.userId.email : '';
                    %>
                    <tr class="request-row clickable" 
                        data-request-id="<%= request._id %>"
                        data-request-type="<%= type %>"
                        data-title="<%= title.replace(/"/g, '&quot;') %>"
                        data-requestor="<%= requestor.replace(/"/g, '&quot;') %>"
                        data-requestor-email="<%= requestorEmail.replace(/"/g, '&quot;') %>"
                        data-organization="<%= organization.replace(/"/g, '&quot;') %>"
                        data-description="<%= description.replace(/"/g, '&quot;') %>"
                        data-date-submitted="<%= dateSubmitted %>"
                        data-status="<%= status %>"
                        data-files='<%= JSON.stringify(files) %>'
                        data-deliverables='<%= JSON.stringify(deliverables) %>'
                        data-deadline="<%= deadline %>"
                        data-service-type="<%= serviceType.replace(/"/g, '&quot;') %>"
                        data-specific-request-type="<%= specificRequestType.replace(/"/g, '&quot;') %>">
                      <td>
                        <span class="type-badge <%= type %>">
                          <%= isApproval ? 'Approval' : 'Service' %>
                        </span>
                      </td>
                      <td class="title-cell"><%= title %></td>
                      <td><%= requestor %></td>
                      <td><%= organization %></td>
                      <td><%= dateSubmitted %></td>
                      <td>
                        <span class="status-badge <%= status.toLowerCase().replace(/\s+/g, '-') %>"><%= status %></span>
                      </td>
                      <td>
                        <button class="view-btn">
                          <svg class="view-btn-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                          </svg>
                          <span class="view-btn-text">View Details</span>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" style="text-align: center; padding: 3rem; color: #64748b;">
                      <div style="font-size: 3rem; margin-bottom: 1rem;">
                        <svg width="64" height="64" fill="none" stroke="#94a3b8" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block;">
                          <rect x="4" y="4" width="16" height="16" rx="2"/>
                          <line x1="8" y1="8" x2="16" y2="8"/>
                          <line x1="8" y1="12" x2="16" y2="12"/>
                          <line x1="8" y1="16" x2="12" y2="16"/>
                        </svg>
                      </div>
                      <p>No tasks assigned to your unit yet</p>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </div>

  <!-- Request Details Modal - Two Column Layout -->
  <div id="requestDetailsModal" class="modal" style="display: none;">
    <div class="modal-content unit-modal-wide">
      <!-- Modal Header -->
      <div class="modal-header unit-modal-header">
        <div class="modal-title-section">
          <svg class="modal-title-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="4" y="4" width="16" height="16" rx="2"/>
            <line x1="8" y1="8" x2="16" y2="8"/>
            <line x1="8" y1="12" x2="16" y2="12"/>
            <line x1="8" y1="16" x2="12" y2="16"/>
          </svg>
          <h2 id="modalTitle">Request Details</h2>
          <span class="type-badge" id="modalTypeBadge">APPROVAL</span>
        </div>
        <button class="close-modal-btn" onclick="closeRequestModal()" aria-label="Close">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Two Column Layout -->
      <div class="modal-body unit-modal-body">
        <!-- LEFT COLUMN: Request Details -->
        <div class="unit-left-column">
          <!-- Request Information Card -->
          <div class="unit-info-card">
            <div class="unit-card-header">
              <h3>
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; margin-right: 0.5rem;">
                  <rect x="4" y="4" width="16" height="16" rx="2"/>
                  <line x1="8" y1="8" x2="16" y2="8"/>
                  <line x1="8" y1="12" x2="16" y2="12"/>
                  <line x1="8" y1="16" x2="12" y2="16"/>
                </svg>
                Request Information
              </h3>
              <p class="unit-card-subtitle">Complete details about this request</p>
            </div>
            <div class="unit-info-grid">
              <div class="unit-info-item">
                <span class="unit-info-label">Requestor</span>
                <span class="unit-info-value" id="modalRequestor">Loading...</span>
              </div>
              <div class="unit-info-item">
                <span class="unit-info-label">Email</span>
                <span class="unit-info-value" id="modalRequestorEmail">Loading...</span>
              </div>
              <div class="unit-info-item">
                <span class="unit-info-label">Organization/Office/Dept</span>
                <span class="unit-info-value" id="modalOrganization">Loading...</span>
              </div>
              <div class="unit-info-item">
                <span class="unit-info-label">Date Submitted</span>
                <span class="unit-info-value" id="modalDate">Loading...</span>
              </div>
              <div class="unit-info-item">
                <span class="unit-info-label">Current Status</span>
                <span class="status-badge" id="modalStatus">Pending</span>
              </div>
              <div class="unit-info-item" id="deadlineField" style="display: none;">
                <span class="unit-info-label">Deadline</span>
                <span class="unit-info-value" id="modalDeadline">N/A</span>
              </div>
              <div class="unit-info-item" id="serviceTypeField" style="display: none;">
                <span class="unit-info-label">Service Type</span>
                <span class="unit-info-value" id="modalServiceType">N/A</span>
              </div>
            </div>
          </div>

          <!-- Description Card -->
          <div class="unit-info-card">
            <div class="unit-card-header">
              <h3>
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; margin-right: 0.5rem;">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
                Description
              </h3>
              <p class="unit-card-subtitle">Request details and requirements</p>
            </div>
            <div class="unit-description-content" id="modalDescription">Loading description...</div>
          </div>

          <!-- Files Section -->
          <div id="filesSection" class="unit-info-card" style="display: none;">
            <div class="unit-card-header">
              <h3>
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; margin-right: 0.5rem;">
                  <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                </svg>
                Attached Files
              </h3>
              <p class="unit-card-subtitle">Files submitted with this request</p>
            </div>
            <div id="modalFiles"></div>
          </div>

          <!-- Deliverables Section -->
          <div id="deliverablesSection" class="unit-info-card" style="display: none;">
            <div class="unit-card-header">
              <h3>
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; margin-right: 0.5rem;">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                  <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
                Deliverables
              </h3>
              <p class="unit-card-subtitle">Files uploaded by unit team</p>
            </div>
            <div id="modalDeliverables"></div>
          </div>

          <!-- Team Conversation Button -->
          <div class="unit-info-card unit-conversation-trigger">
            <button id="openTeamChatBtn" class="unit-chat-button">
              <span class="unit-chat-icon">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
              </span>
              <div class="unit-chat-text">
                <strong>Open Team Discussion</strong>
                <small>Collaborate with your team members</small>
              </div>
              <span class="unit-chat-arrow">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
            </button>
          </div>
        </div>

        <!-- RIGHT COLUMN: Processing Actions -->
        <div class="unit-right-column">
          <!-- Approval Actions Panel -->
          <div id="approvalActionsPanel" class="unit-action-panel approval-panel" style="display: none;">
            <div class="unit-panel-header approval-header">
              <h3>Process Approval Request</h3>
              <p>Review the request and take appropriate action</p>
            </div>
            
            <div class="unit-action-guide">
              <div class="guide-item">
                <span class="guide-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </span>
                <span>Review all details carefully before approving</span>
              </div>
              <div class="guide-item">
                <span class="guide-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                <span>Approve if all requirements are met</span>
              </div>
              <div class="guide-item">
                <span class="guide-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                  </svg>
                </span>
                <span>Request revision if changes are needed</span>
              </div>
            </div>

            <div class="unit-action-buttons">
              <button id="approveBtn" class="unit-btn unit-btn-approve">
                <span class="btn-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                <span>Approve Request</span>
              </button>
              <button id="requestRevisionBtn" class="unit-btn unit-btn-revision">
                <span class="btn-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                  </svg>
                </span>
                <span>Request Revision</span>
              </button>
            </div>

            <!-- Revision Form -->
            <div id="revisionForm" class="unit-revision-form" style="display: none;">
              <label for="revisionComments" class="unit-form-label">
                <strong>Revision Feedback</strong>
                <small>Clearly explain what needs to be revised</small>
              </label>
              
              <!-- Text Formatting Toolbar -->
              <div class="revision-format-toolbar">
                <button type="button" class="format-btn" data-format="bold" title="Bold">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/>
                    <path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/>
                  </svg>
                </button>
                <button type="button" class="format-btn" data-format="italic" title="Italic">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="19" y1="4" x2="10" y2="4"/>
                    <line x1="14" y1="20" x2="5" y2="20"/>
                    <line x1="15" y1="4" x2="9" y2="20"/>
                  </svg>
                </button>
                <button type="button" class="format-btn" data-format="underline" title="Underline">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3"/>
                    <line x1="4" y1="21" x2="20" y2="21"/>
                  </svg>
                </button>
                <div class="toolbar-divider"></div>
                <button type="button" class="format-btn" data-format="bullet" title="Bullet List">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="8" y1="6" x2="21" y2="6"/>
                    <line x1="8" y1="12" x2="21" y2="12"/>
                    <line x1="8" y1="18" x2="21" y2="18"/>
                    <circle cx="4" cy="6" r="1" fill="currentColor"/>
                    <circle cx="4" cy="12" r="1" fill="currentColor"/>
                    <circle cx="4" cy="18" r="1" fill="currentColor"/>
                  </svg>
                </button>
                <div class="toolbar-divider"></div>
                <button type="button" id="revisionAttachBtn" class="format-btn" title="Attach Files">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                  </svg>
                </button>
                <input type="file" id="revisionFileInput" multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.webp,.xls,.xlsx,.txt" style="display: none;">
                <span class="toolbar-hint">Format your feedback</span>
              </div>

              <!-- Attached Files Preview -->
              <div id="revisionFilesPreview" class="revision-files-preview" style="display: none;">
                <div class="files-preview-header">
                  <span class="files-count">0 file(s) attached</span>
                  <button type="button" id="clearRevisionFiles" class="clear-files-btn">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="18" y1="6" x2="6" y2="18"/>
                      <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                    Clear all
                  </button>
                </div>
                <div id="revisionFilesContainer" class="files-container"></div>
              </div>

              <textarea id="revisionComments" rows="5" class="unit-textarea" placeholder="Provide detailed feedback on what needs to be changed or improved..."></textarea>
              
              <div class="unit-form-actions">
                <button id="submitRevisionBtn" class="unit-btn unit-btn-submit">Submit Revision Request</button>
                <button id="cancelRevisionBtn" class="unit-btn unit-btn-cancel">Cancel</button>
              </div>
            </div>
          </div>

          <!-- Service Actions Panel -->
          <div id="serviceActionsPanel" class="unit-action-panel service-panel" style="display: none;">
            <div class="unit-panel-header service-header">
              <h3>Process Service Request</h3>
              <p>Upload deliverables and complete the service</p>
            </div>

            <div class="unit-action-guide">
              <div class="guide-item">
                <span class="guide-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="17 8 12 3 7 8"/>
                    <line x1="12" y1="3" x2="12" y2="15"/>
                  </svg>
                </span>
                <span>Upload all required deliverables</span>
              </div>
              <div class="guide-item">
                <span class="guide-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="4" y="4" width="16" height="16" rx="2"/>
                    <line x1="8" y1="8" x2="16" y2="8"/>
                    <line x1="8" y1="12" x2="16" y2="12"/>
                    <line x1="8" y1="16" x2="12" y2="16"/>
                  </svg>
                </span>
                <span>Verify all files are correct before uploading</span>
              </div>
              <div class="guide-item">
                <span class="guide-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
                <span>Mark as complete when all work is done</span>
              </div>
            </div>

            <div class="unit-upload-section">
              <label class="unit-form-label">
                <strong>Upload Deliverables</strong>
                <small>Select one or more files to upload (Max 10MB per file)</small>
              </label>
              <div class="unit-file-upload-group" id="unitFileUploadGroup">
                <svg class="unit-upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17,8 12,3 7,8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <p class="unit-upload-text">Drop your files here</p>
                <p class="unit-upload-subtext">or click to browse from your device</p>
                <input type="file" id="deliverablesFileInput" multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.webp,.xls,.xlsx,.txt" class="unit-file-input-hidden">
                <button type="button" class="unit-browse-file-btn" onclick="event.stopPropagation(); document.getElementById('deliverablesFileInput').click()">
                  <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14,2 14,8 20,8"/>
                  </svg>
                  Choose Files
                </button>
                
                <!-- Upload Progress -->
                <div class="unit-upload-progress" id="unitUploadProgress">
                  <div class="unit-progress-bar">
                    <div class="unit-progress-fill" id="unitProgressFill"></div>
                  </div>
                </div>
              </div>
              
              <!-- File Management Section -->
              <div class="unit-file-management" id="unitFileManagement" style="display: none;">
                <div class="unit-file-actions">
                  <span id="unitFilesCount">0 files selected</span>
                  <button type="button" class="unit-clear-all-btn" id="unitClearAllBtn">
                    <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                      <rect x="3" y="6" width="18" height="14" rx="2"/>
                      <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                      <line x1="1" y1="6" x2="23" y2="6"/>
                      <line x1="10" y1="11" x2="10" y2="17"/>
                      <line x1="14" y1="11" x2="14" y2="17"/>
                    </svg>
                    Clear All Files
                  </button>
                </div>
                
                <!-- Selected Files Container -->
                <div class="unit-selected-files-container" id="unitSelectedFiles">
                  <!-- Files will be added here dynamically -->
                </div>
                
                <div class="unit-files-summary" id="unitFilesSummary">
                  Total size: 0 MB
                </div>
              </div>
              
              <button id="uploadDeliverablesBtn" disabled class="unit-btn unit-btn-upload" style="margin-top: 1rem;">
                <span class="btn-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="17 8 12 3 7 8"/>
                    <line x1="12" y1="3" x2="12" y2="15"/>
                  </svg>
                </span>
                <span>Submit Deliverables for Review</span>
              </button>
            </div>

            <div class="unit-info-notice">
              <svg width="20" height="20" fill="none" stroke="#2563eb" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; vertical-align: top; margin-right: 0.5rem; flex-shrink: 0;">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
              </svg>
              <div>
                <p style="margin: 0 0 0.5rem 0; font-weight: 600; color: #1e293b;">About Service Completion</p>
                <p style="margin: 0; font-size: 0.875rem; color: #64748b; line-height: 1.5;">
                  After uploading deliverables, the request status will change to <strong style="color: #2563eb;">"For Checking"</strong>. 
                  The requestor will review your work and may request revisions. Only the requestor can mark the request as completed.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Team Conversation Modal -->
  <div id="teamConversationModal" class="modal" style="display: none;">
    <div class="modal-content unit-conversation-modal">
      <div class="modal-header unit-modal-header">
        <div class="modal-title-section">
          <svg class="modal-title-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <h2>Team Discussion</h2>
          <span class="unit-conversation-subtitle">Collaborate on this request</span>
        </div>
        <button class="close-modal-btn" onclick="closeTeamConversationModal()" aria-label="Close">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      
      <div class="unit-conversation-body">
        <!-- Messages Container -->
        <div id="teamMessagesContainer" class="unit-messages-container">
          <div class="unit-messages-empty">
            <div class="empty-icon">
              <svg width="48" height="48" fill="none" stroke="#94a3b8" stroke-width="2" viewBox="0 0 24 24">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
            </div>
            <p>No team discussion yet</p>
            <small>Start the conversation below</small>
          </div>
        </div>

        <!-- Message Input Area -->
        <div class="unit-message-input-area">
          <!-- Attached Files Preview (Above Toolbar) -->
          <div id="chatFilesPreview" class="chat-files-preview" style="display: none;">
            <div class="files-preview-header">
              <span class="files-count">0 file(s) attached</span>
              <button type="button" id="clearChatFiles" class="clear-files-btn">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
                Clear all
              </button>
            </div>
            <div id="chatFilesContainer" class="files-container"></div>
          </div>

          <!-- Formatting Toolbar -->
          <div class="unit-format-toolbar">
            <button type="button" class="format-btn" data-chat-format="bold" title="Bold">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/>
                <path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/>
              </svg>
            </button>
            <button type="button" class="format-btn" data-chat-format="italic" title="Italic">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="19" y1="4" x2="10" y2="4"/>
                <line x1="14" y1="20" x2="5" y2="20"/>
                <line x1="15" y1="4" x2="9" y2="20"/>
              </svg>
            </button>
            <button type="button" class="format-btn" data-chat-format="underline" title="Underline">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3"/>
                <line x1="4" y1="21" x2="20" y2="21"/>
              </svg>
            </button>
            <div class="toolbar-divider"></div>
            <button type="button" id="chatAttachBtn" class="format-btn" title="Attach Files">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
              </svg>
            </button>
            <input type="file" id="chatFileInput" multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.webp,.xls,.xlsx,.txt" style="display: none;">
            <span class="toolbar-hint">Format your message</span>
          </div>

          <!-- Message Input -->
          <div class="unit-message-input-wrapper">
            <textarea id="teamMessageInput" placeholder="Type your message to team members..." rows="3" class="unit-message-input"></textarea>
            <button id="sendTeamMessageBtn" class="unit-send-btn">
              <span>Send</span>
              <svg class="send-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Define current user role for conversation
    window.currentUserRole = 'unit';
  </script>

  <!-- PDF Viewer Modal -->
  <div id="pdfViewerModal" class="modal" style="display: none;">
    <div class="modal-content pdf-viewer-modal">
      <div class="modal-header pdf-viewer-header">
        <div class="modal-title-section">
          <svg class="modal-title-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="4" y="2" width="16" height="20" rx="2"/>
            <path d="M8 6h8M8 10h8M8 14h4"/>
          </svg>
          <h2 id="pdfViewerTitle">PDF Document</h2>
        </div>
        <button class="close-modal-btn" onclick="closePdfViewer()" aria-label="Close">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="pdf-viewer-body">
        <iframe id="pdfViewerFrame" style="width: 100%; height: 100%; border: none;"></iframe>
      </div>
    </div>
  </div>

  <!-- JavaScript -->
  <script src="/javascripts/ejs/Unit/alltasks.js"></script>
</body>
</html>
