<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Request Approvals - <%= unitTeam %> Unit</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/stylesheets/notifications.css" />
  <link rel="stylesheet" href="/stylesheets/unit-navbar.css" />
  <link rel="stylesheet" href="/stylesheets/modal-centered.css" />
  <link rel="stylesheet" href="/stylesheets/no-animations.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
  <script src="/javascripts/alert-handler.js"></script>
  <script src="/javascripts/unit-navbar.js"></script>
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/taskapprovals.css" />
</head>
<body>
  <!-- Unit Sidebar Navigation -->
  <%- include('../partials/unit-navbar', { user: user, activePage: 'task-approvals' }) %>

  <!-- MAIN CONTENT WITH HEADER -->
  <div class="unit-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="unit-menu-toggle" id="unitMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/unit/dashboard" class="text-wrapper">S-CORE UNIT</a>
      </div>
      
      <span class="text-wrapper-2">Request for Approval</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/unit/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

    <!-- DASHBOARD CONTENT -->
    <div class="student-side">
      <div class="div">

      <section class="activity-section">
        <!-- Page Header with User Info and Action Button -->
        <div class="page-header-container">
          <div class="user-info-section">
            <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" 
                 alt="Profile Picture" class="profile-pic-large" style="width:64px;height:64px;border-radius:50%;" />
            <div>
              <h2 style="margin-bottom: 0.25rem;"><%= user.fName %> <%= user.lName %></h2>
              <p style="color: #6b7280;"><%= user.userType === 'student' ? 'Student' : 'Non-Student' %></p>
            </div>
          </div>
          <div class="action-button-container">
            <button class="view-all-btn" id="openModalBtn">+ Request Approval</button>
          </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="nav-tabs">
          <a href="/unit/all-tasks" class="tab-btn">All Tasks</a>
          <a href="/unit/task-approvals" class="tab-btn active">Request Approvals</a>
          <a href="/unit/task-services" class="tab-btn">Service Requests</a>
        </nav>

        <div class="filter-section">
          <div class="filter-container">
            <div class="filter-group">
              <label class="filter-label">Filter by:</label>
              
              <!-- First Row -->
              <div class="filter-controls">
                <div class="filter-item">
                  <label class="filter-sublabel">Status</label>
                  <div class="custom-select-wrapper">
                    <div class="custom-select" id="statusFilter">
                      <div class="select-display">All Status</div>
                      <div class="select-dropdown" id="statusDropdown">
                        <label class="dropdown-option">
                          <input type="checkbox" value="all" checked>
                          <span class="checkbox-custom"></span>
                          All Status
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="pending">
                          <span class="checkbox-custom"></span>
                          Pending
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="approved">
                          <span class="checkbox-custom"></span>
                          Approved
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="rejected">
                          <span class="checkbox-custom"></span>
                          Rejected
                        </label>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="filter-item">
                  <label for="titleFilter" class="filter-sublabel">Title</label>
                  <input type="text" id="titleFilter" class="filter-input" placeholder="Search title...">
                </div>
                <div class="filter-item">
                  <% if (user.userType === 'student') { %>
                  <label for="organizationFilter" class="filter-sublabel">My Student Organizations</label>
                  <div class="enhanced-multi-select-wrapper">
                    <div class="enhanced-multi-select" id="organizationFilter">
                      <div class="select-display" data-placeholder="Select My Organizations">
                        <span class="selected-text">All My Organizations</span>
                        <span class="dropdown-arrow">â–¼</span>
                      </div>
                      <div class="select-dropdown" id="organizationDropdown">
                        <div class="search-container">
                          <input type="text" class="search-input" placeholder="Search my organizations...">
                        </div>
                        <div class="options-container">
                          <!-- Options populated by JavaScript -->
                        </div>
                      </div>
                    </div>
                  </div>
                  <% } else { %>
                  <label for="organizationFilter" class="filter-sublabel">My Office/Department</label>
                  <div class="enhanced-multi-select-wrapper">
                    <div class="enhanced-multi-select" id="organizationFilter">
                      <div class="select-display" data-placeholder="Select My Departments">
                        <span class="selected-text">All My Departments</span>
                        <span class="dropdown-arrow">â–¼</span>
                      </div>
                      <div class="select-dropdown" id="organizationDropdown">
                        <div class="search-container">
                          <input type="text" class="search-input" placeholder="Search my departments...">
                        </div>
                        <div class="options-container">
                          <!-- Options populated by JavaScript -->
                        </div>
                      </div>
                    </div>
                  </div>
                  <% } %>
                </div>
              </div>
              
              <!-- Second Row -->
              <div class="filter-controls">
                <div class="filter-item">
                  <label for="dateFromFilter" class="filter-sublabel">Date From</label>
                  <input type="date" id="dateFromFilter" class="filter-input">
                </div>
                <div class="filter-item">
                  <label for="dateToFilter" class="filter-sublabel">Date To</label>
                  <input type="date" id="dateToFilter" class="filter-input">
                </div>
              </div>
            </div>
            
            <div class="filter-actions">
              <button id="clearFilters" class="clear-filters-btn">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <rect x="3" y="6" width="18" height="14" rx="2"/>
                  <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                  <line x1="1" y1="6" x2="23" y2="6"/>
                  <line x1="10" y1="11" x2="10" y2="17"/>
                  <line x1="14" y1="11" x2="14" y2="17"/>
                </svg>
                Clear All
              </button>
              <div class="results-count">
                <span id="resultsCount">Showing all requests</span>
              </div>
            </div>
          </div>
        </div>

        <!-- DEBUG: Test Conversation Modal Button -->
        <div style="margin: 10px 0; padding: 10px; background: #f0f8ff; border: 1px solid #ccc; border-radius: 5px;">
          <button id="testConversationModal" style="background: #007bff; color: white; padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer;">
            ðŸ§ª Test Conversation Modal (Debug)
          </button>
          <small style="display: block; margin-top: 5px; color: #666;">
            Click to test opening conversation modal functionality
          </small>
        </div>

        <section class="table-section" style="overflow-x: auto;">
          <table class="requests-table" style="width: 100%; border-collapse: collapse; border-radius: var(--border-radius); box-shadow: var(--card-shadow); overflow: hidden; background: white;">
            <thead style="background: var(--light-green); color: var(--primary-green);">
              <tr>
                <th>Request ID</th>
                <th>Project Title</th>
                <th>Office/Department/Organization</th>
                <th>Status</th>
                <th>Assigned Units</th>
                <th>Date Submitted</th>
              </tr>
            </thead>
            <tbody id="requestsTableBody">
              <% if (approvalRequests && approvalRequests.length > 0) { %>
                <% approvalRequests.forEach(request => {
                  // Calculate local deadline
                  let localDeadline = '';
                  let formattedDeadline = 'N/A';
                  if (request.deadline) {
                    const d = new Date(request.deadline);
                    localDeadline = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
                    formattedDeadline = (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
                  }

                  // Get requestor name
                  let displayUserName = 'Unknown User';
                  if (request.userId && request.userId.fName) {
                    displayUserName = `${request.userId.fName} ${request.userId.lName || ''}`.trim();
                  }

                  // Get organization from request directly
                  let organization = request.organization || 'N/A';
                %>
                <tr class="request-row"
                  data-id="<%= request._id %>"
                  data-type="approval"
                  data-title="<%= request.title %>"
                  data-status="<%= request.status %>"
                  data-organization="<%= organization %>"
                  data-deadline="<%= localDeadline %>"
                  data-formatted-deadline="<%= formattedDeadline %>"
                  data-datetime="<%= new Date(request.createdAt).toLocaleString() %>"
                  data-date="<%= new Date(request.createdAt).toISOString().split('T')[0] %>"
                  data-description="<%= request.description %>"
                  data-files="<%= request.files ? request.files.join(',') : '' %>"
                  data-requestor="<%= displayUserName %>">
                  <td><%= request._id.toString().slice(-6) %></td>
                  <td><%= request.title %></td>
                  <td><%= displayUserName %></td>
                  <td><%= organization %></td>
                  <td>
                    <span class="status-badge <%= request.status.toLowerCase().replace(/\s+/g, '-') %>">
                      <%= request.status %>
                    </span>
                  </td>
                  <td><%= formattedDeadline %></td>
                  <td><%= new Date(request.createdAt).toLocaleString() %></td>
                </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>

          <% if (!approvalRequests || approvalRequests.length === 0) { %>
          <div style="text-align: center; padding: 2rem; color: #6b7280;">
            <p>No approval tasks assigned to your unit yet.</p>
          </div>
          <% } %>
        </section>

        <!-- Back to Dashboard Button -->
        <div class="back-to-dashboard-container">
          <a href="/unit/dashboard" class="back-to-dashboard-btn">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Back to Dashboard
          </a>
        </div>
      </section>
    </div>
  </div>

  <!-- Create Request Modal -->
  <div id="requestModal" class="modal" style="display:none;">
    <div class="modal-content">
      <header class="modal-header">
        <span class="modal-title">Create a Request for Approval</span>
        <span class="close" id="closeModalBtn">&times;</span>
      </header>
      <div class="modal-body">
        <form class="modal-form" action="/submit-request-approval" method="POST" enctype="multipart/form-data" id="requestForm" onsubmit="return handleFormSubmit(event)">
          <!-- Row 1: Title and Organization -->
          <div class="form-group">
            <label for="projectTitle">Project/Event Title:</label>
            <input type="text" id="projectTitle" name="projectTitle" required placeholder="Enter project or event title..." />
          </div>
          
          <div class="form-group">
            <label for="organization">Organization:</label>
            <%
              let userOrgs = [];
              if (user.userType === 'student') {
                if (Array.isArray(user.studentOrganization)) {
                  if (user.studentOrganization.length === 1 && user.studentOrganization[0].includes(',')) {
                    userOrgs = user.studentOrganization[0].split(',').map(o => o.trim()).filter(Boolean);
                  } else {
                    userOrgs = user.studentOrganization;
                  }
                } else if (typeof user.studentOrganization === 'string') {
                  userOrgs = user.studentOrganization.split(',').map(o => o.trim()).filter(Boolean);
                }
              } else {
                if (Array.isArray(user.affiliation)) {
                  if (user.affiliation.length === 1 && user.affiliation[0].includes(',')) {
                    userOrgs = user.affiliation[0].split(',').map(o => o.trim()).filter(Boolean);
                  } else {
                    userOrgs = user.affiliation;
                  }
                } else if (typeof user.affiliation === 'string') {
                  userOrgs = user.affiliation.split(',').map(o => o.trim()).filter(Boolean);
                }
              }
            %>
            <% if (userOrgs.length === 1) { %>
              <input type="text" id="organization" name="organization" value="<%= userOrgs[0] %>" readonly />
            <% } else if (userOrgs.length > 1) { %>
              <select id="organization" name="organization" required>
                <option value="" disabled selected>Select organization/department</option>
                <% userOrgs.forEach(function(org) { %>
                  <option value="<%= org %>"><%= org %></option>
                <% }); %>
              </select>
            <% } else { %>
              <input type="text" id="organization" name="organization" placeholder="Enter organization/department" required />
            <% } %>
          </div>

          <!-- Row 2: File Upload (Required for approval requests) -->
          <div class="form-group full-width">
            <label for="upload">Upload Files:</label>
            <div class="file-upload-group" id="approvalFileUploadGroup">
              <svg class="upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7,10 12,15 17,10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <p class="upload-text">Drop your files here</p>
              <p class="upload-subtext">or click to browse from your device</p>
              <input type="file" id="upload" name="upload" class="file-input-hidden" multiple required accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.webp,.xls,.xlsx,.txt" />
              <button type="button" class="browse-file-btn" onclick="event.stopPropagation(); document.getElementById('upload').click()">
                <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14,2 14,8 20,8"/>
                </svg>
                Choose Files
              </button>
              
              <!-- Upload Progress -->
              <div class="upload-progress" id="approvalUploadProgress">
                <div class="progress-bar">
                  <div class="progress-fill" id="approvalProgressFill"></div>
                </div>
              </div>
            </div>
            
            <!-- File Management Section -->
            <div class="file-management" id="approvalFileManagement" style="display: none;">
              <div class="file-actions">
                <span id="approvalFilesCount">0 files selected</span>
                <button type="button" class="clear-all-btn" id="approvalClearAllBtn" onclick="clearAllApprovalFiles()">
                  <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="6" width="18" height="14" rx="2"/>
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    <line x1="1" y1="6" x2="23" y2="6"/>
                    <line x1="10" y1="11" x2="10" y2="17"/>
                    <line x1="14" y1="11" x2="14" y2="17"/>
                  </svg>
                  Clear All Files
                </button>
              </div>
              
              <!-- Selected Files Container -->
              <div class="selected-files-container" id="approvalSelectedFiles">
                <!-- Files will be added here dynamically -->
              </div>
              
              <div class="files-summary" id="approvalFilesSummary">
                Total size: 0 MB
              </div>
            </div>
            
            <small style="color: #dc2626; margin-top: 0.5rem;">* Required: Please attach relevant documents (Max 10MB per file)</small>
          </div>

          <!-- Row 3: Description (Full Width) -->
          <div class="form-group full-width">
            <label for="description">Description:</label>
            <textarea id="description" name="description" rows="5" required placeholder="Provide detailed information about your project or event..."></textarea>
          </div>

          <!-- Row 4: Request Type -->
          <div class="form-group full-width">
  <label for="specificRequestType">Select Request Type:</label>
  <select id="specificRequestType" name="specificRequestType" class="form-control" required>
    <option value="" disabled selected>Select request type...</option>
    <option value="Content Posting">Content Posting</option>
    <option value="Social Media Monitoring">Social Media Monitoring</option>
    <option value="Caption Approval">Caption Approval</option>
    <option value="Publication Design">Publication Design</option>
    <option value="Proofreading">Proofreading</option>
    <option value="Graphics Design">Graphics Design</option>
    <option value="Media Coverage">Media Coverage</option>
  </select>
</div>

          <!-- Form Actions -->
          <div class="form-actions">
            <button type="button" id="cancelModalBtn">Cancel</button>
            <button type="submit">Submit Request</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Enhanced Submission Confirmation Modal -->
  <div id="submissionConfirmationModal" class="modal" style="display:none;">
    <div class="modal-content" style="max-width: 600px;">
      <header class="modal-header">
        <span class="modal-title confirmation">Confirm Your Submission</span>
        <span class="close" id="closeSubmissionConfirmation">&times;</span>
      </header>
      <div class="modal-body" style="padding: 0;">
        <div style="padding: 2rem; text-align: center; background: linear-gradient(135deg, #f0f9ff, #e0f2fe);">
          <div style="font-size: 4rem; margin-bottom: 1.5rem; color: #3b82f6;">
            <svg width="64" height="64" fill="none" stroke="#3b82f6" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h2 style="margin: 0 0 1rem 0; font-size: 1.5rem; font-weight: 700; color: #3b82f6;">
            Ready to Submit Your Request?
          </h2>
          <p style="margin: 0 0 1.5rem 0; font-size: 1.1rem; color: #374151; font-weight: 500;">
            Please review your information before final submission to the S-CORE team.
          </p>
        </div>
        
        <div style="padding: 1.5rem 2rem; background: white;">
          <div style="background: #fef3c7; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #f59e0b; margin-bottom: 1.5rem;">
            <h3 style="margin: 0 0 0.75rem 0; font-size: 1rem; font-weight: 600; color: #92400e; display: flex; align-items: center; gap: 0.5rem;">
              <svg width="20" height="20" fill="none" stroke="#f59e0b" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              Important Notice
            </h3>
            <p style="margin: 0; color: #92400e; font-size: 0.95rem; line-height: 1.5;">
              Once submitted, your request cannot be edited. Please ensure all information and files are correct.
            </p>
          </div>
          
          <div style="background: #f0f9ff; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #3b82f6; margin-bottom: 1.5rem;">
            <h3 style="margin: 0 0 0.75rem 0; font-size: 1rem; font-weight: 600; color: #1e40af; display: flex; align-items: center; gap: 0.5rem;">
              <svg width="20" height="20" fill="none" stroke="#3b82f6" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12,6 12,12 16,14"/>
              </svg>
              Processing Timeline
            </h3>
            <p style="margin: 0; color: #1e40af; font-size: 0.95rem; line-height: 1.5;">
              The S-CORE team strives to provide feedback within <strong>three (3) working days</strong>.
            </p>
          </div>
          
          <div style="background: #f8fafc; padding: 1.5rem; border-radius: 12px; border: 1px solid #e2e8f0;">
            <p style="margin: 0; color: #64748b; font-size: 0.9rem; text-align: center; font-style: italic;">
              You can track your request status and communicate with our team through the conversation feature after submission.
            </p>
          </div>
        </div>
      </div>
      <div class="modal-actions">
        <button id="cancelSubmissionBtn">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8z"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Review & Edit
        </button>
        <button id="proceedSubmissionBtn">
          <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Confirm & Submit
        </button>
      </div>
    </div>
  </div>

  <!-- Enhanced Request Details Modal - Unit-Focused -->
  <div id="detailsModal" class="modal" style="display:none;">
    <div class="modal-content" style="max-width: 1200px;">
      <header class="modal-header" style="background: linear-gradient(135deg, var(--primary-green), #059669); color: white;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
          </svg>
          <span class="modal-title" style="font-size: 1.25rem; font-weight: 700;">Task Details</span>
          <span id="modalTaskBadge" class="admin-badge" style="background: rgba(255,255,255,0.2); margin-left: 0.5rem;">TASK</span>
        </div>
        <span class="close" id="closeDetailsModal" style="color: white; opacity: 0.9;">&times;</span>
      </header>
      <div class="modal-body details-modal-body">
        <div class="details-content">

          <!-- Task Status Card - Prominent Display -->
          <div style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%); padding: 1.5rem; border-radius: 12px; margin-bottom: 1.5rem; border-left: 5px solid var(--primary-green);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
              <div>
                <div style="font-size: 0.875rem; color: #64748b; margin-bottom: 0.25rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Current Status</div>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                  <span id="modalStatusBadge" class="status-badge" style="font-size: 1rem; padding: 0.5rem 1rem;">Loading...</span>
                  <span id="modalTaskType" style="color: #475569; font-size: 0.875rem;"></span>
                </div>
              </div>
              <div style="text-align: right;">
                <div style="font-size: 0.875rem; color: #64748b; margin-bottom: 0.25rem; font-weight: 600;">Assigned To</div>
                <div id="modalAssignedTeam" style="color: var(--primary-green); font-weight: 700; font-size: 1.125rem;">Your Team</div>
              </div>
            </div>
          </div>

          <!-- General Information Section - Enhanced -->
          <div class="general-info-section" style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.05); margin-bottom: 1.5rem;">
            <h3 style="color: var(--primary-green); font-size: 1.125rem; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.75rem;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M9 11h6M9 15h6" stroke="white" stroke-width="2"/>
              </svg>
              Request Information
            </h3>
            <div class="general-info-row" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
              <div class="info-item" style="padding: 1rem; background: #f8fafc; border-radius: 8px; border-left: 3px solid var(--primary-green);">
                <span class="info-label" style="display: block; font-size: 0.75rem; color: #64748b; margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Project Title</span>
                <span class="info-value" id="detailTitle" style="font-weight: 600; color: #1e293b; font-size: 1rem;"></span>
              </div>
              <div class="info-item" style="padding: 1rem; background: #f8fafc; border-radius: 8px; border-left: 3px solid #3b82f6;">
                <span class="info-label" style="display: block; font-size: 0.75rem; color: #64748b; margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Requested By</span>
                <span class="info-value" id="detailStudent" style="font-weight: 600; color: #1e293b; font-size: 1rem;"></span>
              </div>
              <div class="info-item" style="padding: 1rem; background: #f8fafc; border-radius: 8px; border-left: 3px solid #8b5cf6;">
                <span class="info-label" style="display: block; font-size: 0.75rem; color: #64748b; margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Request Type</span>
                <span class="info-value" id="detailType" style="font-weight: 600; color: #1e293b; font-size: 1rem;"></span>
              </div>
              <div class="info-item" id="specificRequestItem" style="padding: 1rem; background: #f0fdf4; border-radius: 8px; border-left: 3px solid #10b981; display: none;">
                <span class="info-label" style="display: block; font-size: 0.75rem; color: #64748b; margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Service Type</span>
                <span class="info-value" id="detailSpecificRequest" style="color: var(--primary-green); font-weight: 700; font-size: 1rem;">Not specified</span>
              </div>
              <div class="info-item" style="padding: 1rem; background: #f8fafc; border-radius: 8px; border-left: 3px solid #f59e0b;">
                <span class="info-label" style="display: block; font-size: 0.75rem; color: #64748b; margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Organization</span>
                <span class="info-value" id="detailOrganization" style="font-weight: 600; color: #1e293b; font-size: 1rem;"></span>
              </div>
              <div class="info-item" style="padding: 1rem; background: #f8fafc; border-radius: 8px; border-left: 3px solid #64748b;">
                <span class="info-label" style="display: block; font-size: 0.75rem; color: #64748b; margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Date Submitted</span>
                <span class="info-value" id="detailDatetime" style="font-weight: 600; color: #1e293b; font-size: 1rem;"></span>
              </div>
              <div class="info-item" id="deadlineInfo" style="padding: 1rem; background: #fef2f2; border-radius: 8px; border-left: 3px solid #ef4444; display: none;">
                <span class="info-label" style="display: block; font-size: 0.75rem; color: #64748b; margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">â° Deadline</span>
                <span class="info-value" id="detailDeadlineInfo" style="font-weight: 700; color: #dc2626; font-size: 1rem;"></span>
              </div>
            </div>
          </div>

          <!-- Unit Member Actions Section - Approval Requests -->
          <div class="admin-form-section" id="approvalActionsSection" style="display: none; background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.05); margin-bottom: 1.5rem; border: 2px solid #10b981;">
            <h3 style="color: #047857; font-size: 1.125rem; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.75rem;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Approval Request Actions
              <span class="admin-badge" style="background: linear-gradient(135deg, #10b981, #059669); color: white; font-size: 0.75rem;">REVIEW & RESPOND</span>
            </h3>

            <!-- Action Instructions -->
            <div style="background: #f0fdf4; border-left: 4px solid #10b981; padding: 1rem; margin-bottom: 1.25rem; border-radius: 6px;">
              <div style="display: flex; align-items: start; gap: 0.75rem;">
                <svg width="20" height="20" fill="#059669" viewBox="0 0 24 24" style="flex-shrink: 0; margin-top: 2px;">
                  <path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <div>
                  <div style="font-weight: 600; color: #047857; margin-bottom: 0.25rem;">What you can do:</div>
                  <ul style="margin: 0; padding-left: 1.25rem; color: #065f46; font-size: 0.875rem; line-height: 1.6;">
                    <li>âœ… <strong>Approve</strong> if the request meets all requirements</li>
                    <li>âœï¸ <strong>Request Revision</strong> if changes are needed - provide clear feedback</li>
                    <li>ðŸ’¬ Use the conversation feature to communicate with the requestor</li>
                  </ul>
                </div>
              </div>
            </div>

            <div class="admin-form-grid">
              <!-- Current Status Display -->
              <div class="form-field">
                <label style="font-weight: 600; color: #475569; margin-bottom: 0.5rem; display: block;">Current Status</label>
                <div class="current-value">
                  <span id="currentStatusValue" class="status-badge" style="font-size: 1rem; padding: 0.5rem 1rem;">Loading...</span>
                </div>
              </div>
            </div>

            <div class="admin-form-actions" style="display: flex; gap: 1rem; margin-top: 1.25rem;">
              <button type="button" class="admin-btn admin-btn-success" id="approveBtn" style="flex: 1; background: linear-gradient(135deg, #10b981, #059669); padding: 0.875rem 1.5rem; font-size: 1rem; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 0.5rem; box-shadow: 0 4px 6px rgba(16, 185, 129, 0.3);">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                Approve Request
              </button>
              <button type="button" class="admin-btn admin-btn-warning" id="reviseBtn" style="flex: 1; background: linear-gradient(135deg, #f59e0b, #d97706); padding: 0.875rem 1.5rem; font-size: 1rem; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 0.5rem; box-shadow: 0 4px 6px rgba(245, 158, 11, 0.3);">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Request Revision
              </button>
            </div>

            <!-- Revision Comment Section (Hidden by default) -->
            <div id="revisionCommentSection" style="display: none; margin-top: 1.25rem; padding: 1.25rem; background: #fffbeb; border-radius: 8px; border: 2px solid #f59e0b;">
              <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; color: #92400e;">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                </svg>
                <label for="revisionComment" style="font-weight: 700; font-size: 1rem;">
                  Explain what needs to be revised (Required)
                </label>
              </div>
              <textarea id="revisionComment" rows="5" style="width: 100%; padding: 1rem; border: 2px solid #f59e0b; border-radius: 8px; font-size: 0.95rem; resize: vertical; font-family: inherit;" placeholder="Be specific about what changes are needed. Example: 'Please update the timeline to show more detailed milestones...'"></textarea>
              <div style="display: flex; gap: 0.75rem; margin-top: 1rem; justify-content: flex-end;">
                <button type="button" class="admin-btn admin-btn-secondary" id="cancelRevisionBtn" style="padding: 0.75rem 1.5rem; font-weight: 600;">
                  Cancel
                </button>
                <button type="button" class="admin-btn admin-btn-primary" id="submitRevisionBtn" style="padding: 0.75rem 1.5rem; background: linear-gradient(135deg, #f59e0b, #d97706); font-weight: 600; display: flex; align-items: center; gap: 0.5rem;">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                  </svg>
                  Submit Revision Request
                </button>
              </div>
            </div>
          </div>

          <!-- Service Request Actions Section -->
          <div class="admin-form-section" id="serviceActionsSection" style="display: none; background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.05); margin-bottom: 1.5rem; border: 2px solid #3b82f6;">
            <h3 style="color: #1e40af; font-size: 1.125rem; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.75rem;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
                <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z"/>
              </svg>
              Service Request Actions
              <span class="admin-badge" style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; font-size: 0.75rem;">DELIVER & COMPLETE</span>
            </h3>

            <!-- Action Instructions -->
            <div style="background: #eff6ff; border-left: 4px solid #3b82f6; padding: 1rem; margin-bottom: 1.25rem; border-radius: 6px;">
              <div style="display: flex; align-items: start; gap: 0.75rem;">
                <svg width="20" height="20" fill="#2563eb" viewBox="0 0 24 24" style="flex-shrink: 0; margin-top: 2px;">
                  <path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <div>
                  <div style="font-weight: 600; color: #1e40af; margin-bottom: 0.25rem;">Service Workflow:</div>
                  <ul style="margin: 0; padding-left: 1.25rem; color: #1e3a8a; font-size: 0.875rem; line-height: 1.6;">
                    <li>ðŸ“¤ <strong>Upload Deliverables</strong> - Upload your completed work files</li>
                    <li>âœ… <strong>Mark as Completed</strong> - Finalize the request (requires at least one deliverable)</li>
                    <li>ðŸ’¬ Use conversation to clarify requirements or provide updates</li>
                  </ul>
                </div>
              </div>
            </div>

            <div class="admin-form-grid">
              <!-- Current Status Display -->
              <div class="form-field">
                <label style="font-weight: 600; color: #475569; margin-bottom: 0.5rem; display: block;">Current Status</label>
                <div class="current-value">
                  <span id="serviceStatusValue" class="status-badge" style="font-size: 1rem; padding: 0.5rem 1rem;">Loading...</span>
                </div>
              </div>
            </div>

            <!-- Deliverable Upload Section -->
            <div style="padding: 1.25rem; background: #f0fdf4; border-radius: 8px; border: 2px solid #10b981; margin-bottom: 1.25rem; margin-top: 1.25rem;">
              <label style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; font-weight: 700; color: #047857; font-size: 1rem;">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                Upload Deliverable Files
              </label>
              <input type="file" id="deliverableUpload" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt" style="width: 100%; padding: 1rem; border: 2px dashed #10b981; border-radius: 8px; background: white; cursor: pointer; font-size: 0.875rem;">
              <div style="font-size: 0.8rem; color: #059669; margin-top: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Upload your completed work for the requestor to download. Multiple files allowed.
              </div>
              <div id="deliverablePreview" style="margin-top: 1rem;"></div>
            </div>

            <div class="admin-form-actions" style="display: flex; gap: 1rem;">
              <button type="button" class="admin-btn admin-btn-success" id="uploadDeliverableBtn" style="flex: 1; background: linear-gradient(135deg, #10b981, #059669); padding: 0.875rem 1.5rem; font-size: 1rem; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 0.5rem; box-shadow: 0 4px 6px rgba(16, 185, 129, 0.3);">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                </svg>
                Upload Deliverable
              </button>
              <button type="button" class="admin-btn admin-btn-primary" id="markDoneBtn" style="flex: 1; background: linear-gradient(135deg, #3b82f6, #2563eb); padding: 0.875rem 1.5rem; font-size: 1rem; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 0.5rem; box-shadow: 0 4px 6px rgba(59, 130, 246, 0.3);">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Mark as Completed
              </button>
            </div>
          </div>

          <!-- Description Section -->
          <div class="description-section">
            <h3>Project Description</h3>
            <div class="description-content" id="detailDescription"></div>
          </div>

          <!-- Files Section -->
          <div id="file-preview"></div>

          <!-- Quick Actions -->
          <div class="quick-action-buttons">
            <button class="quick-action-btn chat" id="openChatFromModal">
              <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>Start Conversation
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Conversation Modal -->
  <div id="conversationModal" class="modal" style="display:none;">
    <div class="modal-content" style="max-width: 800px; width: 90%; height: 100vh; overflow: hidden;">
      <header class="modal-header">
        <span class="modal-title">Conversation</span>
        <span class="close" id="closeConversationModal">&times;</span>
      </header>
      <div class="modal-body" style="display: flex; flex-direction: column; height: calc(100% - 60px); padding: 0; overflow: hidden;">
        <div id="messagesContainer" style="flex: 1; overflow-y: auto; padding: 1rem; background: #f9f9f9; min-height: 400px;">
        </div>
        <div style="padding: 1rem; border-top: 1px solid #e5e7eb; background: white; flex-shrink: 0;">
          <!-- Message Formatting Toolbar -->
          <div id="formattingToolbar" style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem; padding: 0.5rem; background: #f8fafc; border-radius: 0.375rem; border: 1px solid #e2e8f0;">
            <button type="button" id="boldBtn" class="format-btn" title="Bold" style="padding: 0.375rem 0.5rem; border: 1px solid #d1d5db; background: white; border-radius: 0.25rem; cursor: pointer; font-weight: bold; font-size: 0.875rem; transition: all 0.2s;">
              <strong>B</strong>
            </button>
            <button type="button" id="italicBtn" class="format-btn" title="Italic" style="padding: 0.375rem 0.5rem; border: 1px solid #d1d5db; background: white; border-radius: 0.25rem; cursor: pointer; font-style: italic; font-size: 0.875rem; transition: all 0.2s;">
              <em>I</em>
            </button>
            <button type="button" id="underlineBtn" class="format-btn" title="Underline" style="padding: 0.375rem 0.5rem; border: 1px solid #d1d5db; background: white; border-radius: 0.25rem; cursor: pointer; text-decoration: underline; font-size: 0.875rem; transition: all 0.2s;">
              U
            </button>
            <div style="width: 1px; height: 1.5rem; background: #d1d5db; align-self: center; margin: 0 0.25rem;"></div>
            <button type="button" id="imageBtn" class="format-btn" title="Upload Image" style="padding: 0.375rem 0.5rem; border: 1px solid #d1d5db; background: white; border-radius: 0.25rem; cursor: pointer; font-size: 0.875rem; transition: all 0.2s;">
              ðŸ“·
            </button>
            <button type="button" id="fileBtn" class="format-btn" title="Upload File" style="padding: 0.375rem 0.5rem; border: 1px solid #d1d5db; background: white; border-radius: 0.25rem; cursor: pointer; font-size: 0.875rem; transition: all 0.2s;">
              ðŸ“Ž
            </button>
            <div style="flex: 1;"></div>
            <span style="font-size: 0.75rem; color: #6b7280; align-self: center;">Format your text</span>
          </div>
          
          <!-- Hidden file inputs -->
          <input type="file" id="imageUpload" accept="image/*" style="display: none;">
          <input type="file" id="fileUpload" style="display: none;">
          
          <!-- Attachment preview area -->
          <div id="attachmentPreview" style="display: none; margin-bottom: 0.75rem; padding: 0.5rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.375rem; max-height: 80px; overflow: hidden;">
            <div style="display: flex; align-items: center; justify-content: space-between; min-height: 24px;">
              <div id="attachmentInfo" style="display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 0;">
                <span id="attachmentIcon" style="flex-shrink: 0;">ðŸ“·</span>
                <span id="attachmentName" style="font-size: 0.875rem; color: #374151; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"></span>
              </div>
              <button type="button" id="removeAttachment" style="padding: 0.25rem; border: none; background: none; cursor: pointer; color: #ef4444; font-size: 1rem; flex-shrink: 0;" title="Remove attachment">
                âœ•
              </button>
            </div>
            <div id="imagePreviewContainer" style="margin-top: 0.25rem; display: none; max-height: 40px; overflow: hidden;">
              <img id="imagePreview" style="max-width: 80px; max-height: 40px; border-radius: 0.25rem; cursor: pointer; object-fit: cover;" onclick="openImageModal(this.src)">
            </div>
          </div>
          
          <div style="display: flex; gap: 0.5rem;">
            <input type="text" id="messageInput" placeholder="Type your message..." 
                   style="flex: 1; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.375rem; font-family: 'Inter', sans-serif;">
            <button id="sendMessageBtn" class="view-all-btn" style="background: var(--primary-green); color: white;">
              Send
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>


  <!-- User Organization Data Script -->
  <script type="application/json" id="userOrgData">
  {
    "userType": "<%= user.userType %>",
    "organizations": <%- JSON.stringify(user.userType === 'student' ? (user.studentOrganization || []) : (user.affiliation || [])) %>
  }
  </script>
<script src="/javascripts/ejs/Unit/taskapprovals.js"></script>
</div>
</div>
</body>
</html>