  <script>
    // Define current user role for conversation
    window.currentUserRole = 'unit';
    window.currentUserFullName = '<%= user.fName %> <%= user.lName %>';
    
    // Global variables for archived request modal
    let currentArchivedRequestId = null;
    let currentArchivedRequestType = null;

    function closeArchivedRequestModal() {
      const modal = document.getElementById('archivedRequestModal');
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    function openArchivedRequestModal(requestId, requestType) {
      console.log('Opening archived request modal:', { requestId, requestType });
      
      currentArchivedRequestId = requestId;
      currentArchivedRequestType = requestType;
      
      // Fetch the request details
      fetch(`/api/request/${requestId}`)
        .then(response => response.json())
        .then(data => {
          if (data.archived) {
            // Display the archived request information
            document.getElementById('archivedRequestTitle').textContent = data.title || 'Untitled';
            document.getElementById('archivedRequestStatus').textContent = data.previousStatus || 'Unknown';
            document.getElementById('archivedRequestDate').textContent = data.deletedAt
              ? new Date(data.deletedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
              : 'Unknown';
            document.getElementById('archivedRequestReason').textContent = data.archiveReason || 'No reason provided.';

            // Clear previous input
            document.getElementById('restorationReasonInput').value = '';

            // Show "already pending" banner instead of the input form if this user already has a pending plea
            const banner = document.getElementById('alreadyPendingBanner');
            const inputSection = document.getElementById('restorationInputSection');
            if (data.hasPendingRestoration) {
              document.getElementById('alreadyPendingText').textContent =
                `You already submitted a restoration request on ${data.myRestorationRequestedAt ? new Date(data.myRestorationRequestedAt).toLocaleDateString() : 'an earlier date'}: "${data.myRestorationReason || ''}" — awaiting admin review.`;
              banner.style.display = 'block';
              inputSection.style.display = 'none';
            } else {
              banner.style.display = 'none';
              inputSection.style.display = '';
            }

            // Show the modal
            const modal = document.getElementById('archivedRequestModal');
            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
          } else {
            alert('This request is not archived. Please try again.');
            closeArchivedRequestModal();
          }
        })
        .catch(error => {
          console.error('Error fetching request:', error);
          alert('Failed to load request details. Please try again.');
          closeArchivedRequestModal();
        });
    }

    function submitRestorationRequest() {
      const reason = document.getElementById('restorationReasonInput').value.trim();
      
      if (!reason) {
        alert('Please provide a reason for restoration.');
        return;
      }
      
      if (!currentArchivedRequestId || !currentArchivedRequestType) {
        alert('Request information is missing. Please try again.');
        return;
      }

      // Submit restoration request
      fetch('/api/request-restoration', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          requestId: currentArchivedRequestId,
          requestType: currentArchivedRequestType,
          reason: reason
        })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          alert('Your restoration request has been submitted successfully. An administrator will review it soon.');
          closeArchivedRequestModal();
        } else {
          alert(`Error: ${data.message}`);
        }
      })
      .catch(error => {
        console.error('Error submitting restoration request:', error);
        alert('Failed to submit restoration request. Please try again.');
      });
    }

    // Close modal on overlay click
    document.addEventListener('DOMContentLoaded', function() {
      const modal = document.getElementById('archivedRequestModal');
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            closeArchivedRequestModal();
          }
        });
      }
    });
  </script>

