<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/x-icon" href="/Picture/favicon.ico?v=2">
    <link rel="shortcut icon" href="/Picture/favicon.ico?v=2">
    <meta name="theme-color" content="#1a5d1a">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Approval Tasks - S-CORE</title>

  <!-- Base Stylesheet and Google Fonts (same as AllTasks) -->
  <link rel="stylesheet" href="/stylesheets/ejs/table-fixes.css" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/stylesheets/status-badges-new.css" />
  <link rel="stylesheet" href="/stylesheets/notifications.css" />
  <link rel="stylesheet" href="/stylesheets/unit-navbar.css" />
  <link rel="stylesheet" href="/stylesheets/modal-centered.css" />
  <link rel="stylesheet" href="/stylesheets/no-animations.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/alltasks.css?v=6" />
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/alltasks-modal.css?v=11" />
  <link rel="stylesheet" href="/stylesheets/ejs/Unit/alltasks-conversation-modal.css?v=3" />
  <link rel="stylesheet" href="/stylesheets/ejs/allrequestsadmin.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="/javascripts/alert-handler.js"></script>
  <script src="/javascripts/unit-navbar.js"></script>
</head>
<body>
  <!-- Unit Sidebar Navigation -->
  <%- include('../partials/unit-navbar', { user: user, activePage: 'task-approvals' }) %>

  <!-- MAIN CONTENT WITH HEADER -->
  <div class="unit-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="unit-menu-toggle" id="unitMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/unit/dashboard" class="text-wrapper">S-CORE UNIT</a>
      </div>
      
      <span class="text-wrapper-2">Approval Tasks</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user-placeholder.svg' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/unit/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="student-side">
      <div class="div">
        <section class="activity-section">
          <div class="section-header" style="padding: 2rem 3rem 0 3rem;">
            <h1><%= unitTeam %> Team - Approval Requests</h1>
            <p>Process and collaborate on approval requests assigned to your unit</p>
          </div>
          
          <nav class="nav-tabs tabs" style="padding: 0 3rem; margin-bottom: 1.5rem;">
            <a href="/unit/all-tasks" class="tab-btn">All Tasks</a>
            <a href="/unit/task-approvals" class="tab-btn active">Approvals</a>
            <a href="/unit/task-services" class="tab-btn">Services</a>
          </nav>
          
          <hr style="margin: 0 3rem 2rem 3rem; border: none; border-top: 2px solid #e5e7eb;">

          <!-- Filter Options (aligned with AllTasks filters for full functionality) -->
          <div class="filter-section">
            <div class="filter-toggle-header" onclick="toggleFilterSection(this)">
              <span class="filter-toggle-header-text">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display:inline-block;vertical-align:middle;">
                  <path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/>
                </svg>
                Filters &amp; Options
              </span>
              <span class="filter-toggle-icon">▼</span>
            </div>
            <div class="filter-toggle-body collapsed">
            <div class="filter-container">
              <div class="filter-group">
                <!-- First Row: Request ID, User, Status -->
                <div class="filter-controls">
                  <div class="filter-item">
                    <label for="requestIdFilter" class="filter-sublabel">Request ID</label>
                    <input type="text" id="requestIdFilter" class="filter-input" placeholder="Search request ID...">
                  </div>
                  <div class="filter-item">
                    <label for="studentFilter" class="filter-sublabel">User</label>
                    <input type="text" id="studentFilter" class="filter-input" placeholder="Search user name...">
                  </div>
                  <div class="filter-item">
                    <label class="filter-sublabel">Status</label>
                    <div class="enhanced-multi-select-wrapper">
                      <div class="enhanced-multi-select" id="statusFilter">
                        <div class="select-display" data-placeholder="Select Status">
                          <span class="selected-text">All Status</span>
                          <span class="dropdown-arrow">▼</span>
                        </div>
                        <div class="select-dropdown" id="statusDropdown">
                          <div class="options-container"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Second Row: Student Organization and Office/Department -->
                <div class="filter-controls dropdown-row">
                  <div class="filter-item">
                    <label for="studentOrgFilter" class="filter-sublabel">Student Organization</label>
                    <div class="enhanced-multi-select-wrapper">
                      <div class="enhanced-multi-select" id="studentOrgFilter">
                        <div class="select-display" data-placeholder="Select Student Organizations">
                          <span class="selected-text">All Student Organizations</span>
                          <span class="dropdown-arrow">▼</span>
                        </div>
                        <div class="select-dropdown" id="studentOrgDropdown">
                          <div class="search-container">
                            <input type="text" class="search-input" placeholder="Search organizations...">
                          </div>
                          <div class="options-container"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="filter-item">
                    <label for="officeDeptFilter" class="filter-sublabel">Office/Department</label>
                    <div class="enhanced-multi-select-wrapper">
                      <div class="enhanced-multi-select" id="officeDeptFilter">
                        <div class="select-display" data-placeholder="Select Offices/Departments">
                          <span class="selected-text">All Offices/Departments</span>
                          <span class="dropdown-arrow">▼</span>
                        </div>
                        <div class="select-dropdown" id="officeDeptDropdown">
                          <div class="search-container">
                            <input type="text" class="search-input" placeholder="Search offices/departments...">
                          </div>
                          <div class="options-container"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Third Row: Sort By, Date From and Date To -->
                <div class="filter-controls">
                  <div class="filter-item">
                    <label for="sortByFilter" class="filter-sublabel">Sort By</label>
                    <select id="sortByFilter" class="filter-input">
                      <option value="deadline-asc">Deadline (Soonest First)</option>
                      <option value="deadline-desc">Deadline (Latest First)</option>
                      <option value="date-desc">Date Submitted (Newest)</option>
                      <option value="date-asc">Date Submitted (Oldest)</option>
                    </select>
                  </div>
                  <div class="filter-item">
                    <label for="dateFromFilter" class="filter-sublabel">Date From</label>
                    <input type="date" id="dateFromFilter" class="filter-input">
                  </div>
                  <div class="filter-item">
                    <label for="dateToFilter" class="filter-sublabel">Date To</label>
                    <input type="date" id="dateToFilter" class="filter-input">
                  </div>
                  <div class="filter-item" style="visibility: hidden;"></div>
                </div>
              </div>

              <div class="filter-actions">
                <button id="clearFilters" class="clear-filters-btn">
                  <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="6" width="18" height="14" rx="2"/>
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    <line x1="1" y1="6" x2="23" y2="6"/>
                    <line x1="10" y1="11" x2="10" y2="17"/>
                    <line x1="14" y1="11" x2="14" y2="17"/>
                  </svg>
                  Clear All
                </button>
                <div class="results-count">
                  <span id="resultsCount">Showing all requests</span>
                </div>
              </div>
            </div>
            </div>
          </div>

          <!-- Requests Table -->
          <div class="table-section" style="background: white; padding: 1.5rem; margin: 0 3rem 2rem 3rem;">
            <table class="requests-table" style="width: 100%;">
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Title</th>
                  <th>Requestor</th>
                  <th>Organization/Office/Dept</th>
                  <th>Date Submitted</th>
                  <th>Status</th>
                  <th style="text-align: center;">Deadline</th>
                </tr>
              </thead>
              <tbody id="requestsTableBody">
                <% 
                // Smart sorting for approval requests
                const allRequests = (approvalRequests || []).map(r => ({...r, requestType: 'approval'}))
                  .sort((a, b) => {
                    const statusPriority = {
                      'Queued': 1,
                      'In Progress': 2,
                      'Pending': 3,
                      'For Revision': 4,
                      // Finalized statuses should always appear last in this specific order
                      // Completed (most recent first), then Approved, Rejected, then Cancelled/Archived
                      'Completed': 5,
                      'Approved': 6,
                      'Rejected': 7,
                      'Cancelled': 8
                    };
                    
                    const aPriority = statusPriority[a.status] || 999;
                    const bPriority = statusPriority[b.status] || 999;
                    
                    if (aPriority === bPriority) {
                      if (aPriority <= 4) {
                        if (!a.deadline && !b.deadline) return new Date(b.createdAt) - new Date(a.createdAt);
                        if (!a.deadline) return 1;
                        if (!b.deadline) return -1;
                        return new Date(a.deadline) - new Date(b.deadline);
                      }
                      return new Date(b.createdAt) - new Date(a.createdAt);
                    }
                    
                    return aPriority - bPriority;
                  });
                %>
                
                <% if (allRequests && allRequests.length > 0) { %>
                  <% allRequests.forEach(request => { %>
                    <% 
                      const isApproval = true; // only approvals on this page
                      const type = 'approval';
                      const title = request.title || request.projectTitle || 'Untitled';
                      const requestor = request.userId ? `${request.userId.fName} ${request.userId.lName}` : 'Unknown';
                      
                      // Prefer the organization actually saved on the request itself;
                      // only derive from the requestor's profile if that's empty.
                      let organization = (request.organization || '').trim();
                      if (!organization && request.userId) {
                        if (request.userId.studentOrganization && Array.isArray(request.userId.studentOrganization) && request.userId.studentOrganization.length > 0) {
                          organization = request.userId.studentOrganization[0];
                        } else if (request.userId.affiliation && Array.isArray(request.userId.affiliation) && request.userId.affiliation.length > 0) {
                          organization = request.userId.affiliation[0];
                        }
                      }
                      
                      const dateSubmitted = new Date(request.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                      const status = request.status || 'Pending';
                      const files = request.files || [];
                      const deadline = request.deadline || '';
                      const description = request.description || '';
                      const requestorEmail = request.userId ? request.userId.email : '';
                    %>
                    <tr class="request-row clickable" 
                        data-request-id="<%= request._id %>"
                        data-request-type="<%= type %>"
                        data-title="<%= title.replace(/"/g, '&quot;') %>"
                        data-requestor="<%= requestor.replace(/"/g, '&quot;') %>"
                        data-requestor-email="<%= requestorEmail.replace(/"/g, '&quot;') %>"
                        data-organization="<%= organization.replace(/"/g, '&quot;') %>"
                        data-description="<%= description.replace(/"/g, '&quot;') %>"
                        data-date-submitted="<%= dateSubmitted %>"
                        data-status="<%= status %>"
                        data-awaiting-resubmission="<%= request.awaitingResubmission ? 'true' : 'false' %>"
                        data-files='<%= JSON.stringify(files) %>'
                        data-links='<%= JSON.stringify(request.links || []) %>'
                        data-deadline="<%= deadline %>">
                      <td>
                        <span class="type-badge <%= type %>">
                          Approval
                        </span>
                      </td>
                      <td class="title-cell"><%= title %></td>
                      <td><%= requestor %></td>
                      <td><%= organization %></td>
                      <td><%= dateSubmitted %></td>
                      <td>
                        <span class="status-badge <%= status.toLowerCase().replace(/\s+/g, '-') %>"><%= status %></span>
                      </td>
                      <td style="text-align: center;">
                        <% if (deadline) { %>
                          <% 
                            const today = new Date();
                            today.setHours(0,0,0,0);
                            const deadlineDate = new Date(deadline);
                            deadlineDate.setHours(0,0,0,0);
                            const timeDiff = deadlineDate - today;
                            const daysDiff = Math.ceil(timeDiff / (1000 * 60 * 60 * 24));
                            const isOverdue = daysDiff < 0 && (status.toLowerCase() === 'pending' || status.toLowerCase() === 'queued' || status.toLowerCase() === 'in-progress' || status.toLowerCase() === 'for-revision');
                            const isNearDeadline = daysDiff >= 0 && daysDiff <= 1 && (status.toLowerCase() === 'pending' || status.toLowerCase() === 'queued' || status.toLowerCase() === 'in-progress' || status.toLowerCase() === 'for-revision');
                          %>
                          <span class="deadline-badge <%= isOverdue ? 'overdue' : isNearDeadline ? 'near-deadline' : '' %>">
                            <%= new Date(deadline).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                          </span>
                        <% } else { %>
                          <span style="color: #94a3b8;">—</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" style="text-align: center; padding: 3rem; color: #64748b;">
                      <svg width="64" height="64" fill="none" stroke="#059669" stroke-width="1.5" viewBox="0 0 24 24" style="display: block; margin: 0 auto 1rem;">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                      </svg>
                      <h3 style="color: #065f46; margin: 0 0 0.5rem; font-size: 1.25rem; font-weight: 600;">No Tasks Found</h3>
                      <p style="color: #6b7280; margin: 0; font-size: 0.9rem;">No approval tasks assigned to your unit yet.</p>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </div>

  <!-- Request Details Modal - reuse same modals and scripts as AllTasks for identical functionality -->
  <div id="requestDetailsModal" class="modal" style="display: none;">
    <div class="modal-content unit-modal-wide">
      <div class="modal-header unit-modal-header">
        <div class="modal-title-section">
          <svg class="modal-title-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="4" y="4" width="16" height="16" rx="2"/>
            <line x1="8" y1="8" x2="16" y2="8"/>
            <line x1="8" y1="12" x2="16" y2="12"/>
            <line x1="8" y1="16" x2="12" y2="16"/>
          </svg>
          <h2 id="modalTitle">Request Details</h2>
          <span class="type-badge" id="modalTypeBadge">APPROVAL</span>
        </div>
        <button class="close-modal-btn" onclick="closeRequestModal()" aria-label="Close">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <div class="modal-body unit-modal-body">
        <div class="unit-left-column">
          <div class="unit-info-card">
            <div class="unit-card-header">
              <h3>Request Information</h3>
              <p class="unit-card-subtitle">Complete details about this request</p>
            </div>
            <div class="unit-info-grid">
              <div class="unit-info-item">
                <span class="unit-info-label">Requestor</span>
                <span class="unit-info-value" id="modalRequestor">Loading...</span>
              </div>
              <div class="unit-info-item">
                <span class="unit-info-label">Email</span>
                <span class="unit-info-value" id="modalRequestorEmail">Loading...</span>
              </div>
              <div class="unit-info-item">
                <span class="unit-info-label">Organization/Office/Dept</span>
                <span class="unit-info-value" id="modalOrganization">Loading...</span>
              </div>
              <div class="unit-info-item">
                <span class="unit-info-label">Date Submitted</span>
                <span class="unit-info-value" id="modalDate">Loading...</span>
              </div>
              <div class="unit-info-item">
                <span class="unit-info-label">Current Status</span>
                <span class="status-badge" id="modalStatus">Pending</span>
              </div>
              <div class="unit-info-item" id="approvedOnField" style="display: none;">
                <span class="unit-info-label">Approved On</span>
                <span class="unit-info-value" id="modalApprovedOn" style="color: #16a34a; font-weight: 600;">—</span>
              </div>
              <div class="unit-info-item" id="deadlineField" style="display: none;">
                <span class="unit-info-label">Deadline</span>
                <span class="unit-info-value" id="modalDeadline">—</span>
              </div>
            </div>
          </div>

          <!-- Administrative Controls -->
          <div class="admin-form-section">
            <h3>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
              </svg>
              Unit Actions
              <span class="admin-badge">APPROVE OR REVISE</span>
            </h3>

            <div class="admin-action-buttons">
              <button type="button" class="admin-btn admin-btn-success" id="adminApproveBtn">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <polyline points="20,6 9,17 4,12"/>
                </svg>
                Approve Request
              </button>
              <button type="button" class="admin-btn admin-btn-warning" id="adminRevisionBtn">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 1-2 2"/>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
                Ask for Revisions
              </button>
            </div>

            <!-- Approved Status Indicator + Revoke Approval (shown only when status is Approved) -->
            <div id="approvalStatusIndicator" style="display: none; margin-top: 1rem;">
              <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
                <p style="color: #166534; margin: 0; font-size: 0.9rem; display: flex; align-items: center; gap: 0.5rem;">
                  <svg width="18" height="18" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                  </svg>
                  This request has been approved.
                </p>
                <button type="button" class="admin-btn admin-btn-warning" id="revokeApprovalBtn">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                    <path d="M21 3v5h-5"/>
                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                    <path d="M3 21v-5h5"/>
                  </svg>
                  Revoke Approval
                </button>
              </div>

              <!-- Revoke Approval Form (hidden until Revoke Approval is clicked) -->
              <div id="revokeApprovalForm" class="revision-form-container" style="display: none; margin-top: 1rem;">
                <div class="revision-form-header">
                  <h4>Revoke Approval</h4>
                  <p>This sends the request back to "For Revision" so the requestor can resubmit. The requestor and admins will be notified. Reason is optional.</p>
                </div>
                <textarea id="revokeReasonText" class="unit-textarea" placeholder="Reason for revoking this approval (optional)..." rows="4"></textarea>
                <div class="revision-form-actions">
                  <button type="button" class="admin-btn admin-btn-secondary" id="cancelRevokeBtn">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <line x1="18" y1="6" x2="6" y2="18"/>
                      <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                    Cancel
                  </button>
                  <button type="button" class="admin-btn admin-btn-warning" id="confirmRevokeBtn">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                      <path d="M21 3v5h-5"/>
                      <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                      <path d="M3 21v-5h5"/>
                    </svg>
                    Confirm Revoke
                  </button>
                </div>
              </div>
            </div>

            <!-- Revision Form (hidden by default) -->
            <div id="revisionForm" class="revision-form-container" style="display: none;">
              <div class="revision-form-header">
                <h4>Request Revisions</h4>
                <p>Provide detailed feedback on what needs to be changed or improved</p>
              </div>

              <div class="unit-format-toolbar">
                <button type="button" class="format-btn" data-revision-format="bold" title="Bold (Ctrl+B)">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/>
                    <path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/>
                  </svg>
                </button>
                <button type="button" class="format-btn" data-revision-format="italic" title="Italic (Ctrl+I)">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <line x1="19" y1="4" x2="10" y2="4"/>
                    <line x1="14" y1="20" x2="5" y2="20"/>
                    <line x1="15" y1="4" x2="9" y2="20"/>
                  </svg>
                </button>
                <button type="button" class="format-btn" data-revision-format="underline" title="Underline (Ctrl+U)">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3"/>
                    <line x1="4" y1="21" x2="20" y2="21"/>
                  </svg>
                </button>
                <span class="toolbar-hint">Format your revision request</span>
              </div>

              <div id="revisionComments" contenteditable="true" role="textbox" aria-multiline="true"
