          </div>
          <h3 class="card-title">User Accounts</h3>
          <p class="card-subtitle">Manage user accounts</p>
          <div class="card-arrow">→</div>
        </div>

        <!-- Enhanced Calendar with deadlines and maximize/minimize functionality -->
        <div class="calendar-standalone">
          <!-- Fixed Calendar Header -->
