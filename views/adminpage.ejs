         <!-- Guide Lines -->
    <div class="guidelines-container">
  <div class="guidelines-header" onclick="toggleGuidelines()" style="cursor: pointer;">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <h4 class="guidelines-title">Request Guidelines</h4>
