    function closeModal(id) {
        document.getElementById(id).style.display = 'none';
    }

    window.onclick = function (e) {
        ['updateProfileModal', 'passwordModal', 'pictureModal'].forEach(id => {
        if (e.target.id === id) closeModal(id);
        });
    };

 document.getElementById('updateProfileForm').onsubmit = async function (e) {
  e.preventDefault();
  const form = e.target;

  let data = {};
  const formData = new FormData(form);

  for (const [key, value] of formData.entries()) {
    data[key] = value;
  }

  // For student users, override studentOrganization with select2 selected array
  if (document.getElementById('studentOrganizationSelect')) {
    const selectedOrgs = $('#studentOrganizationSelect').val() || [];
    data.studentOrganization = selectedOrgs;
  }

  const res = await fetch('/admin/profile/update-popup', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  });

  if (res.ok) {
    location.reload();
  } else {
    alert('Update failed');
  }
};


    document.getElementById('passwordForm').onsubmit = async function (e) {
      e.preventDefault();
      const form = e.target;
      const data = Object.fromEntries(new FormData(form).entries());

      const res = await fetch('/admin/profile/change-password-popup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (res.ok) {
        alert('Password updated');
        closeModal('passwordModal');
      } else {
        const err = await res.text();
        alert(err);
      }
    };
document.getElementById('pictureForm').onsubmit = async function (e) {
  e.preventDefault();
  const form = e.target;
  const formData = new FormData(form);

  try {
    const res = await fetch('/profileadmin/upload-picture', {
      method: 'POST',
      body: formData
    });

    if (!res.ok) {
      const err = await res.text();
      throw new Error(err);
    }

    alert('Profile picture updated!');
    location.reload();
  } catch (error) {
    alert('Error uploading picture: ' + error.message);
  }
};



  document.getElementById('deletePictureForm').onsubmit = async function (e) {
    e.preventDefault();

    if (!confirm('Are you sure you want to delete your profile picture?')) return;

    const res = await fetch('/profileadmin/delete-picture', {
      method: 'POST'
    });

    if (res.ok) {
      alert('Profile picture deleted.');
      location.reload();
    } else {
      const err = await res.text();
      alert('Error: ' + err);
    }
  };
document.getElementById('addOrganizationButton').addEventListener('click', () => {
  const input = document.getElementById('otherOrganization');
  const newOrg = input.value.trim();
  if (!newOrg) {
    alert('Please enter an organization name.');
    return;
  }

  const select = $('#studentOrganizationSelect');

  // Case-insensitive duplicate check
  const optionExists = select.find('option').filter(function() {
    return $(this).val().toLowerCase() === newOrg.toLowerCase();
  }).length > 0;

  if (optionExists) {
    alert('This organization is already added.');
    return;
  }

  // Append new option, not selected yet
      const newOption = new Option(newOrg, newOrg, true, true); // mark selected now
      select.append(newOption);

      let currentSelected = select.val() || [];
      if (!currentSelected.includes(newOrg)) {
        currentSelected.push(newOrg);
      }
      select.val(currentSelected).trigger('change');

  input.value = '';
});



//add org
  function toggleCustomOrg() {
  const container = document.getElementById('customOrgContainer');
  if (container.style.display === 'none' || container.style.display === '') {
    container.style.display = 'block';
  } else {
    container.style.display = 'none';
  }
}





  

  </script>

</body>
</html>