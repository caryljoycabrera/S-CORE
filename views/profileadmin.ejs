       // Parse current organizations safely
    let currentOrgs = [];
    try {
      currentOrgs = JSON.parse('<%- JSON.stringify(user.studentOrganization || []) %>');
    } catch {
      currentOrgs = (`<%= user.studentOrganization || '' %>`).split(',').map(o => o.trim()).filter(Boolean);
    }

    // Clear existing options
    select.empty();

    // Add predefined orgs
    organizationOptions.forEach(org => {
      const isSelected = currentOrgs.includes(org);
      const option = new Option(org, org, isSelected, isSelected);
      select.append(option);
    });

    // Add any current orgs not in predefined
    currentOrgs.forEach(org => {
      if (!organizationOptions.includes(org)) {
        const option = new Option(org, org, true, true);
        select.append(option);
      }
    });

    select.val(currentOrgs).trigger('change');
  }
  }

  // NON-STUDENT LOGIC
  if (id === 'updateProfileModal' && '<%= user.userType %>' !== 'student') {
    const select = $('#officeSelect');
