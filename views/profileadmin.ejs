<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Profile</title>
  <link rel="stylesheet" href="/style.css" />
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<style>
 
 
.toggle-org-button {
  background: none;
  color: #198754;
  font-size: 0.875rem;
  padding: 0;
  margin-top: 0.5rem;
  border: none;
  cursor: pointer;
  text-align: left;
}

.add-org-button {
  background-color: #198754;
  border: none;
  color: white;
  font-weight: bold;
  padding: 0 12px;
  font-size: 1rem;
  cursor: pointer;
  border-radius: 4px;
}
  
   .select2-container--default .select2-selection--single {
  border-radius: 4px;
  border: 1px solid #ced4da;
  padding: 0.375rem;
  background-color: #fff;
  min-height: 38px;
}

.select2-container--default .select2-selection--multiple {
  border-radius: 4px;
  border: 1px solid #ced4da;
  padding: 0.375rem;
  background-color: #fff;
  min-height: 38px;
}

.select2-container--default .select2-selection--multiple .select2-selection__choice {
  background-color: #198754;
  border: none;
  color: white;
  font-weight: 500;
  padding: 0 8px;
  margin-top: 4px;
}

.select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
  color: white;
  margin-right: 6px;
  font-weight: bold;
}


</style>

</head>
<body>
  <header class="overlap">
    <div class="group">
      <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
    </div>
    <a href="/admin" class="text-wrapper">S-CORE ADMIN</a>
    <span class="text-wrapper-2">My Profile</span>

    <div class="dropdown-wrapper">
      <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
        <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
        <div class="user">
<img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
        </div>
      </div>
      <div class="dropdown-menu" id="dropdownMenu">
        <a href="/admin/profile">My Profile</a>
        <a href="/logout">Logout</a>
      </div>
    </div>
  </header>

  <main class="student-side">
    <div class="div">
        <section class="activity-section">
        <div class="section-header">
             <div class="profile-info">
            <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" 
     alt="Profile Picture" class="profile-pic-large" style="width:64px;height:64px;border-radius:50%;" />
            <div>
                <h2><%= user.fName %> <%= user.lName %></h2>
                <p style="color: #6b7280;">Admin</p>
            </div>
            </div>
            <a href="/admin" class="view-all-btn" style="display:inline-block;">
            ← Back to Dashboard
            </a>
        </div>

        <div class="profile-table" style="background:white; border-radius:24px; box-shadow:var(--card-shadow); padding:2.5rem;">
            <table class="requests-table" style="border:none;">
            <tbody>
                <tr><td class="label">Full Name:</td><td><%= user.fName %> <%= user.mName %> <%= user.lName %></td></tr>
                <tr><td class="label">Email:</td><td><%= user.email %></td></tr>
                <tr><td class="label">Username:</td><td><%= user.username %></td></tr>
                <tr><td class="label">Phone Number:</td><td><%= user.phoneNumber || 'N/A' %></td></tr>
            <tr>
            <td class="label">
              <% if (user.userType === 'student') { %>
                Organization:
              <% } else { %>
                Office/Department:
              <% } %>
            </td>
            <td>
              <% if (user.userType === 'student') { %>
                <%= user.studentOrganization && user.studentOrganization.length ? user.studentOrganization.join(', ') : 'None' %>
              <% } else { %>
                <%= user.affiliation && user.affiliation.trim() !== '' ? user.affiliation : 'None' %>
              <% } %>
            </td>
          </tr>


            </tbody>
            </table>

             <div style="margin-top:2rem; display:flex; gap:1rem;">
<button id="openUpdateProfile" class="view-all-btn">Update Profile</button>
<button id="openChangePassword" class="view-all-btn">Change Password</button>
<button id="openPictureModal" class="view-all-btn" type="button">Update Profile Picture</button>
            </div>
        </div>
        </section>
    </div>
    </main>

  <div id="updateProfileModal" class="modal" style="display: none;">
  <div class="modal-content">
    <div class="modal-header">
      <h2 class="modal-title">Update Profile</h2>
      <span class="close" onclick="closeModal('updateProfileModal')">&times;</span>
    </div>
      <input type="hidden" name="userId" value="<%= user._id %>" />

    <form id="updateProfileForm" class="modal-form">
      <div class="form-group">
        <label for="fName">First Name</label>
        <input name="fName" id="fName" type="text" value="<%= user.fName %>" required />
      </div>

      <div class="form-group">
        <label for="mName">Middle Name</label>
        <input name="mName" id="mName" type="text" value="<%= user.mName %>" required />
      </div>

      <div class="form-group">
        <label for="lName">Last Name</label>
        <input name="lName" id="lName" type="text" value="<%= user.lName %>" required />
      </div>

      <div class="form-group">
        <label for="email">Email (cannot be changed)</label>
        <input name="email" id="email" type="email" value="<%= user.email %>" disabled />
      </div>

      <div class="form-group">
        <label for="username">Username (cannot be changed)</label>
        <input name="username" id="username" type="text" value="<%= user.username %>" disabled />
      </div>

      <div class="form-group">
        <label for="phoneNumber">Phone Number</label>
        <input name="phoneNumber" id="phoneNumber" type="text" value="<%= user.phoneNumber || '' %>" />
      </div>
            <% if (user.userType === 'student') { %>
                <div class="form-group">
          <label for="studentOrganizationSelect">Organization(s)</label>
          <select name="studentOrganization" id="studentOrganizationSelect" multiple="multiple" style="width: 100%;">
            <!-- JS will populate options -->
          </select>

            <button type="button" class="toggle-org-button" onclick="toggleCustomOrg()">Click here if Student Organization is not in the list</button>

          <div id="customOrgContainer" style="display: none; margin-top: 0.5rem;">
            <label for="otherOrganization">Add Other Student Organization</label>
            <div style="display: flex; gap: 0.5rem; margin-top: 0.25rem;">
              <input type="text" id="otherOrganization" placeholder="Enter organization name" class="form-control" />
              <button type="button" id="addOrganizationButton" class="add-org-button">+</button>
            </div>
          </div>
        </div>

      <% } else { %>
  
        <div class="form-group">
          <label for="officeSelect">Office/Department</label>
          <select name="affiliation" id="officeSelect" style="width: 100%">
            <!-- Options will be populated dynamically by JS -->
          </select>
        </div>
      <% } %>


      <div class="form-actions">
        <button type="submit">Save Changes</button>
      </div>
    </form>
  </div>
</div>


    <div id="passwordModal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
        <h2 class="modal-title">Change Password</h2>
        <span class="close" onclick="closeModal('passwordModal')">&times;</span>
        </div>
        <form id="passwordForm" class="modal-form">
        <div class="form-group">
            <label for="oldPassword">Old Password</label>
            <input name="oldPassword" id="oldPassword" type="password" required />
        </div>
        <div class="form-group">
            <label for="newPassword">New Password</label>
            <input name="newPassword" id="newPassword" type="password" required />
        </div>
        <div class="form-actions">
            <button type="submit">Update Password</button>
        </div>
        </form>
    </div>
    </div>

    <div id="pictureModal" class="modal" style="display: none;">
  <div class="modal-content">
    <div class="modal-header">
      <h2 class="modal-title">Update Profile Picture</h2>
      <span class="close" onclick="closeModal('pictureModal')">&times;</span>
    </div>
    <form id="pictureForm" method="POST" action="/profileadmin/upload-picture" enctype="multipart/form-data">
    <div class="form-group">
      <label for="formFile">Choose new profile picture</label>
      <input class="form-control" type="file" id="formFile" name="profilePicture" accept="image/*" required>
    </div>
    <div class="form-actions" style="flex-wrap: wrap; gap: 0.75rem;">
      <button type="submit" class="submit-btn" style="background: var(--success); color: white;">Upload</button>
    </div>
  </form>

    <form id="deletePictureForm" method="POST" action="/profileadmin/delete-picture">
      <div class="form-actions" style="flex-wrap: wrap; gap: 0.75rem;">
        <button type="submit" class="delete-btn" style="background: var(--danger); color: white;">Delete Profile Picture</button>
      </div>
    </form>
  </div>
</div>

  <script>
    function toggleDropdown() {
      const menu = document.getElementById("dropdownMenu");
      menu.style.display = menu.style.display === "block" ? "none" : "block";
    }

    document.addEventListener("click", function (event) {
      const toggle = document.querySelector(".dropdown-toggle");
      const menu = document.getElementById("dropdownMenu");
      if (!toggle.contains(event.target)) {
        menu.style.display = "none";
      }
    });

    document.getElementById('openUpdateProfile').onclick = () => openModal('updateProfileModal');
    document.getElementById('openChangePassword').onclick = () => openModal('passwordModal');
    document.getElementById('openPictureModal').onclick = () => openModal('pictureModal');

