            const isSelected = office === currentOffice;
            select.append(new Option(office, office, isSelected, isSelected));
          });

          // If user has a custom office, add it
          if (currentOffice && !officeOptions.includes(currentOffice)) {
            select.append(new Option(currentOffice, currentOffice, true, true));
          }

          // Init select2 after options are appended
