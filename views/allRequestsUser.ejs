<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>All Requests</title>
  <link rel="stylesheet" href="/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
<style>
  .modal-title.warning {
  font-size: 1.25rem;
  font-weight: 600;
  color: rgb(194, 122, 40);
}

.message {
  margin-bottom: 1rem;
  max-width: 80%;
}

.admin-message {
  margin-right: auto;
}

.user-message {
  margin-left: auto;
}

.message-content {
  padding: 0.75rem;
  border-radius: 0.5rem;
  background: white;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
}

.user-message .message-content {
  background: var(--primary-green);
  color: white;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
  font-size: 0.875rem;
}

.message-time {
  opacity: 0.7;
  font-size: 0.75rem;
}

.message-text {
  word-wrap: break-word;
}
/* Enhanced Request Details Modal Styles */
.details-modal-body {
  padding: 0;
  max-height: 80vh;
  overflow-y: auto;
}

.details-content {
  padding: 2rem;
}

.details-section {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 2rem;
  margin-bottom: 1.5rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.details-section:hover {
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  transform: translateY(-1px);
}

.details-section h3 {
  margin: 0 0 1.5rem 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary-green);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
  position: relative;
}

.details-section h3::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 60px;
  height: 2px;
  background: var(--primary-green);
  border-radius: 1px;
}

.details-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

.details-field {
  background: white;
  border-radius: 12px;
  padding: 1.25rem;
  border: 1px solid #f1f5f9;
  transition: all 0.3s ease;
}

.details-field:hover {
  border-color: #e2e8f0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.details-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 0.5rem;
  display: block;
}

.details-value {
  font-size: 1rem;
  color: #1e293b;
  line-height: 1.6;
  font-weight: 500;
}

.status-badge-large {
  display: inline-flex;
  align-items: center;
  padding: 0.625rem 1.25rem;
  border-radius: 25px;
  font-size: 0.875rem;
  font-weight: 600;
  text-transform: capitalize;
  border: 2px solid transparent;
  transition: all 0.3s ease;
}

.status-badge-large.pending {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #92400e;
  border-color: #f59e0b;
}

.status-badge-large.approved {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  color: #065f46;
  border-color: #10b981;
}

.status-badge-large.rejected {
  background: linear-gradient(135deg, #fecaca, #fca5a5);
  color: #991b1b;
  border-color: #ef4444;
}

.status-badge-large.completed {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #1e40af;
  border-color: #3b82f6;
}

.deadline-badge-large {
  display: inline-flex;
  align-items: center;
  padding: 0.625rem 1.25rem;
  border-radius: 25px;
  font-size: 0.875rem;
  font-weight: 600;
  background: linear-gradient(135deg, #f8fafc, #f1f5f9);
  color: #475569;
  border: 2px solid #e2e8f0;
  transition: all 0.3s ease;
}

.deadline-badge-large.overdue {
  background: linear-gradient(135deg, #fecaca, #fca5a5);
  color: #dc2626;
  border-color: #ef4444;
}

.deadline-badge-large.near-deadline {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #d97706;
  border-color: #f59e0b;
}

.description-section {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 2rem;
  margin-bottom: 1.5rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.description-section h3 {
  margin: 0 0 1.5rem 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary-green);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
  position: relative;
}

.description-section h3::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 60px;
  height: 2px;
  background: var(--primary-green);
  border-radius: 1px;
}

.description-content {
  background: white;
  border-radius: 12px;
  padding: 1.5rem;
  border: 1px solid #f1f5f9;
  line-height: 1.7;
  color: #374151;
  font-size: 1rem;
}

.chat-section {
  text-align: center;
  margin-top: 1.5rem;
  padding: 2rem;
  background: linear-gradient(135deg, #f0fdf4, #f7fee7);
  border-radius: 16px;
  border: 1px solid #bbf7d0;
}

.chat-btn-enhanced {
  background: linear-gradient(135deg, var(--primary-green), #20c997);
  color: white;
  border: none;
  padding: 1rem 2.5rem;
  border-radius: 30px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 1rem;
  box-shadow: 0 4px 20px rgba(64, 139, 78, 0.2);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.chat-btn-enhanced:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 30px rgba(64, 139, 78, 0.3);
  background: linear-gradient(135deg, #157347, var(--primary-green));
}

/* Enhanced file preview styles */
.enhanced-file-preview {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 2rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  margin-bottom: 1.5rem;
}

.enhanced-file-preview h3 {
  margin: 0 0 1.5rem 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary-green);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
  position: relative;
}

.enhanced-file-preview h3::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 60px;
  height: 2px;
  background: var(--primary-green);
  border-radius: 1px;
}

.file-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 1.5rem;
}

.enhanced-file-item {
  background: white;
  border-radius: 16px;
  padding: 1.5rem;
  border: 2px solid #f1f5f9;
  transition: all 0.3s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.enhanced-file-item:hover {
  border-color: var(--primary-green);
  box-shadow: 0 8px 30px rgba(64, 139, 78, 0.1);
  transform: translateY(-2px);
}

.file-header-enhanced {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid #f1f5f9;
}

.file-icon-enhanced {
  width: 28px;
  height: 28px;
  color: var(--primary-green);
  flex-shrink: 0;
}

.file-info-enhanced {
  flex: 1;
}

.file-name-enhanced {
  font-weight: 600;
  color: #1e293b;
  font-size: 1rem;
  margin: 0;
  word-break: break-word;
  line-height: 1.4;
}

.file-type-enhanced {
  font-size: 0.875rem;
  color: #64748b;
  margin-top: 0.25rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.file-preview-container {
  margin: 1rem 0;
  border-radius: 12px;
  overflow: hidden;
  background: #f8fafc;
}

.download-btn-enhanced {
  background: linear-gradient(135deg, var(--primary-green), #20c997);
  color: white;
  border: none;
  padding: 0.75rem 1.5rem;
  border-radius: 12px;
  font-weight: 600;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  transition: all 0.3s ease;
  margin-top: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: 0 2px 8px rgba(64, 139, 78, 0.2);
}

.download-btn-enhanced:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(64, 139, 78, 0.3);
  color: white;
  text-decoration: none;
  background: linear-gradient(135deg, #157347, var(--primary-green));
}

/* Mobile responsiveness */
@media (max-width: 768px) {
  .details-content {
    padding: 1rem;
  }
  
  .details-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  
  .file-grid {
    grid-template-columns: 1fr;
  }
  
  .details-section {
    padding: 1.5rem;
  }
  
  .enhanced-file-preview {
    padding: 1.5rem;
  }
}

/* No files message styling */
.no-files-message {
  text-align: center;
  padding: 3rem 2rem;
  color: #64748b;
  background: linear-gradient(145deg, #f8fafc, #f1f5f9);
  border-radius: 12px;
  border: 2px dashed #cbd5e1;
}

.no-files-icon {
  width: 64px;
  height: 64px;
  margin: 0 auto 1rem;
  color: #94a3b8;
}

.no-files-title {
  font-size: 1.125rem;
  font-weight: 600;
  color: #475569;
  margin-bottom: 0.5rem;
}

.no-files-subtitle {
  font-size: 0.875rem;
  color: #64748b;
}
</style>
</head>
<body>
  <div class="student-side">
    <div class="div">
      <div class="overlap">
        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/dashboard" class="text-wrapper">S-CORE</a>
        <span class="text-wrapper-2">All Requests</span>

        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>

      <section class="activity-section">
        <div class="section-header">
          <div class="profile-info" style="display: flex; align-items: center; gap: 1rem;">
            <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" 
                 alt="Profile Picture" class="profile-pic-large" style="width:64px;height:64px;border-radius:50%;" />
            <div>
              <h2 style="margin-bottom: 0.25rem;"><%= user.fName %> <%= user.lName %></h2>
              <p style="color: #6b7280;"><%= user.userType === 'student' ? 'Student' : 'Non-Student' %></p>
            </div>
          </div>
        </div>

        <nav class="tabs" style="display: flex; gap: 1rem; margin-bottom: 1rem;">
          <a href="/all-requests" class="view-all-btn" style="background: var(--primary-green); color: white;">All Requests</a>
          <a href="/request-approvals" class="view-all-btn">Request Approvals</a>
          <a href="/service-requests" class="view-all-btn">Service Requests</a>
        </nav>

        <div class="filter-section">
          <div class="filter-container">
            <div class="filter-group">
              <label class="filter-label">Filter by:</label>
              <div class="filter-controls">
                <div class="filter-item">
                  <label for="typeFilter" class="filter-sublabel">Type</label>
                  <select id="typeFilter" class="filter-select">
                    <option value="all">All Types</option>
                    <option value="Request Approval">Request Approval</option>
                    <option value="Service Request">Service Request</option>
                  </select>
                </div>
               <div class="filter-item">
                <label class="filter-sublabel">Status</label>
                <div class="custom-select-wrapper">
                  <div class="custom-select" id="statusFilter">
                    <div class="select-display">All Status</div>
                    <div class="select-dropdown" id="statusDropdown">
                      <label class="dropdown-option">
                        <input type="checkbox" value="all" checked> All Status
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="pending"> Pending
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="approved"> Approved
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="rejected"> Rejected
                      </label>
                    </div>
                  </div>
                </div>
              </div>

              
                <div class="filter-item">
                  <label for="titleFilter" class="filter-sublabel">Title</label>
                  <input type="text" id="titleFilter" class="filter-input" placeholder="Search title...">
                </div>
                <div class="filter-item">
                  <label for="organizationFilter" class="filter-sublabel">Office/Department/Organization</label>
                  <input type="text" id="organizationFilter" class="filter-input" placeholder="Search organization...">
                </div>
              </div>
              <br>
              <div class="filter-controls">
                <div class="filter-item">
                  <label for="dateFromFilter" class="filter-sublabel">Date From</label>
                  <input type="date" id="dateFromFilter" class="filter-input">
                </div>
                <div class="filter-item">
                  <label for="dateToFilter" class="filter-sublabel">Date To</label>
                  <input type="date" id="dateToFilter" class="filter-input">
                </div>
              </div>
            </div>
            <div class="filter-actions">
              <button id="clearFilters" class="clear-filters-btn">
                <span>🗑️</span> Clear All
              </button>
              <div class="results-count">
                <span id="resultsCount">Showing all requests</span>
              </div>
            </div>
          </div>
        </div>

        <section class="table-section" style="overflow-x: auto;">
          <table class="requests-table" style="width: 100%; border-collapse: collapse; border-radius: var(--border-radius); box-shadow: var(--card-shadow); overflow: hidden; background: white;">
            <thead style="background: var(--light-green); color: var(--primary-green);">
              <tr>
                <th>Request ID</th>
                <th>Type</th>
                <th>Project Title</th>
                <th>Office/Department/Organization</th>
                <th>Status</th>
                <th>Assigned Unit</th>
                <th>Date Submitted</th>
              </tr>
            </thead>
<!-- Replace the existing tbody section with this corrected version -->
<tbody id="requestsTableBody">
  <% allRequests.forEach(request => { %>
<tr class="request-row"
    data-id="<%= request._id %>"
    data-type="<%= request.type %>"
    data-title="<%= request.title %>"
    data-status="<%= request.status %>"
    data-organization="<%= request.organization %>"
    data-units="<%= request.assignedUnits || 'Not yet assigned' %>"
    data-datetime="<%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %>"
    data-date="<%= request.datetime ? request.datetime.toISOString().split('T')[0] : new Date(request.createdAt).toISOString().split('T')[0] %>"
    data-deadline="<%= request.deadline ? request.deadline.toLocaleString() : 'N/A' %>"
    data-description="<%= request.description %>" 
    data-file="<%= request.file ? request.file : '' %>"
    data-files="<%= request.files ? request.files.join(',') : '' %>">
    <td><%= request._id.toString().slice(-6) %></td>
    <td>
      <% if (request.type === 'Request Approval') { %>
        <span class="type-badge" style="padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 500; background: #dbeafe; color: #1e40af;">
          Approval
        </span>
      <% } else { %>
        <span class="type-badge" style="padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 500; background: #fef3c7; color: #92400e;">
          Service
        </span>
      <% } %>
    </td>
    <td><%= request.title %></td>
    <td><%= request.organization %></td>
    <td>
      <span class="status-badge <%= request.status.toLowerCase() %>">
        <%= request.status %>
      </span>
    </td>
    <td><%= request.assignedUnits || 'Not yet assigned' %></td>
    <td><%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %></td>
  </tr>
  <% }); %>
</tbody>
          </table>

          <% if (!allRequests || allRequests.length === 0) { %>
          <div style="text-align: center; padding: 2rem; color: #6b7280;">
            <p>No requests found.</p>
          </div>
          <% } %>
        </section>
      </section>
      <a href="/dashboard" class="view-all-btn" style="display: inline-block;">← Back to Dashboard</a>
    </div>
  </div>

<div id="detailsModal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width: 1000px;">
    <header class="modal-header">
      <span class="modal-title">Request Details</span>
      <span class="close" id="closeDetailsModal">&times;</span>
    </header>
    <div class="modal-body details-modal-body">
      <div class="details-content">
        <!-- General Information Section -->
<!-- General Information Section - ROW LAYOUT -->
<div class="details-section">
  <h3>General Information</h3>
  <div style="display: flex; flex-direction: column; gap: 1rem;">
    <div class="details-field">
      <div class="details-label">Request Type</div>
      <div class="details-value" id="detailType"></div>
    </div>
    
    <div class="details-field">
      <div class="details-label">Project Title</div>
      <div class="details-value" id="detailTitle"></div>
    </div>
    
    <div class="details-field">
      <div class="details-label">Organization</div>
      <div class="details-value" id="detailOrganization"></div>
    </div>
    
    <div class="details-field">
      <div class="details-label">Date Submitted</div>
      <div class="details-value" id="detailDatetime"></div>
    </div>
  </div>
</div>

        <!-- Status & Assignment Section -->
        <div class="details-section">
          <h3>Status & Assignment</h3>
          <div class="details-grid">
            <div class="details-field">
              <div class="details-label">Current Status</div>
              <div class="details-value">
                <span class="status-badge-large" id="detailStatusBadge">
                  <span id="detailStatus"></span>
                </span>
              </div>
            </div>
            
            <div class="details-field">
              <div class="details-label">Assigned Units</div>
              <div class="details-value" id="detailUnits"></div>
            </div>
            
            <div class="details-field" id="deadlineSection" style="display: none;">
              <div class="details-label">Requested Deadline</div>
              <div class="details-value">
                <span class="deadline-badge-large" id="detailDeadlineBadge">
                  <span id="detailDeadline"></span>
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Description Section -->
        <div class="description-section">
          <h3>Description</h3>
          <div class="description-content" id="detailDescription"></div>
        </div>

        <!-- Files Section -->
        <div id="file-preview"></div>

        <!-- Chat Section -->
        <div class="chat-section" id="chatButtonSection" style="display: none;">
          <h4 style="margin: 0 0 1rem 0; color: var(--primary-green); font-weight: 600;">Need to discuss this request?</h4>
          <button id="openChatFromDetailsModal" class="chat-btn-enhanced">
            Start Conversation with Admin
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

      <!-- Conversation Modal - ADD THIS ENTIRE BLOCK -->
  <div id="conversationModal" class="modal" style="display:none;">
    <div class="modal-content" style="max-width: 800px; width: 90%; height: 80vh; overflow: hidden;">
      <header class="modal-header">
        <span class="modal-title">Conversation</span>
        <span class="close" id="closeConversationModal">&times;</span>
      </header>
      <div class="modal-body" style="display: flex; flex-direction: column; height: calc(100% - 60px); padding: 0; overflow: hidden;">
        <div id="messagesContainer" style="flex: 1; overflow-y: auto; padding: 1rem; background: #f9f9f9; min-height: 400px;">
        </div>
        <div style="padding: 1rem; border-top: 1px solid #e5e7eb; background: white; flex-shrink: 0;">
          <div style="display: flex; gap: 0.5rem;">
            <input type="text" id="messageInput" placeholder="Type your message..." 
                   style="flex: 1; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.375rem;">
            <button id="sendMessageBtn" class="view-all-btn" style="background: var(--primary-green); color: white;">
              Send
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>


  <script>
    const detailModal = document.getElementById("detailsModal");
    const closeDetailsModal = document.getElementById("closeDetailsModal");
    const typeFilter = document.getElementById("typeFilter");
    const clearFiltersBtn = document.getElementById("clearFilters");
    const tableBody = document.getElementById("requestsTableBody");
    const allRows = Array.from(document.querySelectorAll('.request-row'));
     const conversationModal = document.getElementById("conversationModal");
    const closeConversationModal = document.getElementById("closeConversationModal");
    const messagesContainer = document.getElementById("messagesContainer");
    const messageInput = document.getElementById("messageInput");
    const sendMessageBtn = document.getElementById("sendMessageBtn");
    const openChatFromDetailsModal = document.getElementById("openChatFromDetailsModal");
    let currentConversationId = null;

    closeDetailsModal.onclick = () => detailModal.style.display = 'none';

