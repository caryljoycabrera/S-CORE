    // Custom Status Filter Logic
const statusFilterElement = document.getElementById('statusFilter');
const statusDropdown = document.getElementById('statusDropdown');
const statusDisplay = statusFilterElement.querySelector('.select-display');
const statusCheckboxes = statusDropdown.querySelectorAll('input[type="checkbox"]');
const allStatusCheckbox = statusDropdown.querySelector('input[value="all"]');

// Toggle dropdown
statusFilterElement.addEventListener('click', function(e) {
  e.stopPropagation();
  statusFilterElement.classList.toggle('active');
});

// Close dropdown when clicking outside
document.addEventListener('click', function() {
  statusFilterElement.classList.remove('active');
});

// Handle checkbox changes
statusCheckboxes.forEach(checkbox => {
  checkbox.addEventListener('change', function() {
    if (this.value === 'all') {
      // If "All Status" is checked, uncheck others
      if (this.checked) {
        statusCheckboxes.forEach(cb => {
          if (cb.value !== 'all') cb.checked = false;
        });
      }
    } else {
      // If any specific status is checked, uncheck "All Status"
      if (this.checked) {
        allStatusCheckbox.checked = false;
      }
      
      // If no specific status is checked, check "All Status"
      const specificChecked = Array.from(statusCheckboxes).some(cb => 
        cb.value !== 'all' && cb.checked
      );
      if (!specificChecked) {
        allStatusCheckbox.checked = true;
      }
    }
    
    updateStatusDisplay();
    filterRequests();
  });
});

function updateStatusDisplay() {
  const checkedBoxes = Array.from(statusCheckboxes).filter(cb => cb.checked);
  
  if (allStatusCheckbox.checked || checkedBoxes.length === 0) {
    statusDisplay.textContent = 'All Status';
  } else if (checkedBoxes.length === 1) {
    statusDisplay.textContent = checkedBoxes[0].value.charAt(0).toUpperCase() + 
                              checkedBoxes[0].value.slice(1);
  } else {
    statusDisplay.textContent = `${checkedBoxes.length} Selected`;
  }
}

// Get selected status values for filtering
function getSelectedStatuses() {
  const checkedBoxes = Array.from(statusCheckboxes).filter(cb => 
    cb.checked && cb.value !== 'all'
  );
  
  if (allStatusCheckbox.checked || checkedBoxes.length === 0) {
    return [];
  }
  
  return checkedBoxes.map(cb => cb.value.toLowerCase());
}

    // ADD ALL THESE FUNCTIONS HERE
    function openChat(requestId) {
      currentConversationId = requestId;
      loadConversation(requestId);
      conversationModal.style.display = 'flex';
    }

    async function loadConversation(requestId) {
      try {
        const response = await fetch(`/api/conversation/${requestId}`);
        const conversation = await response.json();
        
        messagesContainer.innerHTML = '';
        
        if (conversation.messages && conversation.messages.length > 0) {
          conversation.messages.forEach(message => {
            addMessageToUI(message);
          });
          
          await fetch(`/api/conversation/${requestId}/mark-read`, {
            method: 'POST'
          });
        } else {
          messagesContainer.innerHTML = '<p style="text-align: center; color: #6b7280;">No messages yet. Start the conversation!</p>';
        }
        
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      } catch (error) {
        console.error('Error loading conversation:', error);
        messagesContainer.innerHTML = '<p style="color: red;">Error loading conversation</p>';
      }
    }

    function addMessageToUI(message) {
      const messageDiv = document.createElement('div');
      const isUser = message.senderRole === 'user';
      const senderName = message.senderId ? `${message.senderId.fName} ${message.senderId.lName}` : 'Unknown';
      
      messageDiv.className = `message ${isUser ? 'user-message' : 'admin-message'}`;
      messageDiv.innerHTML = `
        <div class="message-content">
          <div class="message-header">
            <strong>${senderName}</strong>
            <span class="message-time">${new Date(message.timestamp).toLocaleString()}</span>
          </div>
          <div class="message-text">${message.content}</div>
        </div>
      `;
      
      messagesContainer.appendChild(messageDiv);
    }

    sendMessageBtn.onclick = async function() {
      const content = messageInput.value.trim();
      if (!content || !currentConversationId) return;

      try {
        const response = await fetch(`/api/conversation/${currentConversationId}/message`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ content })
        });

        const result = await response.json();
        
        if (result.success) {
          addMessageToUI(result.message);
          messageInput.value = '';
          messagesContainer.scrollTop = messagesContainer.scrollHeight;
        } else {
          alert('Failed to send message');
        }
      } catch (error) {
        console.error('Error sending message:', error);
        alert('Failed to send message');
      }
    };

    messageInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        sendMessageBtn.click();
      }
    });

    
// Enhanced file preview function (replace existing file preview code)
function createEnhancedFilePreview(allFiles, previewContainer) {
  if (!previewContainer) return;
  
  if (allFiles.length > 0) {
    const enhancedPreview = document.createElement('div');
    enhancedPreview.className = 'enhanced-file-preview';
    
    const header = document.createElement('h3');
    header.textContent = `Attached Files (${allFiles.length})`;
    enhancedPreview.appendChild(header);
    
    const fileGrid = document.createElement('div');
    fileGrid.className = 'file-grid';
    
    allFiles.forEach((currentFile, index) => {
      if (currentFile && currentFile.trim()) {
        const fileUrl = `/uploads/${currentFile.trim()}`;
        const ext = currentFile.split('.').pop().toLowerCase();
        
        const fileItem = document.createElement('div');
        fileItem.className = 'enhanced-file-item';
        
        // File header
        const fileHeader = document.createElement('div');
        fileHeader.className = 'file-header-enhanced';
        
        // File icon SVG
        const fileIcon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        fileIcon.setAttribute('class', 'file-icon-enhanced');
        fileIcon.setAttribute('viewBox', '0 0 24 24');
        fileIcon.setAttribute('fill', 'none');
        fileIcon.setAttribute('stroke', 'currentColor');
        fileIcon.setAttribute('stroke-width', '2');
        fileIcon.innerHTML = `
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14,2 14,8 20,8"></polyline>
        `;
        
        const fileInfo = document.createElement('div');
        fileInfo.className = 'file-info-enhanced';
        
        const fileName = document.createElement('div');
        fileName.className = 'file-name-enhanced';
        fileName.textContent = currentFile;
        
        const fileType = document.createElement('div');
        fileType.className = 'file-type-enhanced';
        fileType.textContent = ext.toUpperCase() + ' File';
        
        fileInfo.appendChild(fileName);
        fileInfo.appendChild(fileType);
        fileHeader.appendChild(fileIcon);
        fileHeader.appendChild(fileInfo);
        fileItem.appendChild(fileHeader);
        
        // File preview container
        const previewDiv = document.createElement('div');
        previewDiv.className = 'file-preview-container';
        
        // File content based on type
        if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext)) {
          previewDiv.innerHTML = `
            <img src="${fileUrl}" alt="Uploaded Image" 
                 style="width:100%; max-height:250px; object-fit: cover; display: block;" 
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <div style="display:none; padding: 2rem; text-align: center; color: #ef4444;">
              <p style="margin: 0; font-weight: 600;">Image could not be loaded</p>
              <p style="margin: 0.5rem 0 0 0; font-size: 0.875rem;">File: ${currentFile}</p>
            </div>
          `;
        } else if (ext === 'pdf') {
          previewDiv.innerHTML = `
            <embed src="${fileUrl}" width="100%" height="300px" style="display: block;" 
                   onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
            <div style="display:none; padding: 2rem; text-align: center; color: #64748b;">
              <p style="margin: 0; font-weight: 600;">PDF Preview not available</p>
              <p style="margin: 0.5rem 0 0 0; font-size: 0.875rem;">Use the download button to view this file</p>
            </div>
          `;
        } else {
          previewDiv.innerHTML = `
            <div style="text-align: center; padding: 2rem; color: #64748b;">
              <div style="font-size: 3rem; margin-bottom: 1rem; color: #94a3b8;">📄</div>
              <p style="font-weight: 600; margin: 0;">Document File</p>
              <p style="font-size: 0.875rem; margin: 0.5rem 0 0 0;">Use the download button to view this file</p>
            </div>
          `;
        }
        
        fileItem.appendChild(previewDiv);
        
        // Download link
        const downloadLink = document.createElement('a');
        downloadLink.href = fileUrl;
        downloadLink.target = '_blank';
        downloadLink.download = currentFile;
        downloadLink.className = 'download-btn-enhanced';
        downloadLink.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7,10 12,15 17,10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Download File
        `;
        fileItem.appendChild(downloadLink);
        
        fileGrid.appendChild(fileItem);
      }
    });
    
    enhancedPreview.appendChild(fileGrid);
    previewContainer.appendChild(enhancedPreview);
  } else {
    previewContainer.innerHTML = `
      <div class="enhanced-file-preview">
        <h3>Files</h3>
        <div class="no-files-message">
          <svg class="no-files-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <div class="no-files-title">No files uploaded</div>
          <div class="no-files-subtitle">This request does not contain any file attachments</div>
        </div>
      </div>
    `;
  }
} </script>
