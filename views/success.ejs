<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Registration Successful</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-image: url('/Picture/Background.png');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }

    body::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: linear-gradient(135deg, rgba(64, 139, 78, 0.1), rgba(39, 87, 48, 0.25));
      backdrop-filter: blur(2px);
    }

    .message-box {
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(18px);
      padding: 40px 30px;
      border-radius: 20px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
      text-align: center;
      width: 100%;
      max-width: 440px;
      z-index: 1;
      position: relative;
    }

    .message-box h1 {
      font-size: 28px;
      font-weight: 600;
      color: #275730;
      background: linear-gradient(135deg, #275730, #408b4e);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 12px;
    }

    .message-box p {
      font-size: 16px;
      color: #4b5563;
      margin-bottom: 30px;
    }

    .message-box a {
      display: inline-block;
      text-decoration: none;
      padding: 14px 28px;
      background: linear-gradient(135deg, #408b4e, #275730);
      color: white;
      border-radius: 14px;
      font-weight: 600;
      font-size: 16px;
      box-shadow: 0 6px 16px rgba(64, 139, 78, 0.25);
      transition: all 0.3s ease;
    }

    .message-box a:hover {
      background: linear-gradient(135deg, #2f6e3b, #1e4a23);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(64, 139, 78, 0.35);
    }

    @media (max-width: 500px) {
      .message-box {
        padding: 30px 20px;
        border-radius: 16px;
      }

      .message-box h1 {
        font-size: 24px;
      }

      .message-box p {
        font-size: 15px;
      }

      .message-box a {
        font-size: 15px;
        padding: 12px 24px;
      }
    }
  </style>
</head>
<body>
  <div class="message-box">
    <h1><%= message %></h1>
    <p>You have successfully registered!</p>
    <a href="/">Back to Login</a>
  </div>
</body>
</html>