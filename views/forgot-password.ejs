<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password - S-CORE</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-image: url('/Picture/Background.png');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      padding: 20px;
    }

    body::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, rgba(64, 139, 78, 0.1), rgba(39, 87, 48, 0.2));
      backdrop-filter: blur(2px);
    }

    .container {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      padding: 40px 40px 30px 40px;
      border-radius: 24px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
      width: 100%;
      max-width: 520px;
      text-align: center;
      position: relative;
      z-index: 1;
    }

    .back-button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #408b4e;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      padding: 8px 12px;
      border-radius: 8px;
      transition: all 0.3s ease;
      background: rgba(64, 139, 78, 0.1);
      margin-bottom: 20px;
    }

    .back-button:hover {
      background: rgba(64, 139, 78, 0.2);
    }

    h1 {
      color: #408b4e;
      font-size: 28px;
      margin-bottom: 10px;
    }

    .subtitle {
      color: #6b7280;
      font-size: 15px;
      margin-bottom: 30px;
    }

    .option-buttons {
      display: flex;
      gap: 12px;
      margin-bottom: 25px;
    }

    .option-btn {
      flex: 1;
      padding: 12px;
      border: 2px solid #e0e0e0;
      background: white;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      color: #6b7280;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .option-btn:hover {
      border-color: #408b4e;
      color: #408b4e;
    }

    .option-btn.active {
      background: linear-gradient(135deg, #408b4e, #275730);
      color: white;
      border-color: #408b4e;
    }

    .input-group {
      width: 100%;
      margin-bottom: 20px;
    }

    .input-group input {
      width: 100%;
      padding: 14px;
      border: 2px solid #e0e0e0;
      border-radius: 10px;
      font-size: 15px;
      transition: all 0.3s ease;
    }

    .input-group input:focus {
      outline: none;
      border-color: #408b4e;
      box-shadow: 0 0 0 3px rgba(64, 139, 78, 0.1);
    }

    .button {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, #408b4e, #275730);
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-top: 10px;
    }

    .button:hover {
      background: linear-gradient(135deg, #2f6e3b, #1e4a23);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(64, 139, 78, 0.4);
    }

    .message {
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 20px;
      font-size: 14px;
      font-weight: 500;
    }

    .success {
      background: #e8f5e9;
      border: 2px solid #408b4e;
      color: #275730;
    }

    .error {
      background: #fee;
      border: 2px solid #c33;
      color: #c33;
    }

    .link {
      color: #408b4e;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
    }

    .link:hover {
      color: #275730;
    }

    .input-hidden {
      display: none;
    }
  </style>
</head>
<body>
  <div class="container">
    <a href="/login" class="back-button">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Back to Login
    </a>

    <h1>Forgot Password?</h1>
    <p class="subtitle">Choose your preferred method to reset your password</p>

    <% if (microsoftUser) { %>
      <div class="message" style="background: #e8f5e9; border: 2px solid #408b4e; color: #275730; text-align: left;">
        <strong style="font-size: 16px;">Microsoft Account Detected</strong>
        <p style="margin: 10px 0 0 0; font-weight: 400; font-size: 14px;">
          This account is linked to your Microsoft credentials. You have two options:
        </p>
        <div style="margin-top: 15px; display: flex; flex-direction: column; gap: 10px;">
          <button type="button" onclick="resetScorePassword()" style="width: 100%; padding: 12px 20px; background: linear-gradient(135deg, #408b4e, #275730); color: white; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; font-size: 15px; transition: all 0.3s ease;">
            Reset S-CORE Password
          </button>
          <a href="/clerk/sign-in" style="display: block; text-align: center; padding: 12px 20px; background: white; color: #408b4e; text-decoration: none; border-radius: 10px; font-weight: 600; border: 2px solid #408b4e; font-size: 15px; transition: all 0.3s ease;">
            Continue with Microsoft
          </a>
        </div>
      </div>
      <div id="resetForm" style="display: none;">
        <p style="color: #666; font-size: 14px; margin-bottom: 20px;">
          Note: This will reset your S-CORE system password, not your Microsoft password.
        </p>
        <form action="/forgot-password" method="POST">
          <input type="hidden" name="method" value="<%= method %>" />
          <input type="hidden" name="identifier" value="<%= identifier %>" />
          <input type="hidden" name="confirmReset" value="true" />
          <button type="submit" class="button">Confirm Reset S-CORE Password</button>
        </form>
        <button onclick="cancelReset()" style="width: 100%; padding: 12px; background: white; color: #666; border: 2px solid #e0e0e0; border-radius: 10px; font-size: 15px; font-weight: 600; cursor: pointer; margin-top: 10px;">
          Cancel
        </button>
      </div>
    <% } else { %>
      <% if (success) { %>
        <div class="message success"><%= success %></div>
      <% } %>

      <% if (error) { %>
        <div class="message error"><%= error %></div>
      <% } %>

      <% if (!showResetLink) { %>
      <div class="option-buttons">
        <button type="button" class="option-btn active" onclick="selectOption('email')">Use Email</button>
        <button type="button" class="option-btn" onclick="selectOption('username')">Use Username</button>
      </div>

      <form action="/forgot-password" method="POST">
        <input type="hidden" name="method" id="method" value="email" />
        
        <div class="input-group" id="emailInput">
          <input type="email" name="identifier" placeholder="Enter your @dlsud.edu.ph email" required />
        </div>

        <div class="input-group input-hidden" id="usernameInput">
          <input type="text" name="identifier" placeholder="Enter your username" disabled />
        </div>

        <button type="submit" class="button">Send Reset Link</button>
      </form>
      <% } %>
    <% } %>

    <p style="margin-top: 20px; color: #666; font-size: 14px;">
      Remember your password? <a href="/login" class="link">Sign in</a>
    </p>
  </div>

  <script>
    function selectOption(type) {
      const emailBtn = document.querySelector('.option-btn:first-child');
      const usernameBtn = document.querySelector('.option-btn:last-child');
      const emailInput = document.getElementById('emailInput');
      const usernameInput = document.getElementById('usernameInput');
      const methodInput = document.getElementById('method');

      if (type === 'email') {
        emailBtn.classList.add('active');
        usernameBtn.classList.remove('active');
        emailInput.classList.remove('input-hidden');
        usernameInput.classList.add('input-hidden');
        emailInput.querySelector('input').disabled = false;
        emailInput.querySelector('input').required = true;
        usernameInput.querySelector('input').disabled = true;
        usernameInput.querySelector('input').required = false;
        methodInput.value = 'email';
      } else {
        usernameBtn.classList.add('active');
        emailBtn.classList.remove('active');
        usernameInput.classList.remove('input-hidden');
        emailInput.classList.add('input-hidden');
        usernameInput.querySelector('input').disabled = false;
        usernameInput.querySelector('input').required = true;
        emailInput.querySelector('input').disabled = true;
        emailInput.querySelector('input').required = false;
        methodInput.value = 'username';
      }
    }

    function resetScorePassword() {
      document.querySelector('.message').style.display = 'none';
      document.getElementById('resetForm').style.display = 'block';
    }

    function cancelReset() {
      document.querySelector('.message').style.display = 'block';
      document.getElementById('resetForm').style.display = 'none';
    }
  </script>
</body>
</html>
