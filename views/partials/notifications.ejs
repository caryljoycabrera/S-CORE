<!-- ===== Notification Bell Partial ===== -->
<!-- Include this partial in admin and user layouts for notification functionality -->

<!-- Notification CSS -->
<link rel="stylesheet" href="/stylesheets/notifications.css">

<!-- Socket.IO Client -->
<script src="/socket.io/socket.io.js"></script>

<!-- User Data for JavaScript -->
<script id="user-data" type="application/json"><%- JSON.stringify({ id: user._id, role: user.role, name: user.fName + ' ' + user.lName }) %></script>

<!-- Notification Container (will be created by JavaScript if not present) -->
<div class="notification-container">
  <button class="notification-bell" id="notification-bell" aria-label="Notifications">
    <svg class="notification-bell-icon" viewBox="0 0 24 24">
      <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
      <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
    </svg>
    <span class="notification-badge" id="notification-badge">0</span>
  </button>
  
  <div class="notification-dropdown" id="notification-dropdown">
    <div class="notification-header">
      <h3 class="notification-title">Notifications</h3>
      <div class="notification-actions">
        <button class="mark-all-read-btn" id="mark-all-read-btn" title="Mark all as read">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9,11 12,14 22,4"></polyline>
            <path d="M21,12c0,4.97-4.03,9-9,9s-9-4.03-9-9c1.84,0,3.55,0.56,4.96,1.51"></path>
          </svg>
          Mark all read
        </button>
        <button class="close-dropdown-btn" id="close-dropdown-btn" title="Close">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
    
    <div class="notification-list" id="notification-list">
      <div class="notification-loading">Loading notifications...</div>
    </div>
    
    <div class="notification-footer" id="notification-footer">
      <a href="/notifications" class="view-all-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        View all notifications
      </a>
    </div>
  </div>
</div>

<!-- Notification JavaScript -->
<script src="/javascripts/notifications.js"></script>