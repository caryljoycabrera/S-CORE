<!-- ===== Notification Bell Partial ===== -->
<!-- Include this partial in admin and user layouts for notification functionality -->

<!-- Notification CSS -->
<link rel="stylesheet" href="/stylesheets/notifications.css">

<!-- Socket.IO Client -->
<script src="/socket.io/socket.io.js"></script>

<!-- User Data for JavaScript -->
<script id="user-data" type="application/json"><%- JSON.stringify({ id: user._id, role: user.role, name: user.fName + ' ' + user.lName }) %></script>

<!-- Notification Container (will be created by JavaScript if not present) -->
<div class="notification-container">
  <button class="notification-bell" id="notification-bell" aria-label="Notifications">
    <svg class="notification-bell-icon" viewBox="0 0 24 24">
      <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
      <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
    </svg>
    <span class="notification-badge empty" id="notification-badge">0</span>
  </button>
  
  <div class="notification-dropdown" id="notification-dropdown">
    <div class="notification-header">
      <h3 class="notification-title">Notifications</h3>
      <div class="notification-actions">
        <button class="mark-all-read-btn" id="mark-all-read-btn" title="Mark all as read">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9,11 12,14 22,4"></polyline>
            <path d="M21,12c0,4.97-4.03,9-9,9s-9-4.03-9-9c1.84,0,3.55,0.56,4.96,1.51"></path>
          </svg>
          Mark all read
        </button>
        <button class="close-dropdown-btn" id="close-dropdown-btn" title="Close">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
    
    <div class="notification-list" id="notification-list">
      <div class="notification-loading">Loading notifications...</div>
    </div>
    
    <div class="notification-footer" id="notification-footer">
      <a href="/notifications" class="view-all-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        View all notifications
      </a>
    </div>
  </div>
</div>

<script>
// Ensure announcement detail modal exists in DOM (create if not present)
(function() {
  if (document.getElementById('announcementDetailModal')) return;
  var modalHtml = '<div id="announcementDetailModal" class="modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:1000;justify-content:center;align-items:center;">' +
    '<div class="modal-content" style="background:white;border-radius:12px;max-width:600px;width:90%;max-height:80vh;overflow-y:auto;box-shadow:0 20px 40px rgba(0,0,0,0.2);">' +
    '<div class="modal-header" style="padding:1.5rem;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:flex-start;">' +
    '<div style="flex:1;"><h2 id="announcementModalTitle" class="modal-title" style="margin:0;font-size:1.5rem;font-weight:600;color:#1f2937;"></h2>' +
    '<span id="announcementModalDate" style="color:#6b7280;font-size:0.875rem;margin-top:0.25rem;display:block;"></span></div>' +
    '<button onclick="closeAnnouncementModal()" style="background:none;border:none;font-size:1.5rem;cursor:pointer;color:#6b7280;padding:0;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:50%;">&times;</button>' +
    '</div>' +
    '<div class="modal-body" style="padding:1.5rem;">' +
    '<div id="announcementModalContent" style="line-height:1.6;color:#1f2937;"></div>' +
    '<div id="announcementModalMeta" style="margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid #e5e7eb;">' +
    '<p style="margin:0.5rem 0;color:#6b7280;"><strong>From:</strong> <span id="announcementModalFrom"></span></p>' +
    '<p style="margin:0.5rem 0;color:#6b7280;"><strong>Priority:</strong> <span id="announcementModalPriority"></span></p>' +
    '</div></div>' +
    '<div class="modal-actions" style="padding:1.5rem;border-top:1px solid #e5e7eb;display:flex;gap:0.75rem;justify-content:flex-end;">' +
    '<button onclick="closeAnnouncementModal()" style="padding:0.75rem 1.5rem;border-radius:8px;font-size:0.875rem;font-weight:600;cursor:pointer;border:2px solid #e5e7eb;background:#f3f4f6;color:#374151;">Close</button>' +
    '</div></div></div>';
  var div = document.createElement('div');
  div.innerHTML = modalHtml;
  document.body.appendChild(div.firstElementChild);
})();

async function openAnnouncementDetail(announcementId) {
  try {
    var response = await fetch('/api/announcements/' + announcementId);
    var result = await response.json();

    if (!response.ok || !result.success) {
      console.error('Failed to fetch announcement:', result.message);
      return;
    }

    var announcement = result.announcement;

    document.getElementById('announcementModalTitle').textContent = announcement.title;
    document.getElementById('announcementModalDate').textContent = new Date(announcement.createdAt).toLocaleDateString('en-US', {
      month: 'long', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit'
    });

    document.getElementById('announcementModalContent').innerHTML = announcement.content;

    document.getElementById('announcementModalFrom').textContent = announcement.sentBy
      ? announcement.sentBy.fName + ' ' + announcement.sentBy.lName
      : 'Admin';

    var priorityText = announcement.priority === 'high' ? 'Urgent' :
                       announcement.priority === 'medium' ? 'Important' : 'Low';
    document.getElementById('announcementModalPriority').textContent = priorityText;

    document.getElementById('announcementDetailModal').style.display = 'flex';

    if (!announcement.isRead) {
      await fetch('/api/announcements/' + announcementId + '/read', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
    }
  } catch (error) {
    console.error('Error opening announcement:', error);
  }
}

function closeAnnouncementModal() {
  var modal = document.getElementById('announcementDetailModal');
  if (modal) modal.style.display = 'none';
}

(function() {
  var modal = document.getElementById('announcementDetailModal');
  if (modal) {
    modal.addEventListener('click', function(e) {
      if (e.target === this) closeAnnouncementModal();
    });
  }
})();

window.openAnnouncementDetail = openAnnouncementDetail;
</script>

<!-- Notification JavaScript -->
<script src="/javascripts/notifications.js"></script>