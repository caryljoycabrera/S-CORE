<!-- =============================================================================
     UNIT SIDEBAR PARTIAL - REUSABLE NAVIGATION FOR UNIT PAGES
     =============================================================================
     Usage: include('../partials/unit-navbar', { user: user, activePage: 'dashboard' })
     Parameters: user (object), activePage (string: 'dashboard', 'all-tasks', etc.)
     ============================================================================= -->

<!-- Sidebar Backdrop for Mobile -->
<div class="unit-sidebar-backdrop" id="unitSidebarBackdrop"></div>

<!-- Unit Sidebar Navigation -->
<nav class="unit-sidebar" id="unitSidebar">
  <!-- Profile Section at Top -->
  <div class="unit-sidebar-profile">
    <a href="/unit/profile" class="unit-sidebar-profile-link" title="Go to Profile">
      <div class="unit-sidebar-profile-icon-container">
        <!-- SVG Icon (shows when collapsed) -->
        <svg class="unit-sidebar-profile-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <!-- Profile Avatar (shows when expanded) -->
        <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" 
             alt="<%= user.fName %> <%= user.lName %>" 
             class="unit-sidebar-profile-avatar" />
      </div>
      <div class="unit-sidebar-profile-info">
        <p class="unit-sidebar-profile-name"><%= user.fName %> <%= user.lName %></p>
        <p class="unit-sidebar-profile-role"><%= user.unitTeam || 'Unit Member' %></p>
      </div>
      <span class="unit-sidebar-profile-arrow">→</span>
    </a>
  </div>

  <!-- Navigation Items -->
  <div class="unit-sidebar-items">
    <a href="/unit/dashboard" class="unit-sidebar-item <%= activePage === 'dashboard' ? 'active' : '' %>" title="Dashboard">
      <svg class="unit-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
      </svg>
      <span class="unit-sidebar-label">Dashboard</span>
    </a>
    
    <a href="/unit/all-tasks" class="unit-sidebar-item <%= activePage === 'all-tasks' ? 'active' : '' %>" title="All Tasks">
      <svg class="unit-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="18" y1="20" x2="18" y2="10"></line>
        <line x1="12" y1="20" x2="12" y2="4"></line>
        <line x1="6" y1="20" x2="6" y2="14"></line>
      </svg>
      <span class="unit-sidebar-label">All Tasks</span>
    </a>
    
    <a href="/unit/task-approvals" class="unit-sidebar-item <%= activePage === 'task-approvals' ? 'active' : '' %>" title="Approval Tasks">
      <svg class="unit-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
      <span class="unit-sidebar-label">Approval Tasks</span>
    </a>
    
    <a href="/unit/task-services" class="unit-sidebar-item <%= activePage === 'task-services' ? 'active' : '' %>" title="Service Tasks">
      <svg class="unit-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"></path>
      </svg>
      <span class="unit-sidebar-label">Service Tasks</span>
    </a>
    
    <a href="/unit/reports" class="unit-sidebar-item <%= activePage === 'reports' ? 'active' : '' %>" title="Reports">
      <svg class="unit-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <line x1="12" y1="9" x2="8" y2="9"></line>
      </svg>
      <span class="unit-sidebar-label">Reports</span>
    </a>
    
    <a href="/unit/guide" class="unit-sidebar-item <%= activePage === 'guide' ? 'active' : '' %>" title="Help & Guide">
      <svg class="unit-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
      <span class="unit-sidebar-label">Help & Guide</span>
    </a>
  </div>
  
  <!-- Logout Button at Bottom -->
  <div class="unit-sidebar-bottom">
    <a href="/logout" class="unit-sidebar-item unit-sidebar-logout" title="Logout">
      <svg class="unit-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
      </svg>
      <span class="unit-sidebar-label">Logout</span>
    </a>
  </div>
</nav>
