<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= success ? 'Email Verified' : 'Verification Failed' %> - S-CORE</title>
  <link rel="icon" type="image/x-icon" href="/Picture/favicon.ico">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #007b3a 0%, #005a2b 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .verification-card {
      background: white;
      border-radius: 15px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      padding: 50px 40px;
      max-width: 500px;
      text-align: center;
    }
    .icon-wrapper {
      width: 100px;
      height: 100px;
      margin: 0 auto 30px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 50px;
    }
    .icon-wrapper.success {
      background: #d4edda;
      color: #28a745;
    }
    .icon-wrapper.error {
      background: #f8d7da;
      color: #dc3545;
    }
    .verification-card h1 {
      color: #333;
      margin-bottom: 20px;
      font-size: 28px;
      font-weight: 600;
    }
    .verification-card p {
      color: #666;
      font-size: 16px;
      line-height: 1.6;
      margin-bottom: 30px;
    }
    .btn-primary {
      background: #007b3a;
      border: none;
      padding: 12px 40px;
      font-size: 16px;
      font-weight: 600;
      border-radius: 6px;
      transition: background 0.3s ease;
    }
    .btn-primary:hover {
      background: #005a2b;
    }
    .btn-secondary {
      background: #6c757d;
      border: none;
      padding: 12px 40px;
      font-size: 16px;
      font-weight: 600;
      border-radius: 6px;
      margin-top: 15px;
      transition: background 0.3s ease;
    }
    .btn-secondary:hover {
      background: #5a6268;
    }
    .redirect-info {
      margin-top: 20px;
      font-size: 14px;
      color: #999;
    }
    .logo {
      font-size: 32px;
      font-weight: bold;
      color: #007b3a;
      margin-bottom: 30px;
    }
  </style>
</head>
<body>
  <div class="verification-card">
    <div class="logo">S-CORE</div>
    
    <% if (success) { %>
      <div class="icon-wrapper success">
        ✓
      </div>
      <h1>Email Verified!</h1>
      <p><%= message %></p>
      <% if (userName) { %>
        <p><strong>Welcome, <%= userName %>!</strong></p>
      <% } %>
      <a href="/" class="btn btn-primary">Go to Login</a>
      <div class="redirect-info">
        You will be redirected to the login page in <span id="countdown">5</span> seconds...
      </div>
    <% } else { %>
      <div class="icon-wrapper error">
        ✕
      </div>
      <h1>Verification Failed</h1>
      <p><%= message %></p>
      
      <% if (showResendButton) { %>
        <div id="resendSection">
          <p>Enter your email to receive a new verification link:</p>
          <form id="resendForm" class="mt-3">
            <div class="mb-3">
              <input type="email" class="form-control" id="emailInput" placeholder="your.email@dlsud.edu.ph" required>
            </div>
            <button type="submit" class="btn btn-primary">Resend Verification Email</button>
          </form>
          <div id="resendMessage" class="mt-3" style="display: none;"></div>
        </div>
      <% } %>
      
      <a href="/register" class="btn btn-secondary">Back to Registration</a>
    <% } %>
  </div>

  <script>
    <% if (success) { %>
      // Auto-redirect countdown
      let seconds = 5;
      const countdownEl = document.getElementById('countdown');
      
      const countdown = setInterval(() => {
        seconds--;
        countdownEl.textContent = seconds;
        
        if (seconds <= 0) {
          clearInterval(countdown);
          window.location.href = '/';
        }
      }, 1000);
    <% } %>

    <% if (!success && showResendButton) { %>
      // Handle resend verification email
      document.getElementById('resendForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const email = document.getElementById('emailInput').value;
        const messageEl = document.getElementById('resendMessage');
        const submitBtn = e.target.querySelector('button[type="submit"]');
        
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
        
        try {
          const response = await fetch('/auth/resend-verification', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ email })
          });
          
          const data = await response.json();
          
          messageEl.style.display = 'block';
          
          if (response.ok) {
            messageEl.className = 'alert alert-success mt-3';
            messageEl.textContent = data.message || 'Verification email sent! Please check your inbox.';
            document.getElementById('resendForm').style.display = 'none';
          } else {
            messageEl.className = 'alert alert-danger mt-3';
            messageEl.textContent = data.error || 'Failed to send verification email. Please try again.';
            submitBtn.disabled = false;
            submitBtn.textContent = 'Resend Verification Email';
          }
        } catch (error) {
          messageEl.style.display = 'block';
          messageEl.className = 'alert alert-danger mt-3';
          messageEl.textContent = 'An error occurred. Please try again.';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Resend Verification Email';
        }
      });
    <% } %>
  </script>
</body>
</html>
