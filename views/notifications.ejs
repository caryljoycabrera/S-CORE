<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notifications - S-CORE</title>
  <link rel="icon" type="image/x-icon" href="/Picture/favicon.ico?v=2">
  <link rel="shortcut icon" href="/Picture/favicon.ico?v=2">
  <meta name="theme-color" content="#1a5d1a">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/stylesheets/notifications.css">
  <link rel="stylesheet" href="/stylesheets/notifications-page.css">
  <link rel="stylesheet" href="/stylesheets/user-navbar.css">
  <link rel="stylesheet" href="/stylesheets/modal-centered.css" />
  <link rel="stylesheet" href="/stylesheets/no-animations.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="/javascripts/alert-handler.js"></script>
  <style>
    /* User-specific page container styles */
    .student-side {
      padding-top: 30px;
      padding-left: 2rem;
      padding-right: 2rem;
      padding-bottom: 3rem;
      background: #f3f4f6;
      min-height: 100vh;
      box-sizing: border-box;
    }

    /* Mobile Responsiveness for User Layout */
    @media (max-width: 768px) {
      .student-side {
        padding: 1rem;
        padding-top: 20px;
      }
    }
    
    @media (max-width: 480px) {
      .student-side {
        padding: 0.75rem;
        padding-top: 15px;
      }
    }

    /* ── Bulk Delete UI ─────────────────────────────────────────── */
    .notifications-actions .btn.danger { color: #dc2626; }
    .notifications-actions .btn.danger:hover { background: #fef2f2; border-color: #dc2626; }
    .notifications-actions .btn.danger.active { background: #fef2f2; border-color: #dc2626; color: #dc2626; font-weight: 600; }
    .nt-action-checkbox { display: none; width: 18px; height: 18px; cursor: pointer; accent-color: #dc2626; border-radius: 4px; margin: 0; align-self: center; }
    .nt-delete-mode .nt-action-checkbox { display: inline-flex !important; }
    .nt-delete-mode .notification-page-action-btn.delete { display: none !important; }
    .nt-delete-mode .notification-page-item-actions { opacity: 1 !important; }
    .nt-delete-mode .notification-page-item { cursor: default; }
    .notification-page-item.nt-selected { background: #fef2f2 !important; border-left: 4px solid #dc2626 !important; }

    /* ── Bottom Action Bar ───────────────────────────────────────── */
    .nt-action-bar { display: none; justify-content: flex-end; align-items: center; gap: 12px; padding: 14px 24px; background: #f9fafb; border-top: 1px solid #e5e7eb; }
    .nt-delete-mode .nt-action-bar { display: flex !important; }
    .nt-action-bar .nt-count { font-size: 13px; font-weight: 600; color: #6b7280; }
    .nt-action-bar .nt-btn {
      padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 13px;
      border: none; cursor: pointer; font-family: 'Inter', sans-serif; transition: all .2s;
      display: inline-flex; align-items: center; gap: 6px;
    }
    .nt-action-bar .nt-btn-danger { background: #ef4444; color: white; }
    .nt-action-bar .nt-btn-danger:hover { background: #dc2626; }
    .nt-action-bar .nt-btn-danger:disabled { opacity: 0.5; cursor: not-allowed; }
    .nt-action-bar .nt-btn-outline { background: #fff; color: #374151; border: 1px solid #d1d5db; }
    .nt-action-bar .nt-btn-outline:hover { background: #f3f4f6; }

    /* ── Modal Backdrop ──────────────────────────────────────────── */
    .nt-modal-backdrop {
      display: none; position: fixed; top: 0 !important; left: 0 !important;
      width: 100vw !important; height: 100vh !important; z-index: 999999 !important;
      background: rgba(0,0,0,0.65); backdrop-filter: blur(5px);
      align-items: center; justify-content: center; padding: 20px;
    }
    .nt-modal-backdrop.show { display: flex; }
    .nt-modal {
      background: white; border-radius: 12px; width: 100%; max-width: 480px;
      box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
      overflow: hidden; transform: translateY(20px); transition: transform 0.3s ease;
    }
    .nt-modal-backdrop.show .nt-modal { transform: translateY(0); }
    .nt-modal-header {
      padding: 20px 24px; border-bottom: 1px solid #f3f4f6;
      display: flex; align-items: center; justify-content: space-between;
    }
    .nt-modal-title { font-weight: 700; color: #1f2937; font-size: 1.1rem; margin: 0; }
    .nt-modal-close {
      background: none; border: none; font-size: 24px; color: #9ca3af; cursor: pointer;
      line-height: 1; transition: color 0.15s;
    }
    .nt-modal-close:hover { color: #4b5563; }
    .nt-modal-body { padding: 24px; }
    .nt-modal-footer {
      padding: 16px 24px; background: #f9fafb; border-top: 1px solid #f3f4f6;
      display: flex; justify-content: flex-end; gap: 12px;
    }
    .nt-btn-secondary {
      padding: 10px 20px; border-radius: 8px; font-weight: 600; font-size: 0.9rem;
      font-family: 'Inter', sans-serif; cursor: pointer; transition: all 0.2s; border: none;
      background: #f3f4f6; color: #4b5563;
    }
    .nt-btn-secondary:hover { background: #e5e7eb; }
    .nt-btn-primary-danger {
      padding: 10px 20px; border-radius: 8px; font-weight: 600; font-size: 0.9rem;
      font-family: 'Inter', sans-serif; cursor: pointer; transition: all 0.2s; border: none;
      background: #ef4444; color: white;
    }
    .nt-btn-primary-danger:hover { background: #dc2626; }
    .nt-btn-primary-danger:disabled { opacity: 0.5; cursor: not-allowed; }

    /* ── Sidebar behind backdrop ─────────────────────────────────── */
    body.nt-modal-active {
      overflow: hidden !important;
    }
    body.nt-modal-active .user-sidebar,
    body.nt-modal-active #userSidebar,
    body.nt-modal-active .user-sidebar *,
    body.nt-modal-active #userSidebar *,
    body.nt-modal-active .overlap,
    body.nt-modal-active .overlap *,
    body:has(.nt-modal-backdrop.show) .user-sidebar,
    body:has(.nt-modal-backdrop.show) #userSidebar,
    body:has(.nt-modal-backdrop.show) .user-sidebar *,
    body:has(.nt-modal-backdrop.show) #userSidebar *,
    body:has(.nt-modal-backdrop.show) .overlap,
    body:has(.nt-modal-backdrop.show) .overlap * {
      z-index: 50 !important;
      pointer-events: none !important;
    }
    body.nt-modal-active .user-main-content,
    body:has(.nt-modal-backdrop.show) .user-main-content {
      z-index: 200 !important;
      position: relative;
    }
  </style>
</head>
<body>
  <!-- SIDEBAR NAVIGATION -->
  <div class="user-sidebar" id="userSidebar">
    <!-- Profile Section at Top -->
    <div class="sidebar-profile">
      <a href="/profile" class="sidebar-profile-link" title="Go to Profile">
        <div class="sidebar-profile-icon-container">
          <!-- SVG Icon (shows when collapsed) -->
          <svg class="sidebar-profile-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
