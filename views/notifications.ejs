<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notifications - S-CORE</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/stylesheets/notifications.css">
  <link rel="stylesheet" href="/stylesheets/user-navbar.css">
  <link rel="stylesheet" href="/stylesheets/modal-centered.css" />
  <link rel="stylesheet" href="/stylesheets/no-animations.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="/javascripts/alert-handler.js"></script>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #f3f4f6;
      font-family: 'Inter', sans-serif;
    }

    /* Use the standard user dashboard styles from style.css */
    .student-side {
      padding-top: 30px;
      padding-left: 2rem;
      padding-right: 2rem;
      padding-bottom: 3rem;
      background: #f3f4f6;
      min-height: 100vh;
      box-sizing: border-box;
    }

    .notifications-page {
      max-width: 1400px;
      margin: 0 auto;
    }
    
    .notifications-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid #e5e7eb;
    }
    
    .notifications-title {
      font-size: 2rem;
      font-weight: 700;
      color: #111827;
      margin: 0;
    }
    
    .notifications-actions {
      display: flex;
      gap: 1rem;
    }
    
    .btn {
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      border: 1px solid #d1d5db;
      background: white;
      color: #374151;
      text-decoration: none;
      font-weight: 500;
      transition: all 0.2s ease;
      cursor: pointer;
      font-size: 14px;
    }
    
    .btn:hover {
      background: #f9fafb;
      border-color: #9ca3af;
    }
    
    .btn-primary {
      background: #43a047;
      color: white;
      border-color: #43a047;
    }
    
    .btn-primary:hover {
      background: #2c5d31;
      border-color: #2c5d31;
    }
    
    .notifications-filters {
      display: flex;
      gap: 1rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }
    
    .filter-btn {
      padding: 0.5rem 1rem;
      border: 1px solid #d1d5db;
      background: white;
      color: #6b7280;
      border-radius: 2rem;
      cursor: pointer;
      transition: all 0.2s ease;
      font-size: 14px;
    }
    
    .filter-btn.active {
      background: #43a047;
      color: white;
      border-color: #43a047;
    }
    
    .notifications-list-page {
      background: white;
      border-radius: 1rem;
      box-shadow: 0 4px 16px rgba(0,0,0,0.08);
      overflow: hidden;
    }
    
    .notification-item-page {
      padding: 1.5rem;
      border-bottom: 1px solid #f3f4f6;
      transition: background-color 0.2s ease;
    }
    
    .notification-item-page:hover {
      background-color: #f9fafb;
    }
    
    .notification-item-page:last-child {
      border-bottom: none;
    }
    
    .notification-item-page.unread {
      background-color: #f0fdf4;
      border-left: 4px solid #43a047;
    }
    
    .notification-content-page {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }
    
    .notification-details {
      flex: 1;
    }
    
    .notification-title-page {
      font-weight: 600;
      color: #111827;
      margin: 0 0 0.5rem 0;
      font-size: 16px;
    }
    
    .notification-message-page {
      color: #6b7280;
      margin: 0 0 1rem 0;
      line-height: 1.5;
    }
    
    .notification-meta-page {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      color: #9ca3af;
    }
    
    .notification-actions-page {
      display: flex;
      gap: 0.5rem;
    }
    
    .pagination {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 2rem;
    }
    
    .pagination button {
      padding: 0.5rem 1rem;
      border: 1px solid #d1d5db;
      background: white;
      color: #374151;
      border-radius: 0.5rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .pagination button:hover:not(:disabled) {
      background: #f9fafb;
    }
    
    .pagination button.active {
      background: #43a047;
      color: white;
      border-color: #43a047;
    }
    
    .pagination button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    
    .loading {
      text-align: center;
      padding: 2rem;
      color: #6b7280;
    }
    
    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: #6b7280;
    }
    
    .empty-state h3 {
      margin: 0 0 1rem 0;
      font-size: 1.25rem;
      color: #374151;
    }
    
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: #43a047;
      text-decoration: none;
      margin-bottom: 1rem;
      font-weight: 500;
    }
    
    .back-link:hover {
      color: #2c5d31;
    }
    
    /* Mobile Responsiveness */
    @media (max-width: 768px) {
      .student-side {
        padding: 1rem;
        padding-top: 20px;
      }
      
      .notifications-page {
        max-width: 100%;
      }
      
      .notifications-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      
      .notifications-title {
        font-size: 1.5rem;
      }
      
      .notifications-actions {
        width: 100%;
        justify-content: stretch;
      }
      
      .notifications-actions .btn {
        flex: 1;
        text-align: center;
        justify-content: center;
        padding: 0.75rem 1rem;
        font-size: 13px;
      }
      
      .notifications-filters {
        gap: 0.5rem;
        margin-bottom: 1rem;
      }
      
      .filter-btn {
        padding: 0.5rem 0.75rem;
        font-size: 13px;
        white-space: nowrap;
      }
      
      .notification-item-page {
        padding: 1rem;
        flex-direction: column;
        gap: 0.75rem;
      }
      
      .notification-content-page {
        flex-direction: column;
        gap: 0.75rem;
      }
      
      .notification-details {
        width: 100%;
      }
      
      .notification-title-page {
        font-size: 15px;
      }
      
      .notification-message-page {
        font-size: 13px;
      }
      
      .notification-meta-page {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.25rem;
        font-size: 12px;
      }
      
      .notification-actions-page {
        width: 100%;
        flex-direction: column;
        gap: 0.5rem;
      }
      
      .notification-actions-page .btn {
        width: 100%;
        text-align: center;
        justify-content: center;
        padding: 0.75rem;
        font-size: 14px;
      }
      
      .pagination {
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 1.5rem;
      }
      
      .pagination button,
      .pagination span {
        width: 100%;
        text-align: center;
        justify-content: center;
      }
      
      .back-link {
        font-size: 14px;
        margin-bottom: 0.75rem;
      }
    }
    
    @media (max-width: 480px) {
      .student-side {
        padding: 0.75rem;
        padding-top: 15px;
      }
      
      .notifications-title {
        font-size: 1.25rem;
      }
      
      .notifications-filters {
        overflow-x: auto;
        flex-wrap: nowrap;
        padding-bottom: 0.5rem;
      }
      
      .filter-btn {
        flex-shrink: 0;
      }
      
      .notification-item-page {
        padding: 0.75rem;
      }
      
      .notification-title-page {
        font-size: 14px;
      }
      
      .notification-message-page {
        font-size: 12px;
      }
    }
  </style>
</head>
