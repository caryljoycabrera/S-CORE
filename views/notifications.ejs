<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notifications - S-CORE</title>
  <link rel="icon" type="image/x-icon" href="/Picture/favicon.ico?v=2">
  <link rel="shortcut icon" href="/Picture/favicon.ico?v=2">
  <meta name="theme-color" content="#1a5d1a">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/stylesheets/notifications.css">
  <link rel="stylesheet" href="/stylesheets/notifications-page.css">
  <link rel="stylesheet" href="/stylesheets/user-navbar.css">
  <link rel="stylesheet" href="/stylesheets/modal-centered.css" />
  <link rel="stylesheet" href="/stylesheets/no-animations.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="/javascripts/alert-handler.js"></script>
  <style>
    /* User-specific page container styles */
    .student-side {
      padding-top: 30px;
      padding-left: 2rem;
      padding-right: 2rem;
      padding-bottom: 3rem;
      background: #f3f4f6;
      min-height: 100vh;
      box-sizing: border-box;
    }

    /* Mobile Responsiveness for User Layout */
    @media (max-width: 768px) {
      .student-side {
        padding: 1rem;
        padding-top: 20px;
      }
    }
    
    @media (max-width: 480px) {
      .student-side {
        padding: 0.75rem;
        padding-top: 15px;
      }
    }
  </style>
</head>
<body>
  <!-- SIDEBAR NAVIGATION -->
  <div class="user-sidebar" id="userSidebar">
    <!-- Profile Section at Top -->
    <div class="sidebar-profile">
      <a href="/profile" class="sidebar-profile-link" title="Go to Profile">
        <div class="sidebar-profile-icon-container">
          <!-- SVG Icon (shows when collapsed) -->
          <svg class="sidebar-profile-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <!-- Profile Avatar (shows when expanded) -->
          <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user-placeholder.svg' %>" 
               alt="<%= user.fName %> <%= user.lName %>" 
               class="sidebar-profile-avatar" />
        </div>
        <div class="sidebar-profile-info">
          <p class="sidebar-profile-name"><%= user.fName %> <%= user.lName %></p>
          <p class="sidebar-profile-role"><%= user.userType || 'User' %></p>
        </div>
        <span class="sidebar-profile-arrow">→</span>
      </a>
    </div>

    <div class="sidebar-items">
      <a href="/dashboard" class="sidebar-item" title="Dashboard">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span class="sidebar-label">Dashboard</span>
      </a>
      
      <a href="/all-requests" class="sidebar-item" title="All Requests">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        <span class="sidebar-label">All Requests</span>
      </a>
      
      <a href="/request-approvals" class="sidebar-item" title="Request Approvals">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span class="sidebar-label">Request Approvals</span>
      </a>
      
      <a href="/service-requests" class="sidebar-item" title="Request Services">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"></path>
        </svg>
        <span class="sidebar-label">Request Services</span>
      </a>
      
      <a href="/user-guide" class="sidebar-item" title="Help & Guide">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        <span class="sidebar-label">Help & Guide</span>
      </a>
    </div>
    
    <!-- Logout Button at Bottom -->
    <div class="sidebar-bottom">
      <a href="/logout" class="sidebar-item sidebar-logout" title="Logout">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span class="sidebar-label">Logout</span>
      </a>
    </div>
  </div>

  <!-- Main Content -->
  <div class="user-main-content">
  <div class="student-side">
    <div class="div">
      <!-- Header matching user dashboard -->
      <div class="overlap">
        <!-- Left Group: Hamburger, Logo, Title -->
        <div class="header-left-group">
          <!-- Hamburger Menu Button for Mobile -->
          <button class="user-menu-toggle" id="userMenuToggle" title="Open Menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>

          <div class="group">
            <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
          </div>
          <a href="/dashboard" class="text-wrapper">S-CORE</a>
        </div>
        
        <span class="text-wrapper-2">Welcome, <%= user.fName %> <%= user.lName %>!</span>
        
        <div class="header-right-section">
          <!-- Notification Bell -->
          <%- include('partials/notifications') %>
          
          <div class="dropdown-wrapper">
            <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
              <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
              <div class="user">
                <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user-placeholder.svg' %>" alt="User Icon" />
              </div>
            </div>
            <div class="dropdown-menu" id="dropdownMenu">
              <a href="/profile">My Profile</a>
              <a href="/logout">Logout</a>
            </div>
          </div>
        </div>
      </div>

      <div class="notifications-page">
    <a href="<%= user.role === 'unit' ? '/unit/dashboard' : '/dashboard' %>" class="back-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15,18 9,12 15,6"></polyline>
      </svg>
      Back to Dashboard
    </a>
    
    <div class="notifications-header">
      <h1 class="notifications-title">Notifications</h1>
      <div class="notifications-actions">
        <button class="btn" id="mark-all-btn">
          Mark All as Read
        </button>
        <button class="btn" id="refresh-btn">
          Refresh
        </button>
      </div>
    </div>
    
    <div class="notifications-filters">
      <button class="filter-btn active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="unread">Unread</button>
      <button class="filter-btn" data-filter="service">Services</button>
      <button class="filter-btn" data-filter="approval">Approvals</button>
      <button class="filter-btn" data-filter="message">Messages</button>
      <button class="filter-btn" data-filter="system">System</button>
    </div>
    
    <div class="notifications-list-page" id="notifications-container">
      <div class="loading">Loading notifications...</div>
    </div>
    
    <div class="pagination" id="pagination" style="display: none;">
      <button id="prev-btn" onclick="previousPage()">Previous</button>
      <span id="page-info">Page 1 of 1</span>
      <button id="next-btn" onclick="nextPage()">Next</button>
    </div>
    </div>
  </div>
  </div>
  </div>

  <!-- User Data for JavaScript -->
  <script id="user-data" type="application/json"><%- JSON.stringify({ id: user._id, role: user.role, name: user.fName + ' ' + user.lName }) %></script>

  <!-- Unified Notifications Page Script -->
  <script src="/javascripts/notifications-page.js"></script>
  <script>
    // Initialize notifications page
    const notificationsPage = new NotificationsPage({
      containerId: 'notifications-container',
      paginationId: 'pagination',
      pageInfoId: 'page-info',
      prevBtnId: 'prev-btn',
      nextBtnId: 'next-btn',
      markAllReadBtnId: 'mark-all-btn',
      refreshBtnId: 'refresh-btn'
    });

    // Global functions for inline event handlers
    function previousPage() { notificationsPage.previousPage(); }
    function nextPage() { notificationsPage.nextPage(); }
    function markAsRead(id) { notificationsPage.markAsRead(id); }
    function deleteNotification(id) { notificationsPage.deleteNotification(id); }
    function handleNotificationClick(id, url, type) { notificationsPage.handleNotificationClick(id, url, type); }

    // Direct event handlers for buttons
    document.addEventListener('DOMContentLoaded', () => {
      const markAllBtn = document.getElementById('mark-all-btn');
      const refreshBtn = document.getElementById('refresh-btn');
      
      if (markAllBtn) {
        markAllBtn.onclick = async () => {
          console.log('🔘 Mark All Read clicked');
          try {
            const response = await fetch('/api/notifications/read-all', {
              method: 'PATCH',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' }
            });
            
            if (response.ok) {
              console.log('✅ All notifications marked as read');
              document.querySelectorAll('.notification-page-item.unread').forEach(item => {
                item.classList.remove('unread');
                const markReadBtn = item.querySelector('.notification-page-action-btn.mark-read');
                if (markReadBtn) markReadBtn.remove();
              });
              if (notificationsPage) notificationsPage.loadNotifications();
              if (window.notificationSystem) window.notificationSystem.refreshNotifications();
            } else {
              console.error('❌ Failed:', response.status);
            }
          } catch (error) {
            console.error('❌ Error:', error);
          }
        };
      }
      
      if (refreshBtn) {
        refreshBtn.onclick = () => {
          if (notificationsPage) notificationsPage.loadNotifications();
        };
      }
    });

    // Dropdown toggle
    function toggleDropdown() {
      const dropdown = document.getElementById('dropdownMenu');
      dropdown.classList.toggle('show');
    }

    // Close dropdown when clicking outside
    window.addEventListener('click', (e) => {
      if (!e.target.closest('.dropdown-wrapper')) {
        const dropdown = document.getElementById('dropdownMenu');
        if (dropdown) dropdown.classList.remove('show');
      }
    });

    // Sidebar hover effect for desktop
    const sidebar = document.getElementById('userSidebar');
    if (sidebar) {
      sidebar.addEventListener('mouseenter', function() {
        this.classList.add('expanded');
      });
      sidebar.addEventListener('mouseleave', function() {
        this.classList.remove('expanded');
      });
    }

    // Mobile Navigation Setup
    document.addEventListener('DOMContentLoaded', () => {
      const menuToggle = document.getElementById('userMenuToggle');
      const sidebarEl = document.getElementById('userSidebar');
      let touchStartX = 0;
      let touchEndX = 0;

      // Initialize Mobile Navigation
      function initMobileNavigation() {
        if (menuToggle && sidebarEl) {
          // Toggle menu on button click
          menuToggle.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            sidebarEl.classList.toggle('mobile-active');
          });

          // Handle touch swipe gestures
          document.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
          }, { passive: true });

          document.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            handleSwipe();
          }, { passive: true });

          // Close sidebar when clicking outside on mobile
          document.addEventListener('click', (e) => {
            if (window.innerWidth <= 768) {
              if (!sidebarEl.contains(e.target) && !menuToggle.contains(e.target)) {
                sidebarEl.classList.remove('mobile-active');
              }
            }
          });

          // Close sidebar when clicking any sidebar link on mobile
          const sidebarLinks = sidebarEl.querySelectorAll('.sidebar-item, .sidebar-profile-link');
          sidebarLinks.forEach(link => {
            link.addEventListener('click', () => {
              if (window.innerWidth <= 768) {
                setTimeout(() => {
                  sidebarEl.classList.remove('mobile-active');
                }, 100);
              }
            });
          });
        }
      }

      function handleSwipe() {
        const swipeDistance = touchEndX - touchStartX;
        const minSwipeDistance = 50;

        // Swipe right to open
        if (swipeDistance > minSwipeDistance && touchStartX < 50) {
          sidebarEl.classList.add('mobile-active');
        }
        // Swipe left to close
        else if (swipeDistance < -minSwipeDistance && sidebarEl.classList.contains('mobile-active')) {
          sidebarEl.classList.remove('mobile-active');
        }
      }

      // Initialize on page load
      initMobileNavigation();
    });
  </script>
</body>
</html>
