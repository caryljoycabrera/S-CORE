      </a>
    </div>

    <div class="sidebar-items">
      <a href="/dashboard" class="sidebar-item" title="Dashboard">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span class="sidebar-label">Dashboard</span>
      </a>
      
      <a href="/all-requests" class="sidebar-item" title="All Requests">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        <span class="sidebar-label">All Requests</span>
      </a>
      
      <a href="/request-approvals" class="sidebar-item" title="Request Approvals">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span class="sidebar-label">Request Approvals</span>
      </a>
      
      <a href="/service-requests" class="sidebar-item" title="Request Services">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"></path>
        </svg>
        <span class="sidebar-label">Request Services</span>
      </a>
      
      <a href="/user-guide" class="sidebar-item" title="Help & Guide">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        <span class="sidebar-label">Help & Guide</span>
      </a>
    </div>
    
    <!-- Logout Button at Bottom -->
    <div class="sidebar-bottom">
      <a href="/logout" class="sidebar-item sidebar-logout" title="Logout">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span class="sidebar-label">Logout</span>
      </a>
    </div>
  </div>

  <!-- Main Content -->
  <div class="user-main-content">
  <div class="student-side">
    <div class="div">
      <!-- Header matching user dashboard -->
      <div class="overlap">
        <!-- Left Group: Hamburger, Logo, Title -->
        <div class="header-left-group">
          <!-- Hamburger Menu Button for Mobile -->
          <button class="user-menu-toggle" id="userMenuToggle" title="Open Menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>

          <div class="group">
            <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
          </div>
          <a href="/dashboard" class="text-wrapper">S-CORE</a>
        </div>
        
        <span class="text-wrapper-2">Welcome, <%= user.fName %> <%= user.lName %>!</span>
        
        <div class="header-right-section">
          <!-- Notification Bell -->
          <%- include('partials/notifications') %>
          
          <div class="dropdown-wrapper">
            <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
              <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
              <div class="user">
                <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user-placeholder.svg' %>" alt="User Icon" />
              </div>
            </div>
            <div class="dropdown-menu" id="dropdownMenu">
              <a href="/profile">My Profile</a>
              <a href="/logout">Logout</a>
            </div>
          </div>
        </div>
      </div>

      <div class="notifications-page">
    <a href="<%= user.role === 'unit' ? '/unit/dashboard' : '/dashboard' %>" class="back-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15,18 9,12 15,6"></polyline>
      </svg>
      Back to Dashboard
    </a>
    
    <div class="notifications-header">
      <h1 class="notifications-title">Notifications</h1>
      <div class="notifications-actions">
        <button class="btn" id="mark-all-btn">
          Mark All as Read
        </button>
        <button class="btn" id="refresh-btn">
          Refresh
        </button>
        <button class="btn danger" id="ntDeleteToggleBtn" onclick="ntToggleDeleteMode()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="3,6 5,6 21,6"></polyline>
            <path d="M19,6v14a2,2,0,0,1-2,2H7a2,2,0,0,1-2-2V6m3,0V4a2,2,0,0,1,2-2h4a2,2,0,0,1,2,2V6"></path>
          </svg>
          Delete
        </button>
      </div>
    </div>
    
    <div class="notifications-filters">
      <button class="filter-btn active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="unread">Unread</button>
      <button class="filter-btn" data-filter="service">Services</button>
      <button class="filter-btn" data-filter="approval">Approvals</button>
      <button class="filter-btn" data-filter="message">Messages</button>
      <button class="filter-btn" data-filter="system">System</button>
    </div>
    
    <div class="notifications-list-page" id="notifications-container">
      <div class="loading">Loading notifications...</div>
    </div>

    <div class="nt-action-bar">
      <span class="nt-count" id="ntSelectedCount"></span>
      <button class="nt-btn nt-btn-outline" id="ntSelectAllBtn" onclick="ntToggleSelectAll()" style="display:none;">Select All</button>
          <button class="nt-btn nt-btn-danger" id="ntDeleteSelectedBtn" onclick="ntDeleteSelected()" disabled>Delete Selected</button>
          <button class="nt-btn nt-btn-danger" id="ntDeleteAllBtn" onclick="ntDeleteAll()">Delete All</button>
        </div>
    
    <div class="pagination" id="pagination" style="display: none;">
      <button id="prev-btn" onclick="previousPage()">Previous</button>
      <span id="page-info">Page 1 of 1</span>
      <button id="next-btn" onclick="nextPage()">Next</button>
    </div>
    </div>
  </div>
  </div>
  </div>

  <!-- ── Bulk Delete Confirmation Modal ─────────────────────────── -->
  <div class="nt-modal-backdrop" id="ntDeleteModal">
    <div class="nt-modal">
      <div class="nt-modal-header">
        <h3 class="nt-modal-title">Delete Notifications</h3>
        <button class="nt-modal-close" onclick="ntCloseModal('ntDeleteModal')">&times;</button>
      </div>
      <div class="nt-modal-body">
        <p style="color:#4b5563;margin:0;line-height:1.6;">
          Are you sure you want to delete the <strong id="ntDeleteCount">0</strong> selected notification(s)? This action cannot be undone.
        </p>
      </div>
      <div class="nt-modal-footer">
        <button class="nt-btn-secondary" onclick="ntCloseModal('ntDeleteModal')">Cancel</button>
        <button class="nt-btn-primary-danger" id="ntConfirmDeleteBtn" onclick="ntConfirmDeleteSelected()">Delete</button>
      </div>
    </div>
  </div>

  <!-- ── Delete All Confirmation Modal ───────────────────────────── -->
  <div class="nt-modal-backdrop" id="ntDeleteAllModal">
    <div class="nt-modal">
      <div class="nt-modal-header">
        <h3 class="nt-modal-title">Delete All Notifications</h3>
        <button class="nt-modal-close" onclick="ntCloseModal('ntDeleteAllModal')">&times;</button>
      </div>
      <div class="nt-modal-body">
        <p style="color:#4b5563;margin:0;line-height:1.6;">
          Are you sure you want to delete all <strong id="ntDeleteCountAll">0</strong> notification(s) on this page? This action cannot be undone.
        </p>
      </div>
      <div class="nt-modal-footer">
        <button class="nt-btn-secondary" onclick="ntCloseModal('ntDeleteAllModal')">Cancel</button>
        <button class="nt-btn-primary-danger" id="ntConfirmDeleteAllBtn" onclick="ntConfirmDeleteAll()">Delete All</button>
      </div>
    </div>
  </div>

  <!-- User Data for JavaScript -->
  <script id="user-data" type="application/json"><%- JSON.stringify({ id: user._id, role: user.role, name: user.fName + ' ' + user.lName }) %></script>

  <!-- Unified Notifications Page Script -->
  <script src="/javascripts/notifications-page.js"></script>
  <script>
    // Initialize notifications page
    const notificationsPage = new NotificationsPage({
      containerId: 'notifications-container',
      paginationId: 'pagination',
      pageInfoId: 'page-info',
      prevBtnId: 'prev-btn',
      nextBtnId: 'next-btn',
      markAllReadBtnId: 'mark-all-btn',
      refreshBtnId: 'refresh-btn',
      selectionEnabled: true
    });

    // Global functions for inline event handlers
    function previousPage() { notificationsPage.previousPage(); }
    function nextPage() { notificationsPage.nextPage(); }
    function markAsRead(id) { notificationsPage.markAsRead(id); }
    function deleteNotification(id) { notificationsPage.deleteNotification(id); }
    function handleNotificationClick(id, url, type) { notificationsPage.handleNotificationClick(id, url, type); }

    // Direct event handlers for buttons
    document.addEventListener('DOMContentLoaded', () => {
      const markAllBtn = document.getElementById('mark-all-btn');
      const refreshBtn = document.getElementById('refresh-btn');
      
      if (markAllBtn) {
        markAllBtn.onclick = async () => {
          console.log('🔘 Mark All Read clicked');
          try {
            const response = await fetch('/api/notifications/read-all', {
              method: 'PATCH',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' }
            });
            
            if (response.ok) {
              console.log('✅ All notifications marked as read');
              document.querySelectorAll('.notification-page-item.unread').forEach(item => {
                item.classList.remove('unread');
                const markReadBtn = item.querySelector('.notification-page-action-btn.mark-read');
                if (markReadBtn) markReadBtn.remove();
              });
              if (notificationsPage) notificationsPage.loadNotifications();
              if (window.notificationSystem) window.notificationSystem.refreshNotifications();
            } else {
              console.error('❌ Failed:', response.status);
            }
          } catch (error) {
            console.error('❌ Error:', error);
          }
        };
      }
      
      if (refreshBtn) {
        refreshBtn.onclick = () => {
          if (notificationsPage) notificationsPage.loadNotifications();
        };
      }
    });

    // Dropdown toggle
    function toggleDropdown() {
      const dropdown = document.getElementById('dropdownMenu');
      dropdown.classList.toggle('show');
    }

    // Close dropdown when clicking outside
    window.addEventListener('click', (e) => {
      if (!e.target.closest('.dropdown-wrapper')) {
        const dropdown = document.getElementById('dropdownMenu');
        if (dropdown) dropdown.classList.remove('show');
      }
    });

    // Sidebar hover effect for desktop
    const sidebar = document.getElementById('userSidebar');
    if (sidebar) {
      sidebar.addEventListener('mouseenter', function() {
        this.classList.add('expanded');
      });
      sidebar.addEventListener('mouseleave', function() {
        this.classList.remove('expanded');
      });
    }

    // Mobile Navigation Setup
    document.addEventListener('DOMContentLoaded', () => {
      const menuToggle = document.getElementById('userMenuToggle');
      const sidebarEl = document.getElementById('userSidebar');
      let touchStartX = 0;
      let touchEndX = 0;

      // Initialize Mobile Navigation
      function initMobileNavigation() {
        if (menuToggle && sidebarEl) {
          // Toggle menu on button click
          menuToggle.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            sidebarEl.classList.toggle('mobile-active');
          });

          // Handle touch swipe gestures
          document.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
          }, { passive: true });

          document.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            handleSwipe();
          }, { passive: true });

          // Close sidebar when clicking outside on mobile
          document.addEventListener('click', (e) => {
            if (window.innerWidth <= 768) {
              if (!sidebarEl.contains(e.target) && !menuToggle.contains(e.target)) {
                sidebarEl.classList.remove('mobile-active');
              }
            }
          });

          // Close sidebar when clicking any sidebar link on mobile
          const sidebarLinks = sidebarEl.querySelectorAll('.sidebar-item, .sidebar-profile-link');
          sidebarLinks.forEach(link => {
            link.addEventListener('click', () => {
              if (window.innerWidth <= 768) {
                setTimeout(() => {
                  sidebarEl.classList.remove('mobile-active');
                }, 100);
              }
            });
          });
        }
      }

      function handleSwipe() {
        const swipeDistance = touchEndX - touchStartX;
        const minSwipeDistance = 50;

        // Swipe right to open
        if (swipeDistance > minSwipeDistance && touchStartX < 50) {
          sidebarEl.classList.add('mobile-active');
        }
        // Swipe left to close
        else if (swipeDistance < -minSwipeDistance && sidebarEl.classList.contains('mobile-active')) {
          sidebarEl.classList.remove('mobile-active');
        }
      }

      // Initialize on page load
      initMobileNavigation();
    });

    // ═══════════════════════════════════════════════
    // Bulk Delete — Selection Management
    // ═══════════════════════════════════════════════

    let ntDeleteMode = false;

    function ntToggleDeleteMode() {
      ntDeleteMode = !ntDeleteMode;
      const container = document.querySelector('.notifications-page');
      const btn = document.getElementById('ntDeleteToggleBtn');
      if (ntDeleteMode) {
        container.classList.add('nt-delete-mode');
        btn.classList.add('active');
        btn.textContent = 'Cancel';
      } else {
        container.classList.remove('nt-delete-mode');
        btn.classList.remove('active');
        btn.textContent = 'Delete';
        ntClearSelections();
      }
    }

    function ntClearSelections() {
      document.querySelectorAll('.nt-checkbox').forEach(cb => cb.checked = false);
      document.querySelectorAll('.notification-page-item.nt-selected').forEach(el => el.classList.remove('nt-selected'));
      ntUpdateUI();
    }

    function ntUpdateUI() {
      const checkboxes = document.querySelectorAll('.nt-checkbox');
      const checked = document.querySelectorAll('.nt-checkbox:checked');
      const count = checked.length;
      const total = checkboxes.length;
      const countEl = document.getElementById('ntSelectedCount');
      const delBtn = document.getElementById('ntDeleteSelectedBtn');
      const selectAllBtn = document.getElementById('ntSelectAllBtn');
      countEl.textContent = count > 0 ? `${count} selected` : '';
      delBtn.disabled = count === 0;
      if (selectAllBtn) {
        selectAllBtn.style.display = total > 0 && ntDeleteMode ? 'inline-flex' : 'none';
        selectAllBtn.textContent = count === total ? 'Deselect All' : 'Select All';
      }
    }

    // Delegate checkbox change + click-to-select item
    document.addEventListener('change', (e) => {
      if (e.target.classList.contains('nt-checkbox')) {
        const item = e.target.closest('.notification-page-item');
        if (item) item.classList.toggle('nt-selected', e.target.checked);
        ntUpdateUI();
      }
    });

    // Click on notification body toggles checkbox
    document.addEventListener('click', (e) => {
      const item = e.target.closest('.notification-page-item');
      if (item && ntDeleteMode) {
        // Don't toggle when clicking the checkbox itself or action buttons
        if (e.target.closest('.nt-action-checkbox') || e.target.closest('.notification-page-item-actions')) return;
        const cb = item.querySelector('.nt-checkbox');
        if (cb) { cb.checked = !cb.checked; cb.dispatchEvent(new Event('change')); }
      }
    });

    function ntToggleSelectAll() {
      const allChecked = document.querySelectorAll('.nt-checkbox:checked').length === document.querySelectorAll('.nt-checkbox').length;
      document.querySelectorAll('.nt-checkbox').forEach(cb => {
        cb.checked = !allChecked;
        const item = cb.closest('.notification-page-item');
        if (item) item.classList.toggle('nt-selected', cb.checked);
      });
      ntUpdateUI();
    }

    function ntShowModal(id) {
      document.getElementById(id).classList.add('show');
      document.body.classList.add('nt-modal-active');
    }

    function ntCloseModal(id) {
      document.getElementById(id).classList.remove('show');
      document.body.classList.remove('nt-modal-active');
    }

    // Close modals on backdrop click
    document.querySelectorAll('.nt-modal-backdrop').forEach(bd => {
      bd.addEventListener('click', (e) => {
        if (e.target === bd) ntCloseModal(bd.id);
      });
    });

    function ntDeleteSelected() {
      const checked = document.querySelectorAll('.nt-checkbox:checked');
      if (checked.length === 0) return;
      document.getElementById('ntDeleteCount').textContent = checked.length;
      ntShowModal('ntDeleteModal');
    }

    async function ntConfirmDeleteSelected() {
      const btn = document.getElementById('ntConfirmDeleteBtn');
      btn.disabled = true; btn.textContent = 'Deleting...';
      const ids = [...document.querySelectorAll('.nt-checkbox:checked')].map(cb => cb.dataset.id);
      try {
        const res = await fetch('/api/notifications/bulk-delete', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids })
        });
        const data = await res.json();
        if (data.success) {
          ntCloseModal('ntDeleteModal');
          ntToggleDeleteMode(); // exit delete mode
          if (notificationsPage) notificationsPage.loadNotifications();
          if (window.notificationSystem) window.notificationSystem.refreshNotifications();
        } else {
          alert(data.message || 'Failed to delete');
        }
      } catch (err) {
        alert('Error: ' + err.message);
      } finally {
        btn.disabled = false; btn.textContent = 'Delete';
      }
    }

    function ntDeleteAll() {
      const allIds = [...document.querySelectorAll('.nt-checkbox')].map(cb => cb.dataset.id).filter(Boolean);
      if (allIds.length === 0) { alert('No notifications on this page to delete.'); return; }
      document.getElementById('ntDeleteCountAll').textContent = allIds.length;
      ntShowModal('ntDeleteAllModal');
    }

    async function ntConfirmDeleteAll() {
      const btn = document.getElementById('ntConfirmDeleteAllBtn');
      btn.disabled = true; btn.textContent = 'Deleting...';
      const ids = [...document.querySelectorAll('.nt-checkbox')].map(cb => cb.dataset.id).filter(Boolean);
      if (ids.length === 0) { ntCloseModal('ntDeleteAllModal'); btn.disabled = false; btn.textContent = 'Delete All'; return; }
      try {
        const res = await fetch('/api/notifications/bulk-delete', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids })
        });
        const data = await res.json();
        if (data.success) {
          ntCloseModal('ntDeleteAllModal');
          if (ntDeleteMode) ntToggleDeleteMode();
          if (notificationsPage) notificationsPage.loadNotifications();
          if (window.notificationSystem) window.notificationSystem.refreshNotifications();
        } else {
          alert(data.message || 'Failed to delete');
        }
      } catch (err) {
        alert('Error: ' + err.message);
      } finally {
        btn.disabled = false; btn.textContent = 'Delete All';
      }
    }
  </script>
</body>
</html>
