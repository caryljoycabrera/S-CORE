<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>S-CORE Dashboard</title>
  <link rel="stylesheet" href="/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    /* Calendar Theme Styles */
    .calendar-standalone {
      background: #fff;
      border-radius: 1rem;
      box-shadow: 0 4px 16px rgba(0,0,0,0.08);
      padding: 1.5rem;
      margin: 2rem 0 0 0;
      min-width: 280px;
      max-width: 320px;
      border: 1px solid rgba(0,0,0,0.05);
      transition: all 0.3s ease;
    }

    .calendar-standalone:hover {
      box-shadow: 0 8px 24px rgba(0,0,0,0.12);
      transform: translateY(-2px);
    }

    .calendar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid #e5e7eb;
    }

    .calendar-title {
      margin: 0;
      font-size: 1.2rem;
      font-weight: 600;
      color: #1f2937;
      font-family: 'Inter', sans-serif;
    }

    .calendar-month-year {
      font-size: 0.9rem;
      color: #6b7280;
      font-weight: 500;
    }

    .calendar-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 4px;
      font-size: 0.875rem;
      font-family: 'Inter', sans-serif;
    }

    .calendar-day-header {
      font-weight: 600;
      text-align: center;
      padding: 8px 4px;
      color: #6b7280;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .calendar-day {
      padding: 8px 4px;
      border-radius: 6px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s ease;
      color: #374151;
      font-weight: 500;
      min-height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .calendar-day:hover:not(.calendar-today):not(.calendar-empty) {
      background-color: #f3f4f6;
      transform: scale(1.05);
    }

    .calendar-today {
      background: linear-gradient(135deg, #007bff, #0056b3);
      color: white;
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(0, 123, 255, 0.3);
    }

    .calendar-empty {
      cursor: default;
    }

    .calendar-icon {
      width: 20px;
      height: 20px;
      color: #6b7280;
      margin-right: 0.5rem;
    }

    /* Enhanced action card hover effects to match calendar */
    .action-card {
      transition: all 0.3s ease;
    }

    .action-card:hover {
      transform: translateY(-4px) scale(1.01);
      box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }
  </style>
</head>
<body>
  <div class="student-side">
    <div class="div">
      <div class="overlap">
        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/dashboard" class="text-wrapper">S-CORE</a>
        <span class="text-wrapper-2">Welcome, <%= name %>!</span>
         <div class="dropdown-wrapper">
      <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
        <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
        <div class="user">
      <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
        </div>
      </div>
      <div class="dropdown-menu" id="dropdownMenu">
        <a href="/profile">My Profile</a>
        <a href="/logout">Logout</a>
      </div>
    </div>
      </div>
      <div class="action-cards-container">
        <div class="action-card" onclick="location.href='/all-requests'">
          <div class="card-icon-wrapper">
            <img src="/Picture/Stats.png" alt="All Requests" class="card-icon" />
            <div class="icon-glow"></div>
          </div>
          <h3 class="card-title">Track All Requests</h3>
          <p class="card-subtitle">Manage all your requests</p>
          <div class="card-arrow">→</div>
        </div>

        <div class="action-card" onclick="location.href='/request-approvals'">
          <div class="card-icon-wrapper">
            <img src="/Picture/File.png" alt="Request Approval" class="card-icon" />
            <div class="icon-glow"></div>
          </div>
          <h3 class="card-title">Request Approval</h3>
          <p class="card-subtitle">Submit materials for approval</p>
          <div class="card-arrow">→</div>
        </div>

        <div class="action-card" onclick="location.href='/service-requests'">
          <div class="card-icon-wrapper">
            <img src="/Picture/Repair.png" alt="Request Service" class="card-icon" />
            <div class="icon-glow"></div>
          </div>
          <h3 class="card-title">Request Service</h3>
          <p class="card-subtitle">Request deliverables</p>
          <div class="card-arrow">→</div>
        </div>

        <div class="calendar-standalone">
          <div class="calendar-header">
            <div style="display: flex; align-items: center;">
              <svg class="calendar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <h3 class="calendar-title">Calendar</h3>
            </div>
            <div class="calendar-month-year" id="calendar-month-year"></div>
          </div>
          <div id="calendar-standalone" class="calendar-grid"></div>
        </div>

      </div>

      <%
      function timeAgo(date) {
        const now = new Date();
        const diff = now - new Date(date);
        const minutes = Math.floor(diff / 60000);
        const hours = Math.floor(minutes / 60);
        const days = Math.floor(hours / 24);
        
        if (minutes < 1) return 'Just now';
        if (minutes < 60) return `${minutes} min${minutes === 1 ? '' : 's'} ago`;
        if (hours < 24) return `${hours} hour${hours === 1 ? '' : 's'} ago`;
        return `${days} day${days === 1 ? '' : 's'} ago`;
      }
      %>
      
  <div class="activity-section">
  <div class="section-header" style="justify-content: space-between; align-items: center;">
    <h2 class="section-title">Recent Activity</h2>
    <a href="/all-requests" class="view-all-btn">View All</a>
  </div>

  <div class="activity-grid">
    <% if (recentActivity.length === 0) { %>
      <p>No recent activity yet.</p>
    <% } else {
      recentActivity.forEach(activity => {
        const statusClass = activity.status.toLowerCase();

        let icon;
        switch (statusClass) {
          case 'approved':
            icon = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>`;
            break;
          case 'pending':
            icon = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                      <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>`;
            break;
          case 'inreview':
            icon = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <path d="M15 12H9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M12 9v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                    </svg>`;
            break;
          case 'rejected':
            icon = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <path d="M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>`;
            break;
          default:
            icon = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                    </svg>`;
        }
    %>
      <div class="activity-card <%= statusClass %>">
        <div class="activity-icon">
          <%- icon %>
        </div>
        <div class="activity-content">
          <h4><%= activity.title %></h4>
          <p><%= activity.description.length > 60 ? activity.description.slice(0, 60) + '...' : activity.description %></p>
          <span class="activity-time"><%= timeAgo(activity.updatedAt) %></span>
        </div>
        <div class="status-badge <%= statusClass %>"><%= activity.status %></div>
      </div>
    <% }); } %>
  </div>
</div>
      

      <div class="stats-container">
        <div class="stats-card">
          <div class="stat-number"><%= totalRequests %></div>
          <div class="stat-label">Total Requests</div>
        </div>
        <div class="stats-card">
          <div class="stat-number"><%= approvedRequests %></div>
          <div class="stat-label">Approved</div>
        </div>
        <div class="stats-card">
          <div class="stat-number"><%= pendingRequests %></div>
          <div class="stat-label">Pending</div>
        </div>
        <div class="stats-card">
          <div class="stat-number"><%= inReviewRequests %></div>
          <div class="stat-label">For Revision</div>
        </div>
      </div>

      <script>
    function toggleDropdown() {
      const menu = document.getElementById("dropdownMenu");
      menu.style.display = menu.style.display === "block" ? "none" : "block";
    }

    // Close dropdown if clicking outside
    document.addEventListener("click", function (event) {
      const toggle = document.querySelector(".dropdown-toggle");
      const menu = document.getElementById("dropdownMenu");
      if (!toggle.contains(event.target)) {
        menu.style.display = "none";
      }
    });

    // Add hover animations for action cards
    document.querySelectorAll('.action-card').forEach(card => {
      card.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-8px) scale(1.02)';
      });
      
      card.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0) scale(1)';
      });
    });

    // Enhanced calendar rendering with proper theming
    (function() {
      const calendar = document.getElementById('calendar-standalone');
      const monthYear = document.getElementById('calendar-month-year');
      if (!calendar || !monthYear) return;

      const now = new Date();
      const month = now.toLocaleString('default', { month: 'long' });
      const year = now.getFullYear();
      const firstDay = new Date(year, now.getMonth(), 1).getDay();
      const daysInMonth = new Date(year, now.getMonth() + 1, 0).getDate();
      
      // Set month and year in header
      monthYear.textContent = `${month} ${year}`;
      
      let html = '';
      
      // Day headers
      const dayHeaders = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      dayHeaders.forEach(day => {
        html += `<div class="calendar-day-header">${day}</div>`;
      });
      
      // Empty cells for days before month starts
      for (let i = 0; i < firstDay; i++) {
        html += '<div class="calendar-day calendar-empty"></div>';
      }
      
      // Days of the month
      for (let day = 1; day <= daysInMonth; day++) {
        const isToday = day === now.getDate();
        const className = isToday ? 'calendar-day calendar-today' : 'calendar-day';
        html += `<div class="${className}">${day}</div>`;
      }
      
      calendar.innerHTML = html;
    })();
  </script>
</body>
</html>