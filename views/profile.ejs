            </svg>
            Selected File:
          </strong><br>
          <strong>${file.name}</strong><br>
          Size: ${sizeInMB} MB<br>
          Type: ${file.type}
        </div>
      `;
    
    // Enable upload button
    if (uploadBtn) uploadBtn.disabled = false;
  };
  reader.readAsDataURL(file);
}
