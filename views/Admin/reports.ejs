  <!-- MAIN CONTENT WITH HEADER -->
  <div class="admin-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="admin-menu-toggle" id="adminMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/admin" class="text-wrapper">S-CORE ADMIN</a>
      </div>
      
      <span class="text-wrapper-2">Generate Reports</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/admin/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

    <!-- REPORTS PAGE CONTENT -->
    <div class="main-content-area" style="padding: 2rem;">
      <div class="reports-page-header">
        <h1>Reports Management</h1>
        <p>Generate new reports and manage report history</p>
      </div>

      <!-- TABS -->
      <div class="reports-tabs">
        <button class="tab-button active" data-tab="generate">Generate Report</button>
        <button class="tab-button" data-tab="history">Report History</button>
      </div>

      <!-- GENERATE REPORT TAB -->
      <div id="generateTab" class="tab-content active">
        <!-- FILTER PANEL -->
        <div class="report-filters-container">
          <!-- Filters Row 1 -->
          <div class="filters-row">
            <div class="filter-param">
              <label for="datePresetFilter">Time</label>
              <select id="datePresetFilter" class="filter-select">
                <option value="">Custom Range</option>
                <option value="7">Last 7 Days</option>
                <option value="30">Last 30 Days</option>
                <option value="90" selected>Last 90 Days</option>
                <option value="365">Last Year</option>
              </select>
            </div>

            <div class="filter-param" style="position: relative;">
              <div class="field-error" id="dateRangeError">End date must be after start date</div>
              <label for="startDateFilter">Range</label>
              <div class="date-range-group">
                <input type="date" id="startDateFilter" class="filter-input date-input" placeholder="Start Date" />
                <span class="date-separator">to</span>
                <input type="date" id="endDateFilter" class="filter-input date-input" placeholder="End Date" />
              </div>
            </div>

            <div class="filter-param">
              <label for="requestTypeFilter">Request Type</label>
              <select id="requestTypeFilter" class="filter-select">
                <option value="">All Types</option>
                <option value="ServiceRequest">Service Request</option>
                <option value="RequestApproval">Request for Approval</option>
              </select>
            </div>
          </div>

          <!-- Filters Row 2 -->
          <div class="filters-row">
            <div class="filter-param filter-param-wide">
              <label>Unit</label>
              <div class="multi-select-dropdown" id="unitDropdown">
                <button type="button" class="dropdown-trigger" id="unitDropdownTrigger">
                  <span id="unitDropdownText">All Units</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="dropdown-menu" id="unitDropdownMenu" style="display: none;">
                  <label class="dropdown-item">
                    <input type="checkbox" value="" data-filter="unit" id="allUnitsCheckbox" checked>
                    <span>All Units</span>
                  </label>
                  <% if (availableFilters && availableFilters.units) { %>
                    <% availableFilters.units.forEach(unit => { %>
                      <label class="dropdown-item">
                        <input type="checkbox" value="<%= unit %>" data-filter="unit">
                        <span><%= unit %></span>
                      </label>
                    <% }); %>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="filter-param filter-param-wide">
              <label>Status</label>
              <div class="multi-select-dropdown" id="statusDropdown">
                <button type="button" class="dropdown-trigger" id="statusDropdownTrigger">
                  <span id="statusDropdownText">All Statuses</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="dropdown-menu" id="statusDropdownMenu" style="display: none;">
                  <label class="dropdown-item">
                    <input type="checkbox" value="" data-filter="status" id="allStatusesCheckbox" checked>
                    <span>All Statuses</span>
                  </label>
                  <% if (availableFilters && availableFilters.statuses) { %>
                    <% availableFilters.statuses.forEach(status => { %>
                      <label class="dropdown-item">
                        <input type="checkbox" value="<%= status %>" data-filter="status">
                        <span><%= status %></span>
                      </label>
                    <% }); %>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="filter-param">
              <label for="sortByFilter">Sort By</label>
              <select id="sortByFilter" class="filter-select">
                <option value="createdAt">Date Submitted</option>
                <option value="deadline">Deadline</option>
                <option value="status">Status</option>
              </select>
            </div>

            <div class="filter-param">
              <label for="sortOrderFilter">Order</label>
              <select id="sortOrderFilter" class="filter-select">
                <option value="desc">Newest First</option>
                <option value="asc">Oldest First</option>
              </select>
            </div>
          </div>

          <!-- Action Buttons Row -->
          <div class="filter-actions-row">
            <button id="clearFiltersBtn" class="btn-secondary">
              Clear Filters
            </button>
            <button id="generatePreviewBtn" class="btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              Generate Preview
            </button>
          </div>
        </div>

        <!-- REPORT STATS -->
        <div class="report-stats-container" id="reportStats" style="display:none;">
          <h3>Report Summary</h3>
          <div class="stats-grid">
            <div class="stat-item">
              <div class="stat-label">Total Records</div>
              <div class="stat-value" id="statTotal">0</div>
            </div>
            <div class="stat-item">
              <div class="stat-label">Completion Rate</div>
              <div class="stat-value" id="statCompletionRate">0%</div>
            </div>
            <div class="stat-item">
              <div class="stat-label">Pending</div>
              <div class="stat-value" id="statPending">0</div>
            </div>
            <div class="stat-item">
              <div class="stat-label">In Progress</div>
              <div class="stat-value" id="statInProgress">0</div>
            </div>
          </div>
        </div>

        <!-- PREVIEW TABLE -->
        <div class="report-preview-container">
          <div class="preview-header">
          <h2>Report Preview</h2>
          <div class="export-options-wrapper">
            <!-- Row 1: File Name and Report Title -->
            <div class="field-row">
              <div class="export-format-selector">
                <label for="pdfFileName">File Name:</label>
                <input type="text" id="pdfFileName" class="format-input enhanced" placeholder="s-core-report" value="s-core-report">
              </div>
              
              <div class="export-format-selector">
                <label for="pdfTitle">Report Title:</label>
                <input type="text" id="pdfTitle" class="format-input enhanced" placeholder="S-CORE Analytics Report" value="S-CORE Analytics Report">
              </div>
            </div>
            
            <!-- Row 2: Description Toggle -->
            <div class="field-row description-toggle-row">
              <button type="button" class="description-toggle-btn" onclick="toggleDescription()">
