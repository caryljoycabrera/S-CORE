<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Generate Reports</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/stylesheets/notifications.css" />
  <link rel="stylesheet" href="/stylesheets/admin-navbar.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/adminpage.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/reports.css" />
  <link rel="stylesheet" href="/stylesheets/modal-centered.css" />
  <link rel="stylesheet" href="/stylesheets/no-animations.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="/javascripts/alert-handler.js"></script>
<style>
/* NEW RULE TO FIX FLUID LAYOUT */
.student-side > .div {
  max-width: 100%;
  margin-left: 0;
  margin-right: 0;
}
</style>
</head>
<body>
  <!-- SIDEBAR NAVIGATION -->
  <div class="admin-sidebar" id="adminSidebar">
    <!-- Profile Section at Top -->
    <div class="sidebar-profile">
      <a href="/admin/profile" class="sidebar-profile-link" title="Go to Profile">
        <div class="sidebar-profile-icon-container">
          <!-- SVG Icon (shows when collapsed) -->
          <svg class="sidebar-profile-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <!-- Profile Avatar (shows when expanded) -->
          <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" 
               alt="<%= user.fName %> <%= user.lName %>" 
               class="sidebar-profile-avatar" />
        </div>
        <div class="sidebar-profile-info">
          <p class="sidebar-profile-name"><%= user.fName %> <%= user.lName %></p>
          <p class="sidebar-profile-role"><%= user.userType === 'nonstudent' ? 'Non-Student' : user.userType.charAt(0).toUpperCase() + user.userType.slice(1) %></p>
        </div>
        <span class="sidebar-profile-arrow">→</span>
      </a>
    </div>

    <div class="sidebar-items">
      <a href="/admin" class="sidebar-item" title="Dashboard">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span class="sidebar-label">Dashboard</span>
      </a>
      
      <a href="/admin/analytics" class="sidebar-item" title="Analytics">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="20" x2="12" y2="10"></line>
          <line x1="18" y1="20" x2="18" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="16"></line>
        </svg>
        <span class="sidebar-label">Analytics</span>
      </a>
      
      <a href="/admin/all-requests" class="sidebar-item" title="Track All Requests">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 11l3 3L22 4"></path>
          <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
        </svg>
        <span class="sidebar-label">Track All Requests</span>
      </a>
      
      <a href="/admin/approvals" class="sidebar-item" title="Manage Approvals">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span class="sidebar-label">Manage Approvals</span>
      </a>
      
      <a href="/admin/services" class="sidebar-item" title="Manage Services">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"></path>
        </svg>
        <span class="sidebar-label">Manage Services</span>
      </a>
      
      <a href="/admin/users" class="sidebar-item" title="User Accounts">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 00-3-3.87"></path>
          <path d="M16 3.13a4 4 0 010 7.75"></path>
        </svg>
        <span class="sidebar-label">User Accounts</span>
      </a>
      <a href="/admin/announcement" class="sidebar-item" title="Announcements">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 9.5v5a1 1 0 0 1-1 1h-2.5L14 20v-6H9a1 1 0 0 1-1-1V9.5a1 1 0 0 1 1-1h5l4.5-4V8.5H21a1 1 0 0 1 1 1z"></path>
          <path d="M3 11v2a7 7 0 0 0 7 7v-2a5 5 0 0 1-5-5v-2H3z"></path>
        </svg>
        <span class="sidebar-label">Announcements</span>
      </a>

      <a href="/admin/configuration" class="sidebar-item" title="Configuration">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 1v6m0 6v6m8.66-12.66l-4.24 4.24m-6.84 6.84l-4.24 4.24M23 12h-6m-6 0H5m17.66 4.66l-4.24-4.24m-6.84-6.84L6.34 1.42"></path>
        </svg>
        <span class="sidebar-label">Configuration</span>
      </a>

      <a href="/admin/reports" class="sidebar-item active" title="Generate Reports">
        <svg class="sidebar-icon" viewBox="0 0 105.53 122.88" fill="currentColor" stroke="none">
          <path d="M98.66,87l2.84,2.85a1.9,1.9,0,0,1,0,2.71l-2.28,2.29a15.46,15.46,0,0,1,1.42,3.79h3a1.92,1.92,0,0,1,1.92,1.92v4a1.93,1.93,0,0,1-1.92,1.93h-3.23a15.4,15.4,0,0,1-1.67,3.67l2.09,2.09a1.93,1.93,0,0,1,0,2.72L98,117.86a1.93,1.93,0,0,1-2.72,0L93,115.58A15.88,15.88,0,0,1,89.16,117v3a1.93,1.93,0,0,1-1.92,1.92h-4A1.93,1.93,0,0,1,81.31,120v-3.23a15.32,15.32,0,0,1-3.68-1.68l-2.09,2.1a1.93,1.93,0,0,1-2.72,0L70,114.3a1.91,1.91,0,0,1,0-2.71l2.28-2.29a15.88,15.88,0,0,1-1.42-3.79h-3A1.93,1.93,0,0,1,66,103.59v-4a1.94,1.94,0,0,1,1.92-1.93H71.1A15.43,15.43,0,0,1,72.78,94l-2.1-2.09a1.93,1.93,0,0,1,0-2.72l2.85-2.84a1.91,1.91,0,0,1,2.71,0l2.29,2.28a15.83,15.83,0,0,1,3.79-1.42v-3a1.93,1.93,0,0,1,1.92-1.92h4a1.93,1.93,0,0,1,1.92,1.92v3.23a15,15,0,0,1,3.67,1.68L95.94,87a1.94,1.94,0,0,1,2.72,0ZM60.26,117a3,3,0,0,1,0,5.92H6.89A6.89,6.89,0,0,1,0,116V6.85A6.82,6.82,0,0,1,2,2,6.79,6.79,0,0,1,6.88,0H91.52a6.9,6.9,0,0,1,6.89,6.89V68.23c0,.06,0,.12,0,.18a3,3,0,0,1-5.94,0V6.89h0a1,1,0,0,0-.28-.68,1,1,0,0,0-.68-.29H6.89a.94.94,0,0,0-1,1V116h0a1,1,0,0,0,.28.67,1,1,0,0,0,.69.29H60.26ZM19,102.66V96H47.83v6.63l-28.82,0Zm55.3-42.9v6.11H65.62V59.76ZM58.77,54.38V65.87H50.08V54.38ZM43.24,37.92v28H34.55V37.92ZM27.7,26.41V65.87H19V26.41ZM69,29.31l13.11.05a13.14,13.14,0,0,1-3.91,9.29,13.55,13.55,0,0,1-1.91,1.56L69,29.31Zm-1.34-2.6L67,12.7a.51.51,0,0,1,.48-.53H68A14.56,14.56,0,0,1,82.69,25.67a.52.52,0,0,1-.47.54l-14,1a.49.49,0,0,1-.53-.46.08.08,0,0,0,0,0Zm.83-13.55.65,12.51L80.9,24.61a11.68,11.68,0,0,0-4-7.86c-2.46-2.27-4.74-3.62-8.32-3.58ZM66.1,28.7l7,12.17A14.05,14.05,0,1,1,64.06,14.8l2,13.9ZM19,84.83V78.15H59.86v6.63L19,84.83Zm66.73,9.38a7.89,7.89,0,1,1-7.89,7.89,7.89,7.89,0,0,1,7.89-7.89Z"/>
        </svg>
        <span class="sidebar-label">Generate Reports</span>
      </a>
    </div>
    
    <!-- Logout Button at Bottom -->
    <div class="sidebar-bottom">
      <a href="/logout" class="sidebar-item sidebar-logout" title="Logout">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span class="sidebar-label">Logout</span>
      </a>
    </div>
  </div>

  <!-- MAIN CONTENT WITH HEADER -->
  <div class="admin-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="admin-menu-toggle" id="adminMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/admin" class="text-wrapper">S-CORE ADMIN</a>
      </div>
      
      <span class="text-wrapper-2">Generate Reports</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/admin/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

    <!-- REPORTS PAGE CONTENT -->
    <div class="main-content-area" style="padding: 2rem;">
      <div class="reports-page-header">
        <h1>Reports Management</h1>
        <p>Generate new reports and manage report history</p>
      </div>

      <!-- TABS -->
      <div class="reports-tabs">
        <button class="tab-button active" data-tab="generate">Generate Report</button>
        <button class="tab-button" data-tab="history">Report History</button>
      </div>

      <!-- GENERATE REPORT TAB -->
      <div id="generateTab" class="tab-content active">
        <!-- FILTER PANEL -->
        <div class="report-filters-container">
        <div class="filter-group">
          <label for="datePresetFilter">Quick Date Range</label>
          <select id="datePresetFilter" class="filter-input">
            <option value="">Custom Range</option>
            <option value="7">Last 7 Days</option>
            <option value="30">Last 30 Days</option>
            <option value="90">Last 90 Days</option>
            <option value="365">Last Year</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="startDateFilter">Start Date</label>
          <input type="date" id="startDateFilter" class="filter-input" />
        </div>

        <div class="filter-group">
          <label for="endDateFilter">End Date</label>
          <input type="date" id="endDateFilter" class="filter-input" />
        </div>

        <div class="filter-group">
          <label for="unitFilter">Unit</label>
          <select id="unitFilter" class="filter-input" multiple size="4">
            <option value="">All Units</option>
            <% if (availableFilters && availableFilters.units) { %>
              <% availableFilters.units.forEach(unit => { %>
                <option value="<%= unit %>"><%= unit %></option>
              <% }); %>
            <% } %>
          </select>
          <small>Hold Ctrl/Cmd to select multiple</small>
        </div>

        <div class="filter-group">
          <label for="requestTypeFilter">Request Type</label>
          <select id="requestTypeFilter" class="filter-input">
            <option value="">All Types</option>
            <option value="ServiceRequest">Service Request</option>
            <option value="RequestApproval">Request for Approval</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="statusFilter">Status</label>
          <select id="statusFilter" class="filter-input" multiple size="4">
            <option value="">All Statuses</option>
            <% if (availableFilters && availableFilters.statuses) { %>
              <% availableFilters.statuses.forEach(status => { %>
                <option value="<%= status %>"><%= status %></option>
              <% }); %>
            <% } %>
          </select>
          <small>Hold Ctrl/Cmd to select multiple</small>
        </div>

        <div class="filter-group">
          <label for="sortByFilter">Sort By</label>
          <select id="sortByFilter" class="filter-input">
            <option value="createdAt">Date Submitted</option>
            <option value="deadline">Deadline</option>
            <option value="status">Status</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="sortOrderFilter">Sort Order</label>
          <select id="sortOrderFilter" class="filter-input">
            <option value="desc">Newest First</option>
            <option value="asc">Oldest First</option>
          </select>
        </div>

        <div class="filter-actions">
          <button id="generatePreviewBtn" class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
              <path d="M21 3v5h-5"></path>
              <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
              <path d="M3 21v-5h5"></path>
            </svg>
            Generate Preview
          </button>
          <button id="clearFiltersBtn" class="btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 6h18M5 4h14l2 2v13a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6l2-2z"></path>
              <line x1="10" y1="12" x2="14" y2="12"></line>
            </svg>
            Clear Filters
          </button>
        </div>
      </div>

      <!-- REPORT STATS -->
      <div class="report-stats-container" id="reportStats" style="display:none;">
        <h3>Report Summary</h3>
        <div class="stats-grid">
          <div class="stat-item">
            <div class="stat-label">Total Records</div>
            <div class="stat-value" id="statTotal">0</div>
          </div>
          <div class="stat-item">
            <div class="stat-label">Completion Rate</div>
            <div class="stat-value" id="statCompletionRate">0%</div>
          </div>
          <div class="stat-item">
            <div class="stat-label">Pending</div>
            <div class="stat-value" id="statPending">0</div>
          </div>
          <div class="stat-item">
            <div class="stat-label">In Progress</div>
            <div class="stat-value" id="statInProgress">0</div>
          </div>
        </div>
      </div>

      <!-- PREVIEW TABLE -->
      <div class="report-preview-container">
        <div class="preview-header">
          <h2>Report Preview</h2>
          <div class="export-options">
            <div class="export-format-selector">
              <label for="pdfTitle">Report Title:</label>
              <input type="text" id="pdfTitle" class="format-input" placeholder="S-CORE Analytics Report" value="S-CORE Analytics Report">
            </div>
            <div class="export-format-selector">
              <label for="pdfHeaderColor">Header Color:</label>
              <input type="color" id="pdfHeaderColor" class="format-input" value="#10b981">
            </div>
            <div class="export-format-selector">
              <label for="pdfPaperSize">Paper Size:</label>
              <select id="pdfPaperSize" class="format-select">
                <option value="A4">A4</option>
                <option value="A3">A3</option>
                <option value="LETTER">Letter</option>
                <option value="LEGAL">Legal</option>
                <option value="TABLOID">Tabloid</option>
              </select>
            </div>
            <div class="export-format-selector">
              <label for="pdfOrientation">Orientation:</label>
              <select id="pdfOrientation" class="format-select">
                <option value="portrait">Portrait</option>
                <option value="landscape">Landscape</option>
              </select>
            </div>
            <div class="export-buttons">
              <button id="exportPdfBtn" class="btn-export btn-pdf" disabled>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <text x="9" y="17" font-size="8">PDF</text>
                </svg>
                Download PDF
              </button>
              <button id="exportExcelBtn" class="btn-export btn-excel" disabled>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <text x="9" y="17" font-size="8">XLS</text>
                </svg>
                Download Excel
              </button>
            </div>
          </div>
        </div>

        <div class="table-container">
          <table class="report-table" id="reportTable">
            <thead>
              <tr>
                <th>Request ID</th>
                <th>Type</th>
                <th>Requester</th>
                <th>Unit</th>
                <th>Request Name</th>
                <th>Status</th>
                <th>Date Submitted</th>
                <th>Deadline</th>
                <th>Revisions</th>
                <th>Final Remarks</th>
              </tr>
            </thead>
            <tbody id="reportTableBody">
              <tr class="no-data-row">
                <td colspan="10" style="text-align: center; padding: 2rem; color: #6b7280;">
                  Click "Generate Preview" to load data
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- REPORT HISTORY TAB -->
      <div id="historyTab" class="tab-content">
        <div class="history-container">
          <div class="history-header">
            <h2>Generated Reports History</h2>
            <p>View and download previously generated reports</p>
          </div>

          <div class="history-filters">
            <div class="filter-group">
              <label for="historyTypeFilter">Report Type</label>
              <select id="historyTypeFilter" class="filter-input">
                <option value="">All Types</option>
                <option value="report_pdf">PDF Reports</option>
                <option value="report_excel">Excel Reports</option>
              </select>
            </div>
            <div class="filter-group">
              <label class="checkbox-label">
                <input type="checkbox" id="showDeletedFilter"> Show Deleted Reports
              </label>
            </div>
            <button id="refreshHistoryBtn" class="btn-secondary">Refresh</button>
          </div>

          <div class="history-table-container">
            <table class="history-table" id="historyTable">
              <thead>
                <tr>
                  <th>Report Type</th>
                  <th>File Name</th>
                  <th>Generated</th>
                  <th>Records</th>
                  <th>Size</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="historyTableBody">
                <tr class="no-data-row">
                  <td colspan="6" style="text-align: center; padding: 2rem; color: #6b7280;">
                    Loading report history...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="pagination-container" id="historyPagination" style="display: none;">
            <button id="prevPageBtn" class="btn-secondary">Previous</button>
            <span id="pageInfo">Page 1</span>
            <button id="nextPageBtn" class="btn-secondary">Next</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Loading Indicator -->
  <div id="loadingIndicator" class="loading-indicator" style="display:none;">
    <div class="spinner"></div>
    <p>Generating report...</p>
  </div>

  <!-- Scripts -->
  <script src="/javascripts/ejs/reports.js"></script>

  <style>
    /* Report-specific styles */
    .loading-indicator {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: white;
      padding: 2rem;
      border-radius: 12px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
      z-index: 2000;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .spinner {
      width: 40px;
      height: 40px;
      border: 4px solid #e5e7eb;
      border-top: 4px solid #10b981;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

