<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Announcements - S-CORE</title>
  <link rel="icon" type="image/x-icon" href="/Picture/favicon.ico?v=2">
  <link rel="shortcut icon" href="/Picture/favicon.ico?v=2">
  <meta name="theme-color" content="#1a5d1a">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/stylesheets/admin-navbar.css">
  <link rel="stylesheet" href="/stylesheets/modal-centered.css">
  <link rel="stylesheet" href="/stylesheets/notifications.css">
  <link rel="stylesheet" href="/stylesheets/no-animations.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
  <!-- Quill Editor -->
  <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/quill-custom.css">
  <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
  <script src="/javascripts/alert-handler.js"></script>

  <style>
    /* Admin Layout */
    .admin-side { padding: 0 !important; background: #f8f9fa !important; box-sizing: border-box; }
    .activity-section { padding: 0 !important; margin: 0 !important; background: #f8f9fa !important; overflow: visible !important; position: relative; z-index: 1; }
    .page-header-container { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; gap: 1rem; flex-wrap: wrap; padding: 2rem 3rem 0 3rem; }
    .user-info-section { display: flex; align-items: center; gap: 1rem; flex: 1; }
    .action-button-container { margin-left: auto; }
    .filter-section { background: white; border: none; border-radius: 0; padding: 1.25rem; margin: 0 3rem 1.5rem 3rem; box-shadow: none; overflow: visible !important; position: relative; z-index: 1; }
    .table-section { background: white; padding: 1.5rem; margin: 0 3rem 2rem 3rem; border-radius: 0; }

    /* Announcements Table */
    .announcements-table { width: 100%; border-collapse: collapse; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); background: white; }
    .announcements-table thead { background: var(--light-green); color: var(--primary-green); }
    .announcements-table th, .announcements-table td { padding: 1rem; text-align: left; border-bottom: 1px solid #e5e7eb; }
    .announcements-table th { font-weight: 600; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .announcements-table tbody tr:hover { background: #f9fafb; }

    /* Priority Badge */
    .priority-badge { display: inline-flex; align-items: center; padding: 0.375rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .priority-badge.low { background: #dbeafe; color: #1e40af; }
    .priority-badge.medium { background: #fef3c7; color: #d97706; }
    .priority-badge.high { background: #fecaca; color: #dc2626; }

    /* Status Badge */
    .status-badge { display: inline-flex; align-items: center; padding: 0.375rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .status-badge.active { background: #d1fae5; color: #065f46; }
    .status-badge.scheduled { background: #fef3c7; color: #d97706; }
    .status-badge.expired { background: #f3f4f6; color: #6b7280; }

    /* Action Buttons */
    .action-btn { padding: 0.375rem 0.75rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer; border: none; transition: all 0.2s ease; text-transform: uppercase; letter-spacing: 0.5px; }
    .action-btn.edit { background: #3b82f6; color: white; }
    .action-btn.edit:hover { background: #2563eb; transform: translateY(-1px); }
    .action-btn.delete { background: #6b7280; color: white; }
    .action-btn.delete:hover { background: #4b5563; transform: translateY(-1px); }
    .action-btn.view { background: #10b981; color: white; }
    .action-btn.view:hover { background: #059669; transform: translateY(-1px); }

    /* Modal Styles */
    .modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); display: none; justify-content: center; align-items: center; z-index: 1000; }
    .modal-content { background: white; border-radius: 12px; max-width: 600px; width: 90%; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2); }
    .modal-header { padding: 1.5rem; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center; }
    .modal-title { font-size: 1.25rem; font-weight: 600; color: #1f2937; margin: 0; }
    .modal-close { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #6b7280; padding: 0; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: all 0.2s ease; }
    .modal-close:hover { background: #f3f4f6; color: #374151; }
    .modal-body { padding: 1.5rem; }
    .form-group { margin-bottom: 1rem; }
    .form-label { display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem; }
    .form-input { width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 1rem; transition: all 0.2s ease; }
    .form-input:focus { outline: none; border-color: var(--primary-green); box-shadow: 0 0 0 3px rgba(64, 139, 78, 0.1); }
    .form-textarea { resize: vertical; min-height: 120px; }
    .modal-actions { padding: 1.5rem; border-top: 1px solid #e5e7eb; display: flex; gap: 0.75rem; justify-content: flex-end; }
    .modal-btn { padding: 0.75rem 1.5rem; border-radius: 8px; font-size: 0.875rem; font-weight: 600; cursor: pointer; border: none; transition: all 0.2s ease; text-transform: uppercase; letter-spacing: 0.5px; }
    .modal-btn.primary { background: var(--primary-green); color: white; }
    .modal-btn.primary:hover { background: #157347; transform: translateY(-1px); }
    .modal-btn.secondary { background: #f3f4f6; color: #374151; border: 2px solid #e5e7eb; }
    .modal-btn.secondary:hover { background: #e5e7eb; transform: translateY(-1px); }
    .modal-btn.danger { background: #ef4444; color: white; }
    .modal-btn.danger:hover { background: #dc2626; transform: translateY(-1px); }

    /* Checkbox Group */
    .checkbox-group { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .checkbox-item { display: flex; align-items: center; gap: 0.5rem; }
    .checkbox-item input[type="checkbox"] { width: 18px; height: 18px; cursor: pointer; }
    .checkbox-item label { margin: 0; cursor: pointer; }

    /* Editor Container */
    .editor-container { background: white; min-height: 200px; border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 1rem; }

    /* Quill Editor Toolbar Customization */
    .ql-toolbar { border-top-left-radius: 8px; border-top-right-radius: 8px; }
    .ql-container { border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; }
    .ql-snow .ql-toolbar button { font-size: 1rem; width: 32px; height: 32px; padding: 4px; }
    .ql-snow .ql-toolbar button:hover { color: var(--primary-green); }
    .ql-file-upload { background: none; border: none; cursor: pointer; padding: 4px 8px; font-size: 1rem; margin: 0 2px; border-radius: 4px; transition: all 0.2s ease; }
    .ql-file-upload:hover { background: #f3f4f6; }
    .ql-toolbar .ql-formats { gap: 2px; }

    /* Empty State */
    .empty-state { text-align: center; padding: 3rem 2rem; color: #6b7280; }
    .empty-state-icon { font-size: 4rem; margin-bottom: 1rem; opacity: 0.5; }
    .empty-state-title { font-size: 1.25rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem; }

    /* Back to Dashboard Container */
    .back-to-dashboard-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 1.5rem 3rem;
      margin: 0;
    }

    .trash-btn, .back-to-dashboard-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.875rem 1.5rem;
      border-radius: 12px;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      border: none;
      transition: all 0.2s ease;
      text-decoration: none;
      color: inherit;
    }

    .trash-btn {
      background: #fef3c7;
      color: #92400e;
    }

    .trash-btn:hover {
      background: #fde68a;
      transform: translateY(-2px);
    }

    .back-to-dashboard-btn {
      background: #b4f3b7;
      color: white;
    }

    .back-to-dashboard-btn:hover {
      background: #157347;
      color: white;
      transform: translateY(-2px);
    }

    .trash-btn:hover{
      background: #92400e;
      color:white;
    }

    /* View Content Styling */
    #viewContent { font-size: 1rem; color: #1f2937; word-wrap: break-word; }
    #viewContent img { max-width: 100%; height: auto; border-radius: 8px; margin: 1rem 0; display: block; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); }
    #viewContent ul, #viewContent ol { margin: 1rem 0; padding-left: 2rem; }
    #viewContent li { margin: 0.5rem 0; }
    #viewContent blockquote { margin: 1rem 0; padding-left: 1rem; border-left: 4px solid #10b981; color: #6b7280; font-style: italic; }
    #viewContent a { color: #10b981; text-decoration: none; }
    #viewContent a:hover { text-decoration: underline; }
    #viewContent h1 { font-size: 1.875rem; font-weight: 700; margin: 1rem 0 0.5rem 0; }
    #viewContent h2 { font-size: 1.5rem; font-weight: 700; margin: 1rem 0 0.5rem 0; }
    #viewContent h3 { font-size: 1.25rem; font-weight: 700; margin: 1rem 0 0.5rem 0; }
    #viewContent p { margin: 0.5rem 0; }
    #viewContent strong { font-weight: 600; }
    #viewContent em { font-style: italic; }

    /* Responsive */
    @media (max-width: 768px) {
      .page-header-container, .filter-section, .table-section { padding-left: 1.5rem; padding-right: 1.5rem; margin-left: 1.5rem; margin-right: 1.5rem; }
      .back-to-dashboard-container { padding: 1rem 1.5rem; flex-direction: column; align-items: stretch; }
      .trash-btn, .back-to-dashboard-btn { justify-content: center; }
      .modal-content { margin: 1rem; width: calc(100% - 2rem); }
      .checkbox-group { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body>
