  <script>
    function addDropdownEntry(targetId) {
      const input = document.getElementById(targetId + '_input');
      const select = document.getElementById(targetId + '_select');
      const val = input.value.trim();
      
      if (val) {
        let exists = false;
        for(let i=0; i<select.options.length; i++){
          if(select.options[i].value === val) {
            exists = true;
            break;
          }
        }
        if(!exists) {
          const opt = document.createElement('option');
          opt.value = val;
          opt.textContent = val;
          select.appendChild(opt);
        }
        select.value = val;
        input.value = '';
        updateTextareaFromSelect(targetId);
      }
    }

    function addFromSearchableSelect(widgetId, targetId) {
      const widget = document.getElementById(widgetId);
      if (!widget || !widget._searchableSelect) return;
      const val = widget._searchableSelect.getValue();
      if (!val) return;
      const targetSelect = document.getElementById(targetId + '_select');
      let exists = false;
      for(let i=0; i<targetSelect.options.length; i++){
        if(targetSelect.options[i].value === val) {
          exists = true;
          break;
        }
      }
      if(!exists) {
        const opt = document.createElement('option');
        opt.value = val;
        opt.textContent = val;
        targetSelect.appendChild(opt);
      }
      targetSelect.value = val;
      updateTextareaFromSelect(targetId);
    }

    function removeDropdownEntry(targetId) {
      const select = document.getElementById(targetId + '_select');
      if (select.selectedIndex !== -1) {
        select.remove(select.selectedIndex);
        updateTextareaFromSelect(targetId);
      }
    }

    function updateTextareaFromSelect(targetId) {
      const select = document.getElementById(targetId + '_select');
      const textarea = document.getElementById(targetId);
      const vals = [];
      for(let i=0; i<select.options.length; i++) {
        vals.push(select.options[i].value);
      }
      textarea.value = vals.join('\n');
    }

    /* Tabs UI Controller for Units and Roles */
    function initDynamicTabs(containerId) {
      const container = document.getElementById(containerId);
      if (!container) return;
      container.classList.add('tabs-content-area'); // For animation

      let nav = container.previousElementSibling;
      if (!nav || !nav.classList.contains('tabs-nav')) {
          nav = document.createElement('div');
          nav.className = 'tabs-nav';
          container.parentNode.insertBefore(nav, container);
      }
      
      let isRendering = false;
      function renderTabs() {
          if (isRendering) return;
          isRendering = true;
          nav.innerHTML = '';
          const items = container.querySelectorAll('.dynamic-item');
          if (items.length === 0) {
              isRendering = false;
              return;
          }
          
          let hasActive = false;
          
          items.forEach((item, i) => {
              const titleEl = item.querySelector('.item-number');
              let titleText = titleEl ? titleEl.innerText : `Item ${i+1}`;
              // Clean up title text to fit tab
              titleText = titleText.replace(/New Unit/g, '').replace(/New Role/g, '').trim();

              const btn = document.createElement('button');
              btn.type = 'button';
              btn.innerHTML = titleText || `Item ${i+1}`;
              btn.className = 'tab-btn';
              
              if (item.style.display !== 'none' && !hasActive) {
                  btn.classList.add('active');
                  item.style.display = 'block';
                  hasActive = true;
              } else {
                  item.style.display = 'none';
              }
              
              btn.onclick = () => {
                  items.forEach(it => it.style.display = 'none');
                  Array.from(nav.children).forEach(b => b.classList.remove('active'));
                  item.style.display = 'block';
                  btn.classList.add('active');
              };
              
              nav.appendChild(btn);
          });
          
          if (!hasActive && items.length > 0) {
              items[0].style.display = 'block';
              nav.children[0].classList.add('active');
          }
          isRendering = false;
      }
      
      // Setup MutationObserver to watch for additions/removals
      const observer = new MutationObserver((mutations) => {
          let shouldRender = false;
          mutations.forEach(m => {
              if (m.type === 'childList') shouldRender = true;
          });
          if (shouldRender) renderTabs();
      });
      observer.observe(container, { childList: true, subtree: true });

      // Listen for text input changes to update tab titles dynamically
      container.addEventListener('input', (e) => {
          if (e.target.tagName.toLowerCase() === 'input' && e.target.type === 'text') {
              const item = e.target.closest('.dynamic-item');
              if(item) {
                  // Only respond to the FIRST text input to avoid other form inputs renaming the tab
                  const firstInput = item.querySelector('input[type="text"]');
                  if (firstInput !== e.target) return;

                  const i = Array.from(container.children).indexOf(item);
                  const header = item.querySelector('.item-number');
                  if(header) {
                      let pre = header.innerText.split(':')[0].split(' ')[0] + ' ' + (i+1);
                      if (!pre.includes((i+1).toString())) {
                         pre = header.innerText.replace(/:.*/, '').trim() || `Item ${i+1}`;
                      }
                      header.innerHTML = `${pre}: <strong>${e.target.value || 'New'}</strong>`;
                      renderTabs();
                  }
              }
          }
      });

      renderTabs();
    }

    document.addEventListener('DOMContentLoaded', () => {
      initDynamicTabs('unitsWithRequestTypesContainer');
      initDynamicTabs('userRolesContainer');
      initDynamicTabs('pledgeItemsContainer');
      initDynamicTabs('aboutFeaturesContainer');
      initDynamicTabs('servicesContainer');
      initDynamicTabs('teamMembersContainer');
      initDynamicTabs('contactCardsContainer');
      initDynamicTabs('socialMediaContainer');
      initDynamicTabs('footerLinksContainer');
    });
  </script>

