                          loadArchiveRecordsFromAPI();
                          window.showToast && window.showToast(`Restored to ${statusSelect.value}.`);
                          closeAmRestoreModal();
                        } else {
                          alert('Restore failed: ' + (data.message || 'Unknown error'));
