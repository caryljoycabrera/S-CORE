                        </div>
                        <div style="display: flex; gap: 0.5rem;">
                          <input type="text" id="officesList_input" placeholder="New office/department..." style="flex: 1; min-width: 0; margin-bottom: 0;" onkeypress="if(event.key === 'Enter') { event.preventDefault(); addDropdownEntry('officesList'); }">
