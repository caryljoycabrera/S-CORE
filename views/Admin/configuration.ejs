  <!-- MAIN CONTENT WITH HEADER -->
  <div class="admin-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="admin-menu-toggle" id="adminMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/admin" class="text-wrapper">S-CORE ADMIN</a>
      </div>
      
      <span class="text-wrapper-2">Configuration</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user-placeholder.svg' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/admin/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

    <!-- CONFIGURATION CONTENT -->
    <div class="config-container">
      <!-- Toast Notification Area -->
      <div id="configToast" style="position:fixed;top:2rem;right:2rem;z-index:99999;min-width:200px;background:#10b981;color:white;padding:1rem 2rem;border-radius:0.5rem;box-shadow:0 2px 8px rgba(16,185,129,0.2);font-weight:600;display:none;"></div>

      <!-- Tab Navigation -->
      <div class="config-tabs">
        <button type="button" class="config-tab active" onclick="switchTab('system')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;"><use href="#icon-settings"/></svg>System Configuration
        </button>
        <button type="button" class="config-tab" onclick="switchTab('homepage')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;"><use href="#icon-home"/></svg>Homepage Configuration
        </button>
        <button type="button" class="config-tab" onclick="switchTab('aboutscore')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;"><use href="#icon-edit"/></svg>About S-CORE Page Configuration
        </button>
        <button type="button" class="config-tab" onclick="switchTab('archivemanager')" id="archiveManagerTabBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;"><use href="#icon-archive"/></svg>Archive Manager
        </button>
        <button type="button" class="config-tab" onclick="switchTab('chatbot')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;"><use href="#icon-help-circle"/></svg>Q&A Chatbot
        </button>
      </div>

      <!-- Mobile tab dropdown (visible only on small screens) -->
      <select class="config-tabs-mobile-select" id="configTabSelect" onchange="switchTab(this.value)">
        <option value="system">System Configuration</option>
        <option value="homepage">Homepage Configuration</option>
        <option value="aboutscore">About S-CORE Page Configuration</option>
        <option value="archivemanager">Archive Manager</option>
        <option value="chatbot">Q&amp;A Chatbot</option>
      </select>

      <!-- Homepage Configuration Tab -->
      <div id="homepage-tab" class="tab-content">
        <div class="config-header">
          <h1>Homepage Configuration</h1>
        </div>

        <!-- Info Banner -->
        <div style="background: #fffbeb; border-left: 4px solid #f59e0b; padding: 1rem 1.5rem; border-radius: 0.5rem; margin-bottom: 2rem;">
          <p style="margin: 0; color: #92400e; font-weight: 500;">
            <strong><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px;"><use href="#icon-home"/></svg> Homepage Configuration:</strong> Customize the public-facing homepage content including hero section, about information, services, team members, and contact details. Changes will be visible to all visitors.
          </p>
        </div>

        <!-- Configuration Form -->
        <form id="configurationForm" action="/admin/configuration" method="POST">
          <input type="hidden" name="tabName" value="homepage">
          <div class="config-sections" id="configForm">
                  <!-- Modal for Preview -->
                  <div id="configModal" class="preview-modal">
                    <div class="preview-content">
                      <div class="preview-header">
                        <h2>Preview Changes</h2>
                        <button type="button" class="btn-close-preview" onclick="closePreview()">Close</button>
                      </div>
                      <div class="preview-body" id="modalContent">
                        <!-- Preview content will be injected here -->
                      </div>
                    </div>
                  </div>
            <!-- Homepage Preview Area -->
            <div id="homepagePreview" style="display:none;padding:1rem;background:#f9fafb;border-radius:0.5rem;margin-bottom:1rem;"></div>

          <!-- Hero Section -->
          <div class="config-section">
            <h2 class="section-title">
              <svg class="section-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;"><use href="#icon-target"/></svg>
              Hero Section
            </h2>
            <p class="section-description">
              The main hero section that visitors see first when they land on the homepage.
            </p>

            <div class="form-group">
              <label for="heroTitle">Hero Title</label>
              <input
                type="text"
                id="heroTitle"
                name="heroTitle"
                value="<%= pageContent.heroTitle %>"
                maxlength="150"
                oninput="updateCharCount(this, 'heroTitleCount', 150)"
              >
              <div class="char-count" id="heroTitleCount"></div>
              <p class="form-hint">Main heading that appears in the hero section (before the highlighted part)</p>
            </div>

            <div class="form-group">
              <label for="heroTitleHighlight">Hero Title Highlight</label>
              <input
                type="text"
                id="heroTitleHighlight"
                name="heroTitleHighlight"
                value="<%= pageContent.heroTitleHighlight %>"
                maxlength="50"
                oninput="updateCharCount(this, 'heroTitleHighlightCount', 50)"
              >
              <div class="char-count" id="heroTitleHighlightCount"></div>
              <p class="form-hint">Highlighted part of the hero title (appears with gradient styling)</p>
            </div>

            <div class="form-group">
