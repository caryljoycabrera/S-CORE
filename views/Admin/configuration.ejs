                      </div>
                    </div>

                    <!-- High Priority Organizations/Offices/Departments -->
                    <div class="config-section">
                      <h2 class="section-title">
                        <svg class="section-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;"><use href="#icon-alert-triangle"/></svg>
                        High Priority Organizations/Offices/Departments
                      </h2>
                      <p class="section-description">
                        Manage organizations, offices, or departments whose requests should appear highlighted with a red left border, light red background, and always on top of every request table.
                      </p>
                      <div class="form-group">
                        <label for="highPriorityOrgs_select">Current Prioritized Entries</label>
                        <% 
                          const highPriorityOrgs = (settings && settings.highPriorityOrgs && settings.highPriorityOrgs.length > 0) ? settings.highPriorityOrgs : [];
                          const allOrgs = (settings && settings.organizations && settings.organizations.length > 0) ? 
                            (Array.isArray(settings.organizations) ? settings.organizations.map(org => typeof org === 'string' ? org : org.name) : []) : [];
                          const allOffices = (settings && settings.offices && settings.offices.length > 0) ? settings.offices : [];
                        %>
                        <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem;">
                          <select id="highPriorityOrgs_select" style="flex: 1; min-width: 0; margin-bottom: 0;">
                            <% highPriorityOrgs.forEach(function(entry) { %>
                              <option value="<%= entry %>"><%= entry %></option>
                            <% }); %>
                          </select>
                          <button type="button" class="btn-remove-item" onclick="removeDropdownEntry('highPriorityOrgs')" style="position: static; width: auto; height: auto; padding: 0 1rem; border-radius: 0.5rem;" title="Remove selected">
                            <span>×</span> Remove
                          </button>
                        </div>

                        <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 0.75rem 0;">

                        <label style="font-weight: 600; color: #374151; font-size: 0.875rem; margin-bottom: 0.5rem; display: block;">Add from Organizations</label>
                        <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem;">
                          <div class="enhanced-multi-select-wrapper" style="width:auto;flex:1;">
                            <div class="enhanced-multi-select" id="highPriorityOrgSelect">
                              <div class="select-display" data-placeholder="Select Organization">
                                <span class="selected-text">Select Organization</span>
                                <span class="dropdown-arrow">▼</span>
