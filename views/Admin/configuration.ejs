                        <label for="organizationsList_input">Student Organizations</label>
                        <% 
                          const orgs = (settings && settings.organizations && settings.organizations.length > 0) ? 
                            (Array.isArray(settings.organizations) ? settings.organizations.map(org => typeof org === 'string' ? org : org.name) : []) : [];
                        %>
                        <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
                          <select id="organizationsList_select" style="flex: 1; min-width: 0; margin-bottom: 0;">
                            <% orgs.forEach(function(org) { %>
                              <option value="<%= org %>"><%= org %></option>
