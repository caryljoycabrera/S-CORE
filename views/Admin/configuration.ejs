              <div class="form-group">
                <label for="sCoreWhatIsTitle">System Overview Title</label>
                <input type="text" id="sCoreWhatIsTitle" name="sCoreWhatIsTitle" value="<%= pageContent.sCoreWhatIsTitle %>" maxlength="50" oninput="updateCharCount(this, 'sCoreWhatIsTitleCount', 50)">
                <div class="char-count" id="sCoreWhatIsTitleCount"></div>
                <p class="form-hint">Section header (default: 'What is S-CORE?')</p>
              </div>
              <div class="form-group">
                <label for="sCoreWhatIsDescription">System Overview Description</label>
                <textarea id="sCoreWhatIsDescription" name="sCoreWhatIsDescription" class="tall" maxlength="500" oninput="updateCharCount(this, 'sCoreWhatIsDescriptionCount', 500)"><%= pageContent.sCoreWhatIsDescription %></textarea>
                <div class="char-count" id="sCoreWhatIsDescriptionCount"></div>
                <p class="form-hint">Description text explaining what S-CORE is and its main purpose</p>
              </div>
            </div>

            <!-- Platform Features Section -->
            <div class="config-section">
              <h2 class="section-title">
                <span class="section-icon">✨</span>
                Platform Features Section
              </h2>
              <p class="section-description">
                The right content card with dashboard screenshot and description of why users should use S-CORE.
              </p>
              <div class="form-group">
                <label for="sCoreWhyTitle">Platform Features Title</label>
                <input type="text" id="sCoreWhyTitle" name="sCoreWhyTitle" value="<%= pageContent.sCoreWhyTitle %>" maxlength="50" oninput="updateCharCount(this, 'sCoreWhyTitleCount', 50)">
                <div class="char-count" id="sCoreWhyTitleCount"></div>
                <p class="form-hint">Section header (default: 'Why use S-CORE?')</p>
              </div>
              <div class="form-group">
                <label for="sCoreWhyDescription">Platform Features Description</label>
                <textarea id="sCoreWhyDescription" name="sCoreWhyDescription" class="tall" maxlength="500" oninput="updateCharCount(this, 'sCoreWhyDescriptionCount', 500)"><%= pageContent.sCoreWhyDescription %></textarea>
                <div class="char-count" id="sCoreWhyDescriptionCount"></div>
                <p class="form-hint">Description text for platform features and benefits</p>
              </div>
              <div class="form-group">
                <label for="sCoreDashboardImage">Dashboard Screenshot Image URL</label>
                <input type="text" id="sCoreDashboardImage" name="sCoreDashboardImage" value="<%= pageContent.sCoreDashboardImage %>" maxlength="200">
