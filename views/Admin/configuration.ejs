                   // ── Archive Selection State ──────────────────────────────
                   let archiveSelectedIds = new Set();

                   function archiveUpdateSelectedCount() {
                     const count = archiveSelectedIds.size;
                     const btn = document.getElementById('archiveDeleteSelectedBtn');
                     const label = document.getElementById('archiveSelectedCount');
                     const selectAll = document.getElementById('archiveSelectAll');
                     if (label) {
                       label.style.display = count > 0 ? 'inline' : 'none';
                       label.textContent = count + ' selected';
                     }
                     if (btn) {
                       btn.disabled = count === 0;
                       btn.style.opacity = count === 0 ? '0.5' : '1';
                       btn.innerHTML = count > 0
                         ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg> Delete Selected (' + count + ')'
                         : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg> Delete Selected';
                     }
                     if (selectAll) {
                       const allCheckboxes = document.querySelectorAll('#archiveManagerBody .archive-row-select');
                       const visibleCheckboxes = Array.from(allCheckboxes).filter(cb => cb.closest('.archive-row').style.display !== 'none');
                       const checkedVisible = visibleCheckboxes.filter(cb => cb.checked);
                       selectAll.checked = visibleCheckboxes.length > 0 && checkedVisible.length === visibleCheckboxes.length;
                       selectAll.indeterminate = checkedVisible.length > 0 && checkedVisible.length < visibleCheckboxes.length;
                     }
                   }

                   window.toggleArchiveSelectAll = function(checkbox) {
                     const checkboxes = document.querySelectorAll('#archiveManagerBody .archive-row-select');
                     checkboxes.forEach(cb => {
                       const row = cb.closest('.archive-row');
                       if (row.style.display !== 'none') {
                         cb.checked = checkbox.checked;
                         if (cb.checked) {
                           archiveSelectedIds.add(cb.value);
                         } else {
                           archiveSelectedIds.delete(cb.value);
                         }
                       }
                     });
                     archiveUpdateSelectedCount();
                   };

                   window.toggleArchiveRowSelect = function() {
                     const checkboxes = document.querySelectorAll('#archiveManagerBody .archive-row-select');
                     archiveSelectedIds.clear();
                     checkboxes.forEach(cb => {
                       if (cb.checked) {
                         archiveSelectedIds.add(cb.value);
                       }
