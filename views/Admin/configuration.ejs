<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Homepage Configuration | S-CORE Admin</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/stylesheets/notifications.css" />
  <link rel="stylesheet" href="/stylesheets/admin-navbar.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/adminpage.css" />
  <link rel="stylesheet" href="/stylesheets/modal-centered.css" />
  <link rel="stylesheet" href="/stylesheets/no-animations.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="/javascripts/alert-handler.js"></script>
  
  <style>
    /* Configuration Page Specific Styles */
    .config-container {
      max-width: 100%;
      padding: 2rem;
    }

    .config-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid #e5e7eb;
    }

    .config-header h1 {
      font-size: 2rem;
      font-weight: 700;
      color: #1f2937;
      margin: 0;
    }

    .config-header-actions {
      display: flex;
      gap: 1rem;
    }

    .btn-preview,
    .btn-save,
    .btn-reset {
      padding: 0.75rem 1.5rem;
      border-radius: 0.5rem;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.2s ease;
      border: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-preview {
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      color: white;
    }

    .btn-preview:hover {
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      transform: translateY(-1px);
      box-shadow: 0 4px 8px rgba(59, 130, 246, 0.3);
    }

    .btn-save {
      background: linear-gradient(135deg, #10b981, #059669);
      color: white;
    }

    .btn-save:hover {
      background: linear-gradient(135deg, #059669, #047857);
      transform: translateY(-1px);
      box-shadow: 0 4px 8px rgba(16, 185, 129, 0.3);
    }

    .btn-reset {
      background: linear-gradient(135deg, #ef4444, #dc2626);
      color: white;
    }

    .btn-reset:hover {
      background: linear-gradient(135deg, #dc2626, #b91c1c);
      transform: translateY(-1px);
      box-shadow: 0 4px 8px rgba(239, 68, 68, 0.3);
    }

    .config-sections {
      display: grid;
      gap: 2rem;
    }

    .config-section {
      background: white;
      border-radius: 1rem;
      padding: 2rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      border: 1px solid #e5e7eb;
    }

    .section-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: #1f2937;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .section-icon {
      font-size: 1.75rem;
    }

    .section-description {
      color: #6b7280;
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      font-weight: 600;
      color: #374151;
      margin-bottom: 0.5rem;
      font-size: 0.95rem;
    }

    .form-group input[type="text"],
    .form-group input[type="email"],
    .form-group input[type="url"],
    .form-group textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 2px solid #e5e7eb;
      border-radius: 0.5rem;
      font-size: 0.95rem;
      font-family: 'Inter', sans-serif;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: #3b82f6;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .form-group textarea {
      resize: vertical;
      min-height: 100px;
      line-height: 1.6;
    }

    .form-group textarea.tall {
      min-height: 150px;
    }

    .form-hint {
      font-size: 0.85rem;
      color: #6b7280;
      margin-top: 0.25rem;
    }

    .char-count {
      font-size: 0.8rem;
      color: #9ca3af;
      text-align: right;
      margin-top: 0.25rem;
    }

    /* Preview Modal */
    .preview-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.75);
      z-index: 9999;
      padding: 2rem;
      overflow-y: auto;
    }

    .preview-modal.active {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .preview-content {
      background: white;
      border-radius: 1rem;
      max-width: 1200px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
    }

    .preview-header {
      position: sticky;
      top: 0;
      background: white;
      padding: 1.5rem 2rem;
      border-bottom: 2px solid #e5e7eb;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 10;
    }

    .preview-header h2 {
      font-size: 1.5rem;
      font-weight: 700;
      color: #1f2937;
      margin: 0;
    }

    .btn-close-preview {
      background: #ef4444;
      color: white;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-close-preview:hover {
      background: #dc2626;
      transform: translateY(-1px);
    }

    .preview-body {
      padding: 2rem;
    }

    .preview-section {
      margin-bottom: 3rem;
      padding: 2rem;
      background: #f9fafb;
      border-radius: 0.75rem;
      border: 1px solid #e5e7eb;
    }

    .preview-section h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1f2937;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #d1d5db;
    }

    .preview-item {
      margin-bottom: 1rem;
    }

    .preview-item strong {
      display: block;
      color: #374151;
      font-weight: 600;
      margin-bottom: 0.25rem;
    }

    .preview-item p {
      color: #6b7280;
      line-height: 1.6;
      margin: 0;
    }

    /* Alert Messages */
    .alert {
      padding: 1rem 1.5rem;
      border-radius: 0.5rem;
      margin-bottom: 1.5rem;
      font-weight: 500;
    }

    .alert-success {
      background: #d1fae5;
      color: #065f46;
      border: 1px solid #10b981;
    }

    .alert-error {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #ef4444;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .config-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }

      .config-header-actions {
        width: 100%;
        flex-wrap: wrap;
      }

      .btn-preview,
      .btn-save,
      .btn-reset {
        flex: 1;
        justify-content: center;
      }
    }

    /* Dynamic Items Styles */
    .dynamic-items-section {
      margin-top: 1.5rem;
    }

    .dynamic-items-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid #e5e7eb;
    }

    .dynamic-items-header h3 {
      font-size: 1.1rem;
      font-weight: 600;
      color: #374151;
      margin: 0;
    }

    .btn-add-item {
      background: linear-gradient(135deg, #10b981, #059669);
      color: white;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 0.375rem;
      font-weight: 600;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-add-item:hover {
      background: linear-gradient(135deg, #059669, #047857);
      transform: translateY(-1px);
      box-shadow: 0 2px 4px rgba(16, 185, 129, 0.3);
    }

    .dynamic-items-container {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .dynamic-item {
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 0.5rem;
      padding: 1rem;
      position: relative;
    }

    .item-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid #d1d5db;
    }

    .item-number {
      font-weight: 600;
      color: #374151;
      font-size: 0.95rem;
    }

    .btn-remove-item {
      background: #ef4444;
      color: white;
      border: none;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      font-weight: bold;
      transition: all 0.2s ease;
    }

    .btn-remove-item:hover {
      background: #dc2626;
      transform: scale(1.1);
    }

    .item-content {
      display: grid;
      gap: 1rem;
    }

    .item-content .form-group {
      margin-bottom: 0;
    }

    .item-content .form-group label {
      font-size: 0.9rem;
      font-weight: 500;
    }

    .item-content .form-group input,
    .item-content .form-group textarea {
      font-size: 0.9rem;
      padding: 0.5rem 0.75rem;
    }
  </style>
</head>
<body>
  <!-- SIDEBAR NAVIGATION -->
  <div class="admin-sidebar" id="adminSidebar">
    <!-- Profile Section at Top -->
    <div class="sidebar-profile">
      <a href="/admin/profile" class="sidebar-profile-link" title="Go to Profile">
        <div class="sidebar-profile-avatar">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <div class="sidebar-profile-info">
          <div class="sidebar-profile-name"><%= name %></div>
          <div class="sidebar-profile-role">Administrator</div>
        </div>
      </a>
    </div>

    <div class="sidebar-items">
      <a href="/admin" class="sidebar-item" title="Dashboard">
        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span class="sidebar-label">Dashboard</span>
      </a>
      
      <a href="/admin/analytics" class="sidebar-item" title="Analytics">
        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="20" x2="12" y2="10"></line>
          <line x1="18" y1="20" x2="18" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="16"></line>
        </svg>
        <span class="sidebar-label">Analytics</span>
      </a>
      
      <a href="/admin/all-requests" class="sidebar-item" title="Track All Requests">
        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
        </svg>
        <span class="sidebar-label">All Requests</span>
      </a>
      
      <a href="/admin/approvals" class="sidebar-item" title="Manage Approvals">
        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span class="sidebar-label">Approvals</span>
      </a>
      
      <a href="/admin/services" class="sidebar-item" title="Manage Services">
        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="16"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
        <span class="sidebar-label">Services</span>
      </a>
      
      <a href="/admin/users" class="sidebar-item" title="User Accounts">
        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span class="sidebar-label">Users</span>
      </a>
      
      <a href="/admin/announcement" class="sidebar-item" title="Announcements">
        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span class="sidebar-label">Announcements</span>
      </a>
      
      <a href="/admin/configuration" class="sidebar-item active" title="Configuration">
        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 1v6m0 6v6m8.66-12.66l-4.24 4.24m-6.84 6.84l-4.24 4.24M23 12h-6m-6 0H5m17.66 4.66l-4.24-4.24m-6.84-6.84L6.34 1.42"></path>
        </svg>
        <span class="sidebar-label">Configuration</span>
      </a>

      <a href="/admin/reports" class="sidebar-item" title="Generate Reports">
        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span class="sidebar-label">Reports</span>
      </a>
    </div>
    
    <!-- Logout Button at Bottom -->
    <div class="sidebar-bottom">
      <a href="/logout" class="sidebar-item sidebar-logout" title="Logout">
        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span class="sidebar-label">Logout</span>
      </a>
    </div>
  </div>

  <!-- MAIN CONTENT WITH HEADER -->
  <div class="admin-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="admin-menu-toggle" id="adminMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/admin" class="text-wrapper">S-CORE ADMIN</a>
      </div>
      
      <span class="text-wrapper-2">Homepage Configuration</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.firstName %> <%= user.lastName %></div>
            <div class="user">
              <div class="ellipse"></div>
            </div>
          </div>
          
          <div id="dropdownMenu" class="dropdown-menu">
            <a href="/admin/profile" class="dropdown-item">
              <svg class="dropdown-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              Profile
            </a>
            <a href="/logout" class="dropdown-item">
              <svg class="dropdown-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              Logout
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- CONFIGURATION CONTENT -->
    <div class="config-container">
      <!-- Success/Error Messages -->
      <% if (success) { %>
        <div class="alert alert-success">
          ✓ <%= success %>
        </div>
      <% } %>
      
      <% if (error) { %>
        <div class="alert alert-error">
          ✗ <%= error %>
        </div>
      <% } %>

      <!-- Header -->
      <div class="config-header">
        <h1>Homepage Configuration</h1>
        <div class="config-header-actions">
          <button type="button" class="btn-preview" onclick="showPreview()">
            👁️ Preview Changes
          </button>
          <button type="submit" form="configForm" class="btn-save">
            💾 Save Changes
          </button>
          <button type="button" class="btn-reset" onclick="resetForm()">
            🔄 Reset Form
          </button>
        </div>
      </div>

      <!-- Configuration Form -->
      <form id="configForm" method="POST" action="/admin/configuration">
        <div class="config-sections">

          <!-- Hero Section -->
          <div class="config-section">
            <h2 class="section-title">
              <span class="section-icon">🎯</span>
              Hero Section
            </h2>
            <p class="section-description">
              The main hero section that visitors see first when they land on the homepage.
            </p>

            <div class="form-group">
              <label for="heroTitle">Hero Title</label>
              <input
                type="text"
                id="heroTitle"
                name="heroTitle"
                value="<%= pageContent.heroTitle %>"
                maxlength="150"
                oninput="updateCharCount(this, 'heroTitleCount', 150)"
              >
              <div class="char-count" id="heroTitleCount"></div>
              <p class="form-hint">Main heading that appears in the hero section (before the highlighted part)</p>
            </div>

            <div class="form-group">
              <label for="heroTitleHighlight">Hero Title Highlight</label>
              <input
                type="text"
                id="heroTitleHighlight"
                name="heroTitleHighlight"
                value="<%= pageContent.heroTitleHighlight %>"
                maxlength="50"
                oninput="updateCharCount(this, 'heroTitleHighlightCount', 50)"
              >
              <div class="char-count" id="heroTitleHighlightCount"></div>
              <p class="form-hint">Highlighted part of the hero title (appears with gradient styling)</p>
            </div>

            <div class="form-group">
              <label for="heroSubtitle">Hero Subtitle</label>
              <textarea
                id="heroSubtitle"
                name="heroSubtitle"
                class="tall"
                maxlength="500"
                oninput="updateCharCount(this, 'heroSubtitleCount', 500)"
              ><%= pageContent.heroSubtitle %></textarea>
              <div class="char-count" id="heroSubtitleCount"></div>
              <p class="form-hint">Descriptive text that appears below the hero title</p>
            </div>

            <div class="form-group">
              <label for="heroPrimaryButtonText">Primary Button Text</label>
              <input
                type="text"
                id="heroPrimaryButtonText"
                name="heroPrimaryButtonText"
                value="<%= pageContent.heroPrimaryButtonText %>"
                maxlength="50"
                oninput="updateCharCount(this, 'heroPrimaryButtonTextCount', 50)"
              >
              <div class="char-count" id="heroPrimaryButtonTextCount"></div>
              <p class="form-hint">Text for the main call-to-action button</p>
            </div>

            <div class="form-group">
              <label for="heroPrimaryButtonLink">Primary Button Link</label>
              <input
                type="text"
                id="heroPrimaryButtonLink"
                name="heroPrimaryButtonLink"
                value="<%= pageContent.heroPrimaryButtonLink %>"
                maxlength="200"
              >
              <p class="form-hint">URL or anchor link (e.g., #contact, /page, https://example.com)</p>
            </div>

            <div class="form-group">
              <label for="heroSecondaryButtonText">Secondary Button Text</label>
              <input
                type="text"
                id="heroSecondaryButtonText"
                name="heroSecondaryButtonText"
                value="<%= pageContent.heroSecondaryButtonText %>"
                maxlength="50"
