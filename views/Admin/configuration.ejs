    </div>
    
    <!-- Logout Button at Bottom -->
    <div class="sidebar-bottom">
      <a href="/logout" class="sidebar-item sidebar-logout" title="Logout">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span class="sidebar-label">Logout</span>
      </a>
    </div>
  </div>

  <!-- MAIN CONTENT WITH HEADER -->
  <div class="admin-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="admin-menu-toggle" id="adminMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/admin" class="text-wrapper">S-CORE ADMIN</a>
      </div>
      
      <span class="text-wrapper-2">Configuration</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/admin/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

    <!-- CONFIGURATION CONTENT -->
    <div class="config-container">
      <!-- Success/Error Messages -->
      <% if (success) { %>
        <div class="alert alert-success">
          ✓ <%= success %>
        </div>
      <% } %>
      
      <% if (error) { %>
        <div class="alert alert-error">
          ✗ <%= error %>
        </div>
      <% } %>

      <!-- Tab Navigation -->
      <div class="config-tabs">
        <button type="button" class="config-tab active" onclick="switchTab('system')">
          ⚙️ System Configuration
        </button>
        <button type="button" class="config-tab" onclick="switchTab('homepage')">
          🏠 Homepage Configuration
        </button>
      </div>

      <!-- Homepage Configuration Tab -->
      <div id="homepage-tab" class="tab-content">
        <!-- Header -->
        <div class="config-header">
          <h1>Homepage Configuration</h1>
          <div class="config-header-actions">
            <button type="button" class="btn-preview" onclick="showPreview()">
              👁️ Preview Changes
            </button>
            <button type="submit" form="configForm" class="btn-save">
              💾 Save Changes
            </button>
            <button type="button" class="btn-reset" onclick="resetForm()">
              🔄 Reset Form
            </button>
          </div>
        </div>

        <!-- Configuration Form -->
        <form id="configForm" method="POST" action="/admin/configuration">
          <div class="config-sections">

          <!-- Hero Section -->
          <div class="config-section">
            <h2 class="section-title">
              <span class="section-icon">🎯</span>
              Hero Section
            </h2>
            <p class="section-description">
              The main hero section that visitors see first when they land on the homepage.
            </p>

            <div class="form-group">
              <label for="heroTitle">Hero Title</label>
              <input
                type="text"
                id="heroTitle"
                name="heroTitle"
                value="<%= pageContent.heroTitle %>"
                maxlength="150"
                oninput="updateCharCount(this, 'heroTitleCount', 150)"
              >
              <div class="char-count" id="heroTitleCount"></div>
              <p class="form-hint">Main heading that appears in the hero section (before the highlighted part)</p>
            </div>

            <div class="form-group">
              <label for="heroTitleHighlight">Hero Title Highlight</label>
              <input
                type="text"
                id="heroTitleHighlight"
                name="heroTitleHighlight"
                value="<%= pageContent.heroTitleHighlight %>"
                maxlength="50"
                oninput="updateCharCount(this, 'heroTitleHighlightCount', 50)"
              >
              <div class="char-count" id="heroTitleHighlightCount"></div>
              <p class="form-hint">Highlighted part of the hero title (appears with gradient styling)</p>
            </div>

            <div class="form-group">
              <label for="heroSubtitle">Hero Subtitle</label>
              <textarea
                id="heroSubtitle"
                name="heroSubtitle"
                class="tall"
                maxlength="500"
                oninput="updateCharCount(this, 'heroSubtitleCount', 500)"
              ><%= pageContent.heroSubtitle %></textarea>
              <div class="char-count" id="heroSubtitleCount"></div>
              <p class="form-hint">Descriptive text that appears below the hero title</p>
            </div>

            <div class="form-group">
              <label for="heroPrimaryButtonText">Primary Button Text</label>
              <input
                type="text"
                id="heroPrimaryButtonText"
                name="heroPrimaryButtonText"
                value="<%= pageContent.heroPrimaryButtonText %>"
                maxlength="50"
                oninput="updateCharCount(this, 'heroPrimaryButtonTextCount', 50)"
              >
              <div class="char-count" id="heroPrimaryButtonTextCount"></div>
              <p class="form-hint">Text for the main call-to-action button</p>
            </div>

            <div class="form-group">
              <label for="heroPrimaryButtonLink">Primary Button Link</label>
              <input
                type="text"
                id="heroPrimaryButtonLink"
                name="heroPrimaryButtonLink"
                value="<%= pageContent.heroPrimaryButtonLink %>"
                maxlength="200"
              >
              <p class="form-hint">URL or anchor link (e.g., #contact, /page, https://example.com)</p>
            </div>

            <div class="form-group">
              <label for="heroSecondaryButtonText">Secondary Button Text</label>
              <input
                type="text"
                id="heroSecondaryButtonText"
                name="heroSecondaryButtonText"
                value="<%= pageContent.heroSecondaryButtonText %>"
                maxlength="50"
                oninput="updateCharCount(this, 'heroSecondaryButtonTextCount', 50)"
              >
              <div class="char-count" id="heroSecondaryButtonTextCount"></div>
              <p class="form-hint">Text for the secondary button</p>
            </div>

            <div class="form-group">
              <label for="heroSecondaryButtonLink">Secondary Button Link</label>
              <input
                type="text"
                id="heroSecondaryButtonLink"
                name="heroSecondaryButtonLink"
                value="<%= pageContent.heroSecondaryButtonLink %>"
                maxlength="200"
              >
              <p class="form-hint">URL or anchor link for secondary button</p>
            </div>
          </div>

          <!-- SCO Pledge Section -->
          <div class="config-section">
            <h2 class="section-title">
              <span class="section-icon">🤝</span>
              SCO Pledge Section
            </h2>
            <p class="section-description">
              The section title and core values that define the Strategic Communications Office's commitment. You can add, remove, or edit pledge items dynamically.
            </p>

            <div class="form-group">
              <label for="pledgeSectionTitle">Section Title</label>
              <input
                type="text"
                id="pledgeSectionTitle"
                name="pledgeSectionTitle"
                value="<%= pageContent.pledgeSectionTitle %>"
                maxlength="50"
                oninput="updateCharCount(this, 'pledgeSectionTitleCount', 50)"
              >
              <div class="char-count" id="pledgeSectionTitleCount"></div>
              <p class="form-hint">Title that appears above the pledge items</p>
            </div>

            <div class="dynamic-items-section">
              <div class="dynamic-items-header">
                <h3>Pledge Items</h3>
                <button type="button" class="btn-add-item" onclick="addPledgeItem()">
                  <span>+</span> Add Pledge Item
                </button>
              </div>
              <div id="pledgeItemsContainer" class="dynamic-items-container">
                <% 
                const pledgeItems = pageContent.pledgeItems || [];
                pledgeItems.forEach((item, index) => { %>
                <div class="dynamic-item" data-index="<%= index %>">
                  <div class="item-header">
                    <span class="item-number">Pledge <%= index + 1 %></span>
                    <button type="button" class="btn-remove-item" onclick="removePledgeItem(this)">
                      <span>×</span>
                    </button>
                  </div>
                  <div class="item-content">
                    <div class="form-group">
                      <label>Name</label>
                      <input
                        type="text"
                        name="pledgeName[]"
                        value="<%= item.name %>"
                        maxlength="50"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>Description</label>
                      <textarea
                        name="pledgeDescription[]"
                        maxlength="250"
                        required
                      ><%= item.description %></textarea>
                    </div>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- About Section -->
          <div class="config-section">
            <h2 class="section-title">
              <span class="section-icon">ℹ️</span>
              About Section
            </h2>
            <p class="section-description">
              Section title, subtitle, and information about the Strategic Communications Office's mission and vision.
            </p>

            <div class="form-group">
              <label for="aboutSectionTitle">Section Title</label>
              <input
                type="text"
                id="aboutSectionTitle"
                name="aboutSectionTitle"
                value="<%= pageContent.aboutSectionTitle %>"
                maxlength="50"
                oninput="updateCharCount(this, 'aboutSectionTitleCount', 50)"
              >
              <div class="char-count" id="aboutSectionTitleCount"></div>
              <p class="form-hint">Title that appears above the about section</p>
            </div>

            <div class="form-group">
              <label for="aboutSectionSubtitle">Section Subtitle</label>
              <input
                type="text"
                id="aboutSectionSubtitle"
                name="aboutSectionSubtitle"
                value="<%= pageContent.aboutSectionSubtitle %>"
                maxlength="100"
                oninput="updateCharCount(this, 'aboutSectionSubtitleCount', 100)"
              >
              <div class="char-count" id="aboutSectionSubtitleCount"></div>
              <p class="form-hint">Subtitle that appears below the section title</p>
            </div>

            <div class="form-group">
              <label for="aboutMissionTitle">Mission Title</label>
              <input
                type="text"
                id="aboutMissionTitle"
                name="aboutMissionTitle"
                value="<%= pageContent.aboutMissionTitle %>"
                maxlength="50"
                oninput="updateCharCount(this, 'aboutMissionTitleCount', 50)"
              >
              <div class="char-count" id="aboutMissionTitleCount"></div>
              <p class="form-hint">Title for the mission section (e.g., "Our Mission")</p>
            </div>

            <div class="form-group">
              <label for="aboutMission">Mission Statement</label>
              <textarea
                id="aboutMission"
                name="aboutMission"
                class="tall"
                maxlength="600"
                oninput="updateCharCount(this, 'aboutMissionCount', 600)"
              ><%= pageContent.aboutMission %></textarea>
              <div class="char-count" id="aboutMissionCount"></div>
            </div>

            <div class="form-group">
              <label for="aboutVisionTitle">Vision Title</label>
              <input
                type="text"
                id="aboutVisionTitle"
                name="aboutVisionTitle"
                value="<%= pageContent.aboutVisionTitle %>"
                maxlength="50"
                oninput="updateCharCount(this, 'aboutVisionTitleCount', 50)"
              >
              <div class="char-count" id="aboutVisionTitleCount"></div>
              <p class="form-hint">Title for the vision section (e.g., "Our Vision")</p>
            </div>

            <div class="form-group">
              <label for="aboutVision">Vision Statement</label>
              <textarea
                id="aboutVision"
                name="aboutVision"
                class="tall"
                maxlength="600"
                oninput="updateCharCount(this, 'aboutVisionCount', 600)"
              ><%= pageContent.aboutVision %></textarea>
              <div class="char-count" id="aboutVisionCount"></div>
            </div>

            <div class="dynamic-items-section">
              <div class="dynamic-items-header">
                <h3>About Features</h3>
                <button type="button" class="btn-add-item" onclick="addAboutFeature()">
                  <span>+</span> Add Feature
                </button>
              </div>
              <div id="aboutFeaturesContainer" class="dynamic-items-container">
                <% 
                const aboutFeatures = pageContent.aboutFeatures || [];
                aboutFeatures.forEach((feature, index) => { %>
                <div class="dynamic-item" data-index="<%= index %>">
                  <div class="item-header">
                    <span class="item-number">Feature <%= index + 1 %></span>
                    <button type="button" class="btn-remove-item" onclick="removeAboutFeature(this)">
                      <span>×</span>
                    </button>
                  </div>
                  <div class="item-content">
                    <div class="form-group">
                      <label>Icon</label>
                      <input
                        type="text"
                        name="featureIcon[]"
                        value="<%= feature.icon %>"
                        maxlength="10"
                        placeholder="📱"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>Title</label>
                      <input
                        type="text"
                        name="featureTitle[]"
                        value="<%= feature.title %>"
                        maxlength="50"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>Description</label>
                      <textarea
                        name="featureDescription[]"
                        maxlength="200"
                        required
                      ><%= feature.description %></textarea>
                    </div>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- Services Section -->
          <div class="config-section">
            <h2 class="section-title">
              <span class="section-icon">💼</span>
              Services Section
            </h2>
            <p class="section-description">
              Section title, subtitle, and the services offered by the Strategic Communications Office. You can add, remove, or edit services dynamically.
            </p>

            <div class="form-group">
              <label for="servicesSectionTitle">Section Title</label>
              <input
                type="text"
                id="servicesSectionTitle"
                name="servicesSectionTitle"
                value="<%= pageContent.servicesSectionTitle %>"
                maxlength="50"
                oninput="updateCharCount(this, 'servicesSectionTitleCount', 50)"
              >
              <div class="char-count" id="servicesSectionTitleCount"></div>
              <p class="form-hint">Title that appears above the services section</p>
            </div>

            <div class="form-group">
              <label for="servicesSectionSubtitle">Section Subtitle</label>
              <input
                type="text"
                id="servicesSectionSubtitle"
                name="servicesSectionSubtitle"
                value="<%= pageContent.servicesSectionSubtitle %>"
                maxlength="100"
                oninput="updateCharCount(this, 'servicesSectionSubtitleCount', 100)"
              >
              <div class="char-count" id="servicesSectionSubtitleCount"></div>
              <p class="form-hint">Subtitle that appears below the section title</p>
            </div>

            <div class="dynamic-items-section">
              <div class="dynamic-items-header">
                <h3>Services</h3>
                <button type="button" class="btn-add-item" onclick="addServiceItem()">
                  <span>+</span> Add Service
                </button>
              </div>
              <div id="servicesContainer" class="dynamic-items-container">
                <% 
                const services = pageContent.services || [];
                services.forEach((service, index) => { %>
                <div class="dynamic-item" data-index="<%= index %>">
                  <div class="item-header">
                    <span class="item-number">Service <%= index + 1 %></span>
                    <button type="button" class="btn-remove-item" onclick="removeServiceItem(this)">
                      <span>×</span>
                    </button>
                  </div>
                  <div class="item-content">
                    <div class="form-group">
                      <label>Title</label>
                      <input
                        type="text"
                        name="serviceTitle[]"
                        value="<%= service.title %>"
                        maxlength="100"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>Description</label>
                      <textarea
                        name="serviceDescription[]"
                        class="tall"
                        maxlength="500"
                        required
                      ><%= service.description %></textarea>
                    </div>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- Team Section -->
          <div class="config-section">
            <h2 class="section-title">
              <span class="section-icon">👥</span>
              Team Section
            </h2>
            <p class="section-description">
              Section title, subtitle, and team members. You can add, remove, or edit team members dynamically.
            </p>

            <div class="form-group">
              <label for="teamSectionTitle">Section Title</label>
              <input
                type="text"
                id="teamSectionTitle"
                name="teamSectionTitle"
                value="<%= pageContent.teamSectionTitle %>"
                maxlength="50"
                oninput="updateCharCount(this, 'teamSectionTitleCount', 50)"
              >
              <div class="char-count" id="teamSectionTitleCount"></div>
              <p class="form-hint">Title that appears above the team section</p>
            </div>

            <div class="form-group">
              <label for="teamSectionSubtitle">Section Subtitle</label>
              <input
                type="text"
                id="teamSectionSubtitle"
                name="teamSectionSubtitle"
                value="<%= pageContent.teamSectionSubtitle %>"
                maxlength="100"
                oninput="updateCharCount(this, 'teamSectionSubtitleCount', 100)"
              >
              <div class="char-count" id="teamSectionSubtitleCount"></div>
              <p class="form-hint">Subtitle that appears below the section title</p>
            </div>

            <div class="dynamic-items-section">
              <div class="dynamic-items-header">
                <h3>Team Members</h3>
                <button type="button" class="btn-add-item" onclick="addTeamMember()">
                  <span>+</span> Add Team Member
                </button>
              </div>
              <div id="teamMembersContainer" class="dynamic-items-container">
                <% 
                const teamMembers = pageContent.teamMembers || [];
                teamMembers.forEach((member, index) => { %>
                <div class="dynamic-item" data-index="<%= index %>">
                  <div class="item-header">
                    <span class="item-number">Team Member <%= index + 1 %></span>
                    <button type="button" class="btn-remove-item" onclick="removeTeamMember(this)">
                      <span>×</span>
                    </button>
                  </div>
                  <div class="item-content">
                    <div class="form-group">
                      <label>Name</label>
                      <input
                        type="text"
                        name="teamName[]"
                        value="<%= member.name %>"
                        maxlength="100"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>Role</label>
                      <input
                        type="text"
                        name="teamRole[]"
                        value="<%= member.role %>"
                        maxlength="100"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>Email</label>
                      <input
                        type="email"
                        name="teamEmail[]"
                        value="<%= member.email %>"
                        required
                      >
                    </div>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- Contact Section -->
          <div class="config-section">
            <h2 class="section-title">
              <span class="section-icon">📞</span>
              Contact Section
            </h2>
            <p class="section-description">
              Section title, intro text, contact cards with emojis and descriptions, and contact information.
            </p>

            <div class="form-group">
              <label for="contactSectionTitle">Section Title</label>
              <input
                type="text"
                id="contactSectionTitle"
                name="contactSectionTitle"
                value="<%= pageContent.contactSectionTitle %>"
                maxlength="50"
                oninput="updateCharCount(this, 'contactSectionTitleCount', 50)"
              >
              <div class="char-count" id="contactSectionTitleCount"></div>
              <p class="form-hint">Title that appears above the contact section</p>
            </div>

            <div class="form-group">
              <label for="contactIntroText">Introductory Text</label>
              <textarea
                id="contactIntroText"
                name="contactIntroText"
                maxlength="200"
                oninput="updateCharCount(this, 'contactIntroTextCount', 200)"
              ><%= pageContent.contactIntroText %></textarea>
              <div class="char-count" id="contactIntroTextCount"></div>
              <p class="form-hint">Text that appears below the section title</p>
            </div>

            <div class="dynamic-items-section">
              <div class="dynamic-items-header">
                <h3>Contact Cards</h3>
                <button type="button" class="btn-add-item" onclick="addContactCard()">
                  <span>+</span> Add Contact Card
                </button>
              </div>
              <div id="contactCardsContainer" class="dynamic-items-container">
                <% 
                const contactCards = pageContent.contactCards || [];
                contactCards.forEach((card, index) => { %>
                <div class="dynamic-item" data-index="<%= index %>">
                  <div class="item-header">
                    <span class="item-number">Contact Card <%= index + 1 %></span>
                    <button type="button" class="btn-remove-item" onclick="removeContactCard(this)">
                      <span>×</span>
                    </button>
                  </div>
                  <div class="item-content">
                    <div class="form-group">
                      <label>Icon (Emoji)</label>
                      <input
                        type="text"
                        name="contactIcon[]"
                        value="<%= card.icon %>"
                        maxlength="10"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>Title</label>
                      <input
                        type="text"
                        name="contactTitle[]"
                        value="<%= card.title %>"
                        maxlength="50"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>Description</label>
                      <textarea
                        name="contactDescription[]"
                        maxlength="150"
                        required
                      ><%= card.description %></textarea>
                    </div>
                    <div class="form-group">
                      <label>Contact Information</label>
                      <textarea
                        name="contactInfo[]"
                        maxlength="500"
                        required
                      ><%= card.contactInfo %></textarea>
                    </div>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- Social Media Section -->
          <div class="config-section">
            <h2 class="section-title">
              <span class="section-icon">🌐</span>
              Social Media Section
            </h2>
            <p class="section-description">
              Section title and social media profiles where visitors can connect with the office and university.
            </p>

            <div class="form-group">
              <label for="socialSectionTitle">Section Title</label>
              <input
                type="text"
                id="socialSectionTitle"
                name="socialSectionTitle"
                value="<%= pageContent.socialSectionTitle %>"
                maxlength="50"
                oninput="updateCharCount(this, 'socialSectionTitleCount', 50)"
              >
              <div class="char-count" id="socialSectionTitleCount"></div>
              <p class="form-hint">Title that appears above the social media section</p>
            </div>

            <div class="form-group">
              <label>Social Media Links</label>
              <p class="form-hint">Add social media platforms with custom icons and links</p>
              <div class="dynamic-items-header">
                <button type="button" class="btn-add-item" onclick="addSocialMedia()">
                  <span>+</span> Add Social Media Link
                </button>
              </div>
              <div id="socialMediaContainer" class="dynamic-items-container">
                <%
                const socialMedia = pageContent.socialMedia || [];
                socialMedia.forEach((social, index) => { %>
                <div class="dynamic-item" data-index="<%= index %>">
                  <div class="item-header">
                    <span class="item-number">Social Media <%= index + 1 %></span>
                    <button type="button" class="btn-remove-item" onclick="removeSocialMedia(this)">
                      <span>×</span>
                    </button>
                  </div>
                  <div class="item-content">
                    <div class="form-group">
                      <label>Icon (Emoji/Symbol)</label>
                      <input
                        type="text"
                        name="socialIcon[]"
                        value="<%= social.icon %>"
                        maxlength="10"
                        placeholder="e.g., f, ▶, 📷, 🐦"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>Title</label>
                      <input
                        type="text"
                        name="socialTitle[]"
                        value="<%= social.title %>"
                        maxlength="50"
                        placeholder="e.g., Facebook, YouTube"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>URL</label>
                      <input
                        type="url"
                        name="socialUrl[]"
                        value="<%= social.url %>"
                        placeholder="https://..."
                        required
                      >
                    </div>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- Footer Section -->
          <div class="config-section">
            <h2 class="section-title">
              <span class="section-icon">📄</span>
              Footer Section
            </h2>
            <p class="section-description">
              Footer content including copyright text and links.
            </p>

            <div class="form-group">
              <label for="footerTagline">Footer Tagline</label>
              <input
                type="text"
                id="footerTagline"
                name="footerTagline"
                value="<%= pageContent.footerTagline %>"
                maxlength="150"
                oninput="updateCharCount(this, 'footerTaglineCount', 150)"
              >
              <div class="char-count" id="footerTaglineCount"></div>
              <p class="form-hint">Inspirational tagline or motto displayed at the top of the footer</p>
            </div>

            <div class="form-group">
              <label for="footerText">Footer Text</label>
              <input
                type="text"
                id="footerText"
                name="footerText"
                value="<%= pageContent.footerText %>"
                maxlength="100"
                oninput="updateCharCount(this, 'footerTextCount', 100)"
              >
              <div class="char-count" id="footerTextCount"></div>
              <p class="form-hint">Office name and institution information</p>
            </div>

            <div class="form-group">
              <label>Footer Links</label>
              <p class="form-hint">Add navigation links that appear in the footer</p>
              <div class="dynamic-items-header">
                <button type="button" class="btn-add-item" onclick="addFooterLink()">
                  <span>+</span> Add Footer Link
                </button>
              </div>
              <div id="footerLinksContainer" class="dynamic-items-container">
                <%
                const footerLinks = pageContent.footerLinks || [];
                footerLinks.forEach((link, index) => { %>
                <div class="dynamic-item" data-index="<%= index %>">
                  <div class="item-header">
                    <span class="item-number">Footer Link <%= index + 1 %></span>
                    <button type="button" class="btn-remove-item" onclick="removeFooterLink(this)">
                      <span>×</span>
                    </button>
                  </div>
                  <div class="item-content">
                    <div class="form-group">
                      <label>Link Text</label>
                      <input
                        type="text"
                        name="footerLinkText[]"
                        value="<%= link.text %>"
                        maxlength="50"
                        placeholder="e.g., Privacy Policy, Contact Us"
                        required
                      >
                    </div>
                    <div class="form-group">
                      <label>Link URL</label>
                      <input
                        type="text"
                        name="footerLinkUrl[]"
                        value="<%= link.url %>"
                        placeholder="https://example.com or #section"
                        required
                      >
                    </div>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </div>

        </div>
      </form>
      </div> <!-- End homepage-tab -->

      <!-- System Configuration Tab -->
      <div id="system-tab" class="tab-content active">
        <!-- Header -->
        <div class="config-header">
          <h1>System Configuration</h1>
          <div class="config-header-actions">
            <button type="submit" form="systemConfigForm" class="btn-save">
              💾 Save Changes
            </button>
            <button type="button" class="btn-reset" onclick="resetSystemForm()">
              🔄 Reset Form
            </button>
          </div>
        </div>

        <!-- Info Banner -->
        <div style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); border-left: 4px solid #3b82f6; padding: 1rem 1.5rem; border-radius: 0.5rem; margin-bottom: 2rem;">
          <p style="margin: 0; color: #1e40af; font-weight: 500;">
            <strong>ℹ️ System Configuration:</strong> All settings configured here are stored in the database and dynamically control the system behavior. Changes take effect immediately after saving.
          </p>
        </div>

        <!-- System Configuration Form -->
        <form id="systemConfigForm" method="POST" action="/admin/system-configuration">
          <div class="config-sections">

            <!-- Organizations Section -->
            <div class="config-section">
              <h2 class="section-title">
                <span class="section-icon">🏢</span>
                Organizations
              </h2>
              <p class="section-description">
                Manage the list of student organizations that users can select from.
              </p>
              <div class="form-group">
                <label for="organizationsList">Student Organizations (one per line)</label>
                <textarea
                  id="organizationsList"
                  name="organizationsList"
                  class="tall"
                  placeholder="University Student Government (USG)&#10;College of Business Administration and Accountancy Student Government (CBAASG)&#10;etc."
                  rows="10"
                ><%= (settings && settings.organizations && settings.organizations.length > 0) ? (Array.isArray(settings.organizations) ? settings.organizations.map(org => typeof org === 'string' ? org : org.name).join('\n') : '') : '' %></textarea>
                <p class="form-hint">Enter each organization on a new line</p>
              </div>
            </div>

            <!-- Offices/Departments Section -->
            <div class="config-section">
              <h2 class="section-title">
                <span class="section-icon">🏛️</span>
                Offices/Departments
              </h2>
              <p class="section-description">
                Manage the list of offices and departments for non-student users.
              </p>
              <div class="form-group">
                <label for="officesList">Offices/Departments (one per line)</label>
                <textarea
                  id="officesList"
                  name="officesList"
                  class="tall"
                  placeholder="Academic Affairs&#10;Student Services&#10;Administration&#10;etc."
                  rows="10"
                ><%= (settings && settings.offices && settings.offices.length > 0) ? settings.offices.join('\n') : '' %></textarea>
                <p class="form-hint">Enter each office/department on a new line</p>
              </div>
            </div>

            <!-- Units and Request Types Management Section -->
            <div class="config-section">
              <h2 class="section-title">
                <span class="section-icon">🔗</span>
                Units & Request Types Management
              </h2>
              <p class="section-description">
                Manage units and their associated request types. Each unit can handle multiple types of requests.
              </p>
              <div class="dynamic-items-section">
                <div class="dynamic-items-header">
                  <h3>Units</h3>
                  <button type="button" class="btn-add-item" onclick="addUnitWithRequestTypes()">
                    <span>+</span> Add Unit
                  </button>
                </div>
                <div id="unitsWithRequestTypesContainer" class="dynamic-items-container">
                  <% 
                  // Get existing units and mappings from database
                  const existingUnits = (settings && settings.units) || [];
                  const mappings = (settings && settings.requestTypeMappings) || [];
                  
                  // Group request types by unit
                  const unitRequestTypes = {};
                  existingUnits.forEach(unit => {
                    const unitName = typeof unit === 'string' ? unit : unit.name || unit;
                    unitRequestTypes[unitName] = [];
                  });
                  
                  mappings.forEach(mapping => {
                    const unit = mapping.recommendedUnit;
                    if (!unitRequestTypes[unit]) {
                      unitRequestTypes[unit] = [];
                    }
                    unitRequestTypes[unit].push(mapping.requestType);
                  });
                  
                  Object.keys(unitRequestTypes).forEach((unitName, index) => { %>
                  <div class="dynamic-item unit-request-item" data-index="<%= index %>">
                    <div class="item-header">
                      <span class="item-number">Unit <%= index + 1 %>: <strong><%= unitName %></strong></span>
                      <button type="button" class="btn-remove-item" onclick="removeUnitWithRequestTypes(this)">
                        <span>×</span>
                      </button>
                    </div>
                    <div class="item-content">
                      <div class="form-group">
                        <label>Unit Name</label>
                        <input
                          type="text"
                          name="unitName[]"
                          value="<%= unitName %>"
                          maxlength="100"
                          required
                          onchange="updateUnitLabel(this)"
                        >
                      </div>
                      <div class="form-group">
                        <label>Request Types for this Unit (one per line)</label>
                        <textarea
                          name="unitRequestTypes[]"
                          class="tall"
                          placeholder="Enter request types that this unit handles (one per line)"
                          rows="8"
                        ><%= unitRequestTypes[unitName].join('\n') %></textarea>
                        <p class="form-hint">Enter each request type on a new line</p>
                      </div>
                    </div>
                  </div>
                  <% }); %>
                </div>
              </div>
            </div>

            <!-- Request Statuses Section -->
            <div class="config-section">
              <h2 class="section-title">
                <span class="section-icon">📊</span>
                Request Statuses
              </h2>
              <p class="section-description">
                Manage the possible statuses for service requests.
              </p>
              <div class="form-group">
                <label for="requestStatuses">Request Statuses (one per line)</label>
                <textarea
                  id="requestStatuses"
                  name="requestStatuses"
                  class="tall"
                  placeholder="Pending&#10;Queued&#10;In Progress&#10;etc."
                  rows="8"
                ><%= (settings && settings.requestStatuses && settings.requestStatuses.length > 0) ? settings.requestStatuses.join('\n') : '' %></textarea>
                <p class="form-hint">Enter each status on a new line</p>
              </div>
            </div>

            <!-- User Roles Section -->
            <div class="config-section">
              <h2 class="section-title">
                <span class="section-icon">👤</span>
                User Roles & Permissions
              </h2>
              <p class="section-description">
                Manage user roles and configure their access permissions.
              </p>
              <div class="dynamic-items-section">
                <div class="dynamic-items-header">
                  <h3>User Roles</h3>
                  <button type="button" class="btn-add-item" onclick="addUserRole()">
                    <span>+</span> Add Role
                  </button>
                </div>
                <div id="userRolesContainer" class="dynamic-items-container">
                  <% 
                  // Get user roles from database only
                  const userRoles = (settings && settings.userRoles) || [];
                  
                  userRoles.forEach((role, index) => { 
                    const roleName = typeof role === 'string' ? role : role.name;
                    const rolePerms = typeof role === 'string' ? [] : (role.permissions || []);
                  %>
                  <div class="dynamic-item" data-index="<%= index %>">
                    <div class="item-header">
                      <span class="item-number">Role <%= index + 1 %>: <strong><%= roleName %></strong></span>
                      <button type="button" class="btn-remove-item" onclick="removeUserRole(this)">
                        <span>×</span>
                      </button>
                    </div>
                    <div class="item-content">
                      <div class="form-group">
                        <label>Role Name</label>
                        <input
                          type="text"
                          name="roleName[]"
                          value="<%= roleName %>"
                          maxlength="50"
                          required
                          onchange="updateRoleLabel(this)"
                        >
                      </div>
                      <div class="form-group">
                        <label>Access Level</label>
                        <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 0.5rem;">
                          <label style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 0.5rem; cursor: pointer; transition: all 0.2s;" class="role-option">
                            <input type="radio" name="roleAccessLevel_<%= index %>" value="user" <%= rolePerms.includes('user') || (!rolePerms.includes('unit') && !rolePerms.includes('admin')) ? 'checked' : '' %> style="margin-top: 0.25rem; cursor: pointer;">
                            <div style="flex: 1;">
                              <div style="font-weight: 600; color: #1f2937; margin-bottom: 0.25rem;">
                                <svg width="14" height="14" fill="none" stroke="#3b82f6" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; margin-right: 0.25rem; vertical-align: text-bottom;">
                                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                  <circle cx="12" cy="7" r="4"/>
                                </svg>
                                Requestor (User) - Submits Requests
                              </div>
                              <div style="font-size: 0.875rem; color: #6b7280;">Can create and view their own requests</div>
                            </div>
                          </label>
                          
                          <label style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 0.5rem; cursor: pointer; transition: all 0.2s;" class="role-option">
                            <input type="radio" name="roleAccessLevel_<%= index %>" value="unit" <%= rolePerms.includes('unit') ? 'checked' : '' %> style="margin-top: 0.25rem; cursor: pointer;">
                            <div style="flex: 1;">
                              <div style="font-weight: 600; color: #1f2937; margin-bottom: 0.25rem;">
                                <svg width="14" height="14" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; margin-right: 0.25rem; vertical-align: text-bottom;">
                                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                  <circle cx="9" cy="7" r="4"></circle>
                                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                                Unit Member - Works on Tasks
                              </div>
                              <div style="font-size: 0.875rem; color: #6b7280;">Can view all requests, work on assigned tasks, and upload deliverables</div>
                            </div>
                          </label>
                          
                          <label style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 0.5rem; cursor: pointer; transition: all 0.2s;" class="role-option">
                            <input type="radio" name="roleAccessLevel_<%= index %>" value="admin" <%= rolePerms.includes('admin') ? 'checked' : '' %> style="margin-top: 0.25rem; cursor: pointer;">
                            <div style="flex: 1;">
                              <div style="font-weight: 600; color: #1f2937; margin-bottom: 0.25rem;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b" style="display: inline-block; margin-right: 0.25rem; vertical-align: text-bottom;">
                                  <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                                </svg>
                                Administrator - Full System Access
                              </div>
                              <div style="font-size: 0.875rem; color: #6b7280;">Complete administrative access to all system features</div>
                            </div>
                          </label>
                        </div>
                      </div>
                    </div>
                  </div>
                  <% }); %>
                </div>
              </div>
            </div>

            <!-- Announcement Priority Levels Section -->
            <div class="config-section">
              <h2 class="section-title">
                <span class="section-icon">🎯</span>
                Announcement Priority Levels
              </h2>
              <p class="section-description">
                Manage the priority levels for announcements (e.g., low, medium, high, urgent).
              </p>
              <div class="form-group">
                <label for="announcementPriorities">Priority Levels (one per line)</label>
                <textarea
                  id="announcementPriorities"
                  name="announcementPriorities"
                  class="tall"
                  placeholder="low&#10;medium&#10;high&#10;urgent"
                  rows="5"
                ><%= (settings && settings.announcementPriorities && settings.announcementPriorities.length > 0) ? settings.announcementPriorities.join('\n') : '' %></textarea>
                <p class="form-hint">Enter each priority level on a new line</p>
              </div>
            </div>

            <!-- Announcement Types Section -->
            <div class="config-section">
              <h2 class="section-title">
                <span class="section-icon">📢</span>
                Announcement Types
              </h2>
              <p class="section-description">
                Manage the types/categories of announcements (e.g., Event, News, Reminder, Update).
              </p>
              <div class="form-group">
                <label for="announcementTypes">Announcement Types (one per line)</label>
                <textarea
                  id="announcementTypes"
                  name="announcementTypes"
                  class="tall"
                  placeholder="Event&#10;News&#10;Reminder&#10;Update&#10;Maintenance"
                  rows="6"
                ><%= (settings && settings.announcementTypes && settings.announcementTypes.length > 0) ? settings.announcementTypes.join('\n') : '' %></textarea>
                <p class="form-hint">Enter each announcement type on a new line</p>
              </div>
            </div>

            <!-- General Settings Section -->
            <div class="config-section">
              <h2 class="section-title">
                <span class="section-icon">⚙️</span>
                General Settings
              </h2>
              <p class="section-description">
                Configure basic system settings and branding.
              </p>
              <div class="form-group">
                <label for="siteTitle">Site Title</label>
                <input
                  type="text"
                  id="siteTitle"
                  name="siteTitle"
                  value="<%= settings.siteTitle || 'S-CORE - Student Communications Office Request & Engagement System' %>"
                  maxlength="200"
                >
              </div>
              <div class="form-group">
                <label for="siteDescription">Site Description</label>
                <textarea
                  id="siteDescription"
                  name="siteDescription"
                  maxlength="500"
                  rows="3"
                ><%= settings.siteDescription || 'A comprehensive request management portal for DLSU-D Student Communications Office' %></textarea>
              </div>
              <div class="form-group">
                <label for="timezone">Timezone</label>
                <select id="timezone" name="timezone">
                  <option value="Asia/Manila" <%= settings.timezone === 'Asia/Manila' ? 'selected' : '' %>>Asia/Manila</option>
                  <option value="UTC" <%= settings.timezone === 'UTC' ? 'selected' : '' %>>UTC</option>
                  <option value="America/New_York" <%= settings.timezone === 'America/New_York' ? 'selected' : '' %>>America/New York</option>
                  <option value="Europe/London" <%= settings.timezone === 'Europe/London' ? 'selected' : '' %>>Europe/London</option>
                </select>
              </div>
              <div class="form-group">
                <label for="dateFormat">Date Format</label>
                <select id="dateFormat" name="dateFormat">
                  <option value="MM/DD/YYYY" <%= settings.dateFormat === 'MM/DD/YYYY' ? 'selected' : '' %>>MM/DD/YYYY</option>
                  <option value="DD/MM/YYYY" <%= settings.dateFormat === 'DD/MM/YYYY' ? 'selected' : '' %>>DD/MM/YYYY</option>
                  <option value="YYYY-MM-DD" <%= settings.dateFormat === 'YYYY-MM-DD' ? 'selected' : '' %>>YYYY-MM-DD</option>
                </select>
              </div>
              <div class="form-group">
                <label for="logo">Logo URL (optional)</label>
                <input
                  type="text"
                  id="logo"
                  name="logo"
                  value="<%= settings.logo || '' %>"
                  placeholder="https://example.com/logo.png"
                >
              </div>
              <div class="form-group">
                <label for="favicon">Favicon URL (optional)</label>
                <input
                  type="text"
                  id="favicon"
                  name="favicon"
                  value="<%= settings.favicon || '' %>"
                  placeholder="https://example.com/favicon.ico"
                >
              </div>
            </div>

            <!-- Request Management Settings Section -->
            <div class="config-section">
              <h2 class="section-title">
                <span class="section-icon">📋</span>
                Request Management Settings
              </h2>
              <p class="section-description">
                Configure how requests are handled and processed. These settings control revision limits, default deadlines, and workflow automation.
              </p>
              <div class="form-group">
                <label for="maxRevisions">Maximum Major Revisions</label>
                <input
                  type="number"
                  id="maxRevisions"
                  name="maxRevisions"
                  value="<%= settings.maxRevisions || 3 %>"
                  min="1"
                  max="10"
                >
                <p class="form-hint">Maximum number of major revisions allowed per request</p>
              </div>
              <div class="form-group">
                <label for="maxMinorRevisions">Maximum Minor Revisions</label>
                <input
                  type="number"
                  id="maxMinorRevisions"
                  name="maxMinorRevisions"
                  value="<%= settings.maxMinorRevisions || 2 %>"
                  min="1"
                  max="10"
                >
                <p class="form-hint">Maximum number of minor revisions allowed per request</p>
              </div>
              <div class="form-group">
                <label for="defaultDeadlineDays">Default Deadline (Days)</label>
                <input
                  type="number"
                  id="defaultDeadlineDays"
                  name="defaultDeadlineDays"
                  value="<%= settings.defaultDeadlineDays || 7 %>"
                  min="1"
                  max="365"
                >
                <p class="form-hint">Default number of days for request deadlines</p>
              </div>
              <div class="form-group">
                <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 400;">
                  <input
                    type="checkbox"
                    id="autoApproveAfterRevisions"
                    name="autoApproveAfterRevisions"
                    <%= settings.autoApproveAfterRevisions ? 'checked' : '' %>
                  >
                  Auto-approve requests after all revisions
                </label>
              </div>
              <div class="form-group">
                <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 400;">
                  <input
                    type="checkbox"
                    id="requireUnitReview"
                    name="requireUnitReview"
