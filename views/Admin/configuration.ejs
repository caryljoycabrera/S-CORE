      toggle() {
        this.isOpen ? this.close() : this.open();
      },
      
      open() {
        if (!this.menu) return;
        this.menu.style.display = "block";
        this.isOpen = true;
      },
      
      close() {
        if (!this.menu) return;
        this.menu.style.display = "none";
        this.isOpen = false;
      }
