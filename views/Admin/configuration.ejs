    // Close preview when clicking outside
    document.getElementById('previewModal')?.addEventListener('click', (e) => {
      if (e.target.id === 'previewModal') {
        closePreview();
      }
    });

    // Close reset confirmation when clicking outside
    document.getElementById('resetConfirmModal')?.addEventListener('click', (e) => {
      if (e.target.id === 'resetConfirmModal') {
        closeResetConfirm();
      }
    });

    // Close save confirmation when clicking outside
    document.getElementById('saveConfirmModal')?.addEventListener('click', (e) => {
      if (e.target.id === 'saveConfirmModal') {
        closeSaveConfirm();
      }
    });

    // Reset form
    function resetForm() {
      const modal = document.getElementById('resetConfirmModal');
      modal.classList.add('active');
    }

    function closeResetConfirm() {
      const modal = document.getElementById('resetConfirmModal');
      modal.classList.remove('active');
    }

    function confirmReset() {
      closeResetConfirm();
      location.reload();
    }

    function closeSaveConfirm() {
      const modal = document.getElementById('saveConfirmModal');
      modal.classList.remove('active');
    }

    function confirmSave() {
      closeSaveConfirm();
      // Submit the form
      document.getElementById('configForm').submit();
    }

    // Form submission validation
    document.getElementById('configForm').addEventListener('submit', (e) => {
      e.preventDefault(); // Always prevent default submission
      
      const requiredFields = ['heroTitle', 'heroSubtitle'];
      let isValid = true;

      requiredFields.forEach(fieldId => {
        const field = document.getElementById(fieldId);
        if (!field.value.trim()) {
          isValid = false;
          field.style.borderColor = '#ef4444';
        } else {
          field.style.borderColor = '#e5e7eb';
        }
      });

      if (!isValid) {
        alert('Please fill in all required fields before saving.');
        return false;
      }

      // Show confirmation modal instead of browser confirm
      const modal = document.getElementById('saveConfirmModal');
      modal.classList.add('active');
    });

