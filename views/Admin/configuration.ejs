                  <input type="radio" name="roleAccessLevel_${itemCount}" value="user" checked style="margin-top: 0.25rem; cursor: pointer;">
                  <div style="flex: 1;">
                    <div style="font-weight: 600; color: #1f2937; margin-bottom: 0.25rem;">
                      <svg width="14" height="14" fill="none" stroke="#3b82f6" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; margin-right: 0.25rem; vertical-align: text-bottom;">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                      </svg>
                      Requestor (User) - Submits Requests
                    </div>
                    <div style="font-size: 0.875rem; color: #6b7280;">Can create and view their own requests</div>
                  </div>
                </label>
                
                <label style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 0.5rem; cursor: pointer; transition: all 0.2s;" class="role-option">
                  <input type="radio" name="roleAccessLevel_${itemCount}" value="unit" style="margin-top: 0.25rem; cursor: pointer;">
                  <div style="flex: 1;">
                    <div style="font-weight: 600; color: #1f2937; margin-bottom: 0.25rem;">
                      <svg width="14" height="14" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; margin-right: 0.25rem; vertical-align: text-bottom;">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                      </svg>
                      Unit Member - Works on Tasks
                    </div>
                    <div style="font-size: 0.875rem; color: #6b7280;">Can view all requests, work on assigned tasks, and upload deliverables</div>
                  </div>
                </label>
                
                <label style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 0.5rem; cursor: pointer; transition: all 0.2s;" class="role-option">
                  <input type="radio" name="roleAccessLevel_${itemCount}" value="admin" style="margin-top: 0.25rem; cursor: pointer;">
                  <div style="flex: 1;">
                    <div style="font-weight: 600; color: #1f2937; margin-bottom: 0.25rem;">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b" style="display: inline-block; margin-right: 0.25rem; vertical-align: text-bottom;">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                      </svg>
                      Administrator - Full System Access
                    </div>
                    <div style="font-size: 0.875rem; color: #6b7280;">Complete administrative access to all system features</div>
                  </div>
                </label>
              </div>
            </div>
          </div>
        </div>
      `;
      
      container.insertAdjacentHTML('beforeend', itemHtml);
      updateRoleNumbers(container);
    }

    function removeUserRole(button) {
      const item = button.closest('.dynamic-item');
      const container = item.parentElement;
      item.remove();
      updateRoleNumbers(container);
    }

    function updateRoleLabel(input) {
      const item = input.closest('.dynamic-item');
      const label = item.querySelector('.item-number strong');
      if (label) {
        label.textContent = input.value || 'New Role';
      }
    }

    function updateRoleNumbers(container) {
      const items = container.querySelectorAll('.dynamic-item');
      items.forEach((item, index) => {
        const numberSpan = item.querySelector('.item-number');
        const roleName = item.querySelector('input[name="roleName[]"]').value || 'New Role';
        numberSpan.innerHTML = `Role ${index + 1}: <strong>${roleName}</strong>`;
        item.setAttribute('data-index', index);
      });
    }

    function resetSystemForm() {
      if (confirm('Are you sure you want to reset the system configuration form? All unsaved changes will be lost.')) {
        document.getElementById('systemConfigForm').reset();
        // Reset dynamic containers
        document.getElementById('unitsWithRequestTypesContainer').innerHTML = '';
        document.getElementById('userRolesContainer').innerHTML = '';
      }
    }

    // System Config Form submission handling
    document.getElementById('systemConfigForm')?.addEventListener('submit', (e) => {
      // Allow default form submission
      const organizationsList = document.getElementById('organizationsList');
      const officesList = document.getElementById('officesList');
      
      // Basic validation
      if (organizationsList && !organizationsList.value.trim()) {
        e.preventDefault();
        alert('Please add at least one organization.');
        organizationsList.focus();
        return false;
      }

      // Form is valid, allow submission
      return true;
    });

    // Initialize tab on page load
    document.addEventListener('DOMContentLoaded', () => {
      // Check if there's a tab parameter in URL
      const urlParams = new URLSearchParams(window.location.search);
      const tab = urlParams.get('tab');
      const success = urlParams.get('success');
      const error = urlParams.get('error');
      
      // Show success or error messages
      if (success) {
        alert('✅ ' + success);
        // Clean URL
        window.history.replaceState({}, document.title, window.location.pathname);
      } else if (error) {
        alert('❌ ' + error);
        // Clean URL
        window.history.replaceState({}, document.title, window.location.pathname);
      }
      
      if (tab === 'homepage') {
        switchTab('homepage');
      } else {
        // Default to system tab
        switchTab('system');
      }
    });
  </script>
</body>
</html>
