                  window.resetArchiveDefaults = function() {
                    syncArchiveFields('archiveCompletedAfterDays', 30);
                    syncArchiveFields('archiveApprovedAfterDays', 30);
                    syncArchiveFields('archiveRevisionAfterDays', 14);

                    const msgDiv = document.getElementById('archivingResultMsg');
                    if (msgDiv) {
                      msgDiv.style.display = 'block';
                      msgDiv.style.background = '#e0f2fe';
                      msgDiv.style.color = '#0c4a6e';
                      msgDiv.style.border = '1px solid #7dd3fc';
                      msgDiv.innerHTML = 'Defaults restored (30 / 30 / 14 days). Click "Save Settings" to apply.';
                      setTimeout(() => { msgDiv.style.display = 'none'; }, 4000);
                    }
                  };

                  window.saveArchiveSettings = async function() {
                    const btn = document.getElementById('archiveSettingsSaveBtn');
                    const completedDays = parseInt(document.getElementById('archiveCompletedAfterDays2')?.value, 10);
                    const approvedDays  = parseInt(document.getElementById('archiveApprovedAfterDays2')?.value,  10);
                    const revisionDays  = parseInt(document.getElementById('archiveRevisionAfterDays2')?.value,  10);
                    const allowReactivation = document.getElementById('allowUserReactivation2')?.checked;
                    const completedEnabled = document.getElementById('archiveCompletedEnabled')?.checked;
                    const approvedEnabled  = document.getElementById('archiveApprovedEnabled')?.checked;
                    const revisionEnabled  = document.getElementById('archiveRevisionEnabled')?.checked;

                    if (isNaN(completedDays) || isNaN(approvedDays) || isNaN(revisionDays)) {
                      alert('Please enter valid numbers for all day fields.');
                      return;
                    }

                    if (btn) { btn.disabled = true; btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px;"><use href="#icon-clock"/></svg> Saving...'; }
                    try {
                      const res = await fetch('/admin/archive-settings', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({
                          archiveCompletedAfterDays: completedDays,
                          archiveApprovedAfterDays:  approvedDays,
                          archiveRevisionAfterDays:  revisionDays,
                          allowUserReactivation:     allowReactivation,
                          archiveCompletedEnabled:   completedEnabled,
                          archiveApprovedEnabled:    approvedEnabled,
                          archiveRevisionEnabled:    revisionEnabled
                        })
                      });
                      const data = await res.json();
                      if (data.success) {
                        if (btn) { btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px;"><use href="#icon-check-circle"/></svg> Saved!'; btn.style.background = 'linear-gradient(135deg,#059669,#047857)'; }
                        setTimeout(() => {
                          if (btn) { btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px;"><use href="#icon-save"/></svg> Save Settings'; btn.style.background = ''; btn.disabled = false; }
                        }, 2500);
                      } else {
                        throw new Error(data.message || 'Save failed');
                      }
                    } catch(e) {
                      if (btn) { btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px;"><use href="#icon-x-circle"/></svg> Error - try again'; btn.disabled = false; }
                      console.error('Archive settings save error:', e);
                      setTimeout(() => { if (btn) btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px;"><use href="#icon-save"/></svg> Save Settings'; }, 3000);
                    }
                  };

