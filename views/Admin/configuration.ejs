  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const stickyPreview = document.getElementById('stickyPreviewBtn');
      const stickySave = document.getElementById('stickySaveBtn');
      const stickyReset = document.getElementById('stickyResetBtn');

      const stickyBar = document.querySelector('.config-sticky-bar');

      function getActiveTab() {
        const activeTab = document.querySelector('.tab-content.active');
        if (!activeTab) return null;
        if (activeTab.id === 'homepage-tab') return 'homepage';
        if (activeTab.id === 'aboutscore-tab') return 'aboutscore';
        if (activeTab.id === 'system-tab') return 'system';
        if (activeTab.id === 'archivemanager-tab') return 'archivemanager';
        if (activeTab.id === 'chatbot-tab') return 'chatbot';
        return null;
      }

      function updateStickyBar() {
        const tab = getActiveTab();
        const show = (tab === 'homepage' || tab === 'aboutscore' || tab === 'system');
        if (stickyBar) stickyBar.style.display = show ? 'flex' : 'none';
        if (stickyPreview) stickyPreview.style.display = (tab === 'homepage' || tab === 'aboutscore') ? 'inline-flex' : 'none';
      }

      if (stickyPreview) {
        stickyPreview.addEventListener('click', function(e) {
          e.preventDefault();
          const tab = getActiveTab();
          const btn = document.getElementById(tab === 'aboutscore' ? 'aboutScorePreviewBtn' : 'previewBtn');
          if (btn) btn.click();
        });
      }

      if (stickySave) {
        stickySave.addEventListener('click', function(e) {
          e.preventDefault();
          const tab = getActiveTab();
          if (tab === 'homepage') {
            const btn = document.getElementById('saveBtn');
            if (btn) btn.click();
          } else if (tab === 'aboutscore') {
            const btn = document.getElementById('aboutScoreSaveBtn');
            if (btn) btn.click();
          } else if (tab === 'system') {
            const btn = document.getElementById('systemSaveBtn');
            if (btn) btn.click();
          }
        });
      }

      if (stickyReset) {
        stickyReset.addEventListener('click', function(e) {
          e.preventDefault();
          const tab = getActiveTab();
          if (tab === 'homepage') {
            const btn = document.getElementById('cancelBtn');
            if (btn) btn.click();
          } else if (tab === 'aboutscore') {
            const btn = document.getElementById('aboutScoreResetBtn');
            if (btn) btn.click();
          } else if (tab === 'system') {
            const btn = document.getElementById('systemResetBtn');
            if (btn) btn.click();
          }
        });
      }

      const origSwitch = window.switchTab;
      if (origSwitch) {
        window.switchTab = function(tabName) {
          origSwitch(tabName);
          setTimeout(updateStickyBar, 50);
        };
      }

      updateStickyBar();
    });
  </script>

