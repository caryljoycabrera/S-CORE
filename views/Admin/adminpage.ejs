  </div>

  <!-- MAIN CONTENT WITH HEADER -->
  <div class="admin-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="admin-menu-toggle" id="adminMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/admin" class="text-wrapper">S-CORE ADMIN</a>
      </div>
      
      <span class="text-wrapper-2">Welcome, Admin <%= name %>!</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user-placeholder.svg' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/admin/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

    <!-- DASHBOARD CONTENT -->
    <div class="dashboard-container">
      <!-- DASHBOARD HEADER WITH TITLE AND REPORTS BUTTON -->
      <div class="dashboard-header-section">
        <h1 class="dashboard-main-title">Admin Dashboard - Analytics & Performance Insights</h1>
        <a href="/admin/reports" class="generate-reports-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          Generate Reports
        </a>
      </div>

      <!-- ADMIN ACTION CARDS -->
      <div class="action-cards-container">
        <div class="action-card" onclick="location.href='/admin/all-requests'">
          <div class="card-icon-wrapper">
            <img src="/Picture/Stats.png" alt="All Requests" class="card-icon" />
            <div class="icon-glow"></div>
          </div>
          <h3 class="card-title">All Requests</h3>
          <p class="card-subtitle">Track all requests across the system</p>
          <div class="card-arrow">→</div>
        </div>

        <div class="action-card" onclick="location.href='/admin/approvals'">
          <div class="card-icon-wrapper">
            <img src="/Picture/File.png" alt="Request Approvals" class="card-icon" />
            <div class="icon-glow"></div>
          </div>
          <h3 class="card-title">Request Approvals</h3>
          <p class="card-subtitle">Manage approval requests</p>
          <div class="card-arrow">→</div>
        </div>

        <div class="action-card" onclick="location.href='/admin/services'">
          <div class="card-icon-wrapper">
            <img src="/Picture/Repair.png" alt="Service Requests" class="card-icon" />
            <div class="icon-glow"></div>
          </div>
          <h3 class="card-title">Service Requests</h3>
          <p class="card-subtitle">Manage service deliverables</p>
          <div class="card-arrow">→</div>
        </div>

        <div class="action-card" onclick="location.href='/admin/users'">
          <div class="card-icon-wrapper">
            <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 80px; height: 80px; filter: drop-shadow(0 4px 12px rgba(67, 160, 71, 0.3));">
              <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 00-3-3.87"></path>
              <path d="M16 3.13a4 4 0 010 7.75"></path>
            </svg>
            <div class="icon-glow"></div>
          </div>
          <h3 class="card-title">Users</h3>
          <p class="card-subtitle">Manage user accounts</p>
          <div class="card-arrow">→</div>
        </div>
      </div>

      <!-- CALENDAR SECTION -->
      <div class="calendar-standalone">
        <div class="calendar-header">
          <div style="display: flex; align-items: center;">
            <svg class="calendar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <h3 class="calendar-title">Calendar</h3>
          </div>
          <div class="calendar-controls">
            <button class="calendar-maximize-btn" id="calendar-maximize" aria-label="Maximize Calendar" title="Maximize Calendar">⛶</button>
            <div class="calendar-month-controls">
              <button class="calendar-nav-btn" id="calendar-prev-month" aria-label="Previous Month" title="Previous Month">❮</button>
              <span class="calendar-month-year" id="calendar-month-year"></span>
              <button class="calendar-nav-btn" id="calendar-next-month" aria-label="Next Month" title="Next Month">❯</button>
            </div>
          </div>
        </div>
        <div class="calendar-legend">
          <div class="legend-item">
            <div class="legend-dot approval"></div>
            <span class="legend-text">Approval Requests</span>
          </div>
          <div class="legend-item">
            <div class="legend-dot service"></div>
            <span class="legend-text">Service Requests</span>
          </div>
        </div>
        <div class="calendar-content">
          <div id="calendar-standalone" class="calendar-grid"></div>
        </div>
      </div>

      <!-- ESSENTIAL KPIs FOR ADMIN DASHBOARD -->
      <div class="analytics-section">
        <h2 class="section-header-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          Critical Metrics
        </h2>
        <p class="section-subtitle">Real-time system overview - requires immediate admin attention</p>
      
      <!-- KPI CARDS -->
      <div class="kpi-container auto-fit-grid-kpi">
        <!-- Pending Assignment -->
        <div class="kpi-card" data-kpi="pending-assignment">
          <div class="kpi-icon" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <div class="kpi-content">
            <div class="kpi-label">Pending Assignment</div>
            <div class="kpi-value" id="kpi-pending-assignment"><%= stats.pendingApprovals + stats.pendingServices %></div>
            <div class="kpi-subtext">New requests awaiting unit assignment</div>
          </div>
        </div>

        <!-- Awaiting Approval -->
        <div class="kpi-card" data-kpi="awaiting-approval">
          <div class="kpi-icon" style="background: linear-gradient(135deg, #3b82f6, #2563eb);">
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
              <polyline points="9 11 12 14 22 4"></polyline>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
          </div>
          <div class="kpi-content">
            <div class="kpi-label">Awaiting Approval</div>
            <div class="kpi-value" id="kpi-awaiting-approval"><%= stats.awaitingApproval || 0 %></div>
            <div class="kpi-subtext">Completed work awaiting final approval</div>
          </div>
        </div>

        <!-- In Revision -->
        <div class="kpi-card" data-kpi="in-revision">
          <div class="kpi-icon" style="background: linear-gradient(135deg, #ef4444, #dc2626);">
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
              <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <div class="kpi-content">
            <div class="kpi-label">In Revision</div>
            <div class="kpi-value" id="kpi-in-revision"><%= stats.inRevision || 0 %></div>
            <div class="kpi-subtext">Sent back for changes</div>
          </div>
        </div>

        <!-- Total Pending Requests -->
        <div class="kpi-card" data-kpi="urgent-unassigned">
          <div class="kpi-icon" style="background: linear-gradient(135deg, #dc2626, #b91c1c);">
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <div class="kpi-content">
            <div class="kpi-label">Unassigned Tasks</div>
            <div class="kpi-value" id="kpi-urgent-unassigned">
              <span style="color: #dc2626; font-size: 1.5rem;"><%= stats.urgentUnassigned || 0 %></span>
              <span style="color: #6b7280; font-size: 1rem;"> / <%= stats.totalUnassigned || 0 %></span>
            </div>
            <div class="kpi-subtext"><span style="color: #dc2626; font-weight: 600;"><%= stats.urgentUnassigned || 0 %></span> urgent, <%= stats.totalUnassigned || 0 %> total need assignment</div>
          </div>
        </div>
      </div>
    </div>

      <!-- ADMIN ACTION LIST - NEW COMPONENT -->
      <div class="analytics-section">
        <h2 class="section-header-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 11l3 3L22 4"></path>
            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
          </svg>
          Admin Action Required
        </h2>
        <p class="section-subtitle">Critical tasks requiring immediate attention</p>

        <!-- TWO COLUMN LAYOUT -->
        <div class="auto-fit-grid-main" style="margin-top: 1rem;">
          
          <!-- PENDING TASKS TABLE -->
          <div class="table-card">
            <div class="table-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid #e5e7eb;">
              <div>
                <h3 class="table-title" style="margin: 0; font-size: 1rem;">Pending Tasks</h3>
                <p style="font-size: 0.875rem; color: #6b7280; margin: 0.25rem 0 0 0;">Recent requests</p>
                <% if (pendingRequests && pendingRequests.length > 0) { %>
                <p style="font-size: 0.75rem; margin: 0.25rem 0 0 0; color: #6b7280;">
                  Showing <%= Math.min(5, pendingRequests.length) %> of <%= pendingRequests.length %> tasks
                </p>
                <% } %>
              </div>
              <button onclick="maximizePendingTasks()" style="padding: 0.5rem 1rem; background: #43a047; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 0.875rem; display: flex; align-items: center; gap: 0.5rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <polyline points="9 21 3 21 3 15"></polyline>
                  <line x1="21" y1="3" x2="14" y2="10"></line>
                  <line x1="3" y1="21" x2="10" y2="14"></line>
                </svg>
                View All
              </button>
            </div>
            <div class="table-content">
              <table class="data-table">
                <thead>
                  <tr>
                    <th style="width: 35%;">Requestor</th>
                    <th style="width: 30%;">Title</th>
                    <th style="width: 15%;">Type</th>
                    <th style="width: 20%;">Action</th>
                  </tr>
                </thead>
                <tbody id="admin-action-list-tbody">
                  <% if (pendingRequests && pendingRequests.length > 0) { %>
                    <% pendingRequests.slice(0, 5).forEach(request => { %>
                      <tr>
                        <td>
                          <%= request.userId ? (request.userId.fName + ' ' + request.userId.lName) : 'Unknown' %>
                        </td>
                        <td><strong><%= request.title || request.description ? (request.title || request.description).substring(0, 30) + ((request.title || request.description).length > 30 ? '...' : '') : 'No title' %></strong></td>
                        <td>
                          <span class="type-badge <%= request.requestType %>">
                            <%= request.requestType === 'service' ? 'SERVICE' : 'APPROVAL' %>
                          </span>
                        </td>
                        <td>
                          <a href="/admin/<%= request.requestType === 'service' ? 'services' : 'approvals' %>?openModalId=<%= request._id %>" 
                             class="btn-view" style="padding: 0.4rem 0.8rem; font-size: 0.875rem;">View</a>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="4" class="table-empty">No pending requests at this time</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
              <% if (pendingRequests && pendingRequests.length > 5) { %>
                <div style="text-align: center; padding: 0.75rem; background: #f9fafb; border-top: 1px solid #e5e7eb; font-size: 0.875rem; color: #6b7280;">
                  Showing 5 of <%= pendingRequests.length %> tasks
                </div>
              <% } %>
            </div>
          </div>

          <!-- UNASSIGNED TASKS TABLE -->
          <% if (unassignedTasks && unassignedTasks.length > 0) { %>
          <div class="table-card">
            <div class="table-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid #e5e7eb;">
              <div>
                <h3 class="table-title" style="margin: 0; font-size: 1rem;">Unassigned Tasks</h3>
                <p style="font-size: 0.875rem; margin: 0.25rem 0 0 0;">
                  <span style="color: #dc2626; font-weight: 600;"><%= unassignedTasks.filter(t => t.priority === 'critical').length %> Critical</span>, 
                  <span style="color: #f59e0b; font-weight: 600;"><%= unassignedTasks.filter(t => t.priority === 'urgent').length %> Urgent</span>
                </p>
                <p style="font-size: 0.75rem; margin: 0.25rem 0 0 0; color: #6b7280;">
                  Showing <%= Math.min(5, unassignedTasks.length) %> of <%= unassignedTasks.length %> tasks
                </p>
              </div>
              <button onclick="maximizeUnassignedTasks()" style="padding: 0.5rem 1rem; background: #dc2626; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 0.875rem; display: flex; align-items: center; gap: 0.5rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <polyline points="9 21 3 21 3 15"></polyline>
                  <line x1="21" y1="3" x2="14" y2="10"></line>
                  <line x1="3" y1="21" x2="10" y2="14"></line>
                </svg>
                View All
              </button>
            </div>
            <div class="table-content">
              <table class="data-table">
                <thead>
                  <tr>
                    <th style="width: 10%;">P</th>
                    <th style="width: 35%;">Title</th>
                    <th style="width: 15%;">Type</th>
                    <th style="width: 20%;">Deadline</th>
                    <th style="width: 20%;">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% unassignedTasks.slice(0, 5).forEach((task, index) => { 
                    const daysLeft = task.deadline ? Math.ceil((new Date(task.deadline) - new Date()) / (1000 * 60 * 60 * 24)) : null;
                    const bgColor = task.priority === 'critical' ? '#fee2e2' : task.priority === 'urgent' ? '#fef3c7' : 'transparent';
                  %>
                    <tr class="<%= task.priority === 'critical' ? 'task-row-critical' : task.priority === 'urgent' ? 'task-row-urgent' : 'task-row-normal' %>" 
                        onclick="openUnassignedTaskModal('<%= task._id %>', '<%= task.requestType %>')">
                      <td style="text-align: center;">
                        <span class="priority-badge <%= task.priority %>" style="display: inline-block; width: 24px; height: 24px; line-height: 24px; border-radius: 50%; color: white; font-weight: 700; font-size: 0.7rem;">
                          <%= index + 1 %>
                        </span>
                      </td>
                      <td>
                        <strong><%= task.title || task.description ? (task.title || task.description).substring(0, 30) + ((task.title || task.description).length > 30 ? '...' : '') : 'No title' %></strong>
                      </td>
                      <td>
                        <span class="type-badge <%= task.requestType %>">
                          <%= task.requestType === 'service' ? 'SERVICE' : 'APPROVAL' %>
                        </span>
                      </td>
                      <td>
                        <% if (daysLeft !== null) { %>
                          <div style="display: flex; flex-direction: column;">
                            <span style="font-size: 0.75rem;"><%= new Date(task.deadline).toLocaleDateString() %></span>
                            <span class="priority-text <%= task.priority %>" style="font-weight: 600; font-size: 0.7rem;">
                              <%= daysLeft + 'd' %>
                            </span>
                          </div>
                        <% } else { %>
                          <span style="color: #6b7280; font-size: 0.75rem;">-</span>
                        <% } %>
                      </td>
                      <td>
                        <a href="/admin/<%= task.requestType === 'service' ? 'services' : 'approvals' %>?openModalId=<%= task._id %>" 
                           class="btn-view priority-bg <%= task.priority %>" style="padding: 0.4rem 0.8rem; font-size: 0.875rem;"
                           onclick="event.stopPropagation();">Assign</a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
              <% if (unassignedTasks.length > 5) { %>
                <div style="text-align: center; padding: 0.75rem; background: #f9fafb; border-top: 1px solid #e5e7eb; font-size: 0.875rem; color: #6b7280;">
                  Showing 5 of <%= unassignedTasks.length %> tasks
                </div>
              <% } %>
            </div>
          </div>
          <% } %>

        </div>
      </div>

      <!-- MAXIMIZE MODALS -->
      <!-- Pending Tasks Full View Modal -->
      <div id="pendingTasksModal" class="modal" style="display:none;">
        <div class="modal-content" style="max-width: 1200px;">
          <header class="modal-header">
            <span class="modal-title">All Pending Tasks for Admin Action</span>
            <span class="close" id="closePendingTasksModal">&times;</span>
          </header>
          <div class="modal-body" style="padding: 1.5rem;">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Requestor</th>
                  <th>Organization</th>
                  <th>Title</th>
                  <th>Type</th>
                  <th>Date Submitted</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (pendingRequests && pendingRequests.length > 0) { %>
                  <% pendingRequests.forEach(request => { %>
                    <tr>
                      <td><strong><%= request.userId ? (request.userId.fName + ' ' + request.userId.lName) : 'Unknown' %></strong></td>
                      <td><%= request.displayOrganization || request.organization || 'N/A' %></td>
                      <td><strong><%= request.title || request.description || 'No title' %></strong></td>
                      <td>
                        <span class="type-badge <%= request.requestType %>">
                          <%= request.requestType === 'service' ? 'SERVICE' : 'APPROVAL' %>
                        </span>
                      </td>
                      <td><%= request.createdAt ? new Date(request.createdAt).toLocaleDateString() : 'N/A' %></td>
                      <td>
                        <a href="/admin/<%= request.requestType === 'service' ? 'services' : 'approvals' %>?openModalId=<%= request._id %>" 
                           class="btn-view">View & Assign</a>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Unassigned Tasks Full View Modal -->
      <div id="unassignedTasksMaxModal" class="modal" style="display:none;">
        <div class="modal-content" style="max-width: 1200px;">
          <header class="modal-header unified-modal-header">
            <h3 class="modal-title">All Unassigned Tasks</h3>
            <span class="close" id="closeUnassignedTasksMaxModal">&times;</span>
          </header>
          <div class="modal-body" style="padding: 1.5rem;">
            <!-- Priority Legend -->
            <div class="priority-legend">
              <span class="legend-label">Priority Legend:</span>
              <div class="legend-items">
                <div class="legend-item">
                  <span class="legend-color" style="background: #fee2e2;"></span>
                  <span class="legend-text">Critical</span>
                </div>
                <div class="legend-item">
                  <span class="legend-color" style="background: #fef3c7;"></span>
                  <span class="legend-text">Urgent</span>
                </div>
                <div class="legend-item">
                  <span class="legend-color" style="background: #ffffff; border: 1px solid #e5e7eb;"></span>
                  <span class="legend-text">Moderate/Low</span>
                </div>
              </div>
            </div>

            <table class="data-table">
              <thead>
                <tr>
                  <th style="width: 150px;">Requestor</th>
                  <th style="width: 140px;">Organization</th>
                  <th style="width: auto;">Title</th>
                  <th style="width: 120px; text-align: center;">Type</th>
                  <th style="width: 120px;">Deadline</th>
                  <th style="width: 100px; text-align: center;">Days Left</th>
                  <th style="width: 130px; text-align: center;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (unassignedTasks && unassignedTasks.length > 0) { %>
                  <% unassignedTasks.forEach((task, index) => { 
                    const daysLeft = task.deadline ? Math.ceil((new Date(task.deadline) - new Date()) / (1000 * 60 * 60 * 24)) : null;
                    const bgColor = task.priority === 'critical' ? '#fee2e2' : task.priority === 'urgent' ? '#fef3c7' : 'transparent';
                  %>
                    <tr class="<%= task.priority === 'critical' ? 'task-row-critical' : task.priority === 'urgent' ? 'task-row-urgent' : 'task-row-normal' %>">
                      <td style="padding: 1rem 1.25rem;"><strong><%= task.userId?.fName || 'Unknown' %> <%= task.userId?.lName || '' %></strong></td>
                      <td style="padding: 1rem 1.25rem;"><%= task.displayOrganization || task.organization || 'N/A' %></td>
                      <td style="padding: 1rem 1.25rem;"><strong><%= task.title || task.description || 'No title' %></strong></td>
                      <td style="text-align: center; padding: 1rem 0.75rem;">
                        <span class="type-badge <%= task.requestType %>" style="padding: 0.375rem 0.75rem; border-radius: 6px; font-size: 0.75rem;">
                          <%= task.requestType === 'service' ? 'SERVICE' : 'APPROVAL' %>
                        </span>
                      </td>
                      <td style="padding: 1rem 1.25rem;">
                        <span style="font-size: 0.875rem; font-weight: 500;"><%= task.deadline ? new Date(task.deadline).toLocaleDateString() : 'No deadline' %></span>
                      </td>
                      <td style="text-align: center; padding: 1rem 0.75rem;">
                        <% if (daysLeft !== null) { %>
                          <span class="priority-text <%= task.priority %>" style="font-weight: 600; font-size: 0.875rem;">
                            <%= daysLeft + ' day' + (Math.abs(daysLeft) !== 1 ? 's' : '') %>
                          </span>
                        <% } else { %>
                          <span style="color: #6b7280;">-</span>
                        <% } %>
                      </td>
                      <td style="text-align: center; padding: 1rem 0.75rem;">
                        <a href="/admin/<%= task.requestType === 'service' ? 'services' : 'approvals' %>?openModalId=<%= task._id %>" 
                           class="btn-view priority-bg <%= task.priority %>" style="padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; text-decoration: none; display: inline-block; color: white;">Assign Now</a>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <script>
        // Maximize Pending Tasks
        function maximizePendingTasks() {
          document.getElementById('pendingTasksModal').style.display = 'block';
        }

        document.getElementById('closePendingTasksModal').onclick = function() {
          document.getElementById('pendingTasksModal').style.display = 'none';
        };

        // Maximize Unassigned Tasks
        function maximizeUnassignedTasks() {
          document.getElementById('unassignedTasksMaxModal').style.display = 'block';
        }

        document.getElementById('closeUnassignedTasksMaxModal').onclick = function() {
          document.getElementById('unassignedTasksMaxModal').style.display = 'none';
        };

        // Close modals when clicking outside
        window.addEventListener('click', function(event) {
          const pendingModal = document.getElementById('pendingTasksModal');
          const unassignedMaxModal = document.getElementById('unassignedTasksMaxModal');
          
          if (event.target === pendingModal) {
            pendingModal.style.display = 'none';
          }
          if (event.target === unassignedMaxModal) {
            unassignedMaxModal.style.display = 'none';
          }
        });
      </script>

      <!-- Unassigned Task Details Modal -->
      <div id="unassignedTaskModal" class="modal" style="display:none;">
        <div class="modal-content" style="max-width: 700px;">
          <header class="modal-header">
            <span class="modal-title">Unassigned Task Details</span>
            <span class="close" id="closeUnassignedTaskModal">&times;</span>
          </header>
          <div class="modal-body" style="padding: 1.5rem;">
            <div id="unassignedTaskDetails">
              <!-- Details will be populated via JavaScript -->
            </div>
          </div>
        </div>
      </div>

      <script>
        // @ts-nocheck
        // Store unassigned tasks data
        /* @ts-ignore */
        const unassignedTasksData = <%- JSON.stringify(unassignedTasks || []) %>;

        function openUnassignedTaskModal(taskId, requestType) {
          const task = unassignedTasksData.find(t => t._id.toString() === taskId);
          if (!task) return;

          const daysLeft = task.deadline ? Math.ceil((new Date(task.deadline) - new Date()) / (1000 * 60 * 60 * 24)) : null;
          
          const detailsHtml = `
            <div style="display: flex; flex-direction: column; gap: 1rem;">
              <!-- Priority Badge -->
              <div style="display: flex; align-items: center; gap: 0.75rem; padding: 1rem; background: ${task.priority === 'critical' || task.priority === 'urgent' ? '#fef2f2' : '#f9fafb'}; border-radius: 8px; border-left: 4px solid ${task.priorityColor};">
                <span style="display: inline-block; width: 40px; height: 40px; line-height: 40px; border-radius: 50%; background: ${task.priorityColor}; color: white; font-weight: 700; font-size: 1rem; text-align: center;">
                  ${task.priorityLabel.charAt(0)}
                </span>
                <div>
                  <div style="font-weight: 700; font-size: 1.1rem; color: ${task.priorityColor};">${task.priorityLabel} Priority</div>
                  <div style="font-size: 0.875rem; color: #6b7280;">Requires immediate assignment</div>
                </div>
              </div>

              <!-- Title & Type -->
              <div>
                <label style="font-weight: 600; color: #374151; display: block; margin-bottom: 0.5rem;">Title</label>
                <div style="font-size: 1rem; color: #111827;">${task.title || task.description || 'No title'}</div>
                <span class="type-badge ${requestType}" style="margin-top: 0.5rem; display: inline-block;">
                  ${requestType === 'service' ? 'SERVICE REQUEST' : 'APPROVAL REQUEST'}
                </span>
              </div>

              <!-- Requestor Info -->
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div>
                  <label style="font-weight: 600; color: #374151; display: block; margin-bottom: 0.5rem;">Requestor</label>
                  <div style="font-size: 0.95rem; color: #111827;">${task.userId?.fName || 'Unknown'} ${task.userId?.lName || ''}</div>
                </div>
                <div>
                  <label style="font-weight: 600; color: #374151; display: block; margin-bottom: 0.5rem;">Organization</label>
                  <div style="font-size: 0.95rem; color: #111827;">${task.displayOrganization || task.organization || 'N/A'}</div>
                </div>
              </div>

              <!-- Deadline Info -->
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div>
                  <label style="font-weight: 600; color: #374151; display: block; margin-bottom: 0.5rem;">Deadline</label>
                  <div style="font-size: 0.95rem; color: #111827;">
                    ${task.deadline ? new Date(task.deadline).toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) : 'No deadline set'}
                  </div>
                </div>
                ${daysLeft !== null ? `
                <div>
                  <label style="font-weight: 600; color: #374151; display: block; margin-bottom: 0.5rem;">Time Remaining</label>
                  <div style="font-size: 1.1rem; font-weight: 700; color: ${task.priorityColor};">
                    ${daysLeft > 0 ? daysLeft + ' day' + (daysLeft !== 1 ? 's' : '') : daysLeft + ' day' + (Math.abs(daysLeft) !== 1 ? 's' : '') + ' overdue'}
                  </div>
                </div>
                ` : ''}
              </div>

              <!-- Description -->
              ${task.description ? `
              <div>
                <label style="font-weight: 600; color: #374151; display: block; margin-bottom: 0.5rem;">Description</label>
                <div style="font-size: 0.9rem; color: #4b5563; line-height: 1.6; padding: 0.75rem; background: #f9fafb; border-radius: 6px;">
                  ${task.description}
                </div>
              </div>
              ` : ''}

              <!-- Created Date -->
              <div>
                <label style="font-weight: 600; color: #374151; display: block; margin-bottom: 0.5rem;">Submitted</label>
                <div style="font-size: 0.875rem; color: #6b7280;">
                  ${task.createdAt ? new Date(task.createdAt).toLocaleString() : 'Unknown'}
                </div>
              </div>

              <!-- Action Buttons -->
              <div style="display: flex; gap: 1rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #e5e7eb;">
                <a href="/admin/${requestType === 'service' ? 'services' : 'approvals'}?openModalId=${taskId}" 
                   class="btn-view" style="flex: 1; text-align: center; background: ${task.priorityColor}; padding: 0.75rem 1.5rem;">
                  Assign Unit Team
                </a>
                <button onclick="document.getElementById('unassignedTaskModal').style.display='none'" 
                        style="flex: 1; padding: 0.75rem 1.5rem; background: #f3f4f6; color: #374151; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                  Close
                </button>
              </div>
            </div>
          `;

          document.getElementById('unassignedTaskDetails').innerHTML = detailsHtml;
          document.getElementById('unassignedTaskModal').style.display = 'block';
        }

        // Close modal handlers
        document.getElementById('closeUnassignedTaskModal').onclick = function() {
          document.getElementById('unassignedTaskModal').style.display = 'none';
        };

        window.onclick = function(event) {
          const modal = document.getElementById('unassignedTaskModal');
          if (event.target === modal) {
            modal.style.display = 'none';
          }
        };
      </script>

      <!-- ORIGINAL CHARTS SECTION (Keep for backward compatibility) -->
      <div class="analytics-section">
        <h2 class="section-header-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          Workflow Snapshot
        </h2>
        <p class="section-subtitle">Quick overview of request distribution and workload</p>

      <!-- CHARTS SECTION -->
      <div class="charts-grid auto-fit-grid-main">
        <!-- Request Status Overview Chart -->
        <div class="chart-card">
          <div class="chart-header">
            <h3 class="chart-title">Current Request Status</h3>
            <p class="chart-subtitle">Real-time snapshot of the entire workflow pipeline (Pending, In Progress, Completed, etc.)</p>
          </div>
          <div class="chart-content">
            <canvas id="statusChart"></canvas>
          </div>
        </div>

        <!-- Active Tasks by Unit Chart -->
        <div class="chart-card">
          <div class="chart-header">
            <h3 class="chart-title">Active Tasks by Unit</h3>
            <p class="chart-subtitle">Current workload distribution</p>
          </div>
          <div class="chart-content">
            <canvas id="unitChart"></canvas>
          </div>
        </div>

        <!-- Request Volume Over Time Chart -->
        <div class="chart-card chart-card-wide">
          <div class="chart-header">
            <div>
              <h3 class="chart-title">Request Volume Over Time</h3>
              <p class="chart-subtitle">Track request submission trends</p>
            </div>
            <select id="timeRangeFilter" class="chart-filter">
              <option value="7">Last 7 Days</option>
              <option value="30" selected>Last 30 Days</option>
              <option value="90">Last 3 Months</option>
              <option value="365">Last Year</option>
            </select>
          </div>
          <div class="chart-content">
            <canvas id="volumeChart"></canvas>
          </div>
        </div>
      </div>

      <!-- ACTIONABLE LISTS & TABLES -->
      <div class="tables-grid auto-fit-grid-main">
        <!-- Very Recent Requests Table -->
        <div class="table-card">
          <div class="table-header">
            <div>
              <h3 class="table-title">Very Recent Requests</h3>
              <p class="table-subtitle">Requests from the last 7 days</p>
            </div>
            <a href="/admin/approvals" class="view-all-link">View All →</a>
          </div>
          <div class="table-content">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Request</th>
                  <th>Type</th>
                  <th>Requester</th>
                  <th>Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="incoming-requests-tbody">
                <% if (recentRequests && recentRequests.length > 0) { %>
                  <% recentRequests.forEach(request => { %>
                    <tr>
                      <td><strong><%= request.title || request.description ? (request.title || request.description).substring(0, 30) + ((request.title || request.description).length > 30 ? '...' : '') : 'No title' %></strong></td>
                      <td>
                        <span class="type-badge <%= request.requestType %>">
                          <%= request.requestType === 'service' ? 'SERVICE' : 'APPROVAL' %>
                        </span>
                      </td>
                      <td><%= request.userId?.fName || 'Unknown' %> <%= request.userId?.lName || '' %></td>
                      <td><%= request.createdAt ? new Date(request.createdAt).toLocaleDateString() : 'N/A' %></td>
                      <td>
                        <a href="/admin/<%= request.requestType === 'service' ? 'services' : 'approvals' %>?openModalId=<%= request._id %>" 
                           class="btn-view" style="padding: 0.4rem 0.8rem; font-size: 0.875rem;">View</a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="table-empty">No recent requests</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Urgent & Overdue Tasks Table -->
        <div class="table-card">
          <div class="table-header">
            <div>
              <h3 class="table-title">Urgent & Overdue Tasks</h3>
              <p class="table-subtitle">High-priority items</p>
            </div>
            <a href="/admin/approvals" class="view-all-link">View All →</a>
          </div>
          <div class="table-content">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Request</th>
                  <th>Status</th>
                  <th>Deadline</th>
                  <th>Priority</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="urgent-tasks-tbody">
                <% if (urgentTasks && urgentTasks.length > 0) { %>
                  <% urgentTasks.forEach(task => { %>
                    <tr class="<%= task.isOverdue ? 'task-row-overdue' : (task.priority === 'critical' ? 'task-row-urgent' : '') %>">
                      <td><strong><%= task.title || task.description ? (task.title || task.description).substring(0, 25) + ((task.title || task.description).length > 25 ? '...' : '') : 'No title' %></strong></td>
                      <td>
                        <span class="status-badge <%= task.status?.toLowerCase().replace(/\s+/g, '') %>">
                          <%= task.status || 'Pending' %>
                        </span>
                      </td>
                      <td><%= task.deadline ? new Date(task.deadline).toLocaleDateString() : 'N/A' %></td>
                      <td>
                        <span class="priority-text <%= task.priority %>" style="font-weight: 700; font-size: 0.875rem;">
                          <%= task.isOverdue ? 'OVERDUE' : task.priority.toUpperCase() %>
                        </span>
                      </td>
                      <td>
                        <a href="/admin/<%= task.requestType === 'service' ? 'services' : 'approvals' %>?openModalId=<%= task._id %>" 
                           class="btn-view priority-bg <%= task.priority %>" style="padding: 0.4rem 0.8rem; font-size: 0.875rem;">View</a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="table-empty">No urgent tasks</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Top Requests by Revision Count -->
        <div class="table-card table-card-wide">
          <div class="table-header">
            <div>
              <h3 class="table-title">Top Requests by Revision Count</h3>
