                        </span>
                      </td>
                      <td><%= request.userId?.fName || 'Unknown' %> <%= request.userId?.lName || '' %></td>
                      <td><%= request.assignedUnits || 'Not assigned' %></td>
                      <td style="text-align: center;">
                        <span style="background: #fef3c7; color: #d97706; padding: 0.25rem 0.75rem; border-radius: 6px; font-weight: 700; font-size: 0.875rem;">
                          <%= request.revisionCount %>
