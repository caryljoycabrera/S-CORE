          const unassignedElement = document.getElementById('kpi-urgent-unassigned');
          if (unassignedElement) {
            // Find the span elements within the unassigned KPI
            const spans = unassignedElement.querySelectorAll('span');
            if (spans.length >= 2) {
              spans[0].textContent = urgentUnassigned;
              spans[1].textContent = ' / ' + totalUnassigned;
            }
            // Update the subtext as well
            const subtext = unassignedElement.parentElement.querySelector('.kpi-subtext');
            if (subtext) {
              subtext.innerHTML = `<span style="color: #dc2626; font-weight: 600;">${urgentUnassigned}</span> urgent, ${totalUnassigned} total need assignment`;
            }
          }
          
          // Update additional KPIs (if elements exist)
          const completedMonthEl = document.getElementById('kpi-completed-month');
          if (completedMonthEl) completedMonthEl.textContent = kpiData.completedThisMonth || '0';
          
          const upcomingDeadlinesEl = document.getElementById('kpi-upcoming-deadlines');
          if (upcomingDeadlinesEl) upcomingDeadlinesEl.textContent = kpiData.upcomingDeadlines || '0';
          
          const overdueEl = document.getElementById('kpi-overdue');
          if (overdueEl) overdueEl.textContent = kpiData.overdue || '0';
        }
        
        // Load revision hotspot data
        await loadRevisionHotspot();
        
        // Load incoming requests data
        await loadIncomingRequests();
        
        // Load urgent and overdue tasks
        await loadUrgentAndOverdueTasks();
        
      } catch (error) {
        console.error('Error loading dashboard data:', error);
      }
    }

    // Load incoming requests
    async function loadIncomingRequests() {
      try {
        const response = await fetch('/api/admin/incoming-requests', {
          credentials: 'same-origin'
        });
        const result = await response.json();
        
        if (result.success && result.data) {
          const tbody = document.getElementById('incoming-requests-tbody');
          
          if (result.data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="table-empty">No incoming requests</td></tr>';
            return;
          }
          
          let html = '';
          result.data.forEach(item => {
            const date = item.createdAt ? new Date(item.createdAt).toLocaleDateString() : 'N/A';
            const url = item.type === 'Approval Request' 
              ? `/admin/approvals?openModalId=${item._id}`
              : `/admin/services?openModalId=${item._id}`;
            
            html += `
              <tr>
                <td><strong>${item.title || 'Untitled'}</strong></td>
                <td><span class="type-badge ${item.type === 'Approval Request' ? 'approval' : 'service'}">${item.type}</span></td>
                <td>${item.requesterName || 'Unknown'}</td>
                <td>${date}</td>
                <td><a href="${url}" class="btn-view">View</a></td>
              </tr>
            `;
          });
          
          tbody.innerHTML = html;
        }
      } catch (error) {
        console.error('Error loading incoming requests:', error);
      }
    }

