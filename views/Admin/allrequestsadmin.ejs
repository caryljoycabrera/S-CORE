<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Track All Requests - S-CORE</title>
  <link rel="icon" type="image/x-icon" href="/Picture/favicon.ico">

  <!-- ==========================================
       ** EXTERNAL STYLESHEET & JAVASCRIPT LINKS
       ** ==========================================
       ** Admin all requests page styles are now managed in: public/stylesheets/ejs/allrequestsadmin.css
       ** All requests page functionality is handled by: public/javascripts/ejs/allrequestsadmin.js
       ** This improves code organization and maintainability
       * ========================================== -->

  <!-- Base Stylesheet and Google Fonts -->
  <link rel="stylesheet" href="/stylesheets/ejs/table-fixes.css" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/stylesheets/status-badges-new.css" />
  <link rel="stylesheet" href="/stylesheets/notifications.css" />
  <link rel="stylesheet" href="/stylesheets/admin-navbar.css" />
  <link rel="stylesheet" href="/stylesheets/modal-centered.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/admin-modal-two-column.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/Admin/approvals-conversation-modal.css" />
  <link rel="stylesheet" href="/stylesheets/no-animations.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/admin-edit-modal.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/admin-trash-modal.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
  <script src="/javascripts/alert-handler.js"></script>

  <!-- Admin All Requests Page Specific Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/ejs/allrequestsadmin.css" />


</head>
<body>
  <!-- SIDEBAR NAVIGATION -->
  <div class="admin-sidebar" id="adminSidebar">
    <!-- Profile Section at Top -->
    <div class="sidebar-profile">
      <a href="/admin/profile" class="sidebar-profile-link" title="Go to Profile">
        <div class="sidebar-profile-icon-container">
          <!-- SVG Icon (shows when collapsed) -->
          <svg class="sidebar-profile-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <!-- Profile Avatar (shows when expanded) -->
          <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" 
               alt="<%= user.fName %> <%= user.lName %>" 
               class="sidebar-profile-avatar" />
        </div>
        <div class="sidebar-profile-info">
          <p class="sidebar-profile-name"><%= user.fName %> <%= user.lName %></p>
          <p class="sidebar-profile-role"><%= user.userType === 'nonstudent' ? 'Non-Student' : user.userType.charAt(0).toUpperCase() + user.userType.slice(1) %></p>
        </div>
        <span class="sidebar-profile-arrow">→</span>
      </a>
    </div>

    <div class="sidebar-items">
      <a href="/admin" class="sidebar-item" title="Dashboard">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span class="sidebar-label">Dashboard</span>
      </a>
      
      <a href="/admin/analytics" class="sidebar-item" title="Analytics">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="20" x2="12" y2="10"></line>
          <line x1="18" y1="20" x2="18" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="16"></line>
        </svg>
        <span class="sidebar-label">Analytics</span>
      </a>
      
      <a href="/admin/all-requests" class="sidebar-item active" title="Track All Requests">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 11l3 3L22 4"></path>
          <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
        </svg>
        <span class="sidebar-label">Track All Requests</span>
      </a>
      
      <a href="/admin/approvals" class="sidebar-item" title="Manage Approvals">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span class="sidebar-label">Manage Approvals</span>
      </a>
      
      <a href="/admin/services" class="sidebar-item" title="Manage Services">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"></path>
        </svg>
        <span class="sidebar-label">Manage Services</span>
      </a>
      
      <a href="/admin/users" class="sidebar-item" title="User Accounts">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 00-3-3.87"></path>
          <path d="M16 3.13a4 4 0 010 7.75"></path>
        </svg>
        <span class="sidebar-label">User Accounts</span>
      </a>
      <a href="/admin/announcement" class="sidebar-item" title="Announcements">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 9.5v5a1 1 0 0 1-1 1h-2.5L14 20v-6H9a1 1 0 0 1-1-1V9.5a1 1 0 0 1 1-1h5l4.5-4V8.5H21a1 1 0 0 1 1 1z"></path>
          <path d="M3 11v2a7 7 0 0 0 7 7v-2a5 5 0 0 1-5-5v-2H3z"></path>
        </svg>
        <span class="sidebar-label">Announcements</span>
      </a>

      <a href="/admin/configuration" class="sidebar-item" title="Configuration">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 1v6m0 6v6m8.66-12.66l-4.24 4.24m-6.84 6.84l-4.24 4.24M23 12h-6m-6 0H5m17.66 4.66l-4.24-4.24m-6.84-6.84L6.34 1.42"></path>
        </svg>
        <span class="sidebar-label">Configuration</span>
      </a>

      <a href="/admin/reports" class="sidebar-item" title="Generate Reports">
        <svg class="sidebar-icon" viewBox="0 0 105.53 122.88" fill="currentColor" stroke="none">
          <path d="M98.66,87l2.84,2.85a1.9,1.9,0,0,1,0,2.71l-2.28,2.29a15.46,15.46,0,0,1,1.42,3.79h3a1.92,1.92,0,0,1,1.92,1.92v4a1.93,1.93,0,0,1-1.92,1.93h-3.23a15.4,15.4,0,0,1-1.67,3.67l2.09,2.09a1.93,1.93,0,0,1,0,2.72L98,117.86a1.93,1.93,0,0,1-2.72,0L93,115.58A15.88,15.88,0,0,1,89.16,117v3a1.93,1.93,0,0,1-1.92,1.92h-4A1.93,1.93,0,0,1,81.31,120v-3.23a15.32,15.32,0,0,1-3.68-1.68l-2.09,2.1a1.93,1.93,0,0,1-2.72,0L70,114.3a1.91,1.91,0,0,1,0-2.71l2.28-2.29a15.88,15.88,0,0,1-1.42-3.79h-3A1.93,1.93,0,0,1,66,103.59v-4a1.94,1.94,0,0,1,1.92-1.93H71.1A15.43,15.43,0,0,1,72.78,94l-2.1-2.09a1.93,1.93,0,0,1,0-2.72l2.85-2.84a1.91,1.91,0,0,1,2.71,0l2.29,2.28a15.83,15.83,0,0,1,3.79-1.42v-3a1.93,1.93,0,0,1,1.92-1.92h4a1.93,1.93,0,0,1,1.92,1.92v3.23a15,15,0,0,1,3.67,1.68L95.94,87a1.94,1.94,0,0,1,2.72,0ZM60.26,117a3,3,0,0,1,0,5.92H6.89A6.89,6.89,0,0,1,0,116V6.85A6.82,6.82,0,0,1,2,2,6.79,6.79,0,0,1,6.88,0H91.52a6.9,6.9,0,0,1,6.89,6.89V68.23c0,.06,0,.12,0,.18a3,3,0,0,1-5.94,0V6.89h0a1,1,0,0,0-.28-.68,1,1,0,0,0-.68-.29H6.89a.94.94,0,0,0-1,1V116h0a1,1,0,0,0,.28.67,1,1,0,0,0,.69.29H60.26ZM19,102.66V96H47.83v6.63l-28.82,0Zm55.3-42.9v6.11H65.62V59.76ZM58.77,54.38V65.87H50.08V54.38ZM43.24,37.92v28H34.55V37.92ZM27.7,26.41V65.87H19V26.41ZM69,29.31l13.11.05a13.14,13.14,0,0,1-3.91,9.29,13.55,13.55,0,0,1-1.91,1.56L69,29.31Zm-1.34-2.6L67,12.7a.51.51,0,0,1,.48-.53H68A14.56,14.56,0,0,1,82.69,25.67a.52.52,0,0,1-.47.54l-14,1a.49.49,0,0,1-.53-.46.08.08,0,0,0,0,0Zm.83-13.55.65,12.51L80.9,24.61a11.68,11.68,0,0,0-4-7.86c-2.46-2.27-4.74-3.62-8.32-3.58ZM66.1,28.7l7,12.17A14.05,14.05,0,1,1,64.06,14.8l2,13.9ZM19,84.83V78.15H59.86v6.63L19,84.83Zm66.73,9.38a7.89,7.89,0,1,1-7.89,7.89,7.89,7.89,0,0,1,7.89-7.89Z"/>
        </svg>
        <span class="sidebar-label">Generate Reports</span>
      </a>
    </div>
    
    <!-- Logout Button at Bottom -->
    <div class="sidebar-bottom">
      <a href="/logout" class="sidebar-item sidebar-logout" title="Logout">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span class="sidebar-label">Logout</span>
      </a>
    </div>
  </div>

  <!-- MAIN CONTENT WITH HEADER -->
  <div class="admin-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="admin-menu-toggle" id="adminMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/admin" class="text-wrapper">S-CORE ADMIN</a>
      </div>
      
      <span class="text-wrapper-2">Track All Requests</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/admin/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

      <!-- Section -->
      <section class="activity-section">
        <!-- Page Header with User Info and Action Buttons -->
        <div class="page-header-container">
          <div class="user-info-section">
            <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" 
                 alt="Profile Picture" class="profile-pic-large" style="width:64px;height:64px;border-radius:50%;" />
            <div>
              <h1 style="margin-bottom: 0.25rem;">All Requests Overview</h1>
              <p style="color: #6b7280; margin: 0;">View and manage all user requests in one place</p>
            </div>
          </div>
          <div class="action-button-container">
            <a href="/admin/approvals" class="view-all-btn">+ Request Approval</a>
            <a href="/admin/services" class="view-all-btn">+ Request Service</a>
          </div>
        </div>
        
        <nav class="nav-tabs tabs">
          <a href="/admin/all-requests" class="tab-btn active">All Requests</a>
          <a href="/admin/approvals" class="tab-btn">Approvals</a>
          <a href="/admin/services" class="tab-btn">Services</a>
          <a href="/admin/users" class="tab-btn">Users</a>
        </nav>
        
        <hr style="margin: 0 3rem 2rem 3rem; border: none; border-top: 2px solid #e5e7eb;">

        <!-- Filter Options -->
        <div class="filter-section">
          <div class="filter-container">
            <div class="filter-group">
              <label class="filter-label">Filter by:</label>

              <!-- First Row: Request ID, User, Status, Assigned Unit -->
              <div class="filter-controls">
                <div class="filter-item">
                  <label for="requestIdFilter" class="filter-sublabel">Request ID</label>
                  <input type="text" id="requestIdFilter" class="filter-input" placeholder="Search request ID...">
                </div>
                <div class="filter-item">
                  <label for="studentFilter" class="filter-sublabel">User</label>
                  <input type="text" id="studentFilter" class="filter-input" placeholder="Search user name...">
                </div>
                <div class="filter-item">
                  <label class="filter-sublabel">Status</label>
                  <div class="enhanced-multi-select-wrapper">
                    <div class="enhanced-multi-select" id="statusFilter">
                      <div class="select-display" data-placeholder="Select Status">
                        <span class="selected-text">All Status</span>
                        <span class="dropdown-arrow">▼</span>
                      </div>
                      <div class="select-dropdown" id="statusDropdown">
                        <div class="options-container"></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="filter-item">
                  <label class="filter-sublabel">Assigned Unit</label>
                  <div class="enhanced-multi-select-wrapper">
                    <div class="enhanced-multi-select" id="assignedUnitFilter">
                      <div class="select-display" data-placeholder="Select Assigned Unit">
                        <span class="selected-text">All Units</span>
                        <span class="dropdown-arrow">▼</span>
                      </div>
                      <div class="select-dropdown" id="assignedUnitDropdown">
                        <div class="options-container"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Second Row: Student Organization and Office/Department -->
              <div class="filter-controls dropdown-row">
                <div class="filter-item">
                  <label for="studentOrgFilter" class="filter-sublabel">Student Organization</label>
                  <div class="enhanced-multi-select-wrapper">
                    <div class="enhanced-multi-select" id="studentOrgFilter">
                      <div class="select-display" data-placeholder="Select Student Organizations">
                        <span class="selected-text">All Student Organizations</span>
                        <span class="dropdown-arrow">▼</span>
                      </div>
                      <div class="select-dropdown" id="studentOrgDropdown">
                        <div class="search-container">
                          <input type="text" class="search-input" placeholder="Search organizations...">
                        </div>
                        <div class="options-container"></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="filter-item">
                  <label for="officeDeptFilter" class="filter-sublabel">Office/Department</label>
                  <div class="enhanced-multi-select-wrapper">
                    <div class="enhanced-multi-select" id="officeDeptFilter">
                      <div class="select-display" data-placeholder="Select Offices/Departments">
                        <span class="selected-text">All Offices/Departments</span>
                        <span class="dropdown-arrow">▼</span>
                      </div>
                      <div class="select-dropdown" id="officeDeptDropdown">
                        <div class="search-container">
                          <input type="text" class="search-input" placeholder="Search offices/departments...">
                        </div>
                        <div class="options-container"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Third Row: Sort By, Date From and Date To -->
              <div class="filter-controls">
                <div class="filter-item">
                  <label for="sortByFilter" class="filter-sublabel">Sort By</label>
                  <select id="sortByFilter" class="filter-input">
                    <option value="deadline-asc">Deadline (Soonest First)</option>
                    <option value="deadline-desc">Deadline (Latest First)</option>
                    <option value="date-desc">Date Submitted (Newest)</option>
                    <option value="date-asc">Date Submitted (Oldest)</option>
                  </select>
                </div>
                <div class="filter-item">
                  <label for="dateFromFilter" class="filter-sublabel">Date From</label>
                  <input type="date" id="dateFromFilter" class="filter-input">
                </div>
                <div class="filter-item">
                  <label for="dateToFilter" class="filter-sublabel">Date To</label>
                  <input type="date" id="dateToFilter" class="filter-input">
                </div>
                <div class="filter-item" style="visibility: hidden;"></div>
              </div>
            </div>

            <div class="filter-actions">
              <button id="clearFilters" class="clear-filters-btn">
                <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                  <rect x="3" y="6" width="18" height="14" rx="2"/>
                  <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                  <line x1="1" y1="6" x2="23" y2="6"/>
                  <line x1="10" y1="11" x2="10" y2="17"/>
                  <line x1="14" y1="11" x2="14" y2="17"/>
                </svg>
                Clear All
              </button>
              <div class="results-count">
                <span id="resultsCount">Showing all requests</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Table -->
        <section class="table-section" style="overflow-x: auto;">
          <table class="requests-table" style="border-collapse: collapse; background: white; min-width: 960px;">
            <thead style="background: var(--light-green); color: var(--primary-green);">
              <tr>
                <th>Request ID</th>
                <th>Type</th>
                <th>User</th>
                <th>Project Title</th>
                <th>Office/Department/Organization</th>
                <th>Status</th>
                <th>Assigned Units</th>
                <th>Date Submitted</th>
                <th>Deadline</th>
              </tr>
            </thead>
            <tbody id="requestsTableBody">
              <% allRequests.forEach(request => {
                // Calculate local deadline and formatted deadline string
                let localDeadline = '';
                let formattedDeadline = 'N/A';
                if (request.deadline) {
                  const d = new Date(request.deadline);
                  localDeadline = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
                  formattedDeadline = (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
                }

                // Ensure userName is always available
                let displayUserName = 'System User';
                if (request.userName) {
                  displayUserName = request.userName;
                } else if (request.userId && request.userId.fName) {
                  displayUserName = `${request.userId.fName} ${request.userId.lName || ''}`.trim();
                }
              %>
              <tr class="request-row"
                data-id="<%= request._id %>"
                data-request-id="<%= request._id.toString().slice(-6) %>"
                data-type="<%= request.type %>"
                data-specifictype="<%= request.specificRequestType || 'Not specified' %>"
                data-title="<%= request.title %>"
                data-status="<%= request.status %>"
                data-organization="<%= request.displayOrganization || request.organization %>"
                data-units="<%= request.assignedUnits || 'Not yet assigned' %>"
                data-datetime="<%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %>"
                data-date="<%= request.datetime ? request.datetime.toISOString().split('T')[0] : new Date(request.createdAt).toISOString().split('T')[0] %>"
                data-created="<%= new Date(request.createdAt).toISOString().split('T')[0] %>"
                data-description="<%= request.description %>"
                data-file="<%= request.file || '' %>"
                data-files="<%= request.files ? request.files.join(',') : '' %>"
                data-deadline="<%= localDeadline %>"
                data-formatted-deadline="<%= formattedDeadline %>"
                data-allow-additional-upload="<%= request.allowAdditionalFileUpload ? 'true' : 'false' %>"
                data-debug-allow="<%= JSON.stringify({
                  raw: request.allowAdditionalFileUpload,
                  type: typeof request.allowAdditionalFileUpload,
                  final: request.allowAdditionalFileUpload ? 'true' : 'false'
                }) %>"
                data-student="<%= displayUserName %>">
                <td data-label="ID"><%= request._id.toString().slice(-6) %></td>
                <td data-label="Type">
                  <% if (request.type === 'Request Approval') { %>
                    <span class="type-badge" style="padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 500; background: #dbeafe; color: #1e40af;">
                      Approval
                    </span>
                  <% } else { %>
                    <span class="type-badge" style="padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 500; background: #fef3c7; color: #92400e;">
                      Service
                    </span>
                  <% } %>
                </td>
                <td data-label="User"><%= displayUserName %></td>
                <td data-label="Title"><div class="table-cell-wrapper"><%= request.title %></div></td>
                <td data-label="Organization"><div class="table-cell-wrapper"><%= request.displayOrganization || request.organization %></div></td>
                <td data-label="Status">
                  <span class="status-badge <%= request.status.toLowerCase().replace(/\s+/g, '-') %>">
                    <%= request.status %>
                  </span>
                </td>
                <td data-label="Assigned Units"><%= request.assignedUnits || 'Not yet assigned' %></td>
                <td data-label="Submitted"><%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %></td>
                <td data-label="Deadline"><%= formattedDeadline %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>

          <% if (allRequests.length === 0) { %>
          <div style="text-align: center; padding: 2rem; color: #6b7280;">
            <p>No requests found.</p>
          </div>
          <% } %>
        </section>

        <!-- Back to Dashboard Button -->
        <div class="back-to-dashboard-container">
          <a href="/admin" class="back-to-dashboard-btn">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Back to Dashboard
          </a>
          
          <!-- Pagination Controls -->
          <div class="pagination-controls" id="paginationControls">
            <button class="pagination-btn pagination-nav" id="prevPageBtn" disabled>
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M15 19l-7-7 7-7"/>
              </svg>
            </button>
            <div class="pagination-numbers" id="paginationNumbers">
              <!-- Page numbers will be inserted here by JavaScript -->
            </div>
            <button class="pagination-btn pagination-nav" id="nextPageBtn" disabled>
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
          
          <button class="trash-btn" onclick="openTrashModal()" title="View Deleted Requests">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            Trash
          </button>
        </div>
      </section>
    </div>
  </div>

  <!-- Trash Modal -->
<div id="trashModal" class="modal" style="display:none;">
  <div class="modal-content trash-modal-content">
    <div class="modal-header unit-modal-header trash-header-color">
      <div class="modal-title-section">
        <svg class="modal-title-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        <h2>Deleted Requests</h2>
      </div>
      <button class="close-modal-btn" onclick="closeTrashModal()" aria-label="Close">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="trash-modal-body">
      <div class="trash-info-banner">
        <svg viewBox="0 0 24 24" fill="none" style="width: 20px; height: 20px; margin-right: 10px;">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" fill="#0891b2"/>
        </svg>
        <span>These requests are hidden from active views. You can restore or permanently delete them.</span>
      </div>

      <div class="trash-table-container">
        <table class="trash-requests-table">
          <thead>
            <tr>
              <th>Type</th>
              <th>Title</th>
              <th>Organization</th>
              <th>Requester</th>
              <th>Deleted By</th>
              <th>Deleted On</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="trashTableBody">
            <!-- Populated by JavaScript -->
          </tbody>
        </table>
        <div id="trashEmptyState" class="trash-empty-state" style="display: none;">
          <svg viewBox="0 0 24 24" fill="none" style="width: 48px; height: 48px; margin-bottom: 16px; opacity: 0.5;">
            <path d="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z" fill="currentColor"/>
          </svg>
          <p style="font-size: 18px; font-weight: 600; margin-bottom: 8px;">No deleted requests</p>
          <p style="color: #6b7280;">Deleted requests will appear here</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Restore Confirmation Modal -->
<div id="restoreConfirmModal" class="confirmation-modal">
  <div class="confirmation-modal-content">
    <div class="confirmation-header">
      <h3>Confirm Restore</h3>
      <button class="modal-close" onclick="closeRestoreModal()">✕</button>
    </div>
    <div class="confirmation-body">
      <p id="restoreConfirmMessage">Are you sure you want to restore this request? It will be moved back to the active requests list.</p>
      <div class="confirmation-actions">
        <button class="btn-cancel" onclick="closeRestoreModal()">Cancel</button>
        <button id="confirmRestoreBtn" class="btn-confirm" onclick="confirmRestore()">Restore Request</button>
      </div>
    </div>
  </div>
</div>

<!-- Permanent Delete Confirmation Modal -->
<div id="permanentDeleteModal" class="confirmation-modal">
  <div class="confirmation-modal-content">
    <div class="confirmation-header warning">
      <h3>⚠️ Confirm Permanent Deletion</h3>
      <button class="modal-close" onclick="closePermanentDeleteModal()">✕</button>
    </div>
    <div class="confirmation-body">
      <p style="color: #dc2626; font-weight: 600;">This action cannot be undone!</p>
      <p id="permanentDeleteMessage">Are you sure you want to permanently delete this request? All associated data will be lost forever.</p>
      <div class="confirmation-actions">
        <button class="btn-cancel" onclick="closePermanentDeleteModal()">Cancel</button>
        <button id="confirmPermanentDeleteBtn" class="btn-danger" onclick="confirmPermanentDelete()">Delete Forever</button>
      </div>
    </div>
  </div>
</div>

  <!-- Enhanced Request Details Modal -->
  <div id="detailsModal" class="modal" style="display:none;">
    <div class="modal-content unit-modal-wide">
      <!-- Modal Header -->
      <div class="modal-header unit-modal-header" id="modalHeader">
        <div class="modal-title-section">
          <svg class="modal-title-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="4" y="4" width="16" height="16" rx="2"/>
            <line x1="8" y1="8" x2="16" y2="8"/>
            <line x1="8" y1="12" x2="16" y2="12"/>
            <line x1="8" y1="16" x2="12" y2="16"/>
          </svg>
          <h2 id="modalTitle">Request Details</h2>
          <span class="type-badge" id="modalTypeBadge">REQUEST</span>
        </div>
        <div class="modal-header-actions">
          <button class="modal-action-btn edit-btn" onclick="openEditMode()" title="Edit Request">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            Edit
          </button>
          <button class="modal-action-btn delete-btn" onclick="openDeleteConfirm()" title="Delete Request">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
            Delete
          </button>
          <button class="close-modal-btn" onclick="document.getElementById('detailsModal').style.display='none'" aria-label="Close">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Two Column Layout -->
      <div class="modal-body unit-modal-body">
        <!-- LEFT COLUMN: Request Details -->
        <div class="unit-left-column">
          
          <!-- General Information Section -->
          <div class="admin-info-card general-info-section">
            <h3>General Information</h3>
            <div class="general-info-row">
              <div class="info-item">
                <span class="info-label">Project Title:</span>
                <span class="info-value" id="detailTitle"></span>
              </div>
              <div class="info-item">
                <span class="info-label">Requested By:</span>
                <span class="info-value" id="detailStudent"></span>
              </div>
              <div class="info-item">
                <span class="info-label">Request Type:</span>
                <span class="info-value" id="detailType"></span>
              </div>
              <div class="info-item">
                <span class="info-label">Specific Request Type:</span>
                <span class="info-value" id="detailSpecificRequest" style="color: var(--primary-green); font-weight: 600;">Not specified</span>
              </div>
              <div class="info-item">
                <span class="info-label">Organization:</span>
                <span class="info-value" id="detailOrganization"></span>
              </div>
              <div class="info-item">
                <span class="info-label">Date Submitted:</span>
                <span class="info-value" id="detailDatetime"></span>
              </div>
              <div class="info-item" id="deadlineInfo" style="display: none;">
                <span class="info-label">Deadline:</span>
                <span class="info-value" id="detailDeadlineInfo"></span>
              </div>
            </div>
          </div>

          <!-- Admin Controls Form Section -->
          <div class="admin-form-section">
            <h3>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
              </svg>
              Administrative Controls
              <span class="admin-badge">EDIT & UPDATE</span>
            </h3>

            <form id="adminUpdateForm" onsubmit="return false;">
              <div class="admin-form-grid">
                <!-- Status Field -->
                <div class="form-field">
                  <label for="adminStatusSelect">Request Status</label>
                  <select id="adminStatusSelect" name="status">
                    <% (requestStatuses || []).forEach(function(status) { %>
                      <option value="<%= status %>"><%= status %></option>
                    <% }); %>
                  </select>
                  <div class="current-value">
                    Current: <span id="currentStatusValue">Loading...</span>
                  </div>
                </div>

                <!-- Assigned Units Field -->
                <div class="form-field">
                  <label for="adminUnitsSelect">Assigned Unit</label>
                  <select id="adminUnitsSelect" name="assignedUnits">
                    <option value="">Not yet assigned</option>
                    <% (units || []).forEach(function(unit) { %>
                      <option value="<%= unit %>"><%= unit %></option>
                    <% }); %>
                  </select>
                  <div class="current-value">
                    Current: <span id="currentUnitsValue">Loading...</span>
                  </div>
                </div>

                <!-- Deadline Field (for Service Requests only) -->
                <div class="form-field" id="adminDeadlineField" style="display: none;">
                  <label for="adminDeadlineInput">Request Deadline</label>
                  <input type="datetime-local" id="adminDeadlineInput" name="deadline">
                  <div class="current-value">
                    Current: <span id="currentDeadlineValue">Loading...</span>
                  </div>
                </div>
              </div>

              <div class="admin-form-actions">
                <button type="button" class="admin-btn admin-btn-secondary" id="adminCancelBtn">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                  Cancel Changes
                </button>
                <button type="button" class="admin-btn admin-btn-primary" id="adminUpdateBtn">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                    <polyline points="17,21 17,13 7,13 7,21"/>
                    <polyline points="7,3 7,8 15,8"/>
                  </svg>
                  Update Request
                </button>
              </div>
            </form>
          </div>

          <!-- Description Section -->
          <div class="admin-info-card description-section">
            <div class="admin-card-header">
              <h3>Project Description</h3>
              <p class="admin-card-subtitle">Request details and requirements</p>
            </div>
            <div class="description-content" id="detailDescription"></div>
          </div>

          <!-- Files Section -->
          <div id="file-preview"></div>
        </div>

        <!-- RIGHT COLUMN: Processing Actions -->
        <div class="unit-right-column">
          
          <!-- Team Conversation Button -->
          <div class="unit-info-card unit-conversation-trigger">
            <button id="openChatFromModal" class="unit-chat-button">
              <span class="unit-chat-icon">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
              </span>
              <div class="unit-chat-text">
                <strong>Open Request Discussion</strong>
                <small>Communicate with users and units</small>
              </div>
              <span class="unit-chat-arrow">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
            </button>
          </div>

          <!-- Revision History Section (appears in right column) -->
          <div id="revisionHistorySection" class="unit-action-panel revision-history-panel">
            <div class="unit-panel-header revision-header">
              <h3>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline; margin-right: 8px; vertical-align: -3px;">
                  <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                  <path d="M21 3v5h-5"/>
                  <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                  <path d="M3 21v-5h5"/>
                </svg>
                Revision History
              </h3>
              <p>Complete timeline of all revisions and resubmissions</p>
            </div>
            <div id="revisionHistoryContainer" class="revision-history-timeline">
              <!-- Dynamically populated by JavaScript -->
            </div>
          </div>

          <!-- Additional File Upload Toggle -->
          <div id="additionalFileToggleSection" class="admin-action-panel" style="display: none;">
            <div style="background: #f0fdf4; border-radius: 8px; padding: 1rem; margin: 1rem 0; border: 1px solid #bbf7d0;">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <label class="toggle-switch" style="margin: 0;">
                  <input type="checkbox" id="toggleAdditionalFileUploadBtn" checked>
                  <span class="toggle-slider"></span>
                </label>
                <span style="font-size: 0.9rem; color: #166534; font-weight: 500;">Allow users to upload additional files</span>
              </div>
              <div style="font-size: 0.8rem; color: #6b7280; margin-top: 0.25rem;">
              This will permit users to add more files when revising their requests
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>  <!-- Team Conversation Modal -->
  <div id="teamConversationModal" class="modal" style="display: none;">
    <div class="modal-content unit-conversation-modal">
      <div class="modal-header unit-modal-header">
        <div class="modal-title-section">
          <svg class="modal-title-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <h2>Request Discussion</h2>
          <span class="unit-conversation-subtitle">Communicate with users and units</span>
        </div>
        <button class="close-modal-btn" onclick="closeTeamConversationModal()" aria-label="Close">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      
      <div class="unit-conversation-body">
        <!-- Messages Container -->
        <div id="teamMessagesContainer" class="unit-messages-container">
          <div class="unit-messages-empty">
            <div class="empty-icon">
              <svg width="48" height="48" fill="none" stroke="#94a3b8" stroke-width="2" viewBox="0 0 24 24">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
            </div>
            <p>No discussion yet</p>
            <small>Start the conversation below</small>
          </div>
        </div>

        <!-- Message Input Area -->
        <div class="unit-message-input-area">
          <!-- Formatting Toolbar -->
          <div class="unit-format-toolbar">
            <button type="button" class="format-btn" data-chat-format="bold" title="Bold">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/>
                <path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/>
              </svg>
            </button>
            <button type="button" class="format-btn" data-chat-format="italic" title="Italic">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="19" y1="4" x2="10" y2="4"/>
                <line x1="14" y1="20" x2="5" y2="20"/>
                <line x1="15" y1="4" x2="9" y2="20"/>
              </svg>
            </button>
            <button type="button" class="format-btn" data-chat-format="underline" title="Underline">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3"/>
                <line x1="4" y1="21" x2="20" y2="21"/>
              </svg>
            </button>
            <div class="toolbar-divider"></div>
            <button type="button" id="chatAttachBtn" class="format-btn" title="Attach Files">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
              </svg>
            </button>
            <input type="file" id="chatFileInput" multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.webp,.xls,.xlsx,.txt" style="display: none;">
            <span class="toolbar-hint">Format your message</span>
          </div>

          <!-- Attached Files Preview -->
          <div id="chatFilesPreview" class="chat-files-preview" style="display: none;">
            <div class="files-preview-header">
              <span class="files-count">0 file(s) attached</span>
              <button type="button" id="clearChatFiles" class="clear-files-btn">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
                Clear all
              </button>
            </div>
            <div id="chatFilesContainer" class="files-container"></div>
          </div>

          <!-- Message Input -->
          <div class="unit-message-input-wrapper">
            <div id="teamMessageInput" contenteditable="true" role="textbox" aria-multiline="true" placeholder="Type your message..." class="unit-message-input"></div>
            <button id="sendTeamMessageBtn" class="unit-send-btn">
              <span>Send</span>
              <svg class="send-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Define current user role for conversation
    window.currentUserRole = 'admin';
  </script>

