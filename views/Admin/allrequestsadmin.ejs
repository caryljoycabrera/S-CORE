<script src="/javascripts/ejs/admin-trash-modal.js"></script>
<script>
  // Initialize trash modal for all requests page
  document.addEventListener('DOMContentLoaded', function() {
    if (window.AdminTrashModal) {
      window.AdminTrashModal.init({
        entityType: 'requests',
        fetchEndpoint: '/api/admin/deleted-requests',
        restoreEndpoint: '/admin/request/restore',
        permanentDeleteEndpoint: '/admin/request/permanent-delete',
        typeFilter: 'all',
        reloadOnRestore: true
      });
    }

    // Add event listener for trash button
    const trashBtn = document.getElementById('trashBtn');
    if (trashBtn) {
      trashBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        window.openTrashModal();
      });
    }
  });
</script>

