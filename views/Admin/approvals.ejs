<!-- Edit Request Modal -->
<div id="editRequestModal" class="confirmation-modal">
  <div class="confirmation-modal-content edit-modal-content">
    <div class="confirmation-header">
      <div class="modal-title-section">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; margin-right: 8px;">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
        </svg>
        <h3 style="display: inline-block; vertical-align: middle; margin: 0;">Edit Request</h3>
      </div>
      <div class="modal-header-actions">
        <button class="close-modal-btn" onclick="closeEditModal()" aria-label="Close">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
    <div class="confirmation-body edit-modal-body">
      <!-- Non-editable Requestor Information -->
      <div class="edit-info-section">
        <h4 style="margin: 0 0 12px 0; font-size: 14px; font-weight: 700; color: #374151; display: flex; align-items: center; gap: 8px;">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="8.5" cy="7" r="4"></circle>
            <line x1="20" y1="8" x2="20" y2="14"></line>
            <line x1="23" y1="11" x2="17" y2="11"></line>
          </svg>
          Requestor Information (Read-only)
        </h4>
        <div class="edit-readonly-grid">
          <div class="edit-readonly-item">
            <span class="edit-readonly-label">Requested By:</span>
            <span class="edit-readonly-value" id="editRequestor">Loading...</span>
          </div>
          <div class="edit-readonly-item">
            <span class="edit-readonly-label">Organization:</span>
            <span class="edit-readonly-value" id="editOrganizationReadonly">Loading...</span>
          </div>
          <div class="edit-readonly-item">
            <span class="edit-readonly-label">Request Type:</span>
            <span class="edit-readonly-value" id="editRequestType">Request Approval</span>
          </div>
          <div class="edit-readonly-item">
            <span class="edit-readonly-label">Date Submitted:</span>
            <span class="edit-readonly-value" id="editDateSubmitted">Loading...</span>
          </div>
          <div class="edit-readonly-item" id="editSpecificTypeContainer" style="display: none;">
            <span class="edit-readonly-label">Specific Type:</span>
            <span class="edit-readonly-value" id="editSpecificType">N/A</span>
          </div>
        </div>
      </div>

      <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 20px 0;">

      <!-- Editable Form -->
      <form id="editRequestForm">
        <div class="edit-form-group">
          <label for="editTitle">Title <span class="required">*</span></label>
          <input type="text" id="editTitle" required class="edit-input" placeholder="Enter request title">
        </div>
        
        <div class="edit-form-group">
          <label for="editDescription">Description <span class="required">*</span></label>
          <textarea id="editDescription" required class="edit-textarea" rows="5" placeholder="Enter detailed description"></textarea>
        </div>
        
        <div class="edit-form-group">
          <label for="editSpecificRequestType">Specific Request Type</label>
          <div style="display: flex; gap: 1rem; align-items: flex-start;">
            <div style="flex: 1;">
              <select id="editSpecificRequestType" class="edit-input" style="margin-bottom: 0.5rem; width: 100%; padding: 0.75rem; border: 1px solid #e5e7eb; border-radius: 8px;">
                <option value="">Select type</option>
              </select>
              <small style="color: #6b7280; font-size: 0.875rem;">Choose from approved request types</small>
            </div>
            <div style="flex: 0 0 auto; padding-top: 0.5rem;"><span style="color: #6b7280; font-size: 0.875rem;">or</span></div>
            <div style="flex: 1;">
              <input type="text" id="editCustomRequestType" class="edit-input" style="margin-bottom: 0.5rem;" placeholder="Enter custom type..." maxlength="100">
              <small style="color: #6b7280; font-size: 0.875rem;">Custom types need approval</small>
            </div>
          </div>
          <input type="hidden" id="editFinalRequestType" name="editFinalRequestType">
        </div>
        
        <div class="edit-form-row">
          <div class="edit-form-group">
            <label for="editDeadline">Deadline</label>
            <input type="date" id="editDeadline" class="edit-input">
          </div>
          <div class="edit-form-group" id="editLinksContainer" style="display: none;">
            <label for="editLinks">Links</label>
            <input type="text" id="editLinks" class="edit-input" placeholder="Separate multiple links with commas">
            <small style="color: #6b7280; font-size: 12px; margin-top: 4px; display: block;">Enter URLs separated by commas</small>
          </div>
        </div>

        <div class="confirmation-actions">
          <button type="button" class="btn-cancel" onclick="closeEditModal()">Cancel</button>
          <button type="submit" class="btn-confirm">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; margin-right: 6px;">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteConfirmModal" class="confirmation-modal">
  <div class="confirmation-modal-content">
    <div class="confirmation-header" style="background-color: #dc2626; color: white;">
      <h3>
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; margin-right: 8px;">
          <circle cx="12" cy="12" r="10"/>
          <line x1="15" y1="9" x2="9" y2="15"/>
          <line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
        Archive Request
      </h3>
      <button class="modal-close" onclick="closeDeleteConfirm()">✕</button>
    </div>
    <div class="confirmation-body">
      <div style="background: #fee2e2; border-left: 4px solid #dc2626; padding: 1rem; margin-bottom: 1rem; border-radius: 8px;">
        <p style="margin: 0; color: #991b1b; font-size: 0.95rem;">
          <strong>Warning:</strong> This action will move the request to archive. The request will be hidden from active views but can be restored later.
        </p>
      </div>
      <p>Are you sure you want to archive this request?</p>
        <div style="margin-top: 15px;">
          <label for="archiveReason" style="display:block; margin-bottom:5px; font-weight:bold; color:#374151;">Archiving Reason (Required)</label>
          <textarea id="archiveReason" rows="3" placeholder="Explain why this request is being archived" style="width:100%; border:1px solid #d1d5db; border-radius:6px; padding:8px; font-size:14px; box-sizing:border-box;" required></textarea>
        </div>

      <div class="confirmation-actions" style="margin-top: 24px;">
        <button class="btn-cancel" onclick="closeDeleteConfirm()">Cancel</button>
        <button class="btn-danger" onclick="confirmDelete()">Archive Request</button>
      </div>
    </div>
  </div>
</div>

