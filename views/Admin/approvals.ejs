}

.search-input:focus {
  outline: none;
  border-color: var(--primary-green);
  box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.1);
}

.options-container {
  max-height: 200px;
  overflow-y: auto;
  padding: 0.25rem 0;
}

.dropdown-option {
  display: flex;
  align-items: center;
  padding: 0.5rem 0.75rem;
