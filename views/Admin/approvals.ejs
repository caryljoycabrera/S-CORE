<!-- Create Request Modal -->
<div id="requestModal" class="modal" style="display:none;">
  <div class="modal-content unit-modal-wide">
    <div class="modal-header unit-modal-header approval-header-color">
      <div class="modal-title-section">
        <svg class="modal-title-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
        </svg>
        <h2 class="modal-title">Create a Request for Approval</h2>
        <span class="type-badge">APPROVAL</span>
      </div>
      <button class="close-modal-btn" onclick="document.getElementById('requestModal').style.display='none'" aria-label="Close">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <form class="modal-form" action="/submit-request-approval" method="POST" id="requestForm" onsubmit="return handleFormSubmit(event)">
        <div class="form-group full-width" style="position: relative;">
          <label for="requestForUser">Create Request For User: <span style="color: #6b7280; font-weight: 400;">(Optional)</span></label>
          <input type="text" id="requestForUser" name="requestForUser" placeholder="Search user by name or email..." autocomplete="off" />
          <div id="userSuggestionsDropdown" class="user-suggestions-dropdown" style="display: none;"></div>
          <input type="hidden" id="requestForUserId" name="requestForUserId" />
          <small style="color: #6b7280; margin-top: 0.25rem; display: block;">Type to search for a user to create this request on their behalf. Leave empty to create it yourself as admin (e.g., an internal task for a unit).</small>
        </div>

        <div class="form-group">
          <label for="projectTitle">Project/Event Title:</label>
          <input type="text" id="projectTitle" name="projectTitle" required placeholder="Enter project or event title..." />
        </div>

        <div class="form-group" id="organizationGroup">
          <label for="organization">Organization/Office/Dept:</label>
          <input type="text" id="organization" name="organization" placeholder="Enter organization/office/dept... (optional)" />
          <small id="organizationHint" style="color: #6b7280; margin-top: 0.25rem; display: block;">Optional — auto-filled when you select a user above.</small>
        </div>

        <div class="form-group full-width">
          <label for="specificRequestType">Select Specific Request Type:</label>
          <small style="color: #6b7280; margin-bottom: 0.5rem; display: block;">These are the specific request types offered under each unit's category (configured in Units &amp; Request Types Management). Picking one pinpoints the recommended unit below.</small>
          <div style="display: flex; gap: 1rem; align-items: flex-start;">
            <div style="flex: 1;">
              <select id="specificRequestType" name="specificRequestType" class="form-control" required
                onchange="
                  const custom = document.getElementById('customRequestType');
                  if(this.value) {
                    custom.value = '';
                    custom.name = '';
                    this.name = 'specificRequestType';
                  }
                ">
                <option value="" disabled selected>Select request type...</option>
              </select>
            </div>
            <div style="flex: 0 0 auto; padding-top: 0.5rem;"><span style="color: #6b7280; font-size: 0.875rem;">or</span></div>
            <div style="flex: 1;">
              <input type="text" id="customRequestType" class="form-control" placeholder="Or enter custom type..." maxlength="100"
                oninput="
                  const select = document.getElementById('specificRequestType');
                  if(this.value.trim() !== '') {
                    select.removeAttribute('required');
                    select.value = '';
                    select.name = '';
                    this.name = 'specificRequestType';
                  } else {
                    select.setAttribute('required', 'required');
                    this.name = '';
                    select.name = 'specificRequestType';
                  }
                ">
            </div>
          </div>
        </div>

        <div class="form-group full-width">
          <label for="assignedUnitSelect">Assign to Unit:</label>
          <select id="assignedUnitSelect" name="assignedUnits" class="form-control">
            <option value="" selected>Auto-assign based on request type</option>
            <% units.forEach(unit => { %>
              <option value="<%= unit %>"><%= unit %></option>
            <% }); %>
          </select>
          <small id="recommendedUnitHint" class="recommended-unit-hint">Pick a request type to see the recommended unit, or choose a unit yourself.</small>
        </div>

        <div class="form-group full-width">
          <label>Relevant Links (Optional):</label>
          <div id="linksContainer">
            <div class="link-item">
              <input type="url" class="link-input" placeholder="Enter URL (e.g., https://drive.google.com/...)" />
              <button type="button" class="remove-link-btn" onclick="this.parentElement.remove()" style="display:none;">×</button>
            </div>
          </div>
          <button type="button" class="add-link-btn" onclick="addAdminLinkInput()">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add Link
          </button>
        </div>

        <div class="form-group full-width">
          <label for="description">Description:</label>
          <div id="descriptionEditor" style="background: white; min-height: 150px; border: 1px solid #e2e8f0; border-radius: 8px;"></div>
          <input type="hidden" id="description" name="description" required>
        </div>

        <div id="createRequestFormError" style="display: none; grid-column: 1 / -1; background: #fee2e2; border: 1px solid #fecaca; border-left: 4px solid #dc2626; border-radius: 8px; padding: 0.75rem 1rem; color: #991b1b; font-size: 0.9rem; font-weight: 500;"></div>

        <div class="form-actions">
          <button type="button" id="cancelModalBtn">Cancel</button>
          <button type="submit">Submit Request</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Permanent Delete Confirmation Modal -->
<div id="permanentDeleteModal" class="confirmation-modal">
  <div class="confirmation-modal-content">
    <div class="confirmation-header warning">
      <h3>⚠️ Confirm Permanent Deletion</h3>
      <button class="modal-close" onclick="closePermanentDeleteModal()">✕</button>
    </div>
    <div class="confirmation-body">
      <p style="color: #dc2626; font-weight: 600;">This action cannot be undone!</p>
      <p>Are you sure you want to permanently delete this request? All associated data will be lost forever.</p>
      <div class="confirmation-actions">
        <button class="btn-cancel" onclick="closePermanentDeleteModal()">Cancel</button>
        <button class="btn-danger" onclick="confirmPermanentDelete()">Delete Forever</button>
      </div>
    </div>
  </div>
</div>

<script>
// ===== QUILL RICH TEXT EDITOR FOR CREATE REQUEST MODAL =====
let approvalDescriptionQuill = null;

// Unit recommendations from system configuration (Units & Request Types Management)
const unitRecommendations = <%- JSON.stringify(requestTypeMappings || []) %>;

function getRecommendedUnit(requestType) {
  const mapping = unitRecommendations.find(m => m.requestType === requestType);
  return mapping ? mapping.recommendedUnit : '';
}

function updateRecommendedUnit() {
  const typeSelect = document.getElementById('specificRequestType');
  const customType = document.getElementById('customRequestType');
  const unitSelect = document.getElementById('assignedUnitSelect');
  const hint = document.getElementById('recommendedUnitHint');
  if (!unitSelect || !hint) return;

  // Reset option labels
  Array.from(unitSelect.options).forEach(opt => {
    if (opt.value) opt.textContent = opt.value;
  });

  const recommended = (customType && customType.value.trim())
    ? ''
    : getRecommendedUnit(typeSelect ? typeSelect.value : '');

  if (recommended) {
    const match = Array.from(unitSelect.options).find(opt => opt.value === recommended);
    if (match) {
      match.textContent = recommended + ' ★ Recommended';
      unitSelect.value = recommended;
    }
    hint.classList.add('has-recommendation');
    hint.textContent = 'Recommended unit for this request type: ' + recommended + '. You can still pick a different unit.';
  } else {
    hint.classList.remove('has-recommendation');
    if (customType && customType.value.trim()) {
      unitSelect.value = '';
      hint.textContent = 'No recommendation for custom request types — pick a unit, or leave on auto-assign (goes to admin inbox as Pending).';
    } else {
      hint.textContent = 'Pick a request type to see the recommended unit, or choose a unit yourself.';
    }
  }
}

document.addEventListener('DOMContentLoaded', () => {
  // Initialize Quill Editor for Description
  if (document.getElementById('descriptionEditor')) {
    approvalDescriptionQuill = new Quill('#descriptionEditor', {
      theme: 'snow',
      placeholder: 'Enter detailed description of your request...',
      modules: {
        toolbar: [
          [{ 'header': [1, 2, 3, false] }],
          ['bold', 'italic', 'underline'],
          [{ 'list': 'ordered'}, { 'list': 'bullet' }],
          ['link'],
          ['clean']
        ]
      }
    });
  }

  // Populate request types from the Units & Request Types configuration,
  // grouped by the unit category each type belongs to
  const typeSelect = document.getElementById('specificRequestType');
  if (typeSelect && unitRecommendations.length > 0) {
    const typesByUnit = {};
    unitRecommendations.forEach(mapping => {
      if (!mapping.requestType) return;
      const unit = mapping.recommendedUnit || 'Other';
      (typesByUnit[unit] = typesByUnit[unit] || []).push(mapping.requestType);
    });
    Object.keys(typesByUnit).forEach(unit => {
      const group = document.createElement('optgroup');
      group.label = unit;
      typesByUnit[unit].forEach(type => {
        const option = document.createElement('option');
        option.value = type;
        option.textContent = type;
        group.appendChild(option);
      });
      typeSelect.appendChild(group);
    });
  } else if (typeSelect) {
    // Fallback: no configured mappings — load from the request-types API
    fetch('/api/request-types?requestCategory=Request Approval')
      .then(res => (res.ok ? res.json() : null))
      .then(data => {
        if (!data || !data.types) return;
        data.types.forEach(type => {
          const option = document.createElement('option');
          option.value = type.name || type;
          option.textContent = type.name || type;
          typeSelect.appendChild(option);
        });
      })
      .catch(err => console.warn('Error loading request types:', err));
  }

  // Recommend a unit whenever the request type changes
  document.getElementById('specificRequestType')?.addEventListener('change', updateRecommendedUnit);
  document.getElementById('customRequestType')?.addEventListener('input', updateRecommendedUnit);
});

// ===== ORGANIZATION AUTO-FILL FROM SELECTED USER =====
function collectUserOrganizations(selectedUser) {
  const splitList = (value) => {
    if (Array.isArray(value)) {
      return value.flatMap(v => String(v).split(',')).map(o => o.trim()).filter(Boolean);
    }
    if (typeof value === 'string') {
      return value.split(',').map(o => o.trim()).filter(Boolean);
    }
    return [];
  };

  let orgs = [];
  if (selectedUser.userType === 'student') {
    orgs = splitList(selectedUser.studentOrganization);
  } else {
    orgs = splitList(selectedUser.affiliation)
      .concat(splitList(selectedUser.office))
      .concat(splitList(selectedUser.department));
  }
  return [...new Set(orgs)];
}

// Reset the organization control back to a plain text input; returns the input
function resetOrganizationControl() {
  const wrapper = document.getElementById('organizationSelect');
  const current = document.getElementById('organization');
  const input = document.createElement('input');
  input.type = 'text';
  input.id = 'organization';
  input.name = 'organization';
  input.placeholder = 'Enter organization/office/dept... (optional)';
  if (wrapper) {
    wrapper.replaceWith(input);
  } else if (current) {
    input.className = current.className;
    current.replaceWith(input);
  }
  window.adminRequestAllowedOrgs = null;
  return input;
}

// Called when the "create for user" field is cleared: org becomes optional free text
window.onAdminRequestUserCleared = function() {
  const hint = document.getElementById('organizationHint');
  const input = resetOrganizationControl();
  input.required = false;
  if (hint) hint.textContent = 'Optional — auto-filled when you select a user above.';
};

// Build a searchable dropdown so the admin picks exactly one of the user's orgs
function buildOrganizationDropdown(currentInput, orgs) {
  const wrapper = document.createElement('div');
  wrapper.className = 'org-select';
  wrapper.id = 'organizationSelect';
  wrapper.innerHTML =
    '<button type="button" class="org-select-toggle">' +
      '<span class="org-select-value org-select-placeholder">Select organization/office/dept...</span>' +
      '<span class="org-select-arrow">▼</span>' +
    '</button>' +
    '<div class="org-select-menu" style="display:none;">' +
      '<input type="text" class="org-select-search" placeholder="Search organizations/offices/depts...">' +
      '<div class="org-select-options"></div>' +
    '</div>';
  const hidden = document.createElement('input');
  hidden.type = 'hidden';
  hidden.id = 'organization';
  hidden.name = 'organization';
  wrapper.appendChild(hidden);
  currentInput.replaceWith(wrapper);

  const menu = wrapper.querySelector('.org-select-menu');
  const search = wrapper.querySelector('.org-select-search');
  const optionsBox = wrapper.querySelector('.org-select-options');
  const valueLabel = wrapper.querySelector('.org-select-value');

  function renderOptions(filter) {
    optionsBox.innerHTML = '';
    const q = (filter || '').toLowerCase();
    orgs.filter(o => o.toLowerCase().includes(q)).forEach(org => {
      const opt = document.createElement('div');
      opt.className = 'org-select-option' + (org === hidden.value ? ' selected' : '');
      opt.textContent = org;
      opt.addEventListener('click', function() {
        hidden.value = org;
        valueLabel.textContent = org;
        valueLabel.classList.remove('org-select-placeholder');
        menu.style.display = 'none';
      });
      optionsBox.appendChild(opt);
    });
    if (!optionsBox.children.length) {
      const empty = document.createElement('div');
      empty.className = 'org-select-empty';
      empty.textContent = 'No matches';
      optionsBox.appendChild(empty);
    }
  }

  wrapper.querySelector('.org-select-toggle').addEventListener('click', function() {
    const isOpen = menu.style.display !== 'none';
    menu.style.display = isOpen ? 'none' : 'block';
    if (!isOpen) {
      search.value = '';
      renderOptions('');
      search.focus();
    }
  });
  search.addEventListener('input', function() { renderOptions(search.value); });
  renderOptions('');
}

// Single delegated listener closes the dropdown on outside click
document.addEventListener('click', function(e) {
  const wrapper = document.getElementById('organizationSelect');
  if (wrapper && !wrapper.contains(e.target)) {
    const menu = wrapper.querySelector('.org-select-menu');
    if (menu) menu.style.display = 'none';
  }
});

// Called by approvals.js when the admin picks a user from the suggestions
window.onAdminRequestUserSelected = function(selectedUser) {
  const hint = document.getElementById('organizationHint');
  const input = resetOrganizationControl();
  const orgs = collectUserOrganizations(selectedUser);

  if (orgs.length === 1) {
    // Exactly one org: auto-fill, read-only
    input.value = orgs[0];
    input.readOnly = true;
    input.required = true;
    if (hint) hint.textContent = 'Auto-filled from the selected user\'s profile.';
  } else if (orgs.length > 1) {
    // Multiple orgs: searchable dropdown, admin picks exactly one
    buildOrganizationDropdown(input, orgs);
    window.adminRequestAllowedOrgs = orgs;
    if (hint) hint.textContent = 'This user belongs to ' + orgs.length + ' organizations — pick the one this request is for.';
  } else {
    // No orgs on profile: free text, required since this request is for a user
    input.placeholder = 'Enter organization/office/dept...';
    input.required = true;
    if (hint) hint.textContent = 'No organization found on this user\'s profile — enter one manually.';
  }
};

// ===== LINKS MANAGEMENT =====
window.addAdminLinkInput = function() {
  const container = document.getElementById('linksContainer');
  const linkItem = document.createElement('div');
  linkItem.className = 'link-item';
  linkItem.innerHTML = `
    <input type="url" class="link-input" placeholder="Enter URL (e.g., https://drive.google.com/...)" />
    <button type="button" class="remove-link-btn" onclick="this.parentElement.remove()">×</button>
  `;
  container.appendChild(linkItem);
};

// ===== FORM SUBMISSION =====
window.handleFormSubmit = function(event) {
  event.preventDefault();
  const form = event.target;

  // Show validation errors inline in the form (native alert() is suppressed by alert-handler.js)
  const showFormError = (message) => {
    const err = document.getElementById('createRequestFormError');
    if (!err) { alert(message); return; }
    err.textContent = message;
    err.style.display = 'block';
    err.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };
  const errBox = document.getElementById('createRequestFormError');
  if (errBox) errBox.style.display = 'none';

  // User selection is optional: if the admin typed a name but never picked a
  // suggestion, stop them (they probably intended to select someone)
  if (document.getElementById('requestForUser').value.trim() && !document.getElementById('requestForUserId').value) {
    showFormError('Please select the user from the suggestions, or clear the field to create this request yourself as admin.');
    return false;
  }

  // When the selected user has multiple orgs, the value must be one of them
  if (window.adminRequestAllowedOrgs) {
    const orgValue = (document.getElementById('organization')?.value || '').trim();
    if (!window.adminRequestAllowedOrgs.includes(orgValue)) {
      showFormError("Please pick one of the selected user's organizations/offices/departments from the list.");
      return false;
    }
  }

  // Get Quill content
  if (approvalDescriptionQuill) {
    if (!approvalDescriptionQuill.getText().trim()) {
      showFormError('Please enter a description.');
      return false;
    }
    document.getElementById('description').value = approvalDescriptionQuill.root.innerHTML;
  }

  const formObj = Object.fromEntries(new FormData(form));
  formObj.links = Array.from(document.querySelectorAll('#linksContainer .link-input'))
    .map(input => input.value.trim())
    .filter(Boolean);

  const submitBtn = form.querySelector('button[type="submit"]');
  if (submitBtn) submitBtn.disabled = true;

  fetch('/submit-request-approval', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(formObj)
  })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        window.location.href = data.redirectUrl || '/admin/approvals?submitted=true';
      } else {
        showFormError(data.message || 'Failed to submit request.');
        if (submitBtn) submitBtn.disabled = false;
      }
    })
    .catch(err => {
      console.error('Error submitting request:', err);
      showFormError('Failed to submit request. Please try again.');
      if (submitBtn) submitBtn.disabled = false;
    });

  return false;
};

// Modal close handlers
document.getElementById('cancelModalBtn')?.addEventListener('click', () => {
  document.getElementById('requestModal').style.display = 'none';
  document.getElementById('requestForm')?.reset();
  if (approvalDescriptionQuill) approvalDescriptionQuill.setContents([]);
  updateRecommendedUnit();
});
</script>

<!-- Conversation formatting + send handler (enables WYSIWYG formatting) -->
<script>
  // Global formatting function for toolbar onclick handlers
  window.applyChatFormat = function(formatType) {
    const input = document.getElementById('messageInput');
    if (!input) return;
    if (input.tagName === 'DIV' || input.isContentEditable) {
      const cmdMap = { bold: 'bold', italic: 'italic', underline: 'underline' };
      const cmd = cmdMap[formatType];
      if (cmd && document.queryCommandSupported(cmd)) {
        input.focus();
        document.execCommand(cmd, false, null);
      }
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const messageInput = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendMessageBtn');

      // Keyboard shortcuts
      if (messageInput) {
        messageInput.addEventListener('keydown', (e) => {
          // For contenteditable, let browser handle Ctrl+B/I/U natively (WYSIWYG via execCommand)
          if (messageInput.isContentEditable && (e.ctrlKey || e.metaKey) && ['b', 'i', 'u'].includes(e.key.toLowerCase())) {
            return;
          }
          // Enter = send (without shift)
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            if (sendBtn) sendBtn.click();
          }
        });
      }

    // Send handler - sends innerHTML when contenteditable
    if (sendBtn && messageInput) {
      sendBtn.addEventListener('click', () => {
        const modal = document.getElementById('conversationModal');
        const requestId = modal?.dataset?.requestId || window.currentConversationId || window.currentRequestId;
        if (!requestId) {
          alert('No request selected. Please open a request first.');
          return;
        }

        const content = messageInput.isContentEditable
          ? (window.htmlToMarkdown ? window.htmlToMarkdown(messageInput.innerHTML) : messageInput.innerHTML.trim())
          : (messageInput.value || '').trim();
        if (!content && !currentAttachment) {
          alert('Please enter a message');
          return;
        }

        const formData = new FormData();
        formData.append('content', content || '');

        fetch(`/api/conversation/${requestId}/message`, { method: 'POST', body: formData })
          .then(resp => {
            if (!resp.ok) throw new Error('Failed to send message');
            return resp.json();
          })
          .then(data => {
            if (data.success) {
              // clear input
              if (messageInput.isContentEditable) messageInput.innerHTML = '';
              else messageInput.value = '';
              // try to reload conversation if a loader exists
              if (typeof window.loadConversation === 'function') {
                window.loadConversation(requestId);
              } else if (typeof window.loadTeamConversation === 'function') {
                window.loadTeamConversation(requestId);
              } else {
                // fallback: close and reopen modal to refresh
                const modalEl = document.getElementById('conversationModal');
                if (modalEl) {
                  // naive reload of messages container
                  const messagesContainer = document.getElementById('messagesContainer');
                  if (messagesContainer) messagesContainer.insertAdjacentHTML('beforeend', '<div style="font-size:0.9rem;color:#6b7280;margin-top:8px;">Message sent — refresh to see updates</div>');
                }
              }
            } else {
              alert(data.message || 'Failed to send message');
            }
          })
          .catch(err => {
            console.error('Error sending conversation message', err);
            alert('Failed to send message');
          });
      });
    }
  });
</script>

