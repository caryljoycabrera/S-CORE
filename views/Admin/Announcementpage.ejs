<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Announcement - S-CORE</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/stylesheets/admin-navbar.css" />
  <style>
    .announce-container { max-width: 900px; margin: 2rem auto; background: #fff; padding: 1.5rem; border-radius: 8px; box-shadow: 0 6px 24px rgba(16,24,40,0.06); }
    .form-row { margin-bottom: 1rem; }
    label { display:block; font-weight:600; margin-bottom:0.4rem; }
    input[type=text], textarea, select { width:100%; padding:0.6rem; border:1px solid #e5e7eb; border-radius:6px; font-size:1rem; }
    textarea { min-height:140px; }
    .inline { display:flex; gap:0.75rem; align-items:center; }
    .inline > * { margin:0; }
    .controls { display:flex; gap:0.5rem; margin-top:1rem; }
    .btn { background:#43a047; color:#fff; padding:0.6rem 1rem; border-radius:6px; border:none; cursor:pointer; font-weight:700; }
    .btn.secondary { background:#6b7280; }
    .note { font-size:0.9rem; color:#6b7280; }
    .hidden { display:none; }
    .user-select { height:160px; }
  </style>
</head>
<body>
  <div style="max-width:1200px;margin:1rem auto;padding:0 1rem;">
    <a href="/admin">← Back to Admin</a>
    <div class="announce-container">
      <h2>Send Announcement</h2>
      <p class="note">Create a broadcast message to specific users, an organization, or everyone.</p>

      <form method="POST" action="/admin/announcement/send">
        <div class="form-row">
          <label for="title">Title</label>
          <input id="title" name="title" type="text" placeholder="Announcement title" required />
        </div>

        <div class="form-row">
          <label for="content">Message</label>
          <textarea id="content" name="content" placeholder="Write your announcement here..." required></textarea>
        </div>

        <div class="form-row">
          <label for="priority">Priority</label>
          <select id="priority" name="priority">
            <option value="low">Low</option>
            <option value="medium" selected>Medium</option>
            <option value="high">High</option>
          </select>
        </div>

        <div class="form-row">
          <label>Recipients</label>
          <div style="display:flex;flex-direction:column;gap:0.5rem;">
            <label class="inline"><input type="radio" name="recipientType" value="all" checked onchange="onRecipientChange()"> All users</label>
            <label class="inline"><input type="radio" name="recipientType" value="organization" onchange="onRecipientChange()"> By organization</label>
            <label class="inline"><input type="radio" name="recipientType" value="specific" onchange="onRecipientChange()"> Specific users</label>
          </div>
        </div>

        <div id="orgBlock" class="form-row hidden">
          <label for="organization">Organization</label>
          <select id="organization" name="organization">
            <option value="">-- Select organization --</option>
            <% if (Array.isArray(organizations)) { %>
              <% organizations.forEach(function(org){ %>
                <option value="<%= org %>"><%= org %></option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div id="usersBlock" class="form-row hidden">
          <label for="specificUsers">Select users (hold Ctrl/Cmd to select multiple)</label>
          <select id="specificUsers" name="specificUsers" multiple class="user-select">
            <% if (Array.isArray(users)) { %>
              <% users.forEach(function(u){ %>
                <option value="<%= u._id %>"><%= (u.fName||'') + ' ' + (u.lName||'') %> — <%= u.email || (u.organization||'') %></option>
              <% }) %>
            <% } %>
          </select>
          <div class="note">If you prefer, paste comma-separated user IDs into the field below.</div>
          <input type="text" name="specificUsers" id="specificUsersText" placeholder="userId1,userId2,..." style="margin-top:0.5rem;" />
        </div>

        <div class="controls">
          <button class="btn" type="submit">Send Announcement</button>
          <a class="btn secondary" href="/admin">Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <script>
    function onRecipientChange(){
      const val = document.querySelector('input[name="recipientType"]:checked').value;
      document.getElementById('orgBlock').classList.toggle('hidden', val !== 'organization');
      document.getElementById('usersBlock').classList.toggle('hidden', val !== 'specific');
    }

    // Initialize visibility based on default selection
    document.addEventListener('DOMContentLoaded', function(){ onRecipientChange(); });
  </script>
</body>
</html>
