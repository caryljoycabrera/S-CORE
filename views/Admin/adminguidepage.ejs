  <script>
    // Dropdown toggle functionality (navbar specific)
    function toggleDropdown() {
      const dropdown = document.getElementById('dropdownMenu');
      if (dropdown) {
        dropdown.classList.toggle('show');
      }
    }

    // Close dropdown when clicking outside
    window.addEventListener('click', function(e) {
      if (!e.target.matches('.dropdown-toggle') && !e.target.closest('.dropdown-toggle')) {
        const dropdown = document.getElementById('dropdownMenu');
        if (dropdown && dropdown.classList.contains('show')) {
          dropdown.classList.remove('show');
        }
      }
    });

    // Sidebar hover effect for desktop
    const sidebar = document.getElementById('adminSidebar');
    if (sidebar) {
      sidebar.addEventListener('mouseenter', function() {
        this.classList.add('expanded');
      });
      sidebar.addEventListener('mouseleave', function() {
        this.classList.remove('expanded');
      });
    }

    // Mobile Navigation Setup
    document.addEventListener('DOMContentLoaded', () => {
      const menuToggle = document.getElementById('adminMenuToggle');
      const sidebarEl = document.getElementById('adminSidebar');
      let touchStartX = 0;
      let touchEndX = 0;

      function initMobileNavigation() {
        if (menuToggle && sidebarEl) {
          menuToggle.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            sidebarEl.classList.toggle('mobile-active');
          });

          document.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
          }, { passive: true });

          document.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            handleSwipe();
          }, { passive: true });

          document.addEventListener('click', (e) => {
            if (window.innerWidth <= 768) {
              if (!sidebarEl.contains(e.target) && !menuToggle.contains(e.target)) {
                sidebarEl.classList.remove('mobile-active');
              }
            }
          });

          const sidebarLinks = sidebarEl.querySelectorAll('.sidebar-item, .sidebar-profile-link');
          sidebarLinks.forEach(link => {
            link.addEventListener('click', () => {
              if (window.innerWidth <= 768) {
                setTimeout(() => {
                  sidebarEl.classList.remove('mobile-active');
                }, 100);
              }
            });
          });
        }
      }

      function handleSwipe() {
        const swipeDistance = touchEndX - touchStartX;
        const minSwipeDistance = 50;

        if (swipeDistance > minSwipeDistance && touchStartX < 50) {
          sidebarEl.classList.add('mobile-active');
        } else if (swipeDistance < -minSwipeDistance && sidebarEl.classList.contains('mobile-active')) {
          sidebarEl.classList.remove('mobile-active');
        }
      }

      initMobileNavigation();
    });

    // --- NEW: Guide page interactivity ---
    function toggleSection(header) {
      const section = header.parentElement;
      section.classList.toggle('collapsed');
    }

    // TOC scroll spy — highlight active section
    document.addEventListener('DOMContentLoaded', function() {
      const tocLinks = document.querySelectorAll('.toc-link');
      const sections = [];

      tocLinks.forEach(function(link) {
        const href = link.getAttribute('href');
        if (href) {
          const id = href.substring(1); // remove #
          const el = document.getElementById(id);
          if (el) {
            sections.push({ el: el, link: link });
          }
        }
      });

      if (sections.length === 0) return;

      function updateActiveToc() {
        const scrollY = window.scrollY + 120; // offset for header
        let currentSection = sections[0];

        for (let i = 0; i < sections.length; i++) {
          const sec = sections[i];
          if (sec.el.offsetTop <= scrollY) {
            currentSection = sec;
          } else {
            break;
          }
        }

        tocLinks.forEach(function(l) { l.classList.remove('active'); });
        if (currentSection && currentSection.link) {
          currentSection.link.classList.add('active');
        }
      }

      // Throttled scroll handler
      let ticking = false;
      window.addEventListener('scroll', function() {
        if (!ticking) {
          window.requestAnimationFrame(function() {
            updateActiveToc();
            ticking = false;
          });
          ticking = true;
        }
      });

      updateActiveToc();

      // Open section from URL hash on load
      if (window.location.hash) {
        const targetId = window.location.hash.substring(1);
        const target = document.getElementById(targetId);
        if (target && target.classList.contains('guide-section')) {
          // Ensure it's not collapsed
          target.classList.remove('collapsed');
          // Scroll to it with offset
          setTimeout(function() {
            const rect = target.getBoundingClientRect();
            window.scrollBy(0, rect.top - 100);
          }, 100);
        }
      }

      // Handle TOC link clicks with smooth scroll
      tocLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
          const href = this.getAttribute('href');
          if (href && href.startsWith('#')) {
            const target = document.getElementById(href.substring(1));
            if (target) {
              e.preventDefault();
              target.classList.remove('collapsed');
              const rect = target.getBoundingClientRect();
              window.scrollBy({
                top: rect.top - 100,
                behavior: 'smooth'
              });
              history.replaceState(null, '', href);
            }
          }
        });
      });
    });
  </script>

