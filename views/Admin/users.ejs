  <script>
    // Tab switching functionality
    document.addEventListener('DOMContentLoaded', function() {
      // Set all existing users to approved status initially
      document.querySelectorAll('.user-row').forEach(row => {
        row.dataset.status = 'approved';
        const statusBadge = row.querySelector('.status-badge');
        if (statusBadge) {
          statusBadge.className = 'status-badge status-approved';
          statusBadge.textContent = 'APPROVED';
        }
      });

      // Tab click handlers
      document.querySelectorAll('.status-tab').forEach(tab => {
        tab.addEventListener('click', (e) => {
          e.preventDefault();
          const status = tab.dataset.status;
          
          // Update active tab
          document.querySelectorAll('.status-tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          
          // Filter table rows
          const rows = document.querySelectorAll('.user-row');
          rows.forEach(row => {
            if (status === 'all' || row.dataset.status === status) {
              row.style.display = '';
            } else {
              row.style.display = 'none';
            }
          });

          // Update results count
          const visibleRows = document.querySelectorAll('.user-row[style=""]').length;
          const totalRows = document.querySelectorAll('.user-row').length;
          const resultsCount = document.getElementById('resultsCount');
          if (resultsCount) {
            if (status === 'all') {
              resultsCount.textContent = `Showing all ${totalRows} users`;
            } else {
              resultsCount.textContent = `Showing ${visibleRows} of ${totalRows} users`;
            }
          }
        });
      });
    });

    // View user details
    function viewUser(userId) {
      const row = document.querySelector(`tr[data-id="${userId}"]`);
      if (row) {
        row.click(); // This will trigger the existing modal open logic
      }
    }
  </script>

