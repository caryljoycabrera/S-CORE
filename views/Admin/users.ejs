      <p id="restoreConfirmMessage" style="margin-bottom: 2rem; color: #374151; line-height: 1.6;">Are you sure you want to restore this user?</p>
      <div style="display: flex; gap: 1rem; justify-content: center;">
        <button type="button" class="user-admin-btn user-admin-btn-secondary" onclick="closeRestoreConfirm()">
          Cancel
        </button>
        <button type="button" class="user-admin-btn user-admin-btn-primary" id="confirmRestoreBtn" onclick="confirmRestore()">
          Restore
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Permanent Delete Confirmation Modal -->
<div id="permanentDeleteConfirmModal" class="modal" style="display: none;">
  <div class="modal-content" style="max-width: 500px; margin: auto;">
    <header class="modal-header">
      <span class="modal-title">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"/>
          <line x1="15" y1="9" x2="9" y2="15"/>
          <line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
        Permanently Delete User
      </span>
      <span class="close" onclick="closePermanentDeleteConfirm()">&times;</span>
    </header>
