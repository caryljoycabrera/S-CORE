        <button type="button" class="user-admin-btn user-admin-btn-secondary" onclick="closePermanentDeleteConfirm()">
          Cancel
        </button>
        <button type="button" class="user-admin-btn user-admin-btn-danger" id="confirmPermanentDeleteBtn" onclick="confirmPermanentDelete()" style="background: #dc2626; color: white;">
          Permanently Delete
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Create User Modal -->
<div id="createUserModal" class="modal" style="display:none;">
  <div class="modal-content unit-modal-wide">
    <div class="modal-header unit-modal-header">
      <div class="modal-title-section">
        <svg class="modal-title-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="8.5" cy="7" r="4"></circle>
          <line x1="20" y1="8" x2="20" y2="14"></line>
          <line x1="23" y1="11" x2="17" y2="11"></line>
        </svg>
        <h2 class="modal-title">Create User Invitation</h2>
      </div>
      <button class="close-modal-btn" id="closeCreateUserModal" aria-label="Close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <form id="createUserForm" style="display: flex; flex-direction: column; gap: 1.5rem;">
        <p style="color: #6b7280; margin: -0.5rem 0 0.5rem 0;">
          Send an invitation email to create a new user account. The user will receive a link to complete registration with auto-approval.
        </p>
        
        <!-- Email (Required) -->
        <div class="form-group">
          <label for="userEmail" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #374151;">
            Email Address <span style="color: #ef4444;">*</span>
          </label>
          <input type="email" id="userEmail" name="email" required 
                 placeholder="user@dlsud.edu.ph"
                 pattern=".*@dlsud\.edu\.ph$"
                 style="width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
          <small style="color: #6b7280; display: block; margin-top: 0.25rem;">Must be a valid @dlsud.edu.ph email address</small>
        </div>
        
        <!-- Optional fields section -->
        <div style="border-top: 2px solid #e5e7eb; padding-top: 1rem;">
          <h3 style="font-size: 16px; font-weight: 600; color: #374151; margin-bottom: 1rem;">
            Optional Pre-filled Information
          </h3>
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <!-- First Name -->
            <div class="form-group">
              <label for="userFirstName" style="display: block; font-weight: 500; margin-bottom: 0.5rem; color: #374151;">First Name</label>
              <input type="text" id="userFirstName" name="firstName" placeholder="Juan"
                     style="width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
            </div>
            
            <!-- Last Name -->
            <div class="form-group">
              <label for="userLastName" style="display: block; font-weight: 500; margin-bottom: 0.5rem; color: #374151;">Last Name</label>
              <input type="text" id="userLastName" name="lastName" placeholder="Dela Cruz"
                     style="width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
            </div>
          </div>
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;">
            <!-- Middle Name -->
            <div class="form-group">
              <label for="userMiddleName" style="display: block; font-weight: 500; margin-bottom: 0.5rem; color: #374151;">Middle Name</label>
              <input type="text" id="userMiddleName" name="middleName" placeholder="Santos"
                     style="width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
            </div>
            
            <!-- Phone Number -->
            <div class="form-group">
              <label for="userPhoneNumber" style="display: block; font-weight: 500; margin-bottom: 0.5rem; color: #374151;">Phone Number</label>
              <input type="text" id="userPhoneNumber" name="phoneNumber" placeholder="09123456789"
                     style="width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
            </div>
          </div>
          
          <!-- User Type -->
          <div class="form-group" style="margin-top: 1rem;">
            <label for="createUserType" style="display: block; font-weight: 500; margin-bottom: 0.5rem; color: #374151;">User Type</label>
            <select id="createUserType" name="userType" 
                    style="width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
              <option value="">Select user type (optional)...</option>
              <option value="student">Student</option>
              <option value="nonstudent">Staff/Faculty</option>
            </select>
          </div>
          
          <!-- Student-specific fields -->
          <div id="createStudentFields" style="display: none; margin-top: 1rem;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <div class="form-group">
                <label for="createStudentId" style="display: block; font-weight: 500; margin-bottom: 0.5rem; color: #374151;">Student ID</label>
                <input type="text" id="createStudentId" name="studentId" maxlength="9" placeholder="123456789"
                       style="width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
              </div>
              
              <div class="form-group">
                <label for="createCYS" style="display: block; font-weight: 500; margin-bottom: 0.5rem; color: #374151;">Course/Year/Section</label>
                <input type="text" id="createCYS" name="cys" placeholder="BSN21"
                       style="width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px; text-transform: uppercase;">
              </div>
            </div>
            
            <div class="form-group" style="margin-top: 1rem;">
              <label for="createStudentOrg" style="display: block; font-weight: 500; margin-bottom: 0.5rem; color: #374151;">Student Organizations</label>
              <select id="createStudentOrg" name="studentOrganization" multiple class="select2-multiple"
                      style="width: 100%;">
                <% organizationsData.forEach(org => { %>
                  <option value="<%= org %>"><%= org %></option>
                <% }); %>
              </select>
            </div>
          </div>
          
          <!-- Non-student fields -->
          <div id="createNonStudentFields" style="display: none; margin-top: 1rem;">
            <div class="form-group">
              <label for="createAffiliation" style="display: block; font-weight: 500; margin-bottom: 0.5rem; color: #374151;">Office/Department</label>
              <select id="createAffiliation" name="affiliation" multiple class="select2-multiple"
                      style="width: 100%;">
                <% officesData.forEach(office => { %>
                  <option value="<%= office %>"><%= office %></option>
                <% }); %>
              </select>
            </div>
          </div>
        </div>
        
        <div class="form-actions" style="display: flex; gap: 1rem; justify-content: flex-end; padding-top: 1rem; border-top: 2px solid #e5e7eb; margin-top: 0.5rem;">
          <button type="button" id="cancelCreateUser" class="modal-btn modal-btn-secondary">
            Cancel
          </button>
          <button type="submit" class="modal-btn modal-btn-primary" id="submitCreateUser">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Send Invitation
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Enhanced User Details Modal - Inspired by profile.ejs -->
<div id="userModal" class="modal" style="display:none;">
  <div class="modal-content">
    <header class="modal-header">
      <span class="modal-title">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
      User Profile Management
    </span>
      <div class="modal-header-actions">
        <button class="modal-action-btn edit-btn" onclick="openEditUserModal()" title="Edit User Information">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          Edit
        </button>
        <button class="modal-action-btn delete-btn" onclick="openDeleteConfirm()" title="Delete User">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          Delete
        </button>
        <button class="close-modal-btn" onclick="closeUserDetailsModal()" aria-label="Close">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </header>
    <div class="modal-body user-details-modal-body">
      <div class="user-details-content">
        
        <!-- 1. Personal Information Section -->
        <div class="user-info-section">
          <h3>
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            Personal Information
          </h3>
          <table class="user-info-table">
            <tbody>
              <tr>
                <td>User ID:</td>
                <td id="viewUserId"></td>
              </tr>
              <tr>
                <td>Full Name:</td>
                <td id="viewFullName"></td>
              </tr>
              <tr>
                <td>Username:</td>
                <td id="viewUsername"></td>
              </tr>
              <tr>
                <td>Email Address:</td>
                <td id="viewEmail"></td>
              </tr>
              <tr>
                <td>Phone Number:</td>
                <td id="viewPhone"></td>
              </tr>
              <tr>
                <td>User Type:</td>
                <td>
                  <span class="user-type-badge" id="viewUserType"></span>
                </td>
              </tr>
              <tr id="viewCysRow" style="display: none;">
                <td>Course/Year/Section:</td>
                <td id="viewCys"></td>
              </tr>
              <tr>
                <td id="viewOrgLabel">Organization:</td>
                <td>
                  <div id="viewOrganizationContainer">
                    <span id="viewOrganization"></span>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- 2. User Status Section -->
        <div class="user-admin-form-section">
          <h3>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
            User Status
            <span class="user-admin-badge" style="background: linear-gradient(135deg, #10b981, #059669);">
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M5 13l4 4L19 7"/>
              </svg>
              MANAGE ACCESS
            </span>
          </h3>
          
          <div class="user-form-grid">
            <div class="user-form-field">
              <label>Current Status</label>
              <div style="margin-top: 0.5rem;">
                <span class="status-badge" id="modalStatusBadge">PENDING</span>
              </div>
            </div>
            
            <div class="user-form-field">
              <label>Change Status</label>
              <div class="quick-action-buttons" style="margin-top: 0.5rem; display: flex; gap: 0.625rem; flex-wrap: wrap;">
                <button type="button" class="modal-approve-btn" id="modalApproveBtn" data-userid="" style="min-width: 100px;">Approve</button>
                <button type="button" class="modal-deny-btn" id="modalDenyBtn" data-userid="" style="min-width: 100px;">Deny</button>
                <button type="button" class="modal-reset-btn" id="modalResetBtn" data-userid="" style="min-width: 100px;">Reset to Pending</button>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Administrative Controls Section (Only for Approved Users) -->
        <div class="user-admin-form-section" id="adminControlsSection" style="display: none;">
          <h3>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
            </svg>
            Administrative Controls
            <span class="user-admin-badge">
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
              </svg>
              EDIT ROLE
            </span>
          </h3>        
          <form action="/admin/user/update" method="POST" id="userUpdateForm">
            <input type="hidden" name="userId" id="editUserId" />
            
            <div class="user-form-grid">
              <div class="user-form-field role-update-field">
                <label for="editRole">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                  </svg>
                  Change User Role
                </label>
                
                <div class="custom-role-dropdown" id="customRoleDropdown">
                  <div class="dropdown-selected" onclick="toggleCustomDropdown()">
                    <div class="selected-content">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                      </svg>
                      <span class="selected-text" id="selectedRoleText">Standard User - Submit & View Own Requests</span>
                    </div>
                    <svg class="dropdown-arrow" width="40" height="40" viewBox="0 0 24 24" fill="#f59e0b">
                      <path d="M7 10l5 5 5-5z"/>
                    </svg>
                  </div>
                  
                  <div class="dropdown-options" id="customDropdownOptions" style="display: none;">
                    <% if (typeof userRoles !== 'undefined' && userRoles.length > 0) { %>
                      <% userRoles.forEach(role => { %>
                        <% const roleName = typeof role === 'string' ? role : role.name; %>
                        <% const rolePerms = typeof role === 'string' ? [] : (role.permissions || []); %>
                        <% const displayText = roleName; %>
                        <% const value = rolePerms.includes('admin') ? 'admin' : (rolePerms.includes('unit') ? 'unit' : 'user'); %>
                        <div class="dropdown-option" data-value="<%= value %>" onclick="selectCustomRole('<%= value %>', '<%= displayText %>')">
                          <% if (value === 'user') { %>
                            <svg width="16" height="16" fill="none" stroke="#3b82f6" stroke-width="2" viewBox="0 0 24 24">
                              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                              <circle cx="12" cy="7" r="4"/>
                            </svg>
                          <% } else if (value === 'unit') { %>
                            <svg width="16" height="16" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24">
                              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                              <circle cx="9" cy="7" r="4"></circle>
                              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                          <% } else if (value === 'admin') { %>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b">
                              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                            </svg>
                          <% } %>
                          <span><%= displayText %></span>
                        </div>
                      <% }) %>
                    <% } else { %>
                      <!-- Fallback to hardcoded if not loaded -->
                      <div class="dropdown-option" data-value="user" onclick="selectCustomRole('user', 'Requestor (User) - Submits requests')">
                        <svg width="16" height="16" fill="none" stroke="#3b82f6" stroke-width="2" viewBox="0 0 24 24">
                          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                          <circle cx="12" cy="7" r="4"/>
                        </svg>
                        <span>Requestor (User) - Submits requests</span>
                      </div>
                      <div class="dropdown-option" data-value="unit" onclick="selectCustomRole('unit', 'Unit Member - Works on tasks')">
                        <svg width="16" height="16" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24">
                          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                          <circle cx="9" cy="7" r="4"></circle>
                          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        <span>Unit Member - Works on tasks</span>
                      </div>
                      <div class="dropdown-option" data-value="admin" onclick="selectCustomRole('admin', 'Administrator - Full System Access')">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b">
                          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                        </svg>
                        <span>Administrator - Full System Access</span>
                      </div>
                    <% } %>
                  </div>
          
          <input type="hidden" name="role" id="editRole" value="user">
        </div>
        
        <!-- Simplified Current Role Display - Just Text -->
        <div class="current-role-display">
          <span class="current-role-label">Current Role:</span>
          <span class="current-role-text" id="currentRoleDisplay">Loading...</span>
        </div>
        
        <div class="role-update-warning">
          <svg width="16" height="16" fill="none" stroke="#f59e0b" stroke-width="2" viewBox="0 0 24 24" style="display: inline-block; margin-right: 0.5rem; vertical-align: text-top;">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          <strong>Important:</strong> Changing user roles affects system access permissions. 
          Administrators have full system access and can manage all users and requests.
        </div>

        <!-- Unit Team Assignment Field (only visible when role is 'unit') -->
        <div class="user-form-field" id="unitAssignmentContainer" style="display: none; margin-top: 1.5rem;">
          <label for="editUnitTeam">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            Assign to Unit Team
          </label>
          <select name="unitTeam" id="editUnitTeam" class="filter-select" style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 0.375rem; font-size: 0.875rem;">
            <option value="N/A">N/A (No Unit)</option>
            <% if (typeof units !== 'undefined' && units.length > 0) { %>
              <% units.forEach(unit => { %>
                <option value="<%= unit %>"><%= unit %></option>
              <% }) %>
            <% } %>
          </select>
          <small style="color: #6b7280; font-size: 0.75rem; margin-top: 0.5rem; display: block;">
            Select which SCO unit team this member belongs to. They will only see tasks assigned to their specific unit.
          </small>
        </div>
      </div>
    </div>
    
    <div class="user-form-actions">
      <button type="button" class="user-admin-btn user-admin-btn-secondary" id="cancelUpdateBtn">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
        Cancel Changes
      </button>
      <button type="submit" class="user-admin-btn user-admin-btn-primary">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
          <polyline points="17,21 17,13 7,13 7,21"/>
          <polyline points="7,3 7,8 15,8"/>
        </svg>
        Save Changes
      </button>
    </div>
  </form>
</div>

<!-- Status Change Confirmation Modal - For modal action buttons -->
<div id="confirmStatusModal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width: 500px; margin: auto;">
    <header class="modal-header">
      <span class="modal-title">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 16v-4M12 8h.01"/>
        </svg>
        Confirm Status Change
      </span>
      <span class="close" id="closeConfirmModal">&times;</span>
    </header>
    <div class="modal-body" style="padding: 2rem;">
      <div id="confirmMessage" style="margin-bottom: 2rem; color: #374151; line-height: 1.6; font-size: 1rem;">
        <!-- Dynamic message will be inserted here -->
      </div>
      <div class="user-form-actions" style="justify-content: center; gap: 1rem;">
        <button type="button" id="cancelConfirmBtn" class="user-admin-btn user-admin-btn-secondary">
          Cancel
        </button>
        <button type="button" id="confirmStatusBtn" class="user-admin-btn user-admin-btn-primary">
          Confirm
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Edit User Information Modal -->
<div id="editUserModal" class="modal" style="display:none;">
  <div class="modal-content">
    <header class="modal-header">
      <span class="modal-title">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
        Edit User Information
      </span>
      <button class="close-modal-btn" onclick="closeEditUserModal()" aria-label="Close">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </header>
    
    <div class="modal-body">
      <!-- Editable Information Section -->
      <div class="edit-form-section">
        <h3>
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Editable Information
        </h3>
        
        <form id="editUserForm">
          <input type="hidden" id="editUserFormId" name="userId" />
          
          <div class="form-grid">
            <!-- Name Fields -->
            <div class="form-group">
              <label for="editFirstName">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
                First Name
              </label>
              <input type="text" id="editFirstName" name="fName" required />
            </div>
            
            <div class="form-group">
              <label for="editMiddleName">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
                Middle Name (Optional)
              </label>
              <input type="text" id="editMiddleName" name="mName" />
            </div>
            
            <div class="form-group">
              <label for="editLastName">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
                Last Name
              </label>
              <input type="text" id="editLastName" name="lName" required />
            </div>
            
            <!-- Contact Information -->
            <div class="form-group">
              <label for="editUsername">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
                Username
              </label>
              <input type="text" id="editUsername" name="username" required />
            </div>
            
            <div class="form-group">
              <label for="editEmail">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
                Email Address
              </label>
              <input type="email" id="editEmail" name="email" required />
            </div>
            
            <div class="form-group">
              <label for="editPhone">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                Phone Number (Optional)
              </label>
              <input type="tel" id="editPhone" name="phoneNumber" />
            </div>
            
            <!-- Student-specific fields -->
            <div class="form-group" id="editCysGroup" style="display: none;">
              <label for="editCys">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M12 14l9-5-9-5-9 5 9 5z"/>
                  <path d="M12 14l6.16-3.422a12.083 12.083 0 0 1 .665 6.479A11.952 11.952 0 0 0 12 20.055a11.952 11.952 0 0 0-6.824-2.998 12.078 12.078 0 0 1 .665-6.479L12 14z"/>
                </svg>
                Course/Year/Section
              </label>
              <input type="text" id="editCys" name="cys" placeholder="e.g., BSIT 3-1" />
            </div>
            
            <!-- Organization/Affiliation -->
            <div class="form-group" id="editOrgGroup">
              <label for="editOrganization" id="editOrgLabel">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5m-4 0h4"/>
                </svg>
                Organization/Affiliation
              </label>
              <select id="editOrganization" name="organization" multiple="multiple" style="width: 100%"></select>
            </div>
          </div>
        </form>
      </div>
    </div>
    
    <div class="modal-footer">
      <button type="button" class="modal-btn modal-btn-secondary" onclick="closeEditUserModal()">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
        Cancel
      </button>
      <button type="button" class="modal-btn modal-btn-primary" onclick="saveUserChanges()">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
          <polyline points="17,21 17,13 7,13 7,21"/>
          <polyline points="7,3 7,8 15,8"/>
        </svg>
        Save Changes
      </button>
    </div>
  </div>
</div>


