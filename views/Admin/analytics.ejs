<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>S-CORE Analytics & Performance Insights</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/stylesheets/notifications.css" />
  <link rel="stylesheet" href="/stylesheets/admin-navbar.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/adminpage.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/analytics.css" />
  <link rel="stylesheet" href="/stylesheets/modal-centered.css" />
  <link rel="stylesheet" href="/stylesheets/no-animations.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="/javascripts/alert-handler.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
/* NEW RULE TO FIX FLUID LAYOUT */
.student-side > .div {
  max-width: 100%;
  margin-left: 0;
  margin-right: 0;
}

/* NEW -- For small KPI cards */
.auto-fit-grid-kpi {
  display: grid;
  gap: 1.5rem;
  /* Automatically fits columns with a 300px minimum */
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
}

/* NEW -- For large charts and tables */
.auto-fit-grid-main {
  display: grid;
  gap: 1.5rem;
  /* Automatically fits columns with a 450px minimum */
  grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
}

/* FIX: Make dashboard content fluid */
.dashboard-container {
  max-width: 100%;
  margin-left: 0;
  margin-right: 0;
}

/* TABLE RESPONSIVE FIXES - Prevent content cutoff */
.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.8rem; /* Smaller base font size */
}

.data-table th,
.data-table td {
  padding: 0.6rem 0.5rem; /* Reduced padding */
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 150px; /* Prevent columns from getting too wide */
}

.data-table th {
  font-size: 0.75rem; /* Even smaller headers */
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.data-table td strong {
  font-size: 0.8rem;
  font-weight: 600;
}

.data-table .type-badge {
  font-size: 0.65rem; /* Smaller badges */
  padding: 0.25rem 0.5rem;
  white-space: nowrap;
}

.data-table .btn-view {
  font-size: 0.75rem !important; /* Smaller buttons */
  padding: 0.35rem 0.65rem !important;
  white-space: nowrap;
}

.table-title {
  font-size: 1.1rem; /* Slightly smaller title */
}

.table-subtitle {
  font-size: 0.8rem; /* Smaller subtitle */
}

/* For very small screens, make text even smaller */
@media (max-width: 1200px) {
  .data-table {
    font-size: 0.75rem;
  }

  .data-table th {
    font-size: 0.7rem;
    padding: 0.5rem 0.4rem;
  }

  .data-table td {
    font-size: 0.75rem;
    padding: 0.5rem 0.4rem;
  }

  .data-table .type-badge {
    font-size: 0.6rem;
    padding: 0.2rem 0.4rem;
  }

  .data-table .btn-view {
    font-size: 0.7rem !important;
    padding: 0.3rem 0.5rem !important;
  }
}

/* Filtered Results Section Styles */
.filtered-results-section {
  margin-bottom: 2rem;
}

.table-stats {
  font-size: 0.9rem;
  color: #6b7280;
  font-weight: 500;
}

.status-badge {
  display: inline-block;
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.025em;
}

.status-badge.pending { background: #fef3c7; color: #d97706; }
.status-badge.in-progress { background: #dbeafe; color: #2563eb; }
.status-badge.completed { background: #d1fae5; color: #065f46; }
.status-badge.for-revision { background: #fee2e2; color: #dc2626; }
.status-badge.approved { background: #d1fae5; color: #065f46; }
.status-badge.rejected { background: #fee2e2; color: #dc2626; }
.status-badge.unknown { background: #f3f4f6; color: #374151; }
</style>
</head>
<body>
  <!-- SIDEBAR NAVIGATION -->
  <div class="admin-sidebar" id="adminSidebar">
    <!-- Profile Section at Top -->
    <div class="sidebar-profile">
      <a href="/admin/profile" class="sidebar-profile-link" title="Go to Profile">
        <div class="sidebar-profile-icon-container">
          <!-- SVG Icon (shows when collapsed) -->
          <svg class="sidebar-profile-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <!-- Profile Avatar (shows when expanded) -->
          <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" 
               alt="<%= user.fName %> <%= user.lName %>" 
               class="sidebar-profile-avatar" />
        </div>
        <div class="sidebar-profile-info">
          <p class="sidebar-profile-name"><%= user.fName %> <%= user.lName %></p>
          <p class="sidebar-profile-role"><%= user.userType === 'nonstudent' ? 'Non-Student' : user.userType.charAt(0).toUpperCase() + user.userType.slice(1) %></p>
        </div>
        <span class="sidebar-profile-arrow">→</span>
      </a>
    </div>

    <div class="sidebar-items">
      <a href="/admin" class="sidebar-item" title="Dashboard">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span class="sidebar-label">Dashboard</span>
      </a>
      
      <a href="/admin/analytics" class="sidebar-item active" title="Analytics">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="20" x2="12" y2="10"></line>
          <line x1="18" y1="20" x2="18" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="16"></line>
        </svg>
        <span class="sidebar-label">Analytics</span>
      </a>
      
      <a href="/admin/all-requests" class="sidebar-item" title="Track All Requests">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 11l3 3L22 4"></path>
          <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
        </svg>
        <span class="sidebar-label">Track All Requests</span>
      </a>
      
      <a href="/admin/approvals" class="sidebar-item" title="Manage Approvals">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span class="sidebar-label">Manage Approvals</span>
      </a>
      
      <a href="/admin/services" class="sidebar-item" title="Manage Services">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"></path>
        </svg>
        <span class="sidebar-label">Manage Services</span>
      </a>
      
      <a href="/admin/users" class="sidebar-item" title="User Accounts">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 00-3-3.87"></path>
          <path d="M16 3.13a4 4 0 010 7.75"></path>
        </svg>
        <span class="sidebar-label">User Accounts</span>
      </a>
      <a href="/admin/announcement" class="sidebar-item" title="Announcements">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 9.5v5a1 1 0 0 1-1 1h-2.5L14 20v-6H9a1 1 0 0 1-1-1V9.5a1 1 0 0 1 1-1h5l4.5-4V8.5H21a1 1 0 0 1 1 1z"></path>
          <path d="M3 11v2a7 7 0 0 0 7 7v-2a5 5 0 0 1-5-5v-2H3z"></path>
        </svg>
        <span class="sidebar-label">Announcements</span>
      </a>

      <a href="/admin/configuration" class="sidebar-item" title="Configuration">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 1v6m0 6v6m8.66-12.66l-4.24 4.24m-6.84 6.84l-4.24 4.24M23 12h-6m-6 0H5m17.66 4.66l-4.24-4.24m-6.84-6.84L6.34 1.42"></path>
        </svg>
        <span class="sidebar-label">Configuration</span>
      </a>

      <a href="/admin/reports" class="sidebar-item" title="Generate Reports">
        <svg class="sidebar-icon" viewBox="0 0 105.53 122.88" fill="currentColor" stroke="none">
          <path d="M98.66,87l2.84,2.85a1.9,1.9,0,0,1,0,2.71l-2.28,2.29a15.46,15.46,0,0,1,1.42,3.79h3a1.92,1.92,0,0,1,1.92,1.92v4a1.93,1.93,0,0,1-1.92,1.93h-3.23a15.4,15.4,0,0,1-1.67,3.67l2.09,2.09a1.93,1.93,0,0,1,0,2.72L98,117.86a1.93,1.93,0,0,1-2.72,0L93,115.58A15.88,15.88,0,0,1,89.16,117v3a1.93,1.93,0,0,1-1.92,1.92h-4A1.93,1.93,0,0,1,81.31,120v-3.23a15.32,15.32,0,0,1-3.68-1.68l-2.09,2.1a1.93,1.93,0,0,1-2.72,0L70,114.3a1.91,1.91,0,0,1,0-2.71l2.28-2.29a15.88,15.88,0,0,1-1.42-3.79h-3A1.93,1.93,0,0,1,66,103.59v-4a1.94,1.94,0,0,1,1.92-1.93H71.1A15.43,15.43,0,0,1,72.78,94l-2.1-2.09a1.93,1.93,0,0,1,0-2.72l2.85-2.84a1.91,1.91,0,0,1,2.71,0l2.29,2.28a15.83,15.83,0,0,1,3.79-1.42v-3a1.93,1.93,0,0,1,1.92-1.92h4a1.93,1.93,0,0,1,1.92,1.92v3.23a15,15,0,0,1,3.67,1.68L95.94,87a1.94,1.94,0,0,1,2.72,0ZM60.26,117a3,3,0,0,1,0,5.92H6.89A6.89,6.89,0,0,1,0,116V6.85A6.82,6.82,0,0,1,2,2,6.79,6.79,0,0,1,6.88,0H91.52a6.9,6.9,0,0,1,6.89,6.89V68.23c0,.06,0,.12,0,.18a3,3,0,0,1-5.94,0V6.89h0a1,1,0,0,0-.28-.68,1,1,0,0,0-.68-.29H6.89a.94.94,0,0,0-1,1V116h0a1,1,0,0,0,.28.67,1,1,0,0,0,.69.29H60.26ZM19,102.66V96H47.83v6.63l-28.82,0Zm55.3-42.9v6.11H65.62V59.76ZM58.77,54.38V65.87H50.08V54.38ZM43.24,37.92v28H34.55V37.92ZM27.7,26.41V65.87H19V26.41ZM69,29.31l13.11.05a13.14,13.14,0,0,1-3.91,9.29,13.55,13.55,0,0,1-1.91,1.56L69,29.31Zm-1.34-2.6L67,12.7a.51.51,0,0,1,.48-.53H68A14.56,14.56,0,0,1,82.69,25.67a.52.52,0,0,1-.47.54l-14,1a.49.49,0,0,1-.53-.46.08.08,0,0,0,0,0Zm.83-13.55.65,12.51L80.9,24.61a11.68,11.68,0,0,0-4-7.86c-2.46-2.27-4.74-3.62-8.32-3.58ZM66.1,28.7l7,12.17A14.05,14.05,0,1,1,64.06,14.8l2,13.9ZM19,84.83V78.15H59.86v6.63L19,84.83Zm66.73,9.38a7.89,7.89,0,1,1-7.89,7.89,7.89,7.89,0,0,1,7.89-7.89Z"/>
        </svg>
        <span class="sidebar-label">Generate Reports</span>
      </a>
    </div>
    
    <!-- Logout Button at Bottom -->
    <div class="sidebar-bottom">
      <a href="/logout" class="sidebar-item sidebar-logout" title="Logout">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span class="sidebar-label">Logout</span>
      </a>
    </div>
  </div>

  <!-- MAIN CONTENT WITH HEADER -->
  <div class="admin-main-content">
    <!-- HEADER -->
    <div class="overlap">
      <!-- Left Group: Hamburger, Logo, Title -->
      <div class="header-left-group">
        <!-- Hamburger Menu Button for Mobile -->
        <button class="admin-menu-toggle" id="adminMenuToggle" title="Open Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/admin" class="text-wrapper">S-CORE ADMIN</a>
      </div>
      
      <span class="text-wrapper-2">Analytics</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/admin/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </div>

    <!-- ANALYTICS DASHBOARD CONTENT -->
    <div class="dashboard-container">
      <!-- DASHBOARD HEADER WITH TITLE AND REPORTS BUTTON -->
      <div class="dashboard-header-section">
        <div>
          <h1 class="dashboard-main-title">Analytics & Performance Insights</h1>
          <p class="dashboard-subtitle">Comprehensive data analysis and reporting for S-CORE operations</p>
        </div>
      </div>

      <!-- ANALYTICS FILTERS SECTION -->
      <div class="analytics-filters-container">
        <h2 class="filters-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="4" y1="21" x2="4" y2="14"></line>
            <line x1="4" y1="10" x2="4" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12" y2="3"></line>
            <line x1="20" y1="21" x2="20" y2="16"></line>
            <line x1="20" y1="12" x2="20" y2="3"></line>
            <line x1="1" y1="14" x2="7" y2="14"></line>
            <line x1="9" y1="8" x2="15" y2="8"></line>
            <line x1="17" y1="16" x2="23" y2="16"></line>
          </svg>
          Performance Insights Filters
        </h2>
        <p class="filters-subtitle">Filter all analytics data below - results update automatically</p>

        <div class="filters-grid">
          <!-- Date Range Filter -->
          <div class="filter-group">
            <label for="dateRangeFilter" class="filter-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              Date Range
            </label>
            <select id="dateRangeFilter" class="filter-select">
              <option value="daily">Daily</option>
              <option value="weekly">Weekly</option>
              <option value="monthly" selected>Monthly</option>
              <option value="quarterly">Quarterly</option>
              <option value="annually">Annually</option>
              <option value="custom">Custom Range</option>
            </select>
          </div>

          <!-- Custom Date Range (Hidden by default) -->
          <div class="filter-group custom-date-range" id="customDateRange" style="display: none;">
            <label for="customStartDate" class="filter-label">Start Date</label>
            <input type="date" id="customStartDate" class="filter-input">
          </div>

          <div class="filter-group custom-date-range" id="customDateRangeEnd" style="display: none;">
            <label for="customEndDate" class="filter-label">End Date</label>
            <input type="date" id="customEndDate" class="filter-input">
          </div>

          <!-- Unit Filter -->
          <div class="filter-group">
            <label for="unitFilter" class="filter-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
              Unit
            </label>
            <select id="unitFilter" class="filter-select">
              <option value="all" selected>All Units</option>
              <% units.forEach(unit => { %>
              <option value="<%= unit %>"><%= unit %></option>
              <% }); %>
            </select>
          </div>

          <!-- Request Type Filter -->
          <div class="filter-group">
            <label for="requestTypeFilter" class="filter-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              Request Type
            </label>
            <select id="requestTypeFilter" class="filter-select">
              <option value="all" selected>All Requests</option>
              <% requestTypes.forEach(type => { %>
              <option value="<%= type %>"><%= type %></option>
              <% }); %>
            </select>
          </div>

          <!-- Status Filter -->
          <div class="filter-group">
            <label for="statusFilter" class="filter-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 11 12 14 22 4"></polyline>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
              </svg>
              Status
            </label>
            <select id="statusFilter" class="filter-select">
              <option value="all" selected>All Statuses</option>
              <% requestStatuses.forEach(status => { %>
              <option value="<%= status %>"><%= status %></option>
              <% }); %>
            </select>
          </div>

          <!-- Reset Button -->
          <div class="filter-group">
            <button id="resetFilters" class="btn-reset-filters">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="1 4 1 10 7 10"></polyline>
                <polyline points="23 20 23 14 17 14"></polyline>
                <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
              </svg>
              Reset
            </button>
          </div>
        </div>
      </div>

      <!-- FILTERED RESULTS SECTION -->
      <div class="analytics-section filtered-results-section" id="filteredResultsSection">
        <h2 class="section-header-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Workflow Bottlenecks & Status
        </h2>
        <p class="section-subtitle">Monitor tasks, deadlines, and identify bottlenecks</p>

        <!-- Filtered Charts -->
        <div class="charts-grid auto-fit-grid-main">
          <!-- Filtered Status Distribution -->
          <div class="chart-card">
            <div class="chart-header">
              <div>
                <h3 class="chart-title">Request Status Distribution</h3>
                <p class="chart-subtitle">A real-time snapshot of requests in the workflow pipeline</p>
              </div>
            </div>
            <div class="chart-content">
              <canvas id="filteredStatusChart"></canvas>
            </div>
          </div>

          <!-- Filtered Request Type Distribution -->
          <div class="chart-card">
            <div class="chart-header">
              <div>
                <h3 class="chart-title">Request Type Distribution</h3>
                <p class="chart-subtitle">Trend of approval and service requests</p>
              </div>
            </div>
            <div class="chart-content">
              <canvas id="filteredTypeChart"></canvas>
            </div>
          </div>
        </div>

        <!-- Filtered Requests Table -->
        <div class="table-card table-card-wide" style="margin-top: 1.5rem;">
          <div class="table-header">
            <div>
              <h3 class="table-title">Filtered Requests</h3>
              <p class="table-subtitle">All requests matching your current filter criteria</p>
            </div>
            <div class="table-stats">
              <span id="filtered-count">0</span> requests found
            </div>
          </div>
          <div class="table-content">
            <table class="data-table" id="filteredRequestsTable">
              <thead>
                <tr>
                  <th>Request ID</th>
                  <th>Title</th>
                  <th>Type</th>
                  <th>Requester</th>
                  <th>Unit</th>
                  <th>Status</th>
                  <th>Submitted</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="filteredRequestsTbody">
                <tr>
                  <td colspan="8" class="table-empty">No requests match the current filters. Try adjusting your filter criteria.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- SECTION A: AT-A-GLANCE KPIs -->
      <div class="analytics-section">
        <h2 class="section-header-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          At-a-Glance Key Performance Indicators
        </h2>
      
        <!-- KPI CARDS -->
        <div class="kpi-container auto-fit-grid-kpi">
          <!-- Total Requests -->
          <div class="kpi-card" data-kpi="total-requests">
            <div class="kpi-icon" style="background: linear-gradient(135deg, #3b82f6, #2563eb);">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
            </div>
            <div class="kpi-content">
              <div class="kpi-label">Total Requests</div>
              <div class="kpi-value" id="kpi-total-requests"><%= stats.totalApprovals + stats.totalServices %></div>
              <div class="kpi-subtext">In selected period</div>
            </div>
          </div>

          <!-- Avg Turnaround Time -->
          <div class="kpi-card" data-kpi="avg-turnaround">
            <div class="kpi-icon" style="background: linear-gradient(135deg, #10b981, #059669);">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="kpi-content">
              <div class="kpi-label">Avg. Turnaround Time</div>
              <div class="kpi-value" id="kpi-avg-turnaround">
                <span class="kpi-number"><%= Math.round(stats.avgTurnaroundTime) %></span>
                <span class="kpi-unit">days</span>
              </div>
              <div class="kpi-subtext">From submission to done</div>
            </div>
          </div>

          <!-- Pending Assignment -->
          <div class="kpi-card" data-kpi="pending-assignment">
            <div class="kpi-icon" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
            <div class="kpi-content">
              <div class="kpi-label">Pending Assignment</div>
              <div class="kpi-value" id="kpi-pending-assignment"><%= stats.pendingApprovals + stats.pendingServices %></div>
              <div class="kpi-subtext">Needs assignment by admin</div>
            </div>
          </div>

          <!-- In Revision -->
          <div class="kpi-card" data-kpi="in-revision">
            <div class="kpi-icon" style="background: linear-gradient(135deg, #ef4444, #dc2626);">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
            </div>
            <div class="kpi-content">
              <div class="kpi-label">In Revision</div>
              <div class="kpi-value" id="kpi-in-revision">0</div>
              <div class="kpi-subtext">Currently being revised</div>
            </div>
          </div>

          <!-- Active Requests -->
          <div class="kpi-card" data-kpi="active-requests">
            <div class="kpi-icon" style="background: linear-gradient(135deg, #059669, #047857);">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                <polyline points="13 2 13 9 20 9"></polyline>
                <circle cx="9" cy="12" r="1"></circle>
                <circle cx="9" cy="16" r="1"></circle>
              </svg>
            </div>
            <div class="kpi-content">
              <div class="kpi-label">Active Requests</div>
              <div class="kpi-value" id="kpi-active-requests"><%= stats.activeRequests %></div>
              <div class="kpi-subtext">Currently in progress</div>
            </div>
          </div>

          <!-- Completion Rate -->
          <div class="kpi-card" data-kpi="completion-rate">
            <div class="kpi-icon" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <div class="kpi-content">
              <div class="kpi-label">Completion Rate</div>
              <div class="kpi-value" id="kpi-completion-rate">
                <span class="kpi-number"><%= stats.completionRate %></span>
                <span class="kpi-unit">%</span>
              </div>
              <div class="kpi-subtext">Successfully completed</div>
            </div>
          </div>

          <!-- Avg Response Time -->
          <div class="kpi-card" data-kpi="response-time">
            <div class="kpi-icon" style="background: linear-gradient(135deg, #06b6d4, #0891b2);">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                <polyline points="17 6 23 6 23 12"></polyline>
              </svg>
            </div>
            <div class="kpi-content">
              <div class="kpi-label">Avg. Response Time</div>
              <div class="kpi-value" id="kpi-response-time">
                <span class="kpi-number"><%= stats.avgResponseTime %></span>
                <span class="kpi-unit"><%= stats.responseTimeUnit %></span>
              </div>
              <div class="kpi-subtext">Initial response time</div>
            </div>
          </div>

          <!-- Overdue Tasks -->
          <div class="kpi-card" data-kpi="overdue-tasks">
            <div class="kpi-icon" style="background: linear-gradient(135deg, #dc2626, #b91c1c);">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
            </div>
            <div class="kpi-content">
              <div class="kpi-label">Overdue Tasks</div>
              <div class="kpi-value" id="kpi-overdue-tasks"><%= stats.overdueTasks %></div>
              <div class="kpi-subtext">Past deadline</div>
            </div>
          </div>

        </div>
      </div>

      <!-- SECTION B: REQUEST PATTERNS & TRENDS -->
      <div class="analytics-section">
        <h2 class="section-header-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
          Request Patterns & Trends
        </h2>
        <p class="section-subtitle">Request volume and top requestors</p>

        <div class="charts-grid auto-fit-grid-main">
          <!-- Top Requestors Pie Chart -->
          <div class="chart-card">
            <div class="chart-header">
              <div>
                <h3 class="chart-title">Top Requestors</h3>
                <p class="chart-subtitle">Shows which organizations or departments are submitting the most requests, helping to identify key stakeholders</p>
              </div>
            </div>
            <div class="chart-content">
              <canvas id="topRequestorsChart"></canvas>
            </div>
          </div>

          <!-- Request Volume Over Time Line Chart -->
          <div class="chart-card">
            <div class="chart-header">
              <div>
                <h3 class="chart-title">Request Volume Over Time</h3>
                <p class="chart-subtitle">Tracks the total number of 'Approval' vs. 'Service' requests submitted to identify peak periods</p>
              </div>
            </div>
            <div class="chart-content">
              <canvas id="requestVolumeChart"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION C: UNIT PERFORMANCE & WORKLOAD -->
      <div class="analytics-section">
        <h2 class="section-header-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          Unit Performance & Workload
        </h2>
        <p class="section-subtitle">Compare tasks per unit and measure efficiency</p>

        <div class="charts-grid auto-fit-grid-main">
          <!-- Active Workload by Unit Bar Chart -->
          <div class="chart-card">
            <div class="chart-header">
              <div>
                <h3 class="chart-title">Active Workload by Unit</h3>
                <p class="chart-subtitle">Compares the number of 'In Progress' tasks assigned to each unit to monitor workload distribution</p>
              </div>
            </div>
            <div class="chart-content">
              <canvas id="activeWorkloadChart"></canvas>
            </div>
          </div>

          <!-- Average Turnaround Time by Unit Bar Chart -->
          <div class="chart-card">
            <div class="chart-header">
              <div>
                <h3 class="chart-title">Avg. Turnaround Time by Unit</h3>
                <p class="chart-subtitle">Measures the average time (in days) from request submission to completion for each unit to track efficiency</p>
              </div>
            </div>
            <div class="chart-content">
              <canvas id="turnaroundByUnitChart"></canvas>
            </div>
          </div>

          <!-- Total Workload by Unit Bar Chart -->
          <div class="chart-card">
            <div class="chart-header">
              <div>
                <h3 class="chart-title">Total Workload by Unit</h3>
                <p class="chart-subtitle">Shows the total number of requests assigned to each unit, including all statuses</p>
              </div>
            </div>
            <div class="chart-content">
              <canvas id="totalWorkloadChart"></canvas>
            </div>
          </div>

          <!-- Average Response Time by Unit Bar Chart -->
          <div class="chart-card">
            <div class="chart-header">
              <div>
                <h3 class="chart-title">Avg. Response Time by Unit</h3>
                <p class="chart-subtitle">Measures the average time (in hours) from request assignment to first response for each unit</p>
              </div>
            </div>
            <div class="chart-content">
              <canvas id="responseTimeByUnitChart"></canvas>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/javascripts/notifications.js"></script>
  <script src="/javascripts/ejs/analytics.js"></script>
  <script>
    console.log('Inline analytics script starting...');
    
    // Debug: Check what requestTypes contains
    console.log('requestTypes:', <%- JSON.stringify(requestTypes) %>);
    console.log('requestStatuses:', <%- JSON.stringify(requestStatuses) %>);
    
    // Define loadVolumeData early to ensure it's available
    async function loadVolumeData(filters = {}) {
      try {
        console.log('loadVolumeData called with filters:', filters);
        
        // Build query string from filters
        const params = new URLSearchParams();
        
        if (filters.dateRange) params.append('dateRange', filters.dateRange);
        if (filters.units && filters.units.length > 0 && !filters.units.includes('all')) {
          params.append('units', filters.units.join(','));
        }
        if (filters.requestType && filters.requestType !== 'all') {
          params.append('requestType', filters.requestType);
        }
        if (filters.status && filters.status !== 'all') {
          params.append('status', filters.status);
        }
        if (filters.customStartDate) params.append('startDate', filters.customStartDate);
        if (filters.customEndDate) params.append('endDate', filters.customEndDate);
        
        // Default to 30 days if no date filter
        if (!filters.dateRange && !filters.customStartDate) {
          params.append('days', '30');
        }
        
        const queryString = params.toString();
        const url = queryString ? `/admin/analytics-data/request-volume?${queryString}` : '/admin/analytics-data/request-volume?days=30';
        
        console.log('Fetching volume data from:', url);
        
        const response = await fetch(url);
        const data = await response.json();
        
        console.log('Volume data response:', data);
        
        if (data.success) {
          console.log('Updating chart with labels:', data.labels);
          console.log('Approvals data:', data.approvals);
          console.log('Services data:', data.services);
          
          requestVolumeChart.data.labels = data.labels;
          requestVolumeChart.data.datasets[0].data = data.approvals;
          requestVolumeChart.data.datasets[1].data = data.services;
          
          console.log('Chart data set, calling update...');
          requestVolumeChart.update();
          console.log('Request volume chart updated successfully');
        } else {
          console.error('Error in volume data response:', data);
        }
      } catch (error) {
        console.error('Error loading volume data:', error);
      }
    }
    
    // Make it globally available immediately
    window.loadVolumeData = loadVolumeData;
    console.log('loadVolumeData function defined early and assigned to window');
    
    // Dropdown toggle function
    function toggleDropdown() {
      const dropdown = document.getElementById('dropdownMenu');
      dropdown.classList.toggle('show');
    }

    // Close dropdown when clicking outside
    window.addEventListener('click', function(e) {
      if (!e.target.closest('.dropdown-wrapper')) {
        const dropdown = document.getElementById('dropdownMenu');
        if (dropdown && dropdown.classList.contains('show')) {
          dropdown.classList.remove('show');
        }
      }
    });

    // Sidebar hover expand/collapse
    const sidebar = document.getElementById('adminSidebar');
    if (sidebar) {
      sidebar.addEventListener('mouseenter', function() {
        this.classList.add('expanded');
      });
      sidebar.addEventListener('mouseleave', function() {
        this.classList.remove('expanded');
      });
    }

    // Mobile hamburger menu toggle
    document.addEventListener('DOMContentLoaded', () => {
      const menuToggle = document.getElementById('adminMenuToggle');
      const sidebarEl = document.getElementById('adminSidebar');

      console.log('Menu Toggle:', menuToggle); // Debug
      console.log('Sidebar:', sidebarEl); // Debug
      console.log('Window width:', window.innerWidth); // Debug

      if (menuToggle && sidebarEl) {
        menuToggle.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          console.log('Menu button clicked!'); // Debug
          const isActive = sidebarEl.classList.toggle('mobile-active');
          console.log('Sidebar is now:', isActive ? 'OPEN' : 'CLOSED'); // Debug
          console.log('Sidebar classes:', sidebarEl.className); // Debug
          console.log('Computed left position:', window.getComputedStyle(sidebarEl).left); // Debug
        });
      }

      // Close sidebar when clicking outside of it on mobile
      document.addEventListener('click', (e) => {
        if (sidebarEl && sidebarEl.classList.contains('mobile-active')) {
          if (!sidebarEl.contains(e.target) && !menuToggle.contains(e.target)) {
            console.log('Clicking outside - closing sidebar'); // Debug
            sidebarEl.classList.remove('mobile-active');
          }
        }
      });
    });

    // Menu toggle for sidebar (mobile)
    const menuToggle = document.getElementById('menuToggle');
    if (menuToggle) {
      menuToggle.addEventListener('click', () => {
        document.getElementById('adminSidebar').classList.toggle('active');
      });
    }

    // Initialize request volume chart
    const requestVolumeChartCtx = document.getElementById('requestVolumeChart').getContext('2d');
    const requestVolumeChart = new Chart(requestVolumeChartCtx, {
      type: 'line',
      data: {
        labels: [],
        datasets: [{
          label: 'Approval Requests',
          data: [],
          borderColor: '#43a047',
          backgroundColor: 'rgba(67, 160, 71, 0.1)',
          tension: 0.4,
          fill: true
        }, {
          label: 'Service Requests',
          data: [],
          borderColor: '#f97316',
          backgroundColor: 'rgba(249, 115, 22, 0.1)',
          tension: 0.4,
          fill: true
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        interaction: {
          intersect: false,
          mode: 'index'
        },
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              padding: 15,
              font: {
                size: 12,
                family: 'Inter'
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true
          }
        }
      }
    });

    console.log('About to define loadVolumeData function');
    
    // loadVolumeData is already defined at the top of the script
    
    // Load data on page load, or apply pending filters
    console.log('Checking for pending volume filters:', window.pendingVolumeFilters);
    if (window.pendingVolumeFilters) {
      console.log('Applying pending volume filters:', window.pendingVolumeFilters);
      loadVolumeData(window.pendingVolumeFilters);
      window.pendingVolumeFilters = null;
    } else {
      loadVolumeData();
    }

    // Initialize Socket.IO for real-time updates
    const socket = io();

    // Authenticate socket as admin
    socket.emit('authenticate', {
      userId: '<%= user._id %>',
      userRole: '<%= user.userType %>'
    });

    // Listen for active requests updates
    socket.on('activeRequestsUpdate', (data) => {
      console.log('📊 Received active requests update:', data);
      const activeRequestsElement = document.getElementById('kpi-active-requests');
      if (activeRequestsElement) {
        activeRequestsElement.textContent = data.activeRequests;
        console.log('✅ Updated active requests KPI to:', data.activeRequests);
      } else {
        console.warn('⚠️ Active requests element not found');
      }
    });

    // Handle socket authentication confirmation
    socket.on('authenticated', (data) => {
      console.log('🔐 Analytics socket authenticated:', data);
    });

    console.log('📡 Analytics real-time updates initialized');
  </script>
</body>
</html>
