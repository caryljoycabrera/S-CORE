<!-- ===========================================
     JAVASCRIPT CONNECTION
     ===========================================
     This page includes JavaScript functionality from:
     - public/javascripts/shared-data.js (centralized data arrays)
     - public/javascripts/ejs/profileadmin.js (main client-side logic)
     Note: Socket.IO is loaded via the notifications partial
     Note: notifications.js is already loaded in the notifications partial
     =========================================== -->
<script src="/javascripts/shared-data.js"></script>
<script src="/javascripts/ejs/profileadmin.js"></script>

<script>
// Sidebar hover effect
const sidebar = document.getElementById('adminSidebar');
if (sidebar) {
  sidebar.addEventListener('mouseenter', function() {
    this.classList.add('expanded');
  });
  sidebar.addEventListener('mouseleave', function() {
    this.classList.remove('expanded');
  });
}

// Wait for shared system data to load from API
function waitForSystemData() {
  return new Promise(resolve => {
    if ((window.studentOrgsArray && window.studentOrgsArray.length > 0) || 
        (window.affiliationsArray && window.affiliationsArray.length > 0)) {
      resolve(); return;
    }
    const handler = () => { window.removeEventListener('systemDataLoaded', handler); resolve(); };
    window.addEventListener('systemDataLoaded', handler);
    setTimeout(() => { window.removeEventListener('systemDataLoaded', handler); resolve(); }, 5000);
  });
}

