<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Profile</title>
  <!-- ===========================================
       PROFILE ADMIN PAGE STYLES CONNECTION
       ===========================================
       This page is connected to:
       - public/stylesheets/ejs/profileadmin.css (main styles)
       - public/style.css (global styles)
       Last updated: 2025-11-04
       =========================================== -->
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/stylesheets/notifications.css" />
  <link rel="stylesheet" href="/stylesheets/admin-navbar.css" />
  <link rel="stylesheet" href="/stylesheets/ejs/profileadmin.css" />
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<style>
/* NEW RULE TO FIX FLUID LAYOUT */
body.profile-page .student-side > .div {
  max-width: 100%;
  margin-left: 0;
  margin-right: 0;
}
</style>

</head>
<body class="profile-page">
  <!-- SIDEBAR NAVIGATION -->
  <div class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-items">
      <a href="/admin" class="sidebar-item" title="Dashboard">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span class="sidebar-label">Dashboard</span>
      </a>
      
      <a href="/admin/analytics" class="sidebar-item" title="Analytics">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="20" x2="12" y2="10"></line>
          <line x1="18" y1="20" x2="18" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="16"></line>
        </svg>
        <span class="sidebar-label">Analytics</span>
      </a>
      
      <a href="/admin/all-requests" class="sidebar-item" title="Track All Requests">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 11l3 3L22 4"></path>
          <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
        </svg>
        <span class="sidebar-label">Track All Requests</span>
      </a>
      
      <a href="/admin/approvals" class="sidebar-item" title="Manage Approvals">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span class="sidebar-label">Manage Approvals</span>
      </a>
      
      <a href="/admin/services" class="sidebar-item" title="Manage Services">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"></path>
        </svg>
        <span class="sidebar-label">Manage Services</span>
      </a>
      
      <a href="/admin/users" class="sidebar-item" title="User Accounts">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 00-3-3.87"></path>
          <path d="M16 3.13a4 4 0 010 7.75"></path>
        </svg>
        <span class="sidebar-label">User Accounts</span>
      </a>
    </div>
    
    <!-- Logout Button at Bottom -->
    <div class="sidebar-bottom">
      <a href="/logout" class="sidebar-item sidebar-logout" title="Logout">
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span class="sidebar-label">Logout</span>
      </a>
    </div>
  </div>

  <!-- MAIN CONTENT WITH SIDEBAR -->
  <div class="admin-main-content">
    <header class="overlap">
      <div class="group">
        <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
      </div>
      <a href="/admin" class="text-wrapper">S-CORE ADMIN</a>
      <span class="text-wrapper-2">My Profile</span>

      <div class="header-right-section">
        <%- include('../partials/notifications') %>
        
        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/admin/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </header>

    <main class="student-side">
      <div class="div">
        <!-- LEFT SIDEBAR - Profile Card -->
        <div class="section-header">
          <div class="profile-info">
            <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" 
                 alt="Profile Picture" class="profile-pic-large" />
            <h2><%= user.fName %> <%= user.lName %></h2>
            <p>Admin</p>
          </div>

          <!-- About Section -->
          <div class="about-section">
            <h3>About</h3>
            <div class="about-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <div>
                <div class="about-label">Email:</div>
                <div class="about-value"><%= user.email %></div>
              </div>
            </div>
            
            <div class="about-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <div>
                <div class="about-label">Phone:</div>
                <div class="about-value"><%= user.phoneNumber || 'N/A' %></div>
              </div>
            </div>

            <% if (user.userType === 'student') { %>
            <div class="about-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"/>
              </svg>
              <div>
                <div class="about-label">Student ID:</div>
                <div class="about-value"><%= user.studentId || 'N/A' %></div>
              </div>
            </div>
            <% } %>
          </div>

          <!-- Action Buttons -->
          <div class="profile-actions">
            <button id="openUpdateProfile">Update Profile</button>
            <button id="openChangePassword">Change Password</button>
            <button id="openPictureModal" type="button">Update Picture</button>
            <a href="/admin" class="view-all-btn">← Back to Dashboard</a>
          </div>
        </div>

        <!-- RIGHT SIDE - Profile Information -->
        <div class="profile-table">
          <div class="info-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <h3>Profile Information</h3>
          </div>
          <table>
            <tbody>
              <tr><td class="label">FULL NAME</td><td><%= user.fName %> <%= user.mName %> <%= user.lName %></td></tr>
              <tr><td class="label">USERNAME</td><td><%= user.username %></td></tr>
              <tr><td class="label">EMAIL</td><td><%= user.email %></td></tr>
              <tr><td class="label">PHONE</td><td><%= user.phoneNumber || 'N/A' %></td></tr>
              
              <% if (user.userType === 'student') { %>
                <tr>
                  <td class="label">ORGANIZATION</td>
                  <td>
                    <% if (user.studentOrganization && user.studentOrganization.length > 0) { %>
                      <div class="org-tags-container">
                        <% 
                        let organizations = Array.isArray(user.studentOrganization) 
                          ? user.studentOrganization 
                          : user.studentOrganization.split(',').map(org => org.trim()).filter(Boolean);
                        
                        organizations.forEach((org, index) => { %>
                      <span class="org-tag <%= organizations.length === 1 ? 'single' : '' %>" 
                            title="<%= org %>">
                        <%= org %>
                      </span>
                        <% }); %>
                      </div>
                    <% } else { %>
                      <span class="no-organizations">No organizations</span>
                    <% } %>
                  </td>
                </tr>
                <tr><td class="label">COURSE/YEAR/SECTION</td><td><%= user.cys || 'N/A' %></td></tr>
                <tr><td class="label">STUDENT ID</td><td><%= user.studentId || 'N/A' %></td></tr>
              <% } else { %>
                <tr>
                  <td class="label">OFFICE/DEPARTMENT</td>
                  <td>
                    <% if (user.affiliation && user.affiliation.length > 0) { %>
                      <div class="org-tags-container">
                        <% 
                        let affiliations = Array.isArray(user.affiliation) 
                          ? user.affiliation 
                          : user.affiliation.split(',').map(aff => aff.trim()).filter(Boolean);
                        
                        affiliations.forEach((aff, index) => { %>
                      <span class="org-tag <%= affiliations.length === 1 ? 'single' : '' %>" 
                            title="<%= aff %>">
                        <%= aff %>
                      </span>
                        <% }); %>
                      </div>
                    <% } else { %>
                      <span class="no-organizations">No office/department</span>
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>

          <!-- Admin Statistics Section -->
          <div class="info-header" style="margin-top: 2rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            <h3>Admin Overview</h3>
          </div>
          
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-icon admin-accent">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <div class="stat-content">
                <div class="stat-label">Role</div>
                <div class="stat-value">Administrator</div>
              </div>
            </div>
            
            <div class="stat-card">
              <div class="stat-icon admin-accent">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div class="stat-content">
                <div class="stat-label">Account Status</div>
                <div class="stat-value">Active</div>
              </div>
            </div>
            
            <div class="stat-card">
              <div class="stat-icon admin-accent">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <div class="stat-content">
                <div class="stat-label">Access Level</div>
                <div class="stat-value">Full Access</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- Enhanced Update Profile Modal -->
  <div id="updateProfileModal" class="modal" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.5rem;">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Update Profile
        </h2>
        <span class="close" onclick="closeModal('updateProfileModal')">&times;</span>
      </div>
      <div class="modal-body">
        <form id="updateProfileForm" class="modal-form profile-update-form">
          <input type="hidden" name="userId" value="<%= user._id %>" />
          
          <!-- Personal Information Section -->
          <div class="form-section">
            <h3 class="section-title">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.5rem;">
              <circle cx="12" cy="8" r="4"/>
              <path d="M2 20c0-3.3137 3.134-6 7-6h6c3.866 0 7 2.6863 7 6"/>
            </svg>
            Personal Information
          </h3>
            
            <div class="form-group">
              <label for="fName">First Name <span class="required">*</span></label>
              <input name="fName" id="fName" type="text" value="<%= user.fName %>" required />
            </div>
            
            <div class="form-group">
              <label for="mName">Middle Name <span class="required">*</span></label>
              <input name="mName" id="mName" type="text" value="<%= user.mName %>" required />
            </div>
            
            <div class="form-group">
              <label for="lName">Last Name <span class="required">*</span></label>
              <input name="lName" id="lName" type="text" value="<%= user.lName %>" required />
            </div>
            
            <div class="form-group">
              <label for="phoneNumber">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.5rem;">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              Phone Number
            </label>
              <input name="phoneNumber" id="phoneNumber" type="text" value="<%= user.phoneNumber || '' %>" placeholder="Enter your phone number" />
            </div>
          </div>

          <!-- Account Information Section -->
          <div class="form-section">
            <h3 class="section-title">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.5rem;">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <circle cx="12" cy="16" r="1"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Account Information
        </h3>
            
            <div class="form-group">
              <label for="email">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.5rem;">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            Email Address
          </label>
              <input name="email" id="email" type="email" value="<%= user.email %>" disabled title="Email cannot be changed" />
              <small style="color: #64748b; margin-top: 0.5rem; font-style: italic;">Email address cannot be modified</small>
            </div>
            
            <div class="form-group">
              <label for="username">
          Username
        </label>
              <input name="username" id="username" type="text" value="<%= user.username %>" disabled title="Username cannot be changed" />
              <small style="color: #64748b; margin-top: 0.5rem; font-style: italic;">Username cannot be modified</small>
            </div>
          </div>

          <% if (user.userType === 'student') { %>
          <!-- Student-Specific Information -->
          <div class="form-section student-info-grid">
            <h3 class="section-title">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.5rem;">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                <path d="M6 12v5c3 3 9 3 12 0v-5"/>
              </svg>
              Student Information
            </h3>
            
            <!-- Organization Section -->
            <div class="organization-section">
              <label for="studentOrganization">
                Student Organizations
                <span class="org-counter" id="orgCounter">No organizations selected</span>
                <small style="display: block; color: #065f46; font-style: italic; margin-top: 0.5rem;">
          <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.25rem;">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          Click on any selected organization to remove it
        </small>
              </label>
              <select name="studentOrganization[]" id="studentOrganization" multiple="multiple" style="width: 100%"></select>

              <div class="custom-org-section" id="customOrgSection">
                <button type="button" class="toggle-org-button" id="toggleCustomOrg">
                  Add organization not in the list
                </button>

                <div id="customOrgContainer" style="display: none;">
                  <div class="custom-org-input-group">
                    <input 
                      type="text" 
                      id="otherOrganization" 
                      placeholder="Enter organization name..." 
                      class="custom-org-input"
                      maxlength="100"
                    />
                    <button type="button" id="addOrganizationButton" class="add-org-button" title="Add Organization"></button>
                  </div>
                  <div id="orgAddedFeedback" class="org-added-feedback"></div>
                </div>
              </div>
            </div>

            <!-- Academic Information -->
            <div class="academic-info">
              <div class="form-group">
                <label for="cys">
            Course / Year / Section
          </label>
                <input name="cys" id="cys" type="text" value="<%= user.cys || '' %>" placeholder="e.g., BSCS-4A" />
              </div>
              
              <div class="form-group">
                <label for="studentId">Student ID </label>
                <input name="studentId" id="studentId" type="text" value="<%= user.studentId || '' %>" placeholder="Enter your student ID" />
              </div>
            </div>
          </div>
          
          <% } else { %>
          <!-- Staff-Specific Information -->
          <div class="form-section">
            <h3 class="section-title">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.5rem;">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            </svg>
            Professional Information
          </h3>
            
            <div class="office-section">
              <div class="form-group">
                <label for="officeSelect">Office/Department
                  <small style="display: block; color: #065f46; font-style: italic; margin-top: 0.5rem;">
                    💡 Click on any selected office/department to remove it
                  </small>
                </label>
                <select name="affiliation[]" id="officeSelect" multiple="multiple" style="width: 100%">
                  <!-- options will be filled dynamically -->
                </select>
              </div>
            </div>
          </div>
          <% } %>

          <!-- Form Actions -->
          <div class="form-actions">
            <button type="button" onclick="closeModal('updateProfileModal')">Cancel</button>
            <button type="submit">
        <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.5rem;">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
          <polyline points="17,21 17,13 7,13 7,21"/>
          <polyline points="7,3 7,8 15,8"/>
        </svg>
        Save Changes
      </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Password Change Modal -->
  <div id="passwordModal" class="modal" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.5rem;">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <circle cx="12" cy="16" r="1"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Change Password
        </h2>
        <span class="close" onclick="closeModal('passwordModal')">&times;</span>
      </div>
      <div class="modal-body">
        <form id="passwordForm" class="modal-form password-form">
          <div class="form-group">
            <label for="oldPassword">Current Password</label>
            <div class="password-input-container">
              <input name="oldPassword" id="oldPassword" type="password" required />
              <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('oldPassword', 'oldPasswordIcon')">
                <svg id="oldPasswordIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
          </div>
          
          <div class="form-group">
            <label for="newPassword">New Password</label>
            <div class="password-input-container">
              <input name="newPassword" id="newPassword" type="password" required />
              <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('newPassword', 'newPasswordIcon')">
                <svg id="newPasswordIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
            
            <!-- Password Strength Indicator -->
            <div class="password-strength" id="passwordStrength" style="display: none;">
              <div class="strength-bar">
                <div class="strength-fill" id="strengthFill"></div>
              </div>
              <span id="strengthText">Password strength</span>
            </div>
            
            <!-- Password Validation Rules -->
            <div class="password-validation" id="passwordValidation" style="display: none;">
              <div class="validation-item" id="lengthCheck">
                <svg class="validation-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>At least 8 characters</span>
              </div>
              <div class="validation-item" id="numberCheck">
                <svg class="validation-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>At least one number</span>
              </div>
              <div class="validation-item" id="specialCheck">
                <svg class="validation-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>At least one special character</span>
              </div>
            </div>
          </div>
          
          <div class="form-group">
            <label for="confirmNewPassword">Confirm New Password</label>
            <div class="password-input-container">
              <input name="confirmNewPassword" id="confirmNewPassword" type="password" required />
              <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('confirmNewPassword', 'confirmPasswordIcon')">
                <svg id="confirmPasswordIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
            
            <!-- Password Match Indicator -->
            <div class="password-match-indicator" id="passwordMatchIndicator">
              Enter password confirmation
            </div>
          </div>
          
          <div class="form-actions">
            <button type="button" onclick="closeModal('passwordModal')" style="background: #6b7280; color: white;">Cancel</button>
            <button type="submit" id="updatePasswordBtn" disabled>Update Password</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Enhanced Picture Upload Modal -->
  <div id="pictureModal" class="modal" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.5rem;">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <circle cx="8" cy="8" r="2"/>
            <path d="M21 21l-6-6a2 2 0 0 0-2.83 0L3 21"/>
          </svg>
          Update Profile Picture
        </h2>
        <span class="close" onclick="closeModal('pictureModal')">&times;</span>
      </div>
      <div class="modal-body">
        <div class="picture-modal-body">
          
          <!-- Current Picture Section at the top -->
          <div class="current-picture-header">
            <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" 
                 alt="Current Profile Picture" id="currentProfileImg" />
            <h4>Current Picture</h4>
            <p>This is your current profile picture that others will see.</p>
          </div>

          <!-- Upload Selection Section -->
          <div class="upload-selection-section">
            
            <!-- Drop Zone -->
            <div class="file-upload-container" id="fileUploadContainer">
              <svg class="upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7,10 12,15 17,10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <p class="upload-text">Drop your image here</p>
              <p class="upload-subtext">or click to browse from your device</p>
              <input type="file" id="fileInput" name="profilePicture" accept="image/*" class="file-input-hidden" />
              <button type="button" class="browse-button" onclick="document.getElementById('fileInput').click()">
          <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.5rem;">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14,2 14,8 20,8"/>
            <path d="M16 13a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
            <path d="M14 5v4a2 2 0 0 1-2 2H8"/>
          </svg>
          Choose File
        </button>
            </div>

            <!-- Selected Image Preview -->
            <div class="selected-image-preview" id="selectedImagePreview">
              <h4>Selected Image</h4>
              <div id="imagePreviewContent">
                <p class="no-image-placeholder">No image selected</p>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="picture-actions">
            <!-- Upload Section -->
            <div class="action-section upload-section">
              <p>Replace your current profile picture with a new one.</p>
              <button type="button" id="uploadBtn" class="upload-action-btn" disabled>
            <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.5rem;">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7,10 12,15 17,10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Upload Picture
          </button>
            </div>

            <!-- Delete Section -->
            <div class="action-section delete-section">
              <p>Delete your current profile picture and use the default avatar.</p>
              <button type="button" id="deleteBtn" class="delete-action-btn">
            <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24" style="display: inline; vertical-align: middle; margin-right: 0.5rem;">
              <polyline points="3,6 5,6 21,6"/>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
              <line x1="10" y1="11" x2="10" y2="17"/>
              <line x1="14" y1="11" x2="14" y2="17"/>
            </svg>
            Delete Picture
          </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Notification Modal -->
<div id="notificationModal" class="notification-modal">
  <div class="notification-content">
    <div id="notificationIcon" class="notification-icon">
      <span id="notificationIconText">✓</span>
    </div>
    <h3 id="notificationTitle" class="notification-title">Success</h3>
    <p id="notificationMessage" class="notification-message">Operation completed successfully!</p>
    <div id="notificationActions" class="notification-actions">
      <button id="notificationOkBtn" class="notification-btn primary">OK</button>
    </div>
  </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmationModal" class="notification-modal">
  <div class="notification-content">
          <div class="notification-icon warning">
        <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </div>
    <h3 id="confirmationTitle" class="notification-title">Confirm Action</h3>
    <p id="confirmationMessage" class="notification-message">Are you sure you want to proceed?</p>
    <div class="notification-actions">
      <button id="confirmationCancelBtn" class="notification-btn secondary">Cancel</button>
      <button id="confirmationConfirmBtn" class="notification-btn danger">Confirm</button>
    </div>
  </div>
  </div>
</div>

<!-- ===========================================
     JAVASCRIPT CONNECTION
     ===========================================
     This page includes JavaScript functionality from:
     - public/javascripts/ejs/profileadmin.js (main client-side logic)
     =========================================== -->
<script src="/javascripts/ejs/profileadmin.js"></script>

<script>
// Sidebar hover effect
const sidebar = document.getElementById('adminSidebar');
if (sidebar) {
  sidebar.addEventListener('mouseenter', function() {
    this.classList.add('expanded');
  });
  sidebar.addEventListener('mouseleave', function() {
    this.classList.remove('expanded');
  });
}

// OVERRIDE openModal function with EJS template support
function openModal(id) {
  const modal = document.getElementById(id);
  modal.style.display = 'flex';

  // Student logic with enhanced functionality
  if (id === 'updateProfileModal' && '<%= user.userType %>' === 'student') {
    console.log('Initializing student organization select for student user');
    const select = $('#studentOrganization');
    if (!select.hasClass('select2-hidden-accessible')) {
      console.log('Select2 not yet initialized, initializing now...');
      select.select2({
        placeholder: "Search and select organizations...",
        allowClear: true,
        width: '100%',
        dropdownParent: $('#updateProfileModal'),
        closeOnSelect: false,
        templateResult: function(data) {
          if (!data.id) return data.text;
          return $(`<div style="padding: 4px 0;">${data.text}</div>`);
        }
      });

      // Initialize with organization options
      const organizationOptions = [
        "University Student Government (USG)",
        "Internal Audit Service (IAS)",
        "University Student Election Commission (USEC)",
        "Office of the Solicitor General (OSG)",
        "College of Business Administration and Accountancy Student Government (CBAASG)",
        "Business Management Program Council (BMPC)",
        "Junior Philippine Institute of Accountants (JPIA)",
        "Marketing Management Program Council (MMPC)",
        "College of Education Student Government (COEdSG)",
        "College of Engineering, Architecture and Technology Student Government (CEATSG)",
        "Architecture Program Council (ArchPC)",
        "Civil Engineering Program Council (CEEPC)",
        "Computer Engineering Program Council (CpEPC)",
        "Electrical Engineering Program Council (EEEPC)",
        "Electronics Engineering Program Council (ECEPC)",
        "Industrial Engineering Program Council (IEEPC)",
        "Mechanical Engineering Program Council (MEEPC)",
        "Multimedia Arts Program Council (MMAPC)",
        "College of Tourism and Hospitality Management Student Government (CTHMSG)",
        "College of Criminal Justice Education Student Government (CCJESG)",
        "Criminology Program Council (CrimPC)",
        "Forensic Science Program Council (FScPC)",
        "College of Liberal Arts and Communication Student Government (CLACSG)",
        "Communication Program Council (CPC)",
        "International Development Program Council (IDPC)",
        "Political Science Program Council (PSPC)",
        "Psychology Program Council (PPC)",
        "College of Science Student Government (COSSG)",
        "Applied Mathematics Program Council (AMPC)",
        "Biology Program Council (BioPC)",
        "College of Information and Computer Studies Student Government (CICSSG)",
        "Computer Science Program Council (CSPC)",
        "Information Technology Program Council (ITPC)",
        "DLSU-D Chorale (CHORALE)",
        "Lasallian Symphony Orchestra (LSO)",
        "La Salle Filipiniana Dance Company (LSFDC)",
        "Lasallian Pointes N' Flexes Dance Company (LPNFDC)",
        "Lasallian Pop Band (LPB)",
        "Teatro Lasalliana (TEATRO)",
        "Visual and Performing Arts Production Unit (VPAPU)",
        "Heraldo Filipino",
        "Vicissitude",
        "Council of Student Organizations (CSO)",
        "Business Operations Management Society (BOMS)",
        "Junior Marketing Association (JMA)",
        "DLSU-D Psychological Society (DPS)",
        "DLSU-D Pre-Medical Society (DPMS)",
        "Hotel and Restaurant Management Society (HRMS)",
        "Turismo Lasalleño Society (TLS)",
        "Lasallian Educators Society (LES)",
        "American Society of Heating, Refrigerating, and Air-Conditioning Engineers (ASHRAE DLSU-D)",
        "DLSU-D Pre-Law Society (DPLS)",
        "Astraeus Literary and Arts Guild",
        "Accounting Enrichment Society (ACES)",
        "Circle of Student Assistants (COSA)",
        "DLSU-D Lifters",
        "DLSU-D Patriots of Animal Welfare and Support (PAWS)",
        "DLSU-D United Patriots Football Club",
        "Junior Financial Executives Institute of the Philippines (JFINEX)",
        "Marché Société (MS)",
        "PROJECT: Ikigai (PROJ:Ik) - former Viridescent A-1",
        "SINAG Society of Leaders (SISOL)",
        "Campus Peer Ministers (CPM) and Youth for Christ of (YFC) of Campus Ministry Office",
        "Lasallian Peer Facilitators (LPF) of Student Wellness Center",
        "Lasallian Student Ambassadors (LSA) of Linkages and Scholarship Office",
        "LS Verde of Campus Sustainability Office",
        "Students' Extension of Resources through Voluntary Effort (SERVE) of LCDC",
        "Green FM of Communications and Journalism Department",
        "International Students' Association (ISA) of International Students Office",
        "Lasallian Youth Accompaniment Group (LaYAG) of University Lasallian Family Office"
      ];

      const currentOrgs = `<%= user.studentOrganization || '' %>`
        .split(',')
        .map(o => o.trim())
        .filter(Boolean);

      // Add predefined options
      organizationOptions.forEach(org => {
        const exists = currentOrgs.includes(org);
        if (select.find(`option[value="${org}"]`).length === 0) {
          const option = new Option(org, org, exists, exists);
          select.append(option);
        }
      });

      // Add custom organizations
      currentOrgs.forEach(org => {
        if (!organizationOptions.includes(org)) {
          if (select.find(`option[value="${org}"]`).length === 0) {
            const option = new Option(org, org, true, true);
            select.append(option);
          }
        }
      });

      select.trigger('change');
      updateOrganizationCounter();

      // Listen for selection changes
      select.on('change', function() {
        updateOrganizationCounter();
        // Re-setup click handlers after any change
        setTimeout(setupOrganizationClickHandlers, 100);
      });

      // Initial setup of click handlers
      setTimeout(setupOrganizationClickHandlers, 200);
    }

    // Set up toggle functionality
    document.getElementById('toggleCustomOrg').onclick = toggleCustomOrg;

    // Set up add organization button
    document.getElementById('addOrganizationButton').onclick = addCustomOrganization;

    // Set up Enter key functionality
    document.getElementById('otherOrganization').onkeypress = function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        addCustomOrganization();
      }
    };
  }

  // NON-STUDENT LOGIC - Fixed version for multiple selection
  if (id === 'updateProfileModal' && '<%= user.userType %>' !== 'student') {
    const select = $('#officeSelect');
    
    // Only initialize if not already initialized
    if (!select.hasClass('select2-hidden-accessible')) {
      console.log('Initializing office select for non-student user');
      
      // Office options array
      const officeOptions = [
        "Office of the President",
        "Office of the Chief Administrative Officer",
        "Office of the Provost",
        "Office of the Chief Lasallian Mission Officer",
        "Office of the Principal",
        "Corporate and Executive Management Office",
        "Center for Heritage Conservation",
        "Museo De La Salle",
        "Risk, Compliance and Audit Office",
        "University Chaplain",
        "Office of the Vice President for Administrative Services",
        "Office of the Vice President for Finance",
        "Office of the Vice President for Global Engagement and External Relations",
        "Office of the Vice President for Research, Innovation, and Productive Partnerships",
        "Office of the Vice President for Student Welfare and Services",
        "Office of the Vice Chancellor for Academics",
        "Office of the Vice Chancellor for Administration and Finance",
        "Office of the Vice Chancellor for Research and Innovation",
        "Office of the Vice Chancellor for Lasallian Mission and Internationalization",
        "Office of the Vice Chancellor for Student Services",
        "University Registrar",
        "Admissions and Aid Office",
        "Learning Management Center",
        "Quality Assurance Office",
        "University Strategic Planning Office",
        "Graduate School Office",
        "Research and Advanced Studies Office",
        "Technology Transfer and Management Office",
        "Linkages and Scholarship Office",
        "Publications and External Relations Office",
        "Career Services Office",
        "Cultural Arts Office",
        "Sports Development Office",
        "Student Discipline Office",
        "Student Wellness Center",
        "Student Publication Office",
        "Campus Ministry Office",
        "Lasallian Community Engagement and Development Center",
        "Human Resources Management Office",
        "Accounting Office",
        "Budget Office",
        "Internal Audit Office",
        "Procurement Office",
        "Treasury Office",
        "Corporate Planning Office",
        "Legal Office",
        "Safety and Security Office",
        "Facilities Management Office",
        "Information Communication Technology Management Office",
        "Learning Innovation Center",
        "Library Services",
        "University Lasallian Family Office",
        "University Student Services",
        "College of Business Administration and Accountancy",
        "College of Criminal Justice Education",
        "College of Education",
        "College of Engineering, Architecture and Technology",
        "College of Information and Computer Studies",
        "College of Liberal Arts and Communication",
        "College of Science",
        "College of Tourism and Hospitality Management"
      ];

      // Get current affiliations from server
      const currentAffiliations = `<%= user.affiliation || '' %>`
        .split(',')
        .map(o => o.trim())
        .filter(Boolean);

      console.log('Current affiliations:', currentAffiliations);

      // Clear any existing options first
      select.empty();

      // Add predefined office options
      officeOptions.forEach(office => {
        const isSelected = currentAffiliations.includes(office);
        const option = new Option(office, office, isSelected, isSelected);
        select.append(option);
      });

      // Add any custom affiliations not in the predefined list
      currentAffiliations.forEach(affiliation => {
        if (!officeOptions.includes(affiliation)) {
          const option = new Option(affiliation, affiliation, true, true);
          select.append(option);
        }
      });

      // Initialize Select2 AFTER adding all options
      select.select2({
        placeholder: "Search and select office/department...",
        allowClear: true,
        width: '100%',
        dropdownParent: $('#updateProfileModal'),
        closeOnSelect: false,
        templateResult: function(data) {
          if (!data.id) return data.text;
          return $(`<div style="padding: 4px 0;">${data.text}</div>`);
        }
      });

      // Trigger change to update display
      select.trigger('change');

      console.log('Office select initialized with', select.val()?.length || 0, 'selections');

      // Listen for selection changes
      select.on('change', function() {
        const selectedCount = select.val()?.length || 0;
        console.log('Office selection changed:', selectedCount, 'items');
        // Re-setup click handlers after any change
        setTimeout(setupOfficeClickHandlers, 100);
      });

      // Initial setup of click handlers
      setTimeout(setupOfficeClickHandlers, 200);
    }
  }
}
</script>

</body>
</html>
