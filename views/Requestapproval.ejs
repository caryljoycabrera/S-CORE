  <!-- Conversation Modal -->
  <div id="conversationModal" class="modal" style="display:none;">
    <div class="modal-content" style="max-width: 800px; width: 90%; height: 80vh; overflow: hidden;">
      <header class="modal-header">
        <span class="modal-title">Conversation</span>
        <span class="close" id="closeConversationModal">&times;</span>
      </header>
      <div class="modal-body" style="display: flex; flex-direction: column; height: calc(100% - 60px); padding: 0; overflow: hidden;">
        <div id="messagesContainer" style="flex: 1; overflow-y: auto; padding: 1rem; background: #f9f9f9; min-height: 400px;">
        </div>
        <div style="padding: 1rem; border-top: 1px solid #e5e7eb; background: white; flex-shrink: 0;">
          <div style="display: flex; gap: 0.5rem;">
            <input type="text" id="messageInput" placeholder="Type your message..." 
                   style="flex: 1; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.375rem;">
            <button id="sendMessageBtn" class="view-all-btn" style="background: var(--primary-green); color: white;">
              Send
            </button>
