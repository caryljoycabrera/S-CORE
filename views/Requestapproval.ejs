<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Request for Approval</title>
  <link rel="stylesheet" href="/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
<style>
   .modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0,0,0,0.5);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}
.modal-content {
  background: white;
  border-radius: 1rem;
  max-width: 480px;
  width: 90%;
  box-shadow: var(--card-shadow);
  overflow: hidden;
}
.modal-title.submission {
  font-size: 1.25rem;
  font-weight: 600;
  color: rgb(194, 122, 40);
}
</style>
</head>
<body>
  <div class="student-side">
    <div class="div">
      <div class="overlap">
        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/dashboard" class="text-wrapper">S-CORE</a>
        <span class="text-wrapper-2">Request for Approval</span>

        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>

      <section class="activity-section">
        <div class="section-header">
          <div class="profile-info" style="display: flex; align-items: center; gap: 1rem;">
            <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" 
                 alt="Profile Picture" class="profile-pic-large" style="width:64px;height:64px;border-radius:50%;" />
            <div>
              <h2 style="margin-bottom: 0.25rem;"><%= user.fName %> <%= user.lName %></h2>
              <p style="color: #6b7280;"><%= user.userType === 'student' ? 'Student' : 'Non-Student' %></p>
            </div>
          </div>
          <button class="view-all-btn" id="openModalBtn">+ Request Approval</button>
        </div>

        <nav class="tabs" style="display: flex; gap: 1rem; margin-bottom: 1rem;">
          <a href="/all-requests" class="view-all-btn">All Requests</a>
          <a href="/request-approvals" class="view-all-btn" style="background: var(--primary-green); color: white;">Request Approvals</a>
          <a href="/service-requests" class="view-all-btn">Service Requests</a>
        </nav>

        <div class="filter-section">
          <div class="filter-container">
            <div class="filter-group">
              <label class="filter-label">Filter by:</label>
              <div class="filter-controls">
 <div class="filter-item">
                <label class="filter-sublabel">Status</label>
                <div class="custom-select-wrapper">
                  <div class="custom-select" id="statusFilter">
                    <div class="select-display">All Status</div>
                    <div class="select-dropdown" id="statusDropdown">
                      <label class="dropdown-option">
                        <input type="checkbox" value="all" checked> All Status
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="pending"> Pending
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="approved"> Approved
                      </label>
                      <label class="dropdown-option">
                        <input type="checkbox" value="rejected"> Rejected
                      </label>
                    </div>
                  </div>
                </div>
              </div>
                <div class="filter-item">
                  <label for="titleFilter" class="filter-sublabel">Title</label>
                  <input type="text" id="titleFilter" class="filter-input" placeholder="Search title...">
                </div>
                <div class="filter-item">
                  <label for="organizationFilter" class="filter-sublabel">Office/Department/Organization</label>
                  <input type="text" id="organizationFilter" class="filter-input" placeholder="Search organization...">
                </div>
              </div>
              <br>
              <div class="filter-controls">
                <div class="filter-item">
                  <label for="dateFromFilter" class="filter-sublabel">Date From</label>
                  <input type="date" id="dateFromFilter" class="filter-input">
                </div>
                <div class="filter-item">
                  <label for="dateToFilter" class="filter-sublabel">Date To</label>
                  <input type="date" id="dateToFilter" class="filter-input">
                </div>
              </div>
            </div>
            <div class="filter-actions">
              <button id="clearFilters" class="clear-filters-btn">
                <span>🗑️</span> Clear All
              </button>
              <div class="results-count">
                <span id="resultsCount">Showing all requests</span>
              </div>
            </div>
          </div>
        </div>

        <section class="table-section" style="overflow-x: auto;">
          <table class="requests-table" style="width: 100%; border-collapse: collapse; border-radius: var(--border-radius); box-shadow: var(--card-shadow); overflow: hidden; background: white;">
            <thead style="background: var(--light-green); color: var(--primary-green);">
              <tr>
                <th>Request ID</th>
                <th>Project Title</th>
                <th>Office/Department/Organization</th>
                <th>Status</th>
                <th>Assigned Units</th>
                <th>Date Submitted</th>
              </tr>
            </thead>
            <tbody id="requestsTableBody">
              <% allRequests.forEach(request => { %>
              <tr class="request-row"
                  data-id="<%= request._id %>"
                  data-type="<%= request.type %>"
                  data-title="<%= request.title %>"
                  data-status="<%= request.status %>"
                  data-organization="<%= user.userType === 'nonstudent' ? user.affiliation : request.organization %>"
                  data-units="<%= request.assignedUnits || 'Not yet assigned' %>"
                  data-datetime="<%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %>"
                  data-date="<%= request.datetime ? request.datetime.toISOString().split('T')[0] : new Date(request.createdAt).toISOString().split('T')[0] %>""
                  data-description="<%= request.description %>" 
                  data-file="<%= request.file ? request.file : '' %>">
                <td><%= request._id.toString().slice(-6) %></td>
                <td><%= request.title %></td>
                <td><%= user.userType === 'nonstudent' ? user.affiliation : request.organization %></td>
                <td>
                  <span class="status-badge <%= request.status.toLowerCase() %>">
                    <%= request.status %>
                  </span>
                </td>
                <td><%= request.assignedUnits || 'Not yet assigned' %></td>
                <td><%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>

          <% if (!allRequests || allRequests.length === 0) { %>
          <div style="text-align: center; padding: 2rem; color: #6b7280;">
            <p>No requests found.</p>
          </div>
          <% } %>
        </section>
      </section>
      <a href="/dashboard" class="view-all-btn" style="display: inline-block;">← Back to Dashboard</a>
    </div>
  </div>

  <!-- Create Request Modal -->
  <div id="requestModal" class="modal" style="display:none;">
    <div class="modal-content">
      <header class="modal-header">
        <span class="modal-title">Create a Request for Approval</span>
        <span class="close" id="closeModalBtn">&times;</span>
      </header>
<form class="modal-form" action="/submit-request-approval" method="POST" enctype="multipart/form-data" onsubmit="handleSubmit(event)">
  <div class="form-group">
    <label for="projectTitle">Project/Event Title:</label>
    <input type="text" id="projectTitle" name="projectTitle" required />
  </div>
  <div class="form-group">
    <label for="organization">Organization:</label>
    <%
      let orgs = [];
      if (Array.isArray(user.studentOrganization)) {
        if (user.studentOrganization.length === 1 && user.studentOrganization[0].includes(',')) {
          orgs = user.studentOrganization[0].split(',').map(o => o.trim()).filter(Boolean);
        } else {
          orgs = user.studentOrganization;
        }
      } else if (typeof user.studentOrganization === 'string') {
        orgs = user.studentOrganization.split(',').map(o => o.trim()).filter(Boolean);
      }
    %>
    <select id="organization" name="organization" required>
      <% orgs.forEach(function(org) { %>
        <option value="<%= org %>"><%= org %></option>
      <% }); %>
    </select>
  </div>
  <div class="form-group">
    <label for="description">Description:</label>
    <textarea id="description" name="description" rows="5" required></textarea>
  </div>
  <div class="form-group">
    <label for="upload">Upload File:</label>
    <input type="file" id="upload" name="upload" required />
  </div>
  <div class="form-actions">
    <button type="submit" class="view-all-btn" style="background: var(--success); color: white;">Submit</button>
    <button type="button" class="view-all-btn" id="cancelModalBtn">Cancel</button>
  </div>
</form>
    </div>
  </div>

  <!-- Request Details Modal -->
  <div id="detailsModal" class="modal" style="display:none;">
    <div class="modal-content">
      <header class="modal-header">
        <span class="modal-title">Request Details</span>
        <span class="close" id="closeDetailsModal">&times;</span>
      </header>
      <div class="modal-body">
        <p><strong>Type:</strong> <span id="detailType"></span></p>
        <p><strong>Title:</strong> <span id="detailTitle"></span></p>
        <p><strong>Office/Department/Organization:</strong> <span id="detailOrganization"></span></p>
        <p><strong>Description:</strong> <span id="detailDescription"></span></p>
        <p><strong>Status:</strong> <span id="detailStatus"></span></p>
        <p><strong>Assigned Units:</strong> <span id="detailUnits"></span></p>
        <p><strong>Date Submitted:</strong> <span id="detailDatetime"></span></p>
        <div id="file-preview" style="margin-top:1rem;"></div>
      </div>
    </div>
  </div>

  <!-- Submission Confirmation Modal -->
<div id="submissionConfirmationModal" class="modal" style="display:none;">
  <div class="modal-content">
    <header class="modal-header">
      <span class="modal-title submission">Request Submitted</span>
      <span class="close" id="closeSubmissionConfirmation">&times;</span>
    </header>
    <div class="modal-body" style="padding: 1rem 2rem;">
  <p>Thank you for submitting your request for approval.</p>
      <br>
  <p>Please take a moment to carefully review the information you have provided to ensure its accuracy before finalizing.</p>
  <p>The S-CORE team strives to provide feedback within <strong>three (3) working days</strong>, though requests may be processed sooner if possible. This timeline will always be respected unless the office is experiencing a high volume of requests or is temporarily busy.</p>
      <br>
  <p>We appreciate your understanding and patience as we work to process your request efficiently.</p>
      <button id="okSubmissionBtn" class="view-all-btn" style="background: rgb(194, 122, 40); color: white; margin-top: 1rem;">OK</button>
      <button id="CancelBtn" class="view-all-btn" style="background: #e5e7eb; color: #374151;">Cancel</button>

    </div>
  </div>
</div>


  <script>
    function pad(n) { return n < 10 ? '0' + n : n; }
    function formatDateTimeLocal(date) {
      return date.getFullYear() + '-' +
        pad(date.getMonth() + 1) + '-' +
        pad(date.getDate()) + 'T' +
        pad(date.getHours()) + ':' +
        pad(date.getMinutes());
    }

    const openModalBtn = document.getElementById('openModalBtn');
    const requestModal = document.getElementById('requestModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const cancelModalBtn = document.getElementById('cancelModalBtn');
    const detailModal = document.getElementById("detailsModal");
    const closeDetailsModal = document.getElementById("closeDetailsModal");
    const clearFiltersBtn = document.getElementById("clearFilters");
    const tableBody = document.getElementById("requestsTableBody");
    const allRows = Array.from(document.querySelectorAll('.request-row'));
    const submissionModal = document.getElementById('submissionConfirmationModal');
    const closeSubmissionBtn = document.getElementById('closeSubmissionConfirmation');
    const okSubmissionBtn = document.getElementById('okSubmissionBtn');

    closeSubmissionBtn.onclick = () => {
      submissionModal.style.display = 'none';
    };

    okSubmissionBtn.onclick = () => {
      submissionModal.style.display = 'none';
    };

    // Close modal when clicking outside of content
    window.onclick = function(event) {
      if (event.target === submissionModal) {
        submissionModal.style.display = 'none';
      }
    }


    openModalBtn.onclick = () => {
      requestModal.style.display = 'flex';
    };
    closeModalBtn.onclick = () => requestModal.style.display = 'none';
    cancelModalBtn.onclick = () => requestModal.style.display = 'none';
    closeDetailsModal.onclick = () => detailModal.style.display = 'none';

    window.onclick = function(event) {
      if (event.target === requestModal) requestModal.style.display = 'none';
      if (event.target === detailModal) detailModal.style.display = 'none';
    }

function filterRequests() {
  const selectedStatuses = getSelectedStatuses();
  const titleValue = document.getElementById('titleFilter').value.toLowerCase();
  const organizationValue = document.getElementById('organizationFilter').value.toLowerCase();
  const dateFromValue = document.getElementById('dateFromFilter').value;
  const dateToValue = document.getElementById('dateToFilter').value;

  let visibleCount = 0;

  allRows.forEach(row => {
    const rowStatus = row.dataset.status.toLowerCase();
    const rowTitle = row.dataset.title.toLowerCase();
    const rowOrganization = row.dataset.organization.toLowerCase();
    const rowDate = row.dataset.date; // YYYY-MM-DD from dataset

    // Status filter
    const statusMatch = selectedStatuses.length === 0 || selectedStatuses.includes('all') || selectedStatuses.includes(rowStatus);

    // Title filter
    const titleMatch = (titleValue === '' || rowTitle.includes(titleValue));

    // Organization filter
    const organizationMatch = (organizationValue === '' || rowOrganization.includes(organizationValue));

    // Date range filter (convert to Date objects for reliable comparison)
    let dateMatch = true;
    if (dateFromValue) dateMatch = dateMatch && (rowDate >= dateFromValue);
    if (dateToValue) dateMatch = dateMatch && (rowDate <= dateToValue);

    // Final combined check (all filters must match)
    const isVisible = statusMatch && titleMatch && organizationMatch && dateMatch;
    row.style.display = isVisible ? '' : 'none';

    if (isVisible) visibleCount++;
  });

  // Update result count
  const totalCount = allRows.length;
  const resultsCount = document.getElementById('resultsCount');
  if (visibleCount === totalCount) {
    resultsCount.textContent = `Showing all ${totalCount} requests`;
  } else {
    resultsCount.textContent = `Showing ${visibleCount} of ${totalCount} requests`;
  }

  // Show or hide "no results" message
  toggleNoResultsMessage(visibleCount === 0);
}


    function toggleNoResultsMessage(show) {
      let noResultsRow = document.getElementById('noResultsRow');
      
      if (show && !noResultsRow) {
        const tbody = document.getElementById('requestsTableBody');
        noResultsRow = document.createElement('tr');
        noResultsRow.id = 'noResultsRow';
        noResultsRow.innerHTML = `
          <td colspan="6" style="text-align: center; padding: 3rem; color: #6b7280;">
            <div style="font-size: 3rem; margin-bottom: 1rem;">🔍</div>
            <h3 style="margin-bottom: 0.5rem; color: var(--primary-green);">No requests found</h3>
            <p>Try adjusting your filters to see more results.</p>
          </td>
        `;
        tbody.appendChild(noResultsRow);
      } else if (!show && noResultsRow) {
        noResultsRow.remove();
      }
    }

    statusFilter.addEventListener('change', filterRequests);
    document.getElementById('titleFilter').addEventListener('input', filterRequests);
    document.getElementById('organizationFilter').addEventListener('input', filterRequests);
    document.getElementById('dateFromFilter').addEventListener('change', filterRequests);
    document.getElementById('dateToFilter').addEventListener('change', filterRequests);

    clearFiltersBtn.addEventListener('click', () => {
      statusFilter.value = 'all';
      document.getElementById('titleFilter').value = '';
      document.getElementById('organizationFilter').value = '';
      document.getElementById('dateFromFilter').value = '';
      document.getElementById('dateToFilter').value = '';
       statusCheckboxes.forEach(cb => cb.checked = false);
      allStatusCheckbox.checked = true;
      updateStatusDisplay()

      filterRequests();
    });

    document.querySelectorAll('.request-row').forEach(row => {
      row.addEventListener('click', () => {
        document.getElementById("detailType").innerText = row.dataset.type;
        document.getElementById("detailTitle").innerText = row.dataset.title;
        document.getElementById("detailOrganization").innerText = row.dataset.organization;
        document.getElementById("detailDescription").innerText = row.dataset.description || 'N/A';
        document.getElementById("detailStatus").innerText = row.dataset.status;
        document.getElementById("detailUnits").innerText = row.dataset.units;
        document.getElementById("detailDatetime").innerText = row.dataset.datetime;

        const file = row.dataset.file;
        const previewContainer = document.getElementById('file-preview');
        previewContainer.innerHTML = '';
        if (file) {
          const fileUrl = `/uploads/${file}`;
          const ext = file.split('.').pop().toLowerCase();
          if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext)) {
            previewContainer.innerHTML = `<img src="${fileUrl}" alt="Uploaded Image" style="max-width:100%; border-radius: 8px;" /><br><a href="${fileUrl}" target="_blank">Open Image</a>`;
          } else if (ext === 'pdf') {
            previewContainer.innerHTML = `<embed src="${fileUrl}" width="100%" height="400px" /><br><a href="${fileUrl}" target="_blank">Open PDF</a>`;
          } else {
            previewContainer.innerHTML = `<p>Click to download:</p><a href="${fileUrl}" target="_blank">Download File (${file})</a>`;
          }
        } else {
          previewContainer.innerHTML = `<p>No file uploaded.</p>`;
        }
        detailModal.style.display = 'flex';
      });
    });

    function toggleDropdown() {
      const menu = document.getElementById("dropdownMenu");
      menu.style.display = menu.style.display === "block" ? "none" : "block";
    }

    document.addEventListener("click", function (event) {
      const toggle = document.querySelector(".dropdown-toggle");
      const menu = document.getElementById("dropdownMenu");
      if (!toggle.contains(event.target)) {
        menu.style.display = "none";
      }
    });
    //show submission confirmation modal
  function handleSubmit(event) {
  event.preventDefault(); // stop immediate submit

  const submissionModal = document.getElementById('submissionConfirmationModal');
  submissionModal.style.display = 'flex';

  function submitForm() {
    submissionModal.style.display = 'none';
    // remove listeners after submit to avoid duplicates
    okSubmissionBtn.removeEventListener('click', submitForm);
    closeSubmissionConfirmation.removeEventListener('click', submitForm);

    // submit the form now
    event.target.submit();
  }

  const okSubmissionBtn = document.getElementById('okSubmissionBtn');
  const closeSubmissionConfirmation = document.getElementById('closeSubmissionConfirmation');

  okSubmissionBtn.addEventListener('click', submitForm);
  closeSubmissionConfirmation.addEventListener('click', submitForm);
}
const cancelSubmissionBtn = document.getElementById('CancelBtn');

cancelSubmissionBtn.onclick = () => {
  // Just hide the submission confirmation modal
  submissionModal.style.display = 'none';
  // The request form modal is still open so user can edit
};

    // Custom Status Filter Logic
const statusFilterElement = document.getElementById('statusFilter');
const statusDropdown = document.getElementById('statusDropdown');
const statusDisplay = statusFilterElement.querySelector('.select-display');
const statusCheckboxes = statusDropdown.querySelectorAll('input[type="checkbox"]');
const allStatusCheckbox = statusDropdown.querySelector('input[value="all"]');

// Toggle dropdown
statusFilterElement.addEventListener('click', function(e) {
  e.stopPropagation();
  statusFilterElement.classList.toggle('active');
});

// Close dropdown when clicking outside
document.addEventListener('click', function() {
  statusFilterElement.classList.remove('active');
});

// Handle checkbox changes
statusCheckboxes.forEach(checkbox => {
  checkbox.addEventListener('change', function() {
    if (this.value === 'all') {
      // If "All Status" is checked, uncheck others
      if (this.checked) {
        statusCheckboxes.forEach(cb => {
          if (cb.value !== 'all') cb.checked = false;
        });
      }
    } else {
      // If any specific status is checked, uncheck "All Status"
      if (this.checked) {
        allStatusCheckbox.checked = false;
      }
      
      // If no specific status is checked, check "All Status"
      const specificChecked = Array.from(statusCheckboxes).some(cb => 
        cb.value !== 'all' && cb.checked
      );
      if (!specificChecked) {
        allStatusCheckbox.checked = true;
      }
    }
    
    updateStatusDisplay();
    filterRequests();
  });
});

function updateStatusDisplay() {
  const checkedBoxes = Array.from(statusCheckboxes).filter(cb => cb.checked);
  
  if (allStatusCheckbox.checked || checkedBoxes.length === 0) {
    statusDisplay.textContent = 'All Status';
  } else if (checkedBoxes.length === 1) {
    statusDisplay.textContent = checkedBoxes[0].value.charAt(0).toUpperCase() + 
                              checkedBoxes[0].value.slice(1);
  } else {
    statusDisplay.textContent = `${checkedBoxes.length} Selected`;
  }
}

// Get selected status values for filtering
function getSelectedStatuses() {
  const checkedBoxes = Array.from(statusCheckboxes).filter(cb => 
    cb.checked && cb.value !== 'all'
  );
  
  if (allStatusCheckbox.checked || checkedBoxes.length === 0) {
    return [];
  }
  
  return checkedBoxes.map(cb => cb.value.toLowerCase());
}


  </script>
</body>
</html>