          <!-- Chat Section -->
          <div class="chat-section" id="chatButtonSection" style="display: none;">
            <h4 style="margin: 0 0 1rem 0; color: var(--primary-green); font-weight: 600;">Need to discuss this request?</h4>
            <button id="openChatFromDetailsModal" class="chat-btn-enhanced">
              <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
