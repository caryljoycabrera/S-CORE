<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Request for Approval</title>
  <link rel="stylesheet" href="/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
<style>
/* Modal Styles */
.modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0,0,0,0.5);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 9999;
  padding: 20px;
}

.modal-content {
  background: white;
  border-radius: 1rem;
  max-width: 800px;
  width: 95%;
  max-height: 90vh;
  box-shadow: var(--card-shadow);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 1.5rem;
  border-bottom: 1px solid #e5e7eb;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 0;
}

.modal-form {
  padding: 1rem 1.5rem;
  display: grid;
  grid-template-columns: 1fr 1fr; 
  gap: 1.5rem;
}

.form-group.full-width {
  grid-column: 1 / -1;
}

.form-group {
  display: flex;
  flex-direction: column;
}

.form-group label {
  font-weight: 600;
  font-size: 0.875rem;
  color: #374151;
  margin-bottom: 0.5rem;
  display: block;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 0.75rem;
  border: 2px solid #e5e7eb;
  border-radius: 0.5rem;
  font-size: 1rem;
  background-color: white;
  color: #1f2937;
  transition: all 0.3s ease;
  font-family: inherit;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--primary-green);
  box-shadow: 0 0 0 3px rgba(64, 139, 78, 0.1);
}

.form-group input[readonly] {
  background-color: #f9fafb;
  color: #6b7280;
  cursor: not-allowed;
}

.form-group textarea {
  resize: vertical;
  min-height: 120px;
}

.form-actions {
  grid-column: 1 / -1;
  display: flex;
  gap: 1rem;
  justify-content: flex-end;
  padding-top: 1rem;
  border-top: 1px solid #e5e7eb;
  margin-top: 1rem;
}

/* Enhanced Filter Styles */
.enhanced-multi-select-wrapper {
  position: relative;
  width: 100%;
}

.enhanced-multi-select {
  position: relative;
  width: 100%;
}

.select-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.5rem 0.75rem;
  border: 1px solid #d1d5db;
  border-radius: 0.375rem;
  font-size: 0.875rem;
  color: #374151;
  background: white;
  cursor: pointer;
  transition: all 0.2s ease;
  min-height: 2.5rem;
  box-sizing: border-box;
}

.select-display:hover {
  border-color: #9ca3af;
}

.select-display.active {
  border-color: var(--primary-green);
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
}

.selected-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dropdown-arrow {
  margin-left: 0.5rem;
  font-size: 0.75rem;
  color: #6b7280;
  transition: transform 0.2s ease;
  flex-shrink: 0;
}

.select-display.active .dropdown-arrow {
  transform: rotate(180deg);
}

.select-dropdown {
  display: none;
  position: absolute;
  top: calc(100% + 2px);
  left: 0;
  right: 0;
  background: white;
  border: 1px solid #d1d5db;
  border-radius: 0.375rem;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  z-index: 1000;
  max-height: 300px;
  overflow: hidden;
  animation: dropdownSlideIn 0.2s ease-out;
}

@keyframes dropdownSlideIn {
  from {
    opacity: 0;
    transform: translateY(-10px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.select-dropdown.show {
  display: block;
}

.search-container {
  padding: 0.75rem;
  border-bottom: 1px solid #e5e7eb;
  background: #f9fafb;
}

.search-input {
  width: 100%;
  padding: 0.5rem;
  border: 1px solid #d1d5db;
  border-radius: 0.25rem;
  font-size: 0.875rem;
  background: white;
  transition: border-color 0.2s ease;
}

.search-input:focus {
  outline: none;
  border-color: var(--primary-green);
  box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.1);
}

.options-container {
  max-height: 200px;
  overflow-y: auto;
  padding: 0.25rem 0;
}

.dropdown-option {
  display: flex;
  align-items: center;
  padding: 0.5rem 0.75rem;
  cursor: pointer;
  font-size: 0.875rem;
  color: #374151;
  transition: background-color 0.15s ease;
  margin: 0;
  position: relative;
}

.dropdown-option:hover {
  background: #f3f4f6;
}

.dropdown-option.selected {
  background: #f0fdf4;
  color: var(--primary-green);
}

.dropdown-option input[type="checkbox"] {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.checkbox-custom {
  width: 16px;
  height: 16px;
  border: 2px solid #d1d5db;
  border-radius: 3px;
  margin-right: 0.75rem;
  position: relative;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.dropdown-option:hover .checkbox-custom {
  border-color: var(--primary-green);
}

.dropdown-option input[type="checkbox"]:checked + .checkbox-custom {
  background: var(--primary-green);
  border-color: var(--primary-green);
}

.dropdown-option input[type="checkbox"]:checked + .checkbox-custom::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: white;
  font-size: 11px;
  font-weight: bold;
}

.options-container::-webkit-scrollbar {
  width: 6px;
}

.options-container::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 3px;
}

.options-container::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 3px;
}

.options-container::-webkit-scrollbar-thumb:hover {
  background: #a8a8a8;
}

.no-results {
  padding: 1rem;
  text-align: center;
  color: #6b7280;
  font-size: 0.875rem;
  font-style: italic;
}

/* Custom Select Wrapper for Status filters */
.custom-select-wrapper {
  position: relative;
  width: 100%;
}

.custom-select {
  position: relative;
  width: 100%;
}

.custom-select .select-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.5rem 0.75rem;
  border: 1px solid #d1d5db;
  border-radius: 0.375rem;
  font-size: 0.875rem;
  color: #374151;
  background: white;
  cursor: pointer;
  transition: all 0.2s ease;
  min-height: 2.5rem;
  box-sizing: border-box;
}

.custom-select .select-display:hover {
  border-color: #9ca3af;
}

.custom-select .select-display.active {
  border-color: var(--primary-green);
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
}

.custom-select .select-display::after {
  content: '▼';
  margin-left: 0.5rem;
  font-size: 0.75rem;
  color: #6b7280;
  transition: transform 0.2s ease;
  flex-shrink: 0;
}

.custom-select .select-display.active::after {
  transform: rotate(180deg);
}

.custom-select .select-dropdown {
  display: none;
  position: absolute;
  top: calc(100% + 2px);
  left: 0;
  right: 0;
  background: white;
  border: 1px solid #d1d5db;
  border-radius: 0.375rem;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  z-index: 1000;
  max-height: 300px;
  overflow: hidden;
  animation: dropdownSlideIn 0.2s ease-out;
}

.custom-select .select-dropdown.show {
  display: block;
}

.custom-select .dropdown-option {
  display: flex;
  align-items: center;
  padding: 0.5rem 0.75rem;
  cursor: pointer;
  font-size: 0.875rem;
  color: #374151;
  transition: background-color 0.15s ease;
  margin: 0;
  position: relative;
}

.custom-select .dropdown-option:hover {
  background: #f3f4f6;
}

.custom-select .dropdown-option.selected {
  background: #f0fdf4;
  color: var(--primary-green);
}

.custom-select .dropdown-option input[type="checkbox"] {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.custom-select .checkbox-custom {
  width: 16px;
  height: 16px;
  border: 2px solid #d1d5db;
  border-radius: 3px;
  margin-right: 0.75rem;
  position: relative;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.custom-select .dropdown-option:hover .checkbox-custom {
  border-color: var(--primary-green);
}

.custom-select .dropdown-option input[type="checkbox"]:checked + .checkbox-custom {
  background: var(--primary-green);
  border-color: var(--primary-green);
}

.custom-select .dropdown-option input[type="checkbox"]:checked + .checkbox-custom::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: white;
  font-size: 11px;
  font-weight: bold;
}

/* Message Styles */
.message {
  margin-bottom: 1rem;
  max-width: 80%;
}

.admin-message {
  margin-right: auto;
}

.user-message {
  margin-left: auto;
}

.message-content {
  padding: 0.75rem;
  border-radius: 0.5rem;
  background: white;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
}

.user-message .message-content {
  background: var(--primary-green);
  color: white;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
  font-size: 0.875rem;
}

.message-time {
  opacity: 0.7;
  font-size: 0.75rem;
}

.message-text {
  word-wrap: break-word;
}

/* Checkbox Container */
.checkbox-container {
  padding: 1rem;
  border-radius: 0.75rem;
  background: linear-gradient(145deg, #f8fdf9, #f0f9f1);
  border: 2px solid #d1fae5;
  transition: all 0.3s ease;
  cursor: pointer;
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

.checkbox-container:hover {
  background: linear-gradient(145deg, #f0f9f1, #e8f5e9);
  border-color: #a7f3d0;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.15);
}

.checkbox-container input[type="checkbox"] {
  accent-color: var(--primary-green);
  width: 1.25rem;
  height: 1.25rem;
  margin: 0;
  flex-shrink: 0;
}

.checkbox-text {
  flex: 1;
  font-weight: 500;
  color: #065f46;
}

.checkbox-description {
  margin-top: 0.5rem;
  color: #6b7280;
  font-size: 0.875rem;
  font-style: italic;
}

/* Enhanced File Upload */
.file-upload-group {
  position: relative;
  border: 2px dashed #cbd5e1;
  border-radius: 12px;
  padding: 2rem;
  text-align: center;
  background: linear-gradient(135deg, #fefefe, #f8fafc);
  transition: all 0.3s ease;
  cursor: pointer;
  min-height: 120px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.file-upload-group:hover {
  border-color: var(--primary-green);
  background: linear-gradient(135deg, #f0fdf4, #f7fee7);
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(64, 139, 78, 0.1);
}

.file-upload-group.has-file {
  border-color: var(--primary-green);
  background: linear-gradient(135deg, #f0fdf4, #f7fee7);
  border-style: solid;
}

.file-upload-group.dragover {
  border-color: var(--primary-green);
  background: linear-gradient(135deg, #f0fdf4, #f7fee7);
  box-shadow: 0 0 0 4px rgba(64, 139, 78, 0.1);
  transform: scale(1.02);
}

.upload-icon {
  width: 48px;
  height: 48px;
  margin-bottom: 1rem;
  color: #64748b;
  transition: color 0.3s ease;
}

.file-upload-group:hover .upload-icon,
.file-upload-group.dragover .upload-icon {
  color: var(--primary-green);
}

.upload-text {
  font-size: 1.1rem;
  font-weight: 600;
  color: #334155;
  margin-bottom: 0.5rem;
}

.upload-subtext {
  font-size: 0.9rem;
  color: #64748b;
  margin-bottom: 1rem;
}

.file-input-hidden {
  position: absolute;
  opacity: 0;
  width: 100%;
  height: 100%;
  cursor: pointer;
  z-index: 1;
}

.browse-file-btn {
  background: linear-gradient(135deg, var(--primary-green), #20c997);
  color: white;
  border: none;
  padding: 0.75rem 1.5rem;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 0.9rem;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  position: relative;
  z-index: 2;
}

.browse-file-btn:hover {
  background: linear-gradient(135deg, #157347, var(--primary-green));
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(64, 139, 78, 0.3);
}

/* File Management */
.file-management {
  margin-top: 1rem;
  width: 100%;
}

.file-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  padding: 0.5rem;
  background: #f8fafc;
  border-radius: 8px;
}

.clear-all-btn {
  background: #ef4444;
  color: white;
  border: none;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  font-size: 0.875rem;
  cursor: pointer;
  transition: all 0.3s ease;
  font-weight: 600;
}

.clear-all-btn:hover {
  background: #dc2626;
  transform: translateY(-1px);
}

.clear-all-btn:disabled {
  background: #9ca3af;
  cursor: not-allowed;
  transform: none;
}

.selected-files-container {
  margin-top: 1rem;
  max-height: 300px;
  overflow-y: auto;
  width: 100%;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: white;
}

.file-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem;
  border-bottom: 1px solid #f3f4f6;
  transition: all 0.3s ease;
}

.file-item:last-child {
  border-bottom: none;
}

.file-item:hover {
  background: #f8fafc;
}

.file-item-info {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex: 1;
}

.file-item-details {
  flex: 1;
}

.file-item-name {
  margin: 0 0 0.25rem 0;
  font-size: 0.875rem;
  font-weight: 600;
  color: #334155;
  word-break: break-all;
}

.file-item-size {
  margin: 0;
  font-size: 0.75rem;
  color: #64748b;
}

.file-delete-btn {
  background: #ef4444;
  color: white;
  border: none;
  padding: 0.375rem 0.75rem;
  border-radius: 4px;
  font-size: 0.75rem;
  cursor: pointer;
  transition: all 0.3s ease;
  font-weight: bold;
  min-width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.file-delete-btn:hover {
  background: #dc2626;
  transform: scale(1.1);
}

.files-summary {
  padding: 0.75rem;
  background: #f0f9ff;
  border-top: 1px solid #e2e8f0;
  font-size: 0.875rem;
  color: #0369a1;
  text-align: center;
  font-weight: 600;
}

.upload-progress {
  margin-top: 0.5rem;
  display: none;
}

.progress-bar {
  width: 100%;
  height: 8px;
  background: #e5e7eb;
  border-radius: 4px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--primary-green);
  transition: width 0.3s ease;
  width: 0%;
}

/* Enhanced Request Details Modal Styles */
.details-modal-body {
  padding: 0;
  max-height: 80vh;
  overflow-y: auto;
}

.details-content {
  padding: 2rem;
}

.details-section {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 2rem;
  margin-bottom: 1.5rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.details-section:hover {
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  transform: translateY(-1px);
}

.details-section h3 {
  margin: 0 0 1.5rem 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary-green);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
  position: relative;
}

.details-section h3::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 60px;
  height: 2px;
  background: var(--primary-green);
  border-radius: 1px;
}

.details-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

.details-field {
  background: white;
  border-radius: 12px;
  padding: 1.25rem;
  border: 1px solid #f1f5f9;
  transition: all 0.3s ease;
}

.details-field:hover {
  border-color: #e2e8f0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.details-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 0.5rem;
  display: block;
}

.details-value {
  font-size: 1rem;
  color: #1e293b;
  line-height: 1.6;
  font-weight: 500;
}

.status-badge-large {
  display: inline-flex;
  align-items: center;
  padding: 0.625rem 1.25rem;
  border-radius: 25px;
  font-size: 0.875rem;
  font-weight: 600;
  text-transform: capitalize;
  border: 2px solid transparent;
  transition: all 0.3s ease;
}

.status-badge-large.pending {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #92400e;
  border-color: #f59e0b;
}

.status-badge-large.approved {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  color: #065f46;
  border-color: #10b981;
}

.status-badge-large.rejected {
  background: linear-gradient(135deg, #fecaca, #fca5a5);
  color: #991b1b;
  border-color: #ef4444;
}

.status-badge-large.completed {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #1e40af;
  border-color: #3b82f6;
}

.description-section {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 2rem;
  margin-bottom: 1.5rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.description-section h3 {
  margin: 0 0 1.5rem 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary-green);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
  position: relative;
}

.description-section h3::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 60px;
  height: 2px;
  background: var(--primary-green);
  border-radius: 1px;
}

.description-content {
  background: white;
  border-radius: 12px;
  padding: 1.5rem;
  border: 1px solid #f1f5f9;
  line-height: 1.7;
  color: #374151;
  font-size: 1rem;
}

.chat-section {
  text-align: center;
  margin-top: 1.5rem;
  padding: 2rem;
  background: linear-gradient(135deg, #f0fdf4, #f7fee7);
  border-radius: 16px;
  border: 1px solid #bbf7d0;
}

.chat-btn-enhanced {
  background: linear-gradient(135deg, var(--primary-green), #20c997);
  color: white;
  border: none;
  padding: 1rem 2.5rem;
  border-radius: 30px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 1rem;
  box-shadow: 0 4px 20px rgba(64, 139, 78, 0.2);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.chat-btn-enhanced:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 30px rgba(64, 139, 78, 0.3);
  background: linear-gradient(135deg, #157347, var(--primary-green));
}

/* Enhanced file preview styles */
.enhanced-file-preview {
  background: linear-gradient(145deg, #ffffff, #f8fafc);
  border-radius: 16px;
  padding: 2rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  margin-bottom: 1.5rem;
}

.enhanced-file-preview h3 {
  margin: 0 0 1.5rem 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary-green);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #e2e8f0;
  position: relative;
}

.enhanced-file-preview h3::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 60px;
  height: 2px;
  background: var(--primary-green);
  border-radius: 1px;
}

.file-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 1.5rem;
}

.enhanced-file-item {
  background: white;
  border-radius: 16px;
  padding: 1.5rem;
  border: 2px solid #f1f5f9;
  transition: all 0.3s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.enhanced-file-item:hover {
  border-color: var(--primary-green);
  box-shadow: 0 8px 30px rgba(64, 139, 78, 0.1);
  transform: translateY(-2px);
}

.file-header-enhanced {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid #f1f5f9;
}

.file-icon-enhanced {
  width: 28px;
  height: 28px;
  color: var(--primary-green);
  flex-shrink: 0;
}

.file-info-enhanced {
  flex: 1;
}

.file-name-enhanced {
  font-weight: 600;
  color: #1e293b;
  font-size: 1rem;
  margin: 0;
  word-break: break-word;
  line-height: 1.4;
}

.file-type-enhanced {
  font-size: 0.875rem;
  color: #64748b;
  margin-top: 0.25rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.file-preview-container {
  margin: 1rem 0;
  border-radius: 12px;
  overflow: hidden;
  background: #f8fafc;
}

.download-btn-enhanced {
  background: linear-gradient(135deg, var(--primary-green), #20c997);
  color: white;
  border: none;
  padding: 0.75rem 1.5rem;
  border-radius: 12px;
  font-weight: 600;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: 0 2px 8px rgba(64, 139, 78, 0.2);
  cursor: pointer;
  min-width: 0;
  flex: 1;
  text-align: center;
  height: 44px;
  box-sizing: border-box;
}

.download-btn-enhanced:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(64, 139, 78, 0.3);
  color: white;
  text-decoration: none;
  background: linear-gradient(135deg, #157347, var(--primary-green));
}

/* Modal Actions */
.modal-actions {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.5rem;
  border-top: 1px solid #e5e7eb;
  background: #f9fafb;
}

.modal-actions .view-all-btn {
  padding: 0.875rem 1.75rem;
  border-radius: 12px;
  font-weight: 600;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.95rem;
  text-transform: none;
  letter-spacing: 0;
}

.modal-actions .view-all-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
}

.modal-title.warning {
  font-size: 1.5rem;
  font-weight: 700;
  color: #d97706;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.modal-title.submission {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--primary-green);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.modal-title.confirmation {
  font-size: 1.25rem;
  font-weight: 600;
  color: #3b82f6;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* Mobile responsiveness */
@media (max-width: 768px) {
  .modal-form {
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 1rem;
  }
  
  .modal-content {
    max-width: 95%;
    margin: 10px;
  }
  
  .form-actions {
    flex-direction: column;
  }
  
  .file-actions {
    flex-direction: column;
    gap: 0.5rem;
  }

  .details-content {
    padding: 1rem;
  }
  
  .details-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  
  .file-grid {
    grid-template-columns: 1fr;
  }
  
  .details-section {
    padding: 1.5rem;
  }
  
  .enhanced-file-preview {
    padding: 1.5rem;
  }
}

/* Filter styles */
.filter-input {
  min-height: 2.5rem;
  box-sizing: border-box;
}

.enhanced-multi-select-wrapper {
  width: 100%;
  min-width: 200px;
}

/* Scrollbar styling */
.modal-body::-webkit-scrollbar {
  width: 8px;
}

.modal-body::-webkit-scrollbar-track {
  background: #f1f5f9;
  border-radius: 4px;
}

.modal-body::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 4px;
}

.modal-body::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

.selected-files-container::-webkit-scrollbar {
  width: 6px;
}

.selected-files-container::-webkit-scrollbar-track {
  background: #f1f5f9;
  border-radius: 3px;
}

.selected-files-container::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 3px;
}

.selected-files-container::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}
</style>
</head>
<body>
  <div class="student-side">
    <div class="div">
      <div class="overlap">
        <div class="group">
          <img src="/Picture/logo.jpg" alt="S-CORE Logo" style="width:64px;height:59px;">
        </div>
        <a href="/dashboard" class="text-wrapper">S-CORE</a>
        <span class="text-wrapper-2">Request for Approval</span>

        <div class="dropdown-wrapper">
          <div class="overlap-group dropdown-toggle" onclick="toggleDropdown()">
            <div class="text-wrapper-3"><%= user.fName %> <%= user.lName %></div>
            <div class="user">
              <img class="user-icon" src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" alt="User Icon" />
            </div>
          </div>
          <div class="dropdown-menu" id="dropdownMenu">
            <a href="/profile">My Profile</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>

      <section class="activity-section">
        <div class="section-header">
          <div class="profile-info" style="display: flex; align-items: center; gap: 1rem;">
            <img src="<%= user.profilePicture ? '/uploads/' + user.profilePicture : '/Picture/user.png' %>" 
                 alt="Profile Picture" class="profile-pic-large" style="width:64px;height:64px;border-radius:50%;" />
            <div>
              <h2 style="margin-bottom: 0.25rem;"><%= user.fName %> <%= user.lName %></h2>
              <p style="color: #6b7280;"><%= user.userType === 'student' ? 'Student' : 'Non-Student' %></p>
            </div>
          </div>
          <button class="view-all-btn" id="openModalBtn">+ Request Approval</button>
        </div>

        <nav class="tabs" style="display: flex; gap: 1rem; margin-bottom: 1rem;">
          <a href="/all-requests" class="view-all-btn">All Requests</a>
          <a href="/request-approvals" class="view-all-btn" style="background: var(--primary-green); color: white;">Request Approvals</a>
          <a href="/service-requests" class="view-all-btn">Service Requests</a>
        </nav>

        <div class="filter-section">
          <div class="filter-container">
            <div class="filter-group">
              <label class="filter-label">Filter by:</label>
              
              <!-- First Row -->
              <div class="filter-controls">
                <div class="filter-item">
                  <label class="filter-sublabel">Status</label>
                  <div class="custom-select-wrapper">
                    <div class="custom-select" id="statusFilter">
                      <div class="select-display">All Status</div>
                      <div class="select-dropdown" id="statusDropdown">
                        <label class="dropdown-option">
                          <input type="checkbox" value="all" checked>
                          <span class="checkbox-custom"></span>
                          All Status
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="pending">
                          <span class="checkbox-custom"></span>
                          Pending
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="approved">
                          <span class="checkbox-custom"></span>
                          Approved
                        </label>
                        <label class="dropdown-option">
                          <input type="checkbox" value="rejected">
                          <span class="checkbox-custom"></span>
                          Rejected
                        </label>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="filter-item">
                  <label for="titleFilter" class="filter-sublabel">Title</label>
                  <input type="text" id="titleFilter" class="filter-input" placeholder="Search title...">
                </div>
                <div class="filter-item">
                  <% if (user.userType === 'student') { %>
                  <label for="organizationFilter" class="filter-sublabel">My Student Organizations</label>
                  <div class="enhanced-multi-select-wrapper">
                    <div class="enhanced-multi-select" id="organizationFilter">
                      <div class="select-display" data-placeholder="Select My Organizations">
                        <span class="selected-text">All My Organizations</span>
                        <span class="dropdown-arrow">▼</span>
                      </div>
                      <div class="select-dropdown" id="organizationDropdown">
                        <div class="search-container">
                          <input type="text" class="search-input" placeholder="Search my organizations...">
                        </div>
                        <div class="options-container">
                          <!-- Options populated by JavaScript -->
                        </div>
                      </div>
                    </div>
                  </div>
                  <% } else { %>
                  <label for="organizationFilter" class="filter-sublabel">My Office/Department</label>
                  <div class="enhanced-multi-select-wrapper">
                    <div class="enhanced-multi-select" id="organizationFilter">
                      <div class="select-display" data-placeholder="Select My Departments">
                        <span class="selected-text">All My Departments</span>
                        <span class="dropdown-arrow">▼</span>
                      </div>
                      <div class="select-dropdown" id="organizationDropdown">
                        <div class="search-container">
                          <input type="text" class="search-input" placeholder="Search my departments...">
                        </div>
                        <div class="options-container">
                          <!-- Options populated by JavaScript -->
                        </div>
                      </div>
                    </div>
                  </div>
                  <% } %>
                </div>
              </div>
              
              <!-- Second Row -->
              <div class="filter-controls">
                <div class="filter-item">
                  <label for="dateFromFilter" class="filter-sublabel">Date From</label>
                  <input type="date" id="dateFromFilter" class="filter-input">
                </div>
                <div class="filter-item">
                  <label for="dateToFilter" class="filter-sublabel">Date To</label>
                  <input type="date" id="dateToFilter" class="filter-input">
                </div>
              </div>
            </div>
            
            <div class="filter-actions">
              <button id="clearFilters" class="clear-filters-btn">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <rect x="3" y="6" width="18" height="14" rx="2"/>
                  <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                  <line x1="1" y1="6" x2="23" y2="6"/>
                  <line x1="10" y1="11" x2="10" y2="17"/>
                  <line x1="14" y1="11" x2="14" y2="17"/>
                </svg>
                Clear All
              </button>
              <div class="results-count">
                <span id="resultsCount">Showing all requests</span>
              </div>
            </div>
          </div>
        </div>

        <section class="table-section" style="overflow-x: auto;">
          <table class="requests-table" style="width: 100%; border-collapse: collapse; border-radius: var(--border-radius); box-shadow: var(--card-shadow); overflow: hidden; background: white;">
            <thead style="background: var(--light-green); color: var(--primary-green);">
              <tr>
                <th>Request ID</th>
                <th>Project Title</th>
                <th>Office/Department/Organization</th>
                <th>Status</th>
                <th>Assigned Units</th>
                <th>Date Submitted</th>
              </tr>
            </thead>
            <tbody id="requestsTableBody">
              <% allRequests.forEach(request => { %>
              <tr class="request-row"
                  data-id="<%= request._id %>"
                  data-type="<%= request.type %>"
                  data-title="<%= request.title %>"
                  data-status="<%= request.status %>"
                  data-organization="<%= request.organization %>"
                  data-units="<%= request.assignedUnits || 'Not yet assigned' %>"
                  data-datetime="<%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %>"
                  data-date="<%= request.datetime ? request.datetime.toISOString().split('T')[0] : new Date(request.createdAt).toISOString().split('T')[0] %>"
                  data-description="<%= request.description %>" 
                  data-file="<%= request.file ? request.file : '' %>"
                  data-files="<%= request.files ? request.files.join(',') : '' %>">
                  <td><%= request._id.toString().slice(-6) %></td>
                  <td><%= request.title %></td>
                  <td><%= request.organization %></td>
                  <td>
                    <span class="status-badge <%= request.status.toLowerCase() %>">
                      <%= request.status %>
                    </span>
                  </td>
                  <td><%= request.assignedUnits || 'Not yet assigned' %></td>
                  <td><%= request.datetime ? request.datetime.toLocaleString() : new Date(request.createdAt).toLocaleString() %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>

          <% if (!allRequests || allRequests.length === 0) { %>
          <div style="text-align: center; padding: 2rem; color: #6b7280;">
            <p>No requests found.</p>
          </div>
          <% } %>
        </section>
      </section>
      <a href="/dashboard" class="view-all-btn" style="display: inline-block;">← Back to Dashboard</a>
    </div>
  </div>

  <!-- Create Request Modal -->
  <div id="requestModal" class="modal" style="display:none;">
    <div class="modal-content">
      <header class="modal-header">
        <span class="modal-title">Create a Request for Approval</span>
        <span class="close" id="closeModalBtn">&times;</span>
      </header>
      <div class="modal-body">
        <form class="modal-form" action="/submit-request-approval" method="POST" enctype="multipart/form-data">
          <!-- Row 1: Title and Organization -->
          <div class="form-group">
            <label for="projectTitle">Project/Event Title:</label>
            <input type="text" id="projectTitle" name="projectTitle" required placeholder="Enter project or event title..." />
          </div>
          
          <div class="form-group">
            <label for="organization">Organization:</label>
            <%
              let userOrgs = [];
              if (user.userType === 'student') {
                if (Array.isArray(user.studentOrganization)) {
                  if (user.studentOrganization.length === 1 && user.studentOrganization[0].includes(',')) {
                    userOrgs = user.studentOrganization[0].split(',').map(o => o.trim()).filter(Boolean);
                  } else {
                    userOrgs = user.studentOrganization;
                  }
                } else if (typeof user.studentOrganization === 'string') {
                  userOrgs = user.studentOrganization.split(',').map(o => o.trim()).filter(Boolean);
                }
              } else {
                if (Array.isArray(user.affiliation)) {
                  if (user.affiliation.length === 1 && user.affiliation[0].includes(',')) {
                    userOrgs = user.affiliation[0].split(',').map(o => o.trim()).filter(Boolean);
                  } else {
                    userOrgs = user.affiliation;
                  }
                } else if (typeof user.affiliation === 'string') {
                  userOrgs = user.affiliation.split(',').map(o => o.trim()).filter(Boolean);
                }
              }
            %>
            <% if (userOrgs.length === 1) { %>
              <input type="text" id="organization" name="organization" value="<%= userOrgs[0] %>" readonly />
            <% } else if (userOrgs.length > 1) { %>
              <select id="organization" name="organization" required>
                <option value="" disabled selected>Select organization/department</option>
                <% userOrgs.forEach(function(org) { %>
                  <option value="<%= org %>"><%= org %></option>
                <% }); %>
              </select>
            <% } else { %>
              <input type="text" id="organization" name="organization" placeholder="Enter organization/department" required />
            <% } %>
          </div>

          <!-- Row 2: File Upload (Required for approval requests) -->
          <div class="form-group full-width">
            <label for="upload">Upload Files:</label>
            <div class="file-upload-group" id="approvalFileUploadGroup">
              <svg class="upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7,10 12,15 17,10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <p class="upload-text">Drop your files here</p>
              <p class="upload-subtext">or click to browse from your device</p>
              <input type="file" id="upload" name="upload" class="file-input-hidden" multiple required accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.webp,.xls,.xlsx,.txt" />
              <button type="button" class="browse-file-btn" onclick="event.stopPropagation(); document.getElementById('upload').click()">
                <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14,2 14,8 20,8"/>
                </svg>
                Choose Files
              </button>
              
              <!-- Upload Progress -->
              <div class="upload-progress" id="approvalUploadProgress">
                <div class="progress-bar">
                  <div class="progress-fill" id="approvalProgressFill"></div>
                </div>
              </div>
            </div>
            
            <!-- File Management Section -->
            <div class="file-management" id="approvalFileManagement" style="display: none;">
              <div class="file-actions">
                <span id="approvalFilesCount">0 files selected</span>
                <button type="button" class="clear-all-btn" id="approvalClearAllBtn" onclick="clearAllApprovalFiles()">
                  <svg width="16" height="16" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="6" width="18" height="14" rx="2"/>
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    <line x1="1" y1="6" x2="23" y2="6"/>
                    <line x1="10" y1="11" x2="10" y2="17"/>
                    <line x1="14" y1="11" x2="14" y2="17"/>
                  </svg>
                  Clear All Files
                </button>
              </div>
              
              <!-- Selected Files Container -->
              <div class="selected-files-container" id="approvalSelectedFiles">
                <!-- Files will be added here dynamically -->
              </div>
              
              <div class="files-summary" id="approvalFilesSummary">
                Total size: 0 MB
              </div>
            </div>
            
            <small style="color: #dc2626; margin-top: 0.5rem;">* Required: Please attach relevant documents (Max 10MB per file)</small>
          </div>

          <!-- Row 3: Description (Full Width) -->
          <div class="form-group full-width">
            <label for="description">Description:</label>
            <textarea id="description" name="description" rows="5" required placeholder="Provide detailed information about your project or event..."></textarea>
          </div>

          <!-- Form Actions -->
          <div class="form-actions">
            <button type="button" class="view-all-btn" id="cancelModalBtn" style="background: #e5e7eb; color: #374151;">Cancel</button>
            <button type="submit" class="view-all-btn" style="background: var(--success); color: white;">Submit Request</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Enhanced Submission Confirmation Modal -->
  <div id="submissionConfirmationModal" class="modal" style="display:none;">
    <div class="modal-content" style="max-width: 600px;">
      <header class="modal-header">
        <span class="modal-title confirmation">Confirm Your Submission</span>
        <span class="close" id="closeSubmissionConfirmation">&times;</span>
      </header>
      <div class="modal-body" style="padding: 0;">
        <div style="padding: 2rem; text-align: center; background: linear-gradient(135deg, #f0f9ff, #e0f2fe);">
          <div style="font-size: 4rem; margin-bottom: 1.5rem; color: #3b82f6;">
            <svg width="64" height="64" fill="none" stroke="#3b82f6" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h2 style="margin: 0 0 1rem 0; font-size: 1.5rem; font-weight: 700; color: #3b82f6;">
            Ready to Submit Your Request?
          </h2>
          <p style="margin: 0 0 1.5rem 0; font-size: 1.1rem; color: #374151; font-weight: 500;">
            Please review your information before final submission to the S-CORE team.
          </p>
        </div>
        
        <div style="padding: 1.5rem 2rem; background: white;">
          <div style="background: #fef3c7; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #f59e0b; margin-bottom: 1.5rem;">
            <h3 style="margin: 0 0 0.75rem 0; font-size: 1rem; font-weight: 600; color: #92400e; display: flex; align-items: center; gap: 0.5rem;">
              <svg width="20" height="20" fill="none" stroke="#f59e0b" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              Important Notice
            </h3>
            <p style="margin: 0; color: #92400e; font-size: 0.95rem; line-height: 1.5;">
              Once submitted, your request cannot be edited. Please ensure all information and files are correct.
            </p>
          </div>
          
          <div style="background: #f0f9ff; padding: 1.5rem; border-radius: 12px; border-left: 4px solid #3b82f6; margin-bottom: 1.5rem;">
            <h3 style="margin: 0 0 0.75rem 0; font-size: 1rem; font-weight: 600; color: #1e40af; display: flex; align-items: center; gap: 0.5rem;">
              <svg width="20" height="20" fill="none" stroke="#3b82f6" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12,6 12,12 16,14"/>
              </svg>
              Processing Timeline
            </h3>
            <p style="margin: 0; color: #1e40af; font-size: 0.95rem; line-height: 1.5;">
              The S-CORE team strives to provide feedback within <strong>three (3) working days</strong>.
            </p>
          </div>
          
          <div style="background: #f8fafc; padding: 1.5rem; border-radius: 12px; border: 1px solid #e2e8f0;">
            <p style="margin: 0; color: #64748b; font-size: 0.9rem; text-align: center; font-style: italic;">
              You can track your request status and communicate with our team through the conversation feature after submission.
            </p>
          </div>
        </div>
      </div>
      <div class="modal-actions" style="padding: 1.5rem; border-top: 1px solid #e5e7eb; background: #f9fafb;">
        <button id="cancelSubmissionBtn" class="view-all-btn" style="background: #e5e7eb; color: #374151;">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Review & Edit
        </button>
        <button id="proceedSubmissionBtn" class="view-all-btn" style="background: #3b82f6; color: white;">
